@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix echr:    <https://growgraph.dev/echr#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:  <https://schema.org/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/echr> a owl:Ontology ;
    rdfs:label "ECHR Art. 6 — Domestic Proceedings Extraction Schema"@en ;
    dcterms:title "ECHR Art. 6 — Domestic Proceedings Extraction Schema"@en ;
    dcterms:description """Extraction schema for the domestic (national) proceedings narrated in
the facts of European Court of Human Rights judgments, together with the Article 6
fair-trial grievances attached to them.

The schema is written for information extraction, not for legal reasoning: every
class is something a reader can point at in the text, and every controlled
vocabulary is closed by an explicit owl:oneOf enumeration so that extracted values
are comparable across cases. Each vocabulary carries an explicit escape value
(echr:LevelUnknown, echr:TypeOther, echr:OutcomeOther, ...) so no extractor ever needs
to mint a term of its own.

Section 4 defines the gender module. Applicant, judge and representative gender is
rarely stated outright in Strasbourg judgments; it is signalled by honorifics,
pronouns, kinship terms and — much less reliably — by name morphology. The module
therefore never records a bare gender value: an assertion of echr:hasGender must be
accompanied by the cue type(s) it rests on (echr:hasGenderCue) and the verbatim cue
text (echr:hasGenderCueText), and every cue type declares its own reliability
(echr:hasCueReliability). This makes a gender assertion auditable and lets an
evaluation separate cue-supported inference from guessing on names. echr:GenderUnknown
is a first-class, expected answer for anonymised applicants.

echr:hasGender records the gender the document itself marks, through its own
language. It is a property of the text's treatment of a person, not a claim about
that person's gender identity.

Age is recorded far more simply, through echr:hasBirthYear and echr:hasStatedAge.
Strasbourg judgments conventionally open the facts with a year of birth, so the datum
is stated rather than inferred and needs no cue apparatus. Both are recorded only
where the text asserts them, and neither is ever computed — from the other, or from
the dates the schema already carries.

Section 5 defines the pre-trial detention module. Detention pending investigation or
trial is modelled as a node of its own rather than as dates on a proceeding, because
a person may be detained, released and re-detained within a single set of proceedings
and because the ground relied on changes from one review to the next. It carries the
arrest date, which is ordinarily the point from which the reasonable-time period runs
in criminal cases, and it marks the periods over which the Court requires special
diligence of the authorities.

Section 6 defines the periods module: the period the Court took into consideration
under Article 6 § 1, and the dormant stretches inside a proceeding. Both are nodes
with dates of their own rather than durations hung off something else, because when a
stretch of time fell, and which instance it fell in, are the questions being asked.

The schema records the domestic proceedings and the grievances the facts attach to
them. It does not record the Strasbourg Court's own dispositions — admissibility,
violation findings, the guarantees each complaint engaged, just satisfaction — which
are expected to come from case-level metadata joined on echr:hasHudocId. The one
exception is echr:PeriodConsidered, which is stated in the Court's reasoning and has
no equivalent in that metadata."""@en ;
    dcterms:created "2026-07-24T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:modified "2026-08-07T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "echr" ;
    rdfs:seeAlso <https://ks.echr.coe.int/documents/d/echr-ks/guide_art_6_criminal_eng> ,
        <https://ks.echr.coe.int/documents/d/echr-ks/guide_art_6_civil_eng> ;
    owl:versionIRI <https://growgraph.dev/echr/2.1.0> ;
    owl:versionInfo "2.1.0" .

################################################################
# 0. Datatypes
################################################################

echr:PartialDate a rdfs:Datatype ;
    rdfs:label "partial date"@en ;
    skos:definition "A date as precise as the text allows: a full date, a year and month, or a bare year. Judgments frequently say only \"in 1998\" or \"in March 2003\"; record that precision rather than inventing a day."@en ;
    owl:equivalentClass [ a rdfs:Datatype ;
        owl:unionOf ( xsd:date xsd:gYearMonth xsd:gYear ) ] ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

################################################################
# 1. Core classes
################################################################

echr:CaseDocument a owl:Class ;
    rdfs:label "Case Document"@en ;
    skos:definition "The Strasbourg judgment or decision being read. Do not create these: reuse the existing case IRI and attach the extracted proceedings to it."@en ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:DomesticProceeding a owl:Class ;
    rdfs:label "Domestic Proceeding"@en ;
    skos:definition "One set of proceedings before a single national court or authority, as narrated in the facts. Create one instance per instance of the domestic chain (e.g. first-instance trial, appeal, cassation), not one per hearing or procedural step."@en ;
    skos:scopeNote "Where a case is remitted and retried before the same court, the retrial is a separate proceeding linked by echr:followsProceeding, because it has its own dates and its own outcome."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:DomesticAuthority a owl:Class ;
    rdfs:label "Domestic Authority"@en ;
    skos:definition "A national court, tribunal, prosecutor or administrative body that decided a proceeding. Reuse one instance per authority named in the text."@en ;
    rdfs:subClassOf foaf:Organization ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:Party a owl:Class ;
    rdfs:label "Party"@en ;
    skos:definition "A person, company or public body taking part in the domestic proceedings, including the future applicant."@en ;
    skos:scopeNote "What sort of entity a party is comes from its type, not from a separate vocabulary: a human party is also typed echr:NaturalPerson, and an institutional party that decided another proceeding in the chain is also typed echr:DomesticAuthority. A party that went on to apply to Strasbourg is reached through echr:hasApplicant on the case, not through a role value."@en ;
    rdfs:subClassOf foaf:Agent ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:Participation a owl:Class ;
    rdfs:label "Participation"@en ;
    skos:definition "One party's involvement in one proceeding: who they were and which side they were on, at that instance."@en ;
    skos:scopeNote "Create one instance per party per proceeding. The side a party is on changes as the case moves up — the accused at trial is the moving party on appeal — and the schema records that change by having a separate participation at each instance rather than by accumulating roles on the party."@en ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:Article6Issue a owl:Class ;
    rdfs:label "Article 6 Issue"@en ;
    skos:definition "A fair-trial grievance the facts attribute to a particular proceeding (e.g. the appeal took six years, the judge had earlier acted as prosecutor). Create one instance per distinct grievance."@en ;
    skos:scopeNote "Record the grievance as the facts present it. Do not add issues the Court found of its own motion elsewhere in the judgment, and do not decide whether the grievance is well-founded."@en ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

################################################################
# 2. Person classes
#
# Split out from echr:Party because the humans who matter to an Article 6 grievance
# are not all parties to the proceeding. A judge is not a party, but impartiality,
# independence and irregular composition are grievances about a particular judge. A
# lawyer is not a party, but denial of counsel, refusal of counsel of choice and
# questioning without a lawyer present are grievances about a particular
# representative — and, in the pre-trial phase, among the commonest.
#
# The split is therefore about who a grievance can be predicated of, not about which
# attributes a node carries.
#
# One asymmetry remains. echr:hasSittingJudge is scoped to a proceeding, and parties
# are now scoped to one through echr:Participation, but echr:isRepresentedBy still
# hangs off the party across the whole chain — so a change of counsel between
# instances cannot be tied to the instance it happened at. Representation is the
# obvious next candidate for the same treatment, by moving it onto the participation.
################################################################

echr:NaturalPerson a owl:Class ;
    rdfs:label "Natural Person"@en ;
    skos:definition "An identified or referred-to human being in the case: an applicant, a co-party, a judge, a prosecutor acting in person, a lawyer, a relative. Create one instance per person, however they are designated — a person named only as \"the applicant\" or as \"X\" is still a natural person."@en ;
    rdfs:subClassOf foaf:Person ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:JudicialOfficer a owl:Class ;
    rdfs:label "Judicial Officer"@en ;
    skos:definition "A judge, investigating judge, lay assessor or prosecutor named in the facts as sitting in or conducting a domestic proceeding."@en ;
    skos:scopeNote "Domestic benches are usually unnamed. Create instances only where the facts name or individuate the officer — typically when the grievance is about that officer (impartiality, prior involvement, replacement of the bench)."@en ;
    rdfs:subClassOf echr:NaturalPerson ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:LegalRepresentative a owl:Class ;
    rdfs:label "Legal Representative"@en ;
    skos:definition "A lawyer, legal-aid counsel, guardian or agent acting for a party in the domestic proceedings."@en ;
    rdfs:subClassOf echr:NaturalPerson ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

################################################################
# 3. Vocabulary container classes
################################################################

echr:InstanceLevel a owl:Class ;
    rdfs:label "Instance Level"@en ;
    skos:definition "Controlled vocabulary: position of a proceeding in the national hierarchy."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:ProceedingType a owl:Class ;
    rdfs:label "Proceeding Type"@en ;
    skos:definition "Controlled vocabulary: nature of the proceeding in domestic terms."@en ;
    skos:scopeNote "This is the domestic characterisation, as the facts label it. Whether Article 6 applies under its civil or criminal limb is an autonomous Convention question decided by the Court, and is not recorded here."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:ProceedingOutcome a owl:Class ;
    rdfs:label "Proceeding Outcome"@en ;
    skos:definition "Controlled vocabulary: the disposition that closed the proceeding."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:OutcomeDirection a owl:Class ;
    rdfs:label "Outcome Direction"@en ;
    skos:definition "Controlled vocabulary: which way the disposition cut for the future applicant. Orthogonal to echr:ProceedingOutcome — the same disposition can favour or disfavour the applicant depending on which side they were on."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:PartySide a owl:Class ;
    rdfs:label "Party Side"@en ;
    skos:definition "Controlled vocabulary: which side of a proceeding a party was on, stated in terms that hold across civil, criminal and appellate instances alike."@en ;
    skos:scopeNote "Deliberately coarse. Claimant, prosecution and appellant are all the moving party; defendant, accused and respondent on appeal are all the responding party. Recording the shared distinction rather than the domestic label is what makes the value comparable between a first-instance trial and a cassation appeal, and between one legal order and another."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:AuthorityKind a owl:Class ;
    rdfs:label "Authority Kind"@en ;
    skos:definition "Controlled vocabulary: what sort of body the deciding authority is, in the one respect not already recoverable from the proceeding it decided — whether it is judicial, prosecutorial, administrative or disciplinary."@en ;
    skos:scopeNote "Rank and specialism are not recorded here: supreme, constitutional and specialised courts are already distinguished by echr:hasInstanceLevel and echr:hasProceedingType on the proceedings they decided. What those cannot give is a property of the body itself, held across every case it appears in — which is what makes it possible to ask whether detention ordered by a prosecutor behaves differently from detention ordered by a court."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:DelayAttribution a owl:Class ;
    rdfs:label "Delay Attribution"@en ;
    skos:definition "Controlled vocabulary: to whom the facts attribute the delay complained of. Tracks the reasonable-time test — complexity of the case, conduct of the applicant, conduct of the authorities."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

[] a owl:AllDisjointClasses ;
    owl:members ( echr:CaseDocument echr:DomesticProceeding echr:Article6Issue
        echr:NaturalPerson echr:DomesticAuthority echr:PreTrialDetention
        echr:PeriodConsidered echr:InactivityPeriod echr:Adjournment echr:Participation ) .

# echr:Party is deliberately disjoint from neither echr:NaturalPerson nor
# echr:DomesticAuthority: a human party is both a party and a natural person, and a
# prosecutor's office can be a party in one proceeding and the deciding authority in
# another.
[] a owl:AllDisjointClasses ;
    owl:members ( echr:CaseDocument echr:DomesticProceeding echr:Article6Issue echr:Party ) .

################################################################
# 4. Gender module
#
# Gender is almost never stated in a Strasbourg judgment; it is inferred from the
# language the judgment uses. Three rules govern this module.
#
#  (a) echr:hasGender records how the document marks a person, through honorifics,
#      pronouns and gendered nouns. It is not a claim about gender identity, and it
#      is not to be resolved from outside knowledge about a named individual.
#  (b) An assertion of echr:hasGender other than echr:GenderUnknown must carry at
#      least one echr:hasGenderCue and the verbatim echr:hasGenderCueText it rests
#      on. A value with no recorded cue is a guess and scores as one.
#  (c) echr:GenderUnknown is the expected answer for an anonymised applicant with no
#      gendered cue ("the applicant", "X", "A.B."). Do not fall back on a name.
################################################################

echr:Gender a owl:Class ;
    rdfs:label "Gender"@en ;
    skos:definition "Controlled vocabulary: the gender a case document marks a natural person with, through its own language."@en ;
    skos:scopeNote "This is documentary gender marking, not gender identity. Where a judgment is itself about a person's gender recognition, the marking may differ from how the person identifies; record the marking, and record the discrepancy as a note if the facts state one."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:GenderCueType a owl:Class ;
    rdfs:label "Gender Cue Type"@en ;
    skos:definition "Controlled vocabulary: the kind of textual signal a gender assertion rests on. Every cue type declares its reliability through echr:hasCueReliability."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:EvidenceStrength a owl:Class ;
    rdfs:label "Evidence Strength"@en ;
    skos:definition "Controlled vocabulary: how much weight a textual cue can bear."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

#---------------------------------------------------------------
# 4.1 Gender properties
#---------------------------------------------------------------

echr:hasGender a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has gender"@en ;
    skos:definition "The gender the document marks this person with. Assert echr:GenderUnknown rather than omitting the property when the text carries no cue — an explicit unknown is a finding, an absent value is a gap."@en ;
    rdfs:domain echr:NaturalPerson ;
    rdfs:range echr:Gender ;
    rdfs:seeAlso schema:gender , foaf:gender ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasGenderCue a owl:ObjectProperty ;
    rdfs:label "has gender cue"@en ;
    skos:definition "A kind of textual signal supporting the echr:hasGender assertion. Record every distinct kind of cue found, not just the strongest one."@en ;
    rdfs:domain echr:NaturalPerson ;
    rdfs:range echr:GenderCueType ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasGenderCueText a owl:DatatypeProperty ;
    rdfs:label "has gender cue text"@en ;
    skos:definition "The cue exactly as it appears in the case text, short enough to be a quotation: \"Mr Rusi Kosev Stanev\", \"his placement in a social care home\", \"the applicant's wife\"."@en ;
    rdfs:domain echr:NaturalPerson ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasGenderConfidence a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has gender confidence"@en ;
    skos:definition "Confidence in the gender assertion, from 0.0 to 1.0. A reading resting only on echr:GenderCueNameMorphology or echr:GenderCueGivenName should not be given a high value."@en ;
    rdfs:domain echr:NaturalPerson ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasCueReliability a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has cue reliability"@en ;
    skos:definition "How much weight a cue type can bear. Fixed by this schema for each echr:GenderCueType; extractors read it, they do not set it."@en ;
    rdfs:domain echr:GenderCueType ;
    rdfs:range echr:EvidenceStrength ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasHonorific a owl:DatatypeProperty ;
    rdfs:label "has honorific"@en ;
    skos:definition "The courtesy title used for the person, verbatim: \"Mr\", \"Ms\", \"Mrs\", \"Mme\", \"M.\". The most reliable gender cue in Strasbourg judgments, which apply honorifics even to anonymised applicants."@en ;
    rdfs:domain echr:NaturalPerson ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:isAnonymised a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "is anonymised"@en ;
    skos:definition "True where the judgment withholds the person's name, designating them by initials, a single letter, or a bare role (\"the applicant\", \"X\", \"A.B.\"). Anonymisation removes the name cues but usually leaves honorifics and pronouns intact."@en ;
    rdfs:domain echr:NaturalPerson ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

#---------------------------------------------------------------
# 4.2 Gender
#---------------------------------------------------------------

echr:GenderFemale a echr:Gender ;
    skos:prefLabel "female"@en ;
    skos:definition "The document marks the person as a woman."@en ;
    skos:inScheme echr:GenderScheme .

echr:GenderMale a echr:Gender ;
    skos:prefLabel "male"@en ;
    skos:definition "The document marks the person as a man."@en ;
    skos:inScheme echr:GenderScheme .

echr:GenderOther a echr:Gender ;
    skos:prefLabel "other"@en ;
    skos:definition "The document marks the person in terms that are neither male nor female — for instance in gender-recognition cases where the facts describe a transgender or non-binary applicant in those terms."@en ;
    skos:scopeNote "Use only where the text supports it. This is not a bucket for cases that are merely unclear; those are echr:GenderUnknown."@en ;
    skos:inScheme echr:GenderScheme .

echr:GenderUnknown a echr:Gender ;
    skos:prefLabel "unknown"@en ;
    skos:definition "The document carries no cue sufficient to mark the person's gender. The correct and expected value for an anonymised person referred to without honorific or pronoun."@en ;
    skos:inScheme echr:GenderScheme .

echr:GenderScheme a skos:ConceptScheme ;
    rdfs:label "Gender vocabulary"@en .

echr:Gender owl:equivalentClass [ a owl:Class ;
    owl:oneOf ( echr:GenderFemale echr:GenderMale echr:GenderOther echr:GenderUnknown ) ] .

#---------------------------------------------------------------
# 4.3 Gender cue type
#---------------------------------------------------------------

echr:GenderCueHonorific a echr:GenderCueType ;
    skos:prefLabel "honorific"@en ;
    skos:definition "A courtesy title: \"Mr\", \"Mrs\", \"Ms\", \"Miss\", \"M.\", \"Mme\". Survives anonymisation and is the single most dependable cue in this corpus."@en ;
    echr:hasCueReliability echr:StrengthStrong ;
    skos:inScheme echr:GenderCueScheme .

echr:GenderCuePronoun a echr:GenderCueType ;
    skos:prefLabel "pronoun"@en ;
    skos:definition "A gendered pronoun or possessive used for the person: \"he\", \"his\", \"him\", \"she\", \"her\", \"hers\"."@en ;
    skos:scopeNote "Check that the pronoun refers to this person and not to another individual mentioned in the same sentence. Pronouns in quoted domestic decisions may refer to a different party."@en ;
    echr:hasCueReliability echr:StrengthStrong ;
    skos:inScheme echr:GenderCueScheme .

echr:GenderCueExplicitStatement a echr:GenderCueType ;
    skos:prefLabel "explicit statement"@en ;
    skos:definition "The text states the person's sex or gender outright: \"the applicant is a woman\", \"a female prisoner\", \"the applicant, a transgender man\"."@en ;
    echr:hasCueReliability echr:StrengthStrong ;
    skos:inScheme echr:GenderCueScheme .

echr:GenderCueKinshipTerm a echr:GenderCueType ;
    skos:prefLabel "kinship term"@en ;
    skos:definition "A gendered family term applied to the person: \"the applicant's mother\", \"his wife\", \"her son\", \"the widow of the deceased\"."@en ;
    skos:scopeNote "Mind the direction. \"His wife\" marks the wife as female and the referent as male; both readings are legitimate cues, but attach each to the right person."@en ;
    echr:hasCueReliability echr:StrengthStrong ;
    skos:inScheme echr:GenderCueScheme .

echr:GenderCueGenderedRoleNoun a echr:GenderCueType ;
    skos:prefLabel "gendered role noun"@en ;
    skos:definition "A gendered occupational or status noun: \"businesswoman\", \"spokesman\", \"a policewoman\", \"the abbess\"."@en ;
    echr:hasCueReliability echr:StrengthModerate ;
    skos:inScheme echr:GenderCueScheme .

echr:GenderCueGrammaticalAgreement a echr:GenderCueType ;
    skos:prefLabel "grammatical agreement"@en ;
    skos:definition "Gender marked by inflection in a quoted original-language phrase or title — a feminine adjective, participle or patronymic in the domestic decision as reproduced in the judgment."@en ;
    echr:hasCueReliability echr:StrengthModerate ;
    skos:inScheme echr:GenderCueScheme .

echr:GenderCueNameMorphology a echr:GenderCueType ;
    skos:prefLabel "name morphology"@en ;
    skos:definition "Gender read off the shape of a surname or patronymic — Slavic feminine forms in -ova/-eva/-ska, Lithuanian -aitė/-ienė, Greek genitives, Icelandic -dóttir/-son."@en ;
    skos:scopeNote "Weak, and unevenly weak across respondent States: dependable for Czech and Lithuanian names, unreliable elsewhere, and absent for most Western European names. Never the sole basis for a confident assertion; record echr:hasJurisdictionState so the reading can be judged in context."@en ;
    echr:hasCueReliability echr:StrengthWeak ;
    skos:inScheme echr:GenderCueScheme .

echr:GenderCueGivenName a echr:GenderCueType ;
    skos:prefLabel "given name"@en ;
    skos:definition "Gender read off a given name conventionally borne by one gender in the relevant language."@en ;
    skos:scopeNote "The weakest cue in this schema and the one most likely to produce a wrong answer. Given names are unisex in some languages, transliterated inconsistently, and reduced to an initial in anonymised cases. Where a given name is the only signal available, echr:GenderUnknown with the name recorded is often the better answer than a guess."@en ;
    echr:hasCueReliability echr:StrengthWeak ;
    skos:inScheme echr:GenderCueScheme .

echr:GenderCueNone a echr:GenderCueType ;
    skos:prefLabel "no cue"@en ;
    skos:definition "The text carries nothing to go on. Pair with echr:GenderUnknown; it distinguishes a person whose gender was looked for and not found from one who was never examined."@en ;
    echr:hasCueReliability echr:StrengthWeak ;
    skos:inScheme echr:GenderCueScheme .

echr:GenderCueScheme a skos:ConceptScheme ;
    rdfs:label "Gender cue type vocabulary"@en .

echr:GenderCueType owl:equivalentClass [ a owl:Class ;
    owl:oneOf ( echr:GenderCueHonorific echr:GenderCuePronoun echr:GenderCueExplicitStatement
        echr:GenderCueKinshipTerm echr:GenderCueGenderedRoleNoun echr:GenderCueGrammaticalAgreement
        echr:GenderCueNameMorphology echr:GenderCueGivenName echr:GenderCueNone ) ] .

#---------------------------------------------------------------
# 4.4 Evidence strength
#---------------------------------------------------------------

echr:StrengthStrong a echr:EvidenceStrength ;
    skos:prefLabel "strong"@en ;
    skos:definition "The cue is an explicit gender marking by the document itself. Sufficient on its own."@en ;
    skos:inScheme echr:EvidenceStrengthScheme .

echr:StrengthModerate a echr:EvidenceStrength ;
    skos:prefLabel "moderate"@en ;
    skos:definition "The cue marks gender through conventional usage that usually but not always holds. Sufficient when uncontradicted, better when corroborated."@en ;
    skos:inScheme echr:EvidenceStrengthScheme .

echr:StrengthWeak a echr:EvidenceStrength ;
    skos:prefLabel "weak"@en ;
    skos:definition "The cue rests on naming convention or statistical association rather than on anything the document asserts. Not a sufficient basis on its own."@en ;
    skos:inScheme echr:EvidenceStrengthScheme .

echr:EvidenceStrengthScheme a skos:ConceptScheme ;
    rdfs:label "Evidence strength vocabulary"@en .

echr:EvidenceStrength owl:equivalentClass [ a owl:Class ;
    owl:oneOf ( echr:StrengthStrong echr:StrengthModerate echr:StrengthWeak ) ] .

################################################################
# 5. Pre-trial detention module
#
# Detention pending investigation or trial is the pre-trial fact that bears
# hardest on Article 6 § 1, for two reasons.
#
#  (a) It usually fixes the start of the reasonable-time period in criminal
#      cases. The period runs from the moment the applicant is substantially
#      affected by the accusation — ordinarily arrest or first questioning,
#      not committal or the opening of the trial. Where a detention is
#      recorded, echr:hasDetentionStartDate is normally the better clock start
#      than echr:hasProceedingStartDate.
#  (b) It raises the standard by which delay is judged. The Court requires
#      special diligence of authorities holding an accused in custody, so the
#      same elapsed time is treated more severely where the applicant was
#      detained throughout it.
#
# A detention is its own node rather than a pair of dates on the proceeding,
# because a person may be detained, released and re-detained within one set of
# proceedings, and because the ground relied on changes from one review to the
# next. Create one instance per continuous period under a single measure; a
# change of measure — police custody converted to remand, remand to house
# arrest — closes one node and opens another.
################################################################

echr:PreTrialDetention a owl:Class ;
    rdfs:label "Pre-Trial Detention"@en ;
    skos:definition "A continuous period during which a person was deprived of liberty in connection with proceedings not yet finally determined, as narrated in the facts."@en ;
    skos:scopeNote "Pre-trial only. Detention serving a sentence after final conviction is out of scope, as is detention on grounds unconnected with these proceedings. Detention continuing after a first-instance conviction while an appeal is pending is the hard case: it is in scope, and echr:hasExtractionNote should say so."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:CustodialMeasure a owl:Class ;
    rdfs:label "Custodial Measure"@en ;
    skos:definition "Controlled vocabulary: the form the deprivation of liberty took."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:DetentionGround a owl:Class ;
    rdfs:label "Detention Ground"@en ;
    skos:definition "Controlled vocabulary: the reason the authorities gave for ordering or extending the detention, as the facts report it."@en ;
    skos:scopeNote "Record the ground the decision stated, not the ground an extractor thinks was operative. Where a decision gave no reason or reproduced statutory wording without applying it, that is echr:GroundNoneStated and is itself a finding."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:DetentionEnding a owl:Class ;
    rdfs:label "Detention Ending"@en ;
    skos:definition "Controlled vocabulary: how the period of detention came to an end."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

#---------------------------------------------------------------
# 5.1 Detention properties
#---------------------------------------------------------------

echr:hasPreTrialDetention a owl:ObjectProperty ;
    rdfs:label "has pre-trial detention"@en ;
    skos:definition "Attaches a period of detention to the proceeding in which it was ordered or continued. A detention spanning investigation and trial attaches to both."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:PreTrialDetention ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasDetainee a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has detainee"@en ;
    skos:definition "The person held. Usually the future applicant; record a co-accused only where the facts turn on the comparison."@en ;
    rdfs:domain echr:PreTrialDetention ;
    rdfs:range echr:NaturalPerson ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasDetentionAuthority a owl:ObjectProperty ;
    rdfs:label "has detention authority"@en ;
    skos:definition "The body that ordered or extended the detention. Whether it was a court or a prosecutor is a recurring pre-trial issue in its own right."@en ;
    rdfs:domain echr:PreTrialDetention ;
    rdfs:range echr:DomesticAuthority ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasCustodialMeasure a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has custodial measure"@en ;
    skos:definition "The form this deprivation of liberty took."@en ;
    rdfs:domain echr:PreTrialDetention ;
    rdfs:range echr:CustodialMeasure ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasDetentionGround a owl:ObjectProperty ;
    rdfs:label "has detention ground"@en ;
    skos:definition "A ground the authorities gave. Not functional: detention orders routinely cite several, and the set typically shrinks as the detention lengthens."@en ;
    rdfs:domain echr:PreTrialDetention ;
    rdfs:range echr:DetentionGround ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasDetentionEnding a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has detention ending"@en ;
    skos:definition "How this period of detention came to an end."@en ;
    rdfs:domain echr:PreTrialDetention ;
    rdfs:range echr:DetentionEnding ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasDetentionStartDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has detention start date"@en ;
    skos:definition "Date the person was taken into custody under this measure. Record only the precision the text gives."@en ;
    rdfs:domain echr:PreTrialDetention ;
    rdfs:range echr:PartialDate ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasDetentionEndDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has detention end date"@en ;
    skos:definition "Date the person was released or the measure was replaced. Omit where the facts present the person as still detained; record echr:EndingStillDetained instead."@en ;
    rdfs:domain echr:PreTrialDetention ;
    rdfs:range echr:PartialDate ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasStatedDetentionDuration a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has stated detention duration"@en ;
    skos:definition "Length of the detention where the judgment states it in words, as an xsd:duration. Do not compute this from the dates — record it only when the text asserts it."@en ;
    rdfs:domain echr:PreTrialDetention ;
    rdfs:range xsd:duration ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasExtensionCount a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has extension count"@en ;
    skos:definition "The number of times the facts say the detention was extended or renewed. A proxy for how often the necessity of custody was actually revisited; record it only where the text gives a count or enumerates the extensions."@en ;
    rdfs:domain echr:PreTrialDetention ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

#---------------------------------------------------------------
# 5.2 Custodial measure
#---------------------------------------------------------------

echr:MeasurePoliceCustody a echr:CustodialMeasure ;
    skos:prefLabel "police custody"@en ;
    skos:definition "Short initial custody at a police station or by an investigating authority, before any judicial order — garde à vue and its equivalents. Where an arrest date is given at all, this is usually the measure it belongs to."@en ;
    skos:inScheme echr:CustodialMeasureScheme .

echr:MeasureRemandInCustody a echr:CustodialMeasure ;
    skos:prefLabel "remand in custody"@en ;
    skos:definition "Detention on remand ordered by a court or prosecutor pending investigation or trial."@en ;
    skos:inScheme echr:CustodialMeasureScheme .

echr:MeasureHouseArrest a echr:CustodialMeasure ;
    skos:prefLabel "house arrest"@en ;
    skos:inScheme echr:CustodialMeasureScheme .

echr:MeasurePsychiatricConfinement a echr:CustodialMeasure ;
    skos:prefLabel "psychiatric confinement"@en ;
    skos:definition "Compulsory placement for psychiatric assessment or treatment ordered in these proceedings."@en ;
    skos:inScheme echr:CustodialMeasureScheme .

echr:MeasureOther a echr:CustodialMeasure ;
    skos:prefLabel "other"@en ;
    skos:inScheme echr:CustodialMeasureScheme .

echr:MeasureUnknown a echr:CustodialMeasure ;
    skos:prefLabel "unknown"@en ;
    skos:definition "The facts record that the person was detained but not under what measure."@en ;
    skos:inScheme echr:CustodialMeasureScheme .

echr:CustodialMeasureScheme a skos:ConceptScheme ;
    rdfs:label "Custodial measure vocabulary"@en .

echr:CustodialMeasure owl:equivalentClass [ a owl:Class ;
    owl:oneOf ( echr:MeasurePoliceCustody echr:MeasureRemandInCustody echr:MeasureHouseArrest
        echr:MeasurePsychiatricConfinement echr:MeasureOther echr:MeasureUnknown ) ] .

#---------------------------------------------------------------
# 5.3 Detention ground
#---------------------------------------------------------------

echr:GroundRiskOfAbsconding a echr:DetentionGround ;
    skos:prefLabel "risk of absconding"@en ;
    skos:inScheme echr:DetentionGroundScheme .

echr:GroundRiskOfReoffending a echr:DetentionGround ;
    skos:prefLabel "risk of reoffending"@en ;
    skos:inScheme echr:DetentionGroundScheme .

echr:GroundRiskOfCollusion a echr:DetentionGround ;
    skos:prefLabel "risk of collusion"@en ;
    skos:definition "Risk that the person would interfere with witnesses, tamper with evidence or obstruct the investigation."@en ;
    skos:inScheme echr:DetentionGroundScheme .

echr:GroundGravityOfOffence a echr:DetentionGround ;
    skos:prefLabel "gravity of the offence"@en ;
    skos:definition "The seriousness of the charge, relied on as a reason in itself. Worth recording separately because the Court treats it as insufficient on its own once detention has lasted any length of time."@en ;
    skos:inScheme echr:DetentionGroundScheme .

echr:GroundPublicOrder a echr:DetentionGround ;
    skos:prefLabel "preservation of public order"@en ;
    skos:inScheme echr:DetentionGroundScheme .

echr:GroundNeedForInvestigativeSteps a echr:DetentionGround ;
    skos:prefLabel "need to complete investigative steps"@en ;
    skos:definition "Detention continued so that expert reports, further questioning or other investigative acts could be completed."@en ;
    skos:inScheme echr:DetentionGroundScheme .

echr:GroundNoneStated a echr:DetentionGround ;
    skos:prefLabel "no ground stated"@en ;
    skos:definition "The decision gave no reason, or reproduced the wording of the statute without relating it to the facts of the case."@en ;
    skos:inScheme echr:DetentionGroundScheme .

echr:GroundOther a echr:DetentionGround ;
    skos:prefLabel "other"@en ;
    skos:inScheme echr:DetentionGroundScheme .

echr:GroundUnknown a echr:DetentionGround ;
    skos:prefLabel "unknown"@en ;
    skos:definition "The facts do not report what the authorities relied on. Distinct from echr:GroundNoneStated, which is a positive finding that the decision itself gave none."@en ;
    skos:inScheme echr:DetentionGroundScheme .

echr:DetentionGroundScheme a skos:ConceptScheme ;
    rdfs:label "Detention ground vocabulary"@en .

echr:DetentionGround owl:equivalentClass [ a owl:Class ;
    owl:oneOf ( echr:GroundRiskOfAbsconding echr:GroundRiskOfReoffending echr:GroundRiskOfCollusion
        echr:GroundGravityOfOffence echr:GroundPublicOrder echr:GroundNeedForInvestigativeSteps
        echr:GroundNoneStated echr:GroundOther echr:GroundUnknown ) ] .

#---------------------------------------------------------------
# 5.4 Detention ending
#---------------------------------------------------------------

echr:EndingReleasedUnconditionally a echr:DetentionEnding ;
    skos:prefLabel "released unconditionally"@en ;
    skos:inScheme echr:DetentionEndingScheme .

echr:EndingReleasedOnBailOrSupervision a echr:DetentionEnding ;
    skos:prefLabel "released on bail or under supervision"@en ;
    skos:definition "Released subject to conditions that are not themselves a deprivation of liberty: bail, a travel ban, reporting obligations."@en ;
    skos:inScheme echr:DetentionEndingScheme .

echr:EndingConvertedToLesserMeasure a echr:DetentionEnding ;
    skos:prefLabel "converted to a lesser custodial measure"@en ;
    skos:definition "Replaced by another measure that still deprives the person of liberty, typically house arrest. Open a new echr:PreTrialDetention node for the substitute."@en ;
    skos:inScheme echr:DetentionEndingScheme .

echr:EndingConvictionAtFirstInstance a echr:DetentionEnding ;
    skos:prefLabel "conviction at first instance"@en ;
    skos:definition "The detention ceased to be pre-trial on conviction, whether or not the person remained in custody afterwards."@en ;
    skos:inScheme echr:DetentionEndingScheme .

echr:EndingProceedingsTerminated a echr:DetentionEnding ;
    skos:prefLabel "proceedings terminated"@en ;
    skos:definition "Ended because the case did: acquittal, discontinuance, charges dropped, expiry of a statutory maximum."@en ;
    skos:inScheme echr:DetentionEndingScheme .

echr:EndingStillDetained a echr:DetentionEnding ;
    skos:prefLabel "still detained"@en ;
    skos:definition "The facts present the person as still in custody at the time of the Strasbourg judgment. Pair with an absent echr:hasDetentionEndDate."@en ;
    skos:inScheme echr:DetentionEndingScheme .

echr:EndingOther a echr:DetentionEnding ;
    skos:prefLabel "other"@en ;
    skos:inScheme echr:DetentionEndingScheme .

echr:EndingUnknown a echr:DetentionEnding ;
    skos:prefLabel "unknown"@en ;
    skos:definition "The facts do not say how the detention ended."@en ;
    skos:inScheme echr:DetentionEndingScheme .

echr:DetentionEndingScheme a skos:ConceptScheme ;
    rdfs:label "Detention ending vocabulary"@en .

echr:DetentionEnding owl:equivalentClass [ a owl:Class ;
    owl:oneOf ( echr:EndingReleasedUnconditionally echr:EndingReleasedOnBailOrSupervision
        echr:EndingConvertedToLesserMeasure echr:EndingConvictionAtFirstInstance
        echr:EndingProceedingsTerminated echr:EndingStillDetained echr:EndingOther
        echr:EndingUnknown ) ] .

################################################################
# 6. Periods and delay events module
#
# Two spans the reasonable-time analysis turns on, neither of which a proceeding
# or a grievance can carry as a scalar, plus the one dated event that neither span
# can express.
#
#  (a) echr:PeriodConsidered is the period the Court itself took into account
#      under Article 6 § 1. It is not the wall-clock span of the narrated
#      proceedings and cannot be derived from one. The Court cuts the period at
#      the date the Convention entered into force for the respondent State, and
#      counts constitutional, supervisory-review and enforcement proceedings only
#      under conditions no set of dates records. In most length cases the
#      judgment states the period outright — "the period to be taken into
#      consideration began on 3 May 1994 and ended on 12 October 2001, lasting
#      seven years and five months" — so it is read, not computed, and
#      echr:coversProceeding records which instances it was made up of.
#
#      This is the one place the schema reads outside the facts: the period is
#      stated in the Court's reasoning. An extraction of it must anchor to a
#      paragraph of that part of the judgment through echr:hasSourceParagraph.
#
#  (b) echr:InactivityPeriod is a dormant stretch the facts single out. It
#      replaces the scalar it grew out of, which recorded how long a gap was but
#      neither when it fell nor which instance it fell in — the distinction the
#      pre-trial question rests on. It hangs off the proceeding rather than the
#      grievance, because a length grievance spans the chain while a dormant
#      stretch always sits inside one instance of it.
#
#  (c) echr:Adjournment is a hearing put off to a later date. It is not a period
#      and it is not inactivity: the court sat, and nothing was achieved. That is
#      a distinct phenomenon from dormancy and the commonest event-level cause of
#      delay in Article 6 length cases — three hearings adjourned for an absent
#      witness can consume a year inside a single instance without leaving a
#      dormant stretch anywhere. It is the one point-in-time event the schema
#      records; there is deliberately no general procedural-event class, because
#      the facts of a judgment are a dense chronology and modelling every dated
#      step would multiply extraction volume for far less return.
################################################################

echr:PeriodConsidered a owl:Class ;
    rdfs:label "Period Considered"@en ;
    skos:definition "The period the Court took into consideration in assessing whether the proceedings were concluded within a reasonable time."@en ;
    skos:scopeNote "Read from the Court's reasoning, not from the facts. Create one instance per set of proceedings the Court assessed as a unit; a case with parallel civil and criminal chains may have two."@en ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:InactivityPeriod a owl:Class ;
    rdfs:label "Inactivity Period"@en ;
    skos:definition "A stretch during which the facts record that nothing moved in the proceeding: no hearing listed, no step taken, the file left with an expert or an appellate registry."@en ;
    skos:scopeNote "Record a period only where the facts single the stretch out, either by asserting it (\"no hearing was held between February 1997 and September 2001\") or by narrating consecutive dated steps with an unexplained gap between them. Do not infer dormancy from silence in the narrative."@en ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:Adjournment a owl:Class ;
    rdfs:label "Adjournment"@en ;
    skos:definition "A hearing that was listed and then put off to a later date, as narrated in the facts."@en ;
    skos:scopeNote "Create one instance per adjournment the facts record, whether individually dated or given as a count (\"the hearing was adjourned on five occasions\"). Where only a count is given, create one node carrying echr:hasExtractionNote to say so rather than inventing dates. A hearing that did not take place because none was ever listed is not an adjournment; that is echr:InactivityPeriod."@en ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:PeriodStartBasis a owl:Class ;
    rdfs:label "Period Start Basis"@en ;
    skos:definition "Controlled vocabulary: what fixed the start of the period taken into consideration."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

#---------------------------------------------------------------
# 6.1 Period properties
#---------------------------------------------------------------

echr:hasPeriodConsidered a owl:ObjectProperty ;
    rdfs:label "has period considered"@en ;
    skos:definition "Attaches the Court's assessed period to the case."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:PeriodConsidered ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:coversProceeding a owl:ObjectProperty ;
    rdfs:label "covers proceeding"@en ;
    skos:definition "A proceeding the assessed period was made up of. Recording these is what distinguishes the Court's period from the wall-clock span of the chain: a proceeding narrated in the facts but not covered here was excluded from the assessment, and the exclusion is itself a finding."@en ;
    rdfs:domain echr:PeriodConsidered ;
    rdfs:range echr:DomesticProceeding ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasPeriodStartDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has period start date"@en ;
    skos:definition "Date from which the Court ran the period. Record only the precision the text gives."@en ;
    rdfs:domain echr:PeriodConsidered ;
    rdfs:range echr:PartialDate ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasPeriodEndDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has period end date"@en ;
    skos:definition "Date at which the Court closed the period. Omit where the proceedings were still pending; assert echr:isPeriodStillRunning instead."@en ;
    rdfs:domain echr:PeriodConsidered ;
    rdfs:range echr:PartialDate ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasStatedPeriodDuration a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has stated period duration"@en ;
    skos:definition "Length of the assessed period where the judgment states it in words, as an xsd:duration. Record it only when the text asserts it; the Court almost always does, and its figure governs over anything computed from the dates."@en ;
    rdfs:domain echr:PeriodConsidered ;
    rdfs:range xsd:duration ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasPeriodStartBasis a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has period start basis"@en ;
    skos:definition "What fixed the start of the period the Court took into consideration."@en ;
    rdfs:domain echr:PeriodConsidered ;
    rdfs:range echr:PeriodStartBasis ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasLevelsOfJurisdiction a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has levels of jurisdiction"@en ;
    skos:definition "The number of levels of jurisdiction the assessed period ran across, where the Court states it (\"two levels of jurisdiction\"). The Court uses it as the denominator against which a duration is judged, so the same elapsed time means different things at one level and at four."@en ;
    rdfs:domain echr:PeriodConsidered ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:isPeriodStillRunning a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "is period still running"@en ;
    skos:definition "True where the Court closed the period at the date of its own judgment because the domestic proceedings were still pending."@en ;
    rdfs:domain echr:PeriodConsidered ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasInactivityPeriod a owl:ObjectProperty ;
    rdfs:label "has inactivity period"@en ;
    skos:definition "A dormant stretch the facts single out within this proceeding."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:InactivityPeriod ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasInactivityStartDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has inactivity start date"@en ;
    skos:definition "Date of the last step before the stretch. Record only the precision the text gives."@en ;
    rdfs:domain echr:InactivityPeriod ;
    rdfs:range echr:PartialDate ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasInactivityEndDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has inactivity end date"@en ;
    skos:definition "Date of the first step after the stretch. Record only the precision the text gives."@en ;
    rdfs:domain echr:InactivityPeriod ;
    rdfs:range echr:PartialDate ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasStatedInactivityDuration a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has stated inactivity duration"@en ;
    skos:definition "Length of the dormant stretch where the judgment states it in words, as an xsd:duration. Do not compute this from the dates — record it only when the text asserts it."@en ;
    rdfs:domain echr:InactivityPeriod ;
    rdfs:range xsd:duration ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasInactivityCause a owl:ObjectProperty ;
    rdfs:label "has inactivity cause"@en ;
    skos:definition "To whom the facts attribute this particular stretch. Shares a vocabulary with echr:hasDelayAttribution, which carries the attribution for the grievance as a whole; this one carries it gap by gap."@en ;
    rdfs:domain echr:InactivityPeriod ;
    rdfs:range echr:DelayAttribution ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasAdjournment a owl:ObjectProperty ;
    rdfs:label "has adjournment"@en ;
    skos:definition "A hearing in this proceeding that was put off to a later date."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:Adjournment ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasAdjournmentDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has adjournment date"@en ;
    skos:definition "Date of the hearing that was adjourned. Record only the precision the text gives."@en ;
    rdfs:domain echr:Adjournment ;
    rdfs:range echr:PartialDate ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasResumptionDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has resumption date"@en ;
    skos:definition "Date the hearing was put off to, where the facts give it. The gap between this and echr:hasAdjournmentDate is what separates a fortnight's postponement from an eight-month one, and the facts often supply it only through the date of the next listed hearing."@en ;
    rdfs:domain echr:Adjournment ;
    rdfs:range echr:PartialDate ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasAdjournmentCause a owl:ObjectProperty ;
    rdfs:label "has adjournment cause"@en ;
    skos:definition "To whom the facts attribute this adjournment. Shares the echr:DelayAttribution vocabulary with echr:hasInactivityCause and echr:hasDelayAttribution, so that authority-caused and applicant-caused delay can be totalled across dormant stretches and adjournments alike."@en ;
    skos:scopeNote "The vocabulary is coarse by design: it records who the delay is laid at, not what went wrong. If a finer typology proves necessary — witness absent, counsel unavailable, expert report outstanding, bench not constituted — add it as a separate vocabulary after piloting, rather than by widening this one."@en ;
    rdfs:domain echr:Adjournment ;
    rdfs:range echr:DelayAttribution ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

#---------------------------------------------------------------
# 6.2 Period start basis
#---------------------------------------------------------------

echr:BasisArrest a echr:PeriodStartBasis ;
    skos:prefLabel "arrest or police custody"@en ;
    skos:definition "The period ran from the moment the applicant was arrested or taken into custody."@en ;
    skos:inScheme echr:PeriodStartBasisScheme .

echr:BasisOfficialNotification a echr:PeriodStartBasis ;
    skos:prefLabel "official notification of the charge"@en ;
    skos:definition "The period ran from formal notification of the accusation, or from another act by which the applicant was substantially affected — search, questioning as a suspect, freezing of assets."@en ;
    skos:inScheme echr:PeriodStartBasisScheme .

echr:BasisInstitutionOfAction a echr:PeriodStartBasis ;
    skos:prefLabel "institution of the action"@en ;
    skos:definition "The civil-limb default: the period ran from the lodging of the claim or the bringing of the dispute before the authority."@en ;
    skos:inScheme echr:PeriodStartBasisScheme .

echr:BasisEntryIntoForce a echr:PeriodStartBasis ;
    skos:prefLabel "entry into force for the respondent State"@en ;
    skos:definition "The period was cut at the date the Convention, or the right of individual petition, took effect for the respondent State; everything earlier lies outside the Court's competence ratione temporis. Worth recording separately: the assessed period is then shorter than the proceedings, and the case's own dates will not explain why."@en ;
    skos:inScheme echr:PeriodStartBasisScheme .

echr:BasisOther a echr:PeriodStartBasis ;
    skos:prefLabel "other"@en ;
    skos:inScheme echr:PeriodStartBasisScheme .

echr:BasisUnknown a echr:PeriodStartBasis ;
    skos:prefLabel "unknown"@en ;
    skos:definition "The judgment gives a start date without saying what fixed it."@en ;
    skos:inScheme echr:PeriodStartBasisScheme .

echr:PeriodStartBasisScheme a skos:ConceptScheme ;
    rdfs:label "Period start basis vocabulary"@en .

echr:PeriodStartBasis owl:equivalentClass [ a owl:Class ;
    owl:oneOf ( echr:BasisArrest echr:BasisOfficialNotification echr:BasisInstitutionOfAction
        echr:BasisEntryIntoForce echr:BasisOther echr:BasisUnknown ) ] .

################################################################
# 7. Object properties
################################################################

echr:hasDomesticProceeding a owl:ObjectProperty ;
    rdfs:label "has domestic proceeding"@en ;
    skos:definition "Attaches an extracted proceeding to the case being read."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:DomesticProceeding ;
    owl:inverseOf echr:isProceedingInCase ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:isProceedingInCase a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "is proceeding in case"@en ;
    skos:definition "Inverse of echr:hasDomesticProceeding; assert either direction."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:CaseDocument ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasApplicant a owl:ObjectProperty ;
    rdfs:label "has applicant"@en ;
    skos:definition "The party or parties who went on to apply to Strasbourg. Cases may have several; a company applicant is a party without being a natural person."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:Party ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:followsProceeding a owl:ObjectProperty, owl:AsymmetricProperty, owl:IrreflexiveProperty ;
    rdfs:label "follows proceeding"@en ;
    skos:definition "Links a proceeding to the one immediately before it in the domestic chain (an appeal follows the first-instance trial)."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:DomesticProceeding ;
    owl:inverseOf echr:precedesProceeding ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:precedesProceeding a owl:ObjectProperty, owl:AsymmetricProperty, owl:IrreflexiveProperty ;
    rdfs:label "precedes proceeding"@en ;
    skos:definition "Inverse of echr:followsProceeding; assert either direction."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:DomesticProceeding ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasCourt a owl:ObjectProperty ;
    rdfs:label "has court"@en ;
    skos:definition "The authority that decided the proceeding."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:DomesticAuthority ;
    owl:inverseOf echr:decidedProceeding ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:decidedProceeding a owl:ObjectProperty ;
    rdfs:label "decided proceeding"@en ;
    skos:definition "Inverse of echr:hasCourt: the proceedings determined by this authority."@en ;
    rdfs:domain echr:DomesticAuthority ;
    rdfs:range echr:DomesticProceeding ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasAuthorityKind a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has authority kind"@en ;
    skos:definition "What sort of body this authority is — judicial, prosecutorial, administrative or disciplinary."@en ;
    rdfs:domain echr:DomesticAuthority ;
    rdfs:range echr:AuthorityKind ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasSittingJudge a owl:ObjectProperty ;
    rdfs:label "has sitting judge"@en ;
    skos:definition "A judicial officer named in the facts as sitting in or conducting this proceeding."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:JudicialOfficer ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:isRepresentedBy a owl:ObjectProperty ;
    rdfs:label "is represented by"@en ;
    skos:definition "The lawyer, legal-aid counsel or guardian acting for this party in the domestic proceedings."@en ;
    rdfs:domain echr:Party ;
    rdfs:range echr:LegalRepresentative ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasInstanceLevel a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has instance level"@en ;
    skos:definition "Where this proceeding sat in the national hierarchy."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:InstanceLevel ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasProceedingType a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has proceeding type"@en ;
    skos:definition "The nature of this proceeding in domestic terms."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:ProceedingType ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasOutcome a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has outcome"@en ;
    skos:definition "The disposition that closed this proceeding at this instance."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:ProceedingOutcome ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasOutcomeDirection a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has outcome direction"@en ;
    skos:definition "Which way the disposition cut for the future applicant."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:OutcomeDirection ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasParticipation a owl:ObjectProperty ;
    rdfs:label "has participation"@en ;
    skos:definition "A party's involvement in this proceeding. One participation per party per instance; a party appearing at three instances has three."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:Participation ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:participatingParty a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "participating party"@en ;
    skos:definition "The party whose involvement this is."@en ;
    rdfs:domain echr:Participation ;
    rdfs:range echr:Party ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasPartySide a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has party side"@en ;
    skos:definition "Which side of this proceeding the party was on. Functional: a party has one side at one instance, and a party who changes side between instances does so by having a different value on a different participation."@en ;
    rdfs:domain echr:Participation ;
    rdfs:range echr:PartySide ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:raisesArticle6Issue a owl:ObjectProperty ;
    rdfs:label "raises Article 6 issue"@en ;
    skos:definition "Attaches a fair-trial grievance to the proceeding in which it arose."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:Article6Issue ;
    owl:inverseOf echr:issueArisesIn ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:issueArisesIn a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "issue arises in"@en ;
    skos:definition "Inverse of echr:raisesArticle6Issue; assert either direction."@en ;
    rdfs:domain echr:Article6Issue ;
    rdfs:range echr:DomesticProceeding ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:affectsParty a owl:ObjectProperty ;
    rdfs:label "affects party"@en ;
    skos:definition "The party whose fair-trial rights the grievance concerns. Usually the future applicant, but a co-accused or a company can be the one affected."@en ;
    rdfs:domain echr:Article6Issue ;
    rdfs:range echr:Party ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasDelayAttribution a owl:ObjectProperty ;
    rdfs:label "has delay attribution"@en ;
    skos:definition "To whom the facts attribute the delay, taking the grievance as a whole. Where the facts attribute individual dormant stretches separately, record those on the stretch with echr:hasInactivityCause."@en ;
    rdfs:domain echr:Article6Issue ;
    rdfs:range echr:DelayAttribution ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

################################################################
# 8. Datatype properties
################################################################

echr:hasName a owl:DatatypeProperty ;
    rdfs:label "has name"@en ;
    skos:definition "A designation as written in the case text. Generic parent of the specific name properties below."@en ;
    rdfs:subPropertyOf foaf:name ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasAuthorityName a owl:DatatypeProperty ;
    rdfs:label "has authority name"@en ;
    skos:definition "Name of the court or authority exactly as written in the case text."@en ;
    rdfs:subPropertyOf echr:hasName ;
    rdfs:domain echr:DomesticAuthority ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasPartyName a owl:DatatypeProperty ;
    rdfs:label "has party name"@en ;
    skos:definition "Name or designation of the party as written in the case text (often initials or \"the applicant\")."@en ;
    rdfs:subPropertyOf echr:hasName ;
    rdfs:domain echr:Party ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasPersonName a owl:DatatypeProperty ;
    rdfs:label "has person name"@en ;
    skos:definition "Full designation of a natural person as written in the case text, including any honorific: \"Mr Rusi Kosev Stanev\", \"Ms A. Genova\", \"the applicant\"."@en ;
    rdfs:subPropertyOf echr:hasName ;
    rdfs:domain echr:NaturalPerson ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasGivenName a owl:DatatypeProperty ;
    rdfs:label "has given name"@en ;
    skos:definition "The given name or its initial, separated out from the full designation. Recorded because it is often the only name-based cue available, and because separating it makes name-based gender inference visible rather than implicit."@en ;
    rdfs:subPropertyOf echr:hasName ;
    rdfs:domain echr:NaturalPerson ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasSurname a owl:DatatypeProperty ;
    rdfs:label "has surname"@en ;
    skos:definition "The family name, separated out from the full designation."@en ;
    rdfs:subPropertyOf echr:hasName ;
    rdfs:domain echr:NaturalPerson ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

#---------------------------------------------------------------
# Age
#
# Recorded far more simply than gender, because it is stated rather than inferred:
# Strasbourg judgments conventionally open the facts with a year of birth. There is
# no cue apparatus here and none is needed — an age is in the text or it is absent.
# Nothing here is ever computed: not from the other properties, and not from the
# dates the schema already carries.
#---------------------------------------------------------------

echr:hasBirthYear a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has birth year"@en ;
    skos:definition "The year of birth the judgment states. Strasbourg judgments conventionally open the facts with it (\"The applicant was born in 1954 and lives in Sofia\"), which makes it the one age datum that is nearly always available and rarely ambiguous. Record only what the text states; do not derive it from a stated age."@en ;
    rdfs:domain echr:NaturalPerson ;
    rdfs:range xsd:gYear ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasStatedAge a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has stated age"@en ;
    skos:definition "An age in years the facts assert for the person (\"the applicant, then aged 11\"). Do not compute this from echr:hasBirthYear and a date — record it only where the text asserts it."@en ;
    skos:scopeNote "Functional, because the schema has nowhere to hang the moment an age was true of. Where the facts give ages at more than one point, record the one the grievance turns on and say so with echr:hasExtractionNote. Age at any dated event is better derived downstream from echr:hasBirthYear against the proceeding and detention dates the schema already carries."@en ;
    rdfs:domain echr:NaturalPerson ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:wasMinorAtMaterialTime a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "was minor at material time"@en ;
    skos:definition "True where the facts describe the person as a child, minor or juvenile at the time of the events or the proceedings. Recorded separately because it is what Article 6 turns on where it turns on age at all — effective participation, and the conduct of a trial against a child defendant."@en ;
    skos:scopeNote "Assert only where the text says so, or states an age plainly below majority. Do not infer it by computing from echr:hasBirthYear against an assumed domestic age of majority."@en ;
    rdfs:domain echr:NaturalPerson ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasProceedingStartDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has proceeding start date"@en ;
    skos:definition "Date the proceeding was instituted, where the facts give one. Record only the precision the text gives."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:PartialDate ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasDecisionDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has decision date"@en ;
    skos:definition "Date of the decision closing the proceeding at this instance. Record only the precision the text gives."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:PartialDate ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasStatedDuration a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has stated duration"@en ;
    skos:definition "Length of the proceeding where the judgment states it in words (\"the proceedings lasted seven years and four months\"), as an xsd:duration. Do not compute this from the dates — record it only when the text asserts it."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range xsd:duration ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:isPending a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "is pending"@en ;
    skos:definition "True where the facts present the proceeding as still undecided at the time of the Strasbourg judgment."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:isFinalDomesticDecision a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "is final domestic decision"@en ;
    skos:definition "True for the proceeding whose decision the facts present as the last domestic one before the application to Strasbourg."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasJurisdictionState a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has jurisdiction state"@en ;
    skos:definition "The State whose legal order the authority belongs to, as named in the text (\"Bulgaria\"). The principal control variable for anything measured across the corpus: pre-trial structure, detention practice and typical case duration vary far more between respondent States than within them."@en ;
    rdfs:domain echr:DomesticAuthority ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasIssueDescription a owl:DatatypeProperty ;
    rdfs:label "has issue description"@en ;
    skos:definition "The grievance in the words of the facts, or a close paraphrase."@en ;
    rdfs:subPropertyOf dcterms:description ;
    rdfs:domain echr:Article6Issue ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasHudocId a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has HUDOC id"@en ;
    skos:definition "The HUDOC document identifier of the judgment, e.g. \"001-108690\"."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasApplicationNumber a owl:DatatypeProperty ;
    rdfs:label "has application number"@en ;
    skos:definition "The Strasbourg application number, e.g. \"36760/06\". Joined cases carry several."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasCaseName a owl:DatatypeProperty ;
    rdfs:label "has case name"@en ;
    skos:definition "The case title as printed, e.g. \"Stanev v. Bulgaria\". Note that an anonymised title (\"A.B. v. Croatia\") is itself a signal that the applicant is anonymised."@en ;
    rdfs:subPropertyOf echr:hasName ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasRespondentState a owl:DatatypeProperty ;
    rdfs:label "has respondent state"@en ;
    skos:definition "The State against which the application was lodged, as named in the judgment."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasJudgmentDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has judgment date"@en ;
    skos:definition "Date the Strasbourg judgment was delivered."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:PartialDate ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

################################################################
# 9. Evidence anchoring
#
# Applies to any extracted node. Judgments number their paragraphs, so an extracted
# assertion can always be traced back to one; recording the anchor is what makes an
# extraction checkable against the source rather than merely plausible.
################################################################

echr:hasSupportingQuote a owl:DatatypeProperty ;
    rdfs:label "has supporting quote"@en ;
    skos:definition "The passage of the case text the extracted node rests on, verbatim and short. One node may carry several."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasSourceParagraph a owl:DatatypeProperty ;
    rdfs:label "has source paragraph"@en ;
    skos:definition "The numbered paragraph of the judgment the node was read from, as printed (\"1\", \"42\", \"§ 42\")."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

echr:hasExtractionNote a owl:DatatypeProperty ;
    rdfs:label "has extraction note"@en ;
    skos:definition "A short note on why a value was hard to settle: conflicting cues, an ambiguous pronoun antecedent, a date given only approximately."@en ;
    rdfs:subPropertyOf skos:note ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://growgraph.dev/echr> .

################################################################
# 10. Controlled vocabulary members
################################################################

#---------------------------------------------------------------
# 10.1 Instance level
#---------------------------------------------------------------

echr:LevelInvestigative a echr:InstanceLevel ;
    skos:prefLabel "investigative or pre-trial"@en ;
    skos:definition "Preliminary investigation, prosecutorial inquiry or committal stage before any trial."@en ;
    skos:inScheme echr:InstanceLevelScheme .

echr:LevelAdministrativeReview a echr:InstanceLevel ;
    skos:prefLabel "administrative or quasi-judicial review"@en ;
    skos:definition "A decision by an administrative body, commission, board or disciplinary panel preceding judicial review."@en ;
    skos:inScheme echr:InstanceLevelScheme .

echr:LevelFirstInstance a echr:InstanceLevel ;
    skos:prefLabel "first instance"@en ;
    skos:definition "The first court to try the merits: district court, regional court of first instance, tribunal of first instance."@en ;
    skos:inScheme echr:InstanceLevelScheme .

echr:LevelAppeal a echr:InstanceLevel ;
    skos:prefLabel "appeal"@en ;
    skos:definition "An ordinary appeal on fact and law to a higher court."@en ;
    skos:inScheme echr:InstanceLevelScheme .

echr:LevelCassation a echr:InstanceLevel ;
    skos:prefLabel "cassation or supreme court"@en ;
    skos:definition "Review on points of law by a court of cassation or supreme court."@en ;
    skos:inScheme echr:InstanceLevelScheme .

echr:LevelConstitutional a echr:InstanceLevel ;
    skos:prefLabel "constitutional court"@en ;
    skos:definition "Proceedings before a constitutional court, including individual constitutional complaints."@en ;
    skos:inScheme echr:InstanceLevelScheme .

echr:LevelSupervisoryReview a echr:InstanceLevel ;
    skos:prefLabel "supervisory review"@en ;
    skos:definition "Extraordinary review of a final judgment on a prosecutor's or president's application, characteristic of post-Soviet systems."@en ;
    skos:inScheme echr:InstanceLevelScheme .

echr:LevelReopening a echr:InstanceLevel ;
    skos:prefLabel "reopening or retrial"@en ;
    skos:definition "Proceedings reopened after a final decision, or a retrial following remittal."@en ;
    skos:inScheme echr:InstanceLevelScheme .

echr:LevelEnforcement a echr:InstanceLevel ;
    skos:prefLabel "enforcement"@en ;
    skos:definition "Proceedings to enforce a judgment already given."@en ;
    skos:inScheme echr:InstanceLevelScheme .

echr:LevelUnknown a echr:InstanceLevel ;
    skos:prefLabel "unknown"@en ;
    skos:definition "The facts do not place the proceeding in the hierarchy."@en ;
    skos:inScheme echr:InstanceLevelScheme .

echr:InstanceLevelScheme a skos:ConceptScheme ;
    rdfs:label "Instance level vocabulary"@en .

echr:InstanceLevel owl:equivalentClass [ a owl:Class ;
    owl:oneOf ( echr:LevelInvestigative echr:LevelAdministrativeReview echr:LevelFirstInstance
        echr:LevelAppeal echr:LevelCassation echr:LevelConstitutional echr:LevelSupervisoryReview
        echr:LevelReopening echr:LevelEnforcement echr:LevelUnknown ) ] .

#---------------------------------------------------------------
# 10.2 Proceeding type
#---------------------------------------------------------------

echr:TypeCriminal a echr:ProceedingType ;
    skos:prefLabel "criminal"@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:TypeCivil a echr:ProceedingType ;
    skos:prefLabel "civil"@en ;
    skos:definition "Private-law litigation between parties: contract, tort, debt, personal injury."@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:TypeAdministrative a echr:ProceedingType ;
    skos:prefLabel "administrative"@en ;
    skos:definition "Litigation against a public authority over a decision, licence, permit or measure."@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:TypeConstitutional a echr:ProceedingType ;
    skos:prefLabel "constitutional"@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:TypeDisciplinary a echr:ProceedingType ;
    skos:prefLabel "disciplinary"@en ;
    skos:definition "Professional or institutional discipline — of lawyers, judges, officers, prisoners. Often criminal under the Engel criteria despite the domestic label."@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:TypeLabour a echr:ProceedingType ;
    skos:prefLabel "labour or employment"@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:TypeFamily a echr:ProceedingType ;
    skos:prefLabel "family"@en ;
    skos:definition "Divorce, custody, contact, adoption, maintenance."@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:TypeGuardianship a echr:ProceedingType ;
    skos:prefLabel "guardianship or legal capacity"@en ;
    skos:definition "Placement under guardianship, restoration of legal capacity, involuntary placement in care. Article 6 access-to-court questions arise sharply here because the person concerned may have no standing to bring the action."@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:TypeProperty a echr:ProceedingType ;
    skos:prefLabel "property or restitution"@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:TypeSocialSecurity a echr:ProceedingType ;
    skos:prefLabel "social security or welfare"@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:TypeTax a echr:ProceedingType ;
    skos:prefLabel "tax or customs"@en ;
    skos:definition "Tax assessment and tax-penalty proceedings. Tax surcharges are frequently criminal under the Engel criteria."@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:TypeStateLiability a echr:ProceedingType ;
    skos:prefLabel "state liability or compensation"@en ;
    skos:definition "Claims for damages against the State, including domestic remedies for excessive length of proceedings."@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:TypeAsylumOrImmigration a echr:ProceedingType ;
    skos:prefLabel "asylum or immigration"@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:TypeElectoral a echr:ProceedingType ;
    skos:prefLabel "electoral"@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:TypeOther a echr:ProceedingType ;
    skos:prefLabel "other"@en ;
    skos:definition "A proceeding the facts describe clearly but which fits none of the above."@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:TypeUnknown a echr:ProceedingType ;
    skos:prefLabel "unknown"@en ;
    skos:definition "The facts do not say what kind of proceeding this was."@en ;
    skos:inScheme echr:ProceedingTypeScheme .

echr:ProceedingTypeScheme a skos:ConceptScheme ;
    rdfs:label "Proceeding type vocabulary"@en .

echr:ProceedingType owl:equivalentClass [ a owl:Class ;
    owl:oneOf ( echr:TypeCriminal echr:TypeCivil echr:TypeAdministrative echr:TypeConstitutional
        echr:TypeDisciplinary echr:TypeLabour echr:TypeFamily echr:TypeGuardianship echr:TypeProperty
        echr:TypeSocialSecurity echr:TypeTax echr:TypeStateLiability echr:TypeAsylumOrImmigration
        echr:TypeElectoral echr:TypeOther echr:TypeUnknown ) ] .

#---------------------------------------------------------------
# 10.3 Proceeding outcome
#---------------------------------------------------------------

echr:OutcomeConviction a echr:ProceedingOutcome ;
    skos:prefLabel "conviction"@en ;
    skos:inScheme echr:ProceedingOutcomeScheme .

echr:OutcomeAcquittal a echr:ProceedingOutcome ;
    skos:prefLabel "acquittal"@en ;
    skos:inScheme echr:ProceedingOutcomeScheme .

echr:OutcomeClaimGranted a echr:ProceedingOutcome ;
    skos:prefLabel "claim granted"@en ;
    skos:definition "The court upheld the claim or application, wholly or in substance."@en ;
    skos:inScheme echr:ProceedingOutcomeScheme .

echr:OutcomeClaimDismissed a echr:ProceedingOutcome ;
    skos:prefLabel "claim dismissed"@en ;
    skos:inScheme echr:ProceedingOutcomeScheme .

echr:OutcomeClaimPartlyGranted a echr:ProceedingOutcome ;
    skos:prefLabel "claim partly granted"@en ;
    skos:inScheme echr:ProceedingOutcomeScheme .

echr:OutcomeDeclaredInadmissible a echr:ProceedingOutcome ;
    skos:prefLabel "declared inadmissible"@en ;
    skos:definition "Rejected without examination of the merits — no standing, out of time, wrong forum."@en ;
    skos:inScheme echr:ProceedingOutcomeScheme .

echr:OutcomeRefusedExamination a echr:ProceedingOutcome ;
    skos:prefLabel "examination refused"@en ;
    skos:definition "The authority declined to entertain the matter at all: refused to register the action, refused leave to appeal, returned the request unanswered. The characteristic disposition behind an access-to-court grievance."@en ;
    skos:inScheme echr:ProceedingOutcomeScheme .

echr:OutcomeDiscontinued a echr:ProceedingOutcome ;
    skos:prefLabel "discontinued"@en ;
    skos:definition "Ended without decision on the merits: withdrawn, time-barred, abated on death, amnestied."@en ;
    skos:inScheme echr:ProceedingOutcomeScheme .

echr:OutcomeSettled a echr:ProceedingOutcome ;
    skos:prefLabel "settled"@en ;
    skos:inScheme echr:ProceedingOutcomeScheme .

echr:OutcomeQuashedAndRemitted a echr:ProceedingOutcome ;
    skos:prefLabel "quashed and remitted"@en ;
    skos:definition "The decision below was set aside and the matter sent back for fresh examination."@en ;
    skos:inScheme echr:ProceedingOutcomeScheme .

echr:OutcomeUpheldOnAppeal a echr:ProceedingOutcome ;
    skos:prefLabel "decision below upheld"@en ;
    skos:inScheme echr:ProceedingOutcomeScheme .

echr:OutcomeMeasureImposed a echr:ProceedingOutcome ;
    skos:prefLabel "measure imposed"@en ;
    skos:definition "A non-penal measure was ordered: guardianship, placement in an institution, a disciplinary sanction, a fine."@en ;
    skos:inScheme echr:ProceedingOutcomeScheme .

echr:OutcomePending a echr:ProceedingOutcome ;
    skos:prefLabel "pending"@en ;
    skos:definition "No decision had been given at the time of the Strasbourg judgment."@en ;
    skos:inScheme echr:ProceedingOutcomeScheme .

echr:OutcomeOther a echr:ProceedingOutcome ;
    skos:prefLabel "other"@en ;
    skos:definition "The facts state plainly how the proceeding ended, but the disposition fits none of the above. Record echr:hasExtractionNote so the gap in the vocabulary can be seen and closed."@en ;
    skos:inScheme echr:ProceedingOutcomeScheme .

echr:OutcomeUnknown a echr:ProceedingOutcome ;
    skos:prefLabel "unknown"@en ;
    skos:definition "The facts do not say how the proceeding ended. Distinct from echr:OutcomeOther, which is a positive reading of a disposition the vocabulary cannot name."@en ;
    skos:inScheme echr:ProceedingOutcomeScheme .

echr:ProceedingOutcomeScheme a skos:ConceptScheme ;
    rdfs:label "Proceeding outcome vocabulary"@en .

echr:ProceedingOutcome owl:equivalentClass [ a owl:Class ;
    owl:oneOf ( echr:OutcomeConviction echr:OutcomeAcquittal echr:OutcomeClaimGranted
        echr:OutcomeClaimDismissed echr:OutcomeClaimPartlyGranted echr:OutcomeDeclaredInadmissible
        echr:OutcomeRefusedExamination echr:OutcomeDiscontinued echr:OutcomeSettled
        echr:OutcomeQuashedAndRemitted echr:OutcomeUpheldOnAppeal echr:OutcomeMeasureImposed
        echr:OutcomePending echr:OutcomeOther echr:OutcomeUnknown ) ] .

#---------------------------------------------------------------
# 10.4 Outcome direction
#---------------------------------------------------------------

echr:DirectionFavourableToApplicant a echr:OutcomeDirection ;
    skos:prefLabel "favourable to the applicant"@en ;
    skos:inScheme echr:OutcomeDirectionScheme .

echr:DirectionUnfavourableToApplicant a echr:OutcomeDirection ;
    skos:prefLabel "unfavourable to the applicant"@en ;
    skos:inScheme echr:OutcomeDirectionScheme .

echr:DirectionMixed a echr:OutcomeDirection ;
    skos:prefLabel "mixed"@en ;
    skos:inScheme echr:OutcomeDirectionScheme .

echr:DirectionUnknown a echr:OutcomeDirection ;
    skos:prefLabel "unknown"@en ;
    skos:inScheme echr:OutcomeDirectionScheme .

echr:OutcomeDirectionScheme a skos:ConceptScheme ;
    rdfs:label "Outcome direction vocabulary"@en .

echr:OutcomeDirection owl:equivalentClass [ a owl:Class ;
    owl:oneOf ( echr:DirectionFavourableToApplicant echr:DirectionUnfavourableToApplicant
        echr:DirectionMixed echr:DirectionUnknown ) ] .

#---------------------------------------------------------------
# 10.5 Party side
#
# Four values replacing a thirteen-member role vocabulary that mixed three
# unrelated distinctions: Convention status (which is echr:hasApplicant on the
# case), which side a party was on, and which instance they were at. Only the
# second is a capacity, and it now lives on echr:Participation, so it is anchored
# to one proceeding instead of accumulating across the chain.
#---------------------------------------------------------------

echr:SideInitiating a echr:PartySide ;
    skos:prefLabel "initiating party"@en ;
    skos:definition "The party who moved the authority to act at this instance: the claimant or plaintiff in civil proceedings, the prosecution in criminal proceedings, the appellant on appeal, the applicant for supervisory review or reopening."@en ;
    skos:inScheme echr:PartySideScheme .

echr:SideResponding a echr:PartySide ;
    skos:prefLabel "responding party"@en ;
    skos:definition "The party the proceeding was brought against at this instance: the defendant in civil proceedings, the accused in criminal proceedings, the respondent on appeal."@en ;
    skos:inScheme echr:PartySideScheme .

echr:SideThirdParty a echr:PartySide ;
    skos:prefLabel "third party"@en ;
    skos:definition "A party joined to the proceeding without being on either side of the principal dispute: an intervener, a civil party joined to a criminal trial, a public body appearing to be heard."@en ;
    skos:inScheme echr:PartySideScheme .

echr:SideUnknown a echr:PartySide ;
    skos:prefLabel "unknown"@en ;
    skos:definition "The facts place the party in the proceeding but not on a side. The expected value where a judgment names a body without saying what it was doing there."@en ;
    skos:inScheme echr:PartySideScheme .

echr:PartySideScheme a skos:ConceptScheme ;
    rdfs:label "Party side vocabulary"@en .

echr:PartySide owl:equivalentClass [ a owl:Class ;
    owl:oneOf ( echr:SideInitiating echr:SideResponding echr:SideThirdParty echr:SideUnknown ) ] .

#---------------------------------------------------------------
# 10.6 Authority kind
#---------------------------------------------------------------

echr:AuthorityJudicial a echr:AuthorityKind ;
    skos:prefLabel "judicial"@en ;
    skos:definition "A court or tribunal, of whatever rank or specialism. Rank is recorded on the proceedings it decided, through echr:hasInstanceLevel."@en ;
    skos:inScheme echr:AuthorityKindScheme .

echr:AuthorityProsecutorial a echr:AuthorityKind ;
    skos:prefLabel "prosecutorial or investigative"@en ;
    skos:definition "A prosecutor's office, investigator or investigating authority. The distinction that matters most in the pre-trial phase: whether custody and the progress of the investigation were controlled by a court or by the body conducting the prosecution."@en ;
    skos:inScheme echr:AuthorityKindScheme .

echr:AuthorityAdministrative a echr:AuthorityKind ;
    skos:prefLabel "administrative"@en ;
    skos:definition "A ministry, agency, commission or municipal organ deciding in the first place, outside the court system."@en ;
    skos:inScheme echr:AuthorityKindScheme .

echr:AuthorityDisciplinary a echr:AuthorityKind ;
    skos:prefLabel "disciplinary or professional"@en ;
    skos:definition "A professional body or institutional panel exercising disciplinary power over its own members or over persons in its charge."@en ;
    skos:inScheme echr:AuthorityKindScheme .

echr:AuthorityUnknown a echr:AuthorityKind ;
    skos:prefLabel "unknown"@en ;
    skos:definition "The facts name the body but give no basis for saying what sort it is."@en ;
    skos:inScheme echr:AuthorityKindScheme .

echr:AuthorityKindScheme a skos:ConceptScheme ;
    rdfs:label "Authority kind vocabulary"@en .

echr:AuthorityKind owl:equivalentClass [ a owl:Class ;
    owl:oneOf ( echr:AuthorityJudicial echr:AuthorityProsecutorial echr:AuthorityAdministrative
        echr:AuthorityDisciplinary echr:AuthorityUnknown ) ] .

#---------------------------------------------------------------
# 10.7 Delay attribution
#---------------------------------------------------------------

echr:DelayAttributedToAuthorities a echr:DelayAttribution ;
    skos:prefLabel "attributed to the authorities"@en ;
    skos:definition "Dormant periods, repeated remittals, adjournments ordered by the court, slowness of experts appointed by it."@en ;
    skos:inScheme echr:DelayAttributionScheme .

echr:DelayAttributedToApplicant a echr:DelayAttribution ;
    skos:prefLabel "attributed to the applicant"@en ;
    skos:definition "Requests for adjournment, changes of counsel, failure to appear, dilatory appeals."@en ;
    skos:inScheme echr:DelayAttributionScheme .

echr:DelayAttributedToComplexity a echr:DelayAttribution ;
    skos:prefLabel "attributed to the complexity of the case"@en ;
    skos:inScheme echr:DelayAttributionScheme .

echr:DelayUnattributed a echr:DelayAttribution ;
    skos:prefLabel "unattributed"@en ;
    skos:definition "The facts record the delay without assigning responsibility for it."@en ;
    skos:inScheme echr:DelayAttributionScheme .

echr:DelayAttributionScheme a skos:ConceptScheme ;
    rdfs:label "Delay attribution vocabulary"@en .

echr:DelayAttribution owl:equivalentClass [ a owl:Class ;
    owl:oneOf ( echr:DelayAttributedToAuthorities echr:DelayAttributedToApplicant
        echr:DelayAttributedToComplexity echr:DelayUnattributed ) ] .
