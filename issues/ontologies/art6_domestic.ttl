@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix echr:    <https://github.com/dahrb/Art_6/tree/main/ontology/seed.ttl#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix wd:      <http://www.wikidata.org/entity/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

################################################################
# Ontology header
################################################################

<https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> a owl:Ontology ;
    rdfs:label "ECHR Art. 6 — Domestic Proceedings & HUDOC Metadata Ontology"@en ;
    dcterms:title "ECHR Art. 6 — Domestic Proceedings & HUDOC Metadata Ontology"@en ;
    dcterms:description """A condensed T-Box for Article 6 ECHR research. It covers two scopes only:
(1) the domestic proceedings that precede an application to the Strasbourg Court — instances, deciding
authorities, dates and durations, outcomes, remedies/exhaustion, and the fair-trial issues raised; and
(2) the HUDOC metadata already held in the processed Art. 6 dataset.
Terms are minted in the seed.ttl namespace so that existing A-Box graphs (metadata.ttl) stay conformant;
this ontology supersedes seed.ttl v3.0 and drops its speculative, unpopulated branches."""@en ;
    dcterms:created "2026-07-24T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespaceUri "https://github.com/dahrb/Art_6/tree/main/ontology/seed.ttl#" ;
    vann:preferredNamespacePrefix "echr" ;
    owl:priorVersion <https://github.com/dahrb/Art_6/tree/main/ontology/seed.ttl> ;
    owl:versionIRI <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl/4.0.0> ;
    owl:versionInfo "4.0.0" .

################################################################
# 1. Case record (HUDOC document layer)
################################################################

echr:CaseDocument a owl:Class ;
    rdfs:label "Case Document"@en ;
    skos:definition "A single Strasbourg case record, corresponding to one row of the processed Art. 6 HUDOC dataset."@en ;
    skos:closeMatch wd:Q2334719 ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> ;
    owl:hasKey ( echr:hasItemId ) .

echr:Judgment a owl:Class ;
    rdfs:label "Judgment"@en ;
    skos:definition "Case document whose HUDOC source collection is judgments."@en ;
    skos:closeMatch wd:Q3769186 ;
    rdfs:subClassOf echr:CaseDocument ;
    owl:disjointWith echr:Decision ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:Decision a owl:Class ;
    rdfs:label "Decision"@en ;
    skos:definition "Case document whose HUDOC source collection is decisions (typically admissibility)."@en ;
    skos:closeMatch wd:Q327000 ;
    rdfs:subClassOf echr:CaseDocument ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:Application a owl:Class ;
    rdfs:label "Application"@en ;
    skos:definition "An application lodged with the Court, identified by its normalised application number."@en ;
    skos:closeMatch wd:Q56759633 ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> ;
    owl:hasKey ( echr:hasApplicationNumber ) .

echr:ConventionArticle a owl:Class ;
    rdfs:label "Convention Article"@en ;
    skos:definition "A Convention article or sub-provision (e.g. 6, 6-1, 6-3-c, P1-1)."@en ;
    rdfs:subClassOf skos:Concept ;
    skos:closeMatch wd:Q712597 ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:Keyword a owl:Class ;
    rdfs:label "Thesaurus Keyword"@en ;
    skos:definition "A HUDOC (kpthesaurus) controlled indexing concept."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:LegalFinding a owl:Class ;
    rdfs:label "Legal Finding"@en ;
    skos:definition "A structured outcome statement derived from the conclusion/violation metadata of a case."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:Violation a owl:Class ;
    rdfs:label "Violation"@en ;
    skos:definition "Finding that a violation of the referenced Convention article occurred."@en ;
    rdfs:subClassOf echr:LegalFinding ;
    owl:disjointWith echr:NonViolation ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:NonViolation a owl:Class ;
    rdfs:label "Non-Violation"@en ;
    skos:definition "Finding that no violation of the referenced Convention article occurred."@en ;
    rdfs:subClassOf echr:LegalFinding ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:Judge a owl:Class ;
    rdfs:label "Judge"@en ;
    skos:definition "A judge of the Court sitting on a case, normalised across rows via judges_id."@en ;
    rdfs:subClassOf foaf:Person ;
    skos:closeMatch wd:Q16533 ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> ;
    owl:hasKey ( echr:hasJudgeId ) .

echr:CourtFormation a owl:Class ;
    rdfs:label "Court Formation"@en ;
    skos:definition "The originating body of the case document (e.g. Court (Grand Chamber), Court (First Section), Commission)."@en ;
    rdfs:subClassOf foaf:Organization ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:Country a owl:Class ;
    rdfs:label "Country"@en ;
    skos:definition "A state, used for respondent states, judge nationalities and the jurisdiction of domestic authorities."@en ;
    skos:closeMatch wd:Q3624078 ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:Party a owl:Class ;
    rdfs:label "Party"@en ;
    skos:definition "A party to the domestic proceedings and/or the applicant before the Court."@en ;
    rdfs:subClassOf foaf:Agent ;
    skos:closeMatch wd:Q12648988 ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:LegalRepresentative a owl:Class ;
    rdfs:label "Legal Representative"@en ;
    skos:definition "Counsel acting for a party, domestically or before the Court."@en ;
    rdfs:subClassOf foaf:Person ;
    skos:closeMatch wd:Q40348 ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

################################################################
# 2. Domestic proceedings (pre-Strasbourg lifecycle)
################################################################

echr:DomesticProceeding a owl:Class ;
    rdfs:label "Domestic Proceeding"@en ;
    skos:definition "One instance of proceedings before a national court or authority in the lifecycle of the case prior to the application to the Court."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:DomesticAuthority a owl:Class ;
    rdfs:label "Domestic Authority"@en ;
    skos:definition "A national court, tribunal or other authority determining a domestic proceeding."@en ;
    rdfs:subClassOf foaf:Organization ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:Article6Issue a owl:Class ;
    rdfs:label "Article 6 Issue"@en ;
    skos:definition "A fair-trial complaint attributed to a domestic proceeding: a typed grievance (e.g. excessive length, lack of impartiality) tied to the Article 6 sub-provision it engages."@en ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:Law a owl:Class ;
    rdfs:label "Law Source"@en ;
    skos:definition "A legal source relied on in a proceeding or cited by a case document."@en ;
    skos:closeMatch wd:Q7748 ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:DomesticLaw a owl:Class ;
    rdfs:label "Domestic Law"@en ;
    skos:definition "National legal source applied in the domestic proceedings."@en ;
    rdfs:subClassOf echr:Law ;
    skos:closeMatch wd:Q1668641 ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

################################################################
# 3. Controlled vocabulary classes
################################################################

echr:ChamberType a owl:Class ;
    rdfs:label "Chamber Type"@en ;
    skos:definition "Normalised court level of the Strasbourg formation (court_level)."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:ImportanceLevel a owl:Class ;
    rdfs:label "Importance Level"@en ;
    skos:definition "HUDOC case importance score (1-4)."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:JudgmentType a owl:Class ;
    rdfs:label "Judgment Type"@en ;
    skos:definition "HUDOC document type (judgment_type)."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:LawSystem a owl:Class ;
    rdfs:label "Law System"@en ;
    skos:definition "Legal tradition of the respondent state (law_system)."@en ;
    rdfs:subClassOf skos:Concept ;
    skos:closeMatch wd:Q2478386 ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:Article6Limb a owl:Class ;
    rdfs:label "Article 6 Limb"@en ;
    skos:definition "Limb of Article 6 engaged by the case (article_6_limb)."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:SeparateOpinionIndicator a owl:Class ;
    rdfs:label "Separate Opinion Indicator"@en ;
    skos:definition "Whether a separate opinion is appended (separateopinion)."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:InstanceLevel a owl:Class ;
    rdfs:label "Instance Level"@en ;
    skos:definition "Position of a domestic proceeding in the national court hierarchy."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:ProceedingType a owl:Class ;
    rdfs:label "Proceeding Type"@en ;
    skos:definition "Nature of the domestic proceeding, which conditions whether the civil or criminal limb of Article 6 applies."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:ProceedingOutcome a owl:Class ;
    rdfs:label "Proceeding Outcome"@en ;
    skos:definition "Result of a domestic proceeding from the applicant's perspective."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:Article6IssueType a owl:Class ;
    rdfs:label "Article 6 Issue Type"@en ;
    skos:definition "Controlled typology of fair-trial grievances arising in domestic proceedings."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:RemedyExhaustionStatus a owl:Class ;
    rdfs:label "Remedy Exhaustion Status"@en ;
    skos:definition "Status of the Article 35 § 1 requirement to exhaust domestic remedies."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

[] a owl:AllDisjointClasses ;
    owl:members ( echr:CaseDocument echr:Application echr:DomesticProceeding echr:DomesticAuthority
                  echr:Article6Issue echr:LegalFinding echr:Judge echr:Party echr:Law ) .

################################################################
# 4. Object properties — case document (HUDOC)
################################################################

echr:hasApplication a owl:ObjectProperty ;
    rdfs:label "has application"@en ;
    skos:definition "Application number(s) under which the case was registered (case_appno)."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:Application ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:referencesSecondaryApplication a owl:ObjectProperty ;
    rdfs:label "references secondary application"@en ;
    skos:definition "Additional applications joined to or cross-referenced by the case (secondary_appno)."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:Application ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:citesApplication a owl:ObjectProperty ;
    rdfs:label "cites application"@en ;
    skos:definition "Application-level citation edge derived from cited_appno."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:Application ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:citesCase a owl:ObjectProperty ;
    rdfs:label "cites case"@en ;
    skos:definition "Citation edge to another case document, resolved from cited application numbers."@en ;
    rdfs:subPropertyOf dcterms:references ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:CaseDocument ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:concernsArticle a owl:ObjectProperty ;
    rdfs:label "concerns article"@en ;
    skos:definition "Convention articles engaged by the case (article)."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:ConventionArticle ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasArticle6Limb a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has Article 6 limb"@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:Article6Limb ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasChamberType a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has chamber type"@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:ChamberType ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasCourtFormation a owl:ObjectProperty ;
    rdfs:label "has court formation"@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:CourtFormation ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasImportanceLevel a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has importance level"@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:ImportanceLevel ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasJudgmentType a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has judgment type"@en ;
    rdfs:subPropertyOf dcterms:type ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:JudgmentType ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasLawSystem a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has law system"@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:LawSystem ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasRespondentState a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has respondent state"@en ;
    skos:definition "State against which the application is directed (respondent); also the jurisdiction of the domestic proceedings."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:Country ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasSeparateOpinion a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has separate opinion"@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:SeparateOpinionIndicator ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasKeyword a owl:ObjectProperty ;
    rdfs:label "has keyword"@en ;
    skos:definition "Thesaurus concepts indexing the case (kpthesaurus_labels)."@en ;
    rdfs:subPropertyOf dcterms:subject ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:Keyword ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasJudge a owl:ObjectProperty ;
    rdfs:label "has judge"@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:Judge ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasJudgeCountry a owl:ObjectProperty ;
    rdfs:label "has judge country"@en ;
    skos:definition "State in respect of which the judge was elected."@en ;
    rdfs:domain echr:Judge ;
    rdfs:range echr:Country ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasFinding a owl:ObjectProperty ;
    rdfs:label "has finding"@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:LegalFinding ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:findingRefersToArticle a owl:ObjectProperty ;
    rdfs:label "finding refers to article"@en ;
    rdfs:domain echr:LegalFinding ;
    rdfs:range echr:ConventionArticle ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasApplicantParty a owl:ObjectProperty ;
    rdfs:label "has applicant party"@en ;
    skos:definition "Resolved applicant entity for the case; the raw string stays on echr:hasApplicantName."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:Party ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasLegalRepresentative a owl:ObjectProperty ;
    rdfs:label "has legal representative"@en ;
    skos:definition "Counsel acting for a party in a case or in a specific domestic proceeding."@en ;
    rdfs:subPropertyOf dcterms:contributor ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( echr:CaseDocument echr:DomesticProceeding echr:Party ) ] ;
    rdfs:range echr:LegalRepresentative ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:citesLaw a owl:ObjectProperty ;
    rdfs:label "cites law"@en ;
    rdfs:subPropertyOf dcterms:references ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:Law ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

################################################################
# 5. Object properties — domestic proceedings
################################################################

echr:hasDomesticProceeding a owl:ObjectProperty ;
    rdfs:label "has domestic proceeding"@en ;
    skos:definition "Links a case to a proceeding in its national procedural history."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:DomesticProceeding ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasFinalDomesticDecision a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has final domestic decision"@en ;
    skos:definition "The proceeding whose decision is final for Article 35 § 1 purposes and starts the time-limit for lodging the application."@en ;
    rdfs:subPropertyOf echr:hasDomesticProceeding ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:DomesticProceeding ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:followsProceeding a owl:ObjectProperty, owl:AsymmetricProperty, owl:IrreflexiveProperty ;
    rdfs:label "follows proceeding"@en ;
    skos:definition "Links a proceeding to the one that immediately preceded it in the domestic chain."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:DomesticProceeding ;
    owl:inverseOf echr:precedesProceeding ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:precedesProceeding a owl:ObjectProperty, owl:AsymmetricProperty, owl:IrreflexiveProperty ;
    rdfs:label "precedes proceeding"@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:DomesticProceeding ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasCourt a owl:ObjectProperty ;
    rdfs:label "has court"@en ;
    skos:definition "The national court or authority that determined the proceeding."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:DomesticAuthority ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasAuthorityCountry a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has authority country"@en ;
    rdfs:domain echr:DomesticAuthority ;
    rdfs:range echr:Country ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasInstanceLevel a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has instance level"@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:InstanceLevel ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasProceedingType a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has proceeding type"@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:ProceedingType ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasOutcome a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has outcome"@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:ProceedingOutcome ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:involvesParty a owl:ObjectProperty ;
    rdfs:label "involves party"@en ;
    skos:definition "A party taking part in the domestic proceeding, including the future applicant and the opposing party or public authority."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:Party ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:appliesLaw a owl:ObjectProperty ;
    rdfs:label "applies law"@en ;
    skos:definition "Legal source relied on by the domestic authority in the proceeding."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:Law ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:raisesArticle6Issue a owl:ObjectProperty ;
    rdfs:label "raises Article 6 issue"@en ;
    skos:definition "A fair-trial grievance attributed to this proceeding."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:Article6Issue ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasIssueType a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has issue type"@en ;
    rdfs:domain echr:Article6Issue ;
    rdfs:range echr:Article6IssueType ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:issueRefersToArticle a owl:ObjectProperty ;
    rdfs:label "issue refers to article"@en ;
    skos:definition "Convention sub-provision engaged by the issue (e.g. 6-1, 6-3-c)."@en ;
    rdfs:domain echr:Article6Issue ;
    rdfs:range echr:ConventionArticle ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasRemedyExhaustionStatus a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has remedy exhaustion status"@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:RemedyExhaustionStatus ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

################################################################
# 6. Datatype properties — case document (HUDOC)
################################################################

echr:hasItemId a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has item id"@en ;
    skos:definition "HUDOC item identifier (itemid); canonical external key used for IRI minting."@en ;
    rdfs:subPropertyOf dcterms:identifier ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasEcli a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has ECLI"@en ;
    skos:definition "European Case Law Identifier of the document."@en ;
    rdfs:subPropertyOf dcterms:identifier ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasCaseName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has case name"@en ;
    rdfs:subPropertyOf dcterms:title ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasApplicantName a owl:DatatypeProperty ;
    rdfs:label "has applicant name"@en ;
    skos:definition "Applicant/appellant name as given in the metadata (appellant); retained as raw text where entity resolution is incomplete."@en ;
    rdfs:subPropertyOf foaf:name ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( echr:CaseDocument echr:Party ) ] ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasCaseTextPath a owl:DatatypeProperty ;
    rdfs:label "has case text path"@en ;
    skos:definition "Relative path to the source case text artifact, retained for provenance and reproducibility."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasLanguageCode a owl:DatatypeProperty ;
    rdfs:label "has language code"@en ;
    skos:definition "ISO language code of the document (languageisocode; ENG/FRE in the current sample)."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasJudgmentDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has judgment date"@en ;
    skos:definition "Date the Court delivered the judgment or decision (judgementdate)."@en ;
    rdfs:subPropertyOf dcterms:date ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasYear a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has year"@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range xsd:gYear ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasConclusionText a owl:DatatypeProperty ;
    rdfs:label "has conclusion text"@en ;
    skos:definition "Verbatim conclusion string from the metadata, preserved for exact wording."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasConclusionReference a owl:DatatypeProperty ;
    rdfs:label "has conclusion reference"@en ;
    skos:definition "Article token extracted from the conclusion string (e.g. \"6-1\"), kept as provenance alongside echr:concernsArticle."@en ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasApplicationNumber a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has application number"@en ;
    skos:definition "Canonical normalised application number (e.g. \"54837/08\")."@en ;
    rdfs:subPropertyOf dcterms:identifier ;
    rdfs:domain echr:Application ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasLodgedDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has lodged date"@en ;
    skos:definition "Date the application was lodged with the Court; compared against the final domestic decision date for the four/six-month rule."@en ;
    rdfs:domain echr:Application ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasKeywordCode a owl:DatatypeProperty ;
    rdfs:label "has keyword code"@en ;
    skos:definition "Raw kpthesaurus code retained as provenance for the mapped keyword."@en ;
    rdfs:domain echr:Keyword ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasJudgeId a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has judge id"@en ;
    skos:definition "Stable judge identifier (judges_id) used to deduplicate judge entities across rows."@en ;
    rdfs:subPropertyOf dcterms:identifier ;
    rdfs:domain echr:Judge ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasTenureBeginYear a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has tenure begin year"@en ;
    rdfs:domain echr:Judge ;
    rdfs:range xsd:gYear ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasTenureEndYear a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has tenure end year"@en ;
    rdfs:domain echr:Judge ;
    rdfs:range xsd:gYear ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:isSectionPresident a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "is section president"@en ;
    rdfs:domain echr:Judge ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasPresidencyBeginYear a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has presidency begin year"@en ;
    skos:definition "Presidency start year; expected only where echr:isSectionPresident is true."@en ;
    rdfs:domain echr:Judge ;
    rdfs:range xsd:gYear ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasPresidencyEndYear a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has presidency end year"@en ;
    rdfs:domain echr:Judge ;
    rdfs:range xsd:gYear ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasRepresentativeName a owl:DatatypeProperty ;
    rdfs:label "has representative name"@en ;
    rdfs:subPropertyOf foaf:name ;
    rdfs:domain echr:LegalRepresentative ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

################################################################
# 7. Datatype properties — domestic proceedings
################################################################

echr:hasProceedingStartDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has proceeding start date"@en ;
    skos:definition "Date the proceeding was instituted; the starting point for reasonable-time assessment at this instance."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasDecisionDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has decision date"@en ;
    skos:definition "Date of the decision closing the proceeding at this instance."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasDurationDays a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has duration in days"@en ;
    skos:definition "Length of the proceeding in days, normally derived from start and decision dates."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:isFinalDomesticDecision a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "is final domestic decision"@en ;
    skos:definition "Whether the decision closing this proceeding is the final domestic decision for Article 35 § 1 purposes."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hadPublicHearing a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "had public hearing"@en ;
    skos:definition "Whether a public oral hearing was held at this instance."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hadLegalAid a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "had legal aid"@en ;
    skos:definition "Whether legal aid or assigned counsel was granted to the applicant at this instance."@en ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasProceedingSummary a owl:DatatypeProperty ;
    rdfs:label "has proceeding summary"@en ;
    skos:definition "Short natural-language account of the proceeding, extracted from the facts section of the case text."@en ;
    rdfs:subPropertyOf dcterms:description ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasAuthorityName a owl:DatatypeProperty ;
    rdfs:label "has authority name"@en ;
    skos:definition "Name of the domestic court or authority as it appears in the case text."@en ;
    rdfs:subPropertyOf foaf:name ;
    rdfs:domain echr:DomesticAuthority ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

echr:hasIssueDescription a owl:DatatypeProperty ;
    rdfs:label "has issue description"@en ;
    skos:definition "Verbatim or summarised statement of the fair-trial grievance."@en ;
    rdfs:subPropertyOf dcterms:description ;
    rdfs:domain echr:Article6Issue ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://github.com/dahrb/Art_6/tree/main/ontology/art6_domestic.ttl> .

################################################################
# 8. Controlled vocabulary individuals
################################################################

## 8.1 Chamber type (court_level)

echr:Committee a owl:NamedIndividual, echr:ChamberType ;
    rdfs:label "Committee"@en ;
    skos:definition "Three-judge formation used for filtering and repetitive cases, and for admissibility."@en .

echr:Chamber a owl:NamedIndividual, echr:ChamberType ;
    rdfs:label "Chamber"@en ;
    skos:definition "Seven-judge formation handling most merits cases."@en .

echr:GrandChamber a owl:NamedIndividual, echr:ChamberType ;
    rdfs:label "Grand Chamber"@en ;
    skos:definition "Seventeen-judge formation; highest formation of the Court."@en ;
    owl:sameAs wd:Q108704123 .

echr:Commission a owl:NamedIndividual, echr:ChamberType ;
    rdfs:label "Commission"@en ;
    skos:definition "Legacy European Commission of Human Rights, used in pre-1998 procedural contexts."@en .

## 8.2 Importance level

echr:Importance_1 a owl:NamedIndividual, echr:ImportanceLevel ;
    rdfs:label "Key Case"@en ;
    skos:definition "Significant contribution to the development, clarification or modification of the case-law."@en .

echr:Importance_2 a owl:NamedIndividual, echr:ImportanceLevel ;
    rdfs:label "Important Case"@en ;
    skos:definition "No significant contribution to the case-law, but more than mere application of it."@en .

echr:Importance_3 a owl:NamedIndividual, echr:ImportanceLevel ;
    rdfs:label "Case Report"@en ;
    skos:definition "Applies existing case-law."@en .

echr:Importance_4 a owl:NamedIndividual, echr:ImportanceLevel ;
    rdfs:label "Case of Little Interest"@en ;
    skos:definition "Little legal interest; frequently repetitive."@en .

## 8.3 Law system

echr:LawSystem_Civil a owl:NamedIndividual, echr:LawSystem ;
    rdfs:label "Civil law jurisdiction"@en ;
    skos:closeMatch wd:Q5950118 .

echr:LawSystem_Common a owl:NamedIndividual, echr:LawSystem ;
    rdfs:label "Common law jurisdiction"@en ;
    skos:closeMatch wd:Q30216 .

echr:LawSystem_Mixed a owl:NamedIndividual, echr:LawSystem ;
    rdfs:label "Mixed jurisdiction"@en ;
    skos:definition "Jurisdiction combining civil and common-law elements."@en .

## 8.4 Article 6 limb

echr:Limb_Civil a owl:NamedIndividual, echr:Article6Limb ;
    rdfs:label "Civil"@en ;
    skos:definition "Determination of civil rights and obligations."@en .

echr:Limb_Criminal a owl:NamedIndividual, echr:Article6Limb ;
    rdfs:label "Criminal"@en ;
    skos:definition "Determination of a criminal charge."@en .

echr:Limb_Mixed a owl:NamedIndividual, echr:Article6Limb ;
    rdfs:label "Mixed"@en ;
    skos:definition "Both civil and criminal dimensions are present."@en .

echr:Limb_Constitutional a owl:NamedIndividual, echr:Article6Limb ;
    rdfs:label "Constitutional"@en ;
    skos:definition "Constitutional review context."@en .

echr:Limb_Unspecified a owl:NamedIndividual, echr:Article6Limb ;
    rdfs:label "Unspecified"@en ;
    skos:definition "The source metadata does not distinguish a limb."@en .

## 8.5 Separate opinion

echr:SeparateOpinion_Present a owl:NamedIndividual, echr:SeparateOpinionIndicator ;
    rdfs:label "Separate opinion present"@en .

echr:SeparateOpinion_Absent a owl:NamedIndividual, echr:SeparateOpinionIndicator ;
    rdfs:label "No separate opinion"@en .

## 8.6 Instance level

echr:Instance_FirstInstance a owl:NamedIndividual, echr:InstanceLevel ;
    rdfs:label "First instance"@en .

echr:Instance_Appeal a owl:NamedIndividual, echr:InstanceLevel ;
    rdfs:label "Appeal"@en .

echr:Instance_Cassation a owl:NamedIndividual, echr:InstanceLevel ;
    rdfs:label "Cassation or supreme court"@en ;
    skos:definition "Final ordinary review, whether by cassation, revision or a supreme court."@en .

echr:Instance_Constitutional a owl:NamedIndividual, echr:InstanceLevel ;
    rdfs:label "Constitutional court"@en .

echr:Instance_AdministrativeAuthority a owl:NamedIndividual, echr:InstanceLevel ;
    rdfs:label "Administrative or non-judicial authority"@en ;
    skos:definition "Determination by a body that is not a court, whose decisions may or may not attract Article 6 guarantees directly."@en .

echr:Instance_Enforcement a owl:NamedIndividual, echr:InstanceLevel ;
    rdfs:label "Enforcement proceedings"@en ;
    skos:definition "Execution of a final domestic judgment; relevant to non-enforcement complaints."@en .

echr:Instance_Reopening a owl:NamedIndividual, echr:InstanceLevel ;
    rdfs:label "Reopening or extraordinary review"@en .

## 8.7 Proceeding type

echr:ProceedingType_Civil a owl:NamedIndividual, echr:ProceedingType ;
    rdfs:label "Civil proceedings"@en .

echr:ProceedingType_Criminal a owl:NamedIndividual, echr:ProceedingType ;
    rdfs:label "Criminal proceedings"@en .

echr:ProceedingType_Administrative a owl:NamedIndividual, echr:ProceedingType ;
    rdfs:label "Administrative proceedings"@en .

echr:ProceedingType_Disciplinary a owl:NamedIndividual, echr:ProceedingType ;
    rdfs:label "Disciplinary proceedings"@en .

echr:ProceedingType_Constitutional a owl:NamedIndividual, echr:ProceedingType ;
    rdfs:label "Constitutional proceedings"@en .

echr:ProceedingType_Enforcement a owl:NamedIndividual, echr:ProceedingType ;
    rdfs:label "Enforcement proceedings"@en .

## 8.8 Proceeding outcome

echr:Outcome_FavourableToApplicant a owl:NamedIndividual, echr:ProceedingOutcome ;
    rdfs:label "Favourable to applicant"@en .

echr:Outcome_PartlyFavourable a owl:NamedIndividual, echr:ProceedingOutcome ;
    rdfs:label "Partly favourable to applicant"@en .

echr:Outcome_UnfavourableToApplicant a owl:NamedIndividual, echr:ProceedingOutcome ;
    rdfs:label "Unfavourable to applicant"@en .

echr:Outcome_Remitted a owl:NamedIndividual, echr:ProceedingOutcome ;
    rdfs:label "Remitted to a lower instance"@en .

echr:Outcome_Discontinued a owl:NamedIndividual, echr:ProceedingOutcome ;
    rdfs:label "Discontinued or struck out"@en .

echr:Outcome_Pending a owl:NamedIndividual, echr:ProceedingOutcome ;
    rdfs:label "Still pending"@en .

## 8.9 Article 6 issue types

echr:Issue_AccessToCourt a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Access to a court"@en ;
    skos:definition "Procedural bar, immunity, fee or limitation preventing determination of the claim."@en .

echr:Issue_LengthOfProceedings a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Length of proceedings"@en ;
    skos:definition "Failure to determine the case within a reasonable time."@en .

echr:Issue_Independence a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Independence of the tribunal"@en .

echr:Issue_Impartiality a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Impartiality of the tribunal"@en .

echr:Issue_TribunalEstablishedByLaw a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Tribunal established by law"@en .

echr:Issue_PublicHearing a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Public hearing or public pronouncement"@en .

echr:Issue_EqualityOfArms a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Equality of arms"@en .

echr:Issue_AdversarialProceedings a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Adversarial proceedings and disclosure"@en .

echr:Issue_ReasonedDecision a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Reasoned decision"@en .

echr:Issue_EvidenceAssessment a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Admission or assessment of evidence"@en .

echr:Issue_NonEnforcement a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Non-enforcement of a final judgment"@en .

echr:Issue_LegalCertainty a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Legal certainty and quashing of final judgments"@en .

echr:Issue_PresumptionOfInnocence a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Presumption of innocence"@en ;
    skos:definition "Article 6 § 2 grievance."@en .

echr:Issue_DefenceRights a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Defence rights"@en ;
    skos:definition "Article 6 § 3 grievances other than those listed separately (notification, time and facilities)."@en .

echr:Issue_LegalAssistance a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Legal assistance"@en ;
    skos:definition "Article 6 § 3 (c): access to a lawyer or legal aid."@en .

echr:Issue_WitnessExamination a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Examination of witnesses"@en ;
    skos:definition "Article 6 § 3 (d)."@en .

echr:Issue_Interpretation a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Interpretation and translation"@en ;
    skos:definition "Article 6 § 3 (e)."@en .

echr:Issue_TrialInAbsentia a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Trial in absentia"@en .

echr:Issue_SelfIncrimination a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Privilege against self-incrimination"@en .

echr:Issue_Entrapment a owl:NamedIndividual, echr:Article6IssueType ;
    rdfs:label "Entrapment or agent provocateur"@en .

## 8.10 Remedy exhaustion

echr:Exhaustion_Exhausted a owl:NamedIndividual, echr:RemedyExhaustionStatus ;
    rdfs:label "Domestic remedies exhausted"@en .

echr:Exhaustion_NotExhausted a owl:NamedIndividual, echr:RemedyExhaustionStatus ;
    rdfs:label "Domestic remedies not exhausted"@en .

echr:Exhaustion_NoEffectiveRemedy a owl:NamedIndividual, echr:RemedyExhaustionStatus ;
    rdfs:label "No effective remedy available"@en ;
    skos:definition "Exhaustion excused because the available remedy was ineffective or inaccessible."@en .

echr:Exhaustion_Undetermined a owl:NamedIndividual, echr:RemedyExhaustionStatus ;
    rdfs:label "Undetermined"@en .
