# ===========================================
# OntoCast Environment Configuration
# ===========================================

CURRENT_DOMAIN=https://github.com/dahrb/Art_6/tree/main/facts

# Server Configuration
PORT=8999
BASE_RECURSION_LIMIT=1000
#ESTIMATED_CHUNKS=30
MAX_VISITS=1                 # alias for max_visits_per_node


# LLM Configuration
# LLM_PROVIDER=google
# LLM_API_KEY=${GEMINI_KEY}       # Expanded manually by start_server.ps1 from keys.env
# LLM_MODEL_NAME=gemini-3.1-flash-lite
# LLM_TEMPERATURE=0.1


# LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=${OPENAI_API_KEY}  # Commented out: uv --env-file does not expand variables. LLM_API_KEY is set directly in keys.env
LLM_MODEL_NAME=gpt-5-mini
LLM_TEMPERATURE=0.1 #gpt-5-mini doesn't support temp

# ontology.env
# LLM_PROVIDER=openai
# LLM_MODEL_NAME=Qwen-3-80B
# LLM_BASE_URL=http://localhost:8002/v1
# LLM_API_KEY=token-abc123   # any non-empty string; vLLM ignores it by default

CHUNK_BREAKPOINT_THRESHOLD_TYPE=percentile  # percentile | standard_deviation | interquartile | gradient
CHUNK_BREAKPOINT_THRESHOLD_AMOUNT=95.0
CHUNK_BUFFER_SIZE=5
CHUNK_MIN_SIZE=10000
CHUNK_MAX_SIZE=30000

FUSEKI_URI=http://localhost:3032
FUSEKI_DATASET=Art_6_Clean
FUSEKI_AUTH=admin/test345

# Path Configuration
ONTOCAST_WORKING_DIRECTORY=C:/Postdoc/Article_6/issues/facts
ONTOCAST_ONTOLOGY_DIRECTORY=C:/Postdoc/Article_6/issues/ontologies
ONTOCAST_CACHE_DIR=C:/Postdoc/Article_6/.cache/ontocast/art_6_2

#Agg
AGG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
AGG_SIMILARITY_THRESHOLD=0.80

CLEAN=true
RENDER_MODE=facts                        # ontology | facts | ontology_and_facts
LOGGING_LEVEL=debug
PARALLEL_WORKERS=4
PARALLEL_FACTS_RETRIES=3
PARALLEL_ONTOLOGY_RETRIES=3
ENABLE_ONTOLOGY_CONSOLIDATION=false

ONTOLOGY_CONTEXT_MODE=fixed_single_ontology
ONTOLOGY_CONTEXT_FIXED_ONTOLOGY_ID=seed
#Stop ontocast from using ontology selection

LLM_GRAPH_FORMAT=jsonld

# Optional: Skip ontology critique
SKIP_ONTOLOGY_DEVELOPMENT=false

# Optional: Web search grounding (search-later mode)
# Node execution starts without search; search runs only when node output requests it.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_TOP_K=3
WEB_SEARCH_TIMEOUT_SECONDS=8.0
WEB_SEARCH_MAX_SNIPPET_CHARS=400
WEB_SEARCH_MAX_TOTAL_CHARS=1800
WEB_SEARCH_ONTOLOGY_RENDER_ENABLED=true
WEB_SEARCH_ONTOLOGY_CRITIC_ENABLED=true
WEB_SEARCH_FACTS_RENDER_ENABLED=false
WEB_SEARCH_FACTS_CRITIC_ENABLED=false
WEB_SEARCH_PLANNER_ENABLED=true
WEB_SEARCH_PLANNER_MAX_QUERIES=3
WEB_SEARCH_PLANNER_MIN_QUERY_CHARS=12
WEB_SEARCH_PLANNER_MIN_CONFIDENCE=0.35
WEB_SEARCH_REUSE_EVIDENCE_ACROSS_ATTEMPT=true
WEB_SEARCH_MIN_SNIPPET_CHARS=40
WEB_SEARCH_ALLOWED_DOMAINS=[]
WEB_SEARCH_BLOCKED_DOMAINS=[]