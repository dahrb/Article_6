# multi_label_source.ttl
# ---------------------------------------------------------------------------
# FIXTURE: Multi-label accumulation bug
#
# Minimal extract from the Gemini Flash Lite run on case 001-102617
# (Paksas v. Lithuania), captured 2026-06-09T13:51:16Z.
#
# Reification/prov triples (rdf:reifies, prov:wasDerivedFrom) have been
# stripped — they used RDF-star syntax not supported by rdflib's plain Turtle
# parser. The object-level triples below are sufficient to demonstrate the bug.
#
# What happened:
#   doc1:proc_2004_05_25 was encountered by THREE separate chunks. Each chunk
#   emitted its own rdfs:label without checking whether one existed already.
#   The aggregated graph contains 4 rdfs:label triples on the same subject:
#
#   Chunk doc:86e9972d6204 → "Constitutional Court Review of Election Law"
#   Chunk doc:57ae1011cf66 → "Constitutional Court ruling of 25 May 2004"
#                          → "Constitutional Court Ruling of 25 May 2004"  (case dup)
#   Chunk doc:a18c01532461 → "Constitutional Court ruling on disqualification"
#
# Similarly:
#   doc1:proc_2004_05_28 → 3 labels across 2 chunks
#   doc1:proc_2004_07_15 → 3 labels across 2 chunks
#   doc1:proc_2004_04_06 → 2 labels across 2 chunks
#   doc1:applicant_001   → 2 labels across 2 chunks
# ---------------------------------------------------------------------------

@prefix doc1: <https://github.com/dahrb/Art_6/tree/main/facts/001-102617#> .
@prefix seed: <https://github.com/dahrb/Art_6/tree/main/ontology/seed.ttl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------------------
# doc1:proc_2004_05_25  — 4 labels (worst offender)
# ---------------------------------------------------------------------------
doc1:proc_2004_05_25 a seed:DomesticProceeding ;
    seed:hasDecisionDate "2004-05-25"^^xsd:date ;
    rdfs:label "Constitutional Court Review of Election Law" ;        # chunk 86e9972d6204
    rdfs:label "Constitutional Court ruling of 25 May 2004" ;         # chunk 57ae1011cf66
    rdfs:label "Constitutional Court Ruling of 25 May 2004" ;         # chunk 57ae1011cf66 — case variant
    rdfs:label "Constitutional Court ruling on disqualification" .    # chunk a18c01532461

# ---------------------------------------------------------------------------
# doc1:proc_2004_05_28  — 3 labels
# ---------------------------------------------------------------------------
doc1:proc_2004_05_28 a seed:DomesticProceeding ;
    seed:hasDecisionDate "2004-05-28"^^xsd:date ;
    rdfs:label "Supreme Administrative Court Dismissal" ;             # chunk 86e9972d6204
    rdfs:label "Supreme Administrative Court decision of 28 May 2004" ; # chunk a18c01532461
    rdfs:label "Supreme Administrative Court dismissal" .             # chunk eef3687856ce — case dup

# ---------------------------------------------------------------------------
# doc1:proc_2004_07_15  — 3 labels
# ---------------------------------------------------------------------------
doc1:proc_2004_07_15 a seed:DomesticProceeding ;
    seed:hasDecisionDate "2004-07-15"^^xsd:date ;
    rdfs:label "Act of 15 July 2004" ;                               # chunk 1bd4f85cb261
    rdfs:label "Amendment to Seimas Elections Act" ;                  # chunk 1bd4f85cb261
    rdfs:label "Act of the Seimas regarding disqualification" .       # chunk eef3687856ce

# ---------------------------------------------------------------------------
# doc1:proc_2004_04_06  — 2 labels
# ---------------------------------------------------------------------------
doc1:proc_2004_04_06 a seed:DomesticProceeding ;
    seed:hasDecisionDate "2004-04-06"^^xsd:date ;
    rdfs:label "Removal from office" ;                               # chunk 86e9972d6204
    rdfs:label "Impeachment of Rolandas Paksas" .                    # chunk eef3687856ce

# ---------------------------------------------------------------------------
# doc1:applicant_001  — 2 labels on a generic IRI
# ---------------------------------------------------------------------------
doc1:applicant_001 a seed:Party ;
    rdfs:label "Applicant" ;                                          # chunk 86e9972d6204
    rdfs:label "Former President of Lithuania" .                      # chunk a2abc30ec4bd
