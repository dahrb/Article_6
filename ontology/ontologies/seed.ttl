@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix echr: <https://github.com/dahrb/Art_6/tree/main/ontology/seed.ttl#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Slim ontology: metadata-covered concepts (ChamberType, ImportanceLevel, Article6Limb,
# LawSystem, SeparateOpinionIndicator, JudgmentType, CourtFormation, Keyword,
# EconomicStatus, VulnerabilityStatus, Application) and their properties are omitted.
# Focus: DomesticProceeding chain, Judge enrichment, LegalFinding, Party, LegalRep,
# OperativeProvision, Law citation, LegalAid, Appeal.

<https://github.com/dahrb/Art_6/tree/main/ontology/seed.ttl> a owl:Ontology ;
    rdfs:label "ECHR Art. 6 Ontology"@en ;
    dcterms:created "2026-05-20T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "An ontology for Art.6 Cases heard at the ECHR (slim — metadata-covered fields omitted)"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "3.1" .


# ── Named Individuals ─────────────────────────────────────────────────────────

echr:Gender_Female a owl:NamedIndividual,
        echr:Gender ;
    rdfs:label "Female"@en ;
    rdfs:comment "Gender value indicating female identity."@en ;
    owl:sameAs wd:Q6581072 .

echr:Gender_Male a owl:NamedIndividual,
        echr:Gender ;
    rdfs:label "Male"@en ;
    rdfs:comment "Gender value indicating male identity."@en ;
    owl:sameAs wd:Q6581097 .

echr:Gender_NonBinary a owl:NamedIndividual,
        echr:Gender ;
    rdfs:label "Non-binary"@en ;
    rdfs:comment "Gender value indicating non-binary identity."@en ;
    owl:sameAs wd:Q48270 .

echr:Gender_Unknown a owl:NamedIndividual,
        echr:Gender ;
    rdfs:label "Unknown"@en ;
    rdfs:comment "Gender value used when gender cannot be inferred from available data."@en .

# ── Sub-classes ───────────────────────────────────────────────────────────────

echr:DomesticLaw a owl:Class ;
    rdfs:label "Domestic Law"^^xsd:string ;
    rdfs:comment "Aligned to wd:Q1668641 (national law)."^^xsd:string ;
    rdfs:subClassOf wd:Q1668641,
        echr:Law .

echr:InternationalLaw a owl:Class ;
    rdfs:label "International Law"^^xsd:string ;
    rdfs:comment "Aligned to wd:Q47659 (international law)."^^xsd:string ;
    rdfs:subClassOf wd:Q4394526,
        echr:Law .

echr:Judgment a owl:Class ;
    rdfs:label "Judgment"^^xsd:string ;
    rdfs:comment "Case subtype for rows where source indicates a judgment document."^^xsd:string ;
    rdfs:subClassOf wd:Q3769186,
        echr:CaseDocument ;
    owl:disjointWith echr:Decision .

echr:NonViolation a owl:Class ;
    rdfs:label "Non-Violation"^^xsd:string ;
    rdfs:comment "A judicial finding that no violation of a Convention Article occurred."^^xsd:string ;
    rdfs:subClassOf echr:LegalFinding .

echr:Violation a owl:Class ;
    rdfs:label "Violation"^^xsd:string ;
    rdfs:comment "A judicial finding that a violation of a Convention Article occurred."^^xsd:string ;
    rdfs:subClassOf echr:LegalFinding .

# ── Object Properties ─────────────────────────────────────────────────────────

echr:appealFiledBy a owl:ObjectProperty ;
    rdfs:label "appeal Filed By"^^xsd:string ;
    rdfs:comment "Links an Appeal to the Party that filed it."^^xsd:string ;
    rdfs:domain echr:Appeal ;
    rdfs:range echr:Party .

echr:citesLaw a owl:ObjectProperty ;
    rdfs:label "cites Law"^^xsd:string ;
    rdfs:comment "Legal-source citation relation aligned to dcterms:references."^^xsd:string ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:Law ;
    rdfs:subPropertyOf dcterms:references .

echr:complainedAboutLength a owl:ObjectProperty ;
    rdfs:label "complained About Length"^^xsd:string ;
    rdfs:comment "Links a Party to an ExcessiveLengthClaim alleging excessive proceedings duration."^^xsd:string ;
    rdfs:domain echr:Party ;
    rdfs:range echr:ExcessiveLengthClaim .

echr:failedToConsiderLegalAid a owl:ObjectProperty ;
    rdfs:label "failed To Consider Legal Aid"^^xsd:string ;
    rdfs:comment "Links a Decision to a pending LegalAidApplication that was not considered."^^xsd:string ;
    rdfs:domain echr:Decision ;
    rdfs:range echr:LegalAidApplication .

echr:findingRefersToArticle a owl:ObjectProperty ;
    rdfs:label "finding refers to Article"^^xsd:string ;
    rdfs:comment "Connects a legal finding to the specific Convention article it evaluates."^^xsd:string ;
    rdfs:domain echr:LegalFinding ;
    rdfs:range echr:ConventionArticle .

echr:followsProceeding a owl:ObjectProperty ;
    rdfs:label "follows proceeding"^^xsd:string ;
    rdfs:comment "Links a proceeding to the one that chronologically preceded it."^^xsd:string ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range echr:DomesticProceeding .

echr:hasConclusionText a owl:DatatypeProperty ;
    rdfs:label "has Conclusion Text"^^xsd:string ;
    rdfs:comment "Raw conclusion text from the judgment, preserved as a literal string."^^xsd:string ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range xsd:string .

echr:hasCourt a owl:ObjectProperty ;
    rdfs:label "has court"^^xsd:string ;
    rdfs:comment "Links a domestic proceeding to the court or authority that issued the decision."^^xsd:string ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range foaf:Organization .

echr:hasDecisionDate a owl:DatatypeProperty ;
    rdfs:label "has decision date"^^xsd:string ;
    rdfs:comment "Date of the decision issued by the domestic court or authority in this proceeding."^^xsd:string ;
    rdfs:domain echr:DomesticProceeding ;
    rdfs:range dcterms:date .

echr:hasFinding a owl:ObjectProperty ;
    rdfs:label "has Finding"^^xsd:string ;
    rdfs:comment "Links a case to structured legal outcome nodes (Violation/NonViolation and related findings)."^^xsd:string ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:LegalFinding .

echr:hasGender a owl:ObjectProperty ;
    rdfs:label "has Gender"^^xsd:string ;
    rdfs:comment "IRI-based controlled gender value inferred from explicit evidence when available."^^xsd:string ;
    rdfs:domain echr:Judge,
        echr:Party ;
    rdfs:range echr:Gender .

echr:hasJudge a owl:ObjectProperty ;
    rdfs:label "has Judge"^^xsd:string ;
    rdfs:comment "Links a case to Judge entities sitting on the bench."^^xsd:string ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:Judge .

echr:hasJudgeCountry a owl:ObjectProperty ;
    rdfs:label "has judge country"^^xsd:string ;
    rdfs:comment "Links a judge to their country of origin, normalized to Country entities."^^xsd:string ;
    rdfs:domain echr:Judge ;
    rdfs:range echr:Country .

echr:hasJudgeId a owl:DatatypeProperty ;
    rdfs:label "has Judge Id"^^xsd:string ;
    rdfs:comment "Stable judge identifier; preferred key for deduplicating judge entities across rows."^^xsd:string ;
    rdfs:domain echr:Judge ;
    rdfs:range xsd:integer .

echr:hasLegalRepresentative a owl:ObjectProperty ;
    rdfs:label "has Legal Representative"^^xsd:string ;
    rdfs:comment "Links a case to its legal representative entity."^^xsd:string ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:LegalRepresentative ;
    rdfs:subPropertyOf dcterms:contributor .

echr:hasLegalStatus a owl:ObjectProperty ;
    rdfs:label "has Legal Status"^^xsd:string ;
    rdfs:domain echr:Party ;
    rdfs:range echr:LegalStatus .

echr:hasNationality a owl:ObjectProperty ;
    rdfs:label "has Nationality"^^xsd:string ;
    rdfs:comment "Country nationality relation for Party."^^xsd:string ;
    rdfs:domain echr:Party ;
    rdfs:range echr:Country .


echr:hasOperativeProvision a owl:ObjectProperty ;
    rdfs:label "has Operative Provision"^^xsd:string ;
    rdfs:comment "Links a case to operative, legally binding outcome clauses extracted/structured for reasoning."^^xsd:string ;
    rdfs:domain echr:CaseDocument ;
    rdfs:range echr:OperativeProvision .

echr:hasPresidencyBeginYear a owl:DatatypeProperty ;
    rdfs:label "has presidency begin year"^^xsd:string ;
    rdfs:comment "Judge leadership metadata: presidency start year (expected only when isSectionPresident is true)."^^xsd:string ;
    rdfs:domain echr:Judge ;
    rdfs:range xsd:gYear .

echr:hasPresidencyEndYear a owl:DatatypeProperty ;
    rdfs:label "has presidency end year"^^xsd:string ;
    rdfs:comment "Judge leadership metadata: presidency end year (expected only when isSectionPresident is true)."^^xsd:string ;
    rdfs:domain echr:Judge ;
    rdfs:range xsd:gYear .

echr:hasRepresentativeName a owl:DatatypeProperty ;
    rdfs:label "has representative name"^^xsd:string ;
    rdfs:comment "Legal representative name string; used when a dedicated representative identifier is unavailable."^^xsd:string ;
    rdfs:domain echr:LegalRepresentative ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf foaf:name .

echr:hasTenureBeginYear a owl:DatatypeProperty ;
    rdfs:label "has tenure begin year"^^xsd:string ;
    rdfs:comment "Judge career metadata: year in which Court tenure began."^^xsd:string ;
    rdfs:domain echr:Judge ;
    rdfs:range xsd:gYear .

echr:hasTenureEndYear a owl:DatatypeProperty ;
    rdfs:label "has tenure end year"^^xsd:string ;
    rdfs:comment "Judge career metadata: year in which Court tenure ended."^^xsd:string ;
    rdfs:domain echr:Judge ;
    rdfs:range xsd:gYear .

echr:hasViolationGrounds a owl:DatatypeProperty ;
    rdfs:label "has Violation Grounds"^^xsd:string ;
    rdfs:comment "Textual rationale describing why a violation was found (e.g., lack of an independent and impartial tribunal)."^^xsd:string ;
    rdfs:domain echr:OperativeProvision ;
    rdfs:range xsd:string .

echr:isSectionPresident a owl:DatatypeProperty ;
    rdfs:label "is section president"^^xsd:string ;
    rdfs:comment "Judge profile metadata flag indicating whether the person served as Section President."^^xsd:string ;
    rdfs:domain echr:Judge ;
    rdfs:range xsd:boolean .

echr:lawyerAppointedOn a owl:DatatypeProperty ;
    rdfs:label "lawyer Appointed On"^^xsd:string ;
    rdfs:comment "Date on which counsel was appointed following a LegalAidApplication."^^xsd:string ;
    rdfs:domain echr:LegalAidApplication ;
    rdfs:range dcterms:date .

echr:legalAidGrantedOn a owl:DatatypeProperty ;
    rdfs:label "legal Aid Granted On"^^xsd:string ;
    rdfs:comment "Date on which legal aid was granted for a LegalAidApplication."^^xsd:string ;
    rdfs:domain echr:LegalAidApplication ;
    rdfs:range dcterms:date .

echr:legalAidRequestedOn a owl:DatatypeProperty ;
    rdfs:label "legal Aid Requested On"^^xsd:string ;
    rdfs:comment "Date on which a LegalAidApplication was filed."^^xsd:string ;
    rdfs:domain echr:LegalAidApplication ;
    rdfs:range dcterms:date .

echr:provisionRefersToArticle a owl:ObjectProperty ;
    rdfs:label "provision Refers To Article"^^xsd:string ;
    rdfs:domain echr:OperativeProvision ;
    rdfs:range echr:ConventionArticle .

echr:securesClaim a owl:ObjectProperty ;
    rdfs:label "secures Claim"^^xsd:string ;
    rdfs:comment "Links an InterlocutoryDecision to the Claim secured by that interim measure."^^xsd:string ;
    rdfs:domain echr:InterlocutoryDecision ;
    rdfs:range echr:Claim .

echr:supremeCourtAppealLodgedOn a owl:DatatypeProperty ;
    rdfs:label "supreme Court Appeal Lodged On"^^xsd:string ;
    rdfs:comment "Date on which a SupremeCourtAppeal was lodged with the highest domestic court."^^xsd:string ;
    rdfs:domain echr:SupremeCourtAppeal ;
    rdfs:range dcterms:date .

echr:usesAssessmentCriterion a owl:ObjectProperty ;
    rdfs:label "uses Assessment Criterion"^^xsd:string ;
    rdfs:comment "Links a ReasonableTimeAssessment to one or more criteria used in the analysis."^^xsd:string ;
    rdfs:domain echr:ReasonableTimeAssessment ;
    rdfs:range echr:AssessmentCriterion .

# ── Classes ───────────────────────────────────────────────────────────────────

echr:AssessmentCriterion a owl:Class ;
    rdfs:label "Assessment Criterion"^^xsd:string ;
    rdfs:comment "Criterion used in legal assessment, including reasonable-time analysis under Article 6."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

echr:Claim a owl:Class ;
    rdfs:label "Claim"^^xsd:string ;
    rdfs:comment "Substantive relief or demand asserted by a party in domestic proceedings."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

echr:ExcessiveLengthClaim a owl:Class ;
    rdfs:label "Excessive Length Claim"^^xsd:string ;
    rdfs:comment "A legal finding or claim asserting that the length of proceedings was excessive."^^xsd:string ;
    rdfs:subClassOf echr:LegalFinding .

echr:InterlocutoryDecision a owl:Class ;
    rdfs:label "Interlocutory Decision"^^xsd:string ;
    rdfs:comment "A decision made during ongoing domestic proceedings on an interim procedural matter."^^xsd:string ;
    rdfs:subClassOf echr:Decision .

echr:LegalStatus a owl:Class ;
    rdfs:label "Legal Status"^^xsd:string ;
    rdfs:comment "Classification of the applicant entity."^^xsd:string ;
    rdfs:subClassOf owl:Thing,
        wd:Q2628882 .

echr:ReasonableTimeAssessment a owl:Class ;
    rdfs:label "Reasonable Time Assessment"^^xsd:string ;
    rdfs:comment "Assessment finding for whether proceedings were completed within a reasonable time under Article 6."^^xsd:string ;
    rdfs:subClassOf echr:LegalFinding .

echr:SupremeCourtAppeal a owl:Class ;
    rdfs:label "Supreme Court Appeal"^^xsd:string ;
    rdfs:comment "A cassation appeal in domestic proceedings which have gone to the highest court."^^xsd:string ;
    rdfs:subClassOf wd:Q190752,
        echr:Appeal .

echr:Appeal a owl:Class ;
    rdfs:label "Appeal"^^xsd:string ;
    rdfs:comment "A procedural filing seeking review of a lower decision in domestic proceedings."^^xsd:string ;
    rdfs:subClassOf wd:Q329777 .

echr:LegalRepresentative a owl:Class ;
    rdfs:label "Legal Representative"^^xsd:string ;
    rdfs:comment "Person acting as legal counsel for an applicant or party (lawyer-aligned entity)."^^xsd:string ;
    rdfs:subClassOf owl:Thing,
        wd:Q40348,
        foaf:Person .

echr:ConventionArticle a owl:Class ;
    rdfs:label "Convention Article"^^xsd:string ;
    rdfs:comment "Convention article concept aligned to wd:Q712597."^^xsd:string ;
    rdfs:subClassOf owl:Thing,
        wd:Q712597 .

echr:Country a owl:Class ;
    rdfs:label "Country"^^xsd:string ;
    rdfs:comment "Country concept aligned to Wikidata where available."^^xsd:string ;
    rdfs:subClassOf owl:Thing,
        wd:Q3624078 .

echr:Decision a owl:Class ;
    rdfs:label "Decision"^^xsd:string ;
    rdfs:comment "Case subtype for rows where source indicates a decision document."^^xsd:string ;
    rdfs:subClassOf wd:Q327000,
        echr:CaseDocument .

echr:Law a owl:Class ;
    rdfs:label "Law Source"^^xsd:string ;
    rdfs:comment "General legal source class aligned to wd:Q7748 (law); used as a target for legal citation assertions."^^xsd:string ;
    rdfs:subClassOf owl:Thing,
        wd:Q7748 .

echr:OperativeProvision a owl:Class ;
    rdfs:label "Operative Provision"^^xsd:string ;
    rdfs:comment "The legally binding 'Holds that...' section of the judgment. Contains the final judicial voting outcomes."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

echr:DomesticProceeding a owl:Class ;
    rdfs:label "Domestic Proceeding"^^xsd:string ;
    rdfs:comment "An individual legal event in the domestic lifecycle of the case."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

echr:LegalAidApplication a owl:Class ;
    rdfs:label "Legal Aid Application"^^xsd:string ;
    rdfs:comment "An application requesting legal aid or court-appointed representation in domestic proceedings."^^xsd:string ;
    rdfs:subClassOf wd:Q707748 .

echr:Gender a owl:Class ;
    rdfs:label "Gender"^^xsd:string ;
    rdfs:comment "Controlled gender vocabulary used for party-level and judge-level gender assertions."^^xsd:string ;
    rdfs:subClassOf owl:Thing,
        wd:Q48277 .

echr:LegalFinding a owl:Class ;
    rdfs:label "Legal Finding"^^xsd:string ;
    rdfs:comment "Structured legal conclusion class capturing result statements (violation/non-violation) derived from decision outcomes."^^xsd:string ;
    rdfs:subClassOf owl:Thing,
        prov:Entity .

echr:Party a owl:Class ;
    rdfs:label "Party"^^xsd:string ;
    rdfs:comment "Applicant/appellant party entity for a case. Aligned to foaf:Agent."^^xsd:string ;
    rdfs:subClassOf owl:Thing,
        wd:Q12648988,
        foaf:Agent .

echr:Judge a owl:Class ;
    rdfs:label "Judge"^^xsd:string ;
    rdfs:comment "Judge entity normalized for reuse across cases. Aligned to foaf:Person."^^xsd:string ;
    rdfs:subClassOf owl:Thing,
        wd:Q16533,
        foaf:Person .

echr:CaseDocument a owl:Class ;
    rdfs:label "Case"^^xsd:string ;
    rdfs:comment "Primary case record class for Art. 6 ECHR cases."^^xsd:string ;
    rdfs:subClassOf owl:Thing,
        wd:Q2334719 .

