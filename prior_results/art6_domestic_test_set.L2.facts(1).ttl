doc:section_18_german_courts_act a schema:Legislation ;
    rdfs:label "Section 18 of the German Courts Act"@en ;
    schema:description "Part of the provisions regulating immunity from jurisdiction concerning members of diplomatic missions."@en ;
    schema:isPartOf doc:germanCourtsAct .

doc:section_19_german_courts_act a schema:Legislation ;
    rdfs:label "Section 19 of the German Courts Act"@en ;
    schema:description "Part of the provisions regulating immunity from jurisdiction concerning members of consular missions."@en ;
    schema:isPartOf doc:germanCourtsAct .

doc:section_1_10_1_1_provision_of_labour_act a schema:Legislation ;
    rdfs:label "Section 1(10)(1)(1) of the Provision of Labour (Temporary Staff) Act"@en ;
    schema:description "Provides that if the contract between a hirer-out and an employee hired out is void under section 1(9)(1), a contract between the hiring employer and the employee hired out is deemed to have been concluded as from the envisaged start of employment."@en ;
    schema:isPartOf doc:provisionOfLabourTemporaryStaffAct .

doc:section_1_10_2_provision_of_labour_act a schema:Legislation ;
    rdfs:label "Section 1(10)(2) of the Provision of Labour (Temporary Staff) Act"@en ;
    schema:description "Provides for a claim in damages against the hirer-out in respect of any loss suffered as a consequence of having relied on the validity of the contract, except where the employee hired out was aware of the factor rendering the contract void."@en ;
    schema:isPartOf doc:provisionOfLabourTemporaryStaffAct .

doc:section_1_1_1_provision_of_labour_act a schema:Legislation ;
    rdfs:label "Section 1(1)(1) of the Provision of Labour (Temporary Staff) Act"@en ;
    schema:description "Provides that an employer who, on a commercial basis, intends to hire out his employees to third persons must obtain official permission."@en ;
    schema:isPartOf doc:provisionOfLabourTemporaryStaffAct .

doc:section_1_9_1_provision_of_labour_act a schema:Legislation ;
    rdfs:label "Section 1(9)(1) of the Provision of Labour (Temporary Staff) Act"@en ;
    schema:description "Provides that contracts between the hirer-out and the hiring employer and between the hirer-out and the employee hired out are void if no official permission has been obtained as required by section 1(1)(1)."@en ;
    schema:isPartOf doc:provisionOfLabourTemporaryStaffAct .

doc:section_20_1_german_courts_act a schema:Legislation ;
    rdfs:label "Section 20(1) of the German Courts Act"@en ;
    schema:description "Concerns representatives of States staying in Germany upon the invitation of the German Government."@en ;
    schema:isPartOf doc:germanCourtsAct .

doc:section_20_2_german_courts_act a schema:Legislation ;
    rdfs:label "Section 20(2) of the German Courts Act"@en ;
    schema:description "Provides that other persons shall have immunity from jurisdiction according to the rules of general international law, or pursuant to international agreements or other legal rules."@en ;
    schema:isPartOf doc:germanCourtsAct .

doc:commissionOfHumanRights a schema:Organization ;
    rdfs:label "European Commission of Human Rights"@en .

