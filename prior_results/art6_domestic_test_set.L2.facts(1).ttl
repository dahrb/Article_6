    rdfs:label "alleged violation of Article 6 § 1"@en ;
    echr:affectsParty doc:applicants_1 ;
    echr:hasIssueDescription "the applicants invited the Court to hold that their rights pursuant to Article 6 § 1 of the Convention had been violated"@en ;
    echr:hasSourceParagraph "36"^^xsd:string .

doc:article_iv_1a_annex_i a schema:Legislation ;
    rdfs:label "Article IV § 1 (a) of Annex I to the ESA Convention"@en ;
    schema:description "Provides that the Agency shall have immunity from jurisdiction and execution, except where the Council has expressly waived such immunity in a particular case; the Council must waive immunity where reliance upon it would impede justice and it can be waived without prejudicing the Agency's interests."@en ;
    schema:isPartOf doc:annexIEsaConvention .

doc:article_xv_paragraph_1_annex_i a schema:Legislation ;
    rdfs:label "Article I of Annex I to the ESA Convention"@en ;
    schema:description "Provides that the Agency shall have legal personality, in particular the capacity to contract, to acquire and to dispose of movable and immovable property, and to be a party to legal proceedings."@en ;
    schema:isPartOf doc:annexIEsaConvention .

doc:case_document_1 a echr:CaseDocument ;
    rdfs:label "Alleged violation of Article 6 § 1 of the Convention"@en,
        "FINAL SUBMISSIONS TO THE COURT"@en ;
    echr:hasDomesticProceeding doc:domesticProceedingLabourCourtDarmstadt ;
    echr:hasExtractionNote "The Court found that there has been no violation of Article 6 § 1 in respect of the applicants' inability to obtain merits examination against ESA."@en ;
    echr:hasRespondentState "Federal Republic of Germany"^^xsd:string,
        "Germany"^^xsd:string .

