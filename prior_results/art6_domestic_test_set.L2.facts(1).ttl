doc:regulation_33_esa_staff_regulations a schema:Legislation ;
    rdfs:label "Regulation 33 of the ESA Staff Regulations"@en ;
    schema:description "Provides for an independent Appeals Board to hear disputes between the Agency and staff members (current or former) or persons entitled under them; describes rescission powers, powers to order repair of damage, to award compensation where execution of rescinding decision would cause major difficulties, competence where Director General refuses to waive immunity, and competence to settle jurisdictional or procedural questions."@en ;
    schema:hasPart doc:orgEsa ;
    schema:isPartOf doc:esaStaffRegulationsChapterViii .

doc:settlement_second_applicant_1994_09_06 a schema:Agreement ;
    rdfs:label "settlement on 6 September 1994"@en ;
    schema:description "Settlement reached in the Darmstadt Labour Court by which the second applicant's employment with T.I. terminated on 31 December 1993 and T.I. undertook to pay DEM 22,000 for loss of job."@en ;
    schema:hasPart doc:payment_second_22000_dem ;
    schema:participant doc:companyS,
        doc:secondApplicant ;
    schema:startDate "1994-09-06"^^xsd:date .

