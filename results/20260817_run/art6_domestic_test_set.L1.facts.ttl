        doc:personDeanSpielmann,
        doc:personEgbertMyjer,
        doc:personFrancoiseTulkens,
        doc:personGannaYudkivska,
        doc:personIsabelleBerroLefevre,
        doc:personJeanPaulCosta,
        doc:personJosepCasadevall,
        doc:personJuliaLaffranque,
        doc:personKhanlarHajiyev,
        doc:personLechGarlicki,
        doc:personLuisLopezGuerra,
        doc:personMirjanaLazarovaTrajkovska,
        doc:personNicolasBratza,
        doc:personNinaVajic,
        doc:personVincentADeGaetano,
        doc:personVincentBerger,
        doc:personZdravkaKalaydjieva .

doc:lawyer_challenge_2005_08_10 a schema:LegalAction ;
    rdfs:label "applicant's lawyer challenged the refusal (10 August 2005)"@en ;
    schema:agent doc:applicantsLawyer ;
    schema:datePublished "2005-08-10"^^xsd:date ;
    schema:description "The applicant's lawyer challenged the refusal, arguing her client should have the opportunity to assess for himself whether, given the living conditions at the home, it was in his interests to remain there and that enforced continuation amounted in practice to a deprivation of liberty."@en .

doc:leave_series_2002_2006_1 a schema:Event ;
    rdfs:label "leaves to Ruse between 2002 and 2006"@en ;
    echr:hasExtractionNote "Between 2002 and 2006 the applicant returned to Ruse three times on leave of absence."@en,
        "Each trip was authorised for a period of about ten days."@en ;
    schema:agent doc:applicant ;
    schema:location doc:rusePlace .

doc:maintenance_medication_since_2002 a schema:MedicalTherapy ;
    rdfs:label "maintenance medication since 2002 under monthly supervision of a psychiatrist"@en ;
    schema:description "The applicant had been on maintenance medication since 2002 under the monthly supervision of a psychiatrist."@en ;
    schema:startDate "2002"^^xsd:gYear .

doc:mayor_refusal_2005_09_16 a echr:DomesticProceeding ;
    rdfs:label "mayor refusal (16 September 2005)"@en ;
    echr:hasCourt doc:mayorOfRila ;
    echr:hasDecisionDate "2005-09-16"^^xsd:date ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasSupportingQuote "In a letter of 16 September 2005, the mayor of Rila refused his request, stating that there was no basis for such an action in view of the medical certificate of 15 June 2005, the opinions of the Director and the social worker, and the conclusions reached by the public prosecutor’s office."@en .

doc:medical_certificate_2005_06_15 a schema:CreativeWork ;
    rdfs:label "medical certificate of 15 June 2005"@en ;
    rdfs:comment "The certificate records that, following his placement in the home in 2002, the applicant was given anti-psychotic medication (carbamazepine (600 mg)) under the monthly supervision of a psychiatrist."@en ;
    schema:datePublished "2005-06-15"^^xsd:date .

doc:medication_supervision_1 a schema:MedicalTherapy ;
    rdfs:label "monthly supervision by a psychiatrist"@en ;
    rdfs:comment "Supervision of medication was monthly."@en ;
    schema:provider doc:psychiatrist_1 .

doc:ministryLabourSocialPolicy a echr:DomesticAuthority ;
    rdfs:label "Ministry of Labour and Social Policy"@en ;
    echr:hasAuthorityName "Ministry of Labour and Social Policy"@en .

doc:partyBulgarianGovernment a echr:Party ;
    rdfs:label "the Bulgarian Government"@en ;
    echr:hasPartyName "the Bulgarian Government"@en ;
    echr:isRepresentedBy doc:agentNNikolova,
        doc:agentRNikolova .

doc:payment_for_journey_1 a schema:MonetaryAmount ;
    rdfs:label "journey cost BGN 60"@en ;
    echr:hasExtractionNote "The journey cost BGN 60 (approximately EUR 30), which was paid to the applicant by the home’s management."@en ;
    schema:currency "BGN"@en ;
    schema:provider doc:home_1 ;
    schema:recipient doc:applicant ;
    schema:value "60"^^xsd:decimal .

