doc:admission_2005_05_31_to_2005_06_15 a schema:MedicalProcedure ;
    rdfs:label "admitted to psychiatric hospital from 31 May to 15 June 2005"@en ;
    schema:description "Admitted for a medical assessment in preparation for a possible application to the courts for restoration of legal capacity."@en ;
    schema:endDate "2005-06-15"^^xsd:date ;
    schema:location doc:psychiatricHospital ;
    schema:startDate "2005-05-31"^^xsd:date .

doc:agreement_2002_12_10 a schema:Agreement ;
    rdfs:label "placement agreement 10 December 2002"@en ;
    schema:agent doc:guardianRP ;
    schema:description "Agreement signed between the guardian R.P. and the Pastra social care home; did not mention the applicant's name. It stated that the home was to provide food, clothing, medical services, heating and accommodation in return for payment; 80% of the sum was to be used as payment for services and the remaining 20% put aside for personal expenses. The agreement did not specify the duration of the provision of the services."@en ;
    schema:participant doc:pastraSocialCareHome ;
    schema:startDate "2002-12-10"^^xsd:date .

doc:allowanceAmountEurApprox a schema:MonetaryAmount ;
    rdfs:label "monthly allowance amount (approx. EUR)"@en ;
    rdfs:comment "approximate conversion stated in source"@en ;
    schema:currency "EUR"^^xsd:string ;
    schema:value "8"^^xsd:decimal .

doc:appellate_prosecutor_upheld_2005_10_11 a echr:DomesticProceeding ;
    rdfs:label "appellate prosecutor decision (11 October 2005)"@en ;
    echr:hasCourt doc:appellateProsecutorOffice ;
    echr:hasDecisionDate "2005-10-11"^^xsd:date ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasSupportingQuote "Despite those objections, the regional prosecutor’s refusal was upheld on 11 October 2005 by the appellate prosecutor."@en .

doc:appointment_decision_2005_02_02 a schema:Event ;
    rdfs:label "Rila Municipal Council appointment decision 2 February 2005"@en ;
    schema:agent doc:rilaMunicipalCouncil ;
    schema:description "The Rila Municipal Council decided to appoint the Director of the Pastra social care home as the applicant's guardian."@en ;
    schema:participant doc:guardianRP ;
    schema:startDate "2005-02-02"^^xsd:date .

doc:bedside_table_1 a schema:Thing ;
    rdfs:label "a bedside table"@en ;
    echr:hasExtractionNote "Only a bedside table in which to store his clothes."@en ;
    schema:owner doc:applicant .

doc:carbamazepine_600mg a schema:Drug ;
    rdfs:label "carbamazepine (600 mg)"@en ;
    schema:dosage doc:dosage_1 .

doc:case_36760_06 a echr:CaseDocument ;
    rdfs:label "application (no. 36760/06)"@en ;
    echr:hasApplicant doc:partyRusiKosevStanev ;
    echr:hasApplicationNumber "36760/06"^^xsd:string ;
    echr:hasRespondentState "Republic of Bulgaria"@en ;
    schema:datePublished "2006-09-08"^^xsd:date .

doc:chief_pp_upheld_2005_11_29 a echr:DomesticProceeding ;
    rdfs:label "Chief Public Prosecutor's Office decision (29 November 2005)"@en ;
    echr:hasCourt doc:publicProsecutorOffice ;
    echr:hasDecisionDate "2005-11-29"^^xsd:date ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasSupportingQuote "and subsequently on 29 November 2005 by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation."@en .

doc:clothes_1 a schema:Product ;
    rdfs:label "his clothes"@en ;
    echr:hasExtractionNote "He preferred to keep them in his bed at night for fear that they might be stolen and replaced with old clothes."@en ;
    schema:owner doc:applicant .

doc:common_room_1 a schema:Room ;
    rdfs:label "common room at the home"@en ;
    rdfs:comment "The room was not heated in winter and the residents kept their coats, hats and gloves on when inside."@en ;
    schema:containedInPlace doc:socialCareHomePastra ;
    schema:hasProduct doc:books_collection_1,
        doc:chessboard_1,
        doc:television_1 ;
    schema:openingHoursSpecification doc:opening_hours_1 .

doc:director_letter_to_police_2006_10_13 a schema:CommunicateAction ;
    rdfs:label "Director's letter to the Ruse municipal police 13 October 2006"@en ;
    echr:hasExtractionNote "On 13 October 2006 the Director wrote asking the police to search for the applicant and transfer him to Sofia so employees of the home could collect him and take him back to Pastra."@en ;
    schema:agent doc:homeDirector ;
    schema:recipient doc:ruseMunicipalPolice ;
    schema:startDate "2006-10-13"^^xsd:date .

doc:director_statement_to_prosecutor_1 a prov:Entity ;
    rdfs:label "statement by the Director to the public prosecutor's office"@en ;
    prov:hadPrimarySource doc:publicProsecutorOffice ;
    prov:wasAttributedTo doc:homeDirector ;
    echr:hasExtractionNote "According to a statement made by the Director to the public prosecutor's office on an unspecified date, the applicant came back early because he was unable to manage his finances and had no accommodation."@en .

doc:dup_nitsa_judicial_review_2005_09_28_2006_03_10 a echr:DomesticProceeding ;
    rdfs:label "Dupnitsa District Court judicial review (28 September 2005 - 10 March 2006)"@en ;
    echr:hasCourt doc:dupnicaDistrictCourt ;
    echr:hasDecisionDate "2006-03-10"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasParticipation doc:participationApplicantDupnitsa,
        doc:participationMayorDupnitsa ;
    echr:hasProceedingStartDate "2005-09-28"^^xsd:date ;
    echr:hasSupportingQuote "On 18 January 2006 the court held a hearing at which the representative of the mayor of Rila objected that the form of authority was invalid as it had not been countersigned by the guardian. The guardian, who was present at the hearing, stated that he was not opposed to the applicant’s application."@en,
        "On 28 September 2005 the applicant’s lawyer applied to the Dupnitsa District Court for judicial review of the mayor’s decision, under Article 115 of the Family Code."@en,
        "The Dupnitsa District Court gave judgment on 10 March 2006. ... the court dismissed the application, ... Since the judgment was not subject to appeal, it became final."@en ;
    echr:isFinalDomesticDecision true .

doc:envelope_posting_assistance_1 a schema:CommunicateAction ;
    rdfs:label "staff put his sheets of paper in envelopes and sent them off for him"@en ;
    rdfs:comment "Staff asked the applicant to give them any sheets of paper he wished to post so that they could put them in envelopes and send them off for him."@en ;
    schema:agent doc:staff_group_1 ;
    schema:recipient doc:applicant .

doc:envelope_refusal_1 a schema:RefuseAction ;
    rdfs:label "staff refused to supply him with envelopes"@en ;
    rdfs:comment "The applicant did not have access to his own money and therefore could not buy envelopes."@en ;
    schema:agent doc:staff_group_1 ;
    schema:object doc:envelopes_1 ;
    schema:target doc:applicant .

doc:evaluation_report_annual_1 a schema:Report ;
    rdfs:label "annual evaluation report on the applicant’s behaviour and social skills"@en ;
    rdfs:comment "Reports indicated the applicant was uncommunicative, preferred to stay on his own rather than join group activities, refused to take his medication, had no close relatives to visit while on leave, was not on good terms with his half-sister, and it was unclear whether he had anywhere to live outside the social care home. The reports concluded reintegration into society was impossible and set an objective of ensuring acquisition of skills for social resettlement and reintegration into the family. He appears never to have been offered therapy to that end."@en ;
    schema:about doc:applicant ;
    schema:creator doc:homeDirector,
        doc:homeSocialWorker .

doc:evidence_feb_2011 a schema:Report ;
    rdfs:label "most recent evidence submitted February 2011"@en ;
    schema:about doc:applicant ;
    schema:datePublished "2011-02"^^xsd:gYearMonth ;
    schema:description "According to the most recent evidence submitted in February 2011, the applicant was still living in the home at that time."@en ;
    schema:location doc:pastraSocialCareHome .

doc:examination_2006_08_31 a schema:MedicalTest ;
    rdfs:label "examination on 31 August 2006"@en ;
    schema:datePublished "2006-08-31"^^xsd:date ;
    schema:description "At the applicant's lawyer's request the applicant was examined by Dr V.S. and by a psychologist, Ms I.A.; the report of that examination found the earlier 15 June 2005 diagnosis of schizophrenia to be inaccurate, observed no risk of deterioration and noted stabilisation of the applicant's health."@en ;
    schema:patient doc:applicant ;
    schema:performer doc:drVs,
        doc:msIa .

doc:father_second_wife_1 a echr:NaturalPerson ;
    rdfs:label "his father’s second wife"@en ;
    echr:hasExtractionNote "Named in the facts as one of the applicant's only close relatives."@en .

doc:government_memorial_1 a prov:Entity ;
    rdfs:label "Government memorial before the Grand Chamber"@en ;
    prov:wasAttributedTo doc:government_1 ;
    echr:hasExtractionNote "Government stated renovations in late 2009 (including sanitary facilities), central heating installed, diet varied (fruit, vegetables, meat), residents had access to television, books and games, and the State provided clothes; the applicant did not dispute these assertions."@en .

doc:guardian_1 a echr:NaturalPerson,
        schema:Person ;
    rdfs:label "the applicant’s guardian"@en,
        "the guardian"@en ;
    echr:hasExtractionNote "The guardian was present at the hearing and stated that he was not opposed to the applicant's application; the applicant asserted that he had made several oral requests to his guardian to apply for his release from partial guardianship and to allow him to leave the home, but his requests had always been refused."@en .

doc:guardian_appointment_2002 a echr:DomesticProceeding ;
    rdfs:label "appointment of Ms R.P. as guardian by Ruse Municipal Council on 23 May 2002"@en ;
    echr:hasCourt doc:authorityRuseMunicipalCouncil ;
    echr:hasDecisionDate "2002-05-23"^^xsd:date .

doc:hygiene_conditions_note_1 a schema:Thing ;
    rdfs:label "diet and hygiene and sanitary conditions (extraction note)"@en ;
    echr:hasExtractionNote "Access to the bathroom, which was unhealthy and decrepit, was permitted once a week. The toilets in the courtyard were unhygienic holes in the ground covered by dilapidated shelters; each toilet was shared by at least eight people. Toiletries were available only sporadically."@en,
        "The food provided at the home was insufficient and of poor quality; the applicant had no say in the choice of meals and was not allowed to help prepare them."@en .

doc:invalidity_pension_2008 a schema:MonetaryAmount ;
    rdfs:label "applicant's invalidity pension (2008)"@en ;
    schema:about doc:applicant ;
    schema:currency "BGN"^^xsd:string ;
    schema:description "The applicant's invalidity pension as updated in 2008 amounted to 130 Bulgarian levs (BGN) (approximately 65 euros)."@en ;
    schema:value "130"^^xsd:decimal .

doc:journeys_to_pastra_1 a schema:Event ;
    rdfs:label "regular journeys to Pastra"@en ;
    echr:hasExtractionNote "He regularly went to the village of Pastra; during visits he mainly provided domestic help to villagers or carried out tasks at the village restaurant."@en ;
    schema:agent doc:applicant ;
    schema:location doc:pastraPlace .

doc:judgment_stanev_v_bulgaria_2012_01_17 a schema:Judgment ;
    rdfs:label "Judgment in Stanev v. Bulgaria (17 January 2012)"@en ;
    schema:about doc:caseStanevVBulgaria ;
    schema:court doc:courtEuropeanCourtOfHumanRightsGrandChamber ;
    schema:datePublished "2012-01-17"^^xsd:date ;
