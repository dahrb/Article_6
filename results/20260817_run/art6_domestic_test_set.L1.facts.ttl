doc:pastraSocialCareHome a schema:Organization ;
    rdfs:label "Pastra social care home"@en,
        "the Pastra social care home"@en ;
    echr:hasExtractionNote "An institution for adults with mental disorders near the village of Pastra in the municipality of Rila; described as under the responsibility of the Ministry of Labour and Social Policy."@en ;
    schema:description "Located in an isolated area of the Rila mountains in south-west Bulgaria; accessible via a dirt track from the village of Pastra, the nearest locality 8 km away."@en .

doc:applicant a echr:NaturalPerson,
        echr:Party,
        schema:Person ;
    rdfs:label "the applicant"@en ;
    echr:hasBirthYear "1956"^^xsd:gYear ;
    echr:hasExtractionNote "Applicant stated he had not been told why he was being placed in the home or for how long; the Government did not dispute this."@en,
        "Born in 1956 in Ruse; lived in Ruse until December 2002; only close relatives recorded: his half-sister and his father’s second wife."@en,
        "Diagnosed with schizophrenia in 1975; panel of occupational physicians (20 December 1990) found 90% degree of disablement; in receipt of an invalidity pension."@en,
        "Placed in the Pastra social care home by a welfare-placement agreement signed on 10 December 2002; applicant was not informed of the agreement; taken there by ambulance the same day (about 400 km from Ruse)."@en ;
    echr:hasGender echr:GenderMale ;
    echr:hasGenderConfidence "1"^^xsd:decimal ;
    echr:hasGenderCue echr:GenderCuePronoun ;
    echr:hasGenderCueText "he"@en ;
    echr:hasPersonName "the applicant"@en ;
    echr:isAnonymised true ;
    echr:isRepresentedBy doc:applicantsLawyer ;
    schema:memberOf doc:block_3,
        doc:home_1,
        doc:socialCareHomePastra .

