    rdfs:label "placement in the home in 2002"@en ;
    schema:patient doc:applicant ;
    schema:startDate "2002"^^xsd:gYear ;
    schema:toLocation doc:socialCareHomePastra .

doc:placement_agreement_2002 a schema:Agreement ;
    rdfs:label "welfare-placement agreement signed between R.P. and the social care home on 10 December 2002"@en ;
    echr:hasExtractionNote "The applicant was not informed of the agreement."@en ;
    schema:agent doc:guardianRP ;
    schema:dateCreated "2002-12-10"^^xsd:date ;
    schema:recipient doc:pastraSocialCareHome .

doc:placement_application_2002 a schema:Action ;
    rdfs:label "application by R.P. to Ruse social services requesting placement in a social care home (29 May 2002)"@en ;
    schema:agent doc:guardianRP ;
    schema:recipient doc:ruseSocialServices ;
    schema:startDate "2002-05-29"^^xsd:date .

doc:police_informed_director_2006_10_19 a schema:CommunicateAction ;
    rdfs:label "Ruse police informed the Director 19 October 2006"@en ;
    echr:hasExtractionNote "On 19 October 2006 the Ruse police informed the Director that the applicant's whereabouts had been discovered but that the police could not transfer him because he was not the subject of a wanted notice."@en ;
    schema:agent doc:ruseMunicipalPolice ;
    schema:recipient doc:homeDirector ;
    schema:startDate "2006-10-19"^^xsd:date .

doc:proceeding_appeal_2001 a echr:DomesticProceeding ;
    rdfs:label "judgment of 12 April 2001 upholding the 20 November 2000 judgment"@en ;
    echr:followsProceeding doc:proceeding_declaration_2000 ;
    echr:hasCourt doc:velikoTarnovoCourtOfAppeal ;
    echr:hasDecisionDate "2001-04-12"^^xsd:date ;
    echr:hasExtractionNote "Appeal by the applicant was dismissed and the first-instance judgment was upheld; judgment transmitted to Ruse Municipal Council on 7 June 2001 for appointment of guardian."@en ;
    echr:isFinalDomesticDecision true .

doc:prosecutor_request_2005_03_02 a schema:Action ;
    rdfs:label "public prosecutor requested Pastra home to send doctor's opinion (2 March 2005)"@en ;
    schema:agent doc:publicProsecutorOffice ;
    schema:datePublished "2005-03-02"^^xsd:date ;
    schema:description "On 2 March 2005 the public prosecutor requested the Pastra social care home to send a doctor's opinion and other medical certificates concerning the applicant's disorders in preparation for a possible application to the courts for restoration of his legal capacity."@en ;
    schema:recipient doc:pastraSocialCareHome .

doc:refusal_2005_08_10 a schema:Action ;
    rdfs:label "regional prosecutor refused to bring an action for restoration (10 August 2005)"@en ;
    schema:about doc:certificate_2005_06_15,
        doc:placement_in_home_2002 ;
    schema:agent doc:regionalProsecutorPerson ;
    schema:datePublished "2005-08-10"^^xsd:date ;
    schema:description "On 10 August 2005 the regional prosecutor refused to bring an action for restoration of the applicant's legal capacity on the grounds that the doctors, the Director of the Pastra social care home and the home's social worker considered the applicant unable to cope on his own and that the home was the most suitable place for him to live."@en .

doc:relative_half_sister_1 a echr:NaturalPerson ;
    rdfs:label "his half-sister"@en ;
    echr:hasExtractionNote "Named in the facts as one of the applicant's only close relatives."@en .

doc:remission_statement_2006 a schema:MedicalCondition ;
    rdfs:label "stable remission since 2006"@en ;
    rdfs:comment "At the Grand Chamber hearing the applicant's representatives stated that their client had been in stable remission since 2006 and had not undergone any psychiatric treatment in recent years."@en ;
    schema:patient doc:applicant .

doc:report_2006_08_31 a schema:Report ;
    rdfs:label "report drawn up on 31 August 2006"@en ;
    schema:author doc:drVs,
        doc:msIa ;
    schema:datePublished "2006-08-31"^^xsd:date ;
    schema:description "The report concluded the 15 June 2005 diagnosis of schizophrenia was inaccurate because the patient did not display all symptoms; that the applicant had not shown signs of aggression at the time but a suspicious attitude and slight tendency to 'verbal aggression'; that he had not undergone treatment for the condition between 2002 and 2006; that his health had visibly stabilised; that no risk of deterioration had been observed; and that, in the Director's opinion, the applicant was capable of reintegrating into society."@en .

doc:report_findings_institutionalisation_2006_08_31 a schema:Report ;
    rdfs:label "report conclusions on institutionalisation and alcohol risk (31 August 2006)"@en ;
    schema:about doc:pastraSocialCareHome ;
    schema:datePublished "2006-08-31"^^xsd:date ;
    schema:description "The report stated that the applicant's stay in the Pastra social care home was damaging to his health and risked developing 'institutionalisation syndrome' the longer he stayed; that it would be more beneficial to integrate him into community life with as few restrictions as possible; that his tendency to alcohol abuse (apparent prior to 2002) should be monitored; and warned that behaviour of an alcohol-dependent person could have similar characteristics to schizophrenia, requiring vigilance to avoid confusion between the two conditions."@en .

doc:residence_registration_2002_12_14 a schema:Event ;
    rdfs:label "residence registration 14 December 2002"@en ;
    schema:agent doc:guardianRP ;
    schema:description "At the request of the Director of the Pastra social care home, the applicant was registered as having his home address in the municipality of Rila; the residence certificate stated the address had been changed for the purpose of his \"permanent supervision\"."@en ;
    schema:location doc:pastraSocialCareHome ;
    schema:startDate "2002-12-14"^^xsd:date .

doc:restoration_request_2004_11_25 a schema:LegalAction ;
    rdfs:label "request to apply to Regional Court to restore legal capacity (25 November 2004)"@en ;
    schema:agent doc:applicant ;
    schema:datePublished "2004-11-25"^^xsd:date ;
    schema:description "On 25 November 2004 the applicant, through his lawyer, asked the public prosecutor's office to apply to the Regional Court to have his legal capacity restored."@en ;
    schema:participant doc:applicantsLawyer ;
    schema:recipient doc:publicProsecutorOffice .

doc:return_event_2006_10_31 a schema:MoveAction ;
    rdfs:label "driven back to the social care home on 31 October 2006"@en ;
    schema:agent doc:staff_group_1 ;
    schema:patient doc:applicant ;
    schema:startTime "2006-10-31"^^xsd:date ;
    schema:toLocation doc:socialCareHomePastra .

doc:returned_early_1 a schema:Event ;
    rdfs:label "returned to Pastra before end of authorised leave after first two visits to Ruse"@en ;
    echr:hasExtractionNote "The applicant returned to Pastra before the end of his authorised period of leave after his first two visits to Ruse."@en ;
    schema:agent doc:applicant .

doc:room_1 a schema:Room ;
    rdfs:label "a room measuring 16 sq. m"@en ;
    echr:hasExtractionNote "Beds were practically side by side."@en ;
    schema:floorSize doc:roomsize_1 ;
    schema:occupant doc:applicant,
        doc:other_residents_group_1 .

doc:ruseRegionalProsecutor a echr:DomesticAuthority ;
    rdfs:label "regional prosecutor"@en,
        "the Ruse regional prosecutor"@en ;
    echr:hasAuthorityName "the Ruse regional prosecutor"@en ;
    echr:hasExtractionNote "Applied to the Ruse Regional Court (unspecified date in 2000) for a declaration of total legal incapacity in respect of the applicant (at the request of the applicant's two relatives)."@en .

doc:social_allowance_grant_2007_02_07 a schema:Grant ;
    rdfs:label "monthly allowance granted on 7 February 2007"@en ;
    rdfs:comment "The municipal social assistance department granted the applicant a monthly allowance."@en ;
    schema:amount doc:allowanceAmountBgn ;
    schema:dateGranted "2007-02-07"^^xsd:date ;
    schema:provider doc:socialAssistanceDepartment ;
    schema:recipient doc:applicant .

doc:social_assessment_2005_12_30 a schema:Report ;
    rdfs:label "social assessment of 30 December 2005"@en ;
    rdfs:comment "The assessment concluded the applicant was incapable of working (even in a sheltered environment), had no need for training or retraining, and was therefore entitled to a social allowance to cover transport, subsistence and medication."@en ;
    schema:about doc:applicant ;
    schema:author doc:socialAssistanceDepartment ;
    schema:datePublished "2005-12-30"^^xsd:date .

doc:social_assistance_report_2009_04 a schema:Report ;
    rdfs:label "Social Assistance Agency report April 2009"@en ;
    schema:datePublished "2009-04"^^xsd:gYearMonth ;
    schema:description "Report produced by the Social Assistance Agency in April 2009: seventy-three people living in the home, one was in hospital and two had absconded. Among the residents, twenty-three were entirely lacking legal capacity, two were partially lacking capacity and the others enjoyed full legal capacity."@en ;
    schema:location doc:pastraSocialCareHome .

doc:sofiaPlace a schema:Place ;
    rdfs:label "Sofia"@en .

doc:third_leave_2006_1 a schema:Event ;
    rdfs:label "third period of leave 15-25 September 2006"@en ;
    echr:hasExtractionNote "The third period of leave was authorised from 15 to 25 September 2006; after the applicant failed to return on the scheduled date the Director wrote to the Ruse municipal police."@en ;
    schema:agent doc:applicant ;
    schema:endDate "2006-09-25"^^xsd:date ;
    schema:location doc:rusePlace ;
    schema:startDate "2006-09-15"^^xsd:date .

doc:transfer_to_pastra_2002 a schema:Action ;
    rdfs:label "applicant taken by ambulance to the Pastra social care home on 10 December 2002"@en ;
    echr:hasExtractionNote "Transport by ambulance the same day as the placement agreement; distance described in the facts as some 400 km from Ruse."@en ;
    schema:location doc:pastraSocialCareHome ;
    schema:startDate "2002-12-10"^^xsd:date .

