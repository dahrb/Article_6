doc:agreementConcerningEsoc a schema:Legislation ;
    rdfs:label "Agreement concerning ESOC"@en ;
    schema:about doc:esa ;
    schema:creator doc:governmentFederalRepublicOfGermany ;
    schema:description "Agreement concluded between the Government of the Federal Republic of Germany and ESRO for establishing a European Space Operations Centre (including European Space Data Centre)."@en ;
    schema:hasPart doc:agreement_esoc_article_6 .

doc:agreement_esoc_article_6 a schema:Legislation ;
    rdfs:label "Article 6 of the Agreement concerning ESOC"@en ;
    schema:description "Provides that, subject to the Protocol on Privileges and Immunities and complementary agreements, the Organisation's activities in the Federal Republic of Germany shall be governed by German law; if staff terms are not governed by the Organisation’s staff regulations they shall be subject to German laws, and certain disputes not within the Appeals Board competence are subject to German jurisdiction."@en ;
    schema:isPartOf doc:agreementConcerningEsoc .

