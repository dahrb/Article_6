doc:esa a echr:Party,
        schema:Organization ;
    rdfs:label "ELDO"@en,
        "ESA"@en,
        "ESA Appeals Board"@en,
        "ESA Council"@en,
        "ESRO"@en,
        "European Space Agency"@en,
        "European Space Agency (ESA)"@en ;
    rdfs:comment "According to the constituent instrument, ESA enjoys immunity except, inter alia, to the extent that the ESA Council expressly waives immunity in a particular case."@en,
        "International organisation established under the ESA Convention of 30 May 1975 (headquarters in Paris)."@en ;
    echr:hasExtractionNote "Defendant (ESA) claimed immunity from jurisdiction; the national courts held that ESA enjoyed immunity under the ESA Convention and Annex I."@en ;
    echr:hasPartyName "ESA"@en ;
    echr:hasSupportingQuote "Regulation 33 § 1: the ESA Appeals Board, 'independent of the Agency', has jurisdiction 'to hear disputes relating to any explicit or implicit decision taken by the Agency and arising between it and a staff member'."@en,
        "The Labour Court considered that ESA enjoyed immunity from jurisdiction according to the ESA Convention and its Annex I."@en ;
    schema:description "European Launcher Development Organisation (referenced as one of the organisations whose members signed or ratified the ESA Convention)."@en,
        "European Space Research Organisation (referenced as one of the organisations whose members signed or ratified the ESA Convention)."@en,
        "Independent body with jurisdiction under Regulation 33 § 1 to hear disputes between the Agency and staff members."@en,
        "The Agency established by the ESA Convention; Article XV and Annex I regulate its legal personality, privileges and immunities."@en ;
    schema:name "European Space Agency"@en ;
    schema:workLocation "Paris"@en .

