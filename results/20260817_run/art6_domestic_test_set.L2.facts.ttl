doc:pl_act_section_1_10_1_1 a schema:Legislation ;
    rdfs:label "Section 1(10)(1)(1) of the Provision of Labour (Temporary Staff) Act"@en ;
    schema:description "Provides that where the contract between a hirer-out and an employee hired out is void under section 1(9)(1), a contract between the hiring employer and the employee hired out is deemed to have been concluded as from the envisaged start of employment."@en ;
    schema:isPartOf doc:provisionOfLabourTemporaryStaffAct .

doc:pl_act_section_1_10_2 a schema:Legislation ;
    rdfs:label "Section 1(10)(2) of the Provision of Labour (Temporary Staff) Act"@en ;
    schema:description "Provides for a claim in damages against the hirer-out for loss suffered as a consequence of having relied on the validity of the contract, except where the employee hired out was aware of the factor rendering the contract void."@en ;
    schema:isPartOf doc:provisionOfLabourTemporaryStaffAct .

doc:pl_act_section_1_1_1 a schema:Legislation ;
    rdfs:label "Section 1(1)(1) of the Provision of Labour (Temporary Staff) Act"@en ;
    schema:description "Provides that an employer who, on a commercial basis, intends to hire out his employees to third persons (hiring employers) must obtain official permission."@en ;
    schema:isPartOf doc:provisionOfLabourTemporaryStaffAct .

doc:pl_act_section_1_9_1 a schema:Legislation ;
    rdfs:label "Section 1(9)(1) of the Provision of Labour (Temporary Staff) Act"@en ;
    schema:description "Provides that contracts between the hirer-out (Verleiher) and the hiring employer (Entleiher) and between the hirer-out and the employee hired out (Leiharbeitnehmer) are void if no official permission has been obtained as required by section 1(1)(1)."@en ;
    schema:isPartOf doc:provisionOfLabourTemporaryStaffAct .

