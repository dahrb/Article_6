    rdfs:label "Darmstadt Labour Court proceeding (first applicant)"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasExtractionNote "On 21 March 1995 the Labour Court declared the action inadmissible, relying on ESA's immunity under Article XV § 2 of the ESA Convention and its Annex I."@en ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasParticipation doc:participation_esa_proc1,
        doc:participation_first_applicant_proc1 ;
