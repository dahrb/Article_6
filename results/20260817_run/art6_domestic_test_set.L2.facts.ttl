doc:agreement_first_applicant_1995 a schema:Agreement ;
    rdfs:label "Agreement with first applicant (20 June 1995)"@en ;
    echr:hasExtractionNote "Agreement dated 20 June 1995 terminating employment on 30 June 1995; T. undertook to pay DEM 14,000 for lawyer's fees and DEM 305,000 for loss of job."@en ;
    schema:datePublished "1995-06-20"^^xsd:date ;
    schema:monetaryAmount doc:amount_dem_14000,
        doc:amount_dem_305000 ;
    schema:party doc:companyT .

doc:app_submission_36 a schema:CommunicateAction ;
    rdfs:label "Applicants' final submissions (paragraph 36)"@en ;
    echr:hasSourceParagraph "36"^^xsd:string ;
    echr:hasSupportingQuote "the applicants invited the Court to hold that their rights pursuant to Article 6 § 1 of the Convention had been violated and to award them just satisfaction under former Article 50 of the Convention (now Article 41)."@en ;
    schema:about doc:article6_issue_1,
        doc:remedy_just_satisfaction_1 ;
    schema:agent doc:partyApplicants ;
    schema:recipient doc:court_1 .

doc:appealsBoard a schema:Organization ;
    rdfs:label "Appeals Board (ESA)"@en ;
    schema:description "Independent body set up under Regulation 33 to hear disputes relating to decisions by the Agency involving staff and related persons; may rescind decisions, order repair of damage, award compensation and settle jurisdictional/procedural questions."@en ;
    schema:isPartOf doc:esa .

doc:applicants_conclusion_1 a schema:Claim ;
    rdfs:label "applicants' conclusion regarding ESA and immunity"@en ;
    schema:author doc:partyApplicants ;
    schema:description "The applicants concluded that the proper functioning of ESA had not required immunity from German jurisdiction in their particular cases."@en .

doc:application_lodged_1995_09_13 a prov:Activity ;
    rdfs:label "application lodged with the Commission on 13 September 1995"@en ;
    prov:wasAttributedTo doc:karlheinzBeer,
        doc:philipRegan ;
    schema:about doc:case_28934_95 ;
    schema:startDate "1995-09-13"^^xsd:date .

doc:application_to_commission_1995_09_13 a schema:Action ;
    rdfs:label "application to the Commission on 13 September 1995"@en ;
    dcterms:description "Mr Beer and Mr Regan applied to the Commission on 13 September 1995."@en ;
    echr:hasSourceParagraph "33"^^xsd:string ;
    schema:agent doc:karlheinzBeer,
        doc:philipRegan ;
    schema:object doc:case_28934_95 ;
    schema:startTime "1995-09-13"^^xsd:date .

doc:article6_issue_access_to_courts_1 a echr:Article6Issue ;
    rdfs:label "access to court limited to preliminary issue"@en ;
    echr:affectsParty doc:partyApplicants ;
    echr:hasIssueDescription "Whether this degree of access limited to a preliminary issue was sufficient to secure the applicants' \"right to a court\", having regard to the rule of law in a democratic society."@en ;
    echr:hasSourceParagraph "48-49"@en ;
    echr:hasSupportingQuote "Admittedly, the applicants were able to argue the question of immunity. However, the Court must examine whether this degree of access limited to a preliminary issue was sufficient to secure the applicants’ \"right to a court\"."@en .

doc:article6_issue_esa_immunity a echr:Article6Issue ;
    rdfs:label "limitation on access to the German courts due to ESA immunity"@en ;
    echr:affectsParty doc:partyApplicants ;
    echr:hasExtractionNote "The Court assessed whether reasonable alternative means were available to protect the applicants' rights and found that alternatives (ESA Appeals Board, compensation claims against foreign firms, labour-law claims) made the immunity permissible under the Convention."@en ;
    echr:hasIssueDescription "Limitation on access to the German courts because ESA enjoyed immunity from German jurisdiction."@en .

doc:asToTheLaw a schema:WebPageElement ;
    rdfs:label "AS TO THE LAW"@en ;
    schema:articleBody "AS TO THE LAW"@en ;
    schema:name "AS TO THE LAW"@en .

doc:caseWaiteAndKennedy a echr:CaseDocument ;
    rdfs:label "case of Mr Waite and Mr Kennedy"@en ;
    echr:hasSupportingQuote "The Labour Court further referred to the decision of the Federal Labour Court in the case of Mr Waite and Mr Kennedy."@en .

doc:case_document_1 a echr:CaseDocument ;
    rdfs:label "Case document"@en,
        "ESA immunity case"@en ;
    echr:hasDomesticProceeding doc:domestic_proceeding_darmstadt_1,
        doc:domestic_proceeding_germany_1 ;
    echr:hasExtractionNote "The Court concluded there was no violation of Article 6 § 1; the applicants had alternative remedies including appeal to the ESA Appeals Board, claims for compensation against the foreign firms that hired them out, and claims under German labour law (Provision of Labour (Temporary Staff) Act)."@en ;
    echr:hasRespondentState "Germany"^^xsd:string,
        "Germany"@en .

doc:commission_decision_1997_02_24 a schema:Action ;
    rdfs:label "Commission declared the application admissible on 24 February 1997"@en ;
    dcterms:description "On 24 February 1997 the Commission declared the application (no. 28934/95) admissible."@en ;
    echr:hasSourceParagraph "34"^^xsd:string ;
    schema:agent doc:commission ;
    schema:datePublished "1997-02-24"^^xsd:date ;
    schema:object doc:case_28934_95 .

doc:commission_report_1997_12_02 a schema:Report ;
    rdfs:label "report of 2 December 1997"@en ;
    dcterms:description "In its report of 2 December 1997 (former Article 31 of the Convention) the Commission expressed the opinion that there had been no violation of Article 6 § 1 of the Convention (seventeen votes to fifteen)."@en ;
    echr:hasSourceParagraph "34"^^xsd:string ;
    schema:about doc:case_28934_95 ;
    schema:datePublished "1997-12-02"^^xsd:date .

doc:committee_comment_1 a schema:Claim ;
    rdfs:label "committee comment on immunity and Article 6"@en ;
    schema:author doc:committeeStaffReps ;
    schema:description "The Committee of Staff Representatives considered that the statutory provisions concerning immunity had to be interpreted so as to satisfy the fundamental rights under Article 6 § 1 of the Convention."@en .

doc:committee_staff_reps_application_1998_11_19 a prov:Activity ;
    rdfs:label "letter seeking leave to submit written comments from the Committee of Staff Representatives of the Coordinated Organisations (19 November 1998)"@en ;
    dcterms:description "Committee sought leave to submit written comments; leave granted by the President on 20 November 1998 and comments filed on 23 November 1998."@en ;
    schema:startDate "1998-11-19"^^xsd:date .

doc:court_finding_immunity_legitimate_1 a schema:Claim ;
    rdfs:label "Court finding that immunity rule has legitimate objective"@en ;
    schema:about doc:domestic_proceeding_1 ;
    schema:author doc:commissionEchr ;
    schema:description "The Court finds that the rule of immunity from jurisdiction, which the German courts applied to ESA in the present case, has a legitimate objective."@en .

doc:court_proportionality_direction_1 a schema:Claim ;
    rdfs:label "Court's direction to assess proportionality in light of circumstances"@en ;
    schema:about doc:domestic_proceeding_1 ;
    schema:author doc:commissionEchr ;
    schema:description "As to the issue of proportionality, the Court must assess the contested limitation placed on Article 6 in the light of the particular circumstances of the case."@en .

