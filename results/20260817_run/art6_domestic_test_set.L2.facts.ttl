doc:proceedingSecondApplicantDarmstadt a echr:DomesticProceeding ;
    rdfs:label "Darmstadt Labour Court proceeding (second applicant)"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasExtractionNote "On 21 March 1995 the Labour Court declared the action inadmissible, relying on ESA's immunity under Article XV § 2 of the ESA Convention and its Annex I. The Labour Court referred to the Federal Labour Court decision of 10 November 1993 (file no. 7 AZR 600/92)."@en ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasParticipation doc:participationSecondApplicantDismissal,
        doc:participation_esa_proc1 ;
    echr:hasProceedingStartDate "1993-11"^^xsd:gYearMonth .

doc:proceeding_darmstadt_labour_court_1 a echr:DomesticProceeding ;
    rdfs:label "Darmstadt Labour Court proceeding"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasExtractionNote "The Darmstadt Labour Court found the applicants' action inadmissible on grounds that ESA enjoyed immunity from jurisdiction under the ESA Convention and Annex I and that the conditions of section 20(2) of the German Courts Act were satisfied."@en ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasParticipation doc:participationApplicantsDarmstadt ;
    echr:hasProceedingType echr:TypeLabour ;
    echr:hasSourceParagraph "45-46"@en ;
    echr:hasSupportingQuote "In the instant case the Darmstadt Labour Court concluded that the conditions under section 20(2) of the German Courts Act for finding that the applicants’ action was inadmissible were fulfilled."@en .

