    echr:hasJurisdictionState "Germany"@en .

doc:federal_labour_court_decision_7_AZR_600_92 a schema:LegalCase ;
    rdfs:label "Federal Labour Court decision (file no. 7 AZR 600/92, 10 November 1993)"@en ;
    rdfs:comment "Decision of 10 November 1993 referred to by the Darmstadt Labour Court; cited as relevant precedent."@en ;
    schema:datePublished "1993-11-10"^^xsd:date ;
    schema:identifier "7 AZR 600/92"^^xsd:string .

doc:gov_commission_opinion_1 a schema:Claim ;
    rdfs:label "Government and Commission opinion on immunity"@en ;
    schema:author doc:commission,
        doc:government ;
    schema:description "The Government and the Commission were of the opinion that the purpose of immunity in international law lay in the protection of international organisations against interference by individual governments and that this constituted a legitimate aim for restricting Article 6."@en .

doc:gov_submission_35 a schema:CommunicateAction ;
    rdfs:label "Government final submissions (paragraph 35)"@en ;
    echr:hasSourceParagraph "35"^^xsd:string ;
    echr:hasSupportingQuote "“for the applications to be rejected as inadmissible, or as an alternative for a finding that the Federal Republic of Germany has not violated Article 6 of the Convention”."@en ;
    schema:about doc:gov_requested_no_violation_1,
        echr:OutcomeDeclaredInadmissible ;
    schema:agent doc:government_party_1 ;
    schema:recipient doc:court_1 .

doc:government_submission_proportionality_1 a schema:Claim ;
    rdfs:label "Government submission on proportionality"@en ;
    schema:author doc:government ;
    schema:description "The Government submitted that the limitation was proportionate to the objective of enabling international organisations to perform their functions efficiently."@en .

