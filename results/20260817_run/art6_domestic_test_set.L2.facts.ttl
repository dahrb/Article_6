doc:domestic_proceeding_germany_1 a echr:DomesticProceeding ;
    rdfs:label "proceeding before German courts concerning ESA immunity"@en ;
    echr:hasCourt doc:germanCourts ;
    echr:hasExtractionNote "German courts gave effect to ESA immunity on the basis of section 20(2) of the Courts Act; the Strasbourg Court found that the German courts did not exceed their margin of appreciation."@en ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasProceedingType echr:TypeUnknown .

doc:esaAnnexIArticleI a schema:Legislation ;
    rdfs:label "Article I of Annex I to the ESA Convention"@en ;
    schema:description "Provides that the Agency shall have legal personality, including capacity to contract, acquire and dispose of property, and to be party to legal proceedings."@en ;
    schema:isPartOf doc:esaAnnexI .

doc:esaAnnexIArticleIv a schema:Legislation ;
    rdfs:label "Article IV §1(a) of Annex I to the ESA Convention"@en ;
    schema:description "Provides that the Agency shall have immunity from jurisdiction and execution except to the extent waived by the Council; the Council must waive immunity where reliance on it would impede justice and waiver would not prejudice Agency interests."@en ;
    schema:isPartOf doc:esaAnnexI .

doc:esaAnnexIArticleXxv a schema:Legislation ;
    rdfs:label "Article XXV of Annex I to the ESA Convention"@en ;
    schema:description "Provides for arbitration with regard to written contracts other than those concluded under the Staff Regulations and allows member States to submit certain disputes to the International Arbitration Tribunal."@en ;
    schema:isPartOf doc:esaAnnexI .

doc:esaConvention a schema:LegalDocument,
        schema:Legislation ;
    rdfs:label "ESA Convention"@en,
        "ESA Convention (Annex I)"@en ;
    rdfs:comment "Cited in the judgment (Article XV § 2 of the ESA Convention and Article IV § 1 of its Annex I) as the basis for the claim of immunity."@en ;
    schema:datePublished "1980-10-30"^^xsd:date ;
    schema:description "Convention establishing the European Space Agency (ESA) and regulating its purposes, legal status, privileges and immunities."@en ;
    schema:hasPart doc:esaAnnexI,
        doc:esaArticleXix,
        doc:esaArticleXv,
        doc:esaArticleXvii .

doc:esaStaffRegulations a schema:Legislation ;
    rdfs:label "ESA Staff Regulations"@en ;
    schema:description "Regulatory instrument governing ESA staff; Chapter VIII (Regulations 33 to 41) concerns disputes within ESA and establishes an Appeals Board."@en ;
    schema:hasPart doc:esa_staff_regulation_33 .

doc:esa_staff_regulation_33 a schema:Legislation ;
    rdfs:label "Regulation 33 of the ESA Staff Regulations"@en ;
    schema:description "Establishes an independent Appeals Board to hear disputes between the Agency and staff/former staff; sets out powers including rescinding decisions contrary to the Regulations, ordering repair of damage, awarding compensation when rescission raises major difficulties, competence where Director General refuses to waive immunity of another staff member, and competence to settle jurisdictional or procedural questions."@en ;
    schema:isPartOf doc:esaStaffRegulations .

