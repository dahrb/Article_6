doc:cost_order_2001 a echr:DomesticProceeding ;
    rdfs:label "Order for additional witness costs"^^xsd:string ;
    echr:followsProceeding doc:appeal_conviction_2001 ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
    echr:hasDecisionDate "2001-10-11"^^xsd:date ;
    echr:hasParticipation doc:participation_matko_costs_2001 ;
    echr:hasSupportingQuote "on 11 October 2001 the Slovenj Gradec District Court ordered the applicant to pay an additional sum to cover the costs of one of the witnesses heard during the proceedings. On that day, the proceedings were “finally concluded”"@en ;
    echr:isFinalDomesticDecision true .

doc:detention_matko_1995 a echr:PreTrialDetention ;
    rdfs:label "Detention of Aleksander Matko April 1995"@en ;
