doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Initial claim by Scholz AG"^^xsd:string ;
    echr:hasCourt doc:commercialCourt ;
    echr:hasDecisionDate "2007-11-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_1_safaryan,
        doc:part_1_scholz ;
    echr:hasProceedingStartDate "2007-01-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 15 January 2007 the applicant company lodged a claim with the Commercial Court against the LLC... On 16 November 2007 the Commercial Court granted the request and decided to leave the applicant company’s claim and the counterclaim lodged by the LLC unexamined."^^xsd:string .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Appeal against decision to leave claim unexamined"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:commercialCourt ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasParticipation doc:part_2_scholz ;
    echr:hasProceedingStartDate "2007-11-23"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 23 November 2007 the applicant company lodged a complaint concerning the decision to leave the claim and counterclaim unexamined."^^xsd:string .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "Complaint against decision to leave claim unexamined (Dec 2007)"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:commercialCourt ;
    echr:hasDecisionDate "2007-12-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_3_scholz ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 10 December 2007 a three-judge bench of the Commercial Court rejected the complaint submitted by the applicant company."^^xsd:string .

doc:proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "Claim for recovery of loan in Yerevan Civil Court"^^xsd:string ;
    echr:followsProceeding doc:adminActionArbitrationRefusal ;
    echr:hasCourt doc:yerevanCivilCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:part_4_scholz ;
    echr:hasProceedingStartDate "2008-10-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "on 17 October 2008 the applicant company lodged a claim with the Yerevan Civil Court, seeking to recover EUR 116,600 from the LLC"^^xsd:string .

doc:proceeding_5 a echr:DomesticProceeding ;
    rdfs:label "Claim for recovery of loan in District Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_4 ;
    echr:hasCourt doc:districtCourtYerevan ;
    echr:hasDecisionDate "2009-06-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_5_safaryan,
        doc:part_5_scholz ;
    echr:hasProceedingStartDate "2009-03-13"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 13 March 2009 the District Court accepted the case for examination... On 16 June 2009 the District Court decided to leave the claim lodged by the applicant company unexamined"^^xsd:string .

doc:proceeding_6 a echr:DomesticProceeding ;
    rdfs:label "Appeal to Civil Court of Appeal"^^xsd:string ;
    echr:followsProceeding doc:proceeding_5 ;
    echr:hasCourt doc:civilCourtAppeal ;
    echr:hasDecisionDate "2009-07-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_6_safaryan,
        doc:part_6_scholz ;
    echr:hasProceedingStartDate "2009-06-25"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 25 June 2009 the applicant company lodged an appeal... On 21 July 2009 the Civil Court of Appeal upheld the decision of 16 June 2009."^^xsd:string .

