    echr:hasProceedingStartDate "2009-08-04"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 4 August 2009 the applicant company lodged an appeal on points of law... On 23 September 2009 the Court of Cassation declared the applicant company’s appeal on points of law inadmissible."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:adminActionArbitrationRefusal a echr:AdministrativeAction ;
