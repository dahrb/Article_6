@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/aa2bb14a2d16/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/aa2bb14a2d16> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:2"^^xsd:string .

doc:caseBeerRegan a echr:CaseDocument ;
    echr:hasApplicant doc:karlheinzBeer,
        doc:philipRegan ;
    echr:hasApplicationNumber "28934/95"@en ;
    echr:hasCaseName "Beer and Regan v. Germany"@en ;
    echr:hasDomesticProceeding doc:proceedingBeerEsa,
        doc:proceedingReganEsa,
        doc:proceedingReganTi ;
    echr:hasRespondentState "Germany"@en .

doc:companyT a echr:Party ;
    rdfs:label "T"@en,
        "T.I."@en .

doc:partBeerEsa a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:karlheinzBeer .

doc:partEsaBeer a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:esa .

doc:partEsaRegan a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:esa .

doc:partReganEsa a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:philipRegan .

doc:partReganTi a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:philipRegan .

doc:partTiRegan a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:companyT .

doc:proceedingBeerEsa a echr:DomesticProceeding ;
    rdfs:label "Beer v ESA proceeding"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partBeerEsa,
        doc:partEsaBeer ;
    echr:hasProceedingStartDate "1993"^^xsd:gYear ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."@en .

doc:proceedingReganEsa a echr:DomesticProceeding ;
    rdfs:label "Regan v ESA proceeding"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partEsaRegan,
        doc:partReganEsa ;
    echr:hasProceedingStartDate "1993"^^xsd:gYear ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."@en .

doc:proceedingReganTi a echr:DomesticProceeding ;
    rdfs:label "Regan v TI proceeding"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1994-09-06"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeSettledOrWithdrawn ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:partReganTi,
        doc:partTiRegan ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "a settlement had been reached in the Darmstadt Labour Court on 6 September 1994"@en .

doc:esa a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "European Space Agency"@en ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "European Space Agency"@en .

doc:karlheinzBeer a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Karlheinz Beer"@en ;
    echr:hasGender echr:GenderMale ;
    echr:hasPersonName "Mr Karlheinz Beer"@en ;
    echr:hasSupportingQuote "Mr Karlheinz Beer"@en .

doc:darmstadtLabourCourt a echr:DomesticAuthority ;
    rdfs:label "Darmstadt Labour Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Darmstadt Labour Court"@en .

doc:philipRegan a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Philip Regan"@en ;
    echr:hasGender echr:GenderMale ;
    echr:hasPersonName "Mr Philip Regan"@en ;
    echr:hasSupportingQuote "Mr Philip Regan"@en .

