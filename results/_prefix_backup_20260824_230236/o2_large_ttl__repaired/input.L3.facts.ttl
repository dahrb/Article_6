doc:proceedingSaleAnnulmentRectification a echr:DomesticProceeding ;
    rdfs:label "Rectification of sale annulment decision"^^xsd:string ;
    echr:followsProceeding doc:proceedingSaleAnnulmentAppeal ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelSupervisoryReview ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:partRectAksoy,
        doc:partRectFund ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 30 June 2017, the 13 th Chamber of the Supreme Administrative Court granted the request, referring to the ruling of the General Assembly of 7 July 2015 which had annulled the Fund’s decision of 13 January 2011 concerning the valuation of Viva TV-Radio Viva (see paragraph 29 above). The court held that the annulment in that judgment necessitated a fresh judicial review of the case."@en .

