doc:appealHouseLords a echr:DomesticProceeding ;
    rdfs:label "Petition to the House of Lords"^^xsd:string ;
    echr:followsProceeding doc:appealCourtAppeal ;
    echr:hasCourt doc:houseOfLords ;
    echr:hasDecisionDate "2000-06-15"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationLordsSawoniuk ;
    echr:hasSupportingQuote "On 15 June 2000, the House of Lords refused the petition for leave to appeal."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:bailReviewHighCourt a echr:DomesticProceeding ;
