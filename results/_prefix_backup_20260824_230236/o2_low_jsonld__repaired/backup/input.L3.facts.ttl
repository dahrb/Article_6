doc:admin_action_1 a echr:AdministrativeAction ;
    rdfs:label "Fund decision of 13 January 2011"@en,
        "Fund decision on default"@en,
        "Fund decision on impossibility of enforcement"@en,
        "transfer of İktisat Bank management"@en ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:board_1,
        doc:fund_1 ;
    echr:hasDecisionDate "2001-03-15"^^xsd:date,
        "2008-04-03"^^xsd:date,
        "2011-01-13"^^xsd:date,
        "2015-10-27"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_1_debtor,
        doc:participation_fund_1 ;
    echr:hasSupportingQuote "By a decision dated 15 March 2001, the Banking Regulation and Supervision Board... resolved to transfer the management and control of İktisat Bankası T.A.Ş."@en,
        "On 3 April 2008, the Fund concluded that the Erol Aksoy Group had failed to fulfil several commitments and obligations set out in the Liquidation Protocol, rendering the Protocol no longer effective for the recovery of public receivables. Consequently, the Fund decided to rely on its provisions concerning default."@en,
        "the Fund notified the applicant of a decision taken on 27 October 2015 regarding the impossibility of enforcing the judgment."@en,
        "the Fund’s decision of 13 January 2011, which approved the invitation to tender and the terms of sale"@en .

