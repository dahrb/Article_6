doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Administrative Court Challenge"^^xsd:string,
        "First instance proceeding before the 13th Chamber"^^xsd:string,
        "First-instance administrative court proceeding"^^xsd:string,
        "annulment proceedings before the administrative court"^^xsd:string ;
    echr:followsProceeding doc:admin_action_6 ;
    echr:hasCourt doc:court_1,
        doc:court_2,
        doc:istanbul_admin_court_6 ;
    echr:hasDecisionDate "2014-03-19"^^xsd:date,
        "2014-12-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_1_1,
        doc:part_1_2,
        doc:part_1_app,
        doc:part_1_fund,
        doc:participation_1 ;
    echr:hasProceedingStartDate "2011-02-07"^^xsd:date,
        "2011-02-24"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 24 February 2011, the applicant initiated proceedings before the administrative court, seeking the annulment of the sale of Viva TV-Radio Viva."^^xsd:string,
        "On 7 February 2011, the applicant initiated proceedings before the administrative court, contesting the actions of the Fund"^^xsd:string,
        "On 9 December 2014, the 13th Chamber of the Supreme Administrative Court dismissed the applicant’s case"^^xsd:string,
        "the decision of the first-instance administrative court, which had dismissed the case on the grounds of his lack of standing"^^xsd:string .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Appeal before the General Assembly"^^xsd:string,
        "Supreme Administrative Court appeal"^^xsd:string,
        "appeal before the Supreme Administrative Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:court_2 ;
    echr:hasDecisionDate "2006-07-20"^^xsd:date,
        "2014-12-09"^^xsd:date,
        "2015-07-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided,
        echr:OutcomeRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant,
        echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_2_1,
        doc:part_2_2,
        doc:part_2_app,
        doc:part_2_fund,
        doc:participation_1 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 20 July 2006, the Supreme Administrative Court... quashed the administrative court’s earlier decision"^^xsd:string,
        "On 7 July 2015, following an appeal by the applicant, the General Assembly... annulled the Fund’s decision"^^xsd:string,
        "On an appeal by the applicant, the 13th Chamber of the Supreme Administrative Court upheld that decision on 9 December 2014."^^xsd:string ;
    echr:isFinalDomesticDecision true .

