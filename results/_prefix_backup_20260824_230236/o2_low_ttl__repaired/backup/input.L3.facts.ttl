doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "Constitutional Court individual application"^^xsd:string,
        "Rectification request proceeding"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:court_2,
        doc:court_3 ;
    echr:hasDecisionDate "2016-01-25"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelConstitutional,
        echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible,
        echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant,
        echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_3_1,
        doc:part_3_2,
        doc:part_3_app,
        doc:part_3_fund ;
    echr:hasProceedingType echr:TypeAdministrative,
        echr:TypeConstitutional ;
    echr:hasSupportingQuote "On 25 January 2016, the Supreme Administrative Court rejected the Fund’s request for rectification"^^xsd:string,
        "The Constitutional Court concluded that the administration’s failure to enforce the annulment decisions amounted to a violation of the applicant’s property rights"^^xsd:string ;
    echr:isFinalDomesticDecision true .

