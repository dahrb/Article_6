doc:admin_action_1 a echr:AdministrativeAction ;
    rdfs:label "Fund decision on Protocol default"^^xsd:string,
        "Fund decision on impossibility of enforcement"^^xsd:string,
        "TSKB Valuation Report 2007"^^xsd:string,
        "transfer of management and control of İktisat Bank"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:boardAuthority,
        doc:fund,
        doc:tskb_1 ;
    echr:hasDecisionDate "2001-03-15"^^xsd:date,
        "2007-08-01"^^xsd:date,
        "2008-04-03"^^xsd:date,
        "2015-10-27"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_1,
        doc:part_2,
        doc:participation_1 ;
    echr:hasSupportingQuote "By a decision dated 15 March 2001, the Banking Regulation and Supervision Board... resolved to transfer the management and control of İktisat Bankası T.A.Ş."^^xsd:string,
        "On 1 August 2007, the Industrial Development Bank of Türkiye ( Türkiye Sınaî Kalkınma Bankası A.Ş ., hereinafter referred to as “TSKB”) issued a report"^^xsd:string,
        "On 3 April 2008, the Fund concluded that the Erol Aksoy Group had failed to fulfil several commitments and obligations set out in the Liquidation Protocol, rendering the Protocol no longer effective for the recovery of public receivables."^^xsd:string,
        "the Fund notified the applicant of a decision taken on 27 October 2015 regarding the impossibility of enforcing the judgment."^^xsd:string .

doc:admin_action_2 a echr:AdministrativeAction ;
    rdfs:label "Fund Sale Resolution 2007"^^xsd:string,
        "Fund resolution to transfer management"^^xsd:string,
        "resolution to recover debts"^^xsd:string ;
    echr:followsProceeding doc:admin_action_1 ;
    echr:hasCourt doc:fund ;
    echr:hasDecisionDate "2001-09-14"^^xsd:date,
        "2007-08-29"^^xsd:date,
        "2008-09-18"^^xsd:date ;
    echr:hasParticipation doc:part_3,
        doc:part_4,
        doc:participation_1 ;
    echr:hasSupportingQuote "On 18 September 2008, the Fund further resolved to transfer the management and control of all companies within the Erol Aksoy Group to itself"^^xsd:string,
        "On 29 August 2007, the Fund resolved to offer both Viva TV and Radio Viva for sale"^^xsd:string,
        "on 14 September 2001, the Fund resolved to recover 726,122,000 Turkish liras from the former shareholders"^^xsd:string .

