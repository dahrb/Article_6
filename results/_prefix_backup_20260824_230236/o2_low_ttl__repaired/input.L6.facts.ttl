    echr:hasPersonName "the director of the LLC" ;
    echr:hasSupportingQuote "the director of the LLC... he had been unaware" .

doc:proceeding_cassation_1 a echr:DomesticProceeding ;
    rdfs:label "Court of Cassation proceeding"^^xsd:string ;
    echr:followsProceeding doc:proceeding_appeal_1 ;
