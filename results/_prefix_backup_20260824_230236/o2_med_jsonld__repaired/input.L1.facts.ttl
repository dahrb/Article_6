<https://growgraph.dev/doc/3c9a1e0dbd58> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:1"^^xsd:string .

doc:actionHomePlacement a echr:AdministrativeAction,
        echr:DomesticProceeding ;
    rdfs:label "Placement in Pastra social care home"@en ;
    echr:followsProceeding doc:actionGuardianAppointment ;
    echr:hasCourt doc:pastra_social_care_home ;
    echr:hasDecisionDate "2002-12-10"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasParticipation doc:participation_home_guardian ;
    echr:hasSupportingQuote "On 10 December 2002 a welfare-placement agreement was signed between R.P. and the social care home"@en .

doc:caseStanevBulgaria a echr:CaseDocument ;
    rdfs:label "Stanev v. Bulgaria"@en ;
    echr:hasApplicant doc:applicantStanev ;
    echr:hasApplicationNumber "36760/06"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceedingIncapacityRuse ;
    echr:hasRespondentState "Republic of Bulgaria"^^xsd:string .

doc:case_document_1 a echr:CaseDocument ;
    rdfs:label "Case regarding Pastra social care home"^^xsd:string ;
    echr:hasApplicant doc:applicant_1 ;
    echr:hasDomesticProceeding <http://example.org/base/administrative_action_1>,
        doc:domestic_proceeding_1,
        doc:prosecutorial_review_1,
        doc:prosecutorial_review_2 .

doc:participation_1 echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicant_1 .

doc:prosecutorial_review_chief a echr:DomesticProceeding ;
    rdfs:label "Chief Public Prosecutor's review"@en ;
    echr:followsProceeding doc:prosecutorial_review_2 ;
    echr:hasCourt doc:chief_prosecutor_1 ;
    echr:hasDecisionDate "2005-11-29"@en ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_rev_chief ;
    echr:hasSupportingQuote "subsequently on 29 November 2005 by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation"@en .

doc:actionGuardianAppointment a echr:AdministrativeAction,
        echr:DomesticProceeding ;
    rdfs:label "Appointment of guardian by Ruse Municipal Council"@en ;
    echr:followsProceeding doc:proceedingAppealVelikoTarnovo ;
