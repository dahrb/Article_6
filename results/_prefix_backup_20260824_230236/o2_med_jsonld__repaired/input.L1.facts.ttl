    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasParticipation doc:partCouncilRuse ;
    echr:hasSupportingQuote "on 23 May 2002 the Municipal Council appointed Ms R.P., a council officer, as the applicant’s guardian"@en .

doc:administrative_action_1 a echr:AdministrativeAction,
        echr:DomesticProceeding ;
    rdfs:label "Mayor of Rila's refusal"^^xsd:string ;
    echr:hasCourt doc:mayor_rila_1 ;
    echr:hasDecisionDate "2005-09-16"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_admin_1 ;
    echr:hasSupportingQuote "In a letter of 16 September 2005, the mayor of Rila refused his request"@en .

