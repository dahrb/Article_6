doc:prosecutorial_review_1 a echr:ProsecutorialReview ;
    rdfs:label "Regional Prosecutor's refusal to bring action"^^xsd:string ;
    echr:hasCourt doc:prosecutorRuse ;
    echr:hasDecisionDate "2005-08-10"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_rev_1 ;
    echr:hasSupportingQuote "On 10 August 2005 the regional prosecutor refused to bring an action for restoration of the applicant’s legal capacity"@en .

doc:prosecutorial_review_2 a echr:ProsecutorialReview ;
    rdfs:label "Appellate Prosecutor's review"^^xsd:string ;
    echr:followsProceeding doc:prosecutorial_review_1 ;
    echr:hasCourt doc:appellate_prosecutor_1 ;
    echr:hasDecisionDate "2005-10-11"^^xsd:date,
        "2005-11-29"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_rev_2 ;
    echr:hasSupportingQuote "subsequently on 29 November 2005 by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation"@en,
        "the regional prosecutor’s refusal was upheld on 11 October 2005 by the appellate prosecutor"@en .

