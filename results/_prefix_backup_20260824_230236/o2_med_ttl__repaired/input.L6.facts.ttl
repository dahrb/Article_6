<https://growgraph.dev/doc/4001ea14f09a> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:6"^^xsd:string .

doc:caseScholzAg a echr:CaseDocument ;
    echr:hasCaseName "Scholz AG v. Armenia"^^xsd:string .

doc:case_document_1 a echr:CaseDocument ;
    echr:hasApplicant doc:applicant_company_1 ;
    echr:hasDomesticProceeding doc:proceeding_commercial_court_1 .

doc:partyLlc a echr:Party ;
    rdfs:label "A. Safaryan and Associates LLC"^^xsd:string ;
    echr:hasPartyName "A. Safaryan and Associates LLC"^^xsd:string ;
    echr:hasSupportingQuote "A. Safaryan and Associates LLC, a limited liability company registered in Armenia (\"the LLC\")"^^xsd:string .

doc:partyScholzAg a echr:Party ;
    rdfs:label "Scholz AG"^^xsd:string ;
    echr:hasPartyName "Scholz AG"^^xsd:string ;
    echr:hasSupportingQuote "a German corporation, Scholz AG (\"the applicant company\")"^^xsd:string ;
    echr:isRepresentedBy doc:lawyerAbgaryan,
        doc:lawyerAtanesyan .

doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Initial claim before Commercial Court"^^xsd:string ;
    echr:hasCourt doc:authorityCommercialCourt ;
    echr:hasParticipation doc:part_1_llc,
        doc:part_1_scholz ;
    echr:hasSupportingQuote "On 16 November 2007 the Commercial Court granted the request and decided to leave the applicant company’s claim and the counterclaim lodged by the LLC unexamined."^^xsd:string .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Appeal against unexamined claim decision"^^xsd:string ;
    echr:hasParticipation doc:part_2_scholz ;
    echr:hasSupportingQuote "On 23 November 2007 the applicant company lodged a complaint concerning the decision to leave the claim and counterclaim unexamined."^^xsd:string .

doc:proceeding_cassation_1 a echr:DomesticProceeding ;
    rdfs:label "Court of Cassation appeal"^^xsd:string ;
    echr:followsProceeding doc:proceeding_appeal_1 ;
    echr:hasCourt doc:court_of_cassation_1 ;
    echr:hasDecisionDate "2009-09-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_cass_app_1 ;
    echr:hasProceedingStartDate "2009-08-04"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 23 September 2009 the Court of Cassation declared the applicant company’s appeal on points of law inadmissible."^^xsd:string ;
    echr:isFinalDomesticDecision true .

