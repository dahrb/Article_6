doc:enforcement_phase_1 a echr:DomesticProceeding ;
    rdfs:label "enforcement of Supreme Administrative Court judgments"@en ;
    echr:followsProceeding doc:proceeding_annulment_1 ;
    echr:hasInstanceLevel echr:LevelEnforcement ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSourceParagraph "1"@en ;
    echr:hasSupportingQuote "non-enforcement of judgments delivered by the Supreme Administrative Court"@en ;
    echr:isFinalDomesticDecision true .

doc:proceedingConstitutionalApp a echr:DomesticProceeding ;
    rdfs:label "Constitutional Court individual application"^^xsd:string ;
    echr:hasCourt doc:constitutionalCourt ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelConstitutional ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2017-09-11"^^xsd:date ;
    echr:hasProceedingType echr:TypeConstitutional ;
    echr:hasSourceParagraph "41, 42"@en ;
    echr:hasSupportingQuote "On 11 September 2017, the applicant lodged an individual application with the Constitutional Court... the Constitutional Court declared the application inadmissible"@en ;
    echr:isFinalDomesticDecision true .

doc:proceedingSupremeAdmin a echr:DomesticProceeding ;
    rdfs:label "Supreme Administrative Court appeal"^^xsd:string ;
    echr:followsProceeding doc:proceedingFirstInstance ;
    echr:hasCourt doc:admin_court_1 ;
    echr:hasDecisionDate "2006-07-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "47"@en ;
    echr:hasSupportingQuote "On 20 July 2006, the Supreme Administrative Court... quashed the administrative court’s earlier decision"@en .

doc:proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "request for rectification before the Supreme Administrative Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:admin_court_1 ;
    echr:hasDecisionDate "2016-01-25"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "30"^^xsd:string ;
    echr:hasSupportingQuote "the Supreme Administrative Court rejected the Fund’s request for rectification"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:proceeding_recovery_2008 rdfs:label "legal proceedings for recovery of public receivables"^^xsd:string ;
    echr:hasCourt doc:fund ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:participationApplicantRecovery ;
    echr:hasProceedingStartDate "2008-04-03"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "13"^^xsd:string ;
    echr:hasSupportingQuote "the Fund decided to rely on its provisions concerning default. It resolved to initiate legal proceedings against all natural and legal person debtors within the Erol Aksoy Group"^^xsd:string .

doc:proceeding_rectification_1 a echr:DomesticProceeding ;
    rdfs:label "request for rectification"^^xsd:string ;
    echr:followsProceeding doc:proceeding_appeal_1 ;
    echr:hasCourt doc:admin_court_1 ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelReopening ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "37"^^xsd:string ;
    echr:hasSupportingQuote "On 30 June 2017, the 13 th Chamber of the Supreme Administrative Court granted the request"^^xsd:string ;
    echr:isFinalDomesticDecision true .

