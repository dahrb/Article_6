<https://growgraph.dev/doc/4ff87067ed83> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:10"^^xsd:string .

doc:administrative_phase_1 a echr:DomesticProceeding ;
    rdfs:label "During the administrative phase, the applicants attempted, firstly, to obtain documents that would enable them to enter and reside legally in Belgium for the period required to make a formal asylum claim; secondly, they brought proceedings before the administrative courts to challenge the refusal by the Aliens Office to issue them with visas."@en,
        "proceedings before the administrative courts to challenge the refusal by the Aliens Office to issue them with visas"@en ;
    echr:followsProceeding doc:visa_applications_2016_08_22 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "8"^^xsd:string ;
    echr:hasSupportingQuote "During the administrative phase, the applicants attempted, firstly, to obtain documents that would enable them to enter and reside legally in Belgium for the period required to make a formal asylum claim; secondly, they brought proceedings before the administrative courts to challenge the refusal by the Aliens Office to issue them with visas."@en,
        "secondly, they brought proceedings before the administrative courts to challenge the refusal by the Aliens Office to issue them with visas."@en .

doc:domestic_proceeding_6_conseil_d_etat_appeal_dismissed_8_february_2018 a ns1:DomesticProceeding ;
    rdfs:label "On 8 February 2018 the Conseil d’État dismissed an appeal on points of law by the applicants."@en ;
    ns1:followsProceeding doc:domestic_proceeding_5_aliens_appeals_board_lift_stay_6_march_2017 ;
    ns1:hasSourceParagraph 17 ;
    ns1:hasSupportingQuote "On 8 February 2018 the Conseil d’État dismissed an appeal on points of law by the applicants against the judgment of 6 March 2017. It held that no departure from the case-law had been made out and dismissed the arguments in which the applicants alleged a breach of the principle of legal certainty and a violation of Articles 3 and 13 of the Convention."^^xsd:string .

doc:domestic_proceeding_1_alien_office_refusal_13_september_2016 a ns1:DomesticProceeding ;
    rdfs:label "On 13 September 2016 the Aliens Office refused to grant “humanitarian visas” to the applicants."@en ;
    ns1:hasSourceParagraph 11 ;
    ns1:hasSupportingQuote "On 13 September 2016 the Aliens Office, the administrative body responsible for issuing visas (see paragraph 45 below), refused to grant “humanitarian visas” to the applicants and informed them of its decisions by an email of 29 September 2016, transmitted through the visa department of the Belgian embassy in Beirut."^^xsd:string .

doc:domestic_proceeding_2_aliens_appeals_board_stay_7_october_2016 a ns1:DomesticProceeding ;
    rdfs:label "On 7 October 2016 the Aliens Appeals Board ordered a stay of execution of the visa refusals."@en ;
    ns1:followsProceeding doc:domestic_proceeding_1_alien_office_refusal_13_september_2016 ;
    ns1:hasSourceParagraph 15 ;
    ns1:hasSupportingQuote "On 7 October 2016 the Aliens Appeals Board, acting under the extremely urgent procedure, ordered a stay of execution of the refusals by the Aliens Office to grant visas and instructed the Belgian State to take new decisions within 48 hours, giving adequate legal grounds, that is, by giving reasons which took account of the extremely dangerous situation in Syria."^^xsd:string .

doc:domestic_proceeding_3_alien_office_new_decisions_10_october_2016_refusal a ns1:DomesticProceeding ;
    rdfs:label "As required by the Aliens Appeals Board’s order, the Aliens Office issued new decisions dated 10 October 2016 refusing to grant the visas."@en ;
    ns1:followsProceeding doc:domestic_proceeding_2_aliens_appeals_board_stay_7_october_2016 ;
    ns1:hasSourceParagraph 19 ;
    ns1:hasSupportingQuote "As required by the order of the Aliens Appeals Board (see paragraph 15 above), the Aliens Office issued new decisions, dated 10 October 2016, refusing to grant the visas; however, it provided the same reasons as in the previous refusals."^^xsd:string .

doc:domestic_proceeding_4_aliens_appeals_board_stay_14_october_2016 a ns1:DomesticProceeding ;
    rdfs:label "By a judgment of 14 October 2016 the Aliens Appeals Board again ordered a stay of execution of the decision refusing to issue the visas."@en ;
    ns1:followsProceeding doc:domestic_proceeding_3_alien_office_new_decisions_10_october_2016_refusal ;
    ns1:hasSourceParagraph 20 ;
    ns1:hasSupportingQuote "By a judgment of 14 October 2016 the Aliens Appeals Board, acting under the extremely urgent procedure, again ordered a stay of execution of the decision of 10 October 2016 refusing to issue the visas, and instructed the Aliens Office to take new decisions, this time giving adequate legal grounds, within 48 hours."^^xsd:string .

doc:domestic_proceeding_5_aliens_appeals_board_lift_stay_6_march_2017 a ns1:DomesticProceeding ;
    rdfs:label "On 6 March 2017 the Aliens Appeals Board lifted the stay of execution of the visa refusal decisions."@en ;
    ns1:followsProceeding doc:domestic_proceeding_4_aliens_appeals_board_stay_14_october_2016 ;
    ns1:hasSourceParagraph 16 ;
    ns1:hasSupportingQuote "On 6 March 2017 the Aliens Appeals Board noted that no application had been brought to have the decisions of 13 September 2016 refusing to issue the visas set aside, and decided in consequence to lift the stay of execution of the visa refusal decisions and the interim measures. It further noted that, since the refusal decisions had not been set aside, they were still operative."^^xsd:string .

doc:visa_applications_2016_08_22 a echr:DomesticProceeding ;
    rdfs:label "On 22 August 2016 the applicant couple, accompanied by one of their children, travelled to the Belgian embassy in Beirut to submit visa applications for themselves and their two children"@en ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "9"^^xsd:string ;
    echr:hasSupportingQuote "On 22 August 2016 the applicant couple, accompanied by one of their children, travelled to the Belgian embassy in Beirut to submit visa applications for themselves and their two children"@en .

