@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/863b36902e6d> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:1"^^xsd:string .

doc:chainWelfarePlacementAgreementToRegistrationPermanentSupervision a doc:DomesticProceeding,
        doc:DomesticProceedingChain ;
    rdfs:label "chain from welfare-placement agreement signed on 10 December 2002 to registration for permanent supervision on 14 December 2002"@en ;
    doc:echrHasSupportingQuote "**14.** On 10 December 2002 a welfare-placement agreement was signed between R.P. and the social care home for adults with mental disorders near the village of Pastra in the municipality of Rila (“the Pastra social care home”), an institution under the responsibility of the Ministry of Labour and Social Policy. The applicant was not informed of the agreement."@en ;
    echr:followsProceeding doc:welfare_placement_agreement_10_december_2002 ;
    echr:hasSourceParagraph "14"^^xsd:string ;
    echr:precedesProceeding doc:registration_permanent_supervision_14_december_2002 .

doc:chain_guardian_appointment_2002_to_social_services_welfare_report_23_july_2002 a doc:DomesticProceeding,
        doc:DomesticProceedingChain ;
    rdfs:label "chain from appointment of a guardian on 23 May 2002 to welfare report drawn up on 23 July 2002"@en ;
    doc:echrHasSupportingQuote "**12.** Since the applicant’s family members had refused to take on any guardianship responsibilities, on 23 May 2002 the Municipal Council appointed Ms R.P., a council officer, as the applicant’s guardian until 31 December 2002."@en ;
    echr:followsProceeding doc:guardian_appointment_ruse_municipal_council_23_may_2002 ;
    echr:hasSourceParagraph "12"^^xsd:string ;
    echr:precedesProceeding doc:social_services_welfare_placement_report_23_july_2002 .

doc:chain_judgment_2001_to_guardian_appointment_2002 a doc:DomesticProceeding,
        doc:DomesticProceedingChain ;
    rdfs:label "chain from judgment of 12 April 2001 upheld on appeal to appointment of a guardian on 23 May 2002"@en ;
    doc:echrHasSupportingQuote "**11.** That judgment was upheld in a judgment of 12 April 2001 by the Veliko Tarnovo Court of Appeal ( Апелативен съд ) on an appeal by the applicant, and was subsequently transmitted to the Ruse Municipal Council on 7 June 2001 for the appointment of a guardian."@en ;
    echr:followsProceeding doc:judgment_12_april_2001 ;
    echr:hasSourceParagraph "11"^^xsd:string ;
    echr:precedesProceeding doc:guardian_appointment_ruse_municipal_council_23_may_2002 .

doc:chain_rila_decision_2_february_2005_to_lawyer_request_9_september_2005 a doc:DomesticProceeding,
        doc:DomesticProceedingChain ;
    rdfs:label "chain from decision of the Rila Municipal Council on 2 February 2005 to lawyer request for appointment of a guardian on 9 September 2005"@en ;
    doc:echrHasSupportingQuote "**17.** On 9 September 2005 the applicant’s lawyer requested the Rila Municipal Council to appoint a guardian for her client. In a letter dated 16 September 2005, she was informed that the Municipal Council had decided on 2 February 2005 to appoint the Director of the Pastra social care home as the applicant’s guardian."@en ;
    echr:followsProceeding doc:rila_municipal_council_decision_2_february_2005_guardian_director ;
    echr:hasSourceParagraph "17"^^xsd:string ;
    echr:precedesProceeding doc:lawyer_request_guardian_9_september_2005 .

doc:chain_welfare_report_to_welfare_placement_agreement_10_december_2002 a doc:DomesticProceeding,
        doc:DomesticProceedingChain ;
    rdfs:label "chain from welfare report of 23 July 2002 to welfare-placement agreement signed on 10 December 2002"@en ;
    doc:echrHasSupportingQuote "**13.** On 29 May 2002 R.P. asked the Ruse social services to place the applicant in a social care home for people with mental disorders. She appended to the application form a series of documents including a psychiatric diagnosis. Social services drew up a welfare report on the applicant, noting on 23 July 2002 that he was suffering from schizophrenia, that he lived alone in a small, run-down annexe to his half-sister’s house and that his half-sister and his father’s second wife had stated that they did not wish to act as his guardian. The requirements for placement in a social care home were therefore deemed to be fulfilled."@en ;
    echr:followsProceeding doc:social_services_welfare_placement_report_23_july_2002 ;
    echr:hasSourceParagraph "13"^^xsd:string ;
    echr:precedesProceeding doc:welfare_placement_agreement_10_december_2002 .

doc:domestic_proceeding_5 a doc:DomesticProceeding,
        doc:EchrDomesticProceeding ;
    rdfs:label "29 November 2005"@en ;
    doc:echrFollowsProceeding "cd:domestic_proceeding_4"^^xsd:string ;
    doc:echrHasSourceParagraph 38 ;
    doc:echrHasSupportingQuote "Despite those objections, the regional prosecutor’s refusal was upheld on 11 October 2005 by the appellate prosecutor, and subsequently on 29 November 2005 by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation."^^xsd:string ;
    doc:followsProceeding doc:domestic_proceeding_4 .

doc:domestic_proceeding_9 a doc:DomesticProceeding,
        doc:EchrDomesticProceeding ;
    rdfs:label "10 March 2006"@en ;
    doc:echrFollowsProceeding "cd:domestic_proceeding_8"^^xsd:string ;
    doc:echrHasSourceParagraph 40 ;
    doc:echrHasSupportingQuote "The Dupnitsa District Court gave judgment on 10 March 2006."^^xsd:string ;
    doc:followsProceeding doc:domestic_proceeding_8 .

doc:partial_incapacity_declaration_20_november_2000 a doc:DomesticProceeding ;
    rdfs:label "a judgment of 20 November 2000"@en ;
    doc:echrHasSupportingQuote "In a judgment of 20 November 2000, the court declared the applicant to be partially incapacitated"^^xsd:string ;
    echr:hasSourceParagraph "10"^^xsd:string .

doc:domestic_proceeding_1 a doc:DomesticProceeding,
        doc:EchrDomesticProceeding ;
    rdfs:label "25 November 2004"@en ;
    doc:echrHasSourceParagraph 37 ;
    doc:echrHasSupportingQuote "On 25 November 2004 the applicant, through his lawyer, asked the public prosecutor’s office to apply to the Regional Court to have his legal capacity restored."^^xsd:string .

doc:domestic_proceeding_2 a doc:DomesticProceeding,
        doc:EchrDomesticProceeding ;
    rdfs:label "2 March 2005"@en ;
    doc:echrFollowsProceeding "cd:domestic_proceeding_1"^^xsd:string ;
    doc:echrHasSourceParagraph 37 ;
    doc:echrHasSupportingQuote "On 2 March 2005 the public prosecutor requested the Pastra social care home to send him a doctor’s opinion and other medical certificates concerning the applicant’s disorders in preparation for a possible application to the courts for restoration of his legal capacity."^^xsd:string ;
    doc:followsProceeding doc:domestic_proceeding_1 .

doc:domestic_proceeding_3 a doc:DomesticProceeding,
        doc:EchrDomesticProceeding ;
    rdfs:label "10 August 2005"@en ;
    doc:echrFollowsProceeding "cd:domestic_proceeding_2"^^xsd:string ;
    doc:echrHasSourceParagraph 38 ;
    doc:echrHasSupportingQuote "On 10 August 2005 the regional prosecutor refused to bring an action for restoration of the applicant’s legal capacity on the grounds that, in the opinion of the doctors, the Director of the Pastra social care home and the home’s social worker, the applicant was unable to cope on his own, and that the home, where he could undergo medical treatment, was the most suitable place for him to live."^^xsd:string ;
    doc:followsProceeding doc:domestic_proceeding_2 .

doc:domestic_proceeding_4 a doc:DomesticProceeding,
        doc:EchrDomesticProceeding ;
    rdfs:label "11 October 2005"@en ;
    doc:echrFollowsProceeding "cd:domestic_proceeding_3"^^xsd:string ;
    doc:echrHasSourceParagraph 38 ;
    doc:echrHasSupportingQuote "Despite those objections, the regional prosecutor’s refusal was upheld on 11 October 2005 by the appellate prosecutor, and subsequently on 29 November 2005 by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation."^^xsd:string ;
    doc:followsProceeding doc:domestic_proceeding_3 .

doc:domestic_proceeding_6 a doc:DomesticProceeding,
        doc:EchrDomesticProceeding ;
    rdfs:label "9 September 2005"@en ;
    doc:echrHasSourceParagraph 39 ;
    doc:echrHasSupportingQuote "On 9 September 2005 the applicant, through his lawyer, asked the mayor of Rila to bring a court action for his release from partial guardianship."^^xsd:string .

doc:domestic_proceeding_7 a doc:DomesticProceeding,
        doc:EchrDomesticProceeding ;
    rdfs:label "28 September 2005"@en ;
    doc:echrFollowsProceeding "cd:domestic_proceeding_6"^^xsd:string ;
    doc:echrHasSourceParagraph 39 ;
    doc:echrHasSupportingQuote "On 28 September 2005 the applicant’s lawyer applied to the Dupnitsa District Court for judicial review of the mayor’s decision, under Article 115 of the Family Code (“the FC”) (see paragraph 49 below)."^^xsd:string ;
    doc:followsProceeding doc:domestic_proceeding_6 .

doc:domestic_proceeding_8 a doc:DomesticProceeding,
        doc:EchrDomesticProceeding ;
    rdfs:label "18 January 2006"@en ;
    doc:echrFollowsProceeding "cd:domestic_proceeding_7"^^xsd:string ;
    doc:echrHasSourceParagraph 39 ;
    doc:echrHasSupportingQuote "On 18 January 2006 the court held a hearing at which the representative of the mayor of Rila objected that the form of authority was invalid as it had not been countersigned by the guardian."^^xsd:string ;
    doc:followsProceeding doc:domestic_proceeding_7 .

doc:judgment_12_april_2001 a doc:DomesticProceeding ;
    rdfs:label "a judgment of 12 April 2001 by the Veliko Tarnovo Court of Appeal"@en ;
    doc:echrHasSupportingQuote "**11.** That judgment was upheld in a judgment of 12 April 2001 by the Veliko Tarnovo Court of Appeal ( Апелативен съд ) on an appeal by the applicant, and was subsequently transmitted to the Ruse Municipal Council on 7 June 2001 for the appointment of a guardian."@en ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasSourceParagraph "11"^^xsd:string ;
    echr:isFinalDomesticDecision false .

doc:lawyer_request_guardian_9_september_2005 a doc:DomesticProceeding,
        echr:DomesticAuthority ;
    rdfs:label "request by the applicant’s lawyer for the appointment of a guardian on 9 September 2005"@en ;
    doc:echrHasSupportingQuote "**17.** On 9 September 2005 the applicant’s lawyer requested the Rila Municipal Council to appoint a guardian for her client. In a letter dated 16 September 2005, she was informed that the Municipal Council had decided on 2 February 2005 to appoint the Director of the Pastra social care home as the applicant’s guardian."@en ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeUnknown ;
    echr:hasOutcomeDirection echr:DirectionUnknown ;
    echr:hasProceedingStartDate "2005-09-09"^^xsd:date ;
    echr:hasSourceParagraph "17"^^xsd:string .

doc:registration_permanent_supervision_14_december_2002 a doc:DomesticProceeding,
        echr:DomesticAuthority ;
    rdfs:label "registration as having his home address for permanent supervision on 14 December 2002"@en ;
    doc:echrHasSupportingQuote "**16.** On 14 December 2002, at the request of the Director of the Pastra social care home, the applicant was registered as having his home address in the municipality of Rila. The residence certificate stated that his address had been changed for the purpose of his “permanent supervision”. According to the most recent evidence submitted in February 2011, the applicant was still living in the home at that time."@en ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasDecisionDate "2002-12-14"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSourceParagraph "16"^^xsd:string .

