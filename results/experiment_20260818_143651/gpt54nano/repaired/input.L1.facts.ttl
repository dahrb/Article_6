        echr:DomesticAuthority ;
    rdfs:label "decision of the Rila Municipal Council on 2 February 2005 to appoint the Director of the Pastra social care home as guardian"@en ;
    doc:echrHasSupportingQuote "**17.** On 9 September 2005 the applicant’s lawyer requested the Rila Municipal Council to appoint a guardian for her client. In a letter dated 16 September 2005, she was informed that the Municipal Council had decided on 2 February 2005 to appoint the Director of the Pastra social care home as the applicant’s guardian."@en ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasDecisionDate "2005-02-02"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionUnknown ;
    echr:hasSourceParagraph "17"^^xsd:string .

