<http://example.org/base/cd,hqdc_draft_decision_vote_2016_1> a doc:DomesticProceeding ;
    rdfs:label "On 22 July 2016 the draft decision was put to vote at a HQDCB meeting, the draft decision was rejected"@en ;
    doc:followsProceeding <http://example.org/base/cd,hqdc_no_decision_2013_1> ;
    doc:hasSourceParagraph "20"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 22 July 2016 the draft decision was put to vote at a HQDCB meeting where 19 out of 30 HQDCB members were present. Out of 19 members, 11 voted in favour of the decision, 6 voted against it, and 2 abstained. In view of the changes to the Rules of Procedure adopted in 2014 (see paragraph 16 above), the draft decision was rejected and the decisions suspending the applicant’s licence remained valid."^^xsd:string .

<http://example.org/base/cd,hqdc_no_decision_2013_1> a doc:DomesticProceeding ;
    rdfs:label "In 2013 the HQDCB held two hearings in the applicant’s case, but failed to reach a decision"@en ;
    doc:hasSourceParagraph "15"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeUnknown ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "In 2013 the HQDCB held two hearings in the applicant’s case, but failed to reach a decision"^^xsd:string .

