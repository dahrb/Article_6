@prefix eCHR: <https://example.org/echr/> .
@prefix echr: <https://growgraph.dev/echr/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <https://growgraph.dev/echr#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/e41947e3377d> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:7"^^xsd:string .

doc:defence_representations_about_prison_arrangements_1 a eCHR:DomesticProceeding ;
    rdfs:label "29 March 1999 defence counsel representations that prison arrangements did not reflect those referred to by the trial judge"@en ;
    eCHR:followsProceeding doc:high_court_refused_bail_review_1 ;
    eCHR:hasSourceParagraph 10 ;
    eCHR:hasSupportingQuote "On 29 March 1999, defence counsel made representations, inter alia , that the arrangements made for the applicant in prison had not reflected those referred to by the trial judge."@en .

doc:domesticTrialJudgeRefusalApplicationToStayAbuse a echr:DomesticProceeding ;
    rdfs:label "the application was refused by the trial judge"@en ;
    echr:followsProceeding doc:domesticDefenceApplicationToStayAbuseLapseOfTime ;
    echr:hasSourceParagraph 1 ;
    echr:hasSupportingQuote "The application was refused by the trial judge who considered that it was entirely speculative as to whether the unavailability of witnesses was a detriment or a bonus, that the evidence of the eye-witnesses called by the prosecution could be properly and rigorously tested within the confines of the trial process, and that any points which the defence might have about the reliability of the evidence could be fairly accommodated within the trial process."@en .

doc:house_of_lords_leave_refused_15_june_2000 a ns1:DomesticProceeding ;
    rdfs:label "On 15 June 2000, the House of Lords refused the petition for leave to appeal."@en ;
    ns1:followsProceeding doc:court_of_appeal_judgment_10_february_2000 ;
    ns1:hasSourceParagraph "unknown"@en ;
    ns1:hasSupportingQuote "On 15 June 2000, the House of Lords refused the petition for leave to appeal."@en .

doc:trialReinstatedBail a ns1:DomesticProceeding ;
    rdfs:label "On hearing re-assurances from defence counsel that arrangements would be made for transporting the applicant to and from the court room and for ensuring his welfare in his own home, and having regard to the shortness of the overnight adjournment of the trial, the trial judge reinstated bail."@en ;
    ns1:hasSourceParagraph "unknown"@en ;
    ns1:hasSupportingQuote "On hearing re-assurances from defence counsel that arrangements would be made for transporting the applicant to and from the court room and for ensuring his welfare in his own home, and having regard to the shortness of the overnight adjournment of the trial, the trial judge reinstated bail."@en .

doc:bail_review_application_high_court_1 a eCHR:DomesticProceeding ;
    rdfs:label "application to the High Court to review bail"@en ;
    eCHR:followsProceeding doc:withdrawal_of_bail_1 ;
    eCHR:hasSourceParagraph 9 ;
    eCHR:hasSupportingQuote "An application was made to the High Court to review bail on 26 March 1999."@en .

doc:close_of_prosecution_case_acquittal_ruling_1 a eCHR:DomesticProceeding ;
    rdfs:label "ruling at the close of the prosecution case that there was insufficient evidence to support a conviction on counts 2 and 4 and that the applicant should be acquitted"@en ;
    eCHR:followsProceeding doc:evidence_admissibility_ruling_2 ;
    eCHR:hasSourceParagraph 2 ;
    eCHR:hasSupportingQuote "At the close of the prosecution case, the judge ruled that there was insufficient evidence as a matter of law to support a conviction on counts 2 and 4 and that the applicant should be acquitted."@en .

doc:conviction_1_and_3_1_april_1999 a ns1:DomesticProceeding ;
    rdfs:label "On 1 April 1999, the jury convicted the applicant of counts 1 and 3."@en ;
    ns1:hasSourceParagraph "unknown"@en ;
    ns1:hasSupportingQuote "On 1 April 1999, the jury convicted the applicant of counts 1 and 3."@en .

doc:court_of_appeal_judgment_10_february_2000 a ns1:DomesticProceeding ;
    rdfs:label "In its judgment of 10 February 2000, the Court of Appeal rejected the applicant’s appeal."@en ;
    ns1:followsProceeding doc:conviction_1_and_3_1_april_1999 ;
    ns1:hasSourceParagraph "unknown"@en ;
    ns1:hasSupportingQuote "In its judgment of 10 February 2000, the Court of Appeal rejected the applicant’s appeal."@en .

doc:domesticCriminalIndictmentFourCountsMurder a echr:DomesticProceeding ;
    rdfs:label "The applicant was charged on an indictment with four counts of murder"@en ;
    echr:followsProceeding doc:domestic_investigation_interview_1996_04_01 ;
    echr:hasSourceParagraph 1 ;
    echr:hasSupportingQuote "The applicant was charged on an indictment with four counts of murder:"@en .

doc:domesticDefenceApplicationToStayAbuseLapseOfTime a echr:DomesticProceeding ;
    rdfs:label "the defence made an application that the trial should be stayed as an abuse on the basis of the lapse of time since events"@en ;
    echr:followsProceeding doc:domestic_trial_1999_02_08_to_1999_04_01 ;
    echr:hasSourceParagraph 1 ;
    echr:hasSupportingQuote "Before the commencement of the proceedings, the defence made a number of applications: that the trial should be stayed as an abuse on the basis that due inter alia to the lapse of time since events the applicant could not obtain a fair trial."@en .

doc:domestic_investigation_interview_1996_04_01 a echr:DomesticProceeding ;
    rdfs:label "On 1 and 3 April 1996, the applicant was interviewed by the British police concerning his activities in Domachevo during the German occupation."@en ;
    echr:hasSourceParagraph 1 ;
    echr:hasSupportingQuote "On 1 and 3 April 1996, the applicant was interviewed by the British police concerning his activities in Domachevo during the German occupation."@en .

doc:domestic_trial_1999_02_08_to_1999_04_01 a echr:DomesticProceeding ;
    rdfs:label "the trial which took place between 8 February and 1 April 1999"@en ;
    echr:followsProceeding doc:domesticCriminalIndictmentFourCountsMurder ;
    echr:hasSourceParagraph 1 ;
    echr:hasSupportingQuote "In the trial which took place between 8 February and 1 April 1999, before Mr Justice Potts and a jury, the applicant was represented by senior and junior counsel and solicitors."@en .

doc:evidence_admissibility_ruling_1 a eCHR:DomesticProceeding ;
    rdfs:label "8 February 1999 ruling that the evidence of Ivan Baglay and Evgeny Melianuk was relevant and admissible"@en ;
    eCHR:followsProceeding doc:evidence_exclusion_application_1 ;
    eCHR:hasSourceParagraph 1 ;
    eCHR:hasSupportingQuote "On 8 February 1999, the judge ruled that the evidence of both witnesses was relevant and admissible"@en .

doc:evidence_admissibility_ruling_2 a eCHR:DomesticProceeding ;
    rdfs:label "26 February 1999 ruling that the evidence of Ivan Baglay and Evgeny Melianuk should go before the jury"@en ;
    eCHR:followsProceeding doc:evidence_admissibility_ruling_1 ;
    eCHR:hasSourceParagraph 1 ;
    eCHR:hasSupportingQuote "and, on 26 February 1999, that it should go before the jury."@en .

doc:evidence_exclusion_application_1 a eCHR:DomesticProceeding ;
    rdfs:label "application that the evidence of two witnesses, Ivan Baglay and Evgeny Melianuk, be excluded as inadmissible"@en ;
    eCHR:hasSourceParagraph 1 ;
    eCHR:hasSupportingQuote "The defence also made an application that the evidence of two witnesses, Ivan Baglay and Evgeny Melianuk, be excluded as inadmissible."@en .

doc:hearsay_missing_persons_document_ruling_1 a eCHR:DomesticProceeding ;
    rdfs:label "judge directed jury that hearsay was not evidence and that the missing persons document was not evidence"@en ;
    eCHR:followsProceeding doc:retain_other_evidence_with_jury_ruling_1 ;
    eCHR:hasSourceParagraph 4 ;
    eCHR:hasSupportingQuote "The judge directed the jury that hearsay was not evidence, that the document to which the officer had referred had not been prepared by him and that, accordingly, the document was not evidence."@en .

doc:high_court_refused_bail_review_1 a eCHR:DomesticProceeding ;
    rdfs:label "High Court refused the application to review bail on 26 March 1999"@en ;
    eCHR:followsProceeding doc:bail_review_application_high_court_1 ;
    eCHR:hasSourceParagraph 9 ;
    eCHR:hasSupportingQuote "It was refused."@en .

doc:judge_refused_provenance_application_1 a eCHR:DomesticProceeding ;
    rdfs:label "24 March 1999 refusal by the judge of the prosecution application to call provenance evidence for the missing persons document"@en ;
    eCHR:followsProceeding doc:prosecution_application_to_call_provenance_evidence_1 ;
    eCHR:hasSourceParagraph 6 ;
    eCHR:hasSupportingQuote "On 24 March 1999, the judge refused the application."@en .

doc:prosecution_application_to_call_provenance_evidence_1 a eCHR:DomesticProceeding ;
    rdfs:label "prosecution application to call evidence to prove the provenance of the missing persons document"@en ;
    eCHR:followsProceeding doc:hearsay_missing_persons_document_ruling_1 ;
    eCHR:hasSourceParagraph 5 ;
    eCHR:hasSupportingQuote "The prosecution made an application to the judge to call evidence to prove the provenance of the missing persons document in order to rebut the allegation of fabrication."@en .

doc:retain_other_evidence_with_jury_ruling_1 a eCHR:DomesticProceeding ;
    rdfs:label "ruling that evidence concerning other matters given by Ben Zion Blustein and Ivan Stepaniuk should remain with the jury"@en ;
    eCHR:followsProceeding doc:withdraw_evidence_counts_2_and_4_ruling_1 ;
    eCHR:hasSourceParagraph 2 ;
    eCHR:hasSupportingQuote "but that evidence concerning other matters given by two witnesses (Ben Zion Blustein and Ivan Stepaniuk) who had testified on those counts should remain with the jury."@en .

doc:withdraw_evidence_counts_2_and_4_ruling_1 a eCHR:DomesticProceeding ;
    rdfs:label "ruling that evidence concerning counts 2 and 4 should be withdrawn from the jury"@en ;
    eCHR:followsProceeding doc:close_of_prosecution_case_acquittal_ruling_1 ;
    eCHR:hasSourceParagraph 2 ;
    eCHR:hasSupportingQuote "He ruled that the evidence going to those two counts should be withdrawn from the jury"@en .

doc:withdrawal_of_bail_1 a eCHR:DomesticProceeding ;
    rdfs:label "25 March 1999 judge withdrew the applicant’s bail after consulting counsel"@en ;
    eCHR:followsProceeding doc:judge_refused_provenance_application_1 ;
    eCHR:hasSourceParagraph 8 ;
    eCHR:hasSupportingQuote "On 25 March 1999, before the closing speeches were due to begin and a long adjournment over a weekend, the judge after consulting counsel decided to withdraw the applicant’s bail."@en .

