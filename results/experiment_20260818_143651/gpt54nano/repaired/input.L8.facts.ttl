@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/d09e06dd9fe1/> .
@prefix eCHR: <https://growgraph.dev/echr/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/d09e06dd9fe1> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:8"^^xsd:string .

doc:nizhniy_novgorod_regional_court a echr:DomesticAuthority ;
    rdfs:label "Nizhniy Novgorod Regional Court"@en .

doc:regional_court_bias_motion_1 a echr:DomesticProceeding ;
    rdfs:label "Regional Court requests for dismissal of the judge and admission of lawyer (rejected)"@en ;
    echr:followsProceeding doc:regional_court_new_trial_1 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "On 19 May the applicant’s “civil defender” requested the Regional Court to dismiss the judge presiding in the case for bias. ... Both requests were rejected by the Regional Court."^^xsd:string .

doc:regional_court_further_orders_domestic_proceeding_1998_05_27 a eCHR:DomesticProceeding ;
    rdfs:label "Regional Court further orders (private determinations) domestic proceeding on 27 May 1998"^^xsd:string ;
    eCHR:followsProceeding doc:nizhniy_novgorod_regional_court_domestic_proceeding_1998_05_27 ;
    eCHR:hasSourceParagraph 2 ;
    eCHR:hasSupportingQuote "On 27 May 1998 the Regional Court made a number of further orders ( частные определения ) in the case."^^xsd:string .

doc:supreme_court_appeal_against_detention_order_2 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court reply (request not allowed separately)"@en ;
    echr:followsProceeding doc:regional_court_new_trial_1 ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "The reply from the Supreme Court, dated 19 May 1998, stated that the national law did not allow appeals against that type of trial court orders separately from appeals against judgments."^^xsd:string .

doc:supreme_court_authority a echr:DomesticAuthority ;
    rdfs:label "Supreme Court"@en .

doc:supreme_court_cassation_1998 a echr:DomesticProceeding ;
    rdfs:label "cassation (Supreme Court, confirmed on 10 August 1998)"@en ;
    echr:followsProceeding doc:trial_1998 ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasDecisionDate "1998-08-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasProceedingStartDate "1998-07-08"^^xsd:string ;
    echr:hasSourceParagraph "3"^^xsd:string ;
    echr:hasSupportingQuote "On 10 August 1998 the Supreme Court confirmed the judgment of the Nizhniy Novgorod Regional Court, with some alterations."^^xsd:string .

doc:supreme_court_property_processing_1998 a echr:DomesticProceeding ;
    rdfs:label "cassation (Supreme Court did not address the property-dispute complaint)"@en ;
    echr:followsProceeding doc:trial_1998 ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasDecisionDate "1998-08-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasSourceParagraph "6"^^xsd:string ;
    echr:hasSupportingQuote "In their cassation appeal to the Supreme Court the applicant’s lawyer argued that the Regional Court had failed to react properly to the mishandling of the applicant’s property by the prosecutor’s office. In its decision, the Supreme Court did not refer to the complaint referring to the property dispute."^^xsd:string .

doc:nizhniy_novgorod_regional_court_domestic_proceeding_1998_05_27 a eCHR:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court domestic proceeding on 27 May 1998"^^xsd:string ;
    eCHR:hasSourceParagraph 1 ;
    eCHR:hasSupportingQuote "On 27 May 1998 the Nizhniy Novgorod Regional Court found the applicant guilty on charges of misappropriation and embezzlement, larceny, bribery and attempt not to return money from abroad."^^xsd:string .

doc:regional_court_first_instance_trial_1 a echr:DomesticProceeding ;
    rdfs:label "Arrest and trial"@en ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "On 21 April 1997 the Nizhniy Novgorod Regional Court found the applicant guilty on some of the charges, and not guilty on most. He was sentenced to one and a half years in prison (the time he had already spent in pre-trial detention) and some of his property was confiscated."^^xsd:string .

doc:supreme_court_appeal_review_1 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court quashed the conviction on the applicant’s appeal and remitted the case"@en ;
    echr:followsProceeding doc:regional_court_first_instance_trial_1 ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "In July 1997 the Supreme Court quashed the conviction on the applicant’s appeal and remitted the case to the Nizhniy Novgorod Regional Court."^^xsd:string .

doc:regional_court_new_trial_1 a echr:DomesticProceeding ;
    rdfs:label "New trial"@en ;
    echr:followsProceeding doc:supreme_court_appeal_review_1 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "On 30 March 1998, during the new trial, the prosecutor applied to the court to detain the applicant for violations of the undertaking not to leave the city during the trial and obstruction of justice. The Regional Court rejected the motion as unsubstantiated."^^xsd:string .

doc:trial_1998 a echr:DomesticProceeding ;
    rdfs:label "trial (Nizhniy Novgorod Regional Court)"@en ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasDecisionDate "1998-05-27"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasProceedingStartDate "1998-06-03"^^xsd:date ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "The applicant received a copy of the trial court judgment on 3 June 1998."^^xsd:string .

