doc:placement_agreement_2002 a echr:DomesticProceeding ;
    rdfs:label "welfare-placement agreement between R.P. and the Pastra social care home (10 December 2002)"@en ;
    echr:followsProceeding doc:welfare_report_23_july_2002 ;
    echr:hasCourt doc:pastraSocialCareHome ;
    echr:hasDecisionDate "2002-12-10"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "14"^^xsd:string ;
    echr:hasSupportingQuote "On 10 December 2002 a welfare-placement agreement was signed between R.P. and the social care home for adults with mental disorders near the village of Pastra in the municipality of Rila (“the Pastra social care home”), an institution under the responsibility of the Ministry of Labour and Social Policy. The applicant was not informed of the agreement."@en .

doc:placement_request_2002 a echr:DomesticProceeding ;
    rdfs:label "R.P. request to Ruse social services for placement in a social care home (29 May 2002)"@en ;
    echr:followsProceeding doc:municipal_council_appointment_2002 ;
    echr:hasCourt doc:ruseSocialServices ;
    echr:hasProceedingStartDate "2002-05-29"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "13"^^xsd:string ;
    echr:hasSupportingQuote "On 29 May 2002 R.P. asked the Ruse social services to place the applicant in a social care home for people with mental disorders."@en .

