doc:mayor_refusal_2005_09_16 a echr:DomesticProceeding ;
    rdfs:label "mayor of Rila refused request to bring a court action (16 September 2005)"@en ;
    echr:hasCourt doc:authorityMayorOfRila ;
    echr:hasDecisionDate "2005-09-16"^^xsd:date ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasSourceParagraph "39"^^xsd:string ;
    echr:hasSupportingQuote "In a letter of 16 September 2005, the mayor of Rila refused his request"@en .

doc:municipal_council_appointment_2002 a echr:DomesticProceeding ;
    rdfs:label "Ruse Municipal Council appointment of Ms R.P. as guardian (23 May 2002)"@en ;
    echr:followsProceeding doc:first_instance_judgment_1 ;
    echr:hasCourt doc:municipalCouncil ;
    echr:hasDecisionDate "2002-05-23"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasSourceParagraph "12"^^xsd:string ;
    echr:hasSupportingQuote "Since the applicant’s family members had refused to take on any guardianship responsibilities, on 23 May 2002 the Municipal Council appointed Ms R.P., a council officer, as the applicant’s guardian until 31 December 2002."@en .

