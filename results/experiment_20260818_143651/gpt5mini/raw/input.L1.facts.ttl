doc:social_assessment_2005_12_30 a echr:DomesticProceeding ;
    rdfs:label "social assessment ( социална оценка ) of the applicant"@en ;
    echr:followsProceeding doc:request_to_municipal_council_social_allowance_2005 ;
    echr:hasCourt doc:municipalSocialAssistanceDepartment ;
    echr:hasProceedingStartDate "2005-12-30"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "34"^^xsd:string ;
    echr:hasSupportingQuote "on 30 December 2005 the municipal social assistance department carried out a “social assessment” ( социална оценка ) of the applicant, which concluded that he was incapable of working, even in a sheltered environment, and had no need for training or retraining, and that in those circumstances he was entitled to a social allowance to cover the costs of his transport, subsistence and medication."@en .

doc:velikoTarnovoCourtOfAppeal a echr:DomesticAuthority ;
    rdfs:label "Veliko Tarnovo Court of Appeal ( Апелативен съд )"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
