doc:request_to_municipal_council_social_allowance_2005 a echr:DomesticProceeding ;
    rdfs:label "the applicant’s guardian asked the Municipal Council to grant a social allowance"@en ;
    echr:hasCourt doc:municipalCouncil ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "34"^^xsd:string ;
    echr:hasSupportingQuote "the applicant’s guardian asked the Municipal Council to grant a social allowance to facilitate his reintegration into the community."@en .

