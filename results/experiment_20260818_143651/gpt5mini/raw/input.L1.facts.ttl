doc:declaration_of_legal_incapacity_ruse_2000 a echr:DomesticProceeding ;
    rdfs:label "Declaration of legal incapacity before the Ruse Regional Court (Окръжен съд)"@en ;
    echr:hasCourt doc:ruseRegionalCourt ;
    echr:hasDecisionDate "2000-11-20"^^xsd:date ;
    echr:hasProceedingStartDate "2000"^^xsd:gYear ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "10"^^xsd:string ;
    echr:hasSupportingQuote "In a judgment of 20 November 2000, the court declared the applicant to be partially incapacitated on the grounds that he had been suffering from simple schizophrenia since 1975, and that his ability to manage his own affairs and interests and to realise the consequences of his own acts had been impaired."@en,
        "On an unspecified date in 2000, at the request of the applicant’s two relatives, the Ruse regional prosecutor applied to the Ruse Regional Court ( Окръжен съд ) for a declaration of total legal incapacity in respect of the applicant."@en .

doc:dupnitsa_district_court_2005_09_28 a echr:DomesticProceeding ;
    rdfs:label "Dupnitsa District Court judicial review of the mayor’s decision (application 28 September 2005; judgment 10 March 2006)"@en ;
    echr:followsProceeding doc:mayor_refusal_2005_09_16 ;
    echr:hasCourt doc:authorityDupnitsaDistrictCourt ;
    echr:hasDecisionDate "2006-03-10"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasProceedingStartDate "2005-09-28"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "39"^^xsd:string,
        "40"^^xsd:string ;
    echr:hasSupportingQuote "As to the merits, the court dismissed the application"@en,
        "On 28 September 2005 the applicant’s lawyer applied to the Dupnitsa District Court for judicial review of the mayor’s decision, under Article 115 of the Family Code"@en,
        "Since the judgment was not subject to appeal, it became final."@en,
        "The Dupnitsa District Court gave judgment on 10 March 2006."@en .

doc:municipal_assistance_grant_2007_02_07 a echr:DomesticProceeding ;
    rdfs:label "grant of monthly allowance by the municipal social assistance department"@en ;
    echr:followsProceeding doc:social_assessment_2005_12_30 ;
    echr:hasCourt doc:municipalSocialAssistanceDepartment ;
    echr:hasDecisionDate "2007-02-07"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "34"^^xsd:string ;
    echr:hasSupportingQuote "On 7 February 2007 the municipal social assistance department granted the applicant a monthly allowance of BGN 16.50 (approximately EUR 8)."@en .

doc:municipal_council_decision_2005 a echr:DomesticProceeding ;
    rdfs:label "Rila Municipal Council decision to appoint the Director of the Pastra social care home as guardian (2 February 2005)"@en ;
    echr:hasCourt doc:municipalCouncil ;
    echr:hasDecisionDate "2005-02-02"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasSourceParagraph "17"^^xsd:string ;
    echr:hasSupportingQuote "In a letter dated 16 September 2005, she was informed that the Municipal Council had decided on 2 February 2005 to appoint the Director of the Pastra social care home as the applicant’s guardian."@en .

doc:proc_upheld_chief_2005_11_29 a echr:DomesticProceeding ;
    rdfs:label "refusal upheld by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation (29 November 2005)"@en ;
    echr:followsProceeding doc:proc_upheld_appellate_2005_10_11 ;
    echr:hasCourt doc:publicProsecutorOffice ;
    echr:hasDecisionDate "2005-11-29"^^xsd:date ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasSourceParagraph "38"^^xsd:string ;
    echr:hasSupportingQuote "and subsequently on 29 November 2005 by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation"@en .

doc:registration_rila_2002 a echr:DomesticProceeding ;
    rdfs:label "registration as resident in the municipality of Rila for \"permanent supervision\" (14 December 2002)"@en ;
    echr:followsProceeding doc:placement_agreement_2002 ;
    echr:hasCourt doc:municipalityOfRila ;
    echr:hasDecisionDate "2002-12-14"^^xsd:date ;
    echr:hasSourceParagraph "16"^^xsd:string ;
    echr:hasSupportingQuote "On 14 December 2002, at the request of the Director of the Pastra social care home, the applicant was registered as having his home address in the municipality of Rila. The residence certificate stated that his address had been changed for the purpose of his “permanent supervision”."@en .

doc:request_rila_2005 a echr:DomesticProceeding ;
    rdfs:label "applicant's lawyer request to Rila Municipal Council to appoint a guardian (9 September 2005)"@en ;
    echr:hasCourt doc:municipalCouncil ;
    echr:hasProceedingStartDate "2005-09-09"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "17"^^xsd:string ;
    echr:hasSupportingQuote "On 9 September 2005 the applicant’s lawyer requested the Rila Municipal Council to appoint a guardian for her client."@en .

doc:ruse_police_search_and_notification_oct_2006 a echr:DomesticProceeding ;
    rdfs:label "request to Ruse municipal police to search for the applicant and subsequent police notification"@en ;
    echr:hasCourt doc:ruseMunicipalPolice ;
    echr:hasDecisionDate "2006-10-19"^^xsd:date ;
    echr:hasProceedingStartDate "2006-10-13"^^xsd:date ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "28"^^xsd:string ;
    echr:hasSupportingQuote "On 19 October 2006 the Ruse police informed the Director that the applicant’s whereabouts had been discovered but that the police could not transfer him because he was not the subject of a wanted notice."@en,
        "the Director of the home wrote to the Ruse municipal police on 13 October 2006, asking them to search for the applicant and transfer him to Sofia, where employees of the home would be able to collect him and take him back to Pastra."@en .

doc:statementToPublicProsecutorOfficeUnspecifiedDate a echr:DomesticProceeding ;
    rdfs:label "statement made by the Director of the home to the public prosecutor’s office"@en ;
    echr:hasCourt doc:publicProsecutorOffice ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "27"^^xsd:string ;
    echr:hasSupportingQuote "According to a statement made by the Director of the home to the public prosecutor’s office on an unspecified date, the applicant came back early because he was unable to manage his finances and had no accommodation."@en .

doc:appeal_veliko_tarnovo_2001 a echr:DomesticProceeding ;
    rdfs:label "judgment of 12 April 2001 by the Veliko Tarnovo Court of Appeal"@en ;
    echr:followsProceeding doc:first_instance_judgment_1 ;
    echr:hasCourt doc:velikoTarnovoCourtOfAppeal ;
    echr:hasDecisionDate "2001-04-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasSourceParagraph "11"^^xsd:string ;
    echr:hasSupportingQuote "That judgment was upheld in a judgment of 12 April 2001 by the Veliko Tarnovo Court of Appeal ( Апелативен съд ) on an appeal by the applicant, and was subsequently transmitted to the Ruse Municipal Council on 7 June 2001 for the appointment of a guardian."@en .

