doc:public_prosecutor_filed_indictment_28_dec_1998 a echr:DomesticProceeding ;
    rdfs:label "On 28 December 1998 the Public Prosecutor filed an indictment against the applicant for “attempting to obstruct an official in the course of his duties” ( poskus kaznivega dejanja preprečitve uradnega dejanja uradni osebi )."@en ;
    echr:followsProceeding doc:investigation_concluded_17_mar_1998 ;
    echr:hasProceedingStartDate "1998-12-28"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "44"^^xsd:string ;
    echr:hasSupportingQuote "On 28 December 1998 the Public Prosecutor filed an indictment against the applicant for “attempting to obstruct an official in the course of his duties” ( poskus kaznivega dejanja preprečitve uradnega dejanja uradni osebi )."@en .

doc:public_prosecutor_request_open_investigation_17_jan_1997 a echr:DomesticProceeding ;
    rdfs:label "On 17 January 1997 the Public Prosecutor requested the Slovenj Gradec District Court to open a criminal investigation against the applicant."@en ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
