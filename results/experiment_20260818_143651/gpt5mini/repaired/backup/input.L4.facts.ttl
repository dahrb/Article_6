doc:criminal_proceedings_1 a echr:DomesticProceeding ;
    rdfs:label "the criminal proceedings"@en ;
    echr:followsProceeding doc:investigation_into_his_allegations_1 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "14"^^xsd:string,
        "3"^^xsd:string ;
    echr:hasSupportingQuote "the criminal proceedings had been unfair and excessively long (Article 6 of the Convention)."@en,
        "the statements he gave in the relevant domestic proceedings"@en .

doc:district_court_final_costs_order_11_oct_2001 a echr:DomesticProceeding ;
    rdfs:label "On 11 October 2001 the Slovenj Gradec District Court ordered the applicant to pay an additional sum to cover the costs of one of the witnesses heard during the proceedings. On that day, the proceedings were “finally concluded” ( pravnomočno končan postopek )."@en ;
    echr:followsProceeding doc:maribor_higher_court_upheld_conviction_9_may_2001 ;
    echr:hasDecisionDate "2001-10-11"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelEnforcement ;
    echr:hasSourceParagraph "50"^^xsd:string ;
    echr:hasSupportingQuote "On 11 October 2001 the Slovenj Gradec District Court ordered the applicant to pay an additional sum to cover the costs of one of the witnesses heard during the proceedings. On that day, the proceedings were “finally concluded” ( pravnomočno končan postopek )."@en ;
    echr:isFinalDomesticDecision true .

doc:domestic_proceeding_public_prosecutor_dismissal_1997 a echr:DomesticProceeding ;
    rdfs:label "Decision of the Public Prosecutor dismissing the applicant's criminal complaint"@en ;
    echr:followsProceeding doc:domestic_proceeding_police_investigation_1995 ;
    echr:hasCourt doc:slovenjGradecDistrictPublicProsecutorOffice ;
    echr:hasDecisionDate "1997-01-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingStartDate "1995-06-15"^^xsd:date ;
    echr:hasSourceParagraph "30"^^xsd:string,
        "31"^^xsd:string,
        "34"^^xsd:string,
        "35"^^xsd:string ;
    echr:hasSupportingQuote "In the decision the Public Prosecutor identified D.P., J.K. and M. J. as the officers accused in the applicant’s complaint."@en,
        "In the meantime, on 14 July 1995, the Slovenj Gradec District Public Prosecutor (the “Public Prosecutor”) requested the Slovenj Gradec Police to identify the officers who had participated in the procedure against the applicant and to conduct an interview with them."@en,
        "On 15 June 1995 the Slovenj Gradec District Public Prosecutor’s Office ( Okrožno državno tožilstvo ) asked the applicant’s lawyer to add his client’s deposition to the file, which he did on 20 June 1995."@en,
        "On 17 January 1997 the Public Prosecutor issued a decision dismissing the applicant’s criminal complaint. It was served on the applicant’s lawyer on 22 January 1997."@en ;
    echr:isFinalDomesticDecision true ;
    echr:isPending false .

doc:judgment_of_12_february_2001_issued_in_the_proceedings_instituted_against_the_applicant_para_21 a echr:DomesticProceeding ;
    rdfs:label "The judgment of 12 February 2001 issued in the proceedings instituted against the applicant"@en ;
    echr:followsProceeding doc:criminal_investigation_instituted_against_the_applicant_para_22 ;
    echr:hasDecisionDate "2001-02-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "21"^^xsd:string ;
    echr:hasSupportingQuote "The judgment of 12 February 2001 issued in the proceedings instituted against the applicant (see paragraph 48), established that three officers of the Slovenj Gradec Police, D.P., J.K. and M.F., who were in the car which stopped the applicant, received information about the location of a “white Golf”, believed to be being driven by the applicant, and an order to stop it."@en .

doc:police_complaint_12_apr_1995 a echr:DomesticProceeding ;
    rdfs:label "On 12 April 1995 the Slovenj Gradec Police lodged a criminal complaint against the applicant for the criminal offence of “obstructing an official in the course of his duties” under section 302, paragraph 4-1 of the Slovenian Criminal Code, which referred to the same incident as the applicant’s criminal complaint."@en ;
    echr:hasProceedingStartDate "1995-04-12"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "37"^^xsd:string ;
    echr:hasSupportingQuote "On 12 April 1995 the Slovenj Gradec Police lodged a criminal complaint against the applicant for the criminal offence of “obstructing an official in the course of his duties” under section 302, paragraph 4-1 of the Slovenian Criminal Code, which referred to the same incident as the applicant’s criminal complaint."@en .

doc:criminal_investigation_instituted_against_the_applicant_para_22 a echr:DomesticProceeding ;
    rdfs:label "the criminal investigation instituted against the applicant"@en ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "22"^^xsd:string ;
    echr:hasSupportingQuote "Officer J.K. testified in the criminal investigation instituted against the applicant, that they had received information that the “white Golf” had left “the place”, which meant that it had left Pik Bar . He was not able to comment on the speed of the applicant’s car. In addition, he stated that by the time a minute had gone by after the applicant was stopped, there were already four or five vehicles of the Slovenj Gradec Police and the Special Unit at the scene and that three or four officers arrived in each vehicle."@en .

doc:district_court_acquittal_22_nov_1999 a echr:DomesticProceeding ;
    rdfs:label "By a judgment of 22 November 1999 the court acquitted the applicant."@en ;
    echr:followsProceeding doc:district_court_rejected_objection_16_feb_1999 ;
    echr:hasDecisionDate "1999-11-22"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeAcquittal ;
    echr:hasSourceParagraph "46"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of 22 November 1999 the court acquitted the applicant."@en .

doc:district_court_rejected_objection_16_feb_1999 a echr:DomesticProceeding ;
    rdfs:label "On 27 January 1999 the applicant filed an objection to the indictment. ... His objection was rejected by the Slovenj Gradec District Court on 16 February 1999."@en ;
    echr:followsProceeding doc:public_prosecutor_filed_indictment_28_dec_1998 ;
    echr:hasDecisionDate "1999-02-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasSourceParagraph "45"^^xsd:string ;
    echr:hasSupportingQuote "His objection was rejected by the Slovenj Gradec District Court on 16 February 1999."@en .

doc:district_court_retrial_conviction_12_feb_2001 a echr:DomesticProceeding ;
    rdfs:label "By a judgment of 12 February 2001, the Slovenj Gradec District Court convicted the applicant as charged and sentenced him to 3 months’ imprisonment, suspended for 3 years."@en ;
    echr:followsProceeding doc:maribor_higher_court_quashed_remitted_27_sep_2000 ;
    echr:hasDecisionDate "2001-02-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelReopening ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasSourceParagraph "48"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of 12 February 2001, the Slovenj Gradec District Court convicted the applicant as charged and sentenced him to 3 months’ imprisonment, suspended for 3 years."@en .

doc:domestic_proceeding_police_investigation_1995 a echr:DomesticProceeding ;
    rdfs:label "The applicant’s criminal complaint and the subsequent investigation"@en ;
    echr:hasCourt doc:slovenjGradecPolice ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingStartDate "1995-04-07"^^xsd:date ;
    echr:hasSourceParagraph "28"^^xsd:string,
        "29"^^xsd:string,
        "32"^^xsd:string ;
    echr:hasSupportingQuote "On 15 May 1995 the applicant lodged, through his lawyer, a written criminal complaint ( kazenska ovadba ) with the Slovenj Gradec Police against unidentified police officers for causing minor bodily harm ( lahka telesna poškodba ) and an unlawful deprivation of liberty ( protipraven odvzem prostosti )."@en,
        "On 20 April 1995, the MIA had appointed a “working group” ( delovna skupina ) consisting of officers from the Slovenj Gradec Police and the MIA to assess the lawfulness of the procedures carried out by the Special Unit and the Slovenj Gradec Police."@en,
        "On 7 April 1995 the applicant went to the Slovenj Gradec Police and made an oral complaint against the officers of the Special Unit concerning the events of 5 April 1995."@en ;
    echr:isPending false .

doc:investigation_concluded_17_mar_1998 a echr:DomesticProceeding ;
    rdfs:label "On 17 March 1998 the criminal investigation was concluded with the investigating judge’s decision ordering the exclusion of certain documents from the case-file in accordance with section 83, paragraph 3, of the Criminal Procedure Act."@en ;
    echr:followsProceeding doc:maribor_higher_court_decision_4_dec_1997 ;
    echr:hasDecisionDate "1998-03-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasSourceParagraph "43"^^xsd:string ;
    echr:hasSupportingQuote "On 17 March 1998 the criminal investigation was concluded with the investigating judge’s decision ordering the exclusion of certain documents from the case-file in accordance with section 83, paragraph 3, of the Criminal Procedure Act."@en .

doc:investigation_into_his_allegations_1 a echr:DomesticProceeding ;
    rdfs:label "the investigation into his allegations"@en ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingStartDate "1995-04-04"^^xsd:date ;
    echr:hasSourceParagraph "3"^^xsd:string ;
    echr:hasSupportingQuote "the investigation into his allegations had not been effective."@en .

doc:maribor_higher_court_decision_4_dec_1997 a echr:DomesticProceeding ;
    rdfs:label "On 4 December 1997 the Maribor Higher Court upheld her appeal finding that, despite the shortcomings mentioned in the first-instance decision, there were sufficient grounds for suspicion that the applicant had committed the alleged offence. Accordingly, it changed the first-instance court’s decision and opened a criminal investigation against the applicant."@en ;
    echr:followsProceeding doc:public_prosecutor_appeal_12_may_1997 ;
    echr:hasDecisionDate "1997-12-04"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasSourceParagraph "41"^^xsd:string ;
    echr:hasSupportingQuote "On 4 December 1997 the Maribor Higher Court upheld her appeal finding that, despite the shortcomings mentioned in the first-instance decision, there were sufficient grounds for suspicion that the applicant had committed the alleged offence. Accordingly, it changed the first-instance court’s decision and opened a criminal investigation against the applicant."@en .

doc:maribor_higher_court_quashed_remitted_27_sep_2000 a echr:DomesticProceeding ;
    rdfs:label "On 5 January 2000 the Public Prosecutor appealed against the judgment and on 27 September 2000 the Maribor Higher Court quashed the judgment and remitted the case to a new panel for retrial."@en ;
    echr:followsProceeding doc:district_court_acquittal_22_nov_1999 ;
    echr:hasDecisionDate "2000-09-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasSourceParagraph "47"^^xsd:string ;
    echr:hasSupportingQuote "on 27 September 2000 the Maribor Higher Court quashed the judgment and remitted the case to a new panel for retrial."@en .

doc:maribor_higher_court_upheld_conviction_9_may_2001 a echr:DomesticProceeding ;
    rdfs:label "On 9 May 2001 the Maribor Higher Court upheld the conviction but amended the judgment with respect to the costs of the proceedings."@en ;
    echr:followsProceeding doc:district_court_retrial_conviction_12_feb_2001 ;
    echr:hasDecisionDate "2001-05-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasSourceParagraph "49"^^xsd:string ;
    echr:hasSupportingQuote "On 9 May 2001 the Maribor Higher Court upheld the conviction but amended the judgment with respect to the costs of the proceedings."@en .

doc:public_prosecutor_appeal_12_may_1997 a echr:DomesticProceeding ;
    rdfs:label "On 12 May 1997 the Public Prosecutor appealed against this decision."@en ;
    echr:followsProceeding doc:district_court_decision_not_open_investigation_8_may_1997 ;
