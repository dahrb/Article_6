doc:brussels_court_appeal_30jun2017 a echr:DomesticProceeding ;
    rdfs:label "court of appeal's judgment of 30 June 2017"@en ;
    echr:followsProceeding doc:brussels_court_appeal_7dec2016 ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasSourceParagraph "28"^^xsd:string ;
    echr:hasSupportingQuote "For its part, the Belgian State sought to counter the execution of the above-cited decisions; it secured this aim through the court of appeal’s judgment of 30 June 2017."@en .

doc:conseilDetatProceeding a echr:DomesticProceeding ;
    rdfs:label "Under section 39/67 of the Aliens Act, an appeal on points of law against the decisions of the Aliens Appeals Board lies to the Conseil d’État ."@en ;
