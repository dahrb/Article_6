doc:brussels_court_appeal_7dec2016 a echr:DomesticProceeding ;
    rdfs:label "Brussels Court of Appeal judgment of 7 December 2016 varying the order of 7 November 2016"@en ;
    echr:followsProceeding doc:tpi_judge_7nov2016 ;
    echr:hasDecisionDate "2016-12-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasSourceParagraph "28"^^xsd:string,
        "32"^^xsd:string ;
    echr:hasSupportingQuote "For the applicants, the purpose of the judicial phase was to obtain execution of the Aliens Appeals Board’s judgment of 20 October 2016 … and subsequently of the Brussels Court of Appeal’s judgment of 7 December 2016."@en,
        "On an appeal by the applicants, the Brussels Court of Appeal delivered a judgment on 7 December 2016 varying the order of 7 November 2016."@en .

