    echr:hasDecisionDate "2008-02-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "26"^^xsd:string ;
    echr:hasSupportingQuote "On 20 February 2008 the Supreme Court declared an appeal on points of law lodged by the applicant inadmissible."@en .

doc:trial_first_instance_2006 a echr:DomesticProceeding ;
    rdfs:label "(b) Trial"@en ;
    echr:followsProceeding doc:investigation_a_2005 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
