doc:mt_conviction_2006 a echr:DomesticProceeding ;
    rdfs:label "convicted at first instance of obstructing justice by giving false testimony"@en ;
    echr:hasDecisionDate "2006-12-26"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "27"^^xsd:string ;
    echr:hasSupportingQuote "On an unspecified date separate criminal proceedings were opened against M.T. and Z.T. On 26 December 2006 and 23 January 2007 respectively they were convicted at first instance of obstructing justice by giving false testimony."@en .

doc:supreme_court_inadmissible_2008 a echr:DomesticProceeding ;
    rdfs:label "On 20 February 2008 the Supreme Court declared an appeal on points of law lodged by the applicant inadmissible."@en ;
