doc:complaint_to_chief_prosecutor_2010_08_25 a echr:DomesticProceeding ;
    rdfs:label "On 25 and 26 August 2010 the applicant complained to the Chief Prosecutor that on 19 August 2010, directly before being transferred to Kutaisi Prison no. 2, he had been severely beaten by the governor of Rustavi Prison no. 6 and had sustained serious injuries to his ribs, head and backbone."@en ;
    echr:hasCourt doc:chiefProsecutor ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingStartDate "2010-08-25"^^xsd:date ;
    echr:hasSourceParagraph "38"^^xsd:string ;
    echr:hasSupportingQuote "On 25 and 26 August 2010 the applicant complained to the Chief Prosecutor that on 19 August 2010, directly before being transferred to Kutaisi Prison no. 2, he had been severely beaten by the governor of Rustavi Prison no. 6 and had sustained serious injuries to his ribs, head and backbone."^^xsd:string .

doc:first_instance_conviction_2006_applicant a echr:DomesticProceeding ;
    rdfs:label "On 8 December 2006 the court of first instance convicted the applicant of aggravated murder and the illegal acquisition, possession and carrying of firearms, and sentenced him to 17 years’ imprisonment."@en ;
    echr:hasDecisionDate "2006-12-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "22"^^xsd:string ;
    echr:hasSupportingQuote "On 8 December 2006 the court of first instance convicted the applicant of aggravated murder and the illegal acquisition, possession and carrying of firearms, and sentenced him to 17 years’ imprisonment."@en .

doc:investigation_a_2005 a echr:DomesticProceeding ;
    rdfs:label "(a) Investigation"@en ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
