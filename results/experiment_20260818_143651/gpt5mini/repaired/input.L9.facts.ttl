    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "9"^^xsd:string ;
    echr:hasSupportingQuote "On 14 July 2005 a search warrant was issued in respect of the applicant. He was arrested and remanded in custody on 27 July 2005."@en .

doc:investigatorAuthority a echr:DomesticAuthority ;
    rdfs:label "the investigator"@en ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasSourceParagraph "40"^^xsd:string ;
    echr:hasSupportingQuote "the investigator commissioned a forensic medical examination to determine if there were any injuries on the applicant’s body"^^xsd:string .

