doc:domestic_authority_1 a echr:DomesticAuthority ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "Aliens Appeals Board"^^xsd:string,
        "Aliens Office"^^xsd:string ;
    echr:hasName "Aliens Office"^^xsd:string ;
    echr:hasSourceParagraph "45"^^xsd:string,
        "75"^^xsd:string ;
    echr:hasSupportingQuote "The Aliens Office is the administrative body, under the supervision of the minister, which has responsibility in practice for all decisions concerning the entry, residence, settlement and expulsion of aliens."^^xsd:string,
        "the Aliens Appeals Board’s judgment of 20 October 2016"^^xsd:string .

doc:domestic_authority_2 a echr:DomesticAuthority ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Aliens Appeals Board"^^xsd:string,
        "Brussels Court of Appeal"^^xsd:string,
        "administrative courts"^^xsd:string ;
    echr:hasName "administrative courts"^^xsd:string ;
    echr:hasSourceParagraph "52"^^xsd:string,
        "75"^^xsd:string ;
    echr:hasSupportingQuote "The Aliens Appeals Board is an administrative court which rules in a collegial formation or as a single judge."^^xsd:string,
        "the Brussels Court of Appeal’s judgment of 7 December 2016"^^xsd:string .

doc:domestic_authority_3 a echr:DomesticAuthority ;
