doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    echr:hasCourt doc:domestic_authority_1 ;
    echr:hasDecisionDate "2016-10-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasProceedingStartDate "2016-08-22"^^xsd:date,
        "2016-10-20"^^xsd:date,
        "1990-01-01"^^echr:PartialDate ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "45"^^xsd:string,
        "75"^^xsd:string,
        "9"^^xsd:string ;
    echr:hasSupportingQuote "On 22 August 2016 the applicant couple, accompanied by one of their children, travelled to the Belgian embassy in Beirut to submit visa applications for themselves and their two children."^^xsd:string,
        "The decision on whether or not to grant a visa falls within the discretionary powers of the Minister (at the relevant time, the State Secretary with responsibility for asylum and migration), and his or her representative, an authorised civil servant from the Aliens Office."^^xsd:string,
        "the Aliens Appeals Board’s judgment of 20 October 2016, which had instructed the Belgian authorities to issue them with the visas they had requested under Article 3 of the Convention"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:domestic_proceeding_2 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_1 ;
    echr:hasCourt doc:domestic_authority_2 ;
    echr:hasDecisionDate "2016-12-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasProceedingStartDate "2016-12-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "52"^^xsd:string,
        "75"^^xsd:string,
        "8"^^xsd:string ;
    echr:hasSupportingQuote "If the Aliens Office refuses to issue a visa, the requesting party may apply to the Aliens Appeals Board to have the Aliens Office’s decision set aside."^^xsd:string,
        "secondly, they brought proceedings before the administrative courts to challenge the refusal by the Aliens Office to issue them with visas."^^xsd:string,
        "the execution of the Brussels Court of Appeal’s judgment of 7 December 2016 ordering the Belgian State to execute the Aliens Appeals Board’s judgment of 20 October 2016"^^xsd:string .

