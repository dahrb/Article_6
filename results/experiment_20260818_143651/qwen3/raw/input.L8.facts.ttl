doc:domestic_proceeding_2 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_1 ;
    echr:hasCourt doc:domestic_authority_2 ;
    echr:hasDecisionDate "1998-08-10"^^xsd:date,
        "1997-07"^^xsd:gYearMonth ;
    echr:hasDomesticProceeding doc:case_document_1 ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome doc:proceeding_outcome_2 ;
    echr:hasOutcomeDirection doc:outcome_direction_1 ;
    echr:hasParticipation doc:participation_2 ;
    echr:hasProceedingStartDate "1998"^^xsd:gYear,
        "1997-07"^^xsd:gYearMonth ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "1"^^xsd:string,
        "2"^^xsd:string ;
    echr:hasStatedDuration "P10M"^^xsd:duration ;
    echr:hasSupportingQuote "In July 1997 the Supreme Court quashed the conviction on the applicant’s appeal and remitted the case to the Nizhniy Novgorod Regional Court."^^xsd:string,
        "On 10 August 1998 the Supreme Court confirmed the judgment of the Nizhniy Novgorod Regional Court, with some alterations."^^xsd:string,
        "Overall, the Supreme Court found that there had not been any significant breaches of national procedural law or international standards during the trial."^^xsd:string,
        "The Supreme Court concluded that the disputed evidence had been properly evaluated by the Nizhniy Novgorod Regional Court and found admissible."^^xsd:string,
        "The Supreme Court did not refer to the complaint referring to the property dispute or to the admission of three civil claimants during the trial."^^xsd:string,
        "The Supreme Court did not refer to the complaint referring to the property dispute."^^xsd:string,
        "The Supreme Court dropped certain charges from the conviction and altered the classification of certain crimes, in view of the Criminal Code which entered into force in 1997."^^xsd:string,
        "The sentencing of the applicant to a total of six years in prison was upheld."^^xsd:string ;
    echr:isFinalDomesticDecision true ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

