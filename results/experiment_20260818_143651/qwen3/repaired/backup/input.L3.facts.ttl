doc:application_1 a doc:Application ;
    doc:applicationNumber 58919 ;
    doc:hasExtractionNote "Application number 58919/18 mentioned in the case header"^^xsd:string .

doc:article6_issue_1 a echr:Article6Issue ;
    echr:hasSourceParagraph "1"^^xsd:string,
        "27"^^xsd:string,
        "36"^^xsd:string,
        "41"^^xsd:string ;
    echr:hasSupportingQuote "He alleged that the Fund had proceeded with the sale without providing him with prior notification and that he had only learned of the sale upon its publication in the Official Gazette."^^xsd:string,
        "They concluded that it was unlawful to determine the estimated value without conducting an updated market assessment, and to proceed with the sale based on this figure."^^xsd:string,
        "the national authorities had failed to comply with the Supreme Administrative Court’s judgments rendered in his favour in those proceedings"^^xsd:string,
        "the non-enforcement of the final judgment annulling the sale of Viva TV-Radio Viva"^^xsd:string .

doc:article6_issue_2 a echr:Article6Issue ;
    echr:hasSourceParagraph "28"^^xsd:string,
        "37"^^xsd:string,
        "42"^^xsd:string ;
    echr:hasSupportingQuote "In the dissenting opinion, the judge observed that an appraisal report prepared by experts on 30 June 2009 had valued the entity at USD 5,914,000. The judge noted that, although approximately eighteen months had passed since the report, the Fund had set the estimated value at USD 6,000,000 without obtaining an updated valuation to reflect the prevailing economic conditions."^^xsd:string,
        "The court held that the annulment in that judgment necessitated a fresh judicial review of the case."^^xsd:string,
        "the applicant’s application had been submitted on 11 September 2017, after the expiry of the time-limit"^^xsd:string .

doc:article6_issue_3 a echr:Article6Issue ;
    echr:hasSourceParagraph "29"^^xsd:string,
        "52"^^xsd:string ;
    echr:hasSupportingQuote "The Constitutional Court concluded that the applicant had exhausted all available remedies."^^xsd:string,
        "The General Assembly concluded that the contested decision was not in compliance with the law, and, by a majority, annulled the Fund’s decision."^^xsd:string .

doc:article6_issue_4 echr:hasSourceParagraph "30"^^xsd:string ;
    echr:hasSupportingQuote "On 25 January 2016, the Supreme Administrative Court rejected the Fund’s request for rectification, noting that the case had become final following the appeal and was no longer subject to rectification."^^xsd:string .

doc:article6_issue_5 echr:hasSourceParagraph "31"^^xsd:string ;
    echr:hasSupportingQuote "The applicant asserted that, prior to the auction date, on 7 February 2011, he had published a public notice in the economy section of the national newspaper, Hürriyet , informing the public of his initiation of legal proceedings concerning the enforcement of the default provisions under the Liquidation Protocol signed with the Fund and the Fund’s decision to assume management and control of his companies following the commencement of the default process."^^xsd:string .

doc:case_document_1 a echr:CaseDocument .

doc:debtAmount a qudt:QuantityValue ;
    qudt:numericValue 726122000 ;
    qudt:unit "qudt:TRY"^^xsd:string ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "As a result, on 14 September 2001, the Fund resolved to recover 726,122,000 Turkish liras from the former shareholders by taking all necessary measures, including relying on the provisions of Law no. 6183 on the Collection of Debts Due to the State and imposing injunctions."^^xsd:string .

