    rdfs:label "Supreme Administrative Court"^^xsd:string ;
    echr:hasAuthorityName "6th Chamber of the İstanbul Administrative Court"^^xsd:string,
        "Supreme Administrative Court"^^xsd:string,
        "The Fund"^^xsd:string,
        "first-instance administrative court"^^xsd:string ;
    echr:hasSourceParagraph "46"^^xsd:string .

doc:domestic_authority_2 a echr:DomesticAuthority ;
    echr:hasAuthorityName "13th Chamber of the Supreme Administrative Court"^^xsd:string,
        "Supreme Administrative Court"^^xsd:string ;
    echr:hasSourceParagraph "47"^^xsd:string .

doc:domestic_authority_3 a echr:DomesticAuthority ;
    echr:hasAuthorityName "Constitutional Court"^^xsd:string ;
    echr:hasSourceParagraph "42"^^xsd:string .

doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Proceeding initiated on 24 February 2011 before the 6th Chamber of the İstanbul Administrative Court"^^xsd:string ;
    echr:hasProceedingStartDate "2006-07-20"^^xsd:date,
        "2008-04-03"^^xsd:date ;
    echr:hasSourceParagraph "1"^^xsd:string,
        "13"^^xsd:string,
        "27"^^xsd:string,
        "35"^^xsd:string,
        "46"^^xsd:string ;
    echr:hasSupportingQuote "On 19 March 2014, the 6th Chamber of the İstanbul Administrative Court dismissed the applicant’s claim, concluding that no legal irregularities had occurred in the tendering and sale procedures."^^xsd:string,
        "On 3 April 2008, the Fund concluded that the Erol Aksoy Group had failed to fulfil several commitments and obligations set out in the Liquidation Protocol, rendering the Protocol no longer effective for the recovery of public receivables. Consequently, the Fund decided to rely on its provisions concerning default. It resolved to initiate legal proceedings against all natural and legal person debtors within the Erol Aksoy Group and to proceed with the sale of assets, including those consolidated as an economic and commercial unit."^^xsd:string,
        "On 7 February 2011, the applicant initiated proceedings before the administrative court, contesting the actions of the Fund concerning the tendering of Viva TV-Radio Viva, in which he claimed to hold both direct and indirect shares."^^xsd:string,
        "The applicant appealed against the decision of the first-instance administrative court, which had dismissed the case on the grounds of his lack of standing."^^xsd:string,
        "the Supreme Administrative Court’s judgments rendered in his favour in those proceedings"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:domestic_proceeding_10 a echr:DomesticProceeding ;
    echr:hasProceedingStartDate "2006-05-09"^^xsd:date ;
    echr:hasSourceParagraph "9"^^xsd:string ;
    echr:hasSupportingQuote "On 9 May 2006, a debt liquidation protocol ( Borç Tasfiye Protokolü , hereinafter referred to as “the Liquidation Protocol”) was signed between the Fund (as creditor) and the Erol Aksoy Group (as debtor). The applicant personally signed the Liquidation Protocol as one of the debtors."^^xsd:string .

doc:domestic_proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Appeal proceeding on 9 December 2014 before the 13th Chamber of the Supreme Administrative Court"^^xsd:string ;
    echr:hasDecisionDate "2006-07-20"^^xsd:date ;
    echr:hasProceedingStartDate "2006-07-20"^^xsd:date,
        "2007-07-19"^^xsd:date ;
    echr:hasSourceParagraph "16"^^xsd:string,
        "28"^^xsd:string,
        "35"^^xsd:string,
        "47"^^xsd:string ;
    echr:hasSupportingQuote "On 19 July 2007, the Fund decided to establish two economic and commercial units: one for Viva TV and the other for Radio Viva."^^xsd:string,
        "On 20 July 2006, the Supreme Administrative Court, ruling unanimously, found that the applicant had a legal interest in the enforcement proceedings initiated under Law no. 6183, as he was the majority shareholder of İktisat Bank, which had been transferred to the Fund. The court held that the applicant had standing to challenge the transaction and quashed the administrative court’s earlier decision."^^xsd:string,
        "On 9 December 2014, the 13th Chamber of the Supreme Administrative Court dismissed the applicant’s case."^^xsd:string,
        "On an appeal by the applicant, the 13th Chamber of the Supreme Administrative Court upheld that decision on 9 December 2014."^^xsd:string .

doc:domestic_proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "Request for rectification proceeding on 30 June 2017 before the 13th Chamber of the Supreme Administrative Court"^^xsd:string ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasProceedingStartDate "2007-08-01"^^xsd:date,
        "2017-09-11"^^xsd:date ;
    echr:hasSourceParagraph "17"^^xsd:string,
        "29"^^xsd:string,
        "37"^^xsd:string,
        "42"^^xsd:string ;
    echr:hasSupportingQuote "In a decision of 23 May 2018, the Constitutional Court observed that the final annulment judgment of the 13th Chamber of the Supreme Administrative Court had been served on the applicant on 28 July 2017 and determined that the thirty-day time-limit for lodging an individual application had commenced on that date. Noting that the applicant’s application had been submitted on 11 September 2017, after the expiry of the time-limit, the Constitutional Court declared the application inadmissible."^^xsd:string,
        "On 30 June 2017, the 13 th Chamber of the Supreme Administrative Court granted the request, referring to the ruling of the General Assembly of 7 July 2015 which had annulled the Fund’s decision of 13 January 2011 concerning the valuation of Viva TV-Radio Viva (see paragraph 29 above). The court held that the annulment in that judgment necessitated a fresh judicial review of the case."^^xsd:string,
        "On 7 July 2015, following an appeal by the applicant, the General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court ( Danıştay İdari Dava Daireleri Genel Kurulu – hereinafter “the General Assembly”), in line with the dissenting opinion, ruled that the estimated value of USD 6,000,000 had been determined on the basis of the 2009 valuation report, without any new assessment of the market value. The General Assembly concluded that the contested decision was not in compliance with the law, and, by a majority, annulled the Fund’s decision."^^xsd:string,
        "With respect to Viva TV, the Fund resolved to consolidate all seized assets, rights, properties and associated components, such as contracts and the rights arising therefrom, belonging to debtor companies within the Erol Aksoy Group and effectively used by Viva TV into a single economic and commercial unit."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:domestic_proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "Annulment proceeding on 30 June 2017 before the 13th Chamber of the Supreme Administrative Court"^^xsd:string ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasProceedingStartDate "2007-08-01"^^xsd:date,
        "2017-09-11"^^xsd:date ;
    echr:hasSourceParagraph "18"^^xsd:string,
        "30"^^xsd:string,
        "38"^^xsd:string,
        "52"^^xsd:string ;
    echr:hasSupportingQuote "A similar resolution was adopted regarding Radio Viva. The Fund decided that the seized assets, rights, properties and associated components utilised by Radio Viva, including contracts and the rights arising therefrom, would also be consolidated into a single economic and commercial unit."^^xsd:string,
        "On 25 January 2016, the Supreme Administrative Court rejected the Fund’s request for rectification, noting that the case had become final following the appeal and was no longer subject to rectification."^^xsd:string,
        "The Constitutional Court concluded that the applicant had exhausted all available remedies. The Constitutional Court further noted that the applicant’s claim concerned a continuing violation and, as such, considered that the application had been lodged within the time-limit. The Constitutional Court held that the administration had an obligation either to enforce a court judgment to achieve restitutio in integrum or, if this was objectively impossible due to insurmountable factual or legal obstacles, to propose alternative measures providing adequate redress, without placing the burden on the applicant to initiate new proceedings. The Constitutional Court held that the completion of the sale did not constitute a legal or practical barrier to enforcing the judgment."^^xsd:string,
        "The court further emphasised that, since the Fund’s decision of 13 January 2011 had been definitively annulled, all actions based on that decision had been rendered legally invalid. As a result, the court overturned the judgment of the 6th Chamber of the Istanbul Administrative Court dated 19 March 2014 and annulled the sale in question."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:domestic_proceeding_5 a echr:DomesticProceeding ;
    echr:hasProceedingStartDate "2007-08-29"^^xsd:date ;
    echr:hasSourceParagraph "20"^^xsd:string,
        "31"^^xsd:string ;
    echr:hasSupportingQuote "In a letter dated 23 March 2016, the applicant communicated with the Fund, requesting the enforcement of the annulment judgment."^^xsd:string,
        "On 29 August 2007, the Fund resolved to offer both Viva TV and Radio Viva for sale together in a single tendering process, setting a reserve price of USD 8,000,000."^^xsd:string .

doc:domestic_proceeding_6 a echr:DomesticProceeding ;
    echr:hasProceedingStartDate "2009-06-30"^^xsd:date ;
    echr:hasSourceParagraph "21"^^xsd:string,
        "27"^^xsd:string ;
    echr:hasSupportingQuote "He alleged that the Fund had proceeded with the sale without providing him with prior notification and that he had only learned of the sale upon its publication in the Official Gazette."^^xsd:string,
        "On 30 June 2009, a valuation report issued by TSKB determined that the value of Radio Viva was USD 5,782,000 and the value of Viva TV was USD 132,000."^^xsd:string .

doc:domestic_proceeding_7 a echr:DomesticProceeding ;
    echr:hasProceedingStartDate "2009-07-09"^^xsd:date ;
    echr:hasSourceParagraph "22"^^xsd:string,
        "27"^^xsd:string ;
    echr:hasSupportingQuote "He additionally requested a stay of execution of the Fund’s decision, arguing that the actual value of Viva TV-Radio Viva substantially exceeded the valuation determined by the Fund."^^xsd:string,
        "On 9 July 2009, the Fund decided to merge the two economic and commercial units, thereby creating the Viva TV-Radio Viva Economic and Commercial Unit (hereinafter referred to as “Viva TV-Radio Viva”)."^^xsd:string .

doc:domestic_proceeding_8 a echr:DomesticProceeding ;
    echr:hasProceedingStartDate "2009-11-05"^^xsd:date ;
    echr:hasSourceParagraph "23"^^xsd:string,
        "27"^^xsd:string ;
    echr:hasSupportingQuote "He asserted that, as a signatory to the Liquidation Protocol agreed with the Fund and as a personal guarantor of the debt underlying the contested sale, he possessed a direct and legitimate legal interest in initiating the proceedings."^^xsd:string,
        "On 5 November 2009, the Fund resolved to offer Viva TV-Radio Viva for sale, establishing a reserve price of USD 6,000,000."^^xsd:string .

doc:domestic_proceeding_9 a echr:DomesticProceeding ;
    echr:hasProceedingStartDate "2011-01-13"^^xsd:date ;
    echr:hasSourceParagraph "24"^^xsd:string,
        "27"^^xsd:string ;
    echr:hasSupportingQuote "On 13 January 2011, the Fund decided to offer Viva TV-Radio Viva for sale again, setting the reserve price at USD 6,000,000."^^xsd:string,
        "The applicant sought the annulment of all measures related to the sale, including the Fund’s decision of 13 January 2011, which approved the invitation to tender and the terms of sale and set the estimated value of Viva TV-Radio Viva at USD 6,000,000."^^xsd:string .

