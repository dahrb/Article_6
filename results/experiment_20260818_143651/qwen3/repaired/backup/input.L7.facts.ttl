    dcterms:title "input.jsonl:7"^^xsd:string .

doc:adjournment_1 a echr:Adjournment ;
    echr:hasAdjournmentDate "1999-03-31"^^xsd:date ;
    echr:hasResumptionDate "1999-04-01"^^xsd:date ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "On 25 March 1999, before the closing speeches were due to begin and a long adjournment over a weekend, the judge after consulting counsel decided to withdraw the applicant’s bail."^^xsd:string,
        "the overnight adjournment of the trial"^^xsd:string .

doc:article6_issue_2 a echr:Article6Issue ;
    echr:hasSourceParagraph "2"^^xsd:string ;
    echr:hasStatedDuration "P1Y10M"^^xsd:duration ;
    echr:hasSupportingQuote "56 years after the event"^^xsd:string,
        "the Court of Appeal found that he had correctly applied his discretion on the basis that the reliability of the evidence could be properly and fairly tested in the trial and subject to his powers of direction as trial judge and that it had not been established that the continuance of the proceedings would deny the applicant a fair trial."^^xsd:string,
        "the appeal took six years"^^xsd:string ;
    echr:hasTimeGap 56 ;
    echr:hasTimeGapUnit "years"^^xsd:string .

doc:article6_issue_3 a echr:Article6Issue ;
    echr:hasSourceParagraph "2"^^xsd:string ;
    echr:hasSupportingQuote "As regards the allegations that the judge should have excluded evidence of witnesses about alleged assaults and the taking away of Jewish families by the applicant which were not on the indictment, it held that this evidence was relevant to prove that the applicant was a policeman involved in the search and kill operation and as establishing the context and circumstances in which the offences were said to have been committed."^^xsd:string .

doc:article6_issue_4 a echr:Article6Issue ;
    echr:hasDistance 127,
        128 ;
    echr:hasDistanceUnit "paces"^^xsd:string ;
    echr:hasSourceParagraph "2"^^xsd:string ;
    echr:hasSupportingQuote "127 or 128 paces"^^xsd:string,
        "The Court of Appeal found no basis to fault the judge’s approach to the evidence concerning Mr Zan’s identification of the applicant."^^xsd:string .

doc:article6_issue_5 a echr:Article6Issue ;
    echr:hasSourceParagraph "2"^^xsd:string ;
    echr:hasSupportingQuote "As regards the cross-examination on the basis of the missing records document, it considered that the judge had given a clear direction to the jury that this document could not constitute evidence that he was a member of the Waffen SS and that it could not contradict his assertion that he was never a member of that organisation."^^xsd:string .

doc:article6_issue_6 a echr:Article6Issue ;
    echr:hasSourceParagraph "3"^^xsd:string ;
    echr:hasSupportingQuote "On 15 June 2000, the House of Lords refused the petition for leave to appeal. No reasons were given."^^xsd:string .

doc:case_document_1 a echr:CaseDocument .

doc:domestic_authority_2 a echr:DomesticAuthority ;
    echr:hasAuthorityName "Court of Appeal"^^xsd:string ;
    echr:hasSourceParagraph "1"^^xsd:string,
        "2"^^xsd:string ;
    echr:hasSupportingQuote "An application was made to the High Court to review bail on 26 March 1999. It was refused. The applicant states that the High Court judge took the view that he should not interfere with the decision given the stage reached in the proceedings, i.e. the closing speeches."^^xsd:string,
        "the Court of Appeal"^^xsd:string .

doc:domestic_authority_3 a echr:DomesticAuthority ;
    echr:hasAuthorityName "House of Lords"^^xsd:string ;
    echr:hasSourceParagraph "3"^^xsd:string ;
    echr:hasSupportingQuote "the House of Lords"^^xsd:string .

doc:domestic_proceeding_2 a echr:DomesticProceeding ;
    echr:hasDecisionDate "2000-02-10"^^xsd:date ;
    echr:hasProceedingStartDate "1999"^^xsd:gYear ;
    echr:hasSourceParagraph "1"^^xsd:string,
        "2"^^xsd:string ;
    echr:hasStatedDuration "P1Y10M"^^xsd:duration ;
    echr:hasSupportingQuote "An application was made to the High Court to review bail on 26 March 1999. It was refused. The applicant states that the High Court judge took the view that he should not interfere with the decision given the stage reached in the proceedings, i.e. the closing speeches."^^xsd:string,
        "In its judgment of 10 February 2000, the Court of Appeal rejected the applicant’s appeal."^^xsd:string,
        "The applicant appealed against conviction to the Court of Appeal."^^xsd:string,
        "the appeal took six years"^^xsd:string .

doc:domestic_proceeding_3 a echr:DomesticProceeding ;
    echr:hasDecisionDate "2000-06-15"^^xsd:date ;
    echr:hasProceedingStartDate "2000"^^xsd:gYear ;
    echr:hasSourceParagraph "3"^^xsd:string ;
    echr:hasStatedDuration "P4M"^^xsd:duration ;
    echr:hasSupportingQuote "On 15 June 2000, the House of Lords refused the petition for leave to appeal. No reasons were given."^^xsd:string,
        "the petition for leave to appeal"^^xsd:string .

doc:inactivity_period_1 a echr:InactivityPeriod ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "On 25 March 1999, before the closing speeches were due to begin and a long adjournment over a weekend, the judge after consulting counsel decided to withdraw the applicant’s bail. An application was made to the High Court to review bail on 26 March 1999. It was refused."^^xsd:string .

doc:natural_person_1 a echr:NaturalPerson ;
    echr:hasBirthYear "1921"^^xsd:gYear ;
    echr:hasGender echr:GenderMale ;
    echr:hasGenderCue "Mr"^^xsd:string,
        "male"^^xsd:string ;
    echr:hasGenderCueText "the applicant"^^xsd:string ;
    echr:hasPersonName "Anthony Sawoniuk"^^xsd:string,
        "the applicant"^^xsd:string ;
    echr:hasSourceParagraph "1"^^xsd:string,
        "2"^^xsd:string ;
    echr:hasStatedAge 13 ;
    echr:hasSupportingQuote "The applicant is a Polish national, born in 1921 and currently serving a sentence of life imprisonment in HM Prison Gartree."^^xsd:string,
        "a 13 year old boy"^^xsd:string,
        "the applicant"^^xsd:string,
        "the applicant became highly emotional"^^xsd:string,
        "the applicant denied it very emphatically"^^xsd:string,
        "the applicant denied that he had ever joined the Waffen SS"^^xsd:string,
        "the applicant had in fact left Domachevo"^^xsd:string,
        "the applicant had joined the Polish brigade"^^xsd:string,
        "the applicant had served in the Polish Free Army"^^xsd:string,
        "the applicant should be acquitted"^^xsd:string,
        "the applicant’s bail"^^xsd:string,
        "the applicant’s claim"^^xsd:string,
        "the applicant’s legal representatives"^^xsd:string,
        "the applicant’s welfare"^^xsd:string ;
    echr:isAnonymised false .

doc:party_2 a echr:Party ;
    echr:hasPartyName "the prosecution"^^xsd:string ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "the jury convicted the applicant"^^xsd:string .

doc:pre_trial_detention_1 a echr:PreTrialDetention ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "On 25 March 1999, before the closing speeches were due to begin and a long adjournment over a weekend, the judge after consulting counsel decided to withdraw the applicant’s bail. ... he would be held in the hospital wing of Belmarsh prison with medical attention and a carer to oversee his welfare."^^xsd:string .

doc:article6_issue_1 a echr:Article6Issue ;
    echr:affectsParty doc:party_1 ;
    echr:hasDelayAttribution echr:DelayUnattributed ;
    echr:hasSourceParagraph "1"^^xsd:string,
        "2"^^xsd:string ;
    echr:hasSupportingQuote "Before the commencement of the proceedings, the defence made a number of applications: that the trial should be stayed as an abuse on the basis that due inter alia to the lapse of time since events the applicant could not obtain a fair trial."^^xsd:string,
        "the judge had erred in failing to stay the proceedings and in admitting the evidence of Ivan Baglay and Evgeny Melianuk, that the judge failed to direct the jury on how to approach evidence which related to similar facts or other crimes not the subject of the indictment, that the judge had erred in not discharging the jury on the basis that they had heard evidence relating to counts 2 and 4 which had been withdrawn and that the verdict of the jury was unsafe by reason of the cross-examination of the applicant on a Waffen SS document which was not evidence in the case and during which his loss of composure would have reflected on his credit."^^xsd:string ;
    echr:issueArisesIn doc:domestic_proceeding_1 .

doc:domestic_authority_1 a echr:DomesticAuthority ;
    echr:hasAuthorityName "Court presided over by Mr Justice Potts and a jury"^^xsd:string,
        "trial judge"^^xsd:string ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "At the close of the prosecution case, the judge ruled that there was insufficient evidence as a matter of law to support a conviction on counts 2 and 4 and that the applicant should be acquitted."^^xsd:string,
        "I emphasise that in taking this course my concern is for the defendant’s own protection."^^xsd:string,
        "I have come to the conclusion that, against the whole background of the case, and bearing in mind particularly the manner in which the defendant gave his evidence over the last two or three days, that the defendant comes within the terms of paragraph (3) ... that bail should be withdrawn for his own protection and that the arrangements to which I have referred would ensure that he is properly looked after until the conclusion of this trial."^^xsd:string,
        "In the trial which took place between 8 February and 1 April 1999, before Mr Justice Potts and a jury, the applicant was represented by senior and junior counsel and solicitors."^^xsd:string,
        "On 24 March 1999, the judge refused the application."^^xsd:string,
        "On 25 March 1999, before the closing speeches were due to begin and a long adjournment over a weekend, the judge after consulting counsel decided to withdraw the applicant’s bail."^^xsd:string,
        "On 8 February 1999, the judge ruled that the evidence of both witnesses was relevant and admissible and, on 26 February 1999, that it should go before the jury."^^xsd:string,
        "The judge directed the jury that hearsay was not evidence, that the document to which the officer had referred had not been prepared by him and that, accordingly, the document was not evidence."^^xsd:string,
        "The judge ruled that it was permissible to put to him questions concerning the Polish military records and permitted prosecution counsel to ask the applicant to look at the missing persons document and put questions on that document."^^xsd:string,
        "the trial judge reinstated bail."^^xsd:string .

doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasCourt doc:domestic_authority_1 ;
    echr:hasDecisionDate "1999-04-01"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasPartySide echr:SideResponding ;
    echr:hasProceedingStartDate "1996-04-01"^^xsd:date,
        "1999"^^xsd:gYear ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSittingJudge doc:judicial_officer_1 ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasStatedDetentionDuration "P0D"^^xsd:duration ;
    echr:hasStatedDuration "P10M"^^xsd:duration ;
    echr:hasSupportingQuote "An application was made to the High Court to review bail on 26 March 1999. It was refused."^^xsd:string,
        "At the close of the prosecution case, the judge ruled that there was insufficient evidence as a matter of law to support a conviction on counts 2 and 4 and that the applicant should be acquitted."^^xsd:string,
        "During cross-examination, he appeared to claim that he had joined the Polish brigade in early 1944."^^xsd:string,
        "During the trial the judge and jury visited the location at Domachevo, including the site in a forest where one witness, Fedor Zan, claimed to have seen the applicant execute a number of Jewish women, including the victim specified in Count 3."^^xsd:string,
        "In the trial which took place between 8 February and 1 April 1999, before Mr Justice Potts and a jury, the applicant was represented by senior and junior counsel and solicitors."^^xsd:string,
        "On 1 April 1999, the jury convicted the applicant of counts 1 and 3. The applicant was sentenced to a mandatory term of life imprisonment. The trial judge recommended that the applicant “never see the light of day”."^^xsd:string,
        "On 24 March 1999, the judge refused the application."^^xsd:string,
        "On 25 March 1999, before the closing speeches were due to begin and a long adjournment over a weekend, the judge after consulting counsel decided to withdraw the applicant’s bail."^^xsd:string,
        "On 29 March 1999, defence counsel made representations, inter alia , that the arrangements made for the applicant in prison had not reflected those referred to by the trial judge."^^xsd:string,
        "On 8 February 1999, the judge ruled that the evidence of both witnesses was relevant and admissible and, on 26 February 1999, that it should go before the jury."^^xsd:string,
        "On hearing re-assurances from defence counsel that arrangements would be made for transporting the applicant to and from the court room and for ensuring his welfare in his own home, and having regard to the shortness of the overnight adjournment of the trial, the trial judge reinstated bail."^^xsd:string,
        "The prosecution made an application to the judge to call evidence to prove the provenance of the missing persons document in order to rebut the allegation of fabrication."^^xsd:string,
        "When the applicant gave evidence, he referred to his service in the Polish army, again with reference to the Polish records, and stated that he had in fact left Domachevo at the end of 1943, not during 1944 as had been part of a formal admission by his legal representatives."^^xsd:string,
        "the trial"^^xsd:string ;
    echr:isFinalDomesticDecision true ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

doc:judicial_officer_1 a echr:JudicialOfficer ;
    echr:hasPersonName "Mr Justice Potts"^^xsd:string ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "In the trial which took place between 8 February and 1 April 1999, before Mr Justice Potts and a jury, the applicant was represented by senior and junior counsel and solicitors."^^xsd:string .

