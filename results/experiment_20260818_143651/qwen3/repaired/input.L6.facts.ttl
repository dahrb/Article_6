@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/009d29d97558/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/009d29d97558> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:6"^^xsd:string .

doc:applicantCompany a echr:Party ;
    echr:hasName "applicant company"^^xsd:string ;
    echr:hasPartyName "applicant company"^^xsd:string .

doc:article6_issue_1 a echr:Article6Issue ;
    rdfs:label "Fair-trial grievance regarding delayed proceedings"^^xsd:string ;
    echr:hasSourceParagraph "19"^^xsd:string,
        "27"^^xsd:string ;
    echr:hasSupportingQuote "In such circumstances, the applicant company's right of access to a court had been violated."^^xsd:string,
        "The decision was amenable to appeal before a three-judge bench of the Commercial Court within three days of receipt by the party."^^xsd:string .

doc:article6_issue_2 a echr:Article6Issue ;
    echr:hasSourceParagraph "20"^^xsd:string,
        "37"^^xsd:string ;
    echr:hasSupportingQuote "The applicant company further pointed out that the argument that it had failed to submit the relevant extracts of the contracts to the tribunal was groundless since, in its claim lodged with that institution, it had expressly mentioned that copies of the decisions of the Commercial Court and extracts of the contracts in question had already been submitted with the letter of 23 July 2008."^^xsd:string,
        "the court had decided to leave the claim unexamined, even though the LLC had submitted the relevant request several months after the litigation had started and had already made its submissions on the merits of the claim."^^xsd:string .

doc:article6_issue_3 a echr:Article6Issue ;
    echr:hasSourceParagraph "24"^^xsd:string ;
    echr:hasSupportingQuote "the applicant company’s representative told the registrar that the conclusion with the LLC of this type of new agreement was at that point impossible and unreasonable, since the Commercial Court had already found that the arbitration clause contained in the contracts was sufficient to start arbitration proceedings."^^xsd:string .

doc:domestic_authority_1 a echr:DomesticAuthority ;
    rdfs:label "Commercial Court"^^xsd:string ;
    echr:hasAuthorityName "Commercial Court"^^xsd:string,
        "President of the Arbitration Tribunal"^^xsd:string ;
    echr:hasName "Commercial Court"^^xsd:string,
        "President of the Arbitration Tribunal"^^xsd:string .

doc:domestic_authority_2 a echr:DomesticAuthority ;
    echr:hasAuthorityName "Arbitration Tribunal of the Chamber of Commerce and Industry of Armenia"^^xsd:string,
        "Yerevan Civil Court"^^xsd:string ;
    echr:hasName "Arbitration Tribunal of the Chamber of Commerce and Industry of Armenia"^^xsd:string,
        "Yerevan Civil Court"^^xsd:string .

doc:domestic_authority_3 a echr:DomesticAuthority ;
    echr:hasAuthorityName "Kentron and Nork-Marash District Court of Yerevan"^^xsd:string ;
    echr:hasName "Kentron and Nork-Marash District Court of Yerevan"^^xsd:string .

doc:domestic_authority_4 a echr:DomesticAuthority ;
    echr:hasAuthorityName "Civil Court of Appeal"^^xsd:string ;
    echr:hasName "Civil Court of Appeal"^^xsd:string .

doc:domestic_authority_5 a echr:DomesticAuthority ;
    echr:hasAuthorityName "Court of Cassation"^^xsd:string ;
    echr:hasName "Court of Cassation"^^xsd:string .

doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Domestic proceeding initiated by Scholz AG on 2007-01-15"^^xsd:string ;
    echr:hasProceedingStartDate "2007-01-15"^^xsd:date,
        "2008-10-07"^^xsd:date ;
    echr:hasSourceParagraph "14"^^xsd:string,
        "16"^^xsd:string,
        "26"^^xsd:string ;
    echr:hasSupportingQuote "On 15 January 2007 the applicant company lodged a claim with the Commercial Court against the LLC, seeking to recover USD 10,000 from the initial debt of USD 1,213,824."^^xsd:string,
        "On 4 October 2007 the LLC filed a counterclaim, contesting the applicant company’s claims."^^xsd:string,
        "On 7 October 2008 the President of the Arbitration Tribunal informed the applicant company that its request to start arbitration proceedings would not be granted."^^xsd:string ;
    echr:isFinalDomesticDecision false ;
    echr:isPending false .

doc:domestic_proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Domestic proceeding amended by Scholz AG on 2007-10-02"^^xsd:string ;
    echr:hasDecisionDate "2007-11-16"^^xsd:date ;
    echr:hasProceedingStartDate "2007-10-02"^^xsd:date,
        "2008-10-17"^^xsd:date ;
    echr:hasSourceParagraph "15"^^xsd:string,
        "19"^^xsd:string,
        "27"^^xsd:string ;
    echr:hasSupportingQuote "On 16 November 2007 the Commercial Court granted the request and decided to leave the applicant company’s claim and the counterclaim lodged by the LLC unexamined."^^xsd:string,
        "On 2 October 2007 the applicant company amended its initial claim, seeking to recover a total of USD 1,516,442 and EUR 116,600 from the LLC, including the principal debt, the loan and interest on both."^^xsd:string,
        "on 17 October 2008 the applicant company lodged a claim with the Yerevan Civil Court, seeking to recover EUR 116,600 from the LLC, representing the amount of the loan and interest."^^xsd:string ;
    echr:isFinalDomesticDecision false ;
    echr:isPending false .

doc:domestic_proceeding_3 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_6 ;
    echr:hasCourt echr:DistrictCourt ;
    echr:hasDecisionDate "2007-12-10"^^xsd:date ;
    echr:hasOutcome echr:OutcomeRejectedOrDismissed ;
    echr:hasProceedingStartDate "2009-03-13"^^xsd:date ;
    echr:hasSourceParagraph "20"^^xsd:string,
        "30"^^xsd:string ;
    echr:hasSupportingQuote "On 13 March 2009 the District Court accepted the case for examination."^^xsd:string,
        "On 23 November 2007 the applicant company lodged a complaint concerning the decision to leave the claim and counterclaim unexamined."^^xsd:string ;
    echr:isFinalDomesticDecision false ;
    echr:isPending false .

doc:domestic_proceeding_4 a echr:DomesticProceeding ;
    echr:hasProceedingStartDate "2008-09-17"^^xsd:date,
        "2009-06-25"^^xsd:date ;
    echr:hasSourceParagraph "25"^^xsd:string,
        "34"^^xsd:string ;
    echr:hasSupportingQuote "On 17 September 2008 the applicant company lodged a claim with the Arbitration Tribunal, seeking to recover EUR 116,600, the amount of the loan and interest."^^xsd:string,
        "On 25 June 2009 the applicant company lodged an appeal."^^xsd:string ;
    echr:isFinalDomesticDecision false,
        true ;
    echr:isPending false .

doc:domestic_proceeding_5 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_6 ;
    echr:hasProceedingStartDate "2009-08-04"^^xsd:date ;
    echr:hasSourceParagraph "37"^^xsd:string ;
    echr:hasSupportingQuote "On 4 August 2009 the applicant company lodged an appeal on points of law."^^xsd:string ;
    echr:isFinalDomesticDecision true ;
    echr:isPending false .

doc:domestic_proceeding_7 a echr:DomesticProceeding ;
    echr:hasProceedingStartDate "2008-11-12"^^xsd:date ;
    echr:hasSourceParagraph "28"^^xsd:string ;
    echr:hasSupportingQuote "On 12 November 2008 the Yerevan Civil Court accepted the applicant company’s claim for examination and scheduled a preparatory hearing."^^xsd:string ;
    echr:isFinalDomesticDecision false ;
    echr:isPending false .

doc:domestic_proceeding_8 a echr:DomesticProceeding ;
    echr:hasProceedingStartDate "2009-02-27"^^xsd:date ;
    echr:hasSourceParagraph "29"^^xsd:string ;
    echr:hasSupportingQuote "On 27 February 2009 the Yerevan Civil Court transferred the case to the Kentron and Nork-Marash District Court of Yerevan"^^xsd:string ;
    echr:isFinalDomesticDecision false ;
    echr:isPending false .

doc:domestic_proceeding_9 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_10 ;
    echr:hasProceedingStartDate "2009-07-21"^^xsd:date ;
    echr:hasSourceParagraph "36"^^xsd:string ;
    echr:hasSupportingQuote "On 21 July 2009 the Civil Court of Appeal upheld the decision of 16 June 2009."^^xsd:string ;
    echr:isFinalDomesticDecision false ;
    echr:isPending false .

doc:llc a echr:Party ;
    echr:hasName "LLC"^^xsd:string ;
    echr:hasPartyName "LLC"^^xsd:string .

doc:participation_1 a echr:Participation ;
    rdfs:label "Participation of Scholz AG as initiating party in first proceeding"^^xsd:string ;
    echr:Participation "cd:domestic_proceeding_1"^^xsd:string .

doc:participation_2 a echr:Participation ;
    rdfs:label "Participation of Scholz AG as initiating party in amended proceeding"^^xsd:string ;
    echr:Participation "cd:domestic_proceeding_2"^^xsd:string .

doc:participation_3 a echr:Participation ;
    echr:Participation "cd:domestic_proceeding_3"^^xsd:string,
        "cd:domestic_proceeding_4"^^xsd:string,
        "cd:domestic_proceeding_5"^^xsd:string .

doc:party_1 a echr:Party ;
    rdfs:label "Scholz AG"^^xsd:string ;
    echr:hasName "Scholz AG"^^xsd:string ;
    echr:hasPartyName "Scholz AG"^^xsd:string,
        "applicant company"^^xsd:string .

doc:domestic_proceeding_10 a echr:DomesticProceeding ;
    echr:hasCourt echr:YerevanCivilCourt ;
    echr:hasDecisionDate "2009-06-16^^echr:PartialDate"^^echr:PartialDate ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal .

doc:domestic_proceeding_6 a echr:DomesticProceeding ;
    echr:hasCourt echr:CommercialCourt ;
    echr:hasDecisionDate "2007-11-16^^echr:PartialDate"^^echr:PartialDate ;
    echr:hasOutcome echr:OutcomeLeaveClaimUnexamined ;
    echr:hasProceedingStartDate "2007-11-16"^^xsd:date ;
    echr:hasSourceParagraph "31"^^xsd:string ;
    echr:hasSupportingQuote "On 16 November 2007, the Commercial Court"^^xsd:string ;
    echr:isFinalDomesticDecision false,
        true ;
    echr:isPending false .

