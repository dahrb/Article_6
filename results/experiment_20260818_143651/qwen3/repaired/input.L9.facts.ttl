doc:article6_issue_1 a echr:Article6Issue ;
    rdfs:label "Delay in re-questioning M.T."^^xsd:string ;
    echr:affectsParty doc:natural_person_1 ;
    echr:hasDelayAttribution echr:DelayUnattributed ;
    echr:hasSourceParagraph "12-13"^^xsd:string,
        "23"^^xsd:string,
        "40"^^xsd:string ;
    echr:hasSupportingQuote "As regards M.T., his initial statements were inadmissible evidence, as they had been obtained under duress."^^xsd:string,
        "M.T.’s request was rejected by the investigator... It does not appear that M.T. received any response to his appeal."^^xsd:string,
        "On 31 August 2010 an investigation was opened into the applicant’s allegations."^^xsd:string,
        "The applicant appealed, arguing that there was insufficient evidence to convict him. He submitted that the evidence relied on by the court was not incontrovertible, as required by domestic law, and the victim’s wife and other family members were implicating him based on hearsay, and were unable to name any eyewitnesses except M.T."^^xsd:string,
        "The court dismissed an application by the applicant for pre-trial statements given by M.T. and Z.T. to be declared inadmissible on the grounds that they had been obtained under duress."^^xsd:string ;
    echr:issueArisesIn doc:domestic_proceeding_1 .

doc:article6_issue_2 a echr:Article6Issue ;
    rdfs:label "Denial of confrontation with M.T."^^xsd:string ;
    echr:affectsParty doc:natural_person_1 ;
    echr:hasDelayAttribution echr:DelayUnattributed ;
    echr:hasSourceParagraph "14"^^xsd:string,
        "38"^^xsd:string ;
    echr:hasSupportingQuote "His request was rejected by the investigator on account of M.T.’s request of 3 September 2005... A second request by the applicant to have a confrontation with M.T., dated 15 November 2005, was rejected by the investigator on 16 November 2005 on identical grounds."^^xsd:string,
        "On 25 and 26 August 2010 the applicant complained to the Chief Prosecutor that on 19 August 2010, directly before being transferred to Kutaisi Prison no. 2, he had been severely beaten by the governor of Rustavi Prison no. 6..."^^xsd:string ;
    echr:issueArisesIn doc:domestic_proceeding_2 .

doc:article6_issue_3 a echr:Article6Issue ;
    rdfs:label "Questioning of witnesses in court"^^xsd:string ;
    echr:affectsParty doc:natural_person_1 ;
    echr:hasDelayAttribution echr:DelayUnattributed ;
    echr:hasSourceParagraph "16"^^xsd:string,
        "45"^^xsd:string ;
    echr:hasSupportingQuote "Both M.T. and Z.T. were questioned in court by the applicant’s representative and the prosecutor."^^xsd:string,
        "On 25 November 2010 the doctor who had examined the applicant upon his admission to Kutaisi Prison no. 2 on 19 August 2010 noted that no signs of ill-treatment had been observed on the applicant’s body and that he had not complained in this regard."^^xsd:string ;
    echr:issueArisesIn doc:domestic_proceeding_3 .

doc:article6_issue_4 a echr:Article6Issue ;
    echr:affectsParty doc:natural_person_1 ;
    echr:hasDelayAttribution echr:DelayUnattributed ;
    echr:hasSourceParagraph "47"^^xsd:string ;
    echr:hasSupportingQuote "Neither the Government nor the applicant updated the Court on the final outcome of that investigation."^^xsd:string ;
    echr:issueArisesIn doc:domestic_proceeding_4 .

doc:article6_issue_5 a echr:Article6Issue ;
    echr:affectsParty doc:natural_person_1 ;
    echr:hasDelayAttribution echr:DelayUnattributed ;
    echr:hasSourceParagraph "43"^^xsd:string ;
    echr:hasSupportingQuote "On 3 September 2010 the forensic medical examination was concluded. An expert from the National Forensic Bureau found that the applicant had a trace of a small abrasion..."^^xsd:string ;
    echr:issueArisesIn doc:domestic_proceeding_5 .

doc:article6_issue_6 a echr:Article6Issue ;
    echr:affectsParty doc:natural_person_1 ;
    echr:hasDelayAttribution echr:DelayUnattributed ;
    echr:hasSourceParagraph "42"^^xsd:string ;
    echr:hasSupportingQuote "On 2 September 2010 the investigator questioned a doctor from the prison hospital..."^^xsd:string ;
    echr:issueArisesIn doc:domestic_proceeding_6 .

doc:article6_issue_7 a echr:Article6Issue ;
    echr:affectsParty doc:natural_person_1 ;
    echr:hasDelayAttribution echr:DelayUnattributed ;
    echr:hasSourceParagraph "46"^^xsd:string ;
    echr:hasSupportingQuote "On 27 April 2011 the doctor, nurse and duty officer who had examined the applicant upon his admission to the prison hospital on 27 August 2010 were questioned as part of the investigation into his allegations."^^xsd:string ;
    echr:issueArisesIn doc:domestic_proceeding_7 .

