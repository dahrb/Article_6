doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Criminal proceedings against the applicant"^^xsd:string ;
    echr:affectsParty doc:natural_person_1 ;
    echr:hasCourt doc:domestic_authority_1,
        "first-instance court" ;
    echr:hasDecisionDate "2011-04-27"^^echr:PartialDate ;
    echr:hasDelayAttribution echr:DelayUnattributed ;
    echr:hasInstanceLevel echr:InstanceLevelFirstInstance,
        echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeConvicted,
        echr:OutcomeUnknown ;
    echr:hasOutcomeDirection echr:DirectionUnknown ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasProceedingStartDate "2005-09-20"^^xsd:date,
        "2010-08-31"^^echr:PartialDate ;
    echr:hasProceedingType echr:ProceedingTypeCriminalTrial,
        echr:TypeCriminal ;
    echr:hasSourceParagraph "22"^^xsd:string,
        "40"^^xsd:string,
        "8"^^xsd:string ;
    echr:hasSupportingQuote "On 10 July 2005 a gun was seized from the applicant’s home."^^xsd:string,
        "On 31 August 2010 an investigation was opened into the applicant’s allegations."^^xsd:string,
        "On 8 December 2006 the court of first instance convicted the applicant of aggravated murder and the illegal acquisition, possession and carrying of firearms, and sentenced him to 17 years’ imprisonment."^^xsd:string,
        "The conviction in respect of aggravated murder was based on the witness statements given by the victim’s family and several other persons who relied on M.T.’s pre-trial statements."^^xsd:string,
        "The court also relied on forensic and other evidence concerning the various technical aspects of the murder and the applicant’s possession of firearms."^^xsd:string ;
    echr:isFinalDomesticDecision false ;
    echr:isPending false ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

doc:domestic_proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Trial at the first-instance court"^^xsd:string ;
    echr:affectsParty doc:natural_person_1 ;
    echr:followsProceeding doc:domestic_proceeding_1,
        doc:domestic_proceeding_3 ;
    echr:hasCourt doc:domestic_authority_2,
        "appellate court" ;
    echr:hasDecisionDate "2007-06-27"^^xsd:date,
        "2010-08-27"^^echr:PartialDate ;
    echr:hasDelayAttribution echr:DelayUnattributed ;
    echr:hasInstanceLevel echr:InstanceLevelAppellate,
        echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeUnknown,
        echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnknown ;
    echr:hasParticipation doc:participation_2 ;
    echr:hasProceedingStartDate "2006-07-17"^^xsd:date,
        "2006-12-08"^^xsd:date,
        "2010-08-25"^^echr:PartialDate ;
    echr:hasProceedingType echr:ProceedingTypeCriminalAppeal,
        echr:TypeCriminal ;
    echr:hasSourceParagraph "15"^^xsd:string,
        "24"^^xsd:string,
        "38"^^xsd:string ;
    echr:hasSupportingQuote "A.T. said that during the inspection M.T. had acted casually, and there had been nothing suspicious in his demeanour, with no sign of pressure being exerted on him."^^xsd:string,
        "As regards the applicant’s argument that M.T.’s statement had been obtained under duress and was inadmissible evidence, the court did not find it established on the facts that pressure had been applied."^^xsd:string,
        "As regards the applicant’s objection regarding the courts’ reliance on hearsay evidence, the appellate court found that the witness statements given by the victim’s wife, daughter and father were corroborated by M.T.’s pre-trial statements which in turn were not inadmissible evidence."^^xsd:string,
        "On 17 July 2006 and 21 August 2006, during the trial at the first ‑ instance court, M.T. and Z.T. changed their testimony."^^xsd:string,
        "On 25 and 26 August 2010 the applicant complained to the Chief Prosecutor that on 19 August 2010... he had been severely beaten..."^^xsd:string,
        "On 27 June 2007 the Tbilisi Court of Appeal upheld the applicant’s conviction."^^xsd:string,
        "The appellate court reheard A.T., who had witnessed the inspection of the crime scene on 20 September 2005 (see paragraph 19 above)."^^xsd:string,
        "The applicant appealed, arguing that there was insufficient evidence to convict him."^^xsd:string ;
    echr:isFinalDomesticDecision false,
        true ;
    echr:isPending false ;
    echr:raisesArticle6Issue doc:article6_issue_2 .

