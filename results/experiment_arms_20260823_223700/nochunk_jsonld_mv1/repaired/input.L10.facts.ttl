doc:proceeding_11 a echr:DomesticProceeding ;
    rdfs:label "Court of Appeal Judgment 30 June 2017"@en ;
    echr:followsProceeding doc:proceeding_9 ;
    echr:hasCourt doc:courtAppealBrussels ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "By a judgment of 30 June 2017 a Dutch-language division of the Court of Appeal held that the Aliens Appeals Boards’ judgment of 20 October 2016 was no longer operative"@en .

doc:proceeding_12 a echr:DomesticProceeding ;
    rdfs:label "Conseil d'État Judgment 17 May 2018"@en ;
    echr:followsProceeding doc:proceeding_10 ;
    echr:hasCourt doc:conseilEtat ;
    echr:hasDecisionDate "2018-05-17"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "An administrative appeal on points of law lodged by the applicants against that judgment was dismissed by the Conseil d’État on 17 May 2018"@en ;
    echr:isFinalDomesticDecision true .

doc:applicantCouple a echr:NaturalPerson,
