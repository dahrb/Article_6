    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "On 7 November 2016 another judge... declared their application admissible but unfounded"@en .

doc:proceeding_9 a echr:DomesticProceeding ;
