    echr:participatingParty doc:applicantCouple .

doc:proceeding_1 a echr:AdministrativeAction ;
    rdfs:label "Visa Refusal Decision 13 Sept 2016"@en ;
    echr:hasCourt doc:aliensOffice ;
    echr:hasDecisionDate "2016-09-13"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_1_app,
        doc:part_1_state ;
    echr:hasSupportingQuote "On 13 September 2016 the Aliens Office... refused to grant “humanitarian visas” to the applicants"@en .

doc:proceeding_10 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board Final Judgment 24 Mar 2017"@en ;
    echr:followsProceeding doc:proceeding_6 ;
    echr:hasCourt doc:aliensAppealsBoard ;
