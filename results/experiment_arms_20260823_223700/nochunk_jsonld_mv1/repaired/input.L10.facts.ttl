    rdfs:label "Conseil d’État"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Conseil d’État"@en .

doc:lawyerLambert a echr:LegalRepresentative ;
    rdfs:label "Ms L. Lambert"@en .

doc:lawyerStein a echr:LegalRepresentative ;
    rdfs:label "Mr O. Stein"@en .

