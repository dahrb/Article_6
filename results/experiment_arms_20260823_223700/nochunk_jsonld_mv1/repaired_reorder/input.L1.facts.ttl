@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/eceae272316f/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/eceae272316f> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:1"^^xsd:string .

doc:adminGuardianAppointment a echr:AdministrativeAction ;
    rdfs:label "Appointment of guardian by Ruse Municipal Council"@en ;
    echr:hasCourt doc:councilRuseMunicipal ;
    echr:hasDecisionDate "2002-05-23"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "on 23 May 2002 the Municipal Council appointed Ms R.P., a council officer, as the applicant’s guardian"@en .

doc:adminPlacementHome a echr:AdministrativeAction ;
    rdfs:label "Placement in Pastra social care home"@en ;
    echr:hasDecisionDate "2002-12-10"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "On 10 December 2002 a welfare-placement agreement was signed between R.P. and the social care home"@en .

doc:caseStanevBulgaria a echr:CaseDocument ;
    echr:hasApplicant doc:applicantStanev ;
    echr:hasApplicationNumber "36760/06"@en ;
    echr:hasCaseName "Stanev v. Bulgaria"@en ;
    echr:hasDomesticProceeding doc:proceedingAppealIncapacity,
        doc:proceedingIncapacityRuse,
        doc:proceedingReviewMayor ;
    echr:hasRespondentState "Republic of Bulgaria"@en .

doc:prosecutorialReviewCapacity a echr:ProsecutorialReview ;
    rdfs:label "Regional Prosecutor review of capacity restoration"@en ;
    echr:hasCourt doc:prosecutorRegionalRuse ;
    echr:hasDecisionDate "2005-08-10"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "On 10 August 2005 the regional prosecutor refused to bring an action for restoration of the applicant’s legal capacity"@en .

doc:councilRuseMunicipal a echr:DomesticAuthority ;
    rdfs:label "Ruse Municipal Council"@en ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "Ruse Municipal Council"^^xsd:string .

doc:courtDupnitsaDistrict a echr:DomesticAuthority ;
    rdfs:label "Dupnitsa District Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Dupnitsa District Court"^^xsd:string .

doc:courtRuseRegional a echr:DomesticAuthority ;
    rdfs:label "Ruse Regional Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Ruse Regional Court"@en ;
    echr:hasJurisdictionState "Bulgaria"@en .

doc:courtVelikoTarnovoAppeal a echr:DomesticAuthority ;
    rdfs:label "Veliko Tarnovo Court of Appeal"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Veliko Tarnovo Court of Appeal"@en .

doc:lawyerGenova a echr:LegalRepresentative ;
    rdfs:label "Ms A. Genova"@en ;
    echr:hasPersonName "Ms A. Genova"@en .

doc:mayorRila a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Mayor of Rila"@en ;
    echr:hasAuthorityName "Mayor of Rila"^^xsd:string .

doc:partMayorRilaDupnitsa a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:mayorRila .

doc:partProsecutorRuse a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:prosecutorRuseRegional .

doc:partStanevAppeal a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicantStanev .

doc:partStanevDupnitsa a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicantStanev .

doc:partStanevRuse a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:applicantStanev .

doc:proceedingAppealIncapacity a echr:DomesticProceeding ;
    rdfs:label "Veliko Tarnovo Court of Appeal proceeding"@en ;
    echr:followsProceeding doc:proceedingIncapacityRuse ;
    echr:hasCourt doc:courtVelikoTarnovoAppeal ;
    echr:hasDecisionDate "2001-04-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partStanevAppeal ;
    echr:hasSupportingQuote "That judgment was upheld in a judgment of 12 April 2001 by the Veliko Tarnovo Court of Appeal"@en .

doc:proceedingReviewMayor a echr:DomesticProceeding ;
    rdfs:label "Dupnitsa District Court review of mayor's decision"@en ;
    echr:hasCourt doc:courtDupnitsaDistrict ;
    echr:hasDecisionDate "2006-03-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partMayorRilaDupnitsa,
        doc:partStanevDupnitsa ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "The Dupnitsa District Court gave judgment on 10 March 2006... the court dismissed the application"@en .

doc:prosecutorRegionalRuse a echr:DomesticAuthority ;
    rdfs:label "Regional Prosecutor"@en ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Regional Prosecutor"^^xsd:string .

doc:prosecutorRuseRegional a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Ruse regional prosecutor"@en ;
    echr:hasAuthorityName "Ruse regional prosecutor"^^xsd:string .

doc:proceedingIncapacityRuse a echr:DomesticProceeding ;
    rdfs:label "Ruse Regional Court incapacity proceeding"@en ;
    echr:hasCourt doc:courtRuseRegional ;
    echr:hasDecisionDate "2000-11-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partProsecutorRuse,
        doc:partStanevRuse ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasStatusApplied echr:StatusPartialIncapacity ;
    echr:hasSupportingQuote "In a judgment of 20 November 2000, the court declared the applicant to be partially incapacitated"@en .

doc:applicantStanev a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Mr Rusi Kosev Stanev"@en ;
    echr:hasPersonName "Mr Rusi Kosev Stanev"@en ;
    echr:isRepresentedBy doc:lawyerGenova .

