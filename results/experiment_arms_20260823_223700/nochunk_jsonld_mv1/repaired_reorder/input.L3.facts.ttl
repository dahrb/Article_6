doc:proceedingSaleAppeal a echr:DomesticProceeding ;
    rdfs:label "Appeal of sale annulment dismissal"@en ;
    echr:followsProceeding doc:proceeding_sale_1 ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2014-12-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "On an appeal by the applicant, the 13th Chamber of the Supreme Administrative Court upheld that decision on 9 December 2014."@en .

doc:proceedingSaleRectification a echr:DomesticProceeding ;
    rdfs:label "Request for rectification of sale judgment"@en ;
    echr:followsProceeding doc:proceedingSaleAppeal ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasSupportingQuote "On 30 June 2017, the 13 th Chamber of the Supreme Administrative Court granted the request... and annulled the sale in question."@en .

doc:proceeding_sale_1 a echr:DomesticProceeding ;
    rdfs:label "Proceeding to annul the sale of Viva TV-Radio Viva"@en ;
    echr:hasCourt doc:istanbulAdminCourt ;
