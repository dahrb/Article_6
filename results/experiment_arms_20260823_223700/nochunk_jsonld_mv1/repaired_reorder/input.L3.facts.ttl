<https://growgraph.dev/doc/6cb3461d1cd1> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:3"^^xsd:string .

doc:case_58919_18 a echr:CaseDocument ;
    echr:hasApplicant doc:erolAksoy ;
    echr:hasApplicationNumber "58919/18"@en ;
    echr:hasCaseName "Erol Aksoy v. Türkiye"@en ;
    echr:hasDomesticProceeding doc:proceeding_sale_1,
        doc:proceeding_valuation_1 ;
    echr:hasRespondentState "Türkiye"@en .

doc:proceedingConstCourt a echr:DomesticProceeding ;
    rdfs:label "Individual application to Constitutional Court"@en ;
    echr:followsProceeding doc:proceedingSaleRectification ;
    echr:hasCourt doc:constitutionalCourt ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2017-09-11"^^xsd:date ;
    echr:hasSupportingQuote "In a decision of 23 May 2018, the Constitutional Court... declared the application inadmissible."@en ;
    echr:isFinalDomesticDecision true .

doc:proceedingValuationAppeal a echr:DomesticProceeding ;
    rdfs:label "Appeal of valuation decision to General Assembly"@en ;
    echr:followsProceeding doc:proceeding_valuation_1 ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2015-07-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:partAppAksoy,
        doc:partAppFund ;
    echr:hasSupportingQuote "On 7 July 2015, following an appeal by the applicant, the General Assembly... annulled the Fund’s decision."@en .

doc:constitutionalCourt a echr:DomesticAuthority ;
    rdfs:label "Constitutional Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Constitutional Court"@en ;
    echr:hasJurisdictionState "Türkiye"@en .

