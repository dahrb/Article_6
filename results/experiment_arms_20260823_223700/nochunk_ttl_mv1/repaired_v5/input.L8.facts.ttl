@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/2e9688b7249b> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:8"^^xsd:string .

doc:admin_action_1 a echr:AdministrativeAction ;
    rdfs:label "Election Invalidation"^^xsd:string ;
    echr:hasCourt doc:electoralCommittee ;
    echr:hasDecisionDate "1998-04-01"^^xsd:date ;
    echr:hasSupportingQuote "On 1 April 1998 the local electoral committee declared the elections invalid"^^xsd:string .

doc:admin_action_3 a echr:AdministrativeAction ;
    rdfs:label "Asset Unfreeze and Transfer"^^xsd:string ;
    echr:followsProceeding doc:admin_action_2 ;
    echr:hasCourt doc:prosecutorNn ;
    echr:hasDecisionDate "1996-05-18"^^xsd:date ;
    echr:hasSupportingQuote "On 18 May 1996 the Nizhniy Novgorod prosecutor’s office unfroze the account and transferred the money to the yard"^^xsd:string .

doc:case_46503_99 a echr:CaseDocument ;
    echr:hasApplicant doc:klimentyev ;
    echr:hasApplicationNumber "46503/99"^^xsd:string ;
    echr:hasCaseName "Andrey Anatolyevitch KLIMENTYEV against Russia"^^xsd:string ;
    echr:hasDomesticProceeding doc:appeal_1,
        doc:appeal_2,
        doc:trial_1,
        doc:trial_2 ;
    echr:hasRespondentState "Russia"^^xsd:string .

doc:detention_1 a echr:PreTrialDetention ;
    echr:hasCustodialMeasure echr:MeasureRemandInCustody ;
    echr:hasDetainee doc:klimentyev ;
    echr:hasDetentionEndDate "1997-04-21"^^xsd:date ;
    echr:hasSupportingQuote "the time he had already spent in pre-trial detention"^^xsd:string .

doc:admin_action_2 a echr:AdministrativeAction ;
    rdfs:label "Asset Freeze"^^xsd:string ;
    echr:hasCourt doc:prosecutorNn ;
    echr:hasDecisionDate "1995-10-05"^^xsd:date ;
    echr:hasSupportingQuote "on 5 October 1995 property belonging to the applicant... was frozen on the order of the Nizhniy Novgorod prosecutor’s office"^^xsd:string,
        "provided for the purchase by the Port of the Stavanger for 2.5 million US dollars" .

doc:appeal_2 a echr:DomesticProceeding ;
    rdfs:label "Second Appeal (Supreme Court)"^^xsd:string ;
    echr:followsProceeding doc:trial_2 ;
    echr:hasCourt doc:courtSupremeRu ;
    echr:hasDecisionDate "1998-08-10"^^xsd:date ;
    echr:hasExtractionNote "Mrs Moskalenko requested an adjournment to study the case materials (more than 100 volumes)."^^xsd:string ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_4 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 10 August 1998 the Supreme Court confirmed the judgment of the Nizhniy Novgorod Regional Court"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:detention_2 a echr:PreTrialDetention ;
    echr:hasCustodialMeasure echr:MeasureRemandInCustody ;
    echr:hasDetainee doc:klimentyev ;
    echr:hasDetentionEndDate "2000-10"^^xsd:gYearMonth ;
    echr:hasDetentionStartDate "1998-04-02"^^xsd:date ;
    echr:hasSupportingQuote "On 2 April 1998 the Nizhniy Novgorod Regional Court granted the prosecutor’s renewed motion for detention... In October 2000 the applicant was released from detention"^^xsd:string .

doc:electoralCommittee a echr:DomesticAuthority ;
    rdfs:label "local electoral committee"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "local electoral committee"^^xsd:string .

doc:lawyerBaum a echr:LegalRepresentative ;
    rdfs:label "Mr Gerhart R. Baum"^^xsd:string ;
    echr:hasGender echr:GenderMale ;
    echr:hasPersonName "Mr Gerhart R. Baum"^^xsd:string .

doc:lawyerK a echr:LegalRepresentative ;
    rdfs:label "Mr. K."^^xsd:string ;
    echr:hasGender echr:GenderMale ;
    echr:hasPersonName "Mr. K."^^xsd:string .

doc:lawyerMoskalenko a echr:LegalRepresentative ;
    rdfs:label "Mrs Moskalenko"^^xsd:string ;
    echr:hasGender echr:GenderFemale ;
    echr:hasPersonName "Mrs Moskalenko"^^xsd:string .

doc:lawyerO a echr:LegalRepresentative ;
    rdfs:label "Mr. O."^^xsd:string ;
    echr:hasGender echr:GenderMale ;
    echr:hasPersonName "Mr. O."^^xsd:string .

doc:part_1 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:klimentyev .

doc:part_2 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:klimentyev .

doc:part_3 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:klimentyev .

doc:part_4 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:klimentyev .

doc:appeal_1 a echr:DomesticProceeding ;
    rdfs:label "First Appeal (Supreme Court)"^^xsd:string ;
    echr:followsProceeding doc:trial_1 ;
    echr:hasCourt doc:courtSupremeRu ;
    echr:hasDecisionDate "1997-07"^^xsd:gYearMonth ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_2 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "In July 1997 the Supreme Court quashed the conviction on the applicant’s appeal and remitted the case to the Nizhniy Novgorod Regional Court"^^xsd:string .

doc:courtRegionalNn a echr:DomesticAuthority ;
    rdfs:label "Nizhniy Novgorod Regional Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Nizhniy Novgorod Regional Court"^^xsd:string ;
    echr:hasJurisdictionState "Russia"^^xsd:string .

doc:courtSupremeRu a echr:DomesticAuthority ;
    rdfs:label "Supreme Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Supreme Court"^^xsd:string ;
    echr:hasJurisdictionState "Russia"^^xsd:string .

doc:prosecutorNn a echr:DomesticAuthority ;
    rdfs:label "Nizhniy Novgorod prosecutor's office"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Nizhniy Novgorod prosecutor's office"^^xsd:string ;
    echr:hasJurisdictionState "Russia"^^xsd:string .

doc:trial_1 a echr:DomesticProceeding ;
    rdfs:label "First Trial (Nizhniy Novgorod Regional Court)"^^xsd:string ;
    echr:hasCourt doc:courtRegionalNn ;
    echr:hasDecisionDate "1997-04-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_1 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 21 April 1997 the Nizhniy Novgorod Regional Court found the applicant guilty on some of the charges"^^xsd:string .

doc:trial_2 a echr:DomesticProceeding ;
    rdfs:label "Second Trial (Nizhniy Novgorod Regional Court)"^^xsd:string ;
    echr:followsProceeding doc:appeal_1 ;
    echr:hasCourt doc:courtRegionalNn ;
    echr:hasDecisionDate "1998-05-27"^^xsd:date ;
    echr:hasExtractionNote "The trial record consisted of two volumes, while the verbatim record ran to 15 volumes."^^xsd:string ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_3 ;
    echr:hasPreTrialDetention doc:detention_2 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "In total, the Regional Court heard more then 35 witnesses during the trial."^^xsd:string,
        "On 27 May 1998 the Nizhniy Novgorod Regional Court found the applicant guilty on charges of misappropriation and embezzlement"^^xsd:string,
        "the court sentenced him to six years in prison"^^xsd:string .

doc:klimentyev a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Andrey Anatolyevich Klimentyev"^^xsd:string ;
    echr:hasPersonName "Andrey Anatolyevich Klimentyev"^^xsd:string ;
    echr:isRepresentedBy doc:lawyerBaum,
        doc:lawyerK,
        doc:lawyerMoskalenko,
        doc:lawyerO .

