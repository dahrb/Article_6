    echr:hasApplicationNumber "18720/08"^^xsd:string ;
    echr:hasCaseName "Malkhaz BADUASHVILI against Georgia"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceeding_1 ;
    echr:hasRespondentState "Georgia"^^xsd:string .

doc:detention_1 a echr:PreTrialDetention ;
    rdfs:label "Pre-trial detention of Malkhaz Baduashvili"^^xsd:string ;
    echr:hasCustodialMeasure echr:MeasureRemandInCustody ;
    echr:hasDetainee doc:applicant_1 ;
    echr:hasDetentionStartDate "2005-07-27"^^xsd:date ;
    echr:hasSupportingQuote "He was arrested and remanded in custody on 27 July 2005"^^xsd:string .

doc:investigating_authority_1 a echr:DomesticAuthority ;
    rdfs:label "Investigating Authorities"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "investigating authorities"^^xsd:string ;
    echr:hasJurisdictionState "Georgia"^^xsd:string .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "Cassation appeal"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:courtSupreme ;
    echr:hasDecisionDate "2008-02-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_3_app ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 20 February 2008 the Supreme Court declared an appeal on points of law lodged by the applicant inadmissible"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:review_1 a echr:ProsecutorialReview ;
