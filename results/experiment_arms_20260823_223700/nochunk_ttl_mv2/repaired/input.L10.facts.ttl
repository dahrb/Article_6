doc:proceedingEnforcementJudge a echr:DomesticProceeding ;
    rdfs:label "Enforcement judge decision 20 December 2017"^^xsd:string ;
    echr:hasDecisionDate "2017-12-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 20 December 2017 the French-language enforcement judge... found that the case had become devoid of purpose"^^xsd:string .

doc:proceeding_appeal_brussels_2 a echr:DomesticProceeding ;
    rdfs:label "Brussels Court of Appeal judgment 30 June 2017"^^xsd:string ;
    echr:followsProceeding doc:proceeding_appeal_brussels_1 ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "By a judgment of 30 June 2017 a Dutch-language division of the Court of Appeal held that the Aliens Appeals Boards’ judgment of 20 October 2016 was no longer operative"^^xsd:string .

doc:proceeding_cassation_1 a echr:DomesticProceeding ;
    rdfs:label "Conseil d'Etat appeal 17 May 2018"^^xsd:string ;
    echr:followsProceeding doc:proceeding_set_aside_1 ;
