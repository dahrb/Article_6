    rdfs:label "Mr Erol Aksoy"^^xsd:string ;
    echr:hasPersonName "Mr Erol Aksoy"^^xsd:string ;
    echr:isRepresentedBy doc:nHolliger .

doc:partValAppAksoy a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:erolAksoy .

doc:partValAppFund a echr:Participation ;
