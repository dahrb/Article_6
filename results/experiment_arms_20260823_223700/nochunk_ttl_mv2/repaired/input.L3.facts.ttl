<https://growgraph.dev/doc/6cb3461d1cd1> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:3"^^xsd:string .

doc:admin_decision_award_2012 a echr:AdministrativeAction ;
    rdfs:label "Fund approval of award to company A"^^xsd:string ;
    echr:hasCourt doc:fund ;
    echr:hasDecisionDate "2012-05-03"^^xsd:date ;
    echr:hasSupportingQuote "On 3 May 2012, the Fund approved the award of Viva TV-Radio Viva to company A. for the price of USD 5,000,000."^^xsd:string .

doc:admin_decision_valuation_2011 a echr:AdministrativeAction ;
    rdfs:label "Fund decision on valuation and tender invitation"^^xsd:string ;
    echr:hasCourt doc:fund ;
    echr:hasDecisionDate "2011-01-13"^^xsd:date ;
    echr:hasSupportingQuote "On 13 January 2011, the Fund decided to offer Viva TV-Radio Viva for sale again, setting the reserve price at USD 6,000,000."^^xsd:string .

doc:admin_refusal_enforcement_1 a echr:AdministrativeAction ;
    rdfs:label "Fund refusal to enforce valuation judgment"^^xsd:string ;
    echr:hasCourt doc:fund ;
    echr:hasDecisionDate "2015-10-27"^^xsd:date ;
    echr:hasSupportingQuote "the Fund notified the applicant of a decision taken on 27 October 2015 regarding the impossibility of enforcing the judgment."^^xsd:string .

doc:admin_refusal_enforcement_2 a echr:AdministrativeAction ;
    rdfs:label "Fund refusal to enforce sale annulment judgment"^^xsd:string ;
    echr:hasCourt doc:fund ;
    echr:hasDecisionDate "2017-08-11"^^xsd:date ;
    echr:hasSupportingQuote "a decision had already been made on 11 August 2017 regarding the enforcement of the relevant judgment."^^xsd:string .

doc:case_58919_18 a echr:CaseDocument ;
    echr:hasApplicant doc:erolAksoy ;
    echr:hasApplicationNumber "58919/18"^^xsd:string ;
    echr:hasCaseName "Erol Aksoy v. Türkiye"^^xsd:string ;
    echr:hasDomesticProceeding doc:constitutionalApplication,
        doc:proceedingSaleAnnulmentAppeal,
        doc:proceedingSaleAnnulmentRectification,
        doc:proceedingValuationAppeal,
        doc:proceedingValuationRectification,
        doc:proceeding_sale_annulment_1,
        doc:proceeding_valuation_1 ;
    echr:hasRespondentState "Türkiye"^^xsd:string .

doc:constitutionalApplication a echr:DomesticProceeding ;
    rdfs:label "Individual application to Constitutional Court"^^xsd:string ;
    echr:followsProceeding doc:proceedingSaleAnnulmentRectification ;
    echr:hasCourt doc:constitutionalCourt ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelSupervisoryReview ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partConstAksoy,
        doc:partConstFund ;
    echr:hasProceedingStartDate "2017-09-11"^^xsd:date ;
    echr:hasProceedingType echr:TypeConstitutional ;
    echr:hasSupportingQuote "On 11 September 2017, the applicant lodged an individual application with the Constitutional Court... the Constitutional Court declared the application inadmissible."^^xsd:string .

doc:constitutionalCourt a echr:DomesticAuthority ;
    rdfs:label "Constitutional Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Constitutional Court"^^xsd:string .

doc:istanbulAdminCourt a echr:DomesticAuthority ;
    rdfs:label "İstanbul Administrative Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "İstanbul Administrative Court"^^xsd:string .

doc:nHolliger a echr:LegalRepresentative ;
    rdfs:label "Ms N. Holliger"^^xsd:string ;
    echr:hasPersonName "Ms N. Holliger"^^xsd:string .

doc:partConstAksoy a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:erolAksoy .

doc:partConstFund a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:fund .

doc:partValRectAksoy a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:erolAksoy .

doc:partValRectFund a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:fund .

doc:proceedingValuationRectification a echr:DomesticProceeding ;
    rdfs:label "Rectification request on valuation"^^xsd:string ;
    echr:followsProceeding doc:proceedingValuationAppeal ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2016-01-25"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:partValRectAksoy,
        doc:partValRectFund ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 25 January 2016, the Supreme Administrative Court rejected the Fund’s request for rectification"^^xsd:string .

doc:proceedingSaleAnnulmentAppeal a echr:DomesticProceeding ;
    rdfs:label "Appeal of sale annulment"^^xsd:string ;
    echr:followsProceeding doc:proceeding_sale_annulment_1 ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2014-12-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partValAppAksoy,
        doc:partValAppFund ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On an appeal by the applicant, the 13th Chamber of the Supreme Administrative Court upheld that decision on 9 December 2014."^^xsd:string .

doc:proceedingSaleAnnulmentRectification a echr:DomesticProceeding ;
    rdfs:label "Rectification of sale annulment"^^xsd:string ;
    echr:followsProceeding doc:proceedingSaleAnnulmentAppeal,
        doc:proceedingValuationAppeal ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:partValAppAksoy,
        doc:partValAppFund ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 30 June 2017, the 13 th Chamber of the Supreme Administrative Court granted the request... and annulled the sale in question."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:proceeding_sale_annulment_1 a echr:DomesticProceeding ;
    rdfs:label "Proceeding to annul sale of Viva TV-Radio Viva"^^xsd:string ;
    echr:hasCourt doc:istanbulAdminCourt ;
    echr:hasDecisionDate "2014-03-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partValAppAksoy,
        doc:partValAppFund ;
    echr:hasProceedingStartDate "2011-02-24"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 24 February 2011, the applicant initiated proceedings before the administrative court, seeking the annulment of the sale of Viva TV-Radio Viva."^^xsd:string .

doc:proceeding_valuation_1 a echr:DomesticProceeding ;
    rdfs:label "Proceeding to annul valuation decision"^^xsd:string ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2014-12-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partValAppAksoy,
        doc:partValAppFund ;
    echr:hasProceedingStartDate "2011-02-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 7 February 2011, the applicant initiated proceedings before the administrative court, contesting the actions of the Fund concerning the tendering of Viva TV-Radio Viva"^^xsd:string .

doc:proceedingValuationAppeal a echr:DomesticProceeding ;
    rdfs:label "Appeal of valuation decision"^^xsd:string ;
    echr:followsProceeding doc:proceeding_valuation_1 ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2015-07-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:partValAppAksoy,
        doc:partValAppFund ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 7 July 2015, following an appeal by the applicant, the General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court... annulled the Fund’s decision."^^xsd:string .

doc:erolAksoy a echr:NaturalPerson,
