@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/2e9688b7249b/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/2e9688b7249b> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:8"^^xsd:string .

doc:adminActionElection a echr:AdministrativeAction ;
    rdfs:label "Invalidation of mayoral election"^^xsd:string ;
    echr:hasDecisionDate "1998-04-01"^^xsd:date ;
    echr:hasSupportingQuote "On 1 April 1998 the local electoral committee declared the elections invalid"^^xsd:string .

doc:admin_action_1 a echr:AdministrativeAction ;
    rdfs:label "Freezing of Stavanger ship"^^xsd:string ;
    echr:hasCourt doc:prosecutorNizhnijNovgorod ;
    echr:hasDecisionDate "1995-10-05"^^xsd:date ;
    echr:hasExtractionNote "Ship purchase price: 2.5 million US dollars."^^xsd:string ;
    echr:hasParticipation doc:part_admin1_pros ;
    echr:hasSupportingQuote "on 5 October 1995 property belonging to the applicant - the ship Stavanger and a floating drydock - was frozen on the order of the Nizhniy Novgorod prosecutor’s office"^^xsd:string .

doc:case_46503_99 a echr:CaseDocument ;
    echr:hasApplicant doc:klimentyev ;
    echr:hasApplicationNumber "46503/99"^^xsd:string ;
    echr:hasCaseName "Andrey Anatolyevitch KLIMENTYEV against Russia"^^xsd:string ;
    echr:hasDomesticProceeding doc:appeal_1,
        doc:appeal_2,
        doc:detention_appeal_1,
        doc:trial_1,
        doc:trial_2 ;
    echr:hasRespondentState "Russia"^^xsd:string .

doc:charge_event_1 a echr:DomesticEvent ;
    rdfs:label "Initial charges against Klimentyev"^^xsd:string ;
    echr:hasDecisionDate "1995-03-07"^^xsd:date ;
    echr:hasSupportingQuote "The applicant, together with another person, was charged with embezzlement and other economic crimes on 7 March 1995."^^xsd:string .

doc:detention_motion_1 a echr:DomesticProceeding ;
    rdfs:label "First detention motion during second trial"^^xsd:string ;
    echr:hasCourt doc:courtNizhnijNovgorod ;
    echr:hasDecisionDate "1998-03-30"^^xsd:date ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasSupportingQuote "On 30 March 1998, during the new trial, the prosecutor applied to the court to detain the applicant... The Regional Court rejected the motion as unsubstantiated."^^xsd:string .

doc:appeal_2 a echr:DomesticProceeding ;
    rdfs:label "Second appeal to Supreme Court"^^xsd:string ;
    echr:followsProceeding doc:trial_2 ;
    echr:hasCourt doc:courtSupreme ;
    echr:hasDecisionDate "1998-08-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_appeal1_app ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 10 August 1998 the Supreme Court confirmed the judgment of the Nizhniy Novgorod Regional Court"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:detention_1 a echr:PreTrialDetention ;
    rdfs:label "Detention during second trial"^^xsd:string ;
    echr:hasCustodialMeasure echr:MeasureRemandInCustody ;
    echr:hasDetainee doc:klimentyev ;
    echr:hasDetentionEndDate "2000-10"^^xsd:gYearMonth ;
    echr:hasDetentionStartDate "1998-04-02"^^xsd:date ;
    echr:hasSupportingQuote "On 2 April 1998 the Nizhniy Novgorod Regional Court granted the prosecutor’s renewed motion for detention... and the applicant was arrested"^^xsd:string .

doc:detention_appeal_1 a echr:DomesticProceeding ;
    rdfs:label "Appeal against detention order"^^xsd:string ;
    echr:followsProceeding doc:trial_2 ;
    echr:hasCourt doc:courtSupreme ;
    echr:hasDecisionDate "1998-05-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partDetAppApp ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "The reply from the Supreme Court, dated 19 May 1998, stated that the national law did not allow appeals against that type of trial court orders separately"^^xsd:string .

doc:lawyerBaum a echr:LegalRepresentative ;
    rdfs:label "Mr Gerhart R. Baum"^^xsd:string ;
    echr:hasPersonName "Mr Gerhart R. Baum"^^xsd:string .

doc:lawyerK a echr:LegalRepresentative ;
    rdfs:label "Mr. K."^^xsd:string ;
    echr:hasPersonName "Mr. K."^^xsd:string .

doc:lawyerMoskalenko a echr:LegalRepresentative ;
    rdfs:label "Mrs Moskalenko"^^xsd:string ;
    echr:hasPersonName "Mrs Moskalenko"^^xsd:string .

doc:lawyerO a echr:LegalRepresentative ;
    rdfs:label "Mr. O."^^xsd:string ;
    echr:hasPersonName "Mr. O."^^xsd:string .

doc:partDetAppApp a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:klimentyev .

doc:part_admin1_pros a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:prosecutorNizhnijNovgorod .

doc:appeal_1 a echr:DomesticProceeding ;
    rdfs:label "First appeal to Supreme Court"^^xsd:string ;
    echr:followsProceeding doc:trial_1 ;
    echr:hasCourt doc:courtSupreme ;
    echr:hasDecisionDate "1997-07"^^xsd:gYearMonth ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_appeal1_app ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "In July 1997 the Supreme Court quashed the conviction on the applicant’s appeal and remitted the case to the Nizhniy Novgorod Regional Court"^^xsd:string .

doc:part_appeal1_app a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:klimentyev .

doc:part_trial1_app a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:klimentyev .

doc:part_trial1_pros a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:prosecutorNizhnijNovgorod .

doc:trial_1 a echr:DomesticProceeding ;
    rdfs:label "First trial of Klimentyev"^^xsd:string ;
    echr:hasCourt doc:courtNizhnijNovgorod ;
    echr:hasDecisionDate "1997-04-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_trial1_app,
        doc:part_trial1_pros ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 21 April 1997 the Nizhniy Novgorod Regional Court found the applicant guilty on some of the charges"^^xsd:string .

doc:courtNizhnijNovgorod a echr:DomesticAuthority ;
    rdfs:label "Nizhniy Novgorod Regional Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Nizhniy Novgorod Regional Court"^^xsd:string ;
    echr:hasJurisdictionState "Russia"^^xsd:string .

doc:courtSupreme a echr:DomesticAuthority ;
    rdfs:label "Supreme Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Supreme Court"^^xsd:string ;
    echr:hasJurisdictionState "Russia"^^xsd:string .

doc:prosecutorNizhnijNovgorod a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Nizhniy Novgorod prosecutor's office"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Nizhniy Novgorod prosecutor's office"^^xsd:string ;
    echr:hasJurisdictionState "Russia"^^xsd:string .

doc:trial_2 a echr:DomesticProceeding ;
    rdfs:label "Second trial of Klimentyev"^^xsd:string ;
    echr:followsProceeding doc:appeal_1 ;
    echr:hasCourt doc:courtNizhnijNovgorod ;
    echr:hasDecisionDate "1998-05-27"^^xsd:date ;
    echr:hasExtractionNote "Sentenced to six years in prison."^^xsd:string ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_trial1_app,
        doc:part_trial1_pros ;
    echr:hasPreTrialDetention doc:detention_1 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 27 May 1998 the Nizhniy Novgorod Regional Court found the applicant guilty on charges of misappropriation and embezzlement"^^xsd:string .

doc:klimentyev a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Andrey Anatolyevich Klimentyev"^^xsd:string ;
    echr:hasPersonName "Andrey Anatolyevich Klimentyev"^^xsd:string ;
    echr:isRepresentedBy doc:lawyerBaum,
        doc:lawyerK,
        doc:lawyerMoskalenko,
        doc:lawyerO .

