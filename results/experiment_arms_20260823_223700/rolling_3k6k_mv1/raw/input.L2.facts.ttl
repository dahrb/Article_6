doc:proceedingFederalLabourCourt a echr:DomesticProceeding ;
    rdfs:label "Proceedings before the Federal Labour Court"^^xsd:string ;
    echr:followsProceeding doc:proceedingEsaStatus ;
    echr:hasCourt doc:federalLabourCourtGermany ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationBeerFlc,
        doc:participationEsaFlc,
        doc:participationReganFlc ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "in giving effect to the immunity from jurisdiction of ESA on the basis of section 20(2) of the Courts Act, the German courts did not exceed their margin of appreciation"^^xsd:string,
        "the reasons advanced by the German labour courts to give effect to the immunity from jurisdiction of ESA"^^xsd:string .

doc:temporaryStaffActProceeding a echr:DomesticProceeding ;
    rdfs:label "Potential proceedings under the German Provision of Labour (Temporary Staff) Act"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "Relying on general labour regulations or, more particularly, on the German Provision of Labour (Temporary Staff) Act, temporary workers can file claims in damages against such firms"^^xsd:string .

doc:appealsBoardEsa a echr:DomesticAuthority ;
    rdfs:label "Appeals Board of the Agency"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasSupportingQuote "There shall be set up an Appeals Board, independent of the Agency"^^xsd:string .

