doc:agreementBeer a echr:AdministrativeAction ;
    rdfs:label "Employment termination agreement with Mr Beer"^^xsd:string ;
    echr:hasDecisionDate "1995-06-20"^^xsd:date ;
    echr:hasSupportingQuote "an agreement concluded on 20 June 1995 with the first applicant, terminating his contract of employment on 30 June 1995"^^xsd:string .

doc:case_28934_95 a echr:CaseDocument ;
    rdfs:label "Beer and Regan v. Germany"^^xsd:string ;
    echr:hasApplicant doc:karlheinzBeer,
        doc:philipRegan ;
    echr:hasApplicationNumber "28934/95"^^xsd:string ;
    echr:hasCaseName "Beer and Regan v. Germany"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceedingDismissalBeer,
        doc:proceedingDismissalTi,
        doc:proceedingEsaStatus ;
    echr:hasJudgmentDate "1999-02-18"^^xsd:date ;
    echr:hasRespondentState "Federal Republic of Germany"^^xsd:string .

doc:companyS a echr:Party ;
    rdfs:label "S."^^xsd:string ;
    echr:hasSupportingQuote "the French company S."^^xsd:string .

doc:esaAppealsBoardProceeding a echr:DomesticProceeding ;
    rdfs:label "Potential proceedings before the ESA Appeals Board"^^xsd:string ;
    echr:hasCourt doc:appealsBoardEsa ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "the remedies available to the applicants were in particular an appeal to the ESA Appeals Board if they wished to assert contractual rights"^^xsd:string .

doc:esoc a echr:DomesticAuthority ;
    rdfs:label "European Space Operations Centre"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasSupportingQuote "establishing a European Space Operations Centre"^^xsd:string .

