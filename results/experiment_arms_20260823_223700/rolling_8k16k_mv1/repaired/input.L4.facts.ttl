    echr:hasProceedingStartDate "1997-05-12"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 12 May 1997 the Public Prosecutor appealed against this decision. On 4 December 1997 the Maribor Higher Court upheld her appeal"^^xsd:string .

doc:appeal_trial_1 a echr:DomesticProceeding ;
    rdfs:label "appeal against acquittal"^^xsd:string ;
    echr:followsProceeding doc:trial_matko_1 ;
    echr:hasCourt doc:mariborHigherCourt ;
