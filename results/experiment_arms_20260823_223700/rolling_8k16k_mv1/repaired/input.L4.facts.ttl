    echr:hasProceedingStartDate "2000-01-05"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 5 January 2000 the Public Prosecutor appealed against the judgment and on 27 September 2000 the Maribor Higher Court quashed the judgment and remitted the case to a new panel for retrial"^^xsd:string .

