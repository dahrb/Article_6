    echr:hasProceedingStartDate "2009-03-13"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 16 June 2009 the District Court decided to leave the claim lodged by the applicant company unexamined"^^xsd:string .

doc:proceeding_6 a echr:DomesticProceeding ;
    rdfs:label "Appeal before Civil Court of Appeal"^^xsd:string ;
    echr:followsProceeding doc:proceeding_5 ;
    echr:hasCourt doc:civilCourtAppeal ;
    echr:hasDecisionDate "2009-07-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_1,
