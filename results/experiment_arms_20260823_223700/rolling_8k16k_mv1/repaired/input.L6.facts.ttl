    echr:hasParticipation doc:part_4 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 10 December 2007 a three-judge bench of the Commercial Court rejected the complaint submitted by the applicant company."^^xsd:string .

doc:proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "Claim for recovery before Yerevan Civil Court"^^xsd:string ;
    echr:followsProceeding doc:admin_action_1 ;
    echr:hasCourt doc:yerevanCivilCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:part_6,
        doc:part_7 ;
    echr:hasProceedingStartDate "2008-10-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "on 17 October 2008 the applicant company lodged a claim with the Yerevan Civil Court, seeking to recover EUR 116,600 from the LLC"^^xsd:string .

doc:proceeding_5 a echr:DomesticProceeding ;
    rdfs:label "Claim for recovery before District Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_4 ;
    echr:hasCourt doc:districtCourt ;
    echr:hasDecisionDate "2009-06-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
