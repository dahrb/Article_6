doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Appeal against decision to leave claim unexamined"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:commercialCourt ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasParticipation doc:part_3 ;
    echr:hasProceedingStartDate "2007-11-23"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 23 November 2007 the applicant company lodged a complaint concerning the decision to leave the claim and counterclaim unexamined."^^xsd:string .

doc:proceeding_7 a echr:DomesticProceeding ;
    rdfs:label "Appeal on points of law before Court of Cassation"^^xsd:string ;
    echr:followsProceeding doc:proceeding_6 ;
    echr:hasCourt doc:courtCassation ;
    echr:hasDecisionDate "2009-09-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_1,
