@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/7c8ffd472caa/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/7c8ffd472caa> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:3"^^xsd:string .

doc:case_58919_18 a echr:CaseDocument ;
    echr:hasApplicationNumber "58919/18"^^xsd:string ;
    echr:hasCaseName "Erol Aksoy v. Türkiye"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceeding_1,
        doc:proceeding_2,
        doc:proceeding_3,
        doc:proceeding_4,
        doc:proceeding_5,
        doc:proceeding_6 ;
    echr:hasRespondentState "Türkiye"^^xsd:string .

doc:proceeding_7 a echr:DomesticProceeding ;
    rdfs:label "individual application to the Constitutional Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_6 ;
    echr:hasCourt doc:authAdministrativeCourt ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelConstitutional ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2017-09-11"^^xsd:date ;
    echr:hasProceedingType echr:TypeConstitutional ;
    echr:hasSourceParagraph "41, 42"^^xsd:string ;
    echr:hasSupportingQuote "On 11 September 2017, the applicant lodged an individual application with the Constitutional Court... the Constitutional Court declared the application inadmissible."^^xsd:string .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "appeal to the General Assembly of the Supreme Administrative Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:authAdministrativeCourt ;
    echr:hasDecisionDate "2015-07-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "29"^^xsd:string ;
    echr:hasSupportingQuote "On 7 July 2015, following an appeal by the applicant, the General Assembly... annulled the Fund’s decision."^^xsd:string .

doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "proceedings contesting the actions of the Fund concerning the tendering of Viva TV-Radio Viva"^^xsd:string ;
    echr:hasCourt doc:authAdministrativeCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingStartDate "2011-02-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "27"^^xsd:string ;
    echr:hasSupportingQuote "On 7 February 2011, the applicant initiated proceedings before the administrative court, contesting the actions of the Fund concerning the tendering of Viva TV-Radio Viva"^^xsd:string .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "appeal against the tendering proceedings decision"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:authAdministrativeCourt ;
    echr:hasDecisionDate "2014-12-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "28"^^xsd:string ;
    echr:hasSupportingQuote "On 9 December 2014, the 13th Chamber of the Supreme Administrative Court dismissed the applicant’s case."^^xsd:string .

doc:proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "proceedings seeking the annulment of the sale of Viva TV-Radio Viva"^^xsd:string ;
    echr:hasCourt doc:authAdministrativeCourt ;
    echr:hasDecisionDate "2014-03-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2011-02-24"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "35"^^xsd:string ;
    echr:hasSupportingQuote "On 19 March 2014, the 6th Chamber of the İstanbul Administrative Court dismissed the applicant’s claim"^^xsd:string .

doc:proceeding_5 a echr:DomesticProceeding ;
    rdfs:label "appeal against the annulment of sale dismissal"^^xsd:string ;
    echr:followsProceeding doc:proceeding_4 ;
    echr:hasCourt doc:authAdministrativeCourt ;
    echr:hasDecisionDate "2014-12-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "35"^^xsd:string ;
    echr:hasSupportingQuote "On an appeal by the applicant, the 13th Chamber of the Supreme Administrative Court upheld that decision on 9 December 2014."^^xsd:string .

doc:proceeding_6 a echr:DomesticProceeding ;
    rdfs:label "rectification request regarding the annulment of sale"^^xsd:string ;
    echr:followsProceeding doc:proceeding_5 ;
    echr:hasCourt doc:authAdministrativeCourt ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelReopening ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "37"^^xsd:string ;
    echr:hasSupportingQuote "On 30 June 2017, the 13 th Chamber of the Supreme Administrative Court granted the request... and annulled the sale in question."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:authAdministrativeCourt a echr:DomesticAuthority ;
    rdfs:label "13th Chamber of the Supreme Administrative Court"^^xsd:string,
        "6th Chamber of the İstanbul Administrative Court"^^xsd:string,
        "Constitutional Court"^^xsd:string,
        "General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court"^^xsd:string,
        "administrative court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasJurisdictionState "Türkiye"^^xsd:string .

