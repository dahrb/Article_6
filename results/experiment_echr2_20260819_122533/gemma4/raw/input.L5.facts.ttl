    echr:hasJurisdictionState "Ukraine"^^xsd:string .

doc:authorityPodilskyyCourt a echr:DomesticAuthority ;
    rdfs:label "Podilskyy District Court of Kyiv"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Podilskyy District Court of Kyiv"^^xsd:string ;
