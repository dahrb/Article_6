    echr:hasAuthorityName "Supreme Court"^^xsd:string ;
    echr:hasJurisdictionState "Ukraine"^^xsd:string .

doc:proceeding_6 a echr:DomesticProceeding ;
    rdfs:label "Appeal to Kyiv Administrative Court of Appeal"^^xsd:string ;
    echr:followsProceeding doc:proceeding_5 ;
    echr:hasCourt doc:authorityKyivAdminAppealCourt ;
    echr:hasDecisionDate "2017-03-06"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "25"^^xsd:string ;
    echr:hasSupportingQuote "On 6 March 2017 the Kyiv Administrative Court of Appeal quashed the decision of 22 December 2016."^^xsd:string .

doc:proceeding_7 a echr:DomesticProceeding ;
    rdfs:label "Final Appeal to Supreme Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_4 ;
    echr:hasCourt doc:authoritySupremeCourt ;
    echr:hasDecisionDate "2021-12-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "31"^^xsd:string ;
    echr:hasSupportingQuote "The applicant’s appeals were rejected (final decision of the Supreme Court of 9 December 2021)."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:authorityQdcZakarpattya a echr:DomesticAuthority ;
    rdfs:label "Qualification and Disciplinary Commission of the Regional Bar of Zakarpattya"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityDisciplinary ;
    echr:hasAuthorityName "Qualification and Disciplinary Commission of the Regional Bar of Zakarpattya"^^xsd:string ;
    echr:hasJurisdictionState "Ukraine"^^xsd:string .

doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "First instance disciplinary proceeding - QDC of Zakarpattya"^^xsd:string ;
    echr:hasCourt doc:authorityQdcZakarpattya ;
    echr:hasDecisionDate "2013-04-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeDisciplinary ;
    echr:hasSourceParagraph "9"^^xsd:string ;
    echr:hasSupportingQuote "On 17 April 2013, in the applicant’s absence, the Disciplinary Chamber of the QDC of Zakarpattya suspended the applicant’s licence"^^xsd:string .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Review of disciplinary decision - QDC of Zakarpattya"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:authorityQdcZakarpattya ;
    echr:hasDecisionDate "2013-05-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeDisciplinary ;
    echr:hasSourceParagraph "11"^^xsd:string ;
    echr:hasSupportingQuote "On 16 May the QDC of Zakarpattya upheld the decision of 17 April 2013."^^xsd:string .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "Appeal to HQDCB"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:authorityHqdcb ;
    echr:hasDecisionDate "2016-07-22"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeDisciplinary ;
    echr:hasSourceParagraph "20"^^xsd:string ;
    echr:hasSupportingQuote "On 22 July 2016 the draft decision was put to vote at a HQDCB meeting... the draft decision was rejected and the decisions suspending the applicant’s licence remained valid."^^xsd:string .

doc:proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "Appeal to Kyiv District Administrative Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:authorityKyivDistAdminCourt ;
    echr:hasDecisionDate "2021-04-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2016-10-05"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "30"^^xsd:string ;
    echr:hasSupportingQuote "On 8 April 2021 the Kyiv District Administrative Court found that all the decisions issued by the self-government bodies of the Bar against the applicant had been lawful."^^xsd:string .

doc:proceeding_5 a echr:DomesticProceeding ;
    rdfs:label "Appeal to Podilskyy District Court"^^xsd:string ;
    echr:hasCourt doc:authorityPodilskyyCourt ;
    echr:hasDecisionDate "2016-12-22"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "23"^^xsd:string ;
    echr:hasSupportingQuote "On 22 December 2016 the Podilskyy District Court decided not to examine the applicant’s appeal."^^xsd:string .

