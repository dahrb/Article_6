<https://growgraph.dev/doc/5f16894b5362> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:6"^^xsd:string .

doc:caseScholzAgArmenia a echr:CaseDocument ;
    echr:hasApplicationNumber "16528/10"^^xsd:string ;
    echr:hasCaseName "Scholz AG v. Armenia"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceedingArbitration,
        doc:proceedingCassation,
        doc:proceedingCivilAppeal,
        doc:proceedingCommercialAppeal,
        doc:proceedingDistrictCourt,
        doc:proceedingYerevanCivil,
        doc:proceeding_commercial_1 ;
    echr:hasRespondentState "Republic of Armenia"^^xsd:string .

doc:authArbitrationTribunal a echr:DomesticAuthority ;
    rdfs:label "Arbitration Tribunal of the Chamber of Commerce and Industry of Armenia"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Arbitration Tribunal of the Chamber of Commerce and Industry of Armenia"^^xsd:string ;
    echr:hasJurisdictionState "Armenia"^^xsd:string .

doc:authCivilCourtAppeal a echr:DomesticAuthority ;
    rdfs:label "Civil Court of Appeal"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Civil Court of Appeal"^^xsd:string ;
    echr:hasJurisdictionState "Armenia"^^xsd:string .

doc:authCourtCassation a echr:DomesticAuthority ;
    rdfs:label "Court of Cassation"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Court of Cassation"^^xsd:string ;
    echr:hasJurisdictionState "Armenia"^^xsd:string .

doc:authDistrictCourt a echr:DomesticAuthority ;
    rdfs:label "Kentron and Nork-Marash District Court of Yerevan"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Kentron and Nork-Marash District Court of Yerevan"^^xsd:string ;
    echr:hasJurisdictionState "Armenia"^^xsd:string .

doc:authYerevanCivilCourt a echr:DomesticAuthority ;
    rdfs:label "Yerevan Civil Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Yerevan Civil Court"^^xsd:string ;
    echr:hasJurisdictionState "Armenia"^^xsd:string .

doc:proceedingArbitration a echr:DomesticProceeding ;
    rdfs:label "Arbitration Tribunal claim"^^xsd:string ;
    echr:hasCourt doc:authArbitrationTribunal ;
    echr:hasDecisionDate "2008-10-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2008-09-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "26"^^xsd:string ;
    echr:hasSupportingQuote "On 7 October 2008 the President of the Arbitration Tribunal informed the applicant company that its request to start arbitration proceedings would not be granted."^^xsd:string .

doc:proceedingCassation a echr:DomesticProceeding ;
    rdfs:label "Court of Cassation appeal"^^xsd:string ;
    echr:followsProceeding doc:proceedingCivilAppeal ;
    echr:hasCourt doc:authCourtCassation ;
    echr:hasDecisionDate "2009-09-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2009-08-04"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "38"^^xsd:string ;
    echr:hasSupportingQuote "On 23 September 2009 the Court of Cassation declared the applicant company’s appeal on points of law inadmissible."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:proceedingCommercialAppeal a echr:DomesticProceeding ;
    rdfs:label "Commercial Court appeal"^^xsd:string ;
    echr:followsProceeding doc:proceeding_commercial_1 ;
    echr:hasCourt doc:authCommercialCourt ;
    echr:hasDecisionDate "2007-12-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2007-11-23"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "21"^^xsd:string ;
    echr:hasSupportingQuote "On 10 December 2007 a three-judge bench of the Commercial Court rejected the complaint submitted by the applicant company."^^xsd:string .

doc:authCommercialCourt a echr:DomesticAuthority ;
    rdfs:label "Commercial Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Commercial Court"^^xsd:string ;
    echr:hasJurisdictionState "Armenia"^^xsd:string .

doc:proceedingCivilAppeal a echr:DomesticProceeding ;
    rdfs:label "Civil Court of Appeal"^^xsd:string ;
    echr:followsProceeding doc:proceedingDistrictCourt ;
    echr:hasCourt doc:authCivilCourtAppeal ;
    echr:hasDecisionDate "2009-07-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2009-06-25"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "36"^^xsd:string ;
    echr:hasSupportingQuote "On 21 July 2009 the Civil Court of Appeal upheld the decision of 16 June 2009."^^xsd:string .

doc:proceedingDistrictCourt a echr:DomesticProceeding ;
    rdfs:label "District Court claim"^^xsd:string ;
    echr:followsProceeding doc:proceedingYerevanCivil ;
    echr:hasCourt doc:authDistrictCourt ;
    echr:hasDecisionDate "2009-06-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2009-03-13"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "33"^^xsd:string ;
    echr:hasSupportingQuote "On 16 June 2009 the District Court decided to leave the claim lodged by the applicant company unexamined"^^xsd:string .

doc:proceedingYerevanCivil a echr:DomesticProceeding ;
    rdfs:label "Yerevan Civil Court claim"^^xsd:string ;
    echr:hasCourt doc:authYerevanCivilCourt ;
    echr:hasDecisionDate "2009-02-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasProceedingStartDate "2008-10-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "29"^^xsd:string ;
    echr:hasSupportingQuote "On 27 February 2009 the Yerevan Civil Court transferred the case to the Kentron and Nork-Marash District Court of Yerevan"^^xsd:string .

doc:proceeding_commercial_1 a echr:DomesticProceeding ;
    rdfs:label "Commercial Court claim for recovery"^^xsd:string ;
    echr:hasCourt doc:authCommercialCourt ;
    echr:hasDecisionDate "2007-11-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2007-01-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "19"^^xsd:string ;
    echr:hasSupportingQuote "On 16 November 2007 the Commercial Court granted the request and decided to leave the applicant company’s claim and the counterclaim lodged by the LLC unexamined."^^xsd:string .

