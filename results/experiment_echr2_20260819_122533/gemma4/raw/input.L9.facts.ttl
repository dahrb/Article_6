@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/1a18c72ccc82/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/1a18c72ccc82> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:9"^^xsd:string .

doc:case_1 a echr:CaseDocument ;
    rdfs:label "Malkhaz BADUASHVILI against Georgia"^^xsd:string ;
    echr:hasApplicationNumber "18720/08"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceeding_1,
        doc:proceeding_2,
        doc:proceeding_3 ;
    echr:hasRespondentState "Georgia"^^xsd:string .

doc:authorityAppeal a echr:DomesticAuthority ;
    rdfs:label "Tbilisi Court of Appeal"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Tbilisi Court of Appeal"^^xsd:string ;
    echr:hasJurisdictionState "Georgia"^^xsd:string .

doc:authorityFirstInstance a echr:DomesticAuthority ;
    rdfs:label "court of first instance"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "court of first instance"^^xsd:string ;
    echr:hasJurisdictionState "Georgia"^^xsd:string .

doc:authoritySupreme a echr:DomesticAuthority ;
    rdfs:label "Supreme Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Supreme Court"^^xsd:string ;
    echr:hasJurisdictionState "Georgia"^^xsd:string .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "cassation appeal of Malkhaz Baduashvili before Supreme Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:authoritySupreme ;
    echr:hasDecisionDate "2008-02-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "26"^^xsd:string ;
    echr:hasSupportingQuote "On 20 February 2008 the Supreme Court declared an appeal on points of law lodged by the applicant inadmissible."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "first-instance trial of Malkhaz Baduashvili"^^xsd:string ;
    echr:hasCourt doc:authorityFirstInstance ;
    echr:hasDecisionDate "2006-12-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "22"^^xsd:string ;
    echr:hasSupportingQuote "On 8 December 2006 the court of first instance convicted the applicant of aggravated murder"^^xsd:string .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "appeal of Malkhaz Baduashvili before Tbilisi Court of Appeal"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:authorityAppeal ;
    echr:hasDecisionDate "2007-06-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "25"^^xsd:string ;
    echr:hasSupportingQuote "On 27 June 2007 the Tbilisi Court of Appeal upheld the applicant’s conviction."^^xsd:string .

