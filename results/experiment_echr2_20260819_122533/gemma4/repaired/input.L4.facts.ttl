@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/f2ce7889910b/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/f2ce7889910b> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:4"^^xsd:string .

doc:authoritySlovenjGradecPolice a echr:DomesticAuthority ;
    rdfs:label "Slovenj Gradec Police"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Slovenj Gradec Police"^^xsd:string ;
    echr:hasJurisdictionState "Slovenia"^^xsd:string .

doc:caseMatkoSlovenia a echr:CaseDocument ;
    rdfs:label "Case of Matko v. Slovenia"^^xsd:string ;
    echr:hasApplicationNumber "43393/98"^^xsd:string ;
    echr:hasDomesticProceeding doc:complaint_investigation_1,
        doc:criminal_proceeding_1,
        doc:criminal_proceeding_appeal_1,
        doc:criminal_proceeding_costs_1,
        doc:criminal_proceeding_retrial_1,
        doc:criminal_proceeding_retrial_appeal_1 ;
    echr:hasRespondentState "Slovenia"^^xsd:string .

doc:authoritySlovenjGradecProsecutor a echr:DomesticAuthority ;
    rdfs:label "Slovenj Gradec District Public Prosecutor's Office"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Slovenj Gradec District Public Prosecutor's Office"^^xsd:string ;
    echr:hasJurisdictionState "Slovenia"^^xsd:string .

doc:complaint_investigation_1 a echr:DomesticProceeding ;
    rdfs:label "Investigation into applicant's criminal complaint"^^xsd:string ;
    echr:hasCourt doc:authoritySlovenjGradecProsecutor ;
    echr:hasDecisionDate "1997-01-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "34"^^xsd:string ;
    echr:hasSupportingQuote "On 17 January 1997 the Public Prosecutor issued a decision dismissing the applicant's criminal complaint."^^xsd:string .

doc:criminal_proceeding_costs_1 a echr:DomesticProceeding ;
    rdfs:label "Proceedings regarding witness costs"^^xsd:string ;
    echr:followsProceeding doc:criminal_proceeding_retrial_appeal_1 ;
    echr:hasCourt doc:authoritySlovenjGradecCourt ;
    echr:hasDecisionDate "2001-10-11"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "50"^^xsd:string ;
    echr:hasSupportingQuote "On 11 October 2001 the Slovenj Gradec District Court ordered the applicant to pay an additional sum... the proceedings were 'finally concluded'"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:authorityMariborCourt a echr:DomesticAuthority ;
    rdfs:label "Maribor Higher Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Maribor Higher Court"^^xsd:string ;
    echr:hasJurisdictionState "Slovenia"^^xsd:string .

doc:criminal_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "First instance criminal proceedings against applicant"^^xsd:string ;
    echr:hasCourt doc:authoritySlovenjGradecCourt ;
    echr:hasDecisionDate "1999-11-22"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeAcquittal ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "46"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of 22 November 1999 the court acquitted the applicant."^^xsd:string .

doc:criminal_proceeding_appeal_1 a echr:DomesticProceeding ;
    rdfs:label "Appeal of first instance acquittal"^^xsd:string ;
    echr:followsProceeding doc:criminal_proceeding_1 ;
    echr:hasCourt doc:authorityMariborCourt ;
    echr:hasDecisionDate "2000-09-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "47"^^xsd:string ;
    echr:hasSupportingQuote "on 27 September 2000 the Maribor Higher Court quashed the judgment and remitted the case to a new panel for retrial."^^xsd:string .

doc:criminal_proceeding_retrial_1 a echr:DomesticProceeding ;
    rdfs:label "Retrial criminal proceedings"^^xsd:string ;
    echr:followsProceeding doc:criminal_proceeding_appeal_1 ;
    echr:hasCourt doc:authoritySlovenjGradecCourt ;
    echr:hasDecisionDate "2001-02-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelReopening ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "48"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of 12 February 2001, the Slovenj Gradec District Court convicted the applicant as charged"^^xsd:string .

doc:criminal_proceeding_retrial_appeal_1 a echr:DomesticProceeding ;
    rdfs:label "Appeal of retrial conviction"^^xsd:string ;
    echr:followsProceeding doc:criminal_proceeding_retrial_1 ;
    echr:hasCourt doc:authorityMariborCourt ;
    echr:hasDecisionDate "2001-05-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "49"^^xsd:string ;
    echr:hasSupportingQuote "On 9 May 2001 the Maribor Higher Court upheld the conviction"^^xsd:string .

doc:authoritySlovenjGradecCourt a echr:DomesticAuthority ;
    rdfs:label "Slovenj Gradec District Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Slovenj Gradec District Court"^^xsd:string ;
    echr:hasJurisdictionState "Slovenia"^^xsd:string .

