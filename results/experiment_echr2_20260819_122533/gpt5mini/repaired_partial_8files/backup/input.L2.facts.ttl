@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/b9a5610d62dc> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:2"^^xsd:string .

doc:beer_labour_proceeding_1993 a echr:DomesticProceeding ;
    rdfs:label "Proceedings before the Darmstadt Labour Court (Beer)"^^xsd:string ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "1993-10"^^xsd:gYearMonth ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "13"^^xsd:string,
        "15"^^xsd:string ;
    echr:hasSupportingQuote "In October and November 1993 the applicants instituted proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA"^^xsd:string,
        "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:regan_labour_proceeding_1993 a echr:DomesticProceeding ;
    rdfs:label "Proceedings before the Darmstadt Labour Court (Regan)"^^xsd:string ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "1993-11"^^xsd:gYearMonth ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "13"^^xsd:string,
        "15"^^xsd:string ;
    echr:hasSupportingQuote "In October and November 1993 the applicants instituted proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA"^^xsd:string,
        "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:regan_vs_ti_settlement_1994 a echr:DomesticProceeding ;
    rdfs:label "Proceedings before the Darmstadt Labour Court (Regan v. T.I.)"^^xsd:string ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1994-09-06"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeSettled ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "17"^^xsd:string ;
    echr:hasSupportingQuote "In the proceedings instituted by the second applicant against his dismissal by the company T.I. (see paragraph 13 above), a settlement had been reached in the Darmstadt Labour Court on 6 September 1994."^^xsd:string .

doc:darmstadtLabourCourt a echr:DomesticAuthority ;
    rdfs:label "Darmstadt Labour Court (Arbeitsgericht)"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Darmstadt Labour Court (Arbeitsgericht)"^^xsd:string ;
    echr:hasJurisdictionState "Germany"^^xsd:string .

