doc:proc_chief_public_prosecutor_2005_11_29 a echr:DomesticProceeding ;
    rdfs:label "Chief Public Prosecutor's Office decision of 29 November 2005"^^xsd:string ;
    echr:followsProceeding doc:proc_appellate_prosecutor_2005_10_11 ;
    echr:hasCourt doc:authorityChiefPublicProsecutorOffice ;
    echr:hasDecisionDate "2005-11-29"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasProceedingType echr:TypeOther ;
    echr:hasSourceParagraph "38"^^xsd:string ;
    echr:hasSupportingQuote "Despite those objections, the regional prosecutor’s refusal was upheld on 11 October 2005 by the appellate prosecutor, and subsequently on 29 November 2005 by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation."^^xsd:string .

doc:proc_dupnitsa_district_court_2006_03_10 a echr:DomesticProceeding ;
    rdfs:label "Dupnitsa District Court judgment of 10 March 2006"^^xsd:string ;
    echr:followsProceeding doc:proc_mayor_rila_2005_09_16 ;
    echr:hasCourt doc:authorityDupnitsaDistrictCourt ;
    echr:hasDecisionDate "2006-03-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "40"^^xsd:string ;
    echr:hasSupportingQuote "The Dupnitsa District Court gave judgment on 10 March 2006. ... As to the merits, the court dismissed the application, finding that the guardian had no legitimate interest in contesting the mayor’s refusal, given that he could apply independently and directly for the applicant to be released from partial guardianship. Since the judgment was not subject to appeal, it became final."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:proc_ruse_municipal_council_2002_05_23 a echr:DomesticProceeding ;
    rdfs:label "Ruse Municipal Council appointment of guardian on 23 May 2002"^^xsd:string ;
    echr:followsProceeding doc:proc_veliko_tarnovo_2001_04_12 ;
    echr:hasCourt doc:authorityRuseMunicipalCouncil ;
    echr:hasDecisionDate "2002-05-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "12"^^xsd:string ;
    echr:hasSupportingQuote "Since the applicant’s family members had refused to take on any guardianship responsibilities, on 23 May 2002 the Municipal Council appointed Ms R.P., a council officer, as the applicant’s guardian until 31 December 2002."^^xsd:string .

