doc:proceeding_arbitration_2008 a echr:DomesticProceeding ;
    rdfs:label "Arbitration Tribunal claim (17 September 2008)"@en ;
    echr:followsProceeding doc:proceeding_commercial_three_judge_2007 ;
    echr:hasCourt doc:authorityArbitrationTribunal ;
    echr:hasDecisionDate "2008-10-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelUnknown ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2008-09-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "26"^^xsd:string ;
    echr:hasSupportingQuote "\"The promissory note of 8 November 2002 and the agreement of 28 October 2005, on which your claim was based, do not contain an arbitration clause and, moreover, the parties have not concluded any agreement to submit the disputes arising out of the performance of the above-mentioned promissory note and the agreement to the permanent arbitration institution of the Chamber of Commerce and Industry of Armenia for determination. Consequently, in the absence of an arbitration agreement between the parties, the [Arbitration Tribunal] cannot start arbitration proceedings.\""^^xsd:string .

doc:proceeding_civil_court_of_appeal_2009 a echr:DomesticProceeding ;
    rdfs:label "Civil Court of Appeal (21 July 2009)"@en ;
    echr:followsProceeding doc:proceeding_district_court_kentron_nork_marash_2009 ;
    echr:hasCourt doc:authorityCivilCourtOfAppeal ;
    echr:hasDecisionDate "2009-07-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2009-06-25"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "36"^^xsd:string ;
    echr:hasSupportingQuote "On 21 July 2009 the Civil Court of Appeal upheld the decision of 16 June 2009."^^xsd:string .

doc:proceeding_commercial_first_instance_2007 a echr:DomesticProceeding ;
    rdfs:label "Claim before the Commercial Court (15 January 2007)"@en ;
    echr:hasCourt doc:authorityCommercialCourt ;
    echr:hasDecisionDate "2007-11-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2007-01-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "14"^^xsd:string ;
    echr:hasSupportingQuote "On 15 January 2007 the applicant company lodged a claim with the Commercial Court against the LLC, seeking to recover USD 10,000 from the initial debt of USD 1,213,824."^^xsd:string .

doc:proceeding_commercial_three_judge_2007 a echr:DomesticProceeding ;
    rdfs:label "Three-judge bench of the Commercial Court appeal (10 December 2007)"@en ;
    echr:followsProceeding doc:proceeding_commercial_first_instance_2007 ;
    echr:hasCourt doc:authorityCommercialCourt ;
    echr:hasDecisionDate "2007-12-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2007-11-23"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "21"^^xsd:string ;
    echr:hasSupportingQuote "On 10 December 2007 a three-judge bench of the Commercial Court rejected the complaint submitted by the applicant company."^^xsd:string .

doc:proceeding_district_court_kentron_nork_marash_2009 a echr:DomesticProceeding ;
    rdfs:label "Kentron and Nork-Marash District Court of Yerevan (13 March 2009)"@en ;
    echr:followsProceeding doc:proceeding_yerevan_civil_2008 ;
    echr:hasCourt doc:authorityDistrictCourtKentronNorkMarash ;
    echr:hasDecisionDate "2009-06-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2009-03-13"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "33"^^xsd:string ;
    echr:hasSupportingQuote "On 16 June 2009 the District Court decided to leave the claim lodged by the applicant company unexamined, finding that the refusal to start arbitration proceedings stated in the letter of 7 October 2008 did not substantiate the fact that there was no possibility of applying to the Arbitration Tribunal."^^xsd:string .

doc:proceeding_yerevan_civil_2008 a echr:DomesticProceeding ;
    rdfs:label "Yerevan Civil Court claim (17 October 2008)"@en ;
    echr:followsProceeding doc:proceeding_arbitration_2008 ;
    echr:hasCourt doc:authorityYerevanCivilCourt ;
    echr:hasDecisionDate "2009-02-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnknown ;
    echr:hasProceedingStartDate "2008-10-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "28"^^xsd:string ;
    echr:hasSupportingQuote "On 12 November 2008 the Yerevan Civil Court accepted the applicant company’s claim for examination and scheduled a preparatory hearing. On the same day it allowed the applicant company’s interlocutory application for a freezing injunction in respect of the property of the LLC in the amount of the claim."^^xsd:string .

