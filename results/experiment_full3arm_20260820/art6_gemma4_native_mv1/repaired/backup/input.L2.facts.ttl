doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "action before the Darmstadt Labour Court"^^xsd:string,
        "employment status proceedings against ESA"^^xsd:string ;
    echr:hasCourt doc:darmstadtLabourCourt ;
