doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "German court proceedings regarding ESA immunity"^^xsd:string ;
    echr:hasCourt doc:germanCourts ;
    echr:hasOutcome echr:OutcomeClaimDismissed,
        echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "the German courts did not exceed their margin of appreciation [in giving effect to the immunity from jurisdiction of ESA]"^^xsd:string,
        "the rule of immunity from jurisdiction, which the German courts applied to ESA in the present case"^^xsd:string .

