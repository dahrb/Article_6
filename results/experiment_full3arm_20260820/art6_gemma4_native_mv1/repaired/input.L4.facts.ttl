    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "the applicant went to the Slovenj Gradec Police and made an oral complaint"^^xsd:string ;
    echr:participatingParty doc:applicant_1 .

doc:part_2 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:slovenjGradecDistrictPublicProsecutorOffice .

doc:participation_3 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:policeSlovenjGradec .

