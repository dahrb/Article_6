    echr:hasPersonName "Officer I.G."^^xsd:string .

doc:officerMf a echr:NaturalPerson ;
    rdfs:label "Officer M.F."^^xsd:string ;
    echr:hasPersonName "Officer M.F."^^xsd:string .

doc:proceeding_5 a echr:DomesticProceeding ;
    rdfs:label "Final costs order - Slovenj Gradec"^^xsd:string ;
    echr:followsProceeding doc:proceeding_4 ;
    echr:hasCourt doc:courtSlovenjGradec ;
    echr:hasDecisionDate "2001-10-11"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasParticipation doc:part_1_app ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "on 11 October 2001 the Slovenj Gradec District Court ordered the applicant to pay an additional sum to cover the costs of one of the witnesses"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:admin_action_1 a echr:AdministrativeAction ;
    rdfs:label "MIA Working Group appointment"^^xsd:string ;
    echr:hasCourt doc:mia ;
    echr:hasDecisionDate "1995-04-20"^^xsd:date ;
    echr:hasSupportingQuote "on 20 April 1995, the MIA had appointed a ‘working group’"^^xsd:string .

doc:administrative_action_1 a echr:AdministrativeAction ;
    rdfs:label "Slovenj Gradec Police report/complaint"^^xsd:string ;
    echr:hasCourt doc:policeSlovenjGradec ;
    echr:hasSupportingQuote "The criminal complaint of the Slovenj Gradec Police states that Aleksander Matko sustained injuries"^^xsd:string .

doc:courtMaribor a echr:DomesticAuthority ;
    rdfs:label "Maribor Higher Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Maribor Higher Court"^^xsd:string .

