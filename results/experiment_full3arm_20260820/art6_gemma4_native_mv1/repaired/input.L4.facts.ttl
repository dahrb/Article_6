    rdfs:label "police procedure"^^xsd:string ;
    echr:hasCourt doc:police_station_1 ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasSupportingQuote "informed him that this was a police procedure"^^xsd:string .

doc:police_station_1 a echr:DomesticAuthority ;
    rdfs:label "police station"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "police station"^^xsd:string .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Appeal against decision not to investigate"^^xsd:string,
        "Appeal to Maribor Higher Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:courtMaribor,
        doc:courtMariborHigher ;
    echr:hasDecisionDate "1997-12-04"^^xsd:date,
        "2000-09-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted,
        echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_1_app,
        doc:part_1_pros ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 4 December 1997 the Maribor Higher Court upheld her appeal... and opened a criminal investigation against the applicant."^^xsd:string,
        "on 27 September 2000 the Maribor Higher Court quashed the judgment and remitted the case to a new panel for retrial."^^xsd:string .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "Conclusion of criminal investigation"^^xsd:string,
        "Retrial - Slovenj Gradec"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:courtSlovenjGradec ;
    echr:hasDecisionDate "1998-03-17"^^xsd:date,
        "2001-02-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative,
        echr:LevelReopening ;
    echr:hasOutcome echr:OutcomeConviction,
        echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_1_app,
        doc:part_1_pros ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "By a judgment of 12 February 2001, the Slovenj Gradec District Court convicted the applicant as charged"^^xsd:string,
        "On 17 March 1998 the criminal investigation was concluded with the investigating judge’s decision ordering the exclusion of certain documents"^^xsd:string .

doc:proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "Indictment and objection phase"^^xsd:string,
        "Second Appeal to Maribor Higher Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:courtMariborHigher ;
    echr:hasDecisionDate "2001-05-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal,
        echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_1_app,
        doc:part_1_pros ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 28 December 1998 the Public Prosecutor filed an indictment against the applicant... On 27 January 1999 the applicant filed an objection to the indictment."^^xsd:string,
        "On 9 May 2001 the Maribor Higher Court upheld the conviction"^^xsd:string .

doc:prosecutorial_review_1 a echr:ProsecutorialReview ;
    rdfs:label "Public Prosecutor's decision on Matko's criminal complaint"^^xsd:string ;
    echr:followsProceeding doc:administrative_action_1 ;
    echr:hasCourt doc:prosecutor_1 ;
    echr:hasDecisionDate "1997-01-17"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_matko_1,
        doc:participation_prosecutor_1 ;
    echr:hasSupportingQuote "On 17 January 1997 the Public Prosecutor issued a decision dismissing the applicant’s criminal complaint."^^xsd:string .

