<https://growgraph.dev/doc/15ef9b3a7c03> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:4"^^xsd:string .

doc:arrest_event_1 a echr:AdministrativeAction ;
    rdfs:label "arrest of Aleksander Matko"^^xsd:string ;
    echr:hasDecisionDate "1995-04-05"^^xsd:date ;
    echr:hasParticipation doc:partMatkoArrest,
        doc:partMiaArrest,
        doc:partSgPoliceArrest ;
    echr:hasSupportingQuote "On 5 April 1995 at about 8.30 p.m. the applicant, driving a car, was arrested in Slovenj Gradec by officers of the Special Unit and the Slovenj Gradec Police."^^xsd:string .

doc:caseMatko a echr:CaseDocument ;
    echr:hasApplicant doc:partyMatko ;
    echr:hasDomesticProceeding doc:prosecutorial_review_1 .

doc:caseMatkoSlovenia a echr:CaseDocument ;
    echr:hasApplicant doc:partyMatko ;
    echr:hasApplicationNumber "43393/98"^^xsd:string ;
    echr:hasCaseName "Matko v. Slovenia"^^xsd:string ;
    echr:hasRespondentState "Republic of Slovenia"^^xsd:string .

doc:case_1 a echr:CaseDocument ;
    echr:hasApplicant doc:applicant_1 ;
    echr:hasDomesticProceeding doc:proceeding_1 .

doc:case_document_1 a echr:CaseDocument ;
    echr:hasApplicant doc:applicant_1 ;
    echr:hasDomesticProceeding doc:criminal_proceeding_1,
        doc:investigation_1 .

doc:criminal_investigation_1 a echr:DomesticProceeding ;
    rdfs:label "criminal investigation"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2,
        doc:participation_3 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "Officer M.F. stated in the same criminal investigation"^^xsd:string .

doc:detention_1 a echr:PreTrialDetention ;
    rdfs:label "police custody of Aleksander Matko"^^xsd:string ;
    echr:hasCustodialMeasure echr:MeasurePoliceCustody ;
    echr:hasDetainee doc:partyMatko ;
    echr:hasDetentionEndDate "1995-04-06"^^xsd:date ;
    echr:hasDetentionStartDate "1995-04-05"^^xsd:date ;
    echr:hasSupportingQuote "He was brought to the Slovenj Gradec Police Station... and released on 6 April 1995 at approximately half past midnight."^^xsd:string .

doc:hospital_visit_1 a echr:AdministrativeAction ;
    rdfs:label "admission to Slovenj Gradec General Hospital"^^xsd:string ;
    echr:hasDecisionDate "1995-04-06"^^xsd:date ;
    echr:hasSupportingQuote "On 6 April 1995, soon after his release, the applicant was admitted to the Slovenj Gradec General Hospital"^^xsd:string .

doc:hospital_visit_2 a echr:AdministrativeAction ;
    rdfs:label "medical aid in the Maribor General Hospital"^^xsd:string ;
    echr:hasDecisionDate "1995-04-07"^^xsd:date ;
    echr:hasSupportingQuote "Next day, 7 April 1995, the applicant sought medical aid in the Maribor General Hospital"^^xsd:string .

