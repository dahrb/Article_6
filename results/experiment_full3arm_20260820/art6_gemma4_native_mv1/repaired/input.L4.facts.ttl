    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:participation_2 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "the criminal proceedings instituted against the applicant"^^xsd:string .

