        doc:participation_1_2 ;
    echr:hasProceedingType echr:TypeCivil,
        echr:TypeCriminal ;
    echr:hasSupportingQuote "During the second trial, on 27 May 1998... the applicant was ordered by the Nizhniy Novgorod Court to pay damages to “Oka”"^^xsd:string,
