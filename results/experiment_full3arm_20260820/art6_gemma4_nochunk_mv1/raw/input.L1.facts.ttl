@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/406198fb6772/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/406198fb6772> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:1"^^xsd:string .

doc:caseStanevBulgaria a echr:CaseDocument ;
    echr:hasApplicant doc:stanev ;
    echr:hasApplicationNumber "36760/06"^^xsd:string ;
    echr:hasCaseName "Stanev v. Bulgaria"^^xsd:string ;
    echr:hasRespondentState "Republic of Bulgaria"^^xsd:string .

doc:enforcementPlacement a echr:EnforcementAction ;
    rdfs:label "Physical placement in Pastra social care home"^^xsd:string ;
    echr:followsProceeding doc:adminPlacementRequest ;
    echr:hasDecisionDate "2002-12-10"^^xsd:date ;
    echr:hasSupportingQuote "On 10 December 2002 a welfare-placement agreement was signed... Later that day, the applicant was taken by ambulance to the Pastra social care home"^^xsd:string .

doc:pastraSocialCareHome a echr:DomesticAuthority ;
    rdfs:label "Pastra social care home"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthoritySocialWelfare ;
    echr:hasAuthorityName "social care home for adults with mental disorders near the village of Pastra"^^xsd:string ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

doc:proceedingJudicialReview a echr:DomesticProceeding ;
    rdfs:label "Judicial review of mayor's decision"^^xsd:string ;
    echr:followsProceeding doc:adminReleaseRequest ;
    echr:hasCourt doc:dupnitsaDistrictCourt ;
    echr:hasDecisionDate "2006-03-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_mayor_1,
        doc:participation_stanev_2 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "The Dupnitsa District Court gave judgment on 10 March 2006... the court dismissed the application... Since the judgment was not subject to appeal, it became final"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:prosecutorial_review_3 a echr:ProsecutorialReview ;
    rdfs:label "Chief Public Prosecutor review of refusal"^^xsd:string ;
    echr:followsProceeding doc:prosecutorial_review_2 ;
    echr:hasCourt doc:chiefPublicProsecutorOffice ;
    echr:hasDecisionDate "2005-11-29"^^xsd:date ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "subsequently on 29 November 2005 by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation"^^xsd:string .

doc:adminPlacementRequest a echr:AdministrativeAction ;
    rdfs:label "Request for placement in social care home"^^xsd:string ;
    echr:followsProceeding doc:admin_guardian_appointment_1 ;
    echr:hasCourt doc:ruseSocialServices ;
    echr:hasDecisionDate "2002-07-23"^^xsd:date ;
    echr:hasSupportingQuote "Social services drew up a welfare report on the applicant, noting on 23 July 2002... The requirements for placement in a social care home were therefore deemed to be fulfilled"^^xsd:string .

doc:adminReleaseRequest a echr:AdministrativeAction ;
    rdfs:label "Request to mayor for release from partial guardianship"^^xsd:string ;
    echr:hasCourt doc:mayorRila ;
    echr:hasDecisionDate "2005-09-16"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_stanev_2 ;
    echr:hasSupportingQuote "In a letter of 16 September 2005, the mayor of Rila refused his request"^^xsd:string .

doc:admin_guardian_appointment_1 a echr:AdministrativeAction ;
    rdfs:label "Appointment of guardian Ms R.P."^^xsd:string ;
    echr:followsProceeding doc:proceedingIncapacityAppeal ;
    echr:hasCourt doc:ruseMunicipalCouncil ;
    echr:hasDecisionDate "2002-05-23"^^xsd:date ;
    echr:hasParticipation doc:participation_rp_1 ;
    echr:hasSupportingQuote "on 23 May 2002 the Municipal Council appointed Ms R.P., a council officer, as the applicant’s guardian"^^xsd:string .

doc:appellateProsecutor a echr:DomesticAuthority ;
    rdfs:label "Appellate prosecutor"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "appellate prosecutor"^^xsd:string ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

doc:chiefPublicProsecutorOffice a echr:DomesticAuthority ;
    rdfs:label "Chief Public Prosecutor’s Office at the Supreme Court of Cassation"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Chief Public Prosecutor’s Office at the Supreme Court of Cassation"^^xsd:string ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

doc:dupnitsaDistrictCourt a echr:DomesticAuthority ;
    rdfs:label "Dupnitsa District Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Dupnitsa District Court"^^xsd:string ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

doc:genovaLawyer a echr:LegalRepresentative ;
    rdfs:label "Ms A. Genova"^^xsd:string ;
    echr:hasPersonName "Ms A. Genova"^^xsd:string .

doc:participation_mayor_1 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:mayorRila .

doc:participation_rp_1 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:rpGuardian .

doc:participation_stanev_1 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:stanev .

doc:proceedingIncapacityAppeal a echr:DomesticProceeding ;
    rdfs:label "Appeal against partial incapacity declaration"^^xsd:string ;
    echr:followsProceeding doc:proceeding_incapacity_1 ;
    echr:hasCourt doc:velikoTarnovoCourtAppeal ;
    echr:hasDecisionDate "2001-04-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_stanev_2 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "That judgment was upheld in a judgment of 12 April 2001 by the Veliko Tarnovo Court of Appeal"^^xsd:string .

doc:proceeding_incapacity_1 a echr:DomesticProceeding ;
    rdfs:label "Proceeding for declaration of total legal incapacity"^^xsd:string ;
    echr:hasCourt doc:ruseRegionalCourt ;
    echr:hasDecisionDate "2000-11-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_stanev_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasStatusApplied echr:StatusPartialIncapacity ;
    echr:hasSupportingQuote "In a judgment of 20 November 2000, the court declared the applicant to be partially incapacitated"^^xsd:string .

doc:prosecutorial_review_1 a echr:ProsecutorialReview ;
    rdfs:label "Refusal to bring action for restoration of legal capacity"^^xsd:string ;
    echr:hasCourt doc:ruseRegionalProsecutor ;
    echr:hasDecisionDate "2005-08-10"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_stanev_2 ;
    echr:hasSupportingQuote "On 10 August 2005 the regional prosecutor refused to bring an action for restoration of the applicant’s legal capacity"^^xsd:string .

doc:prosecutorial_review_2 a echr:ProsecutorialReview ;
    rdfs:label "Appellate prosecutor review of refusal"^^xsd:string ;
    echr:followsProceeding doc:prosecutorial_review_1 ;
    echr:hasCourt doc:appellateProsecutor ;
    echr:hasDecisionDate "2005-10-11"^^xsd:date ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "the regional prosecutor’s refusal was upheld on 11 October 2005 by the appellate prosecutor"^^xsd:string .

