doc:case_46503_99 a echr:CaseDocument ;
    echr:hasApplicant doc:klimentyev ;
    echr:hasApplicationNumber "46503/99"^^xsd:string ;
    echr:hasCaseName "Andrey Anatolyevitch KLIMENTYEV against Russia"^^xsd:string ;
    echr:hasDomesticProceeding doc:appeal_1,
        doc:appeal_2,
        doc:trial_1,
        doc:trial_2 ;
    echr:hasRespondentState "Russia"^^xsd:string .

