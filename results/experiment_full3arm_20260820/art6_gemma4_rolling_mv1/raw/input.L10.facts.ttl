        doc:participation_applicant_spouse_1 ;
    echr:hasSupportingQuote "On 13 September 2016 the Aliens Office, the administrative body responsible for issuing visas (see paragraph 45 below), refused to grant “humanitarian visas” to the applicants"^^xsd:string .

doc:visa_refusal_action_2 a echr:AdministrativeAction ;
    rdfs:label "new refusal decisions of 10 October 2016"^^xsd:string ;
