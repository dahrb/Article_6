doc:stayActionTpiDutch a echr:DomesticProceeding ;
    rdfs:label "unilateral action for stay of execution before President of Brussels Dutch-speaking TPI"^^xsd:string ;
    echr:hasCourt doc:tpiBrusselsDutch ;
    echr:hasDecisionDate "2016-12-13"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationStateStayTpiDutch ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "the Belgian State... lodged a unilateral action to that effect with the President of the Brussels Dutch ‐ speaking TPI on 13 December 2016, but was unsuccessful (order of the same date)"^^xsd:string .

