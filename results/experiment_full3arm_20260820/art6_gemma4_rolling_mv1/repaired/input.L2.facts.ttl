<https://growgraph.dev/doc/1d3abbb7e196> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:2"^^xsd:string .

doc:agreementBeerT a echr:AdministrativeAction ;
    rdfs:label "Employment termination agreement between Mr Beer and T"^^xsd:string ;
    echr:hasDecisionDate "1995-06-20"^^xsd:date ;
    echr:hasSupportingQuote "Under the terms of an agreement concluded on 20 June 1995 with the first applicant, terminating his contract of employment on 30 June 1995, the company T. undertook to pay"^^xsd:string .

doc:agreementReganTi a echr:AdministrativeAction ;
    rdfs:label "Employment termination settlement between Mr Regan and T.I."^^xsd:string ;
    echr:hasSupportingQuote "According to this settlement, the second applicant’s employment with the company T.I. had terminated on 31 December 1993"^^xsd:string .

doc:caseBeerRegan a echr:CaseDocument ;
    rdfs:label "Beer and Regan v. Germany"^^xsd:string ;
    echr:hasApplicant doc:karlheinzBeer,
        doc:philipRegan ;
    echr:hasApplicationNumber "28934/95"^^xsd:string ;
    echr:hasCaseName "Beer and Regan v. Germany"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceedingDismissalTi,
        doc:proceeding_status_esa_1 ;
    echr:hasJudgmentDate "1999-02-18"^^xsd:date ;
    echr:hasRespondentState "Federal Republic of Germany"^^xsd:string .

doc:committeeStaffRepresentatives a echr:Party ;
    rdfs:label "Committee of Staff Representatives of the Coordinated Organisations"^^xsd:string ;
    echr:hasPartyName "Committee of Staff Representatives of the Coordinated Organisations"^^xsd:string .

doc:esro a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "ESRO"^^xsd:string ;
    echr:hasAuthorityName "ESRO"^^xsd:string ;
    echr:hasJurisdictionState "International"^^xsd:string .

doc:germanCourts a echr:DomesticAuthority ;
    rdfs:label "German courts"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "German courts"^^xsd:string ;
    echr:hasJurisdictionState "Germany"^^xsd:string ;
    echr:hasSupportingQuote "the German courts did not exceed their margin of appreciation"^^xsd:string .

doc:governmentGermany a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Government of the Federal Republic of Germany"^^xsd:string ;
    echr:hasAuthorityName "Government of the Federal Republic of Germany"^^xsd:string ;
