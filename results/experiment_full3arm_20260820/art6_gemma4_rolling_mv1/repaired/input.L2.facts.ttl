doc:proceedingDismissalBeer a echr:DomesticProceeding ;
    rdfs:label "Proceedings against T regarding dismissal of Mr Beer"^^xsd:string ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeSettled ;
    echr:hasOutcomeDirection echr:DirectionMixed ;
    echr:hasParticipation doc:participation_beer_t_1,
        doc:participation_t_beer_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "lawyer’s fees incurred in labour court proceedings concerning his dismissal"^^xsd:string .

doc:proceedingEsaAppealsBoard a echr:DomesticProceeding ;
    rdfs:label "Potential proceedings before the ESA Appeals Board"^^xsd:string ;
    echr:hasCourt doc:appealsBoardEsa ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "the remedies available to the applicants were in particular an appeal to the ESA Appeals Board if they wished to assert contractual rights"^^xsd:string .

doc:proceedingFederalLabourCourt a echr:DomesticProceeding ;
    rdfs:label "Proceedings before the Federal Labour Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_status_esa_1 ;
    echr:hasCourt doc:federalLabourCourtGermany ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_beer_federal_1,
        doc:participation_esa_federal_1,
        doc:participation_regan_federal_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "the reasons advanced by the German labour courts to give effect to the immunity from jurisdiction of ESA"^^xsd:string .

doc:proceedingLabourCourtGeneral a echr:DomesticProceeding ;
    rdfs:label "Labour court proceedings regarding contractual relationship"^^xsd:string ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:participationBeerLabourGen,
        doc:participationEsaLabourGen,
        doc:participationReganLabourGen ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "the labour court proceedings instituted by the applicants involved the ‘determination of [their] civil rights and obligations’"^^xsd:string .

doc:appealsBoardEsa a echr:DomesticAuthority ;
    rdfs:label "Appeals Board of the Agency"^^xsd:string,
        "ESA Appeals Board"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "Appeals Board"^^xsd:string,
        "ESA Appeals Board"^^xsd:string ;
    echr:hasJurisdictionState "International"^^xsd:string ;
    echr:hasSupportingQuote "the ESA Appeals Board, which is ‘independent of the Agency’, has jurisdiction ‘to hear disputes relating to any explicit or implicit decision taken by the Agency and arising between it and a staff member’"^^xsd:string .

