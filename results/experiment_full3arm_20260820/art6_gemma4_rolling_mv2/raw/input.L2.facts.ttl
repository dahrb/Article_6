doc:caseBeerRegan a echr:CaseDocument ;
    rdfs:label "Beer and Regan v. Germany"^^xsd:string ;
    echr:hasApplicant doc:karlheinzBeer,
        doc:philipRegan ;
    echr:hasApplicationNumber "28934/95"^^xsd:string ;
    echr:hasCaseName "Beer and Regan v. Germany"^^xsd:string ;
    echr:hasDomesticProceeding doc:application_lodged_1995,
        doc:commissionAdmissibilityDecision,
        doc:commission_opinion_1997,
        doc:proceedingDismissalTi,
        doc:proceedingStatusEsa ;
    echr:hasJudgmentDate "1999-02-18"^^xsd:date ;
    echr:hasRespondentState "Federal Republic of Germany"^^xsd:string .

doc:esaAppealsBoardProceeding a echr:DomesticProceeding ;
    rdfs:label "Potential recourse to ESA Appeals Board"^^xsd:string ;
    echr:hasCourt doc:appealsBoardEsa ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasParticipation doc:partBeerAppeals,
        doc:partReganAppeals ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "the remedies available to the applicants were in particular an appeal to the ESA Appeals Board if they wished to assert contractual rights"^^xsd:string .

doc:esa_staff_regulations_33_1 a echr:AdministrativeAction ;
    rdfs:label "ESA Staff Regulation 33 § 1"^^xsd:string ;
    echr:hasSupportingQuote "Regulation 33 § 1 of the ESA Staff Regulations"^^xsd:string .

