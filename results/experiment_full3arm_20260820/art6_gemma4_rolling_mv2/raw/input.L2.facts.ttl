    echr:hasSupportingQuote "lodged with the Commission under former Article 25 by a German national, Mr Karlheinz Beer, and by a British national, Mr Philip Regan, on 13 September 1995."^^xsd:string .

doc:commission_opinion_1997 a echr:DomesticProceeding ;
    rdfs:label "Commission Opinion on Violation"^^xsd:string ;
