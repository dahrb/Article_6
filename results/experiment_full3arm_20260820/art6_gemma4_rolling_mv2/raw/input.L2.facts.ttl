    echr:hasDecisionDate "1997-12-02"^^xsd:date ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "In its report of 2 December 1997 (former Article 31 of the Convention) it expressed the opinion that there had been no violation of Article 6 § 1 of the Convention"^^xsd:string .

