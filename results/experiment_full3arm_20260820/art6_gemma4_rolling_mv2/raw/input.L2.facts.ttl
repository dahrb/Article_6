    echr:hasSupportingQuote "establishing a European Space Operations Centre"^^xsd:string .

doc:esro a echr:Party ;
    rdfs:label "ESRO"^^xsd:string ;
    echr:hasPartyName "ESRO"^^xsd:string ;
    echr:hasSupportingQuote "concluded between the Government of the Federal Republic of Germany and ESRO"^^xsd:string .

doc:eventBeerSettlement a echr:AdministrativeAction ;
    rdfs:label "Settlement between Mr Karlheinz Beer and Company T"^^xsd:string ;
    echr:hasDecisionDate "1995-06-20"^^xsd:date ;
    echr:hasExtractionNote "Settlement amounts: DEM 14,000 for lawyer's fees and DEM 305,000 for loss of job"^^xsd:string ;
    echr:hasParticipation doc:partBeerSettlement,
        doc:partTSettlement ;
    echr:hasSupportingQuote "Under the terms of an agreement concluded on 20 June 1995 with the first applicant, terminating his contract of employment on 30 June 1995, the company T. undertook to pay to the first applicant the sum of DEM 14,000 for lawyer’s fees incurred in labour court proceedings concerning his dismissal and DEM 305,000 for the loss of his job."^^xsd:string .

doc:eventEsaPlacement a echr:AdministrativeAction ;
    rdfs:label "Placement at European Space Agency"^^xsd:string ;
    echr:hasDecisionDate "1982"^^xsd:gYear ;
    echr:hasSupportingQuote "In 1982 the first applicant, a civil engineer by profession and employed by the French company S., was placed at the disposal of the European Space Agency"^^xsd:string .

doc:eventReganPlacement a echr:AdministrativeAction ;
    rdfs:label "Placement of Mr Philip Regan at ESA"^^xsd:string ;
    echr:hasDecisionDate "1991"^^xsd:gYear ;
    echr:hasSupportingQuote "The second applicant, a systems programmer and employed by the Italian company T.I., was placed at the disposal of the European Space Agency to perform services at the European Space Operations Centre in Darmstadt in 1991."^^xsd:string .

doc:eventReganSettlement a echr:AdministrativeAction ;
    rdfs:label "Settlement between Mr Philip Regan and Company T.I."^^xsd:string ;
    echr:hasDecisionDate "1994-09-06"^^xsd:date ;
    echr:hasExtractionNote "Settlement amount: 22,000 DEM for loss of job"^^xsd:string ;
    echr:hasParticipation doc:partReganTi,
        doc:partTiSettlement ;
    echr:hasSupportingQuote "According to this settlement, the second applicant’s employment with the company T.I. had terminated on 31 December 1993, and the company T.I. undertook to pay to the second applicant the sum of 22,000 marks (DEM) for loss of job."^^xsd:string .

doc:foreignFirmClaims a echr:DomesticProceeding ;
    rdfs:label "Potential claims against hiring foreign firms"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:partBeerFirms,
        doc:partReganFirms ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "the applicants were also left with other possibilities, such as claiming compensation from the foreign firm which had hired them out"^^xsd:string .

doc:governmentGermany a echr:Party ;
