doc:proceedingDismissalTi a echr:DomesticProceeding ;
    rdfs:label "Proceedings against T.I. for dismissal"^^xsd:string ;
    echr:followsProceeding doc:eventReganDismissal ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1994-09-06"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeSettled ;
    echr:hasOutcomeDirection echr:DirectionMixed ;
    echr:hasParticipation doc:partReganTi,
        doc:partTiTi ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "In the proceedings instituted by the second applicant against his dismissal by the company T.I.... a settlement had been reached in the Darmstadt Labour Court on 6 September 1994."^^xsd:string .

doc:proceedingStatusEsa a echr:DomesticProceeding ;
    rdfs:label "Proceedings against ESA for employee status"^^xsd:string ;
    echr:followsProceeding doc:proceedingWaiteKennedy ;
    echr:hasCourt doc:darmstadtLabourCourt,
        doc:germanCourts ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasExtractionNote "Action brought under the German Provision of Labour (Temporary Staff) Act"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partBeerEsa,
        doc:partCommitteeStaff,
        doc:partEsaEsa,
        doc:partReganTi,
        doc:part_esa_status_2 ;
    echr:hasProceedingStartDate "1993-10"^^xsd:gYearMonth ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "In October and November 1993 the applicants instituted proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA... On 21 March 1995 the Darmstadt Labour Court... declared the applicants’ respective actions inadmissible."^^xsd:string,
        "The Labour Court considered that ESA enjoyed immunity from jurisdiction according to the ESA Convention and its Annex I."^^xsd:string,
        "The applicants had access to the Darmstadt Labour Court, only to be told that their action was barred by operation of law."^^xsd:string,
        "the Darmstadt Labour Court concluded that the conditions under section 20(2) of the German Courts Act for finding that the applicants’ action was inadmissible were fulfilled."^^xsd:string .

