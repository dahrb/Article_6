doc:appealConviction a echr:DomesticProceeding ;
    rdfs:label "Appeal against conviction"^^xsd:string ;
    echr:followsProceeding doc:applicationStay,
        doc:trialConviction ;
    echr:hasCourt doc:courtOfAppealUk ;
    echr:hasDecisionDate "2000-02-10"^^xsd:date ;
    echr:hasExtractionNote "The Court of Appeal certified two points of law of general importance regarding the admissibility of evidence of other criminal activity and jury instructions on propensity."^^xsd:string ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partSawoniukAppeal ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "In its judgment of 10 February 2000, the Court of Appeal rejected the applicant’s appeal."^^xsd:string .

doc:applicationEvidenceExclusion a echr:DomesticProceeding ;
    rdfs:label "Application to exclude evidence of Baglay and Melianuk"^^xsd:string ;
    echr:hasCourt doc:courtPotts ;
    echr:hasDecisionDate "1999-02-08"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "the defence made an application that the evidence of two witnesses, Ivan Baglay and Evgeny Melianuk, be excluded as inadmissible. On 8 February 1999, the judge ruled that the evidence of both witnesses was relevant and admissible"^^xsd:string .

doc:applicationProvenance a echr:DomesticProceeding ;
    rdfs:label "Application to call evidence on provenance of missing persons document"^^xsd:string ;
    echr:followsProceeding doc:trialSawoniuk ;
    echr:hasCourt doc:courtPotts ;
    echr:hasDecisionDate "1999-03-24"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partProsecutionProvenance ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "The prosecution made an application to the judge to call evidence to prove the provenance of the missing persons document in order to rebut the allegation of fabrication. On 24 March 1999, the judge refused the application."^^xsd:string .

doc:applicationStay a echr:DomesticProceeding ;
    rdfs:label "Application to stay trial"^^xsd:string ;
    echr:hasCourt doc:courtPotts ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeOther ;
    echr:hasSupportingQuote "the trial should be stayed as an abuse on the basis that due inter alia to the lapse of time since events the applicant could not obtain a fair trial. The application was refused by the trial judge"^^xsd:string .

