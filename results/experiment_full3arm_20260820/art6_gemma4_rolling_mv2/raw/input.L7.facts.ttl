doc:partial_acquittal_counts_2_4 a echr:DomesticProceeding ;
    rdfs:label "Partial acquittal on counts 2 and 4"^^xsd:string ;
    echr:followsProceeding doc:trialSawoniuk ;
    echr:hasCourt doc:courtPotts ;
    echr:hasOutcome echr:OutcomeAcquittal ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "the judge ruled that there was insufficient evidence as a matter of law to support a conviction on counts 2 and 4 and that the applicant should be acquitted"^^xsd:string .

doc:petitionHouseOfLords a echr:DomesticProceeding ;
    rdfs:label "Petition for leave to appeal to the House of Lords"^^xsd:string ;
