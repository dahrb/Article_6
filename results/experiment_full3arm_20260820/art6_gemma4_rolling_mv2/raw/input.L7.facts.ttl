doc:tariffRecommendation a echr:DomesticEvent ;
    rdfs:label "Tariff recommendation"^^xsd:string ;
    echr:hasCourt doc:lordChiefJustice ;
    echr:hasSupportingQuote "The Lord Chief Justice recommended a tariff (the period to be served for retribution and deterrence) of five years."^^xsd:string .

