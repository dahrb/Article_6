doc:proceedingConstitutionalCourtStanding a echr:DomesticProceeding ;
    rdfs:label "Constitutional Court individual application on enforcement failure"^^xsd:string ;
    echr:hasCourt doc:constitutionalCourtTr ;
    echr:hasExtractionNote "compensation mechanisms provided under section 28(3) and (4) of Law no. 2577"^^xsd:string,
        "violation of property rights under Article 35 of the Constitution"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelConstitutional ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participationAksoyConstStanding,
        doc:participationSdifConstStanding ;
    echr:hasSupportingQuote "The Constitutional Court concluded that the administration’s failure to enforce the annulment decisions amounted to a violation of the applicant’s property rights"^^xsd:string .

doc:proceedingSacStandingD a echr:DomesticProceeding ;
    rdfs:label "Supreme Administrative Court proceeding on standing regarding Company D"^^xsd:string ;
    echr:followsProceeding doc:proceedingFirstInstanceAdminD ;
    echr:hasCourt doc:administrativeCourtTr ;
    echr:hasDecisionDate "2006-07-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participationAksoySacStandingD,
        doc:participation_sdif_sac_13 ;
    echr:hasSupportingQuote "On 20 July 2006, the Supreme Administrative Court... quashed the administrative court’s earlier decision."^^xsd:string .

