    echr:hasSupportingQuote "on 3 May 2012, the Fund approved the award of Viva TV-Radio Viva to company A."^^xsd:string .

doc:actionDefaultResolution a echr:AdministrativeAction ;
    rdfs:label "Resolution to rely on default provisions"^^xsd:string ;
    echr:followsProceeding doc:liquidationProtocolEvent ;
    echr:hasCourt doc:sdifAuthority ;
    echr:hasDecisionDate "2008-04-03"^^xsd:date ;
    echr:hasParticipation doc:participationAksoyDefault,
        doc:participationSdifDefault ;
    echr:hasSupportingQuote "On 3 April 2008, the Fund concluded that the Erol Aksoy Group had failed to fulfil several commitments and obligations set out in the Liquidation Protocol, rendering the Protocol no longer effective for the recovery of public receivables. Consequently, the Fund decided to rely on its provisions concerning default. It resolved to initiate legal proceedings against all natural and legal person debtors within the Erol Aksoy Group and to proceed with the sale of assets, including those consolidated as an economic and commercial unit."^^xsd:string,
        "On 3 April 2008, the Fund concluded that the Erol Aksoy Group had failed to fulfil several commitments... the Fund decided to rely on its provisions concerning default."^^xsd:string .

doc:actionMergeUnits a echr:AdministrativeAction ;
