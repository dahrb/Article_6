doc:actionConsolidateRadioViva a echr:AdministrativeAction ;
    rdfs:label "Consolidation of assets into Radio Viva economic unit"^^xsd:string ;
    echr:followsProceeding doc:actionEstablishUnits ;
    echr:hasCourt doc:sdifAuthority ;
    echr:hasParticipation doc:participationSdifConsolidateTv ;
    echr:hasSupportingQuote "A similar resolution was adopted regarding Radio Viva. The Fund decided that the seized assets... utilised by Radio Viva... would also be consolidated into a single economic and commercial unit."^^xsd:string .

doc:actionConsolidateVivaTv a echr:AdministrativeAction ;
    rdfs:label "Consolidation of assets into Viva TV economic unit"^^xsd:string ;
    echr:followsProceeding doc:actionEstablishUnits ;
    echr:hasCourt doc:sdifAuthority ;
    echr:hasParticipation doc:participationSdifConsolidateTv,
        doc:participationVivaCineDijital,
        doc:participationVivaCinebes,
        doc:participationVivaErdem,
        doc:participationVivaKutyay,
        doc:participationVivaMultikanal,
        doc:participationVivaSporCocuk ;
    echr:hasSupportingQuote "the Fund resolved to consolidate all seized assets... belonging to debtor companies within the Erol Aksoy Group and effectively used by Viva TV into a single economic and commercial unit."^^xsd:string .

