doc:agreement_debt_repayment_2005 a echr:AdministrativeAction ;
    rdfs:label "Debt Repayment Agreement 28 Oct 2005"^^xsd:string ;
    echr:hasDecisionDate "2005-10-28"^^xsd:date ;
    echr:hasSupportingQuote "LLC paid off the rest of the debt, namely USD 600,000"^^xsd:string,
        "a debt repayment schedule which was set up in a separate agreement signed on the same day"^^xsd:string,
        "applicant company agreed to provide debt relief in the amount of USD 613,824"^^xsd:string,
        "the LLC owed 1,213,824 US dollars (USD) to the applicant company"^^xsd:string .

doc:agreement_loan_repayment_2005 a echr:AdministrativeAction ;
    rdfs:label "Loan Repayment Agreement 28 Oct 2005"^^xsd:string ;
    echr:hasDecisionDate "2005-10-28"^^xsd:date ;
    echr:hasSupportingQuote "additional 6% would be payable"^^xsd:string,
        "the parties concluded another agreement, setting out a repayment schedule in respect of the loan of EUR 100,000"^^xsd:string .

