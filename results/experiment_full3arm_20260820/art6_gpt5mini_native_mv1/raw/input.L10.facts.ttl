    echr:hasCourt doc:aliensOffice ;
    echr:hasDecisionDate "2016-09-29"^^xsd:date ;
    echr:hasSupportingQuote "informed them of its decisions by an email of 29 September 2016, transmitted through the visa department of the Belgian embassy in Beirut."^^xsd:string .

doc:proceeding_applicants_enforcement_2016_12_15 a echr:DomesticProceeding ;
    rdfs:label "applicants' action before the enforcement judge at the Brussels French-language TPI (15 December 2016)"@en ;
    echr:followsProceeding doc:enforcement_payment_order_2016_12_13 ;
    echr:hasCourt doc:authorityBrusselsFrenchTpi ;
