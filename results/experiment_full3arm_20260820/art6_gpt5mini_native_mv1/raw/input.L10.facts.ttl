doc:case_3599_18 a echr:CaseDocument ;
    rdfs:label "Application no. 3599/18 M.N. and Others against Belgium"@en ;
    echr:hasApplicationNumber "3599/18"^^xsd:string ;
    echr:hasExtractionNote "No domestic proceedings described in the provided excerpt: the procedural paragraphs instead record the Strasbourg allocation, relinquishment to the Grand Chamber and hearing dates."^^xsd:string ;
    echr:hasRespondentState "Belgium"^^xsd:string ;
    echr:hasSupportingQuote "The case originated in an application (no. 3599/18) against Belgium lodged with the Court under Article 34 of the Convention for the Protection of Human Rights and Fundamental Freedoms (“the Convention”) on 10 January 2018 by a married couple and their two minor children, all Syrian nationals (“the applicants”)."^^xsd:string .

doc:case_document_case_1 a echr:CaseDocument ;
    rdfs:label "ECHR case document"@en ;
    echr:hasApplicant doc:partyTheApplicants .

doc:court_of_appeal_judgment_2016_12_07 a echr:DomesticProceeding ;
    rdfs:label "The court of appeal’s judgment of 7 December 2016"^^xsd:string ;
    echr:followsProceeding doc:aliens_office_refusal_2016_09_13 ;
    echr:hasCourt doc:court_appeal_1 ;
    echr:hasDecisionDate "2016-12-07"^^xsd:date ;
    echr:hasParticipation doc:participation_applicants_court_2016_12_07 ;
    echr:hasSupportingQuote "The court of appeal’s judgment of 7 December 2016 was thus no longer operative, given that the Aliens Office’s refusal decisions of 13 September 2016 had become final and irrevocable before the penalty payment was issued against the Belgian State."^^xsd:string .

doc:enforcement_action_2017_12_20 a echr:EnforcementAction ;
    rdfs:label "On 20 December 2017 the French-language enforcement judge, examining the action brought by the applicants on 15 December 2016, found that the case had become devoid of purpose following the Brussels Court of Appeal’s judgment of 30 June 2017."^^xsd:string ;
