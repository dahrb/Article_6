doc:appealOnPointsOfLawToConseil a echr:DomesticProceeding ;
    rdfs:label "an appeal on points of law against the decisions of the Aliens Appeals Board lies to the Conseil d’État"^^xsd:string ;
    echr:followsProceeding doc:applicationSetAsideAliensAppealsBoard ;
    echr:hasCourt doc:conseilDEtatAuthority ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasParticipation doc:participationAliensAppealsBoard,
        doc:participationRequestingConseil ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "Under section 39/67 of the Aliens Act, an appeal on points of law against the decisions of the Aliens Appeals Board lies to the Conseil d’État ."^^xsd:string .

doc:appeal_points_of_law_1 a echr:DomesticProceeding ;
