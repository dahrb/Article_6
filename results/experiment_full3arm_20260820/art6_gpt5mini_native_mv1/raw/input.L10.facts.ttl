doc:partyTheApplicants a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "the applicants"^^xsd:string,
        "the applicants"@en ;
    echr:hasPartyName "the applicants"^^xsd:string ;
    echr:hasPersonName "the applicants"@en ;
    echr:hasSupportingQuote "The applicants stated that they were unable to follow the advice of the Belgian Government and intended to seek enforcement of the Brussels Court of Appeal’s judgment, in view of the urgency of their personal situation and the disastrous humanitarian conditions prevailing for Syrians in Lebanon."^^xsd:string .

doc:aliensOffice a echr:DomesticAuthority,
