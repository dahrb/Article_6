    echr:hasSupportingQuote "an appeal on points of law may be lodged against judgments given on appeal."^^xsd:string .

doc:belgianAuthoritiesRefusalVisa a echr:EnforcementAction ;
    rdfs:label "the Belgian authorities' refusal to issue the so-called “humanitarian” visas"^^xsd:string ;
    echr:followsProceeding doc:proceeding_brussels_court_20161207 ;
    echr:hasCourt doc:applicants ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationRefusalApplicant,
        doc:participationRefusalState ;
    echr:hasSupportingQuote "the Belgian authorities’ refusal to issue them with the so-called “humanitarian” visas had exposed them to a situation incompatible with Article 3 of the Convention"^^xsd:string .

