doc:proceeding_court_of_appeal_variation_2016_12_14 a echr:DomesticProceeding ;
    rdfs:label "court of appeal varied the decision of the first-instance court (14 December 2016)"@en ;
    echr:followsProceeding doc:proceeding_unilateral_stay_2016_12_13 ;
    echr:hasCourt doc:court_appeal_1 ;
    echr:hasDecisionDate "2016-12-14"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_applicants_appeal_2016_12_14,
        doc:participation_state_appeal_2016_12_14 ;
    echr:hasSupportingQuote "However, on an appeal by the Belgian State, the court of appeal varied the decision of the first-instance court in a judgment of 14 December 2016. It noted the Belgian State’s intention to raise the difficulties of complying with the judgment of 7 December 2016 with the enforcement judge (“ le juge des saisies ”) and ordered the applicants not to pursue further enforcement proceedings pending a decision by the enforcement judge who was to rule on the validity of the enforcement procedure and the State’s right to restrict the amounts due in respect of penalty payments."^^xsd:string .

doc:proceeding_inter_partes_2016_11_07 a echr:DomesticProceeding ;
    rdfs:label "Inter partes order of 7 November 2016 by the French-language TPI"^^xsd:string ;
    echr:followsProceeding doc:proceeding_unilateral_application_2016_10_25 ;
    echr:hasCourt doc:brusselsTpiFrenchLanguage ;
    echr:hasDecisionDate "2016-11-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_tpi7_applicants,
        doc:participation_tpi7_belgian_state ;
    echr:hasSupportingQuote "On 7 November 2016 another judge acting as president of the French‐language TPI declared their application admissible but unfounded"^^xsd:string .

doc:proceeding_unilateral_application_2016_10_25 a echr:DomesticProceeding ;
    rdfs:label "Order of 25 October 2016 by acting president of the French-language TPI"^^xsd:string ;
    echr:hasCourt doc:brusselsTpiFrenchLanguage ;
    echr:hasDecisionDate "2016-10-25"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_tpi25_applicants,
        doc:participation_tpi25_belgian_state ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "By an order of 25 October 2016, ... the acting president of the French-language TPI ordered the State, as an urgent measure, to comply with the Board’s judgment of 20 October 2016, that is, to issue the applicants with visas or laissez-passers , and made the order subject to a penalty payment of 1,000 euros (EUR) per day of delay and per applicant."^^xsd:string .

