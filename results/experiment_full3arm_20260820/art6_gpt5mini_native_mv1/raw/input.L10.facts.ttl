    echr:hasSupportingQuote "On 15 December 2016 the applicants brought an action against the Belgian State before the enforcement judge at the Brussels French-language TPI, seeking to ensure that the payment order of 13 December 2016 was executed."^^xsd:string .

doc:proceeding_cassation_2017_02_27 a echr:DomesticProceeding ;
    rdfs:label "appeal on points of law lodged by the Belgian State (27 February 2017)"@en ;
    echr:followsProceeding doc:proceeding_court_of_appeal_2016_12_07 ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasParticipation doc:participation_applicants_cassation_2017_02_27,
        doc:participation_state_cassation_2017_02_27 ;
    echr:hasProceedingStartDate "2017-02-27"^^xsd:date ;
    echr:hasSupportingQuote "On 27 February 2017 the Belgian State lodged an appeal on points of law against the court of appeal’s judgment of 7 December 2016. Those proceedings are currently pending."^^xsd:string ;
    echr:isPending true .

doc:proceeding_state_enforcement_2016_12_15 a echr:DomesticProceeding ;
    rdfs:label "Belgian State proceedings before the enforcement judge at the Brussels Dutch - language TPI (15 December 2016)"@en ;
    echr:followsProceeding doc:proceeding_court_of_appeal_variation_2016_12_14 ;
    echr:hasCourt doc:authorityBrusselsDutchTpi ;
    echr:hasParticipation doc:participation_applicants_enforcement_2016_12_15,
        doc:participation_state_appeal_2016_12_14 ;
    echr:hasProceedingStartDate "2016-12-15"^^xsd:date ;
    echr:hasSupportingQuote "On the same date the Belgian State brought proceedings against the applicants before the enforcement judge at the Brussels Dutch ‐ language TPI, seeking a stay of execution of the principal sentence ( condamnation principale ) resulting from the Aliens Appeals Boards’ judgment of 20 October 2016 (obligation to issue visas or laissez ‐ passers ) and/or a stay of execution of the court of appeal’s judgment of 7 December 2016, and/or to prevent other enforcement measures, such as penalty payments. In the alternative, the State requested a finding that the conditions for a judicial deposit arrangement (“ cantonnement ”) had been met."^^xsd:string .

doc:refusal_correspondence_2016_12_12 a echr:AdministrativeAction ;
    rdfs:label "correspondence of 12 and 13 December 2016 from the lawyers to the Belgian State"^^xsd:string ;
    echr:hasCourt doc:belgianState ;
    echr:hasExtractionNote "Correspondence dated 12 and 13 December 2016"^^xsd:string ;
    echr:hasSupportingQuote "In correspondence of 12 and 13 December 2016, the lawyers to the Belgian State informed the applicants that the Belgian authorities were refusing to issue the laissez-passers or long-stay visas requested by them"^^xsd:string .

