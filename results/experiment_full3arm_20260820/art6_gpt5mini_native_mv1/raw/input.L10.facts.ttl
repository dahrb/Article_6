    echr:hasCourt doc:authorityJugeDesSaisies ;
    echr:hasInstanceLevel echr:LevelEnforcement ;
    echr:hasParticipation doc:participationEnforcementAnyInterested ;
    echr:hasSupportingQuote "any interested party can apply to the enforcement judge (“ juge des saisies ”) on the basis of Article 1498 of the Judicial Code, without, however, such an application having suspensive effect."^^xsd:string .

