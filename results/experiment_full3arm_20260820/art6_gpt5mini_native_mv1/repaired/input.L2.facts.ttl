        "the applicants"@en ;
    echr:hasPartyName "the applicants"^^xsd:string ;
    echr:hasPersonName "The applicants"@en ;
    echr:hasSupportingQuote "Taking into account in particular the alternative means of legal process available to the applicants, it cannot be said that the limitation on their access to the German courts with regard to ESA impaired the essence of their “right to a court” or was disproportionate for the purposes of Article 6 § 1 of the Convention."^^xsd:string,
        "The applicants had access to the Darmstadt Labour Court, only to be told that their action was barred by operation of law."^^xsd:string .

doc:esa a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "ESA"^^xsd:string,
        "The European Space Agency (“ESA”)"^^xsd:string,
        "ESA"@en ;
    echr:hasAuthorityName "the Agency"^^xsd:string ;
    echr:hasPartyName "ESA"^^xsd:string,
        "The European Space Agency (“ESA”)"^^xsd:string,
        "ESA"@en ;
    echr:hasSupportingQuote "ESA"^^xsd:string,
        "ESA was formed out of ESRO and ELDO as a new and single organisation (see paragraph 12 above)."^^xsd:string,
        "The European Space Agency (“ESA”) with headquarters in Paris, formed out of the European Space Research Organisation (“ESRO”) and the European Organisation for the Development and Construction of Space Vehicle Launchers (“ELDO”), was established under the Convention for the Establishment of a European Space Agency (“ESA Convention”) of 30 May 1975 ( United Nations Treaty Series 1983, vol. 1297, I – no. 21524)."^^xsd:string,
        "in giving effect to the immunity from jurisdiction of ESA on the basis of section 20(2) of the Courts Act"^^xsd:string,
        "the defendant, ESA, had claimed immunity from jurisdiction in accordance with Article XV § 2 of the ESA Convention and Article IV § 1 of its Annex I."^^xsd:string,
        "their dispute with ESA"^^xsd:string .

