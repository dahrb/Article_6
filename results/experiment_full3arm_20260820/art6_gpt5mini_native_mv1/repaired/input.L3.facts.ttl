doc:fund_decision_2009_11_05 a echr:AdministrativeAction ;
    rdfs:label "On 5 November 2009, the Fund resolved to offer Viva TV-Radio Viva for sale, establishing a reserve price of USD 6,000,000. Although a company, P. A.ş., obtained the tender documents with the intention of submitting a bid, the tendering process was subsequently postponed."^^xsd:string ;
    echr:followsProceeding doc:fund_decision_2007_08_29 ;
    echr:hasDecisionDate "2009-11-05"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasParticipation doc:participation_fund_20091105 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 5 November 2009, the Fund resolved to offer Viva TV-Radio Viva for sale, establishing a reserve price of USD 6,000,000. Although a company, P. A.ş., obtained the tender documents with the intention of submitting a bid, the tendering process was subsequently postponed."^^xsd:string .

doc:fund_failure_to_enforce_1 a echr:AdministrativeAction ;
    rdfs:label "the Fund's failure to enforce the annulment judgments"^^xsd:string ;
    echr:followsProceeding doc:proceeding_annulment_judgments_1 ;
    echr:hasCourt doc:fund ;
    echr:hasParticipation doc:participation_fail_applicant_1,
        doc:participation_fail_fund_1 ;
    echr:hasSupportingQuote "The Fund justified its failure to enforce the judgment on the grounds that the economic and commercial unit had already been transferred to the successful bidder, thereby severing any legal connection between the Fund and the asset in question. It argued that enforcing the annulment judgment would violate the purchaser’s acquired rights and undermine legal certainty and public trust, particularly as the purchase amount had been duly paid. The Fund further asserted that implementation of the judgment was both legally and practically impossible."^^xsd:string .

