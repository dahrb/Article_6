doc:admin_proc_2011_02_07 a echr:DomesticProceeding ;
    rdfs:label "On 7 February 2011, the applicant initiated proceedings before the administrative court"^^xsd:string ;
    echr:followsProceeding doc:fund_decision_2011_01_13 ;
    echr:hasCourt doc:administrativeCourt ;
    echr:hasParticipation doc:participation_app_20110207,
        doc:participation_fund_20110207 ;
    echr:hasProceedingStartDate "2011-02-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 7 February 2011, the applicant initiated proceedings before the administrative court, contesting the actions of the Fund concerning the tendering of Viva TV-Radio Viva, in which he claimed to hold both direct and indirect shares. He alleged that the Fund had proceeded with the sale without providing him with prior notification and that he had only learned of the sale upon its publication in the Official Gazette. The applicant sought the annulment of all measures related to the sale, including the Fund’s decision of 13 January 2011, which approved the invitation to tender and the terms of sale and set the estimated value of Viva TV-Radio Viva at USD 6,000,000."^^xsd:string .

doc:administrative_action_fund_2015 a echr:AdministrativeAction ;
    rdfs:label "Fund decision of 27 October 2015 on impossibility of enforcing the judgment"^^xsd:string ;
    echr:hasCourt doc:fund ;
    echr:hasDecisionDate "2015-10-27"^^xsd:date ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "On 18 April 2016, the Fund notified the applicant of a decision taken on 27 October 2015 regarding the impossibility of enforcing the judgment."^^xsd:string,
        "Therefore, the Fund determined that the annulment decision could not be enforced, in terms of both legality and practicality."^^xsd:string .

doc:case_58919_18 a echr:CaseDocument ;
    rdfs:label "CASE OF EROL AKSOY v. TÜRKİYE (Application no. 58919/18)"^^xsd:string ;
    echr:hasApplicant doc:partyErolAksoy ;
    echr:hasApplicationNumber "58919/18"^^xsd:string ;
    echr:hasDomesticProceeding doc:enforcement_non_enforcement_by_sdif_1,
        doc:proceeding_annulment_valuation_tender_sale_1 ;
    echr:hasSupportingQuote "the application (no. 58919/18) against the Republic of Türkiye lodged with the Court under Article 34 of the Convention for the Protection of Human Rights and Fundamental Freedoms (\"the Convention\") by a Turkish national, Mr Erol Aksoy (\"the applicant\"), on 5 December 2018;"^^xsd:string .

doc:consolidationRadioViva a echr:AdministrativeAction ;
    rdfs:label "A similar resolution was adopted regarding Radio Viva. The Fund decided that the seized assets, rights, properties and associated components utilised by Radio Viva, including contracts and the rights arising therefrom, would also be consolidated into a single economic and commercial unit."^^xsd:string ;
    echr:followsProceeding doc:decision_establish_units_2007_07_19 ;
    echr:hasParticipation doc:partConsolAnadolu,
        doc:partConsolFundRadio ;
    echr:hasSupportingQuote "A similar resolution was adopted regarding Radio Viva. The Fund decided that the seized assets, rights, properties and associated components utilised by Radio Viva, including contracts and the rights arising therefrom, would also be consolidated into a single economic and commercial unit."^^xsd:string .

doc:consolidationVivaTv a echr:AdministrativeAction ;
    rdfs:label "With respect to Viva TV, the Fund resolved to consolidate all seized assets, rights, properties and associated components, such as contracts and the rights arising therefrom, belonging to debtor companies within the Erol Aksoy Group and effectively used by Viva TV into a single economic and commercial unit."^^xsd:string ;
    echr:followsProceeding doc:decision_establish_units_2007_07_19 ;
    echr:hasParticipation doc:partConsolCineDijital,
        doc:partConsolCinebes,
        doc:partConsolErdem,
        doc:partConsolFundViva,
        doc:partConsolKutyay,
        doc:partConsolMultikanal,
        doc:partConsolSpor ;
    echr:hasSupportingQuote "With respect to Viva TV, the Fund resolved to consolidate all seized assets, rights, properties and associated components, such as contracts and the rights arising therefrom, belonging to debtor companies within the Erol Aksoy Group and effectively used by Viva TV into a single economic and commercial unit."^^xsd:string .

doc:deposit_and_transfer_2012_05_09 a echr:AdministrativeAction ;
    rdfs:label "On 9 May 2012, company A. deposited the tender amount into the Fund’s bank account. On the same day, the parties signed the “Agreement on Takeover of Viva TV-Radio Viva” and the Fund transferred the ownership of Viva TV-Radio Viva to company A."^^xsd:string ;
    echr:followsProceeding doc:fund_approval_2012_05_03 ;
    echr:hasDecisionDate "2012-05-09"^^xsd:date ;
    echr:hasParticipation doc:participation_companyA_20120509,
        doc:participation_fund_20120509 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 9 May 2012, company A. deposited the tender amount into the Fund’s bank account. On the same day, the parties signed the “Agreement on Takeover of Viva TV-Radio Viva” and the Fund transferred the ownership of Viva TV-Radio Viva to company A."^^xsd:string .

doc:enforcementTenderTransfer a echr:EnforcementAction ;
    rdfs:label "collection of tender amount and transfer of Viva TV-Radio Viva to successful bidder"^^xsd:string ;
    echr:hasCourt doc:fund ;
    echr:hasSupportingQuote "The tendering process had proceeded with the necessary approvals from the relevant authorities. The Fund further explained that the tender amount had been collected and Viva TV-Radio Viva had been transferred to the bona fide successful bidder."^^xsd:string .

