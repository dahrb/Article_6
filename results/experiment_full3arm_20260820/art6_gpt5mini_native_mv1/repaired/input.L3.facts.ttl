doc:proc_constitutional_2017_2018 a echr:DomesticProceeding ;
    rdfs:label "Constitutional Court application (11 September 2017; decision 23 May 2018)"^^xsd:string ;
    echr:followsProceeding doc:adminaction_fund_enforcement_2017 ;
    echr:hasCourt doc:constitutionalCourt ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelConstitutional ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasParticipation doc:part_const_applicant_2017 ;
    echr:hasProceedingStartDate "2017-09-11"^^xsd:date ;
    echr:hasSupportingQuote "In a decision of 23 May 2018, the Constitutional Court observed that the final annulment judgment of the 13th Chamber of the Supreme Administrative Court had been served on the applicant on 28 July 2017 and determined that the thirty-day time-limit for lodging an individual application had commenced on that date. Noting that the applicant’s application had been submitted on 11 September 2017, after the expiry of the time-limit, the Constitutional Court declared the application inadmissible."^^xsd:string,
        "On 11 September 2017, the applicant lodged an individual application with the Constitutional Court, alleging violations of his right to property and his right to a fair trial due to the non-enforcement of the final judgment annulling the sale of Viva TV-Radio Viva."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:proc_supadm_rectif_2016_01_25 a echr:DomesticProceeding ;
    rdfs:label "Supreme Administrative Court - rejection of rectification request (25 January 2016)"^^xsd:string ;
    echr:followsProceeding doc:proc_general_assembly_2015_07_07 ;
    echr:hasCourt doc:administrativeCourt ;
    echr:hasDecisionDate "2016-01-25"^^xsd:date ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_20141209_applicant,
        doc:part_20141209_fund ;
    echr:hasSupportingQuote "On 25 January 2016, the Supreme Administrative Court rejected the Fund’s request for rectification, noting that the case had become final following the appeal and was no longer subject to rectification."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:proceeding_constitutional_1 a echr:DomesticProceeding ;
    rdfs:label "Constitutional Court individual application deciding enforcement obligation and remedies exhausted"^^xsd:string ;
    echr:followsProceeding doc:fund_failure_to_enforce_1 ;
    echr:hasCourt doc:constitutionalCourt ;
    echr:hasInstanceLevel echr:LevelConstitutional ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasParticipation doc:participation_const_fund_1,
        doc:participation_fi_applicant_1 ;
    echr:hasSupportingQuote "The Constitutional Court concluded that the administration’s failure to enforce the annulment decisions amounted to a violation of the applicant’s property rights under Article 35 of the Constitution."^^xsd:string .

doc:proceeding_supreme_admin_20060720 a echr:DomesticProceeding ;
    rdfs:label "Supreme Administrative Court decision (20 July 2006) finding applicant had legal interest and quashing earlier decision"^^xsd:string ;
    echr:followsProceeding doc:proceeding_first_instance_1 ;
    echr:hasCourt doc:administrativeCourt ;
    echr:hasDecisionDate "2006-07-20"^^xsd:date ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasParticipation doc:participation_fi_applicant_1,
        doc:participation_sup_fund_1 ;
    echr:hasSupportingQuote "On 20 July 2006, the Supreme Administrative Court, ruling unanimously, found that the applicant had a legal interest in the enforcement proceedings initiated under Law no. 6183, as he was the majority shareholder of İktisat Bank, which had been transferred to the Fund. The court held that the applicant had standing to challenge the transaction and quashed the administrative court’s earlier decision."^^xsd:string .

