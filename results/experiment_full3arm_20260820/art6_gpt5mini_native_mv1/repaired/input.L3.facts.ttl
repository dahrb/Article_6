doc:fund_default_decision_2008_04_03 a echr:AdministrativeAction ;
    rdfs:label "On 3 April 2008, the Fund concluded that the Erol Aksoy Group had failed to fulfil several commitments and obligations set out in the Liquidation Protocol, rendering the Protocol no longer effective for the recovery of public receivables. Consequently, the Fund decided to rely on its provisions concerning default. It resolved to initiate legal proceedings against all natural and legal person debtors within the Erol Aksoy Group and to proceed with the sale of assets, including those consolidated as an economic and commercial unit."^^xsd:string ;
    echr:hasDecisionDate "2008-04-03"^^xsd:date ;
    echr:hasParticipation doc:part_default_debtors_2008_04_03,
        doc:part_default_fund_2008_04_03 ;
    echr:hasSupportingQuote "On 3 April 2008, the Fund concluded that the Erol Aksoy Group had failed to fulfil several commitments and obligations set out in the Liquidation Protocol, rendering the Protocol no longer effective for the recovery of public receivables. Consequently, the Fund decided to rely on its provisions concerning default. It resolved to initiate legal proceedings against all natural and legal person debtors within the Erol Aksoy Group and to proceed with the sale of assets, including those consolidated as an economic and commercial unit."^^xsd:string .

