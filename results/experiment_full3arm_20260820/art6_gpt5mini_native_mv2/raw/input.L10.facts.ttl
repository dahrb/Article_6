doc:legal_reference_visa_code_810 a echr:AdministrativeAction ;
    rdfs:label "Regulation (EC) No. 810/2009 (Visa Code)"^^xsd:string ;
    echr:hasExtractionNote "13 July 2009"^^xsd:string,
        "Regulation (EC) No. 810/2009"^^xsd:string,
