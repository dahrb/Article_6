doc:administrative_action_refusal_2016_09_13 a echr:AdministrativeAction ;
    rdfs:label "Aliens Office refusal of humanitarian visas"^^xsd:string ;
    echr:followsProceeding doc:visa_application_submission_2016_08_22 ;
    echr:hasCourt doc:aliensOffice ;
    echr:hasDecisionDate "2016-09-13"^^xsd:date ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationAliensOfficeRefusal,
        doc:participationApplicantsRefusal ;
    echr:hasSupportingQuote "On 13 September 2016 the Aliens Office, the administrative body responsible for issuing visas (see paragraph 45 below), refused to grant “humanitarian visas” to the applicants and informed them of its decisions by an email of 29 September 2016, transmitted through the visa department of the Belgian embassy in Beirut."^^xsd:string .

doc:aliens_appeals_board_decision_2016_10_20 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board judgment 20 October 2016"^^xsd:string ;
    echr:followsProceeding doc:admin_decision_2016_10_17 ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2016-10-20"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_aliensappeals_aliens_office_2016_10_20,
        doc:participation_applicants_aliens_appeals_2016_10_20 ;
    echr:hasSupportingQuote "By a judgment of 20 October 2016 the Aliens Appeals Board, essentially reiterating the substance of its previous judgments, ordered a stay of execution of the refusal decisions of 17 October 2016. In addition, in view of the imminent danger faced by the applicants, the Belgian State’s persistent refusal to comply with res judicata authority and the importance of ensuring that the remedy was effective, it considered that it was justified to direct the State to issue the applicants, within 48 hours, with laissez-passers or visas, valid for three months."^^xsd:string .

