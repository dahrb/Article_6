doc:admin_welfare_report_2002_07_23 a echr:AdministrativeAction ;
    rdfs:label "Ruse social services welfare report 23-07-2002"^^xsd:string ;
    echr:followsProceeding doc:admin_application_social_services_2002_05_29 ;
    echr:hasCourt doc:authorityRuseSocialServices ;
    echr:hasDecisionDate "2002-07-23"^^xsd:date ;
    echr:hasParticipation doc:part_welfare_report_socialservices_2002_07_23 ;
    echr:hasSupportingQuote "Social services drew up a welfare report on the applicant, noting on 23 July 2002 that he was suffering from schizophrenia, that he lived alone in a small, run-down annexe to his half-sister’s house and that his half-sister and his father’s second wife had stated that they did not wish to act as his guardian."^^xsd:string .

doc:caseStanevVBulgaria a echr:CaseDocument ;
    rdfs:label "CASE OF STANEV v. BULGARIA"^^xsd:string ;
    echr:hasApplicant doc:applicantRusiKosevStanev ;
    echr:hasApplicationNumber "36760/06"^^xsd:string ;
    echr:hasExtractionNote "No domestic proceedings are described in the provided excerpt."^^xsd:string ;
    echr:hasJudgmentDate "2012-01-17"^^xsd:date ;
    echr:hasRespondentState "Republic of Bulgaria"^^xsd:string ;
    echr:hasSupportingQuote "**1.** The case originated in an application (no. 36760/06) against the Republic of Bulgaria lodged with the Court under Article 34 of the Convention for the Protection of Human Rights and Fundamental Freedoms (“the Convention”) by a Bulgarian national, Mr Rusi Kosev Stanev (“the applicant”), on 8 September 2006."^^xsd:string .

doc:case_1 a echr:CaseDocument ;
    rdfs:label "ECtHR case document (extracted)"^^xsd:string ;
    echr:hasApplicant doc:partyApplicant ;
    echr:hasExtractionNote "Administrative and other domestic events were extracted (social_assessment_2005; grant_allowance_2007; increase_allowance_2009; medical_exam_2006; req_guardian_2005). These nodes are not instances of echr:DomesticProceeding in the ontology, so they have been recorded as standalone echr:DomesticEvent/echr:AdministrativeAction nodes rather than via echr:hasDomesticProceeding (which is restricted to echr:DomesticProceeding)."^^xsd:string,
        "Paragraph markers '**34.**', '**35.**' and '**36.**' are present in the source text. These are paragraph identifiers in the judgment and do not represent factual numerical quantities; they have been ignored as numeric data in the extracted graph."^^xsd:string ;
    echr:hasSupportingQuote "in 2005 the applicant’s guardian asked the Municipal Council to grant a social allowance to facilitate his reintegration into the community."^^xsd:string .

doc:case_document_1 a echr:CaseDocument ;
    rdfs:label "D. The applicant’s attempts to obtain release from partial guardianship"^^xsd:string,
        "THE FACTS"^^xsd:string ;
    echr:hasApplicant doc:applicant,
        doc:partyApplicant ;
    echr:hasDomesticProceeding doc:dupnitsa_judicial_review_2005_09_28,
        doc:proceeding_ruse_regional_2000_11_20,
        doc:proceeding_veliko_tarnovo_2001_04_12 ;
    echr:hasExtractionNote "Paragraph number 10 (document structure artifact). Verbatim excerpt: 'On an unspecified date in 2000, at the request of the applicant’s two relatives, the Ruse regional prosecutor applied to the Ruse Regional Court ( Окръжен съд ) for a declaration of total legal incapacity in respect of the applicant.'"^^xsd:string,
        "Paragraph number 13 (document structure artifact). Verbatim excerpt: 'On 29 May 2002 R.P. asked the Ruse social services to place the applicant in a social care home for people with mental disorders.'"^^xsd:string,
        "Paragraph number 9 (document structure artifact). Verbatim excerpt: 'The applicant was born in 1956 in Ruse, where he lived until December 2002 and where his half-sister and his father’s second wife, his only close relatives, also live.'"^^xsd:string,
        "numeric token: 18 (day in '18 January 2006')"^^xsd:string,
        "numeric token: 7 (day in '7 October 2005')"^^xsd:string,
        "paragraph 37"^^xsd:string,
        "paragraph 38"^^xsd:string,
        "paragraph 39"^^xsd:string,
        "paragraph 40"^^xsd:string,
        "paragraph 41"^^xsd:string .

