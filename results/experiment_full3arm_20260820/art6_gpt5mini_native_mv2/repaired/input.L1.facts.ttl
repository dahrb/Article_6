doc:social_assessment_2005 a echr:AdministrativeAction ;
    rdfs:label "social assessment (30 December 2005)"^^xsd:string ;
    echr:followsProceeding doc:req_guardian_2005 ;
    echr:hasDecisionDate "2005-12-30"^^xsd:date ;
    echr:hasParticipation doc:part_assess_applicant_2005,
        doc:part_assess_dept_2005 ;
    echr:hasSupportingQuote "Further to that request, on 30 December 2005 the municipal social assistance department carried out a “social assessment” ( социална оценка ) of the applicant, which concluded that he was incapable of working, even in a sheltered environment, and had no need for training or retraining, and that in those circumstances he was entitled to a social allowance to cover the costs of his transport, subsistence and medication."^^xsd:string .

doc:transfer_to_pastra_2002 a echr:EnforcementAction ;
    rdfs:label "applicant taken by ambulance to the Pastra social care home"^^xsd:string ;
    echr:followsProceeding doc:welfare_placement_agreement_2002 ;
    echr:hasDecisionDate "2002-12-10"^^xsd:date ;
    echr:hasExtractionNote "**15.** Later that day, the applicant was taken by ambulance to the Pastra social care home, some 400 km from Ruse."^^xsd:string ;
    echr:hasParticipation doc:participationTransferApplicant,
        doc:participationTransferPastra ;
    echr:hasSupportingQuote "Later that day, the applicant was taken by ambulance to the Pastra social care home, some 400 km from Ruse."^^xsd:string .

doc:welfare_placement_agreement_2002 a echr:AdministrativeAction ;
    rdfs:label "a welfare-placement agreement"^^xsd:string ;
    echr:hasDecisionDate "2002-12-10"^^xsd:date ;
    echr:hasExtractionNote "**18.** The agreement signed between the guardian R.P. and the Pastra social care home on 10 December 2002 (see paragraph 14 above) did not mention the applicant’s name."^^xsd:string,
        "According to the information in the case file, the applicant’s invalidity pension, as updated in 2008, amounted to 130 Bulgarian levs (BGN – approximately 65 euros (EUR))."^^xsd:string,
        "The agreement stipulated that 80% of the sum was to be used as payment for the services provided and the remaining 20% put aside for personal expenses."^^xsd:string ;
    echr:hasParticipation doc:participationWpaPastra,
        doc:participationWpaRp ;
    echr:hasSupportingQuote "On 10 December 2002 a welfare-placement agreement was signed between R.P. and the social care home for adults with mental disorders near the village of Pastra in the municipality of Rila (“the Pastra social care home”), an institution under the responsibility of the Ministry of Labour and Social Policy."^^xsd:string .

