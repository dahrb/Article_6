doc:regional_prosecutor_refusal_2005_08_10 a echr:ProsecutorialReview ;
    rdfs:label "regional prosecutor refusal to bring action (10 Aug 2005)"^^xsd:string ;
    echr:followsProceeding doc:psychiatric_admission_2005_05_31 ;
    echr:hasDecisionDate "2005-08-10"^^xsd:date ;
    echr:hasParticipation doc:part_appupheld_2005_10_11_applicant,
        doc:part_regrefusal_2005_08_10_regional ;
    echr:hasSupportingQuote "On 10 August 2005 the regional prosecutor refused to bring an action for restoration of the applicant’s legal capacity on the grounds that, in the opinion of the doctors, the Director of the Pastra social care home and the home’s social worker, the applicant was unable to cope on his own, and that the home, where he could undergo medical treatment, was the most suitable place for him to live."^^xsd:string .

