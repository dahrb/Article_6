doc:director a echr:DomesticAuthority,
        echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Pastra social care home"^^xsd:string,
        "the Director"^^xsd:string,
        "the Director of the Pastra social care home"^^xsd:string,
        "the Pastra social care home"^^xsd:string,
        "the social care home"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthoritySocialWelfare ;
    echr:hasAuthorityName "Pastra social care home"^^xsd:string,
        "the Pastra social care home"^^xsd:string,
        "the home"^^xsd:string ;
    echr:hasExtractionNote "**19.** The Pastra social care home is located in an isolated area of the Rila mountains in south-west Bulgaria."^^xsd:string,
        "**20.** The home, built in the 1920s, comprises three buildings, where its residents, all male, are housed according to the state of their mental health."^^xsd:string,
        "**22.** The applicant asserted that the food provided at the home was insufficient and of poor quality."^^xsd:string,
        "Each toilet was shared by at least eight people."^^xsd:string,
        "It is accessible via a dirt track from the village of Pastra, the nearest locality 8 km away."^^xsd:string,
        "there were seventy-three people living in the home, one was in hospital and two had absconded."^^xsd:string ;
    echr:hasPartyName "the Director of the Pastra social care home"^^xsd:string ;
    echr:hasPersonName "the Director"^^xsd:string,
        "the Director of the Pastra social care home"^^xsd:string ;
    echr:hasSupportingQuote "the Director of the Pastra social care home"^^xsd:string,
        "the Pastra social care home"^^xsd:string .

doc:partyApplicant a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "the applicant"^^xsd:string ;
    echr:hasExtractionNote "On 20 December 1990 a panel of occupational physicians declared him unfit to work."^^xsd:string,
        "The panel found that as a result of being diagnosed with schizophrenia in 1975, the applicant had a 90% degree of disablement but did not require assistance."^^xsd:string ;
    echr:hasPartyName "the applicant"^^xsd:string ;
    echr:hasPersonName "the applicant"^^xsd:string ;
    echr:hasSupportingQuote "The applicant was born in 1956 in Ruse, where he lived until December 2002 and where his half-sister and his father’s second wife, his only close relatives, also live."^^xsd:string,
        "The reports indicated that the applicant was uncommunicative, preferred to stay on his own rather than join in group activities, refused to take his medication and had no close relatives to visit while on leave of absence."^^xsd:string ;
    echr:isRepresentedBy doc:lawyer .

doc:applicant a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "the applicant"^^xsd:string ;
    echr:hasExtractionNote "**21.** According to the applicant, the home was decaying, dirty and rarely heated in winter and, as a result, he and the other residents were obliged to sleep in their coats during winter."^^xsd:string,
        "The applicant was placed in block 3 of the home, reserved for residents with the least serious health problems, who were able to move around the premises and go alone to the nearest village with prior permission."^^xsd:string,
        "given anti-psychotic medication (carbamazepine (600 mg)) under monthly supervision of a psychiatrist"^^xsd:string ;
    echr:hasPartyName "the applicant"^^xsd:string ;
    echr:hasPersonName "the applicant"^^xsd:string ;
    echr:hasSupportingQuote "It appears from a medical certificate of 15 June 2005 (see paragraph 37 below) that, following his placement in the home in 2002, the applicant was given anti-psychotic medication (carbamazepine (600 mg)) under the monthly supervision of a psychiatrist."^^xsd:string,
        "The applicant was not informed of the agreement."^^xsd:string ;
    echr:isRepresentedBy doc:applicantLawyer .

