doc:applicant a echr:DomesticAuthority,
        echr:NaturalPerson,
        echr:Party ;
    rdfs:label "HQDCB"^^xsd:string,
        "Lawyer D."^^xsd:string,
        "the applicant"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityDisciplinary ;
    echr:hasAuthorityName "HQDCB"^^xsd:string ;
    echr:hasExtractionNote "35"^^xsd:string ;
    echr:hasPartyName "the applicant"^^xsd:string ;
    echr:hasPersonName "Lawyer D."^^xsd:string,
        "the applicant"^^xsd:string ;
    echr:hasSupportingQuote "Lawyer D. complained to the HQDCB that by failing to attend the meeting of 7 December 2012 the applicant had violated Article 62 of the Rules of Professional Conduct"^^xsd:string,
        "Neither the QDC of Zakarpattya nor the HQDCB had contemplated a less severe punishment"^^xsd:string,
        "The applicant complained under Article 8 of the Convention that because of the decisions of 17 April and 16 May 2013 he had been deprived of the opportunity to practise as an advocate."^^xsd:string,
        "The suspension had had a negative impact on the applicant’s career far beyond 2012, in particular, from 2013 to 2023 he had only obtained authorisation thirty-five times to represent clients as an advocate."^^xsd:string,
        "the HQDCB"^^xsd:string,
        "the applicant"^^xsd:string,
        "the applicant complained"^^xsd:string,
        "the applicant did not assert that he had lost all or a large part of his income because of the suspension."^^xsd:string,
        "the applicant instituted proceedings before the Kyiv District Administrative Court on 5 October 2016."^^xsd:string ;
    echr:isRepresentedBy doc:repHqdcb .

