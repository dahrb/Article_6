doc:adminaction_hqdcb_meeting_2016_07_22 a echr:AdministrativeAction ;
    rdfs:label "HQDCB meeting of 22 July 2016"^^xsd:string ;
    echr:followsProceeding doc:admin_decision_2013 ;
    echr:hasDecisionDate "2016-07-22"^^xsd:date ;
    echr:hasExtractionNote "19 out of 30 HQDCB members were present; of those 19, 11 voted in favour, 6 voted against and 2 abstained."^^xsd:string ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationHqdcbMeetingApplicant,
        doc:participationHqdcbMeetingAuthority ;
    echr:hasSupportingQuote "On 22 July 2016 the draft decision was put to vote at a HQDCB meeting where 19 out of 30 HQDCB members were present. Out of 19 members, 11 voted in favour of the decision, 6 voted against it, and 2 abstained. In view of the changes to the Rules of Procedure adopted in 2014 (see paragraph 16 above), the draft decision was rejected and the decisions suspending the applicant’s licence remained valid."^^xsd:string .

doc:administrative_action_suspension_1 a echr:AdministrativeAction ;
    rdfs:label "the applicant’s suspension"^^xsd:string ;
    echr:hasCourt doc:authority_domestic_authorities_1 ;
    echr:hasExtractionNote "six months"^^xsd:string ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasParticipation doc:participation_applicant_suspension_1,
        doc:participation_authority_suspension_1 ;
    echr:hasSupportingQuote "between 2013 and 2015 the applicant developed methodological manuals for advocates and received payment for that work."^^xsd:string,
        "between 2013 and 2023 the applicant, according to his own submissions, was only authorised to represent clients as an advocate thirty-five times."^^xsd:string,
        "the applicant’s suspension was temporary and lasted for six months."^^xsd:string .

doc:bar_council_changes_2014 a echr:AdministrativeAction ;
    rdfs:label "Bar Council changes to HQDCB Rules of Procedure July 2014"^^xsd:string ;
    echr:hasCourt doc:barCouncilUkraine ;
    echr:hasDecisionDate "2014-07"^^xsd:gYearMonth ;
    echr:hasParticipation doc:part_bar_council_2014 ;
    echr:hasSupportingQuote "In July 2014 the Bar Council of Ukraine adopted changes to the HQDCB’s Rules of Procedure, according to which a draft decision was considered as rejected unless a majority of the HQDCB members voted in its favour."^^xsd:string .

