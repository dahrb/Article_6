doc:proc_dupnitsa_2005_09_28_2006_03_10 a echr:DomesticProceeding ;
    rdfs:label "Dupnitsa District Court judicial review (application 28 Sep 2005; judgment 10 Mar 2006)"^^xsd:string ;
    echr:followsProceeding doc:admin_mayor_refusal_2005_09_16 ;
    echr:hasCourt doc:dupnitsaDistrictCourt ;
    echr:hasDecisionDate "2006-03-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_dup_applicant_2006,
        doc:part_dup_guardian_2006,
        doc:part_dup_mayor_2006 ;
    echr:hasProceedingStartDate "2005-09-28"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "The Dupnitsa District Court gave judgment on 10 March 2006. As to the merits, the court dismissed the application, finding that the guardian had no legitimate interest in contesting the mayor’s refusal, given that he could apply independently and directly for the applicant to be released from partial guardianship. Since the judgment was not subject to appeal, it became final."^^xsd:string ;
    echr:isFinalDomesticDecision true .

