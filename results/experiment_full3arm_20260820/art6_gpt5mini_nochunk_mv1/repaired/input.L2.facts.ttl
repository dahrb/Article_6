@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/1d3abbb7e196/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/1d3abbb7e196> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:2"^^xsd:string .

doc:caseBeerReganVGermany a echr:CaseDocument ;
    rdfs:label "Beer and Regan v. Germany"^^xsd:string ;
    echr:hasApplicant doc:partyBeer,
        doc:partyRegan ;
    echr:hasDomesticProceeding doc:proc_beer_darmstadt_1993,
        doc:proc_regan_darmstadt_1993,
        doc:proc_regan_ti_darmstadt_1994 ;
    echr:hasSupportingQuote "In October and November 1993 the applicants instituted proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA, arguing that, pursuant to the German Provision of Labour (Temporary Staff) Act ( Arbeitnehmerüberlassungsgesetz ), they had acquired the status of employees of ESA."^^xsd:string .

doc:darmstadtLabourCourt a echr:DomesticAuthority ;
    rdfs:label "Darmstadt Labour Court (Arbeitsgericht)"^^xsd:string ;
    echr:hasAuthorityName "Darmstadt Labour Court (Arbeitsgericht)"^^xsd:string ;
    echr:hasSupportingQuote "In October and November 1993 the applicants instituted proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA"^^xsd:string .

doc:partyEsa a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "European Space Agency (ESA)"^^xsd:string ;
    echr:hasAuthorityName "European Space Agency (ESA)"^^xsd:string ;
    echr:hasSupportingQuote "The European Space Agency (\"\"ESA\"\") with headquarters in Paris, ... was established under the Convention for the Establishment of a European Space Agency (\"\"ESA Convention\"\") of 30 May 1975."^^xsd:string .

doc:partyTi a echr:Party ;
    rdfs:label "the company T.I."^^xsd:string ;
    echr:hasPartyName "the company T.I."^^xsd:string ;
    echr:hasSupportingQuote "The second applicant, a systems programmer and employed by the Italian company T.I., was placed at the disposal of the European Space Agency to perform services at the European Space Operations Centre in Darmstadt in 1991."^^xsd:string .

doc:participationReganProcTi a echr:Participation ;
    rdfs:label "Participation of Mr Philip Regan in Regan v T.I. (Darmstadt)"^^xsd:string ;
    echr:hasSupportingQuote "a settlement had been reached in the Darmstadt Labour Court on 6 September 1994."^^xsd:string .

doc:participationTiProcRegan a echr:Participation ;
    rdfs:label "Participation of the company T.I. in Regan v T.I. (Darmstadt)"^^xsd:string ;
    echr:hasSupportingQuote "According to this settlement, the second applicant’s employment with the company T.I. had terminated on 31 December 1993, and the company T.I. undertook to pay to the second applicant the sum of 22,000 marks (DEM) for loss of job."^^xsd:string .

doc:partyBeer a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Mr Karlheinz Beer"^^xsd:string ;
    echr:hasPartyName "Mr Karlheinz Beer"^^xsd:string ;
    echr:hasPersonName "Mr Karlheinz Beer"^^xsd:string ;
    echr:hasSupportingQuote "Mr Karlheinz Beer is a German national, born in 1952 and resident in Darmstadt."^^xsd:string ;
    echr:isRepresentedBy doc:lrEHabscheid,
        doc:lrWjHabscheid .

doc:partyRegan a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Mr Philip Regan"^^xsd:string ;
    echr:hasPartyName "Mr Philip Regan"^^xsd:string ;
    echr:hasPersonName "Mr Philip Regan"^^xsd:string ;
    echr:hasSupportingQuote "Mr Philip Regan is a British national, born in 1960 and resident in London in the United Kingdom."^^xsd:string ;
    echr:isRepresentedBy doc:lrEHabscheid,
        doc:lrWjHabscheid .

doc:proc_beer_darmstadt_1993 a echr:DomesticProceeding ;
    rdfs:label "Proceeding by Mr Karlheinz Beer v. ESA before the Darmstadt Labour Court"^^xsd:string ;
    echr:hasParticipation doc:participationBeerProcBeer,
        doc:participationEsaProcBeer ;
    echr:hasSupportingQuote "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."^^xsd:string .

doc:proc_regan_darmstadt_1993 a echr:DomesticProceeding ;
    rdfs:label "Proceeding by Mr Philip Regan v. ESA before the Darmstadt Labour Court"^^xsd:string ;
    echr:hasParticipation doc:participationBeerProcBeer,
        doc:participationEsaProcBeer ;
    echr:hasSupportingQuote "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."^^xsd:string .

doc:proc_regan_ti_darmstadt_1994 a echr:DomesticProceeding ;
    rdfs:label "Proceeding by Mr Philip Regan v. the company T.I. before the Darmstadt Labour Court"^^xsd:string ;
    echr:hasParticipation doc:participationReganProcTi,
        doc:participationTiProcRegan ;
    echr:hasSupportingQuote "In the proceedings instituted by the second applicant against his dismissal by the company T.I. (see paragraph 13 above), a settlement had been reached in the Darmstadt Labour Court on 6 September 1994."^^xsd:string .

doc:lrEHabscheid a echr:LegalRepresentative,
        echr:NaturalPerson ;
    rdfs:label "Mr E. Habscheid"^^xsd:string ;
    echr:hasPersonName "Mr E. Habscheid"^^xsd:string ;
    echr:hasSupportingQuote "for the applicants ... Mr E. Habscheid, of the Dresden Bar, Adviser"^^xsd:string .

doc:lrWjHabscheid a echr:LegalRepresentative,
        echr:NaturalPerson ;
    rdfs:label "Mr W.J. Habscheid"^^xsd:string ;
    echr:hasPersonName "Mr W.J. Habscheid"^^xsd:string ;
    echr:hasSupportingQuote "for the applicants Mr W.J. Habscheid, of the Kempten Bar, Counsel"^^xsd:string .

doc:participationBeerProcBeer a echr:Participation ;
    rdfs:label "Participation of Mr Karlheinz Beer in Beer v ESA (Darmstadt)"^^xsd:string,
        "Participation of Mr Philip Regan in Regan v ESA (Darmstadt)"^^xsd:string ;
    echr:hasSupportingQuote "In October and November 1993 the applicants instituted proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA"^^xsd:string .

doc:participationEsaProcBeer a echr:Participation ;
    rdfs:label "Participation of ESA in Beer v ESA (Darmstadt)"^^xsd:string,
        "Participation of ESA in Regan v ESA (Darmstadt)"^^xsd:string ;
    echr:hasSupportingQuote "In the respective labour court proceedings, ESA relied on its immunity from jurisdiction under Article XV § 2 of the ESA Convention and its Annex I."^^xsd:string .

