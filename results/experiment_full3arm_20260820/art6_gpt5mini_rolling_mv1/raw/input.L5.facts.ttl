doc:case_martynovskiy_69358_13 a echr:CaseDocument ;
    rdfs:label "CASE OF MARTYNOVSKIY v. UKRAINE"^^xsd:string ;
    echr:hasApplicant doc:partyApplicantRomanMartynovskiy ;
    echr:hasApplicationNumber "69358/13"^^xsd:string ;
    echr:hasDomesticProceeding doc:adoption_rules_20121117,
        doc:complaint_7dec2012,
        doc:proceeding_letter_2013_03_05,
        doc:publication_rules_20130118,
        doc:qdc_examination_feb2013,
        doc:register_entry_2015,
        doc:transfer_2013_01_24 ;
    echr:hasRespondentState "Ukraine"^^xsd:string ;
    echr:hasSupportingQuote "During and after the suspension the applicant continued to work in the legal field, namely as an expert for an NGO and as president of the board of directors of a governmental body (ibid)."^^xsd:string,
        "Firstly, the applicant did not submit any information as to how many authorisations he had obtained before his suspension and, secondly, it cannot be excluded that the applicant voluntarily focused on activities other than representing clients as an advocate after his suspension (see paragraph 18 above)."^^xsd:string,
        "Moreover, it has not been disputed by the parties that between 2013 and 2015 the applicant developed methodological manuals for advocates and received payment for that work."^^xsd:string,
        "The Court also notes that the applicant did not assert that he had lost all or a large part of his income because of the suspension."^^xsd:string,
        "The Court does not discern a causal link between the disputed suspension and the fact that between 2013 and 2023 the applicant, according to his own submissions, was only authorised to represent clients as an advocate thirty-five times."^^xsd:string,
        "The Court observes that the applicant’s suspension was temporary and lasted for six months."^^xsd:string .

