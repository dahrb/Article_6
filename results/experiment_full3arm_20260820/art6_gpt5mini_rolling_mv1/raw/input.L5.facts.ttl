doc:appeal_to_hqdcb_2013 a echr:DomesticProceeding ;
    rdfs:label "Applicant's appeal to HQDCB against QDC decisions (2013)"^^xsd:string ;
    echr:followsProceeding doc:decision_2013_05_16 ;
    echr:hasAdjournment doc:adjournment_2015_change_rapporteur ;
    echr:hasCourt doc:hqdcb ;
    echr:hasExtractionNote "In 2013 the HQDCB held two hearings in the applicant’s case, but failed to reach a decision. No hearings were held in 2014."^^xsd:string ;
    echr:hasParticipation doc:participation_applicant_appeal_hqdcb_2013,
        doc:participation_hqdcb_appeal_2013 ;
    echr:hasProceedingType echr:TypeDisciplinary ;
    echr:hasSupportingQuote "Relying on Article 6 § 1 of the Convention, the applicant complained that the consideration of his appeals against the decisions to suspend his licence had lasted too long."^^xsd:string,
        "The applicant appealed against the decisions of 17 April and 16 May 2013 to the HQDCB, however the appeal did not have a suspensive effect. In the appeal he complained that the QDC of Zakarpattya had not been competent to examine the complaint because under Article 33 of the Law on the Bar and practice of law, complaints against advocates had to be examined by the Bar of the region where those lawyers were practising. He also noted that under the law, the Head of HQDCB was not competent to transfer the complaint to the QDC of Zakarpattya. He further stated that his right to equality of arms had been violated because he had not been informed of the hearing before it had taken place on 17 April 2013."^^xsd:string ;
    echr:isPending true .

doc:complaint_7dec2012 a echr:AdministrativeAction ;
    rdfs:label "Complaint by D. to HQDCB about 7 December 2012 meeting"^^xsd:string ;
    echr:hasCourt doc:hqdcb ;
    echr:hasParticipation doc:participation_D_complaint_7dec2012,
        doc:participation_applicant_complaint_7dec2012 ;
    echr:hasSupportingQuote "Lawyer D. complained to the HQDCB that by failing to attend the meeting of 7 December 2012 the applicant had violated Article 62 of the Rules of Professional Conduct, adopted by the Congress of Advocates on 17 November 2012 and published on 18 January 2012, which provided that advocates elected to self-government bodies should abstain from actions which might result in blocking the work of those bodies. D. stated that before the meeting of 7 December 2012 the HQDCB had posted a message on its website informing of the date and place of the meeting of 7 December 2012. D. asked the HQDCB to suspend the applicant’s licence."^^xsd:string .

doc:decision_2013_04_17 a echr:AdministrativeAction ;
    rdfs:label "QDC decision to suspend applicant's licence (17 April 2013)"^^xsd:string ;
    echr:hasCourt doc:qdcZakarpattya ;
    echr:hasDecisionDate "2013-04-17"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_D_decision_20130417,
        doc:participation_applicant_decision_20130417 ;
    echr:hasSupportingQuote "On 17 April 2013, in the applicant’s absence, the Disciplinary Chamber of the QDC of Zakarpattya suspended the applicant’s licence to practise as an advocate for six months for his failure to attend the meeting of 7 December 2012 and violating Article 62 of the Rules of Professional Conduct."^^xsd:string .

doc:decision_2013_05_16 a echr:AdministrativeAction ;
    rdfs:label "QDC upheld decision (16 May 2013)"^^xsd:string ;
    echr:followsProceeding doc:decision_2013_04_17 ;
    echr:hasCourt doc:qdcZakarpattya ;
    echr:hasDecisionDate "2013-05-16"^^xsd:date ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_applicant_decision_20130516 ;
    echr:hasSupportingQuote "On 16 May the QDC of Zakarpattya upheld the decision of 17 April 2013."^^xsd:string .

doc:inactivity_kdac_20170306_201805 a echr:InactivityPeriod ;
    rdfs:label "Dormancy of Kyiv District Administrative Court proceedings (6 Mar 2017 - May 2018)"^^xsd:string ;
    echr:hasInactivityCause echr:DelayUnattributed ;
    echr:hasInactivityEndDate "2018-05"^^xsd:gYearMonth ;
    echr:hasInactivityStartDate "2017-03-06"^^xsd:date ;
    echr:hasSupportingQuote "It remains unknown why the proceedings had been resumed one year after 6 March 2017, when the applicant’s appeal against the decision of 22 December 2016 had been rejected. The Court observes that there is no evidence in the case file that the applicant had indeed informed the Kyiv District Administrative Court of the decision of 6 March 2017 in April 2017. The Court therefore cannot establish whether the delay in the resumption of the proceedings between March 2017 and May 2018 was attributable to the applicant or to the Government."^^xsd:string .

