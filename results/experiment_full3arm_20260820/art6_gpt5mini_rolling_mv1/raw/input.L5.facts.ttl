doc:proceeding_kyiv_district_administrative_court_2016 a echr:DomesticProceeding ;
    rdfs:label "Proceedings before the Kyiv District Administrative Court (5 Oct 2016 - 9 Dec 2021)"^^xsd:string ;
    echr:hasAdjournment doc:adjournment_kdac_feb2017 ;
    echr:hasCourt doc:kyivDistrictAdministrativeCourt ;
    echr:hasDecisionDate "2021-12-09"^^xsd:date ;
    echr:hasInactivityPeriod doc:inactivity_kdac_20170306_201805 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:participation_applicant_kdac_20161005,
        doc:participation_bodies_of_bar_kdac_20161005,
        doc:participation_kdac_court_20161005 ;
    echr:hasProceedingStartDate "2016-10-05"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "It also observes that the Government did not submit any information about the progress of the case during that period (see paragraph 29 above)."^^xsd:string,
        "The Court observes that the applicant instituted proceedings before the Kyiv District Administrative Court on 5 October 2016. The final decision in the case was delivered on 9 December 2021. The applicant familiarized himself with this decision in November 2022."^^xsd:string,
        "following the resumption of the proceedings in May 2018 the applicant repeatedly enquired with the Kyiv District Administrative Court, in 2018 and 2019, about the progress in his case, but received no reply."^^xsd:string ;
    echr:isFinalDomesticDecision true .

