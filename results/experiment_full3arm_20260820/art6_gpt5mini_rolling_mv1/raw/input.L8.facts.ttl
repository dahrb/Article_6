doc:admin_contact_port_1995 a echr:AdministrativeAction ;
    rdfs:label "Makhachkala Port contact to prosecutor (October 1995)"^^xsd:string ;
    echr:hasDecisionDate "1995-10"^^echr:PartialDate ;
    echr:hasParticipation doc:part_port_contact_1995,
        doc:part_prosecutor_contact_1995 ;
    echr:hasSupportingQuote "In October 1995 the Makhachkala International Sea Port contacted the prosecutor of Nizhniy Novgorod and informed him that the Stavanger had been purchased by the Port before the arrest."^^xsd:string .

doc:admin_forward_contract_dec_1995 a echr:AdministrativeAction ;
    rdfs:label "Makhachkala Port forwarded contract to prosecutor (Dec 1995)"^^xsd:string ;
    echr:hasDecisionDate "1995-12"^^echr:PartialDate ;
    echr:hasParticipation doc:part_port_request_bank_1995,
        doc:part_prosecutor_forward_contract_1995 ;
    echr:hasSupportingQuote "In December 1995 the Makhachkala Sea Port forwarded to the prosecutor’s office a copy of the contract between the owner of the ship, a company owned by the applicant and called “Russian Shipping”, and the Makhachkala Sea Port."^^xsd:string .

doc:admin_head_industry_request_1996_05 a echr:AdministrativeAction ;
    rdfs:label "Head of Industry dept requested prosecutor permission to use proceeds for Oka (May 1996)"^^xsd:string ;
    echr:hasDecisionDate "1996-05"^^echr:PartialDate ;
    echr:hasParticipation doc:part_head_industry_request_1996_05,
        doc:part_oka_head_request_1996_05,
        doc:part_prosecutor_head_request_1996_05 ;
    echr:hasSupportingQuote "In May 1996 the Head of the Industry department of the Nizhniy Novgorod regional administration asked the Nizhniy Novgorod prosecutor for permission to use the proceeds from the Stavanger for the needs of the “Oka” shipyard, which had built the vessel, and which had been declared bankrupt in February 1996."^^xsd:string .

doc:admin_port_transfer_1996_01 a echr:AdministrativeAction ;
    rdfs:label "Makhachkala Port transferred $2.5M to Nizhniy Novgorod city administration account (Jan 1996)"^^xsd:string ;
    echr:hasDecisionDate "1996-01"^^echr:PartialDate ;
    echr:hasParticipation doc:part_city_admin_receive_1996_01,
        doc:part_port_transfer_1996_01 ;
    echr:hasSupportingQuote "In January 1996 the Port transferred the sum of 2.5 million US dollars to a special account of the Nizhniy Novgorod city administration."^^xsd:string .

doc:admin_request_bankaccount_1995 a echr:AdministrativeAction ;
    rdfs:label "Makhachkala Port requested prosecutor indicate bank account (end 1995)"^^xsd:string ;
    echr:hasDecisionDate "1995-12"^^echr:PartialDate ;
    echr:hasParticipation doc:part_port_request_bank_1995,
        doc:part_prosecutor_request_bank_1995 ;
    echr:hasSupportingQuote "It asked the prosecutor’s office to indicate the bank account to which the purchase sum should be transferred."^^xsd:string .

doc:case_46503_99 a echr:CaseDocument ;
    rdfs:label "Application no. 46503/99 by Andrey Anatolyevitch KLIMENTYEV"^^xsd:string ;
    echr:hasApplicant doc:applicantAndreyKlimentyev ;
    echr:hasApplicationNumber "46503/99"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceeding_initial_trial_1995_1997,
        doc:proceeding_new_trial_1998,
        doc:proceeding_supreme_court_1997 .

doc:companyAroko a echr:Party ;
    rdfs:label "Aroko"^^xsd:string ;
    echr:hasPartyName "Aroko"^^xsd:string ;
    echr:hasSupportingQuote "It appears that the order freezing the drydock was lifted in May 1996, as it belonged to a Norwegian company “Aroko”. The applicant was not given a copy of the relevant order."^^xsd:string .

doc:enforcement_freeze_1995_10_05 a echr:EnforcementAction ;
    rdfs:label "Freezing of applicant's property (5 October 1995)"^^xsd:string ;
    echr:followsProceeding doc:proceeding_initial_trial_1995_1997 ;
    echr:hasDecisionDate "1995-10-05"^^echr:PartialDate ;
    echr:hasParticipation doc:part_app_freeze_1995,
        doc:part_prosecutor_freeze_1995 ;
    echr:hasSupportingQuote "Following the institution of an investigation against the applicant in March 1995, on 5 October 1995 property belonging to the applicant - the ship Stavanger and a floating drydock - was frozen on the order of the Nizhniy Novgorod prosecutor’s office."^^xsd:string,
        "The Stavanger, built in Nizhniy Novgorod shipyard \"Oka\", was placed under arrest in a shipyard near Astrakhan on the Caspian Sea."^^xsd:string .

doc:enforcement_freeze_1996_03_11 a echr:EnforcementAction ;
    rdfs:label "Freezing of proceeds from ship sale (11 March 1996)"^^xsd:string ;
    echr:hasDecisionDate "1996-03-11"^^echr:PartialDate ;
    echr:hasParticipation doc:part_city_admin_freeze_1996_03_11,
        doc:part_prosecutor_freeze_1996_03_11 ;
    echr:hasSupportingQuote "on 11 March 1996 the proceeds from the ship sale were frozen on the order of the Nizhniy Novgorod prosecutor’s office."^^xsd:string .

doc:enforcement_prosecutor_unfreeze_1996_05_18 a echr:EnforcementAction ;
    rdfs:label "Prosecutor unfroze account and transferred proceeds to Oka (18 May 1996)"^^xsd:string ;
    echr:hasDecisionDate "1996-05-18"^^echr:PartialDate ;
    echr:hasParticipation doc:part_oka_receive_1996_05_18,
        doc:part_prosecutor_freeze_1996_03_11 ;
    echr:hasSupportingQuote "On 18 May 1996 the Nizhniy Novgorod prosecutor’s office unfroze the account and transferred the money to the yard. The reasoning given was that the applicant had been accused of economic crimes, which had caused damage to “Oka”, and that the applicant had purchased the Stavanger with the money stolen from the yard."^^xsd:string .

doc:enforcement_release_1996_01_19 a echr:EnforcementAction ;
    rdfs:label "Release of the Stavanger from arrest (19 January 1996)"^^xsd:string ;
    echr:hasDecisionDate "1996-01-19"^^echr:PartialDate ;
    echr:hasParticipation doc:part_prosecutor_release_1996_01_19,
        doc:part_russian_shipping_release_1996_01_19 ;
    echr:hasSupportingQuote "On 19 January 1996 the Stavanger was freed from arrest"^^xsd:string .

doc:local_election_invalid_1998 a echr:AdministrativeAction ;
    rdfs:label "Local electoral committee decision invalidating election (1 April 1998)"^^xsd:string ;
    echr:hasCourt doc:localElectoralCommittee ;
    echr:hasDecisionDate "1998-04-01"^^echr:PartialDate ;
    echr:hasParticipation doc:part_app_election_1998,
        doc:part_committee_election_1998 ;
    echr:hasSupportingQuote "On 1 April 1998 the local electoral committee declared the elections invalid on the ground of irregularities committed during the campaign by some candidates, including the applicant."^^xsd:string .

doc:proceeding_regional_court_motions_1998 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court - motions (19 May 1998)"^^xsd:string ;
    echr:followsProceeding doc:proceeding_new_trial_1998 ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_app_dismiss_judge_1998 ;
    echr:hasProceedingStartDate "1998-05-19"^^echr:PartialDate ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "Both requests were rejected by the Regional Court."^^xsd:string,
        "On 19 May the applicant’s “civil defender” requested the Regional Court to dismiss the judge presiding in the case for bias."^^xsd:string,
        "On the same day the applicant requested to admit Mrs Moskalenko as his lawyer in the trial because one of his lawyers was on sick leave."^^xsd:string .

doc:proceeding_regional_court_order_1998_07_08 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court - order to provide amended judgment (8 July 1998)"^^xsd:string ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasDecisionDate "1998-07-08"^^echr:PartialDate ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasParticipation doc:part_app_conviction_1998,
        doc:part_regionalcourt_order_1998_07_08 ;
    echr:hasSupportingQuote "It appears that on 8 July 1998 the Regional Court ordered that the applicant should be given the amended version, but he claims that he did not receive it."^^xsd:string .

doc:proceeding_regional_court_orders_1998 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court - further orders (27 May 1998)"^^xsd:string ;
    echr:followsProceeding doc:proceeding_regional_court_conviction_1998 ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasDecisionDate "1998-05-27"^^echr:PartialDate ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_app_orders_1998 ;
    echr:hasSupportingQuote "In one order the court noted breaches of the relevant rules of criminal procedure during investigation, and found that these breaches had been remedied during the trial."^^xsd:string,
        "In particular, the court noted that the defendants had not been informed about the commissioning of expert reports in the case until the examinations were over."^^xsd:string,
        "On 27 May 1998 the Regional Court made a number of further orders ( частные определения ) in the case. The applicant claims that he was not informed of them, did not receive copies promptly and was therefore unable to appeal against them."^^xsd:string,
        "The court considered that the fact that the defendants were not properly informed about the examinations did not invalidate the conclusions of the experts’ reports, and that the applicant had failed to contest the results of the reports during the investigation or during the trial."^^xsd:string .

doc:proceeding_supreme_court_1998_08_10 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court decision (10 August 1998)"^^xsd:string ;
    echr:followsProceeding doc:proceeding_supreme_court_1998_cassation ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasDecisionDate "1998-08-10"^^echr:PartialDate ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_app_appeal_1997,
        doc:part_prosecutor_appeal_1997 ;
    echr:hasSupportingQuote "His lawyers, including Mrs Moskalenko, were present at the hearing."^^xsd:string,
        "It appears that the defence requested the court to stand down for lack of impartiality, shown by the refusal to postpone the hearing, but the motion was rejected."^^xsd:string,
        "On 10 August 1998 the Supreme Court confirmed the judgment of the Nizhniy Novgorod Regional Court, with some alterations."^^xsd:string,
        "Overall, the Supreme Court found that there had not been any significant breaches of national procedural law or international standards during the trial."^^xsd:string,
        "The Supreme Court concluded that the disputed evidence had been properly evaluated by the Nizhniy Novgorod Regional Court and found admissible."^^xsd:string,
        "The Supreme Court dropped certain charges from the conviction and altered the classification of certain crimes, in view of the Criminal Code which entered into force in 1997."^^xsd:string,
        "The applicant requested permission to attend the hearing in the Supreme Court in person, but the request was turned down."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:proceeding_supreme_court_detention_1998 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court appeal against detention order (23 April 1998)"^^xsd:string ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasDecisionDate "1998-05-19"^^echr:PartialDate ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_app_appeal_1997 ;
    echr:hasProceedingStartDate "1998-04-23"^^echr:PartialDate ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 23 April 1998 the applicant’s “civil defender”, who participated in the process with a status similar to that of a lawyer, lodged with the Supreme Court an appeal against the court order of 2 April to detain the applicant."^^xsd:string,
        "The reply from the Supreme Court, dated 19 May 1998, stated that the national law did not allow appeals against that type of trial court orders separately from appeals against judgments."^^xsd:string .

doc:prosecutorial_file_closure_1999 a echr:ProsecutorialReview ;
    rdfs:label "Nizhniy Novgorod regional prosecutor's office closed file (February 1999)"^^xsd:string ;
    echr:followsProceeding doc:proceeding_quash_1982_1999 ;
    echr:hasDecisionDate "1999-02"^^echr:PartialDate ;
    echr:hasParticipation doc:part_app_file_closure_1999,
        doc:part_prosecutor_file_closure_1999 ;
    echr:hasSupportingQuote "In February 1999 the applicant’s first (1982) conviction was quashed, and the file in that case was closed by the Nizhniy Novgorod regional prosecutor’s office."^^xsd:string .

doc:adjournment_supreme_1998_07 a echr:Adjournment ;
    rdfs:label "Adjournment request July 1998 - Supreme Court"^^xsd:string ;
    echr:hasAdjournmentCause echr:DelayAttributedToApplicant ;
    echr:hasAdjournmentDate "1998-07"^^echr:PartialDate ;
    echr:hasSupportingQuote "In July ... she requested an adjournment of the hearing to give her time to study the case materials (more than 100 volumes)."^^xsd:string .

doc:adjournment_supreme_1998_08_10 a echr:Adjournment ;
    rdfs:label "Adjournment request 10 August 1998 - Supreme Court"^^xsd:string ;
    echr:hasAdjournmentCause echr:DelayAttributedToApplicant ;
    echr:hasAdjournmentDate "1998-08-10"^^echr:PartialDate ;
    echr:hasSupportingQuote "On 10 August 1998 Mrs Moskalenko made a number of requests to the Supreme Court. Referring to difficulties in organising an adequate defence, she requested an adjournment of the hearing to give her time to study the case materials (more than 100 volumes)."^^xsd:string .

