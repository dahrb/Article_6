doc:proceeding_initial_trial_1995_1997 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court (conviction 21 April 1997)"^^xsd:string ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasDecisionDate "1997-04-21"^^echr:PartialDate ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasParticipation doc:part_app_initial_1997,
        doc:part_prosecutor_initial_1997 ;
    echr:hasProceedingStartDate "1995-03-07"^^echr:PartialDate ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "By a judgment of the Nizhniy Novgorod Regional Court of 21 April 1997, later quashed by the Supreme Court, the applicant was ordered to pay the “Oka” damages in the amount that had been transferred to it previously."^^xsd:string,
        "Following the institution of an investigation against the applicant in March 1995"^^xsd:string,
        "On 21 April 1997 the Nizhniy Novgorod Regional Court found the applicant guilty on some of the charges, and not guilty on most."^^xsd:string .

doc:proceeding_new_trial_1998 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court - new trial (started 30 March 1998)"^^xsd:string ;
    echr:followsProceeding doc:proceeding_supreme_court_1997 ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:part_app_newtrial_1998,
        doc:part_prosecutor_newtrial_1998,
        doc:part_witness_a_newtrial_1998,
        doc:part_witness_b_newtrial_1998,
        doc:part_witness_m_newtrial_1998,
        doc:part_witness_p_newtrial_1998,
        doc:part_witness_r_newtrial_1998 ;
    echr:hasPreTrialDetention doc:pretrial_detention_april_1998 ;
    echr:hasProceedingStartDate "1998-03-30"^^echr:PartialDate ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "In addition, five witness statements were admitted in the trial, in the absence of the witnesses."^^xsd:string,
        "In total, the Regional Court heard more then 35 witnesses during the trial."^^xsd:string,
        "On 30 March 1998, during the new trial, the prosecutor applied to the court to detain the applicant for violations of the undertaking not to leave the city during the trial and obstruction of justice. The Regional Court rejected the motion as unsubstantiated."^^xsd:string,
        "R. was also questioned on one occasion in Moscow in 1996."^^xsd:string,
        "The applicant objected to the admission of the statements, claiming that, among other things, they were not affixed by an apostille, and therefore not in conformity with requirements relating to foreign official papers."^^xsd:string,
        "The court also noted that a number of documents in the case file were in foreign languages, but considered that this did not violate the defence rights because the documents were similar to, or copies of, other documents in Russian. In any event, all documents had been translated into Russian during the trial."^^xsd:string,
        "The court also ordered that the rest of the trial should be conducted in camera."^^xsd:string,
        "The trial court rejected these objections, referring to the 1961 Hague Convention Abolishing the Requirement for Legalisation of Foreign Public Documents, which did not require any legalisation of documents received from official bodies of another State Party."^^xsd:string,
        "Two of them, R. and B., citizens of Norway, had been questioned in Norway by a Norwegian police department, ECOCRIME, separately and together with the Russian investigators."^^xsd:string ;
    echr:isPending false,
        true .

