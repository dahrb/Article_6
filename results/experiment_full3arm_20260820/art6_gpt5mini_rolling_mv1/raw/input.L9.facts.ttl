doc:questioning_medical_staff_2011_04_27 a echr:DomesticProceeding ;
    rdfs:label "On 27 April 2011 the doctor, nurse and duty officer who had examined the applicant upon his admission to the prison hospital on 27 August 2010 were questioned as part of the investigation"^^xsd:string ;
    echr:hasCourt doc:investigatingAuthorities ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
