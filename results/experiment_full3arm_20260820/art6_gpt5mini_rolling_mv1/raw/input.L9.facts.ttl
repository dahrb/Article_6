doc:doctor_note_2010_11_25 a echr:DomesticProceeding ;
    rdfs:label "On 25 November 2010 the doctor noted that no signs of ill-treatment had been observed on the applicant's body"^^xsd:string ;
    echr:hasCourt doc:investigatingAuthorities ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasParticipation doc:part_medicalnote_doctor_2010_11_25,
        doc:part_medicalnote_investigator_2010_11_25 ;
    echr:hasProceedingStartDate "2010-11-25"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 25 November 2010 the doctor who had examined the applicant upon his admission to Kutaisi Prison no. 2 on 19 August 2010 noted that no signs of ill-treatment had been observed on the applicant’s body and that he had not complained in this regard."^^xsd:string .

doc:forensic_exam_concluded_2010_09_03 a echr:DomesticProceeding ;
    rdfs:label "On 3 September 2010 the forensic medical examination was concluded."^^xsd:string ;
    echr:hasCourt doc:investigatingAuthorities ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasParticipation doc:part_forensic_applicant_2010_09_03,
        doc:part_forensic_expert_2010_09_03,
        doc:part_forensic_investigator_2010_09_03 ;
    echr:hasProceedingStartDate "2010-09-03"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 3 September 2010 the forensic medical examination was concluded. An expert from the National Forensic Bureau found that the applicant had a trace of a small abrasion in the area of his chin, approximately a month old, possibly caused by a hard object. A small wound, no more than three days old, was observed on the applicant’s shin. The report noted that both injuries were located \"within the applicant’s own reach\"."^^xsd:string .

doc:inspection_2005_09_20 a echr:DomesticProceeding ;
    rdfs:label "On 20 September 2005 the investigating authorities carried out an inspection of the crime scene, involving M.T., to verify the particulars of his earlier statements."^^xsd:string ;
    echr:hasCourt doc:investigatingAuthorities ;
