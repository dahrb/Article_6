    echr:hasSupportingQuote "On 20 September 2005 the investigating authorities carried out an inspection of the crime scene, involving M.T., to verify the particulars of his earlier statements."^^xsd:string .

doc:investigation_open_2010_08_31 a echr:DomesticProceeding ;
    rdfs:label "On 31 August 2010 an investigation was opened into the applicant’s allegations and a forensic medical examination was commissioned."^^xsd:string ;
    echr:hasCourt doc:investigatingAuthorities ;
    echr:hasExtractionNote "Neither the Government nor the applicant updated the Court on the final outcome of that investigation."^^xsd:string ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasParticipation doc:part_investigation_applicant_2010_08_31,
        doc:part_medicalnote_investigator_2010_11_25 ;
    echr:hasProceedingStartDate "2010-08-31"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 31 August 2010 an investigation was opened into the applicant’s allegations. On the same day the investigator commissioned a forensic medical examination to determine if there were any injuries on the applicant’s body and, if so, where they had come from."^^xsd:string .

doc:partial_statement_2010_11_29 a echr:DomesticProceeding ;
    rdfs:label "On 29 November 2010 the applicant gave a partial statement alleging that on 12 August 2010 the governor had asked him to withdraw the application."^^xsd:string ;
    echr:hasCourt doc:investigatingAuthorities ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasParticipation doc:part_partialstatement_applicant_2010_11_29,
        doc:part_partialstatement_investigator_2010_11_29 ;
    echr:hasProceedingStartDate "2010-11-29"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 29 November 2010 the applicant gave a partial statement, alleging that on 12 August 2010 the governor of Rustavi Prison no. 6 had asked him to withdraw his application to the Court, in exchange for better conditions in prison."^^xsd:string .

doc:placement_prison_hospital_2010_08_27 a echr:EnforcementAction ;
