    echr:hasProceedingStartDate "2011-04-27"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 27 April 2011 the doctor, nurse and duty officer who had examined the applicant upon his admission to the prison hospital on 27 August 2010 were questioned as part of the investigation into his allegations. They all noted that the applicant had had no serious injuries and had not made any complaint at the time of his admission to the prison hospital."^^xsd:string .

doc:questioning_prison_governor_and_chief_inspector_2010 a echr:DomesticProceeding ;
