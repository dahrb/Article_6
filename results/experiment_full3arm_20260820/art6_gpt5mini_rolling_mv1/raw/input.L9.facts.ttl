doc:appeal_regional_prosecutor_2005_11_03 a echr:ProsecutorialReview ;
    rdfs:label "On 3 November 2005 M.T. appealed to the regional prosecutor’s office against the investigator’s refusal to question him again."^^xsd:string ;
    echr:followsProceeding doc:rejection_2005_10_29 ;
    echr:hasCourt doc:regionalProsecutorOffice ;
    echr:hasParticipation doc:part_appeal_mt_2005_11_03,
        doc:part_appeal_regional_office_2005_11_03 ;
    echr:hasProceedingStartDate "2005-11-03"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 3 November 2005 M.T. appealed to the regional prosecutor’s office against the investigator’s refusal to question him again."^^xsd:string ;
    echr:isPending true .

doc:appeal_tbilisi_2007_06_27 a echr:DomesticProceeding ;
    rdfs:label "On 27 June 2007 the Tbilisi Court of Appeal upheld the applicant’s conviction."^^xsd:string ;
    echr:followsProceeding doc:first_instance_conviction_2006_12_08 ;
    echr:hasCourt doc:tbilisiCourtOfAppeal ;
    echr:hasDecisionDate "2007-06-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_appeal_applicant_2007_06_27,
        doc:part_appeal_at_2007_06_27,
        doc:part_appeal_prosecution_2007_06_27 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "As regards the applicant’s argument that M.T.’s statement had been obtained under duress and was inadmissible evidence, the court did not find it established on the facts that pressure had been applied."^^xsd:string,
        "On 27 June 2007 the Tbilisi Court of Appeal upheld the applicant’s conviction."^^xsd:string,
        "The appellate court reheard A.T., who had witnessed the inspection of the crime scene on 20 September 2005 (see paragraph 19 above). He confirmed his earlier statement that on that date he had witnessed M.T., whom he had known since childhood, confirming to the investigators his initial version of the events implicating the applicant and indicating particular details related to that account."^^xsd:string .

doc:complaint_chief_prosecutor_2010_08_25 a echr:ProsecutorialReview ;
    rdfs:label "On 25 and 26 August 2010 the applicant complained to the Chief Prosecutor about alleged beatings on 19 August 2010."^^xsd:string ;
    echr:hasCourt doc:chiefProsecutorOffice ;
    echr:hasParticipation doc:part_complaint_applicant_2010_08_25,
        doc:part_complaint_chief_2010_08_25 ;
    echr:hasProceedingStartDate "2010-08-25"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 25 and 26 August 2010 the applicant complained to the Chief Prosecutor that on 19 August 2010, directly before being transferred to Kutaisi Prison no. 2, he had been severely beaten by the governor of Rustavi Prison no. 6 and had sustained serious injuries to his ribs, head and backbone."^^xsd:string .

doc:conviction_mt_2006_12_26 a echr:DomesticProceeding ;
    rdfs:label "On 26 December 2006 M.T. was convicted at first instance of obstructing justice by giving false testimony and given a partially suspended sentence."^^xsd:string ;
    echr:hasCourt doc:courtOfFirstInstance ;
    echr:hasDecisionDate "2006-12-26"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnknown ;
    echr:hasParticipation doc:part_conviction_mt_2006_12_26_court,
        doc:part_conviction_mt_2006_12_26_mt ;
    echr:hasSupportingQuote "On an unspecified date separate criminal proceedings were opened against M.T. and Z.T. On 26 December 2006 and 23 January 2007 respectively they were convicted at first instance of obstructing justice by giving false testimony. Both were given partially suspended sentences. The case file does not contain information about the final outcome of those proceedings."^^xsd:string .

