doc:esa a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "European Space Agency (ESA)"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityUnknown ;
    echr:hasAuthorityName "European Space Agency"^^xsd:string ;
    echr:hasSupportingQuote "The European Space Agency (“ESA”) with headquarters in Paris, formed out of the European Space Research Organisation (“ESRO”) and the European Organisation for the Development and Construction of Space Vehicle Launchers (“ELDO”), was established under the Convention for the Establishment of a European Space Agency (“ESA Convention”) of 30 May 1975 ( United Nations Treaty Series 1983, vol. 1297, I – no. 21524)."^^xsd:string .

