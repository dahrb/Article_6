doc:applicantKarlheinzBeer a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Mr Karlheinz Beer"^^xsd:string ;
    echr:hasPersonName "Mr Karlheinz Beer"^^xsd:string ;
    echr:hasSupportingQuote "**10.** Mr Karlheinz Beer is a German national, born in 1952 and resident in Darmstadt."^^xsd:string,
        "**11.** In 1982 the first applicant, a civil engineer by profession and employed by the French company S., was placed at the disposal of the European Space Agency to perform services at the European Space Operations Centre in Darmstadt."^^xsd:string,
        "lodged with the Commission under former Article 25 by a German national, Mr Karlheinz Beer, and by a British national, Mr Philip Regan, on 13 September 1995."^^xsd:string .

