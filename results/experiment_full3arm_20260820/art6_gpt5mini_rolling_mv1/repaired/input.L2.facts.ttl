        echr:Party ;
    rdfs:label "Mr Philip Regan"^^xsd:string ;
    echr:hasPersonName "Mr Philip Regan"^^xsd:string ;
    echr:hasSupportingQuote "**10.** Mr Philip Regan is a British national, born in 1960 and resident in London in the United Kingdom."^^xsd:string,
