doc:proceeding_commercial_leave_unexamined_20071116 a echr:DomesticProceeding ;
    rdfs:label "Decision to leave claim and counterclaim unexamined (Commercial Court, 16 November 2007)"^^xsd:string ;
    echr:hasCourt doc:domAuthCommercialCourt ;
    echr:hasDecisionDate "2007-11-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:participation_llc_20071116,
        doc:participation_scholz_20071116 ;
    echr:hasProceedingStartDate "2007-11-16"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "**19.** On 16 November 2007 the Commercial Court granted the request and decided to leave the applicant company’s claim and the counterclaim lodged by the LLC unexamined. In doing so, it referred to Article 103 § 3 of the Code of Civil Procedure and found that the resolution of the dispute fell within the jurisdiction of the Arbitration Tribunal. It found that, as the contract of 2 April 2003 contained an arbitration clause, the agreement of 28 October 2005 was also subject to arbitration. The decision was amenable to appeal before a three-judge bench of the Commercial Court within three days of receipt by the party."^^xsd:string .

doc:domAuthCommercialCourt a echr:DomesticAuthority ;
    rdfs:label "Commercial Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
