    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "At the same time, the registrar of the Arbitration Tribunal submitted to the representative of the applicant company a draft arbitration agreement to be concluded with the LLC."^^xsd:string ;
