doc:proc_trial_1999 a echr:DomesticProceeding ;
    rdfs:label "trial before Mr Justice Potts and a jury (8 February - 1 April 1999)"^^xsd:string ;
    echr:followsProceeding doc:procChargedOnIndictment,
        doc:proc_police_officer_testimony_hearsay_direction_1999 ;
    echr:hasCourt doc:authorityTrialMrJusticePotts ;
