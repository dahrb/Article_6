doc:domestic_proceeding_brussels_french_language_tpi_2016_10_25_unilateral_application_president_order a echr:DomesticProceeding ;
    rdfs:label "Acting president of the French-language TPI ordered the State to comply by issuing visas or laissez-passers"@en ;
    echr:hasDecisionDate "2016-10-25"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "30"^^xsd:string ;
    echr:hasSupportingQuote "By an order of 25 October 2016, considering that the failure by the Aliens Office to comply with a judgment of the Aliens Appeals Board, notwithstanding the fact that it had been immediately enforceable, constituted \"an unacceptable illegal action\", the acting president of the French-language TPI ordered the State, as an urgent measure, to comply with the Board’s judgment of 20 October 2016"@en .

doc:domestic_proceeding_brussels_french_language_tpi_2016_11_07_inter_partes_application_confirm_order a echr:DomesticProceeding ;
    rdfs:label "French-language TPI declared the inter partes application admissible but unfounded"@en ;
