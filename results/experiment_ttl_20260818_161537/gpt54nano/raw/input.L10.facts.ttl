    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "52"^^xsd:string ;
    echr:hasSupportingQuote "If the Aliens Office refuses to issue a visa, the requesting party may apply to the Aliens Appeals Board to have the Aliens Office’s decision set aside."^^xsd:string .

