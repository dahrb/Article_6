    echr:hasSupportingQuote "By a judgment of 20 October 2016 the Aliens Appeals Board, essentially reiterating the substance of its previous judgments, ordered a stay of execution of the refusal decisions of 17 October 2016"@en .

doc:domestic_proceeding_aliens_appeals_board_2017_03_24_lift_stay a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board dismissed the application to have the decisions set aside and lifted the stay of execution"@en ;
