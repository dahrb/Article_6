    echr:hasInstanceLevel echr:LevelEnforcement ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "33"^^xsd:string ;
    echr:hasSupportingQuote "On 27 October 2015, the Fund notified the applicant of a decision taken on 27 October 2015 regarding the impossibility of enforcing the judgment."^^xsd:string .

doc:administrative_court_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "On 19 March 2014, the 6th Chamber of the İstanbul Administrative Court dismissed the applicant’s claim"@en ;
    echr:followsProceeding doc:rectification_proceeding_1 ;
    echr:hasDecisionDate "2014-03-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "35"^^xsd:string ;
    echr:hasSupportingQuote "On 19 March 2014, the 6th Chamber of the İstanbul Administrative Court dismissed the applicant’s claim, concluding that no legal irregularities had occurred in the tendering and sale procedures."^^xsd:string .

doc:administrative_enforcement_initiated_law_6183_first_instance a echr:DomesticProceeding ;
    rdfs:label "enforcement proceedings initiated under Law no. 6183"@en ;
    echr:hasCourt doc:firstInstanceAdministrativeCourtAuthority ;
