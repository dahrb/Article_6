doc:administrative_court_2006_07_20 a echr:DomesticProceeding ;
    rdfs:label "Supreme Administrative Court"@en ;
    echr:followsProceeding doc:administrative_enforcement_initiated_law_6183_first_instance ;
    echr:hasCourt doc:supremeAdministrativeCourtAuthority ;
    echr:hasDecisionDate "2006-07-20"^^xsd:date ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "47"^^xsd:string ;
    echr:hasSupportingQuote "On 20 July 2006, the Supreme Administrative Court, ruling unanimously, found that the applicant had a legal interest in the enforcement proceedings initiated under Law no. 6183"@en,
        "quashed the administrative court’s earlier decision"@en .

