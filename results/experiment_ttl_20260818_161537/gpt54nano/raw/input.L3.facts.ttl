doc:domestic_proceeding_liquidation_protocol_signed_2006_05_09 a echr:DomesticProceeding ;
    rdfs:label "debt liquidation protocol signed"@en ;
    echr:hasSourceParagraph "9"^^xsd:string ;
    echr:hasSupportingQuote "On 9 May 2006, a debt liquidation protocol ( Borç Tasfiye Protokolü , hereinafter referred to as “the Liquidation Protocol”) was signed between the Fund (as creditor) and the Erol Aksoy Group (as debtor)"^^xsd:string .

