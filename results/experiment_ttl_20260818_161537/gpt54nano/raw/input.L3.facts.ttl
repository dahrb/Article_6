doc:domestic_proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "non-enforcement of judgments delivered by the Supreme Administrative Court following proceedings initiated by the applicant"@en ;
    echr:followsProceeding doc:domestic_proceeding_1 ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "the non-enforcement of judgments delivered by the Supreme Administrative Court following proceedings initiated by the applicant"^^xsd:string .

doc:domestic_proceeding_consolidate_radio_viva_assets_2007_07_19 a echr:DomesticProceeding ;
    rdfs:label "consolidation of seized assets for radio viva into a single economic and commercial unit"@en ;
    echr:hasSourceParagraph "18"^^xsd:string ;
    echr:hasSupportingQuote "This consolidation included the following companies: Aks Radyo ve Yayıncılık Sanayi ve Ticaret A.Ş., Medya İletişim Hizmetleri Sanayi A.Ş., Anadolu Radyo ve Görüntü Hizmetleri A.Ş., and Erdem Radyo Televizyon Yayıncılığı ve Reklamcılık A.Ş."^^xsd:string .

doc:domestic_proceeding_consolidate_viva_tv_assets_2007_07_19 a echr:DomesticProceeding ;
    rdfs:label "consolidation of seized assets for viva tv into a single economic and commercial unit"@en ;
    echr:hasSourceParagraph "17"^^xsd:string ;
    echr:hasSupportingQuote "With respect to Viva TV, the Fund resolved to consolidate all seized assets, rights, properties and associated components, such as contracts and the rights arising therefrom, belonging to debtor companies within the Erol Aksoy Group and effectively used by Viva TV into a single economic and commercial unit"^^xsd:string .

doc:domestic_proceeding_decision_initiate_legal_proceedings_2008_04_03 a echr:DomesticProceeding ;
    rdfs:label "fund decided to initiate legal proceedings"@en ;
    echr:followsProceeding doc:domestic_proceeding_liquidation_protocol_signed_2006_05_09 ;
    echr:hasProceedingStartDate "2008-04-03"^^echr:PartialDate ;
    echr:hasSourceParagraph "13"^^xsd:string ;
    echr:hasSupportingQuote "On 3 April 2008, the Fund concluded that the Erol Aksoy Group had failed to fulfil several commitments and obligations set out in the Liquidation Protocol, rendering the Protocol no longer effective for the recovery of public receivables. Consequently, the Fund decided to rely on its provisions concerning default. It resolved to initiate legal proceedings against all natural and legal person debtors within the Erol Aksoy Group"^^xsd:string .

doc:domestic_proceeding_enforcement_23_mar_2016 a echr:DomesticProceeding ;
    rdfs:label "a letter dated 23 March 2016"@en ;
    echr:followsProceeding doc:domestic_proceeding_supreme_admin_rectification_25_jan_2016 ;
    echr:hasInstanceLevel echr:LevelEnforcement ;
    echr:hasProceedingStartDate "2016-03"^^echr:PartialDate ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "31"^^xsd:string ;
    echr:hasSupportingQuote "In a letter dated 23 March 2016, the applicant communicated with the Fund, requesting the enforcement of the annulment judgment."^^xsd:string ;
    echr:isPending true .

doc:domestic_proceeding_establish_economic_units_2007_07_19 a echr:DomesticProceeding ;
    rdfs:label "fund decided to establish two economic and commercial units"@en ;
    echr:hasProceedingStartDate "2007-07-19"^^echr:PartialDate ;
    echr:hasSourceParagraph "16"^^xsd:string ;
    echr:hasSupportingQuote "On 19 July 2007, the Fund decided to establish two economic and commercial units: one for Viva TV and the other for Radio Viva"^^xsd:string .

doc:domestic_proceeding_merge_units_2009_07_09 a echr:DomesticProceeding ;
    rdfs:label "fund decided to merge the two economic and commercial units"@en ;
    echr:hasProceedingStartDate "2009-07-09"^^echr:PartialDate ;
    echr:hasSourceParagraph "22"^^xsd:string ;
    echr:hasSupportingQuote "On 9 July 2009, the Fund decided to merge the two economic and commercial units, thereby creating the Viva TV-Radio Viva Economic and Commercial Unit"^^xsd:string .

doc:domestic_proceeding_offer_both_units_for_sale_2007_08_29 a echr:DomesticProceeding ;
    rdfs:label "fund offered viva tv and radio viva for sale in a single tendering process"@en ;
    echr:hasProceedingStartDate "2007-08-29"^^echr:PartialDate ;
    echr:hasSourceParagraph "20"^^xsd:string ;
    echr:hasSupportingQuote "On 29 August 2007, the Fund resolved to offer both Viva TV and Radio Viva for sale together in a single tendering process, setting a reserve price of USD 8,000,000. However, as no bids were received, the tendering process could not proceed"^^xsd:string .

doc:domestic_proceeding_offer_merged_unit_for_sale_2009_11_05 a echr:DomesticProceeding ;
    rdfs:label "fund resolved to offer viva tv-radio viva for sale with reserve price and postponed tendering"@en ;
    echr:hasProceedingStartDate "2009-11-05"^^echr:PartialDate ;
    echr:hasSourceParagraph "23"^^xsd:string ;
    echr:hasSupportingQuote "On 5 November 2009, the Fund resolved to offer Viva TV-Radio Viva for sale, establishing a reserve price of USD 6,000,000. Although a company, P. A.Ş., obtained the tender documents with the intention of submitting a bid, the tendering process was subsequently postponed"^^xsd:string .

doc:domestic_proceeding_offer_merged_unit_for_sale_2011_01_13 a echr:DomesticProceeding ;
    rdfs:label "fund decided to offer viva tv-radio viva for sale again and set reserve price"@en ;
    echr:hasProceedingStartDate "2011-01-13"^^echr:PartialDate ;
    echr:hasSourceParagraph "24"^^xsd:string ;
    echr:hasSupportingQuote "On 13 January 2011, the Fund decided to offer Viva TV-Radio Viva for sale again, setting the reserve price at USD 6,000,000. Three companies acquired the tender documents. However, only company A. participated in the auction held on 8 February 2011"^^xsd:string .

doc:domestic_proceeding_transfer_management_control_2008_09_18 a echr:DomesticProceeding ;
    rdfs:label "fund resolved to transfer management and control of companies"@en ;
    echr:hasProceedingStartDate "2008-09-18"^^echr:PartialDate ;
    echr:hasSourceParagraph "14"^^xsd:string ;
    echr:hasSupportingQuote "On 18 September 2008, the Fund further resolved to transfer the management and control of all companies within the Erol Aksoy Group to itself, along with the rights of their shareholders, except for the entitlement to dividends"^^xsd:string .

doc:domestic_proceeding_valuation_report_2009_06_30 a echr:DomesticProceeding ;
    rdfs:label "valuation report determined updated values of radio viva and viva tv"@en ;
    echr:hasProceedingStartDate "2009-06-30"^^echr:PartialDate ;
    echr:hasSourceParagraph "21"^^xsd:string ;
    echr:hasSupportingQuote "On 30 June 2009, a valuation report issued by TSKB determined that the value of Radio Viva was USD 5,782,000 and the value of Viva TV was USD 132,000"^^xsd:string .

doc:domestic_proceeding_value_report_radio_viva_viva_tv_2007_08_01 a echr:DomesticProceeding ;
    rdfs:label "tskb issued report determining values of radio viva and viva tv economic and commercial units"@en ;
    echr:hasProceedingStartDate "2007-08-01"^^echr:PartialDate ;
    echr:hasSourceParagraph "19"^^xsd:string ;
    echr:hasSupportingQuote "On 1 August 2007, the Industrial Development Bank of Türkiye ( Türkiye Sınaî Kalkınma Bankası A.Ş ., hereinafter referred to as “TSKB”) issued a report and determined that the value of the Radio Viva Economic and Commercial Unit (hereinafter referred to as “Radio Viva”) was 4,258,000 United States dollars (USD), while the value of the Viva TV Economic and Commercial Unit (hereinafter referred to as “Viva TV”) was USD 373,400"^^xsd:string .

doc:impossibility_of_enforcement_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "On 27 October 2015, the Fund took a decision regarding the impossibility of enforcing the judgment"@en ;
    echr:followsProceeding doc:enforcement_decision_proceeding_1 ;
