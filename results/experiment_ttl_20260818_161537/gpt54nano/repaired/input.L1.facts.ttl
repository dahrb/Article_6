doc:domesticGuardianshipAppointmentByMunicipalCouncil a echr:DomesticProceeding ;
    rdfs:label "appointment of a guardian"@en ;
    echr:hasCourt doc:ruseMunicipalCouncil ;
    echr:hasDecisionDate "2 February 2005"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingStartDate "7 June 2001"^^xsd:string ;
    echr:hasProceedingType echr:TypeOther ;
    echr:hasSourceParagraph "11"^^xsd:string ;
    echr:hasSupportingQuote "transmitted to the Ruse Municipal Council on 7 June 2001 for the appointment of a guardian"@en .

doc:domestic_proceeding_11 a echr:DomesticProceeding ;
    rdfs:label "Dupnitsa District Court gave judgment on 10 March 2006 dismissing the application"@en ;
    echr:followsProceeding doc:domestic_proceeding_10 ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasProceedingStartDate "2006-03-10"^^xsd:date ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "40"^^xsd:string ;
    echr:hasSupportingQuote "The Dupnitsa District Court gave judgment on 10 March 2006"@en ;
    echr:isFinalDomesticDecision true .

doc:domestic_proceeding_12 a echr:DomesticProceeding ;
    rdfs:label "oral requests to the guardian to apply for release from partial guardianship and to allow leaving the home"@en ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "41"^^xsd:string ;
    echr:hasSupportingQuote "Lastly, the applicant asserted that he had made several oral requests to his guardian to apply for his release from partial guardianship and to allow him to leave the home"@en .

doc:domestic_proceeding_6 a echr:DomesticProceeding ;
    rdfs:label "Chief Public Prosecutor’s Office at the Supreme Court of Cassation upheld the refusal"@en ;
    echr:followsProceeding doc:domestic_proceeding_5 ;
