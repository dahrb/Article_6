doc:dummy_1 a echr:DomesticProceeding ;
    rdfs:label "domestic legal proceedings"@en ;
    echr:hasSourceParagraph "3"^^xsd:string ;
    echr:hasSupportingQuote "The applicant shared a room measuring 16 sq. m with four other residents and the beds were practically side by side."^^xsd:string .

