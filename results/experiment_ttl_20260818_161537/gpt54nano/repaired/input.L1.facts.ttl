doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "the applicant, through his lawyer, asked the public prosecutor’s office to apply to the Regional Court to have his legal capacity restored"@en ;
    echr:hasProceedingStartDate "2004-11-25"^^xsd:date ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "37"^^xsd:string ;
    echr:hasSupportingQuote "On 25 November 2004 the applicant, through his lawyer, asked the public prosecutor’s office to apply to the Regional Court to have his legal capacity restored"@en .

doc:domestic_proceeding_10 a echr:DomesticProceeding ;
    rdfs:label "Dupnitsa District Court hearing"@en ;
    echr:followsProceeding doc:domestic_proceeding_9 ;
    echr:hasProceedingStartDate "2006-01-18"^^xsd:date ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "39"^^xsd:string ;
    echr:hasSupportingQuote "On 18 January 2006 the court held a hearing"@en .

doc:domestic_proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "public prosecutor requested the Pastra social care home to send him a doctor’s opinion and other medical certificates concerning the applicant’s disorders"@en ;
    echr:followsProceeding doc:domestic_proceeding_1 ;
    echr:hasProceedingStartDate "2005-03-02"^^xsd:date ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "37"^^xsd:string ;
    echr:hasSupportingQuote "On 2 March 2005 the public prosecutor requested the Pastra social care home to send him a doctor’s opinion and other medical certificates concerning the applicant’s disorders in preparation for a possible application to the courts for restoration of his legal capacity"@en .

doc:domestic_proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "admission to a psychiatric hospital from 31 May to 15 June 2005 for a medical assessment"@en ;
    echr:followsProceeding doc:domestic_proceeding_2 ;
    echr:hasProceedingStartDate "2005-05"^^xsd:gYearMonth ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "37"^^xsd:string ;
    echr:hasSupportingQuote "Further to that request, the applicant was admitted to a psychiatric hospital from 31 May to 15 June 2005 for a medical assessment"@en .

doc:domestic_proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "regional prosecutor refused to bring an action for restoration of the applicant’s legal capacity"@en ;
    echr:followsProceeding doc:domestic_proceeding_3 ;
    echr:hasProceedingStartDate "2005-08-10"^^xsd:date ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "38"^^xsd:string ;
    echr:hasSupportingQuote "On 10 August 2005 the regional prosecutor refused to bring an action for restoration of the applicant’s legal capacity"@en .

doc:domestic_proceeding_5 a echr:DomesticProceeding ;
    rdfs:label "appellate prosecutor upheld the regional prosecutor’s refusal"@en ;
    echr:followsProceeding doc:domestic_proceeding_4 ;
    echr:hasProceedingStartDate "2005-10-11"^^xsd:date ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "38"^^xsd:string ;
    echr:hasSupportingQuote "Despite those objections, the regional prosecutor’s refusal was upheld on 11 October 2005 by the appellate prosecutor"@en .

doc:domestic_proceeding_7 a echr:DomesticProceeding ;
    rdfs:label "the applicant, through his lawyer, asked the mayor of Rila to bring a court action for his release from partial guardianship"@en ;
    echr:hasProceedingStartDate "2005-09-09"^^xsd:date ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "39"^^xsd:string ;
    echr:hasSupportingQuote "On 9 September 2005 the applicant, through his lawyer, asked the mayor of Rila to bring a court action for his release from partial guardianship"@en .

doc:domestic_proceeding_8 a echr:DomesticProceeding ;
    rdfs:label "mayor of Rila refused the request"@en ;
    echr:followsProceeding doc:domestic_proceeding_7 ;
    echr:hasProceedingStartDate "2005-09-16"^^xsd:date ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "39"^^xsd:string ;
    echr:hasSupportingQuote "In a letter of 16 September 2005, the mayor of Rila refused his request"@en .

doc:domestic_proceeding_9 a echr:DomesticProceeding ;
    rdfs:label "application to the Dupnitsa District Court for judicial review of the mayor’s decision"@en ;
    echr:followsProceeding doc:domestic_proceeding_8 ;
    echr:hasProceedingStartDate "2005-09"^^xsd:gYearMonth ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "39"^^xsd:string ;
    echr:hasSupportingQuote "On 28 September 2005 the applicant’s lawyer applied to the Dupnitsa District Court for judicial review of the mayor’s decision"@en .

