    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "38"^^xsd:string ;
    echr:hasSupportingQuote "and subsequently on 29 November 2005 by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation"@en .

doc:domestic_proceeding_partial_incapacity_1 a echr:DomesticAuthority,
        echr:DomesticProceeding ;
    rdfs:label "Ruse Regional Court judgment of 20 November 2000 declaring the applicant partially incapacitated"@en ;
    echr:followsProceeding doc:domestic_proceeding_total_incapacity_1 ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasCourt doc:domestic_authority_ruse_regional_court_1 ;
    echr:hasDecisionDate "2000-11-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingStartDate "2000"^^xsd:gYear ;
    echr:hasProceedingType echr:TypeOther ;
    echr:hasSourceParagraph "10"^^xsd:string ;
    echr:hasSupportingQuote "In a judgment of 20 November 2000, the court declared the applicant to be partially incapacitated on the grounds that he had been suffering from simple schizophrenia since 1975, and that his ability to manage his own affairs and interests and to realise the consequences of his own acts had been impaired."@en .

doc:domestic_proceeding_partial_incapacity_2 a echr:DomesticProceeding ;
    rdfs:label "Ruse Regional Court judgment of 20 November 2000 declaring the applicant partially incapacitated"@en ;
    echr:followsProceeding doc:domestic_proceeding_total_incapacity_1 ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
