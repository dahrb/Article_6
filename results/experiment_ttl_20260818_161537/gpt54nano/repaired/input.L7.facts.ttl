@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/e9993b84adb8> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:7"^^xsd:string .

doc:bail_withdrawal_trial_1999_03_25 a echr:DomesticProceeding ;
    rdfs:label "25 March 1999"@en ;
    echr:followsProceeding doc:bail_review_high_court_1999_03_26 ;
    echr:hasDecisionDate "1999-03-25"^^xsd:date ;
    echr:hasProceedingStartDate "1999-03-25"^^xsd:date ;
    echr:hasSourceParagraph "?"^^xsd:string ;
    echr:hasSupportingQuote "On 25 March 1999, before the closing speeches were due to begin and a long adjournment over a weekend, the judge after consulting counsel decided to withdraw the applicant’s bail."^^xsd:string .

doc:stay_application_1 a echr:DomesticProceeding ;
    rdfs:label "the defence application that the trial should be stayed as an abuse"@en ;
    echr:hasCourt doc:trial_judge_1 ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "22"^^xsd:string ;
    echr:hasSupportingQuote "Before the commencement of the proceedings, the defence made a number of applications: that the trial should be stayed as an abuse on the basis that due inter alia to the lapse of time since events the applicant could not obtain a fair trial."@en ;
    echr:isProceedingInCase doc:case_document_1 .

doc:trial_1 a echr:DomesticProceeding ;
    rdfs:label "the trial which took place between 8 February and 1 April 1999"@en ;
    echr:hasDecisionDate "1999-04-01"^^xsd:date ;
    echr:hasProceedingStartDate "1999-02-08"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "21"^^xsd:string ;
    echr:hasSupportingQuote "In the trial which took place between 8 February and 1 April 1999, before Mr Justice Potts and a jury, the applicant was represented by senior and junior counsel and solicitors."@en .

doc:bail_review_high_court_1999_03_26 a echr:DomesticProceeding ;
    rdfs:label "26 March 1999"@en ;
    echr:hasDecisionDate "1999-03-26"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "1999-03-26"^^xsd:date ;
    echr:hasSourceParagraph "?"^^xsd:string ;
    echr:hasSupportingQuote "An application was made to the High Court to review bail on 26 March 1999. It was refused."^^xsd:string .

doc:case_document_1 a echr:CaseDocument ;
    rdfs:label "Admissibility decision in Application no. 63716/00"@en .

doc:trial_judge_1 a echr:DomesticAuthority ;
    rdfs:label "the trial judge"@en ;
    echr:hasAuthorityName "the trial judge"@en ;
    echr:hasSourceParagraph "22"^^xsd:string ;
    echr:hasSupportingQuote "The application was refused by the trial judge who considered that it was entirely speculative as to whether the unavailability of witnesses was a detriment or a bonus, that the evidence of the eye-witnesses called by the prosecution could be properly and rigorously tested within the confines of the trial process, and that any points which the defence might have about the reliability of the evidence could be fairly accommodated within the trial process."@en .

