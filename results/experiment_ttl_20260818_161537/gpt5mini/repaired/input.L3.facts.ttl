    rdfs:label "applicant participation in first-instance administrative proceedings"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicant .

doc:procNonEnforcementFund a echr:DomesticProceeding ;
    rdfs:label "Non-enforcement of Supreme Administrative Court judgments by the Savings Deposit Insurance Fund"^^xsd:string ;
    echr:followsProceeding doc:procSupremeJudgments ;
    echr:hasCourt doc:fund ;
    echr:hasInstanceLevel echr:LevelEnforcement ;
    echr:hasOutcome echr:OutcomeUnknown ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "he complained that the national authorities had failed to comply with the Supreme Administrative Court’s judgments rendered in his favour in those proceedings"^^xsd:string ;
    echr:isProceedingInCase doc:case_58919_18 .

doc:proceedingFirstInstanceVivaSale a echr:DomesticProceeding ;
    rdfs:label "proceedings before the administrative court"^^xsd:string ;
    echr:hasCourt doc:supremeAdmin ;
    echr:hasDecisionDate "2014-03-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationApplicantFirstInstance ;
    echr:hasProceedingStartDate "2011-02-24"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "33"^^xsd:string ;
    echr:hasSupportingQuote "On 24 February 2011, the applicant initiated proceedings before the administrative court, seeking the annulment of the sale of Viva TV-Radio Viva."^^xsd:string .

doc:proceeding_admin_court_2011 a echr:DomesticProceeding ;
    rdfs:label "the applicant initiated proceedings before the administrative court"@en ;
    echr:hasCourt doc:supremeAdmin ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingStartDate "2011-02-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "27"^^xsd:string ;
    echr:hasSupportingQuote "On 7 February 2011, the applicant initiated proceedings before the administrative court, contesting the actions of the Fund concerning the tendering of Viva TV-Radio Viva, in which he claimed to hold both direct and indirect shares."^^xsd:string .

doc:proceeding_general_assembly_2015 a echr:DomesticProceeding ;
    rdfs:label "General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court annulled the Fund’s decision"@en ;
    echr:followsProceeding doc:proceeding_supreme_13th_chamber_2014 ;
    echr:hasCourt doc:supremeAdmin ;
    echr:hasDecisionDate "2015-07-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "29"^^xsd:string ;
    echr:hasSupportingQuote "The General Assembly concluded that the contested decision was not in compliance with the law, and, by a majority, annulled the Fund’s decision."^^xsd:string .

doc:proceeding_supreme_13th_chamber_2014 a echr:DomesticProceeding ;
    rdfs:label "13th Chamber of the Supreme Administrative Court dismissed the applicant’s case"@en ;
    echr:followsProceeding doc:proceeding_admin_court_2011 ;
    echr:hasCourt doc:supremeAdmin ;
