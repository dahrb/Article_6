doc:procAnnulment a echr:DomesticProceeding ;
    rdfs:label "Proceedings initiated by the applicant to annul decisions related to the valuation, tender invitation and sale of Viva TV-Radio Viva"^^xsd:string ;
    echr:followsProceeding doc:proc_board_2001 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "proceedings initiated by the applicant to annul decisions related to the valuation, tender invitation and subsequent sale of a television channel and radio station owned by joint-stock companies in which the applicant held shares"^^xsd:string ;
    echr:isProceedingInCase doc:case_58919_18 .

doc:procSupremeJudgments a echr:DomesticProceeding ;
    rdfs:label "Judgments delivered by the Supreme Administrative Court following the applicant's annulment proceedings"^^xsd:string ;
    echr:followsProceeding doc:procAnnulment ;
    echr:hasCourt doc:supremeAdmin ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "judgments delivered by the Supreme Administrative Court following proceedings initiated by the applicant to annul decisions related to the valuation, tender invitation and subsequent sale of a television channel and radio station owned by joint-stock companies in which the applicant held shares"^^xsd:string ;
    echr:isProceedingInCase doc:case_58919_18 .

doc:proc_board_2001 a echr:DomesticProceeding ;
    rdfs:label "Decision of the Banking Regulation and Supervision Board of 15 March 2001"^^xsd:string ;
    echr:hasCourt doc:boardBrd ;
    echr:hasDecisionDate "2001-03-15"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "6"^^xsd:string ;
    echr:hasSupportingQuote "By a decision dated 15 March 2001, the Banking Regulation and Supervision Board ( Bankalar Düzenleme ve Denetleme Kurulu , hereinafter “the Board”) resolved to transfer the management and control of İktisat Bankası T.A.Ş. (hereinafter “İktisat Bank” or “the Bank”) to the Savings Deposit Insurance Fund ( Tasarruf Mevduat Sigorta Fonu , hereinafter “the Fund”), pursuant to section 14(3) of the Banking Activities Act (Law no. 4389)."^^xsd:string ;
    echr:isProceedingInCase doc:case_58919_18 .

