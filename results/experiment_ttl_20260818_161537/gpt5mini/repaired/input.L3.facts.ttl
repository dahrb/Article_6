<https://growgraph.dev/doc/d47e91fb94bf> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:3"^^xsd:string .

doc:constitutional_application_2017 a echr:DomesticProceeding ;
    rdfs:label "individual application with the Constitutional Court"^^xsd:string ;
    echr:followsProceeding doc:sac_annulment_2017 ;
    echr:hasCourt doc:constitutionalCourt ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelConstitutional ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasProceedingStartDate "2017-09-11"^^xsd:date ;
    echr:hasProceedingType echr:TypeConstitutional ;
    echr:hasSourceParagraph "41"^^xsd:string,
        "42"^^xsd:string ;
    echr:hasSupportingQuote "In a decision of 23 May 2018, the Constitutional Court observed that the final annulment judgment of the 13th Chamber of the Supreme Administrative Court had been served on the applicant on 28 July 2017 and determined that the thirty-day time-limit for lodging an individual application had commenced on that date. Noting that the applicant’s application had been submitted on 11 September 2017, after the expiry of the time-limit, the Constitutional Court declared the application inadmissible. The decision was served on the applicant on 7 June 2018."^^xsd:string,
        "On 11 September 2017, the applicant lodged an individual application with the Constitutional Court, alleging violations of his right to property and his right to a fair trial due to the non-enforcement of the final judgment annulling the sale of Viva TV-Radio Viva."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:fund_enforcement_decision_2017_08_11 a echr:DomesticProceeding ;
    rdfs:label "Fund decision on 11 August 2017 regarding enforcement"^^xsd:string ;
    echr:hasCourt doc:theFund ;
    echr:hasDecisionDate "2017-08-11"^^xsd:date ;
    echr:hasOutcome echr:OutcomeUnknown ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "40"^^xsd:string ;
    echr:hasSupportingQuote "On 5 September 2017, the Fund responded, stating that a decision had already been made on 11 August 2017 regarding the enforcement of the relevant judgment."^^xsd:string .

doc:proceeding_rectification_2016 a echr:DomesticProceeding ;
    rdfs:label "Supreme Administrative Court rejected the Fund’s request for rectification"@en ;
    echr:followsProceeding doc:proceeding_general_assembly_2015 ;
    echr:hasCourt doc:supremeAdmin ;
    echr:hasDecisionDate "2016-01-25"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelUnknown ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "30"^^xsd:string ;
    echr:hasSupportingQuote "On 25 January 2016, the Supreme Administrative Court rejected the Fund’s request for rectification, noting that the case had become final following the appeal and was no longer subject to rectification."^^xsd:string .

doc:proceeding_supreme_admin_rectification_2017_06_30 a echr:DomesticProceeding ;
    rdfs:label "13th Chamber of the Supreme Administrative Court decision on 30 June 2017"^^xsd:string ;
    echr:followsProceeding doc:proceeding_supreme_admin_2014_12_09 ;
    echr:hasCourt doc:supremeAdmin ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "37"^^xsd:string,
        "38"^^xsd:string ;
    echr:hasSupportingQuote "On 30 June 2017, the 13 th Chamber of the Supreme Administrative Court granted the request, referring to the ruling of the General Assembly of 7 July 2015 which had annulled the Fund’s decision of 13 January 2011 concerning the valuation of Viva TV-Radio Viva (see paragraph 29 above)."^^xsd:string,
        "The court further emphasised that, since the Fund’s decision of 13 January 2011 had been definitively annulled, all actions based on that decision had been rendered legally invalid. As a result, the court overturned the judgment of the 6th Chamber of the Istanbul Administrative Court dated 19 March 2014 and annulled the sale in question."^^xsd:string .

doc:boardBrd a echr:DomesticAuthority ;
    rdfs:label "Banking Regulation and Supervision Board"^^xsd:string ;
    echr:hasAuthorityName "Banking Regulation and Supervision Board"^^xsd:string .

doc:constitutionalCourt a echr:DomesticAuthority ;
    rdfs:label "Constitutional Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Constitutional Court"^^xsd:string ;
    echr:hasSourceParagraph "41"^^xsd:string ;
    echr:hasSupportingQuote "On 11 September 2017, the applicant lodged an individual application with the Constitutional Court"^^xsd:string .

