@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/02134fd2b92f> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:8"^^xsd:string .

doc:detention_1998_04_02 a echr:PreTrialDetention ;
    rdfs:label "Detention ordered by Nizhniy Novgorod Regional Court (2 April 1998)"^^xsd:string ;
    echr:hasCustodialMeasure echr:MeasureRemandInCustody ;
    echr:hasDetainee doc:personAndreyAnatolyevichKlimentyev ;
    echr:hasDetentionStartDate "1998-04-02"^^xsd:date ;
    echr:hasSourceParagraph "9"^^xsd:string ;
    echr:hasSupportingQuote "On 2 April 1998 the Nizhniy Novgorod Regional Court granted the prosecutor's renewed motion for detention on grounds of obstruction of justice and violations of the undertaking not to leave the city, and the applicant was arrested in the course of the hearing."^^xsd:string .

doc:drydock_unfreeze_may_1996 a echr:DomesticProceeding ;
    rdfs:label "Lifting of freeze on drydock (May 1996)"^^xsd:string ;
    echr:hasCourt doc:nizhniyNovgorodProsecutorOffice ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "14"^^xsd:string ;
    echr:hasSupportingQuote "It appears that the order freezing the drydock was lifted in May 1996, as it belonged to a Norwegian company \"Aroko\"."^^xsd:string .

doc:freeze_proceeds_1996_03_11 a echr:DomesticProceeding ;
    rdfs:label "Freezing of proceeds from ship sale 11 March 1996"^^xsd:string ;
    echr:hasCourt doc:nizhniyNovgorodProsecutorOffice ;
    echr:hasDecisionDate "1996-03-11"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "12"^^xsd:string ;
    echr:hasSupportingQuote "on 11 March 1996 the proceeds from the ship sale were frozen on the order of the Nizhniy Novgorod prosecutor’s office."^^xsd:string .

doc:freeze_ship_order_1995_10_05 a echr:DomesticProceeding ;
    rdfs:label "Order freezing applicant's property (Stavanger) 5 October 1995"^^xsd:string ;
    echr:hasCourt doc:nizhniyNovgorodProsecutorOffice ;
    echr:hasDecisionDate "1995-10-05"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "9"^^xsd:string ;
    echr:hasSupportingQuote "Following the institution of an investigation against the applicant in March 1995, on 5 October 1995 property belonging to the applicant - the ship Stavanger and a floating drydock - was frozen on the order of the Nizhniy Novgorod prosecutor’s office."^^xsd:string .

doc:proc_regional_requests_1998_05_19 a echr:DomesticProceeding ;
    rdfs:label "Regional court requests (19 May 1998)"^^xsd:string ;
    echr:followsProceeding doc:proc_regional_detention_order_1998_04_02 ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasProceedingStartDate "1998-05-19"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "12"^^xsd:string ;
    echr:hasSupportingQuote "On 19 May the applicant's civil defender requested the Regional Court to dismiss the judge presiding in the case for bias. On the same day the applicant requested to admit Mrs Moskalenko as his lawyer in the trial because one of his lawyers was on sick leave. Both requests were rejected by the Regional Court."^^xsd:string .

doc:proc_supreme_appeal_detention_1998_04_23 a echr:DomesticProceeding ;
    rdfs:label "Appeal to Supreme Court against detention order (23 April 1998)"^^xsd:string ;
    echr:followsProceeding doc:proc_regional_detention_order_1998_04_02 ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasDecisionDate "1998-05-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasProceedingStartDate "1998-04-23"^^xsd:date ;
    echr:hasSourceParagraph "10"^^xsd:string ;
    echr:hasSupportingQuote "On 23 April 1998 the applicant's civil defender, who participated in the process with a status similar to that of a lawyer, lodged with the Supreme Court an appeal against the court order of 2 April to detain the applicant. He requested it to quash the order and to transfer the case to another region to be heard by jury, since it was impossible to achieve a fair and impartial trial in Nizhniy Novgorod, given the political tension surrounding the case. The reply from the Supreme Court, dated 19 May 1998, stated that the national law did not allow appeals against that type of trial court orders separately from appeals against judgments."^^xsd:string .

doc:prosecutor_quash_1982_conviction_1999_02 a echr:DomesticProceeding ;
    rdfs:label "Quashing of applicant's first (1982) conviction February 1999"^^xsd:string ;
    echr:hasCourt doc:nizhniyNovgorodProsecutorOffice ;
    echr:hasDecisionDate "1999-02"^^xsd:gYearMonth ;
    echr:hasInstanceLevel echr:LevelSupervisoryReview ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "6"^^xsd:string ;
    echr:hasSupportingQuote "In February 1999 the applicant’s first (1982) conviction was quashed, and the file in that case was closed by the Nizhniy Novgorod regional prosecutor’s office."^^xsd:string .

doc:regional_court_order_1998_05_27 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court order (частное определение) 27 May 1998"^^xsd:string ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasDecisionDate "1998-05-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "17"^^xsd:string ;
    echr:hasSupportingQuote "On 27 May 1998 the Nizhniy Novgorod Regional Court issued an order ( частное определение ) in which it noted that the investigators had violated the Code of Criminal Procedure (CCP) by transferring the money to \"Oka\" prior to a final court finding on his guilt."^^xsd:string .

doc:release_stavanger_1996_01_19 a echr:DomesticProceeding ;
    rdfs:label "Release of the Stavanger from arrest 19 January 1996"^^xsd:string ;
    echr:hasCourt doc:nizhniyNovgorodProsecutorOffice ;
    echr:hasDecisionDate "1996-01-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "12"^^xsd:string ;
    echr:hasSupportingQuote "On 19 January 1996 the Stavanger was freed from arrest - and on 11 March 1996 the proceeds from the ship sale were frozen on the order of the Nizhniy Novgorod prosecutor’s office."^^xsd:string .

doc:supreme_court_cassation_1998 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court cassation decision 10 August 1998"^^xsd:string ;
    echr:followsProceeding doc:second_trial_regional_court_1998_05_27 ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasDecisionDate "1998-08-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "4"^^xsd:string ;
    echr:hasSupportingQuote "On 10 August 1998 the Supreme Court confirmed the judgment of the Nizhniy Novgorod Regional Court, with some alterations."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:supreme_court_quash_1997_judgment a echr:DomesticProceeding ;
    rdfs:label "Supreme Court quashing of 21 April 1997 Regional Court judgment"^^xsd:string ;
    echr:followsProceeding doc:regional_court_judgment_1997_04_21 ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasSourceParagraph "15"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of the Nizhniy Novgorod Regional Court of 21 April 1997, later quashed by the Supreme Court, the applicant was ordered to pay the \"Oka\" damages..."^^xsd:string .

doc:trial_judgment_copy_received_1998_06_03 a echr:DomesticProceeding ;
    rdfs:label "Receipt of trial court judgment copy 3 June 1998"^^xsd:string ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "The applicant received a copy of the trial court judgment on 3 June 1998."^^xsd:string .

doc:trial_nizhniy_novgorod_regional_court_1998 a echr:DomesticProceeding ;
    rdfs:label "trial"^^xsd:string ;
    echr:followsProceeding doc:pretrial_investigation_1997 ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasDecisionDate "1998-05-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "5"^^xsd:string,
        "6"^^xsd:string ;
    echr:hasSupportingQuote "On 27 May 1998 the Nizhniy Novgorod Regional Court found the applicant guilty on charges of misappropriation and embezzlement, larceny, bribery and attempt not to return money from abroad."^^xsd:string,
        "The court also granted civil claims for damages by the shipyard “Oka” and three other companies, “Zhanto”, “NL TOP” and “Slot”."^^xsd:string .

doc:unfreeze_transfer_1996_05_18 a echr:DomesticProceeding ;
    rdfs:label "Unfreezing and transfer of proceeds to Oka 18 May 1996"^^xsd:string ;
    echr:hasCourt doc:nizhniyNovgorodProsecutorOffice ;
    echr:hasDecisionDate "1996-05-18"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "13"^^xsd:string ;
    echr:hasSupportingQuote "On 18 May 1996 the Nizhniy Novgorod prosecutor’s office unfroze the account and transferred the money to the yard."^^xsd:string .

doc:personAndreyAnatolyevichKlimentyev a echr:NaturalPerson ;
    rdfs:label "Andrey Anatolyevich Klimentyev"^^xsd:string ;
    echr:hasBirthYear "1954"^^xsd:gYear ;
    echr:hasPersonName "Andrey Anatolyevich Klimentyev"^^xsd:string ;
    echr:hasSourceParagraph "2"^^xsd:string ;
    echr:hasSupportingQuote "The applicant, Andrey Anatolyevich Klimentyev, is a Russian national, who was born in 1954 and lives in Nizhniy Novgorod."^^xsd:string .

doc:pretrial_investigation_1997 a echr:DomesticProceeding ;
    rdfs:label "pre-trial investigation"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingStartDate "1997"^^xsd:gYear ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "2"^^xsd:string ;
    echr:hasSupportingQuote "The third statement was taken from a German citizen P. during the pre-trial investigation and the court hearing in 1997."^^xsd:string .

doc:proc_investigation_1995_03_07 a echr:DomesticProceeding ;
    rdfs:label "Criminal charge (7 March 1995)"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingStartDate "1995-03-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "3"^^xsd:string ;
    echr:hasSupportingQuote "The applicant, together with another person, was charged with embezzlement and other economic crimes on 7 March 1995."^^xsd:string .

doc:proc_regional_court_1997_04_21 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court judgment (21 April 1997)"^^xsd:string ;
    echr:followsProceeding doc:proc_investigation_1995_03_07 ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasDecisionDate "1997-04-21"^^xsd:date ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "4"^^xsd:string ;
    echr:hasSupportingQuote "On 21 April 1997 the Nizhniy Novgorod Regional Court found the applicant guilty on some of the charges, and not guilty on most. He was sentenced to one and a half years in prison (the time he had already spent in pre-trial detention) and some of his property was confiscated."^^xsd:string .

doc:proc_regional_retrial_1998 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court retrial (30 March 1998)"^^xsd:string ;
    echr:followsProceeding doc:proc_supreme_court_1997_07 ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasProceedingStartDate "1998-03-30"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "6"^^xsd:string ;
    echr:hasSupportingQuote "On 30 March 1998, during the new trial, the prosecutor applied to the court to detain the applicant for violations of the undertaking not to leave the city during the trial and obstruction of justice. The Regional Court rejected the motion as unsubstantiated."^^xsd:string .

doc:proc_supreme_court_1997_07 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court appeal (July 1997)"^^xsd:string ;
    echr:followsProceeding doc:proc_regional_court_1997_04_21 ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasDecisionDate "1997-07"^^xsd:gYearMonth ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "5"^^xsd:string ;
    echr:hasSupportingQuote "In July 1997 the Supreme Court quashed the conviction on the applicant's appeal and remitted the case to the Nizhniy Novgorod Regional Court."^^xsd:string .

doc:regional_court_judgment_1997_04_21 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court judgment 21 April 1997"^^xsd:string ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasDecisionDate "1997-04-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "15"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of the Nizhniy Novgorod Regional Court of 21 April 1997, later quashed by the Supreme Court, the applicant was ordered to pay the \"Oka\" damages in the amount that had been transferred to it previously."^^xsd:string .

doc:second_trial_regional_court_1998_05_27 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court - second trial (27 May 1998)"^^xsd:string ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasDecisionDate "1998-05-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "16"^^xsd:string ;
    echr:hasSupportingQuote "During the second trial, on 27 May 1998 (confirmed by the Supreme Court on 10 August 1998) the applicant was ordered by the Nizhniy Novgorod Court to pay damages to \"Oka\"."^^xsd:string,
        "On 27 May 1998 the Nizhniy Novgorod Regional Court issued an order ( частное определение ) in which it noted that the investigators had violated the Code of Criminal Procedure (CCP) by transferring the money to \"Oka\" prior to a final court finding on his guilt."^^xsd:string .

doc:proc_regional_detention_order_1998_04_02 a echr:DomesticProceeding ;
    rdfs:label "Regional court detention order (2 April 1998)"^^xsd:string ;
    echr:followsProceeding doc:proc_regional_retrial_1998 ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasDecisionDate "1998-04-02"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "9"^^xsd:string ;
    echr:hasSupportingQuote "On 2 April 1998 the Nizhniy Novgorod Regional Court granted the prosecutor's renewed motion for detention on grounds of obstruction of justice and violations of the undertaking not to leave the city, and the applicant was arrested in the course of the hearing."^^xsd:string .

doc:supremeCourt a echr:DomesticAuthority ;
    rdfs:label "Supreme Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Supreme Court"^^xsd:string ;
    echr:hasSourceParagraph "5"^^xsd:string ;
    echr:hasSupportingQuote "In July 1997 the Supreme Court quashed the conviction on the applicant's appeal and remitted the case to the Nizhniy Novgorod Regional Court."^^xsd:string .

doc:nizhniyNovgorodProsecutorOffice a echr:DomesticAuthority ;
    rdfs:label "Nizhniy Novgorod prosecutor's office"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Nizhniy Novgorod prosecutor's office"^^xsd:string .

doc:nizhniyNovgorodRegionalCourt a echr:DomesticAuthority ;
    rdfs:label "Nizhniy Novgorod Regional Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Nizhniy Novgorod Regional Court"^^xsd:string ;
    echr:hasSourceParagraph "4"^^xsd:string ;
    echr:hasSupportingQuote "On 21 April 1997 the Nizhniy Novgorod Regional Court found the applicant guilty on some of the charges, and not guilty on most."^^xsd:string .

