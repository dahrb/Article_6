doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    echr:hasCourt doc:domestic_authority_1 ;
    echr:hasDecisionDate "2000-11-20"^^xsd:date,
        "2005-12-30"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview,
        echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant,
        echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasProceedingStartDate "2000"^^xsd:gYear ;
    echr:hasProceedingType echr:TypeAdministrative,
        echr:TypeCivil ;
    echr:hasSourceParagraph "10"^^xsd:string,
        "34"^^xsd:string ;
    echr:hasSupportingQuote "In a judgment of 20 November 2000, the court declared the applicant to be partially incapacitated on the grounds that he had been suffering from simple schizophrenia since 1975, and that his ability to manage his own affairs and interests and to realise the consequences of his own acts had been impaired. The court found that the applicant's condition was not so serious as to warrant a declaration of total incapacity."^^xsd:string,
        "on 30 December 2005 the municipal social assistance department carried out a \"social assessment\" ( социална оценка ) of the applicant, which concluded that he was incapable of working, even in a sheltered environment, and had no need for training or retraining, and that in those circumstances he was entitled to a social allowance to cover the costs of his transport, subsistence and medication."^^xsd:string ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

doc:natural_person_1 a echr:NaturalPerson ;
    echr:hasBirthYear "1956"^^xsd:gYear ;
    echr:hasGender echr:GenderMale ;
    echr:hasGenderCue "Mr"^^xsd:string ;
    echr:hasGenderCueText "Mr Rusi Kosev Stanev"^^xsd:string ;
    echr:hasHonorific "Mr"^^xsd:string,
        "the"^^xsd:string ;
    echr:hasPersonName "Mr Rusi Kosev Stanev"^^xsd:string,
        "the applicant"^^xsd:string ;
    echr:hasSourceParagraph "11"^^xsd:string,
