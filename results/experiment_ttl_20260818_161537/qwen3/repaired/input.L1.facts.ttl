doc:quant_1 a schema:QuantitativeValue ;
    echr:hasSourceParagraph "20"^^xsd:string ;
    echr:hasSupportingQuote "According to a report produced by the Social Assistance Agency in April 2009, there were seventy-three people living in the home, one was in hospital and two had absconded."^^xsd:string ;
    schema:value 1 .

doc:quant_130 a schema:MonetaryAmount ;
    echr:hasSourceParagraph "18"^^xsd:string ;
    echr:hasSupportingQuote "The applicant’s invalidity pension, as updated in 2008, amounted to 130 Bulgarian levs (BGN – approximately 65 euros (EUR))"^^xsd:string ;
    schema:amount 130.0 ;
    schema:currency "BGN"^^xsd:string .

doc:quant_2 a schema:QuantitativeValue ;
    echr:hasSourceParagraph "20"^^xsd:string ;
    echr:hasSupportingQuote "According to a report produced by the Social Assistance Agency in April 2009, there were seventy-three people living in the home, one was in hospital and two had absconded."^^xsd:string ;
    schema:value 2 .

doc:quant_23 a schema:QuantitativeValue ;
    echr:hasSourceParagraph "20"^^xsd:string ;
    echr:hasSupportingQuote "Among the residents, twenty-three were entirely lacking legal capacity, two were partially lacking capacity and the others enjoyed full legal capacity."^^xsd:string ;
    schema:value 23 .

doc:quant_2_2 a schema:QuantitativeValue ;
    echr:hasSourceParagraph "20"^^xsd:string ;
    echr:hasSupportingQuote "Among the residents, twenty-three were entirely lacking legal capacity, two were partially lacking capacity and the others enjoyed full legal capacity."^^xsd:string ;
    schema:value 2 .

doc:quant_3 a schema:QuantitativeValue ;
    echr:hasSourceParagraph "20"^^xsd:string ;
    echr:hasSupportingQuote "The home, built in the 1920s, comprises three buildings, where its residents, all male, are housed according to the state of their mental health."^^xsd:string ;
    schema:value 3 .

doc:quant_400 a schema:Distance ;
    echr:hasSourceParagraph "15"^^xsd:string ;
    echr:hasSupportingQuote "Later that day, the applicant was taken by ambulance to the Pastra social care home, some 400 km from Ruse."^^xsd:string ;
    schema:distance 400 ;
    schema:unitCode "km"^^xsd:string .

doc:quant_65 a schema:MonetaryAmount ;
    echr:hasSourceParagraph "18"^^xsd:string ;
    echr:hasSupportingQuote "The applicant’s invalidity pension, as updated in 2008, amounted to 130 Bulgarian levs (BGN – approximately 65 euros (EUR))"^^xsd:string ;
    schema:amount 65.0 ;
    schema:currency "EUR"^^xsd:string .

doc:quant_73 a schema:QuantitativeValue ;
    echr:hasSourceParagraph "20"^^xsd:string ;
    echr:hasSupportingQuote "According to a report produced by the Social Assistance Agency in April 2009, there were seventy-three people living in the home, one was in hospital and two had absconded."^^xsd:string ;
    schema:value 73 .

doc:quant_8 a schema:Distance ;
    echr:hasSourceParagraph "19"^^xsd:string ;
    echr:hasSupportingQuote "It is accessible via a dirt track from the village of Pastra, the nearest locality 8 km away."^^xsd:string ;
    schema:distance 8 ;
    schema:unitCode "km"^^xsd:string .

doc:quant_80 a schema:MonetaryAmount ;
    echr:hasSourceParagraph "18"^^xsd:string ;
    echr:hasSupportingQuote "The agreement stipulated that 80% of the sum was to be used as payment for the services provided and the remaining 20% put aside for personal expenses."^^xsd:string ;
    schema:amount 80.0 ;
    schema:currency "PERCENT"^^xsd:string .

doc:article6_issue_1 a echr:Article6Issue ;
    echr:affectsParty doc:party_1 ;
    echr:hasDelayAttribution echr:DelayAttributedToAuthorities ;
    echr:hasExtractionNote "Detention spans multiple proceedings; attributed to authorities due to systemic institutionalization without judicial oversight."^^xsd:string ;
    echr:hasSourceParagraph "10"^^xsd:string,
        "3"^^xsd:string ;
    echr:hasSupportingQuote "He also submitted that he had no access to a court to seek release from partial guardianship (Article 6 of the Convention)."^^xsd:string,
        "during the period from 1975 to 2000 he had been admitted to a psychiatric hospital on several occasions"^^xsd:string .

