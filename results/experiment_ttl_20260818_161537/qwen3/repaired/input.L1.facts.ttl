    echr:hasStatedDetentionDuration "P1518D"^^xsd:duration,
        "P25Y"^^xsd:duration ;
    echr:hasSupportingQuote "He had been on maintenance medication since 2002 under the monthly supervision of a psychiatrist."^^xsd:string,
        "during the period from 1975 to 2000 he had been admitted to a psychiatric hospital on several occasions"^^xsd:string .

