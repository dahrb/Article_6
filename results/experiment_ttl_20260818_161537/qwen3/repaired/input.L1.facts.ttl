doc:domestic_proceeding_2 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_1 ;
    echr:hasCourt doc:domestic_authority_1 ;
    echr:hasDecisionDate "2007-02-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_2 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "34"^^xsd:string ;
    echr:hasSupportingQuote "On 7 February 2007 the municipal social assistance department granted the applicant a monthly allowance of BGN 16.50 (approximately EUR 8)."^^xsd:string .

doc:domestic_proceeding_3 a echr:DomesticProceeding ;
    echr:hasCourt doc:domestic_authority_2 ;
    echr:hasDecisionDate "2006-10-13"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_2 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "28"^^xsd:string ;
    echr:hasSupportingQuote "After the applicant failed to return on the scheduled date, the Director of the home wrote to the Ruse municipal police on 13 October 2006, asking them to search for the applicant and transfer him to Sofia, where employees of the home would be able to collect him and take him back to Pastra."^^xsd:string .

doc:domestic_proceeding_4 a echr:DomesticProceeding ;
    echr:hasCourt doc:domestic_authority_2 ;
    echr:hasDecisionDate "2006-10-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_4 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "28"^^xsd:string ;
    echr:hasSupportingQuote "On 19 October 2006 the Ruse police informed the Director that the applicant’s whereabouts had been discovered but that the police could not transfer him because he was not the subject of a wanted notice."^^xsd:string .

doc:domestic_proceeding_5 a echr:DomesticProceeding ;
    echr:hasCourt doc:domestic_authority_4 ;
    echr:hasDecisionDate "2006-10-31"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_4 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "28"^^xsd:string ;
    echr:hasSupportingQuote "He was driven back to the social care home on 31 October 2006, apparently by staff of the home."^^xsd:string .

doc:domestic_proceeding_6 a echr:DomesticProceeding ;
    echr:hasCourt doc:domestic_authority_5 ;
    echr:hasDecisionDate "2005-06-15"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_6 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "31"^^xsd:string ;
    echr:hasSupportingQuote "It appears from a medical certificate of 15 June 2005 (see paragraph 37 below) that, following his placement in the home in 2002, the applicant was given anti-psychotic medication (carbamazepine (600 mg)) under the monthly supervision of a psychiatrist."^^xsd:string .

doc:domestic_proceeding_7 a echr:DomesticProceeding ;
    echr:hasCourt doc:domestic_authority_6 ;
    echr:hasDecisionDate "2005"^^xsd:gYear ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnknown ;
    echr:hasParticipation doc:participation_7 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "33"^^xsd:string ;
    echr:hasSupportingQuote "Once a year, the Director of the social care home and the home’s social worker drew up evaluation reports on the applicant’s behaviour and social skills. The reports indicated that the applicant was uncommunicative, preferred to stay on his own rather than join in group activities, refused to take his medication and had no close relatives to visit while on leave of absence. He was not on good terms with his half-sister and nobody was sure whether he had anywhere to live outside the social care home. The reports concluded that it was impossible for the applicant to reintegrate into society, and set the objective of ensuring that he acquired the necessary skills and knowledge for social resettlement and, in the long term, reintegration into his family. It appears that he was never offered any therapy to that end."^^xsd:string .

doc:inactivity_period_1 a echr:InactivityPeriod ;
    echr:hasDomesticProceeding doc:proceeding_3 ;
    echr:hasInactivityCause echr:DelayAttributedToAuthorities ;
    echr:hasInactivityEndDate "2002-05-23"^^xsd:date ;
    echr:hasInactivityStartDate "2001-06-07"^^xsd:date ;
    echr:hasSourceParagraph "11-12"^^xsd:string ;
    echr:hasSupportingQuote "and was subsequently transmitted to the Ruse Municipal Council on 7 June 2001 for the appointment of a guardian. Since the applicant’s family members had refused to take on any guardianship responsibilities, on 23 May 2002 the Municipal Council appointed Ms R.P."^^xsd:string .

doc:inactivity_period_2 a echr:InactivityPeriod ;
    echr:hasDomesticProceeding doc:proceeding_5 ;
    echr:hasInactivityCause echr:DelayAttributedToAuthorities ;
    echr:hasInactivityEndDate "2002-12-10"^^xsd:date ;
    echr:hasInactivityStartDate "2002-07-23"^^xsd:date ;
    echr:hasSourceParagraph "13-14"^^xsd:string ;
    echr:hasSupportingQuote "Social services drew up a welfare report on the applicant, noting on 23 July 2002 that he was suffering from schizophrenia, that he lived alone in a small, run-down annexe to his half-sister’s house and that his half-sister and his father’s second wife had stated that they did not wish to act as his guardian. The requirements for placement in a social care home were therefore deemed to be fulfilled. On 10 December 2002 a welfare-placement agreement was signed between R.P. and the social care home for adults with mental disorders near the village of Pastra in the municipality of Rila (\"the Pastra social care home\"), an institution under the responsibility of the Ministry of Labour and Social Policy"^^xsd:string .

