    echr:isAnonymised true .

doc:proceeding_1 a echr:DomesticProceeding ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:authority_1 ;
    echr:hasDecisionDate "2016-08-22"^^xsd:date,
        "2016-09-13"^^xsd:date,
        "2016-12-07"^^xsd:date ;
    echr:hasExtractionNote "The text states that the Belgian legislation enables a stay of more than 90 days; this duration is referenced as a legal threshold in the context of the visa refusal, and is not the duration of the proceeding itself."^^xsd:string ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview,
        echr:LevelAppeal,
        echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination,
        echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingStartDate "2016-09-13"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative,
        echr:TypeCivil ;
    echr:hasSourceParagraph "11"^^xsd:string,
        "75"^^xsd:string,
        "8"^^xsd:string ;
    echr:hasStatedDuration "P90D"^^xsd:duration ;
    echr:hasSupportingQuote "On 13 September 2016 the Aliens Office, the administrative body responsible for issuing visas (see paragraph 45 below), refused to grant \"humanitarian visas\" to the applicants and informed them of its decisions by an email of 29 September 2016, transmitted through the visa department of the Belgian embassy in Beirut."^^xsd:string,
        "the Brussels Court of Appeal’s judgment of 7 December 2016"^^xsd:string,
        "the applicants attempted, firstly, to obtain documents that would enable them to enter and reside legally in Belgium for the period required to make a formal asylum claim; secondly, they brought proceedings before the administrative courts to challenge the refusal by the Aliens Office to issue them with visas."^^xsd:string ;
    echr:raisesArticle6Issue doc:issue_1 .

doc:proceeding_2 a echr:DomesticProceeding ;
    echr:followsProceeding doc:proceeding_1,
