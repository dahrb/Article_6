    echr:hasStatedDuration "P180D"^^xsd:duration ;
    echr:hasSupportingQuote "its judgments, in particular that of 7 October 2016"^^xsd:string,
        "the appeal lodged with it was not wholly devoid of purpose"^^xsd:string ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

doc:domestic_proceeding_3 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_2 ;
    echr:hasCourt doc:domestic_authority_2 ;
    echr:hasDecisionDate "2016-12-14"^^xsd:date,
        "2018-05-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal,
        echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeClaimDismissed,
        echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionMixed,
        echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative,
        echr:TypeCivil ;
    echr:hasSourceParagraph "23"^^xsd:string,
        "37"^^xsd:string ;
    echr:hasSupportingQuote "An administrative appeal on points of law lodged by the applicants against that judgment was dismissed by the Conseil d’État on 17 May 2018"^^xsd:string,
        "on an appeal by the Belgian State, the court of appeal varied the decision of the first-instance court in a judgment of 14 December 2016"^^xsd:string .

doc:domestic_proceeding_4 a echr:DomesticProceeding ;
    echr:hasCourt doc:domestic_authority_1,
        doc:domestic_authority_3 ;
    echr:hasDecisionDate "2016-10-20"^^xsd:date,
        "2016-12-13"^^xsd:date ;
    echr:hasDomesticProceeding doc:case_document_1 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeasureImposed,
        echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant,
        echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2016-10-17"^^xsd:date,
        "2016-12-13"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative,
        echr:TypeCivil ;
    echr:hasSourceParagraph "25"^^xsd:string,
        "37"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of 20 October 2016 the Aliens Appeals Board, essentially reiterating the substance of its previous judgments, ordered a stay of execution of the refusal decisions of 17 October 2016. In addition, in view of the imminent danger faced by the applicants, the Belgian State’s persistent refusal to comply with res judicata authority and the importance of ensuring that the remedy was effective, it considered that it was justified to direct the State to issue the applicants, within 48 hours, with laissez-passers or visas, valid for three months."^^xsd:string,
        "the Belgian State... lodged a unilateral action to that effect with the President of the Brussels Dutch ‐ speaking TPI on 13 December 2016, but was unsuccessful (order of the same date)"^^xsd:string .

doc:domestic_proceeding_6 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_5 ;
    echr:hasCourt doc:domestic_authority_2,
        doc:domestic_authority_5 ;
    echr:hasDecisionDate "2018-05-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation,
        echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed,
        echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant,
        echr:DirectionUnknown ;
    echr:hasProceedingStartDate "2016-12-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative,
        echr:TypeCivil ;
    echr:hasSourceParagraph "27"^^xsd:string,
        "39"^^xsd:string ;
    echr:hasSupportingQuote "An appeal on points of law against this judgment was dismissed by the Conseil d’État in a judgment of 17 May 2018, on the same grounds as those set out in the above-cited judgment of the same date (see paragraph 23 above)."^^xsd:string,
        "the Belgian State brought proceedings against the applicants before the enforcement judge at the Brussels Dutch ‐ language TPI, seeking a stay of execution of the principal sentence... and/or to prevent other enforcement measures"^^xsd:string .

doc:domestic_proceeding_7 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_3,
        doc:domestic_proceeding_5,
        doc:domestic_proceeding_6 ;
    echr:hasCourt doc:domestic_authority_2,
        doc:domestic_authority_3 ;
    echr:hasDecisionDate "2016-10-25"^^xsd:date,
        "2017-06-30"^^xsd:date ;
    echr:hasDomesticProceeding doc:case_document_1 ;
    echr:hasInstanceLevel echr:LevelAppeal,
        echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed,
        echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant,
        echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2016-10-25"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative,
        echr:TypeCivil ;
    echr:hasSourceParagraph "30"^^xsd:string,
        "40"^^xsd:string ;
    echr:hasSupportingQuote "By an order of 25 October 2016, considering that the failure by the Aliens Office to comply with a judgment of the Aliens Appeals Board, notwithstanding the fact that it had been immediately enforceable, constituted \"an unacceptable illegal action\", the acting president of the French-language TPI ordered the State, as an urgent measure, to comply with the Board’s judgment of 20 October 2016, that is, to issue the applicants with visas or laissez-passers , and made the order subject to a penalty payment of 1,000 euros (EUR) per day of delay and per applicant."^^xsd:string,
        "a Dutch-language division of the Court of Appeal held that the Aliens Appeals Boards’ judgment of 20 October 2016 was no longer operative... the court of appeal’s judgment of 7 December 2016 was thus no longer operative"^^xsd:string .

doc:domestic_proceeding_8 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_5,
        doc:domestic_proceeding_7 ;
    echr:hasCourt doc:domestic_authority_3,
        doc:domestic_authority_4 ;
    echr:hasDecisionDate "2016-11-07"^^xsd:date,
        "2017-12-20"^^xsd:date ;
    echr:hasDomesticProceeding doc:case_document_1 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2016-11-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative,
        echr:TypeCivil ;
    echr:hasSourceParagraph "31"^^xsd:string,
        "42"^^xsd:string ;
    echr:hasSupportingQuote "On 7 November 2016 another judge acting as president of the French-language TPI declared their application admissible but unfounded, considering that the Belgian authorities could not be criticised for failing voluntarily to comply with a judgment by the Aliens Appeals Board, even one that was immediately enforceable, if these same authorities intended to challenge the legality of the judgment by pursuing an appeal procedure provided for by law. The judge also held that, since the legislature had not given the Aliens Appeals Board powers to impose penalty payments, the TPI in turn did not have such powers in the case under examination."^^xsd:string,
        "the French-language enforcement judge... found that the case had become devoid of purpose following the Brussels Court of Appeal’s judgment of 30 June 2017"^^xsd:string .

