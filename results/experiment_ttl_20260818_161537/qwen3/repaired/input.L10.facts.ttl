doc:proceeding_6 a echr:DomesticProceeding ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:authority_3 ;
    echr:hasDecisionDate "2018-02-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2018-02-08"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "17"^^xsd:string ;
    echr:hasSupportingQuote "On 8 February 2018 the Conseil d’État dismissed an appeal on points of law by the applicants against the judgment of 6 March 2017. It held that no departure from the case-law had been made out and dismissed the arguments in which the applicants alleged a breach of the principle of legal certainty and a violation of Articles 3 and 13 of the Convention."^^xsd:string .

doc:proceeding_7 a echr:DomesticProceeding ;
    echr:followsProceeding doc:proceeding_5 ;
    echr:hasCourt doc:authority_3 ;
    echr:hasDecisionDate "2018-02-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2018-02-08"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "18"^^xsd:string ;
    echr:hasSupportingQuote "On the same date the Conseil d’État dismissed an appeal on points of law brought by the Belgian State against the judgment of 7 October 2016 on the grounds that, following the lifting of the stay of execution on 6 March 2017, the contested judgment no longer adversely affected the Belgian State."^^xsd:string .

