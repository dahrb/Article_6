doc:proceeding_4 a echr:DomesticProceeding ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:authority_1 ;
    echr:hasDecisionDate "2016-10-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2016-10-10"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "19"^^xsd:string ;
    echr:hasSupportingQuote "As required by the order of the Aliens Appeals Board (see paragraph 15 above), the Aliens Office issued new decisions, dated 10 October 2016, refusing to grant the visas; however, it provided the same reasons as in the previous refusals. In the notification email sent to the applicants’ lawyer, it stated that \"Article 3 of the Convention [could] not be interpreted as requiring States to admit to their territory all persons living in catastrophic situations, at the risk of requiring the developed countries to accept entire populations from the developing world, countries at war or those ravaged by natural disasters\"."^^xsd:string .

doc:proceeding_5 a echr:DomesticProceeding ;
    echr:followsProceeding doc:proceeding_4 ;
    echr:hasCourt doc:authority_2 ;
    echr:hasDecisionDate "2016-10-14"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingStartDate "2016-10-14"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "20"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of 14 October 2016 the Aliens Appeals Board, acting under the extremely urgent procedure, again ordered a stay of execution of the decision of 10 October 2016 refusing to issue the visas, and instructed the Aliens Office to take new decisions, this time giving adequate legal grounds, within 48 hours."^^xsd:string .

doc:article6_issue_1 a echr:Article6Issue ;
    echr:affectsParty doc:party_1 ;
    echr:hasDelayAttribution echr:DelayAttributedToAuthorities ;
    echr:hasSourceParagraph "33"^^xsd:string ;
    echr:hasSupportingQuote "despite the absence of any proceedings to have the decisions of 13 September 2016 refusing the visas set aside"^^xsd:string .

