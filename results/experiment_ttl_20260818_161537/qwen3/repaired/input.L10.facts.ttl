    echr:hasSourceParagraph "22"^^xsd:string,
        "33"^^xsd:string ;
    echr:hasStatedDuration "P180D"^^xsd:duration ;
    echr:hasSupportingQuote "On 24 March 2017 the Aliens Appeals Board dismissed the application to have those decisions set aside"^^xsd:string,
        "the court of appeal ordered the Belgian State to execute the Aliens Appeals Board’s judgment of 20 October 2016, which had instructed the Belgian authorities to issue visas or laissez-passers , held that this order was immediately enforceable and, lastly, ruled that the State was to pay a penalty of EUR 1,000 per day of delay and per applicant"^^xsd:string ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

