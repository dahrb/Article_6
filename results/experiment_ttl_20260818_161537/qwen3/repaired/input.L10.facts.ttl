    echr:hasDecisionDate "2016-10-07"^^xsd:date,
        "2016-10-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview,
        echr:LevelAppeal,
        echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimGranted,
        echr:OutcomeMeasureImposed,
        echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant,
        echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_3,
        doc:participation_4 ;
    echr:hasProceedingStartDate "2016-08-22"^^xsd:date,
        "2016-09-14"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "14"^^xsd:string,
        "75"^^xsd:string,
        "9"^^xsd:string ;
    echr:hasSupportingQuote "On 22 August 2016 the applicant couple, accompanied by one of their children, travelled to the Belgian embassy in Beirut to submit visa applications for themselves and their two children."^^xsd:string,
        "The applicants lodged an application under the extremely urgent procedure with the Aliens Appeals Board – the judicial appeal body against decisions by the Aliens Office (see paragraph 52 below) –, requesting a stay of execution, under the extremely urgent procedure, of the Aliens Office’s decisions of 13 September 2016 (see paragraph 11 above)."^^xsd:string,
        "the Aliens Appeals Board’s judgment of 20 October 2016"^^xsd:string ;
    echr:raisesArticle6Issue doc:issue_2 .

doc:proceeding_3 a echr:DomesticProceeding ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:authority_2,
        doc:authority_3 ;
    echr:hasDecisionDate "2017-03-06"^^xsd:date ;
