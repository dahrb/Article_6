doc:secondVisaRefusalAction a echr:AdministrativeAction ;
    rdfs:label "second refusal of visas"@en ;
    echr:followsProceeding doc:urgent_stay_proceeding_1 ;
    echr:hasCourt doc:aliensOffice ;
    echr:hasDecisionDate "2016-10-10"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partVisaRefusalAliensOffice,
        doc:partVisaRefusalApplicants ;
    echr:hasSupportingQuote "the Aliens Office issued new decisions, dated 10 October 2016, refusing to grant the visas"@en .

doc:tpi_urgent_order_oct16 a echr:DomesticProceeding ;
    rdfs:label "unilateral application for urgent measure before TPI (25 October 2016)"@en ;
    echr:followsProceeding doc:stay_refusal_oct17 ;
    echr:hasCourt doc:brusselsTpiFrench ;
    echr:hasDecisionDate "2016-10-25"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:partTpiUrgentApplicants,
        doc:partTpiUrgentState ;
    echr:hasSupportingQuote "By an order of 25 October 2016... the acting president of the French-language TPI ordered the State, as an urgent measure, to comply with the Board’s judgment of 20 October 2016"@en,
        "made the order subject to a penalty payment of 1,000 euros (EUR) per day of delay and per applicant"@en .

doc:appeal_tpi_dec_16 a echr:DomesticProceeding ;
    rdfs:label "appeal against TPI order of 7 November 2016 (7 December 2016)"@en ;
    echr:followsProceeding doc:tpi_inter_partes_action_nov16 ;
    echr:hasCourt doc:brusselsCourtAppeal ;
    echr:hasDecisionDate "2016-12-07"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:partCeAppealApplicants,
        doc:part_appeal_dec16_state ;
    echr:hasSupportingQuote "On an appeal by the applicants, the Brussels Court of Appeal delivered a judgment on 7 December 2016 varying the order of 7 November 2016"@en,
        "the Brussels Court of Appeal delivered a judgment on 7 December 2016 varying the order of 7 November 2016. It held that the applicants could rely on the binding and enforceable nature of the contested judgment"@en .

