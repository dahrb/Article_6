doc:stay_refusal_oct17 a echr:DomesticProceeding ;
    rdfs:label "proceeding for stay of execution and laissez-passers (20 October 2016)"@en,
        "proceeding for stay of execution of 17 October decisions"@en ;
    echr:followsProceeding doc:thirdVisaRefusalAction ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2016-10-20"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_stay_oct20_applicants,
        doc:part_stay_oct20_state ;
    echr:hasSupportingQuote "By a judgment of 20 October 2016 the Aliens Appeals Board... ordered a stay of execution of the refusal decisions of 17 October 2016"@en .

doc:urgent_stay_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "urgent application for stay of execution (Oct 2016)"@en ;
    echr:followsProceeding doc:visaRefusalAction ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2016-10-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_urgent_stay_1_applicants,
        doc:part_urgent_stay_1_state ;
    echr:hasSupportingQuote "On 7 October 2016 the Aliens Appeals Board, acting under the extremely urgent procedure, ordered a stay of execution of the refusals"@en .

