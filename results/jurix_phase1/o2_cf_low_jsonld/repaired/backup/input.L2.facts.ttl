doc:appealsBoardEsa a echr:DomesticAuthority ;
    rdfs:label "Appeals Board"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Appeals Board"^^xsd:string ;
    echr:hasSupportingQuote "There shall be set up an Appeals Board, independent of the Agency"^^xsd:string,
        "the ESA Appeals Board, which is “independent of the Agency”, has jurisdiction “to hear disputes relating to any explicit or implicit decision taken by the Agency and arising between it and a staff member”"@en .

doc:case_28934_95 a echr:CaseDocument ;
    echr:hasApplicant doc:karlheinzBeer,
