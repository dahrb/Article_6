    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeSettledOrWithdrawn ;
    echr:hasParticipation doc:partBeerTi,
        doc:partTiDismissal ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "In the proceedings instituted by the second applicant against his dismissal by the company T.I. ... a settlement had been reached in the Darmstadt Labour Court on 6 September 1994"@en .

doc:proceedingStatusEsa a echr:DomesticProceeding ;
    rdfs:label "proceedings against ESA regarding employee status"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partBeerEsa,
        doc:partEsaStatus,
        doc:partReganEsa,
        doc:part_esa_status_2 ;
    echr:hasProceedingStartDate "1993-10"^^xsd:string ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "In October and November 1993 the applicants instituted proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA"@en,
        "The Darmstadt Labour Court concluded that the conditions under section 20(2) of the German Courts Act for finding that the applicants’ action was inadmissible were fulfilled."@en,
        "in giving effect to the immunity from jurisdiction of ESA on the basis of section 20(2) of the Courts Act, the German courts did not exceed their margin of appreciation"@en,
        "the reasons advanced by the German labour courts to give effect to the immunity from jurisdiction of ESA"@en .

