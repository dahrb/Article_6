    echr:hasApplicationNumber "28934/95"@en ;
    echr:hasCaseName "Beer and Regan v. Germany"@en ;
    echr:hasJudgmentDate "1999-02-18"^^xsd:date ;
    echr:hasRespondentState "Federal Republic of Germany"@en ;
    echr:hasSupportingQuote "the application (no. 28934/95)"^^xsd:string,
        "Mr Beer and Mr Regan applied to the Commission on 13 September 1995"@en .

