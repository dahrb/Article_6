    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partMayorDupnitsa,
        doc:partStanevDupnitsa ;
    echr:hasProceedingStartDate "2005-09-28"^^xsd:date ;
    echr:hasSupportingQuote "The Dupnitsa District Court gave judgment on 10 March 2006. ... the court dismissed the application"@en .

doc:reviewCapacitySupreme a echr:ProsecutorialReview ;
    rdfs:label "Chief Public Prosecutor review of legal capacity"@en ;
    echr:followsProceeding doc:reviewCapacityAppellate ;
    echr:hasCourt doc:prosecutorChiefSupreme ;
