doc:actionGuardianRila a echr:AdministrativeAction ;
    rdfs:label "Appointment of Director of Pastra home as guardian"@en ;
    echr:hasCourt doc:councilRilaMunicipal ;
    echr:hasDecisionDate "2005-02-02"^^xsd:date ;
    echr:hasSupportingQuote "the Municipal Council had decided on 2 February 2005 to appoint the Director of the Pastra social care home as the applicant’s guardian"@en .

doc:actionPlacementHome a echr:AdministrativeAction ;
    rdfs:label "Placement in Pastra social care home"@en ;
    echr:followsProceeding doc:actionGuardianAppointment ;
    echr:hasDecisionDate "2002-12-10"^^xsd:date ;
    echr:hasSupportingQuote "On 10 December 2002 a welfare-placement agreement was signed between R.P. and the social care home"@en .

doc:actionSocialAllowance a echr:AdministrativeAction ;
    rdfs:label "Granting of social allowance"@en ;
    echr:hasCourt doc:deptSocialAssistanceRila ;
    echr:hasDecisionDate "2007-02-07"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasSupportingQuote "On 7 February 2007 the municipal social assistance department granted the applicant a monthly allowance"@en .

doc:caseStanevBulgaria a echr:CaseDocument ;
    echr:hasApplicant doc:applicantStanev ;
    echr:hasApplicationNumber "36760/06"@en ;
    echr:hasCaseName "Stanev v. Bulgaria"@en ;
    echr:hasDomesticProceeding doc:proceedingIncapacityRuse .

