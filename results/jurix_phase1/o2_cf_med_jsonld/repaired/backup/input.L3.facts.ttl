<https://growgraph.dev/doc/acf1d7ca24c0> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:3"^^xsd:string .

doc:administrativeActionVivaTvRadioViva a echr:AdministrativeAction ;
    rdfs:label "Establishment of Viva TV and Radio Viva economic units"@en ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2007-07-19"^^xsd:date ;
    echr:hasSupportingQuote "On 19 July 2007, the Fund decided to establish two economic and commercial units: one for Viva TV and the other for Radio Viva."@en .

doc:administrative_action_1 a echr:AdministrativeAction ;
    rdfs:label "Transfer of İktisat Bank management"@en ;
    echr:hasCourt doc:bankingBoard ;
    echr:hasDecisionDate "2001-03-15"^^xsd:date ;
    echr:hasParticipation doc:participation_board_1 ;
    echr:hasSupportingQuote "By a decision dated 15 March 2001, the Banking Regulation and Supervision Board... resolved to transfer the management and control of İktisat Bankası T.A.Ş."@en .

doc:administrative_action_2 a echr:AdministrativeAction ;
    rdfs:label "Debt recovery resolution"@en ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2001-09-14"^^xsd:date ;
    echr:hasParticipation doc:participation_fund_1 ;
    echr:hasSupportingQuote "on 14 September 2001, the Fund resolved to recover 726,122,000 Turkish liras from the former shareholders"@en .

doc:administrative_action_3 a echr:AdministrativeAction ;
    rdfs:label "Default and asset sale resolution"@en ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2008-04-03"^^xsd:date ;
    echr:hasParticipation doc:participation_fund_1 ;
    echr:hasSupportingQuote "On 3 April 2008, the Fund concluded that the Erol Aksoy Group had failed to fulfil several commitments... resolved to initiate legal proceedings"@en .

doc:administrative_action_4 a echr:AdministrativeAction ;
    rdfs:label "Transfer of Erol Aksoy Group management"@en ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2008-09-18"^^xsd:date ;
    echr:hasParticipation doc:participation_fund_1 ;
    echr:hasSupportingQuote "On 18 September 2008, the Fund further resolved to transfer the management and control of all companies within the Erol Aksoy Group to itself"@en .

doc:administrative_action_enforcement_refusal_2015 a echr:AdministrativeAction ;
    rdfs:label "Fund decision on impossibility of enforcement"@en ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2015-10-27"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "the Fund notified the applicant of a decision taken on 27 October 2015 regarding the impossibility of enforcing the judgment"@en .

doc:case_58919_18 a echr:CaseDocument ;
    echr:hasApplicant doc:erolAksoy ;
    echr:hasApplicationNumber "58919/18"@en ;
    echr:hasCaseName "Erol Aksoy v. Türkiye"@en .

doc:domestic_proceeding_constitutional_2017 a echr:DomesticProceeding ;
    rdfs:label "Individual application to Constitutional Court"@en ;
    echr:followsProceeding doc:administrative_action_enforcement_refusal_2017 ;
    echr:hasCourt doc:constitutionalCourt ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_aksoy_rect_2017 ;
    echr:hasProceedingStartDate "2017-09-11"^^xsd:date ;
    echr:hasSupportingQuote "On 11 September 2017, the applicant lodged an individual application with the Constitutional Court... In a decision of 23 May 2018... the Constitutional Court declared the application inadmissible"@en .

doc:domestic_proceeding_general_assembly_2015 a echr:DomesticProceeding ;
    rdfs:label "General Assembly of Administrative Proceedings Divisions decision"@en ;
    echr:followsProceeding doc:domestic_proceeding_supreme_admin_2014 ;
    echr:hasCourt doc:generalAssemblyAdmin ;
    echr:hasDecisionDate "2015-07-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_aksoy_ga_2015,
        doc:participation_fund_ga_2015 ;
    echr:hasSupportingQuote "On 7 July 2015, following an appeal by the applicant, the General Assembly... annulled the Fund’s decision."@en ;
    echr:isFinalDomesticDecision true .

doc:administrative_action_enforcement_refusal_2017 a echr:AdministrativeAction ;
    rdfs:label "Fund response to enforcement request August 2017"@en ;
    echr:followsProceeding doc:domestic_proceeding_rectification_2017 ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2017-08-11"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "a decision had already been made on 11 August 2017 regarding the enforcement of the relevant judgment"@en .

doc:administrative_action_tender_2011 a echr:AdministrativeAction ;
    rdfs:label "Tender invitation for Viva TV-Radio Viva"@en ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2011-01-13"^^xsd:date ;
    echr:hasSupportingQuote "On 13 January 2011, the Fund decided to offer Viva TV-Radio Viva for sale again, setting the reserve price at USD 6,000,000."@en .

doc:constitutionalCourt a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Constitutional Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Constitutional Court"@en ;
    echr:hasSupportingQuote "the applicant lodged an individual application with the Constitutional Court"@en .

doc:domestic_proceeding_admin_court_2011 a echr:DomesticProceeding ;
    rdfs:label "Administrative court challenge to Viva TV-Radio Viva sale"@en ;
    echr:followsProceeding doc:administrative_action_tender_2011 ;
    echr:hasCourt doc:istanbulAdminCourt ;
    echr:hasDecisionDate "2014-03-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_aksoy_admin_2011,
        doc:participation_fund_admin_2011 ;
    echr:hasProceedingStartDate "2011-02-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 19 March 2014, the 6th Chamber of the İstanbul Administrative Court dismissed the applicant’s claim"@en,
        "On 7 February 2011, the applicant initiated proceedings before the administrative court, contesting the actions of the Fund concerning the tendering of Viva TV-Radio Viva"@en .

doc:domestic_proceeding_rectification_2017 a echr:DomesticProceeding ;
    rdfs:label "Request for rectification before Supreme Administrative Court"@en ;
    echr:followsProceeding doc:domestic_proceeding_supreme_admin_2014 ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_aksoy_rect_2017,
        doc:participation_fund_rect_2017 ;
    echr:hasSupportingQuote "On 30 June 2017, the 13 th Chamber of the Supreme Administrative Court granted the request"@en .

