    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasPartyName "European Space Agency"@en ;
    echr:hasSupportingQuote "European Space Agency (\"ESA\")"@en,
        "the defendant, ESA, had claimed immunity from jurisdiction"@en .

