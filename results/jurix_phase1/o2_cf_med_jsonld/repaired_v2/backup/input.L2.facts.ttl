<https://growgraph.dev/doc/aa2bb14a2d16> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:2"^^xsd:string .

doc:caseBeerRegan a echr:CaseDocument ;
    echr:hasApplicant doc:karlheinzBeer,
        doc:philipRegan ;
    echr:hasApplicationNumber "28934/95"@en ;
    echr:hasCaseName "Beer and Regan v. Germany"@en ;
    echr:hasDomesticProceeding doc:proceeding_darmstadt_labour_court_1 .

doc:esaAppealsBoard a echr:DomesticAuthority ;
    rdfs:label "ESA Appeals Board"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "ESA Appeals Board"@en ;
    echr:hasSupportingQuote "ESA Appeals Board"@en .

doc:federalLabourCourt a echr:DomesticAuthority ;
    rdfs:label "Federal Labour Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Federal Labour Court ( Bundesarbeitsgericht )"@en ;
    echr:hasSupportingQuote "Federal Labour Court ( Bundesarbeitsgericht )"@en .

doc:germanCourtsAct a echr:Party ;
    rdfs:label "German Courts Act"@en ;
    echr:hasSupportingQuote "section 20(2) of the Courts Act"@en .

doc:proceedingTDismissal a echr:DomesticProceeding ;
    rdfs:label "Labour court proceedings concerning dismissal by company T."@en ;
    echr:hasParticipation doc:participation_regan_1,
        doc:participation_t_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "lawyer’s fees incurred in labour court proceedings concerning his dismissal"@en .

doc:proceedingTiDismissal a echr:DomesticProceeding ;
    rdfs:label "Proceedings against dismissal by company T.I."@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1994-09-06"^^xsd:date ;
    echr:hasOutcome echr:OutcomeSettledOrWithdrawn ;
    echr:hasParticipation doc:participation_beer_1,
        doc:participation_ti_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "In the proceedings instituted by the second applicant against his dismissal by the company T.I. (see paragraph 13 above), a settlement had been reached in the Darmstadt Labour Court on 6 September 1994."@en .

doc:participation_esa_1 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:esa .

doc:participation_esa_darmstadt_2 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:esa .

doc:participation_t_1 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:companyT .

doc:participation_ti_1 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:companyT .

doc:proceeding_darmstadt_labour_court_1 a echr:DomesticProceeding ;
    rdfs:label "Labour court proceedings at Darmstadt"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_beer_1,
        doc:participation_esa_1,
        doc:participation_esa_darmstadt_2,
        doc:participation_regan_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."@en,
        "The Darmstadt Labour Court concluded that the conditions under section 20(2) of the German Courts Act for finding that the applicants’ action was inadmissible were fulfilled."@en .

