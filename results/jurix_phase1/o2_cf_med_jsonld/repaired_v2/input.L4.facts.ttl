    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationMatkoAppealInvest ;
    echr:hasSupportingQuote "On 4 December 1997 the Maribor Higher Court upheld her appeal finding that... there were sufficient grounds for suspicion... and opened a criminal investigation against the applicant"@en .

doc:appeal_judgment_1 a echr:DomesticProceeding ;
    rdfs:label "Appeal against acquittal"@en ;
    echr:followsProceeding doc:trial_matko_1 ;
