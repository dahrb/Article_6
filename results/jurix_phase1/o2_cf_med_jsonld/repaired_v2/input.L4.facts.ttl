doc:arrest_event_1 a echr:AdministrativeAction ;
    rdfs:label "Arrest of Aleksander Matko"@en ;
    echr:hasCourt doc:slovenjGradecPolice ;
    echr:hasParticipation doc:participationMatkoArrest ;
    echr:hasProceedingStartDate "1995-04-05"^^xsd:date ;
    echr:hasSupportingQuote "On 5 April 1995 at about 8.30 p.m. the applicant, driving a car, was arrested in Slovenj Gradec"@en .

doc:caseMatko a echr:CaseDocument ;
    echr:hasApplicant doc:aleksanderMatko ;
    echr:hasApplicationNumber "43393/98"@en ;
    echr:hasCaseName "Matko v. Slovenia"@en ;
    echr:hasDomesticProceeding doc:retrial_matko_1 .

doc:complaintPoliceIlltreatment a echr:DomesticProceeding ;
    rdfs:label "Criminal complaint by Matko against police officers"@en ;
    echr:hasCourt doc:slovenjGradecDistrictProsecutorOffice ;
    echr:hasDecisionDate "1997-01-17"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationMatkoComplaint ;
    echr:hasProceedingStartDate "1995-05-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 15 May 1995 the applicant lodged, through his lawyer, a written criminal complaint ( kazenska ovadba ) with the Slovenj Gradec Police against unidentified police officers"@en .

doc:costDecisionFinal a echr:DomesticProceeding ;
    rdfs:label "Final cost order"@en ;
    echr:followsProceeding doc:finalAppealMatko ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
    echr:hasDecisionDate "2001-10-11"^^xsd:date ;
    echr:hasParticipation doc:participationMatkoCosts ;
    echr:hasSupportingQuote "on 11 October 2001 the Slovenj Gradec District Court ordered the applicant to pay an additional sum to cover the costs... the proceedings were “finally concluded”"@en ;
    echr:isFinalDomesticDecision true .

