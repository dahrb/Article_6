    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partHqdcbLawyerD,
        doc:partHqdcbMartynovskiy ;
    echr:hasSupportingQuote "On 22 July 2016 the draft decision was put to vote at a HQDCB meeting... the draft decision was rejected and the decisions suspending the applicant’s licence remained valid"@en .

doc:proceedingKyivAdminFinal a echr:DomesticProceeding ;
    rdfs:label "Kyiv District Administrative Court Final Decision"@en ;
    echr:followsProceeding doc:proceedingKyivAdminSuspension ;
    echr:hasCourt doc:kyivDistrictAdminCourt ;
    echr:hasDecisionDate "2021-04-08"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partKyivAdminFinalMartynovskiy ;
    echr:hasSupportingQuote "On 8 April 2021 the Kyiv District Administrative Court found that all the decisions issued by the self-government bodies of the Bar against the applicant had been lawful"@en .

doc:proceedingKyivAdminSuspension a echr:DomesticProceeding ;
    rdfs:label "Kyiv District Administrative Court Suspension Order"@en ;
    echr:hasCourt doc:kyivDistrictAdminCourt ;
    echr:hasDecisionDate "2017-02-16"^^xsd:date ;
    echr:hasParticipation doc:partKyivAdminSuspMartynovskiy ;
    echr:hasSupportingQuote "On 16 February 2017 the Kyiv District Administrative Court granted the request and suspended the examination of the appeal of 5 October 2016"@en .

doc:proceedingPodilskyyCourt a echr:DomesticProceeding ;
    rdfs:label "Podilskyy District Court Appeal"@en ;
    echr:hasCourt doc:podilskyyCourt ;
    echr:hasDecisionDate "2016-12-22"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partPodilskyyMartynovskiy ;
    echr:hasSupportingQuote "On 22 December 2016 the Podilskyy District Court decided not to examine the applicant’s appeal"@en .

doc:proceeding_qdc_zakarpattya_1 a echr:DomesticProceeding ;
