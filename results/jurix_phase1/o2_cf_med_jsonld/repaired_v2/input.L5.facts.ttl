    echr:hasOutcome echr:OutcomeRemitted ;
    echr:hasParticipation doc:partKyivAppealQuashMartynovskiy ;
    echr:hasSupportingQuote "On 6 March 2017 the Kyiv Administrative Court of Appeal quashed the decision of 22 December 2016"@en .

doc:proceedingSupremeCourtFinal a echr:DomesticProceeding ;
    rdfs:label "Supreme Court Final Decision"@en ;
    echr:followsProceeding doc:proceedingKyivAdminFinal ;
    echr:hasCourt doc:supremeCourtUkraine ;
    echr:hasDecisionDate "2021-12-09"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partSupremeFinalMartynovskiy ;
    echr:hasSupportingQuote "The applicant’s appeals were rejected (final decision of the Supreme Court of 9 December 2021)"@en ;
    echr:isFinalDomesticDecision true .

