    echr:hasInactivityStartDate "2017-03-06"^^xsd:date ;
    echr:hasSupportingQuote "the delay in the resumption of the proceedings between March 2017 and May 2018 was attributable to the applicant or to the Government"@en .

doc:inactivity_kyiv_admin_2 a echr:InactivityPeriod ;
    rdfs:label "Kyiv District Administrative Court Inactivity Period 2018-2019"^^xsd:string ;
