doc:proceedingKyivAdminCourt a echr:DomesticProceeding ;
    rdfs:label "Kyiv District Administrative Court Appeal"@en ;
    echr:followsProceeding doc:proceedingHqdcbAppeal ;
    echr:hasCourt doc:kyivDistrictAdminCourt ;
    echr:hasDecisionDate "2021-12-09"^^xsd:date ;
    echr:hasInactivityPeriod doc:inactivity_kyiv_admin_1,
        doc:inactivity_kyiv_admin_2 ;
    echr:hasParticipation doc:partKyivAdminCourtMartynovskiy ;
    echr:hasProceedingStartDate "2016-10-05"^^xsd:date ;
    echr:hasSupportingQuote "On 5 October 2016 the applicant lodged an appeal with the Kyiv District Administrative Court against the decisions of the Zakarpattya Bar and the decision of the HQDCB"@en,
        "The final decision in the case was delivered on 9 December 2021"@en .

doc:proceedingKyivAppealCourt a echr:DomesticProceeding ;
    rdfs:label "Kyiv Administrative Court of Appeal Proceeding"@en ;
    echr:followsProceeding doc:proceedingPodilskyyCourt ;
    echr:hasCourt doc:kyivAppealCourt ;
    echr:hasParticipation doc:partKyivAppealCourtMartynovskiy ;
    echr:hasSupportingQuote "The applicant appealed against that decision to the Kyiv Administrative Court of Appeal"@en .

doc:proceedingKyivAppealQuash a echr:DomesticProceeding ;
    rdfs:label "Kyiv Administrative Court of Appeal Quashing Decision"@en ;
    echr:hasCourt doc:kyivAppealCourt ;
