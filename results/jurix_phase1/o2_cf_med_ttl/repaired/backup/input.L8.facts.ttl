    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 27 May 1998 (confirmed by the Supreme Court on 10 August 1998) the applicant was ordered by the Nizhniy Novgorod Court to pay damages to “Oka”"^^xsd:string,
