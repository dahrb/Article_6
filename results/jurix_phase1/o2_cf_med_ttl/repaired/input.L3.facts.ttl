    echr:followsProceeding doc:domestic_proceeding_3 ;
    echr:hasCourt doc:adminCourt ;
    echr:hasDecisionDate "2016-01-25"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasSupportingQuote "On 25 January 2016, the Supreme Administrative Court rejected the Fund’s request for rectification"^^xsd:string .

doc:domestic_proceeding_7 a echr:DomesticProceeding ;
    rdfs:label "Individual application to the Constitutional Court"^^xsd:string ;
    echr:followsProceeding doc:domestic_proceeding_6 ;
    echr:hasCourt doc:constitutionalCourt ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_20,
        doc:participation_3 ;
    echr:hasProceedingStartDate "2017-09-11"^^xsd:date ;
    echr:hasSupportingQuote "In a decision of 23 May 2018, the Constitutional Court... declared the application inadmissible"^^xsd:string .

