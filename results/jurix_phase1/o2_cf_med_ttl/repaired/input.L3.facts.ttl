doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Administrative court challenge to Viva TV-Radio Viva sale"^^xsd:string ;
    echr:followsProceeding doc:admin_action_9 ;
    echr:hasCourt doc:istanbulAdminCourt ;
    echr:hasDecisionDate "2014-03-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_3,
        doc:participation_4 ;
    echr:hasProceedingStartDate "2011-02-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 19 March 2014, the 6th Chamber of the İstanbul Administrative Court dismissed the applicant’s claim"^^xsd:string,
        "On 24 February 2011, the applicant initiated proceedings before the administrative court, seeking the annulment of the sale of Viva TV-Radio Viva."^^xsd:string,
        "On 7 February 2011, the applicant initiated proceedings before the administrative court, contesting the actions of the Fund concerning the tendering of Viva TV-Radio Viva"^^xsd:string .

doc:domestic_proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "General Assembly of the Administrative Proceedings Divisions appeal"^^xsd:string ;
    echr:followsProceeding doc:domestic_proceeding_2 ;
    echr:hasCourt doc:adminCourt ;
    echr:hasDecisionDate "2015-07-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_3,
        doc:participation_4 ;
    echr:hasSupportingQuote "On 7 July 2015, following an appeal by the applicant, the General Assembly... annulled the Fund’s decision."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:domestic_proceeding_6 a echr:DomesticProceeding ;
    rdfs:label "Enforcement request to the Fund"^^xsd:string ;
    echr:followsProceeding doc:domestic_proceeding_5 ;
    echr:hasCourt doc:savingsFund ;
    echr:hasDecisionDate "2017-09-05"^^xsd:date ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_3,
        doc:participation_4 ;
    echr:hasSupportingQuote "On 5 September 2017, the Fund responded, stating that a decision had already been made on 11 August 2017 regarding the enforcement of the relevant judgment. The Fund reiterated the same reasons it had previously cited in its earlier response for not enforcing the court’s decision, emphasising that the annulment decision could not be enforced due to legal and practical impossibilities (see paragraph 32 above)."@en .

