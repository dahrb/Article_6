    echr:hasCaseName "Matko v. Slovenia"^^xsd:string .

doc:court_unknown_1 a echr:DomesticAuthority ;
    echr:hasAuthorityName "Court in criminal proceedings against Matko"^^xsd:string .

doc:crim_proc_matko_appeal_2 a echr:DomesticProceeding ;
