doc:arrest_event_1995 a echr:AdministrativeAction ;
    rdfs:label "Arrest of Aleksander Matko"^^xsd:string ;
    echr:hasSupportingQuote "On 5 April 1995 at about 8.30 p.m. the applicant, driving a car, was arrested in Slovenj Gradec"^^xsd:string .

