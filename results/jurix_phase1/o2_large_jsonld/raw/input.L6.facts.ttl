    echr:hasProceedingStartDate "2008-09-17"^^xsd:date ;
    echr:hasSupportingQuote "informed the applicant company that its request to start arbitration proceedings would not be granted"@en .

doc:proceedingCivilCourtAppeal a echr:DomesticProceeding ;
