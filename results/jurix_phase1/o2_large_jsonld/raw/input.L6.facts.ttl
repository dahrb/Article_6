<https://growgraph.dev/doc/4001ea14f09a> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:6"^^xsd:string .

doc:caseScholzAg a echr:CaseDocument ;
    echr:hasApplicant doc:partyScholzAg ;
    echr:hasApplicationNumber "16528/10"@en ;
    echr:hasCaseName "Scholz AG v. Armenia"@en ;
    echr:hasDomesticProceeding doc:proceedingArbitrationTribunal,
        doc:proceedingCivilCourtAppeal,
        doc:proceedingCommercialCourtAppeal,
        doc:proceedingCourtCassation,
        doc:proceedingDistrictCourt,
        doc:proceedingYerevanCivilCourt,
        doc:proceeding_commercial_court_1 ;
    echr:hasRespondentState "Republic of Armenia"@en .

doc:personDirectorLlc a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Director of the LLC"@en ;
    echr:hasGender echr:GenderMale ;
    echr:hasPersonName "Director of the LLC"@en ;
    echr:hasSupportingQuote "he had been unaware of their content"@en .

