doc:proceedingCourtCassation a echr:DomesticProceeding ;
    rdfs:label "Court of Cassation proceeding"@en ;
    echr:followsProceeding doc:proceedingCivilCourtAppeal ;
    echr:hasCourt doc:authCourtCassation ;
    echr:hasDecisionDate "2009-09-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partCassScholz ;
    echr:hasProceedingStartDate "2009-08-04"^^xsd:date ;
    echr:hasSupportingQuote "declared the applicant company’s appeal on points of law inadmissible"@en ;
    echr:isFinalDomesticDecision true .

doc:authCommercialCourt a echr:DomesticAuthority ;
    rdfs:label "Commercial Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Commercial Court"@en .

