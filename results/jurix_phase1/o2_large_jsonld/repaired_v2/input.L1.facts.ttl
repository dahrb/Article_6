<https://growgraph.dev/doc/3c9a1e0dbd58> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:1"^^xsd:string .

doc:caseStanevBulgaria a echr:CaseDocument ;
    echr:hasApplicant doc:applicantStanev ;
    echr:hasApplicationNumber "36760/06"@en ;
    echr:hasCaseName "Stanev v. Bulgaria"@en ;
    echr:hasDomesticProceeding doc:actionGuardianAppointmentRila,
        doc:actionGuardianAppointmentRuse,
        doc:actionMayorRefusalRila,
        doc:actionPlacementPastra,
        doc:proceedingAppealIncapacityVelikoTarnovo,
        doc:proceedingIncapacityRequestRuse,
        doc:proceedingIncapacityRuse,
        doc:proceedingJudicialReviewDupnitsa,
        doc:reviewCapacityAppellateProsecutor,
        doc:reviewCapacityRegionalProsecutor,
        doc:reviewCapacitySupremeProsecutor ;
    echr:hasRespondentState "Republic of Bulgaria"@en .

doc:actionGuardianAppointmentRila a echr:AdministrativeAction ;
    rdfs:label "Guardian appointment by Rila Municipal Council"@en ;
    echr:hasCourt doc:councilRilaMunicipal ;
    echr:hasDecisionDate "2005-02-02"^^xsd:date ;
    echr:hasParticipation doc:partStanevRilaAppoint ;
    echr:hasSupportingQuote "the Municipal Council had decided on 2 February 2005 to appoint the Director of the Pastra social care home as the applicant’s guardian"@en .

doc:actionPlacementPastra a echr:AdministrativeAction ;
    rdfs:label "Placement in Pastra social care home"@en ;
    echr:followsProceeding doc:actionGuardianAppointmentRuse ;
    echr:hasCourt doc:councilRilaMunicipal ;
    echr:hasDecisionDate "2002-12-10"^^xsd:date ;
    echr:hasParticipation doc:partStanevPlacement ;
    echr:hasSupportingQuote "On 10 December 2002 a welfare-placement agreement was signed"@en .

doc:councilRuseMunicipal a echr:DomesticAuthority ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "Ruse Municipal Council"@en .

doc:courtDupnitsaDistrict a echr:DomesticAuthority ;
    rdfs:label "Dupnitsa District Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Dupnitsa District Court"@en .

doc:courtVelikoTarnovoAppeal a echr:DomesticAuthority ;
    rdfs:label "Veliko Tarnovo Court of Appeal"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Veliko Tarnovo Court of Appeal ( Апелативен съд )"@en .

doc:lawyerGenova a echr:LegalRepresentative ;
    rdfs:label "Ms A. Genova"@en ;
    echr:hasGender echr:GenderFemale ;
    echr:hasPersonName "Ms A. Genova"@en ;
    echr:hasSupportingQuote "Ms A. Genova, a lawyer practising in Sofia"@en .

