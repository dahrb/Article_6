doc:proceedingJudicialReviewDupnitsa a echr:DomesticProceeding ;
    rdfs:label "Judicial review at Dupnitsa District Court"@en ;
    echr:followsProceeding doc:actionMayorRefusalRila ;
    echr:hasCourt doc:courtDupnitsaDistrict ;
    echr:hasDecisionDate "2006-03-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partStanevDupnitsa ;
    echr:hasSupportingQuote "The Dupnitsa District Court gave judgment on 10 March 2006... the court dismissed the application"@en ;
    echr:isFinalDomesticDecision true .

doc:reviewCapacitySupremeProsecutor a echr:ProsecutorialReview ;
    rdfs:label "Chief Public Prosecutor's Office review"@en ;
    echr:followsProceeding doc:reviewCapacityAppellateProsecutor ;
    echr:hasCourt doc:prosecutorRuseRegional ;
    echr:hasDecisionDate "2005-11-29"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partStanevSupProsecutor ;
    echr:hasSupportingQuote "and subsequently on 29 November 2005 by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation"@en .

doc:actionGuardianAppointmentRuse a echr:AdministrativeAction ;
    rdfs:label "Guardian appointment by Ruse Municipal Council"@en ;
    echr:followsProceeding doc:proceedingAppealIncapacityVelikoTarnovo ;
    echr:hasCourt doc:councilRuseMunicipal ;
    echr:hasDecisionDate "2002-05-23"^^xsd:date ;
    echr:hasParticipation doc:partStanevRuseAppoint ;
    echr:hasSupportingQuote "on 23 May 2002 the Municipal Council appointed Ms R.P., a council officer, as the applicant’s guardian"@en .

doc:actionMayorRefusalRila a echr:AdministrativeAction ;
    rdfs:label "Mayor of Rila refusal of court action"@en ;
    echr:hasCourt doc:mayorRila ;
    echr:hasDecisionDate "2005-09-16"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partStanevMayorRefusal ;
    echr:hasSupportingQuote "In a letter of 16 September 2005, the mayor of Rila refused his request"@en .

doc:councilRilaMunicipal a echr:DomesticAuthority ;
    rdfs:label "Rila Municipal Council"@en ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "Rila Municipal Council"@en .

doc:courtRuseRegional a echr:DomesticAuthority ;
    rdfs:label "Ruse Regional Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Ruse Regional Court ( Окръжен съд )"@en ;
    echr:hasJurisdictionState "Bulgaria"@en .

doc:proceedingAppealIncapacityVelikoTarnovo a echr:DomesticProceeding ;
    rdfs:label "Appeal at Veliko Tarnovo Court of Appeal"@en ;
    echr:followsProceeding doc:proceedingIncapacityRuse ;
    echr:hasCourt doc:courtVelikoTarnovoAppeal ;
    echr:hasDecisionDate "2001-04-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partStanevVeliko ;
    echr:hasSupportingQuote "That judgment was upheld in a judgment of 12 April 2001 by the Veliko Tarnovo Court of Appeal"@en .

doc:proceedingIncapacityRequestRuse a echr:DomesticProceeding ;
    rdfs:label "Incapacity application by Ruse Regional Prosecutor"@en ;
    echr:hasCourt doc:courtRuseRegional ;
    echr:hasParticipation doc:partStanevIncapacityRequest ;
    echr:hasSupportingQuote "the Ruse regional prosecutor applied to the Ruse Regional Court ( Окръжен съд ) for a declaration of total legal incapacity in respect of the applicant"@en .

doc:proceedingIncapacityRuse a echr:DomesticProceeding ;
    rdfs:label "Incapacity proceeding at Ruse Regional Court"@en ;
    echr:followsProceeding doc:proceedingIncapacityRequestRuse ;
    echr:hasCourt doc:courtRuseRegional ;
    echr:hasDecisionDate "2000-11-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partStanevRuse ;
    echr:hasStatusApplied echr:StatusPartialIncapacity ;
    echr:hasSupportingQuote "In a judgment of 20 November 2000, the court declared the applicant to be partially incapacitated"@en .

doc:reviewCapacityAppellateProsecutor a echr:ProsecutorialReview ;
    rdfs:label "Appellate Prosecutor review of capacity"@en ;
    echr:followsProceeding doc:reviewCapacityRegionalProsecutor ;
    echr:hasCourt doc:prosecutorRuseRegional ;
    echr:hasDecisionDate "2005-10-11"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partStanevAppProsecutor ;
    echr:hasSupportingQuote "the regional prosecutor’s refusal was upheld on 11 October 2005 by the appellate prosecutor"@en .

doc:reviewCapacityRegionalProsecutor a echr:ProsecutorialReview ;
    rdfs:label "Regional Prosecutor review of capacity"@en ;
    echr:hasCourt doc:prosecutorRuseRegional ;
    echr:hasDecisionDate "2005-08-10"^^xsd:date ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partStanevRegProsecutor ;
    echr:hasSupportingQuote "On 10 August 2005 the regional prosecutor refused to bring an action for restoration of the applicant’s legal capacity"@en .

doc:prosecutorRuseRegional a echr:DomesticAuthority ;
    rdfs:label "Ruse Regional Prosecutor"@en ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Ruse Regional Prosecutor"@en .

doc:applicantStanev a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Mr Rusi Kosev Stanev"@en ;
    echr:hasGender echr:GenderMale ;
    echr:hasPersonName "Mr Rusi Kosev Stanev"@en ;
    echr:hasSupportingQuote "Mr Rusi Kosev Stanev (“the applicant”)"@en ;
