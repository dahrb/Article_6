@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/b83dff192347> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:4"^^xsd:string .

doc:caseMatko a echr:CaseDocument ;
    echr:hasApplicant doc:aleksanderMatko ;
    echr:hasApplicationNumber "43393/98"^^xsd:string ;
    echr:hasCaseName "Matko v. Slovenia"^^xsd:string ;
    echr:hasDomesticProceeding doc:investigation_complaint_1,
        doc:proceeding_criminal_1,
        doc:proceeding_criminal_10,
        doc:proceeding_criminal_2,
        doc:proceeding_criminal_3,
        doc:proceeding_criminal_4,
        doc:proceeding_criminal_5,
        doc:proceeding_criminal_6,
        doc:proceeding_criminal_7,
        doc:proceeding_criminal_8,
        doc:proceeding_criminal_9 ;
    echr:hasRespondentState "Slovenia"^^xsd:string .

doc:detention_1 a echr:PreTrialDetention ;
    rdfs:label "Initial police custody"^^xsd:string ;
    echr:hasCustodialMeasure echr:MeasurePoliceCustody ;
    echr:hasDetainee doc:aleksanderMatko ;
    echr:hasDetentionEndDate "1995-04-06"^^xsd:date ;
    echr:hasDetentionStartDate "1995-04-05"^^xsd:date ;
    echr:hasSupportingQuote "On 5 April 1995... the applicant... was arrested... He was questioned by the police and released on 6 April 1995"^^xsd:string .

doc:mia a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Ministry of Internal Affairs"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "Ministry of Internal Affairs"^^xsd:string ;
    echr:hasJurisdictionState "Slovenia"^^xsd:string .

doc:investigation_complaint_1 a echr:DomesticProceeding ;
    rdfs:label "Investigation into applicant's complaint"^^xsd:string ;
    echr:hasCourt doc:slovenjGradecDistrictProsecutor ;
    echr:hasDecisionDate "1997-01-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partComplaintMatko,
        doc:partComplaintPolice ;
    echr:hasProceedingStartDate "1995-04-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 17 January 1997 the Public Prosecutor issued a decision dismissing the applicant's criminal complaint."^^xsd:string .

doc:partComplaintMatko a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:aleksanderMatko .

doc:partComplaintPolice a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:slovenjGradecPolice .

doc:part_crim6_matko a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:aleksanderMatko .

doc:part_crim6_prosecutor a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:slovenjGradecDistrictProsecutor .

doc:part_crim7_court a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:slovenjGradecDistrictCourt .

doc:proceeding_criminal_7 a echr:DomesticProceeding ;
    rdfs:label "Final costs order"^^xsd:string ;
    echr:followsProceeding doc:proceeding_criminal_6 ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
    echr:hasDecisionDate "2001-10-11"^^xsd:date ;
    echr:hasParticipation doc:part_crim1_matko,
        doc:part_crim7_court ;
    echr:hasSupportingQuote "on 11 October 2001 the Slovenj Gradec District Court ordered the applicant to pay an additional sum to cover the costs... the proceedings were 'finally concluded'"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:slovenjGradecPolice a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Slovenj Gradec Police"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Slovenj Gradec Police"^^xsd:string ;
    echr:hasJurisdictionState "Slovenia"^^xsd:string .

doc:proceeding_criminal_1 a echr:DomesticProceeding ;
    rdfs:label "First instance investigation request"^^xsd:string ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
    echr:hasDecisionDate "1997-05-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_crim1_matko,
        doc:part_crim1_prosecutor ;
    echr:hasProceedingStartDate "1997-01-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 8 May 1997, further to a proposal of the investigating judge, the Slovenj Gradec District Court decided not to open a criminal investigation against the applicant."^^xsd:string .

doc:proceeding_criminal_2 a echr:DomesticProceeding ;
    rdfs:label "Appeal against decision not to open investigation"^^xsd:string ;
    echr:followsProceeding doc:proceeding_criminal_1 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "1997-12-04"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_crim1_matko,
        doc:part_crim1_prosecutor ;
    echr:hasProceedingStartDate "1997-05-12"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 4 December 1997 the Maribor Higher Court upheld her appeal... and opened a criminal investigation against the applicant."^^xsd:string .

doc:proceeding_criminal_3 a echr:DomesticProceeding ;
    rdfs:label "First instance trial"^^xsd:string ;
    echr:followsProceeding doc:proceeding_criminal_2 ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
    echr:hasDecisionDate "1999-11-22"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_crim1_matko,
        doc:part_crim1_prosecutor ;
    echr:hasProceedingStartDate "1998-12-28"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "By a judgment of 22 November 1999 the court acquitted the applicant."^^xsd:string .

doc:proceeding_criminal_4 a echr:DomesticProceeding ;
    rdfs:label "Appeal against acquittal"^^xsd:string ;
    echr:followsProceeding doc:proceeding_criminal_3 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "2000-09-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeRemitted ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_crim1_matko,
        doc:part_crim1_prosecutor ;
    echr:hasProceedingStartDate "2000-01-05"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "on 27 September 2000 the Maribor Higher Court quashed the judgment and remitted the case to a new panel for retrial."^^xsd:string .

doc:proceeding_criminal_5 a echr:DomesticProceeding ;
    rdfs:label "Retrial"^^xsd:string ;
    echr:followsProceeding doc:proceeding_criminal_4 ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
    echr:hasDecisionDate "2001-02-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelReopening ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_crim1_matko,
        doc:part_crim1_prosecutor ;
    echr:hasProceedingStartDate "2000-09-27"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "By a judgment of 12 February 2001, the Slovenj Gradec District Court convicted the applicant as charged"^^xsd:string .

doc:proceeding_criminal_6 a echr:DomesticProceeding ;
    rdfs:label "Appeal against conviction"^^xsd:string ;
    echr:followsProceeding doc:proceeding_criminal_5 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "2001-05-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_crim6_matko,
        doc:part_crim6_prosecutor ;
    echr:hasProceedingStartDate "2001-03-12"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 9 May 2001 the Maribor Higher Court upheld the conviction"^^xsd:string .

doc:mariborHigherCourt a echr:DomesticAuthority ;
    rdfs:label "Maribor Higher Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Maribor Higher Court"^^xsd:string ;
    echr:hasJurisdictionState "Slovenia"^^xsd:string .

doc:slovenjGradecDistrictProsecutor a echr:DomesticAuthority ;
    rdfs:label "Slovenj Gradec District Public Prosecutor's Office"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Slovenj Gradec District Public Prosecutor's Office"^^xsd:string ;
    echr:hasJurisdictionState "Slovenia"^^xsd:string .

doc:aleksanderMatko a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Mr Aleksander Matko"^^xsd:string ;
    echr:hasGender echr:GenderMale ;
    echr:hasPersonName "Mr Aleksander Matko"^^xsd:string .

doc:part_crim1_prosecutor a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:slovenjGradecDistrictProsecutor .

doc:slovenjGradecDistrictCourt a echr:DomesticAuthority ;
    rdfs:label "Slovenj Gradec District Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Slovenj Gradec District Court"^^xsd:string ;
    echr:hasJurisdictionState "Slovenia"^^xsd:string .

doc:part_crim1_matko a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
