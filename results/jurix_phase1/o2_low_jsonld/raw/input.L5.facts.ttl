doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Licence suspension by Disciplinary Chamber of the QDC of Zakarpattya"@en,
        "disciplinary proceeding resulting in decision of 17 April 2013"@en ;
    echr:hasCourt doc:authorityQdcZakarpattya,
        doc:disciplinary_chamber_1 ;
    echr:hasDecisionDate "2013-04-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_1_applicant,
        doc:participation_1_d ;
    echr:hasProceedingType echr:TypeDisciplinary ;
    echr:hasSupportingQuote "On 17 April 2013, in the applicant’s absence, the Disciplinary Chamber of the QDC of Zakarpattya suspended the applicant’s licence to practise as an advocate for six months"@en,
        "decisions of 17 April and 16 May 2013 he had been deprived of the opportunity to practise as an advocate"@en .

