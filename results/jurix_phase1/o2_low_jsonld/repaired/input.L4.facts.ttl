doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Criminal investigation request"@en,
        "First Instance Trial"@en ;
    echr:hasCourt doc:courtSlovenjGradec ;
    echr:hasDecisionDate "1997-05-08"^^xsd:date,
        "1999-11-22"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible,
        echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_1_app,
        doc:participation_1_applicant,
        doc:participation_1_prosecutor ;
    echr:hasProceedingStartDate "1997-01-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "By a judgment of 22 November 1999 the court acquitted the applicant."@en,
        "On 8 May 1997... the Slovenj Gradec District Court decided not to open a criminal investigation against the applicant."@en .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Appeal against decision not to investigate"@en,
        "First Appeal"@en ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:courtMaribor ;
    echr:hasDecisionDate "1997-12-04"^^xsd:date,
        "2000-09-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided,
        echr:OutcomeRemitted ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_2_pros,
        doc:participation_1_prosecutor,
        doc:participation_2_applicant ;
    echr:hasProceedingStartDate "1997-05-12"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 4 December 1997 the Maribor Higher Court upheld her appeal... and opened a criminal investigation against the applicant."@en,
        "on 27 September 2000 the Maribor Higher Court quashed the judgment and remitted the case to a new panel for retrial."@en .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "Criminal investigation phase"@en,
        "Retrial"@en ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:courtSlovenjGradec ;
    echr:hasDecisionDate "1998-03-17"^^xsd:date,
        "2001-02-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative,
        echr:LevelReopening ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_3_app,
        doc:participation_3_applicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "By a judgment of 12 February 2001, the Slovenj Gradec District Court convicted the applicant as charged"@en,
        "On 17 March 1998 the criminal investigation was concluded"@en .

doc:proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "Indictment phase"@en,
        "Second Appeal"@en ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:courtMaribor ;
    echr:hasDecisionDate "2001-05-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_2_pros,
        doc:part_4_app,
        doc:participation_1_prosecutor,
        doc:participation_4_applicant ;
    echr:hasProceedingStartDate "1998-12-28"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 28 December 1998 the Public Prosecutor filed an indictment against the applicant"@en,
        "On 9 May 2001 the Maribor Higher Court upheld the conviction"@en .

