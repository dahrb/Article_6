doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Commercial Court first instance decision"@en ;
    echr:hasCourt doc:commercialCourt ;
    echr:hasDecisionDate "2007-11-16"^^xsd:date,
        "2009-02-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1_llc,
        doc:participation_p1_applicant,
        doc:participation_p1_llc ;
    echr:hasProceedingStartDate "2007-01-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 15 January 2007 the applicant company lodged a claim with the Commercial Court against the LLC"@en,
        "On 16 November 2007 the Commercial Court granted the request and decided to leave the applicant company’s claim and the counterclaim lodged by the LLC unexamined."@en,
        "On 27 February 2009 the Yerevan Civil Court transferred the case to the Kentron and Nork-Marash District Court of Yerevan"@en .

