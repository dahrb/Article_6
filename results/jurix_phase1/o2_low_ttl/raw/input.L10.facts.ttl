doc:proceeding_3 a echr:DomesticProceeding,
        echr:EnforcementAction ;
    rdfs:label "Brussels Court of Appeal judgment June 2017"^^xsd:string,
        "Visa issuance enforcement"^^xsd:string,
        "appeal on points of law by applicants February 2018"^^xsd:string,
        "proceedings regarding refusal decisions of 17 October 2016"^^xsd:string ;
