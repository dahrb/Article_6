doc:proceeding_1 a echr:AdministrativeAction,
        echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board proceeding"^^xsd:string,
        "Aliens Appeals Boards proceeding"^^xsd:string,
        "Aliens Office refusal decisions"^^xsd:string,
        "proceedings to set aside decisions of 10 October 2016"^^xsd:string,
        "urgent appeal for stay of execution September decisions"^^xsd:string ;
    echr:followsProceeding doc:action_1 ;
    echr:hasCourt doc:aliensAppealsBoard,
        doc:aliensAppealsBoards,
        doc:aliensOffice ;
    echr:hasDecisionDate "2016-09-13"^^xsd:date,
        "2016-10-07"^^xsd:date,
        "2016-10-20"^^xsd:date,
        "2017-03-24"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal,
        echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible,
        echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant,
        echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_1,
        doc:part_1_aliens,
        doc:part_1_app,
        doc:part_1_state,
        doc:part_2,
        doc:participation_1_1,
        doc:participation_1_2 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "Aliens Appeals Boards’ judgment of 20 October 2016"^^xsd:string,
        "On 7 October 2016 the Aliens Appeals Board, acting under the extremely urgent procedure, ordered a stay of execution"^^xsd:string,
        "The applicants brought proceedings before the Aliens Appeals Board to have the Aliens Office’s decisions of 10 October 2016 set aside. On 24 March 2017 the Aliens Appeals Board dismissed the application"^^xsd:string,
        "the Aliens Appeals Board’s judgment of 20 October 2016, which had instructed the Belgian authorities to issue them with the visas they had requested"^^xsd:string,
        "the Aliens Office’s refusal decisions of 13 September 2016"^^xsd:string .

