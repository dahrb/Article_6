    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "By a judgment of 24 March 2017 the Aliens Appeals Board dismissed the application to have the decisions set aside and ordered that the stay of execution... be lifted"^^xsd:string,
