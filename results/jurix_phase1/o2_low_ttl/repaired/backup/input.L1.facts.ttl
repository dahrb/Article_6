doc:admin_action_1 a echr:AdministrativeAction ;
    rdfs:label "appointment of guardian by Ruse Municipal Council"^^xsd:string,
        "placement in the home"^^xsd:string,
        "social assessment"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:authorityRuseMunicipalCouncil,
        doc:social_assistance_dept_1 ;
    echr:hasDecisionDate "2002-05-23"^^xsd:date,
        "2005-12-30"^^xsd:date,
        "2002"^^xsd:gYear ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_4 ;
    echr:hasSupportingQuote "following his placement in the home in 2002"^^xsd:string,
        "on 23 May 2002 the Municipal Council appointed Ms R.P., a council officer, as the applicant’s guardian"^^xsd:string,
        "on 30 December 2005 the municipal social assistance department carried out a ‘social assessment’ ( социална оценка ) of the applicant, which concluded that... he was entitled to a social allowance"^^xsd:string .

doc:admin_action_2 a echr:AdministrativeAction ;
    rdfs:label "granting of monthly allowance"^^xsd:string,
        "request for search and transfer"^^xsd:string ;
    echr:followsProceeding doc:admin_action_1 ;
    echr:hasCourt doc:director_1,
        doc:social_assistance_dept_1 ;
    echr:hasDecisionDate "2006-10-13"^^xsd:date,
        "2007-02-07"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_4 ;
    echr:hasSupportingQuote "On 7 February 2007 the municipal social assistance department granted the applicant a monthly allowance"^^xsd:string,
        "the Director of the home wrote to the Ruse municipal police on 13 October 2006, asking them to search for the applicant"^^xsd:string .

doc:admin_action_3 a echr:AdministrativeAction ;
    rdfs:label "increase of allowance"^^xsd:string,
        "police notification of discovery"^^xsd:string ;
    echr:followsProceeding doc:admin_action_2 ;
    echr:hasCourt doc:director_1,
        doc:social_assistance_dept_1 ;
    echr:hasDecisionDate "2006-10-19"^^xsd:date,
        "2009-03-03"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_4 ;
    echr:hasSupportingQuote "On 19 October 2006 the Ruse police informed the Director that the applicant’s whereabouts had been discovered"^^xsd:string,
        "On 3 February 2009 the allowance was increased to BGN 19.50"^^xsd:string .

