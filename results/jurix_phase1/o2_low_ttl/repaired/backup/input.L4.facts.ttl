        "1997-12-04"^^xsd:date,
        "1998-03-17"^^xsd:date,
        "1999-02-16"^^xsd:date,
        "1999-11-22"^^xsd:date,
        "2000-09-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal,
        echr:LevelFirstInstance,
        echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeInadmissible,
        echr:OutcomeMeritsDecided,
        echr:OutcomeRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant,
        echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_1_app,
        doc:part_1_court,
        doc:part_1_pros,
        doc:part_3_pros,
        doc:participation_1,
        doc:participation_2,
        doc:participation_3,
        doc:participation_4 ;
    echr:hasProceedingStartDate "1999-09-13"^^xsd:date,
        "2000-01-05"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "By a judgment of 22 November 1999 the court acquitted the applicant."^^xsd:string,
        "His objection was rejected by the Slovenj Gradec District Court on 16 February 1999."^^xsd:string,
        "criminal investigation"^^xsd:string,
        "on 27 September 2000 the Maribor Higher Court quashed the judgment and remitted the case to a new panel for retrial."^^xsd:string,
        "the Maribor Higher Court upheld her appeal... and opened a criminal investigation"^^xsd:string,
        "the Slovenj Gradec District Court decided not to open a criminal investigation against the applicant"^^xsd:string,
        "the criminal investigation was concluded with the investigating judge’s decision"^^xsd:string .

