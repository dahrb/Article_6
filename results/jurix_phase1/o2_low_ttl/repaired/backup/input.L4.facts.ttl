doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Appeal against decision not to open investigation"^^xsd:string,
        "Conclusion of criminal investigation"^^xsd:string,
        "Decision not to open criminal investigation"^^xsd:string,
        "First appeal"^^xsd:string,
        "First instance trial"^^xsd:string,
        "Objection proceeding"^^xsd:string,
        "criminal investigation into organised crime"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:authority_1,
        doc:courtDistrictSlovenjGradec,
        doc:courtMaribor,
        doc:courtSlovenjGradec ;
