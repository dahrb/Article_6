doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Domestic proceedings regarding immunity"^^xsd:string,
        "German court proceedings against ESA"^^xsd:string,
        "German court proceedings regarding ESA immunity"^^xsd:string,
        "Labour Court proceedings regarding ESA immunity"^^xsd:string,
        "proceedings against ESA"^^xsd:string ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_1_app1,
        doc:part_1_app2,
        doc:part_1_esa,
        doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."^^xsd:string,
        "The German labour court regarded the applicants’ action under the German Provision of Labour (Temporary Staff) Act inadmissible"^^xsd:string,
        "the German courts did not exceed their margin of appreciation"^^xsd:string,
        "the reasons advanced by the German labour courts to give effect to the immunity from jurisdiction of ESA"^^xsd:string,
        "the rule of immunity from jurisdiction, which the German courts applied to ESA in the present case"^^xsd:string ;
    echr:isFinalDomesticDecision true .

