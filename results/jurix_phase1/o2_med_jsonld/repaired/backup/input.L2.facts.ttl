<https://growgraph.dev/doc/aa2bb14a2d16> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:2"^^xsd:string .

doc:caseBeerRegan a echr:CaseDocument ;
    rdfs:label "Beer and Regan v. Germany"@en ;
    echr:hasApplicant doc:karlheinzBeer,
        doc:personBeer,
        doc:personRegan,
        doc:philipRegan ;
    echr:hasApplicationNumber "28934/95"@en ;
    echr:hasCaseName "Beer and Regan v. Germany"@en ;
    echr:hasDomesticProceeding doc:proceedingDarmstadtLabourCourt,
        doc:proceeding_darmstadt_labour_court_1 ;
    echr:hasRespondentState "Germany"@en .

doc:case_document_1 a echr:CaseDocument ;
    rdfs:label "Case Document"@en,
        "Case regarding ESA immunity"@en ;
    echr:hasDomesticProceeding doc:proceeding_darmstadt_1,
        doc:proceeding_german_courts_1,
        doc:proceeding_labour_court_1 .

