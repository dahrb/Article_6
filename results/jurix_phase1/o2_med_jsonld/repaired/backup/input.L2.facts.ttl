doc:proceedingDarmstadtLabourCourt a echr:DomesticProceeding ;
    rdfs:label "Labour court proceedings at Darmstadt"@en ;
    echr:hasCourt doc:courtDarmstadt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partBeerDarmstadt,
        doc:partEsaDarmstadt,
        doc:partReganDarmstadt ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "the Darmstadt Labour Court concluded that the conditions under section 20(2) of the German Courts Act for finding that the applicants’ action was inadmissible were fulfilled"@en .

doc:proceeding_darmstadt_1 a echr:DomesticProceeding ;
    rdfs:label "Darmstadt Labour Court proceedings (second applicant)"@en ;
    echr:hasCourt doc:courtDarmstadt ;
    echr:hasDecisionDate "1994-09-06"^^xsd:date ;
    echr:hasOutcome echr:OutcomeSettledOrWithdrawn ;
    echr:hasParticipation doc:participation_applicant_2_proc2,
        doc:participation_company_ti_proc2 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "In the proceedings instituted by the second applicant against his dismissal by the company T.I. ... a settlement had been reached in the Darmstadt Labour Court on 6 September 1994."@en .

doc:proceeding_darmstadt_labour_court_1 a echr:DomesticProceeding ;
    rdfs:label "Labour court proceedings at Darmstadt"@en ;
    echr:hasCourt doc:courtDarmstadt ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_beer_1,
        doc:participation_esa_1,
        doc:participation_regan_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."@en ;
    echr:isFinalDomesticDecision true .

doc:proceeding_german_courts_1 a echr:DomesticProceeding ;
    rdfs:label "Proceedings before German courts"@en ;
    echr:hasCourt doc:german_courts_1 ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_applicants_1,
        doc:participation_esa_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "the rule of immunity from jurisdiction, which the German courts applied to ESA in the present case"@en .

doc:proceeding_labour_court_1 a echr:DomesticProceeding ;
    rdfs:label "Labour Court proceedings regarding ESA immunity"@en ;
    echr:hasCourt doc:courtDarmstadt ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_applicant_1_proc1,
        doc:participation_applicant_2_proc1,
        doc:participation_esa_proc1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "The Labour Court... considered that ESA enjoyed such immunity under Article XV § 2 of the ESA Convention and its Annex I."@en .

