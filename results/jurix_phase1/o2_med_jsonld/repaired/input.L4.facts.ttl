@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/b83dff192347/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/b83dff192347> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:4"^^xsd:string .

doc:caseMatko a echr:CaseDocument ;
    rdfs:label "Aleksander Matko Case"@en ;
    echr:hasApplicant doc:aleksanderMatko,
        doc:applicantMatko ;
    echr:hasApplicationNumber "43393/98"@en ;
    echr:hasCaseName "Matko v. Slovenia"@en ;
    echr:hasDomesticProceeding doc:complaint_police_1995,
        doc:criminal_proceeding_1,
        doc:investigation_matko_1997,
        doc:retrial_matko_2001,
        doc:trial_matko_1999 ;
    echr:hasRespondentState "Republic of Slovenia"@en .

doc:complaint_event_1 a echr:AdministrativeAction ;
    rdfs:label "Criminal complaint by Matko"^^xsd:string ;
    echr:hasCourt doc:policeSlovenjGradec ;
    echr:hasDecisionDate "1995-04-07"^^xsd:date ;
    echr:hasParticipation doc:participationMatkoComplaint ;
    echr:hasSupportingQuote "On 7 April 1995 the applicant went to the Slovenj Gradec Police and made an oral complaint against the officers of the Special Unit"@en .

doc:final_appeal_2001 a echr:DomesticProceeding ;
    rdfs:label "Final appeal against conviction"@en ;
    echr:followsProceeding doc:retrial_matko_2001 ;
    echr:hasCourt doc:courtMaribor ;
    echr:hasDecisionDate "2001-05-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_matko_app3,
        doc:part_prosecutor_app1 ;
    echr:hasProceedingStartDate "2001-03-12"^^xsd:date ;
    echr:hasSupportingQuote "the Maribor Higher Court upheld the conviction"@en ;
    echr:isFinalDomesticDecision true .

doc:participationRepLink a owl:NamedIndividual ;
    owl:ObjectProperty doc:lawyerMatko ;
    doc:applicantMatko echr:isRepresentedBy .

doc:appeal_investigation_1997 a echr:DomesticProceeding ;
    rdfs:label "Appeal against decision not to investigate"@en ;
    echr:followsProceeding doc:investigation_matko_1997 ;
    echr:hasCourt doc:courtMaribor ;
    echr:hasDecisionDate "1997-12-04"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_matko_app1,
        doc:part_prosecutor_app1 ;
    echr:hasProceedingStartDate "1997-05-12"^^xsd:date ;
    echr:hasSupportingQuote "the Maribor Higher Court upheld her appeal"@en .

doc:appeal_trial_2000 a echr:DomesticProceeding ;
    rdfs:label "Appeal against acquittal"@en ;
    echr:followsProceeding doc:trial_matko_1999 ;
    echr:hasCourt doc:courtMaribor ;
    echr:hasDecisionDate "2000-09-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeRemitted ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_matko_app1,
        doc:part_prosecutor_app1 ;
    echr:hasProceedingStartDate "2000-01-05"^^xsd:date ;
    echr:hasSupportingQuote "the Maribor Higher Court quashed the judgment and remitted the case to a new panel for retrial"@en .

doc:arrest_event_1 a echr:AdministrativeAction ;
    rdfs:label "Arrest of Aleksander Matko"^^xsd:string ;
    echr:hasCourt doc:policeSlovenjGradec ;
    echr:hasDecisionDate "1995-04-05"^^xsd:date ;
    echr:hasParticipation doc:participationMatkoArrest ;
    echr:hasSupportingQuote "On 5 April 1995 at about 8.30 p.m. the applicant, driving a car, was arrested in Slovenj Gradec by officers of the Special Unit and the Slovenj Gradec Police."@en .

doc:complaint_police_1995 a echr:DomesticProceeding ;
    rdfs:label "Criminal complaint by Matko against police"@en ;
    echr:hasCourt doc:prosecutorSlovenjGradec ;
    echr:hasDecisionDate "1997-01-17"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partMatkoComplaint,
        doc:partPoliceComplaint ;
    echr:hasProceedingStartDate "1995-05-15"^^xsd:date ;
    echr:hasSupportingQuote "the applicant lodged, through his lawyer, a written criminal complaint"@en .

doc:criminal_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Criminal proceedings against Aleksander Matko"^^xsd:string ;
    echr:followsProceeding doc:arrest_event_1 ;
    echr:hasCourt doc:courtSlovenjGradec ;
    echr:hasDecisionDate "2001-02-12"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasParticipation doc:participationMatkoCriminal ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "The judgment of 12 February 2001 issued in the proceedings instituted against the applicant"@en .

doc:partMatkoComplaint a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicantMatko .

doc:partMatkoInv a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:applicantMatko .

doc:partPoliceComplaint a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:policeSlovenjGradec .

doc:partProsecutorInv a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:prosecutorSlovenjGradec .

doc:part_matko_app3 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicantMatko .

doc:participationMatkoArrest a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:aleksanderMatko .

doc:participationMatkoComplaint a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:aleksanderMatko .

doc:participationMatkoCriminal a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:aleksanderMatko .

doc:investigation_matko_1997 a echr:DomesticProceeding ;
    rdfs:label "Criminal investigation against Matko"@en ;
    echr:hasCourt doc:courtSlovenjGradec ;
    echr:hasDecisionDate "1997-05-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:partMatkoInv,
        doc:partProsecutorInv ;
    echr:hasProceedingStartDate "1997-01-17"^^xsd:date ;
    echr:hasSupportingQuote "the Slovenj Gradec District Court decided not to open a criminal investigation against the applicant"@en .

doc:lawyerMatko a owl:NamedIndividual,
        echr:LegalRepresentative ;
    rdfs:label "Lawyer of Aleksander Matko"@en,
        "Lawyer of Matko"@en ;
    echr:hasSupportingQuote "the applicant lodged, through his lawyer"@en .

doc:partMatkoRetrial a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:applicantMatko .

doc:partProsecutorRetrial a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:prosecutorSlovenjGradec .

doc:part_matko_app1 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:applicantMatko .

doc:retrial_matko_2001 a echr:DomesticProceeding ;
    rdfs:label "Retrial of Matko"@en ;
    echr:followsProceeding doc:appeal_trial_2000 ;
    echr:hasCourt doc:courtSlovenjGradec ;
    echr:hasDecisionDate "2001-02-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelReopening ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partMatkoRetrial,
        doc:partProsecutorRetrial ;
    echr:hasSupportingQuote "sentenced him to 3 months’ imprisonment, suspended for 3 years"@en,
        "the Slovenj Gradec District Court convicted the applicant as charged"@en .

doc:trial_matko_1999 a echr:DomesticProceeding ;
    rdfs:label "First instance trial of Matko"@en ;
    echr:followsProceeding doc:appeal_investigation_1997 ;
    echr:hasCourt doc:courtSlovenjGradec ;
    echr:hasDecisionDate "1999-11-22"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:partMatkoRetrial,
        doc:partProsecutorRetrial ;
    echr:hasProceedingStartDate "1999-01-27"^^xsd:date ;
    echr:hasSupportingQuote "By a judgment of 22 November 1999 the court acquitted the applicant"@en .

doc:courtMaribor a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Maribor Higher Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Maribor Higher Court"@en .

doc:part_prosecutor_app1 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:prosecutorSlovenjGradec .

doc:policeSlovenjGradec a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Slovenj Gradec Police"^^xsd:string,
        "Slovenj Gradec Police"@en ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Slovenj Gradec Police"@en .

doc:aleksanderMatko a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Aleksander Matko"^^xsd:string ;
    echr:hasGender echr:GenderMale ;
    echr:hasPersonName "Mr Aleksander Matko"@en .

doc:courtSlovenjGradec a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Slovenj Gradec District Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Slovenj Gradec District Court"@en .

doc:prosecutorSlovenjGradec a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Slovenj Gradec District Public Prosecutor’s Office"@en ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Slovenj Gradec District Public Prosecutor’s Office"@en .

doc:applicantMatko a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Aleksander Matko"@en ;
    echr:hasGender echr:GenderMale ;
    echr:hasPersonName "Aleksander Matko"@en ;
    echr:hasSupportingQuote "Aleksander Matko actively resisted"@en ;
    echr:isRepresentedBy doc:lawyerMatko .

