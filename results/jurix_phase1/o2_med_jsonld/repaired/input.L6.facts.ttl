    dcterms:title "input.jsonl:6"^^xsd:string .

doc:caseScholzAgArmenia a echr:CaseDocument ;
    echr:hasApplicant doc:partyScholzAg ;
    echr:hasApplicationNumber "16528/10"@en ;
    echr:hasCaseName "Scholz AG v. Armenia"@en ;
    echr:hasDomesticProceeding doc:proceeding_commercial_court_1,
        doc:proceeding_commercial_court_appeal_1 ;
    echr:hasRespondentState "Republic of Armenia"@en .

doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Commercial Court complaint"@en ;
    echr:hasCourt doc:commercialCourt ;
    echr:hasDecisionDate "2007-12-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 10 December 2007 a three-judge bench of the Commercial Court rejected the complaint submitted by the applicant company."@en .

doc:proceeding_6 a echr:DomesticProceeding ;
    rdfs:label "Court of Cassation proceeding"@en ;
    echr:followsProceeding doc:proceeding_5 ;
    echr:hasCourt doc:courtOfCassation ;
    echr:hasDecisionDate "2009-09-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 23 September 2009 the Court of Cassation declared the applicant company’s appeal on points of law inadmissible."@en ;
    echr:isFinalDomesticDecision true .

doc:applicantCompany a echr:Party ;
    rdfs:label "the applicant company"@en ;
    echr:hasPartyName "the applicant company"@en .

