    echr:hasProceedingStartDate "2008-10-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "on 17 October 2008 the applicant company lodged a claim with the Yerevan Civil Court"@en .

doc:proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "District Court proceeding"@en ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:districtCourt ;
    echr:hasDecisionDate "2009-06-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1_1,
        doc:participation_4_2 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 16 June 2009 the District Court decided to leave the claim lodged by the applicant company unexamined"@en .

doc:proceeding_5 a echr:DomesticProceeding ;
    rdfs:label "Civil Court of Appeal proceeding"@en ;
    echr:followsProceeding doc:proceeding_4 ;
    echr:hasCourt doc:civilCourtOfAppeal ;
    echr:hasDecisionDate "2009-07-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1_1,
        doc:participation_4_2 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 21 July 2009 the Civil Court of Appeal upheld the decision of 16 June 2009."@en .

doc:proceeding_commercial_court_appeal_1 a echr:DomesticProceeding ;
    rdfs:label "Appeal against Commercial Court decision"@en ;
    echr:followsProceeding doc:proceeding_commercial_court_1 ;
