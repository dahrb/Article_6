doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Arbitration Tribunal claim"@en ;
    echr:hasCourt doc:arbitrationTribunal ;
    echr:hasDecisionDate "2008-10-07"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1_1 ;
    echr:hasProceedingStartDate "2008-09-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 7 October 2008 the President of the Arbitration Tribunal informed the applicant company that its request to start arbitration proceedings would not be granted."@en .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "Yerevan Civil Court claim"@en ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:yerevanCivilCourt ;
