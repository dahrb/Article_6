doc:proceeding_1_alt a echr:DomesticProceeding ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:court_admin_1 ;
    echr:hasParticipation doc:part_p1_alt_app ;
    echr:hasSupportingQuote "On 7 February 2011, the applicant initiated proceedings before the administrative court, contesting the actions of the Fund"@en .

doc:proceeding_1_split a echr:DomesticProceeding ;
    rdfs:label "Administrative Court proceedings (split)"@en ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:courtIstanbulAdmin ;
    echr:hasParticipation doc:part_p1_split_app ;
    echr:hasProceedingStartDate "2011-02-24"^^xsd:date ;
    echr:hasSupportingQuote "On 24 February 2011, the applicant initiated proceedings before the administrative court, seeking the annulment of the sale of Viva TV-Radio Viva."@en .

doc:proceeding_3_alt a echr:DomesticProceeding ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:court_ga_1 ;
    echr:hasParticipation doc:part_p3_alt_app ;
    echr:hasSupportingQuote "On 7 July 2015, following an appeal by the applicant, the General Assembly... annulled the Fund’s decision"@en .

doc:proceeding_3_split a echr:DomesticProceeding ;
    rdfs:label "Request for rectification (split)"@en ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:courtSupremeAdmin ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasParticipation doc:part_p3_split_app ;
    echr:hasSupportingQuote "On 30 June 2017, the 13 th Chamber of the Supreme Administrative Court granted the request... the court overturned the judgment of the 6th Chamber of the Istanbul Administrative Court dated 19 March 2014 and annulled the sale in question."@en .

doc:proceeding_standing_2006 a echr:DomesticProceeding ;
    rdfs:label "Supreme Administrative Court decision on standing"@en ;
    echr:hasCourt doc:courtSupremeAdmin ;
    echr:hasDecisionDate "2006-07-20"^^xsd:date ;
    echr:hasOutcome echr:OutcomeRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_standing_app ;
    echr:hasSupportingQuote "On 20 July 2006, the Supreme Administrative Court, ruling unanimously, found that the applicant had a legal interest in the enforcement proceedings initiated under Law no. 6183"@en .

doc:admin_action_1 a echr:AdministrativeAction ;
    rdfs:label "Decision to offer Viva TV-Radio Viva for sale"^^xsd:string ;
    echr:hasCourt doc:fundAuthority ;
    echr:hasDecisionDate "2011-01-13"^^xsd:date ;
    echr:hasParticipation doc:part_fund_1 ;
    echr:hasSupportingQuote "the Fund’s decision of 13 January 2011, which approved the invitation to tender and the terms of sale"@en .

