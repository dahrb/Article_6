    echr:participatingParty doc:prosecutorSlovenjGradec .

doc:part_prosecutor_trial_app echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:prosecutorSlovenjGradec .

doc:participationMatkoArrest a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:applicantMatko .

doc:participationMatkoComplaint a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicantMatko .

doc:participationMatkoCriminal a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:applicantMatko .

doc:investigation_matko_1997 a echr:DomesticProceeding ;
    rdfs:label "Criminal investigation against Matko"@en ;
    echr:hasCourt doc:courtSlovenjGradec ;
    echr:hasDecisionDate "1997-05-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:partMatkoInv,
        doc:partProsecutorInv ;
    echr:hasProceedingStartDate "1997-01-17"^^xsd:date ;
    echr:hasSupportingQuote "the Slovenj Gradec District Court decided not to open a criminal investigation against the applicant"@en .

doc:lawyerMatko a owl:NamedIndividual,
        echr:LegalRepresentative ;
    rdfs:label "Lawyer of Aleksander Matko"@en ;
    echr:hasSupportingQuote "the applicant lodged, through his lawyer"@en .

doc:retrial_matko_2001 a echr:DomesticProceeding ;
    rdfs:label "Retrial of Matko"@en ;
    echr:followsProceeding doc:appeal_trial_2000,
        doc:arrest_event_1 ;
    echr:hasCourt doc:courtSlovenjGradec ;
    echr:hasDecisionDate "2001-02-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelReopening ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partMatkoRetrial,
        doc:partProsecutorRetrial,
        doc:participationMatkoCriminal ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "The judgment of 12 February 2001 issued in the proceedings instituted against the applicant"@en,
        "sentenced him to 3 months’ imprisonment, suspended for 3 years"@en,
        "the Slovenj Gradec District Court convicted the applicant as charged"@en .

doc:trial_matko_1999 a echr:DomesticProceeding ;
    rdfs:label "First instance trial of Matko"@en ;
    echr:followsProceeding doc:appeal_investigation_1997 ;
    echr:hasCourt doc:courtSlovenjGradec ;
    echr:hasDecisionDate "1999-11-22"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_matko_trial_1,
        doc:part_prosecutor_trial_1 ;
    echr:hasProceedingStartDate "1999-01-27"^^xsd:date ;
    echr:hasSupportingQuote "By a judgment of 22 November 1999 the court acquitted the applicant"@en .

doc:courtMaribor a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Maribor Higher Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Maribor Higher Court"@en .

doc:policeSlovenjGradec a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Slovenj Gradec Police"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Slovenj Gradec Police"@en .

doc:courtSlovenjGradec a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Slovenj Gradec District Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Slovenj Gradec District Court"@en .

doc:prosecutorSlovenjGradec a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Slovenj Gradec District Public Prosecutor’s Office"@en ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Slovenj Gradec District Public Prosecutor’s Office"@en .

doc:applicantMatko a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Aleksander Matko"@en ;
    echr:hasGender echr:GenderMale ;
    echr:hasPersonName "Aleksander Matko"@en,
        "Mr Aleksander Matko"@en ;
    echr:hasSupportingQuote "Aleksander Matko actively resisted"@en ;
    echr:isRepresentedBy doc:lawyerMatko .

