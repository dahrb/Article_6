    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicantMatko .

doc:part_matko_trial_1 echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:applicantMatko .

doc:part_matko_trial_app echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:applicantMatko .

doc:part_prosecutor_app1 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
