@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/b83dff192347/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/b83dff192347> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:4"^^xsd:string .

doc:caseMatko a echr:CaseDocument ;
    rdfs:label "Aleksander Matko Case"@en ;
    echr:hasApplicant doc:applicantMatko ;
    echr:hasApplicationNumber "43393/98"@en ;
    echr:hasCaseName "Matko v. Slovenia"@en ;
    echr:hasDomesticProceeding doc:complaint_police_1995,
        doc:cost_order_2001,
        doc:investigation_matko_1997,
        doc:objection_indictment_1999,
        doc:retrial_matko_2001,
        doc:trial_matko_1999 ;
    echr:hasRespondentState "Republic of Slovenia"@en .

doc:complaint_event_1 a echr:AdministrativeAction ;
    rdfs:label "Criminal complaint by Matko"^^xsd:string ;
    echr:hasCourt doc:policeSlovenjGradec ;
    echr:hasDecisionDate "1995-04-07"^^xsd:date ;
    echr:hasParticipation doc:participationMatkoComplaint ;
    echr:hasSupportingQuote "On 7 April 1995 the applicant went to the Slovenj Gradec Police and made an oral complaint against the officers of the Special Unit"@en .

doc:part_matko_app1 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:applicantMatko .

doc:participationRepLink a owl:NamedIndividual ;
    owl:ObjectProperty doc:lawyerMatko ;
    doc:applicantMatko echr:isRepresentedBy .

doc:appeal_investigation_1997 a echr:DomesticProceeding ;
    rdfs:label "Appeal against decision not to investigate"@en ;
    echr:followsProceeding doc:investigation_matko_1997 ;
    echr:hasCourt doc:courtMaribor ;
    echr:hasDecisionDate "1997-12-04"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_matko_inv_app1,
        doc:part_prosecutor_inv_app1 ;
    echr:hasProceedingStartDate "1997-05-12"^^xsd:date ;
    echr:hasSupportingQuote "the Maribor Higher Court upheld her appeal"@en .

doc:appeal_trial_2000 a echr:DomesticProceeding ;
    rdfs:label "Appeal against acquittal"@en ;
    echr:followsProceeding doc:trial_matko_1999 ;
    echr:hasCourt doc:courtMaribor ;
    echr:hasDecisionDate "2000-09-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeRemitted ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_matko_trial_app,
        doc:part_prosecutor_trial_app ;
    echr:hasProceedingStartDate "2000-01-05"^^xsd:date ;
    echr:hasSupportingQuote "the Maribor Higher Court quashed the judgment and remitted the case to a new panel for retrial"@en .

doc:arrest_event_1 a echr:AdministrativeAction ;
    rdfs:label "Arrest of Aleksander Matko"^^xsd:string ;
    echr:hasCourt doc:policeSlovenjGradec ;
    echr:hasDecisionDate "1995-04-05"^^xsd:date ;
    echr:hasParticipation doc:participationMatkoArrest ;
    echr:hasSupportingQuote "On 5 April 1995 at about 8.30 p.m. the applicant, driving a car, was arrested in Slovenj Gradec by officers of the Special Unit and the Slovenj Gradec Police."@en .

doc:complaint_police_1995 a echr:DomesticProceeding ;
    rdfs:label "Criminal complaint by Matko against police"@en ;
    echr:hasCourt doc:prosecutorSlovenjGradec ;
    echr:hasDecisionDate "1997-01-17"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partMatkoComplaint,
        doc:partPoliceComplaint ;
    echr:hasProceedingStartDate "1995-05-15"^^xsd:date ;
    echr:hasSupportingQuote "the applicant lodged, through his lawyer, a written criminal complaint"@en .

doc:cost_order_2001 a echr:DomesticProceeding ;
    rdfs:label "Order for witness costs"@en ;
    echr:followsProceeding doc:final_appeal_2001 ;
    echr:hasCourt doc:courtSlovenjGradec ;
    echr:hasDecisionDate "2001-10-11"^^xsd:date ;
    echr:hasParticipation doc:part_matko_costs ;
    echr:hasSupportingQuote "on 11 October 2001 the Slovenj Gradec District Court ordered the applicant to pay an additional sum to cover the costs of one of the witnesses heard during the proceedings"@en .

doc:final_appeal_2001 a echr:DomesticProceeding ;
    rdfs:label "Final appeal against conviction"@en ;
    echr:followsProceeding doc:retrial_matko_2001 ;
    echr:hasCourt doc:courtMaribor ;
    echr:hasDecisionDate "2001-05-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_matko_app3,
        doc:part_prosecutor_app1 ;
    echr:hasProceedingStartDate "2001-03-12"^^xsd:date ;
    echr:hasSupportingQuote "the Maribor Higher Court upheld the conviction"@en ;
    echr:isFinalDomesticDecision true .

doc:objection_indictment_1999 a echr:DomesticProceeding ;
    rdfs:label "Objection to indictment"@en ;
    echr:hasCourt doc:courtSlovenjGradec ;
    echr:hasDecisionDate "1999-02-16"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_matko_objection .

