doc:proceeding_detention_1998 a echr:DomesticProceeding ;
    rdfs:label "Detention Order of 2 April 1998"@en ;
    echr:hasCourt doc:regionalCourtNn ;
    echr:hasDecisionDate "1998-04-02"^^xsd:date ;
    echr:hasParticipation doc:participation_detention_klimentyev ;
    echr:hasSupportingQuote "On 2 April 1998 the Nizhniy Novgorod Regional Court granted the prosecutor’s renewed motion for detention"@en .

doc:proceeding_supreme_court_1 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court Appeal"^^xsd:string ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:courtSupreme ;
    echr:hasDecisionDate "1998-08-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasParticipation doc:participationApplicantSupreme,
        doc:participationMoskalenkoSupreme ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 10 August 1998 the Supreme Court confirmed the judgment"@en .

doc:lawyerMoskalenko a echr:LegalRepresentative,
        echr:Party ;
    rdfs:label "Mrs Moskalenko"^^xsd:string ;
    echr:hasGender echr:GenderFemale ;
    echr:hasPersonName "Mrs Moskalenko"^^xsd:string,
        "Mrs Moskalenko"@en .

doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "First Trial at Nizhniy Novgorod Regional Court"@en ;
    echr:hasCourt doc:regionalCourtNn ;
    echr:hasDecisionDate "1997-04-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1_klimentyev ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 21 April 1997 the Nizhniy Novgorod Regional Court found the applicant guilty on some of the charges"^^xsd:string .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Appeal to Supreme Court"@en ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:courtSupreme ;
    echr:hasDecisionDate "1997-07"^^xsd:string ;
    echr:hasOutcome echr:OutcomeRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_2_klimentyev ;
    echr:hasSupportingQuote "In July 1997 the Supreme Court quashed the conviction on the applicant’s appeal and remitted the case to the Nizhniy Novgorod Regional Court"^^xsd:string .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "Retrial at Nizhniy Novgorod Regional Court"@en ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:regionalCourtNn ;
    echr:hasDecisionDate "1998-05-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationApplicantRegional,
        doc:participation_3_klimentyev ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 27 May 1998 the Nizhniy Novgorod Regional Court found the applicant guilty on charges of misappropriation and embezzlement"^^xsd:string,
        "On 27 May 1998 the Regional Court made a number of further orders"@en .

