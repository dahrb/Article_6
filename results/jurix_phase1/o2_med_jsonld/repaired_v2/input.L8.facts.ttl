doc:admin_action_unfreeze_1 a echr:AdministrativeAction ;
    rdfs:label "Unfreezing of Stavanger proceeds"^^xsd:string ;
    echr:followsProceeding doc:admin_action_freeze_1 ;
    echr:hasCourt doc:prosecutorNn ;
    echr:hasDecisionDate "1996-05-18"^^xsd:date ;
    echr:hasParticipation doc:participation_unfreeze_klimentyev ;
    echr:hasSupportingQuote "On 18 May 1996 the Nizhniy Novgorod prosecutor’s office unfroze the account"@en .

doc:case_46503_99 a echr:CaseDocument ;
    rdfs:label "Case of the Applicant vs Russia"^^xsd:string ;
    echr:hasApplicant doc:klimentyev ;
    echr:hasApplicationNumber "46503/99"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceeding_1,
        doc:proceeding_2,
        doc:proceeding_3,
        doc:proceeding_supreme_court_1 .

doc:lawyerO a echr:LegalRepresentative,
        echr:Party ;
    rdfs:label "Mr. O."^^xsd:string ;
    echr:hasGender echr:GenderMale ;
    echr:hasPersonName "Mr. O."@en .

doc:proceeding_supreme_detention_review a echr:DomesticProceeding ;
    rdfs:label "Supreme Court Review of Detention Order"@en ;
    echr:followsProceeding doc:proceeding_detention_1998 ;
    echr:hasCourt doc:courtSupreme ;
    echr:hasDecisionDate "1998-05-19"^^xsd:date ;
    echr:hasParticipation doc:participation_supreme_detention_klimentyev ;
    echr:hasSupportingQuote "The reply from the Supreme Court, dated 19 May 1998, stated that the national law did not allow appeals against that type of trial court orders separately from appeals against judgments"@en .

doc:prosecutorial_review_1 a echr:ProsecutorialReview ;
    rdfs:label "Quashing of 1982 conviction"^^xsd:string ;
    echr:hasCourt doc:prosecutorNn ;
    echr:hasDecisionDate "1999-02"^^xsd:string ;
    echr:hasOutcome echr:OutcomeRemitted ;
    echr:hasParticipation doc:participation_review_klimentyev ;
    echr:hasSupportingQuote "In February 1999 the applicant’s first (1982) conviction was quashed, and the file in that case was closed by the Nizhniy Novgorod regional prosecutor’s office"@en .

doc:admin_action_freeze_1 a echr:AdministrativeAction ;
    rdfs:label "Freezing of Stavanger"^^xsd:string ;
    echr:hasCourt doc:prosecutorNn ;
    echr:hasDecisionDate "1995-10-05"^^xsd:date ;
    echr:hasParticipation doc:participation_freeze_klimentyev ;
    echr:hasSupportingQuote "on 5 October 1995 property belonging to the applicant - the ship Stavanger and a floating drydock - was frozen on the order of the Nizhniy Novgorod prosecutor’s office"@en .

