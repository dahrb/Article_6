doc:proceedingDarmstadtBeer a echr:DomesticProceeding ;
    rdfs:label "Labour court proceedings - Beer"^^xsd:string ;
    echr:hasCourt doc:germanCourts ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_beer_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:proceedingDarmstadtLabourCourt a echr:DomesticProceeding ;
    rdfs:label "Proceedings before the Darmstadt Labour Court"^^xsd:string ;
    echr:hasCourt doc:germanCourts ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partBeerDarmstadt,
        doc:partEsaDarmstadt,
        doc:partReganDarmstadt ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "The Darmstadt Labour Court concluded that the conditions under section 20(2) of the German Courts Act for finding that the applicants’ action was inadmissible were fulfilled."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:proceedingDarmstadtRegan a echr:DomesticProceeding ;
    rdfs:label "Labour court proceedings - Regan"^^xsd:string ;
