<https://growgraph.dev/doc/aa2bb14a2d16> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:2"^^xsd:string .

doc:caseBeerRegan a echr:CaseDocument ;
    rdfs:label "Beer and Regan v. Germany"^^xsd:string ;
    echr:hasApplicant doc:mrBeer,
        doc:mrRegan ;
    echr:hasApplicationNumber "28934/95"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceedingDarmstadtBeer,
        doc:proceedingDarmstadtRegan ;
    echr:hasRespondentState "Federal Republic of Germany"^^xsd:string .

doc:case_28934_95 a echr:CaseDocument ;
    echr:hasApplicant doc:mrBeer,
        doc:mrRegan ;
    echr:hasApplicationNumber "28934/95"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceedingDarmstadtLabourCourt .

doc:case_document_1 a echr:CaseDocument ;
    echr:hasApplicant doc:applicant_1,
        doc:applicant_2,
        doc:applicant_group_1 .

doc:proceedingDismissalT a echr:DomesticProceeding ;
    rdfs:label "labour court proceedings concerning dismissal of first applicant"^^xsd:string ;
    echr:hasOutcome echr:OutcomeSettledOrWithdrawn ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_app_1_t,
        doc:participation_t_1 ;
    echr:hasSupportingQuote "the company T. undertook to pay to the first applicant the sum of DEM 14,000 for lawyer’s fees incurred in labour court proceedings concerning his dismissal"^^xsd:string .

doc:proceedingDismissalTi a echr:DomesticProceeding ;
    rdfs:label "proceedings instituted by the second applicant against his dismissal by the company T.I."^^xsd:string ;
    echr:hasCourt doc:germanCourts ;
    echr:hasDecisionDate "1994-09-06"^^xsd:date ;
    echr:hasOutcome echr:OutcomeSettledOrWithdrawn ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_app_2_ti,
        doc:participation_ti_1 ;
    echr:hasSupportingQuote "In the proceedings instituted by the second applicant against his dismissal by the company T.I. (see paragraph 13 above), a settlement had been reached in the Darmstadt Labour Court on 6 September 1994."^^xsd:string .

doc:proceedingEsaImmunity a echr:DomesticProceeding ;
    rdfs:label "proceeding concerning ESA immunity"^^xsd:string ;
    echr:hasCourt doc:germanCourts ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_app_1_t,
        doc:participation_app_2_esa,
        doc:participation_esa_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "The Labour Court... considered that ESA enjoyed such immunity under Article XV § 2 of the ESA Convention and its Annex I."^^xsd:string .

doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "German court proceedings against ESA"^^xsd:string ;
    echr:hasCourt doc:germanCourts ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "the rule of immunity from jurisdiction, which the German courts applied to ESA in the present case"^^xsd:string .

doc:partBeerDarmstadt a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "the labour court proceedings instituted by the applicants"^^xsd:string ;
    echr:participatingParty doc:mrBeer .

doc:partEsaDarmstadt a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:hasSupportingQuote "the defendant, ESA"^^xsd:string ;
    echr:participatingParty doc:esa .

doc:partReganDarmstadt a echr:Participation ;
