<https://growgraph.dev/doc/f0db2bcd6652> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:8"^^xsd:string .

doc:admin_action_unfreeze_1 a echr:AdministrativeAction ;
    rdfs:label "Unfreezing and transfer of funds"^^xsd:string ;
    echr:followsProceeding doc:admin_action_freeze_1 ;
    echr:hasCourt doc:prosecutorNn ;
    echr:hasDecisionDate "1996-05-18"^^xsd:date ;
    echr:hasSupportingQuote "On 18 May 1996 the Nizhniy Novgorod prosecutor's office unfroze the account and transferred the money to the yard"^^xsd:string .

doc:case_46503_99 a echr:CaseDocument ;
    echr:hasApplicant doc:klimentyev ;
    echr:hasApplicationNumber "46503/99"^^xsd:string ;
    echr:hasCaseName "Andrey Anatolyevitch KLIMENTYEV against Russia"^^xsd:string ;
    echr:hasRespondentState "Russia"^^xsd:string .

doc:case_document_1 a echr:CaseDocument ;
    echr:hasApplicant doc:applicant_1 ;
    echr:hasDomesticProceeding doc:proceeding_regional_court_1 .

doc:detention_1 a echr:PreTrialDetention ;
    rdfs:label "Pre-trial detention 1995-1997"^^xsd:string ;
    echr:hasCustodialMeasure echr:MeasureRemandInCustody ;
    echr:hasDetainee doc:klimentyev ;
    echr:hasSupportingQuote "the time he had already spent in pre-trial detention"^^xsd:string .

doc:electionAction a echr:AdministrativeAction ;
    rdfs:label "Invalidation of mayoral election"^^xsd:string ;
    echr:hasDecisionDate "1998-04-01"^^xsd:date ;
    echr:hasParticipation doc:partElecKlimentyev ;
    echr:hasSupportingQuote "On 1 April 1998 the local electoral committee declared the elections invalid"^^xsd:string .

doc:proceedingDetentionAppeal a echr:DomesticProceeding ;
    rdfs:label "Appeal against detention order"^^xsd:string ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:courtSupreme ;
    echr:hasDecisionDate "1998-05-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partDetKlimentyev ;
    echr:hasSupportingQuote "The reply from the Supreme Court, dated 19 May 1998, stated that the national law did not allow appeals against that type of trial court orders separately"^^xsd:string .

doc:proceeding_supreme_court_1 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court Appeal"^^xsd:string ;
    echr:followsProceeding doc:proceedingRegionalCourtDamages,
        doc:proceeding_regional_court_1 ;
    echr:hasCourt doc:courtSupreme ;
    echr:hasDecisionDate "1998-08-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_supreme_1 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 10 August 1998 the Supreme Court confirmed the judgment of the Nizhniy Novgorod Regional Court"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:admin_action_freeze_1 a echr:AdministrativeAction ;
    rdfs:label "Freezing of Stavanger and drydock"^^xsd:string ;
    echr:hasCourt doc:prosecutorNn ;
    echr:hasDecisionDate "1995-10-05"^^xsd:date ;
    echr:hasSupportingQuote "on 5 October 1995 property belonging to the applicant - the ship Stavanger and a floating drydock - was frozen on the order of the Nizhniy Novgorod prosecutor's office"^^xsd:string .

doc:detention_2 a echr:PreTrialDetention ;
    rdfs:label "Detention order 2 April 1998"^^xsd:string ;
    echr:hasCustodialMeasure echr:MeasureRemandInCustody ;
    echr:hasDetainee doc:klimentyev ;
    echr:hasSupportingQuote "On 2 April 1998 the Nizhniy Novgorod Regional Court granted the prosecutor’s renewed motion for detention"^^xsd:string .

