doc:anthonySawoniuk a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Anthony SAWONIUK"@en ;
    echr:hasGender echr:GenderMale ;
    echr:hasPersonName "Anthony SAWONIUK"@en ;
    echr:hasSupportingQuote "He denied that he had been a member of the local police; that there had ever been a locally recruited police force there; that there had only been unarmed lookout men, not in uniform, keeping watch for Russian partisans; that there had been no ghetto in Dormachevo and no restriction of movement had been imposed on the Jewish population."@en .

