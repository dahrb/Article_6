    echr:hasDecisionDate "1999-03-29"^^xsd:date ;
    echr:hasParticipation doc:participationReinstatementBailApplicant ;
    echr:hasSupportingQuote "On 29 March 1999, defence counsel made representations, inter alia, that the arrangements made for the applicant in prison had not reflected those referred to by the trial judge. ... the trial judge reinstated bail."@en .

