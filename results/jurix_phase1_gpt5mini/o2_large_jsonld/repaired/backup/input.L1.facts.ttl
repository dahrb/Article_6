    echr:hasParticipation doc:participation_dupnitsa_2005_applicant,
        doc:participation_dupnitsa_2005_guardian,
        doc:participation_dupnitsa_2005_mayor ;
    echr:hasProceedingStartDate "2005-09-28"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "The Dupnitsa District Court gave judgment on 10 March 2006. As to the merits, the court dismissed the application... Since the judgment was not subject to appeal, it became final."^^xsd:string ;
    echr:isFinalDomesticDecision true .

