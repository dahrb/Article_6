doc:welfare_report_2002_07_23 a echr:AdministrativeAction ;
    rdfs:label "Welfare report by Ruse social services, 23 July 2002"@en ;
    echr:hasCourt doc:authorityRuseSocialServices ;
    echr:hasDecisionDate "2002-07-23"^^xsd:date ;
    echr:hasParticipation doc:participation_enf_2002_applicant,
        doc:participation_welfare_2002_social_services ;
    echr:hasSupportingQuote "Social services drew up a welfare report on the applicant, noting on 23 July 2002 that he was suffering from schizophrenia, that he lived alone in a small, run-down annexe to his half-sister’s house and that his half-sister and his father’s second wife had stated that they did not wish to act as his guardian."^^xsd:string .

doc:adminaction_mayor_refusal_2005_09_16 a echr:AdministrativeAction ;
    rdfs:label "Mayor of Rila's refusal to bring court action for release from partial guardianship, 16 September 2005"@en ;
    echr:hasCourt doc:authorityMayorOfRila ;
    echr:hasDecisionDate "2005-09-16"^^xsd:date ;
    echr:hasParticipation doc:participation_mayor_2005_applicant,
        doc:participation_mayor_2005_mayor ;
    echr:hasSupportingQuote "In a letter of 16 September 2005, the mayor of Rila refused his request, stating that there was no basis for such an action in view of the medical certificate of 15 June 2005, the opinions of the Director and the social worker, and the conclusions reached by the public prosecutor’s office."^^xsd:string .

