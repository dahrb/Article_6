    echr:hasSupportingQuote "was subsequently transmitted to the Ruse Municipal Council on 7 June 2001 for the appointment of a guardian."^^xsd:string .

doc:adminaction_prosecutor_requested_docs_2005_03_02 a echr:AdministrativeAction ;
    rdfs:label "Public prosecutor requested medical documents from Pastra social care home, 2 March 2005"@en ;
