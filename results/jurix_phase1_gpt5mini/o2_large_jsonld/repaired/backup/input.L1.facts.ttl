        doc:participation_ruse_regional_2000_prosecutor ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "In a judgment of 20 November 2000, the court declared the applicant to be partially incapacitated on the grounds that he had been suffering from simple schizophrenia since 1975, and that his ability to manage his own affairs and interests and to realise the consequences of his own acts had been impaired."^^xsd:string .

