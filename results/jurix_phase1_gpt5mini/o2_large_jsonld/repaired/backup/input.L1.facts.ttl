doc:proceeding_dupnitsa_district_2005_09_28_2006_03_10 a echr:DomesticProceeding ;
    rdfs:label "Dupnitsa District Court judicial review (application under Article 115 FC), start 28 September 2005, judgment 10 March 2006"@en ;
