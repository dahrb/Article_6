doc:proc_constitutional_2017_09_11_2018_05_23 a echr:DomesticProceeding ;
    rdfs:label "Individual application to the Constitutional Court (lodged 11 September 2017; decision 23 May 2018)"@en ;
    echr:followsProceeding doc:adminaction_fund_enforcement_decision_2017_08_11 ;
    echr:hasCourt doc:authorityConstitutionalCourt ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasParticipation doc:part_proc_constitutional_2017_applicant,
        doc:part_proc_constitutional_2017_fund ;
    echr:hasProceedingStartDate "2017-09-11"^^xsd:date ;
    echr:hasSupportingQuote "In a decision of 23 May 2018, the Constitutional Court observed that the final annulment judgment of the 13th Chamber of the Supreme Administrative Court had been served on the applicant on 28 July 2017 and determined that the thirty-day time-limit for lodging an individual application had commenced on that date."@en,
        "On 11 September 2017, the applicant lodged an individual application with the Constitutional Court, alleging violations of his right to property and his right to a fair trial due to the non-enforcement of the final judgment annulling the sale of Viva TV-Radio Viva."@en .

doc:proc_supadm_13th_rect_grant_2017_06_30 a echr:DomesticProceeding ;
    rdfs:label "13th Chamber of the Supreme Administrative Court granted rectification and annulled the sale (30 June 2017)"@en ;
    echr:followsProceeding doc:proc_supadm_rect_reject_2016_01_25 ;
    echr:hasCourt doc:authority_supreme_admin_13th_chamber ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasParticipation doc:part_proc_constitutional_2017_applicant,
        doc:part_proc_supadm_rect_grant_2017_fund ;
    echr:hasSupportingQuote "On 30 June 2017, the 13 th Chamber of the Supreme Administrative Court granted the request, referring to the ruling of the General Assembly of 7 July 2015 ... The court ... overturned the judgment of the 6th Chamber of the Istanbul Administrative Court dated 19 March 2014 and annulled the sale in question."@en .

