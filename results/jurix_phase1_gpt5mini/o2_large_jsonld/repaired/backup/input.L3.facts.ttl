doc:adminaction_fund_decision_2011_01_13 a echr:AdministrativeAction ;
    rdfs:label "Fund decision of 13 January 2011 approving the invitation to tender and terms of sale"@en ;
    echr:hasDecisionDate "2011-01-13"^^xsd:date ;
    echr:hasParticipation doc:part_adminaction_fund_decision_2011_applicant,
        doc:part_adminaction_fund_decision_2011_fund ;
    echr:hasSupportingQuote "the Fund’s decision of 13 January 2011, which approved the invitation to tender and the terms of sale and set the estimated value of Viva TV-Radio Viva at USD 6,000,000"@en .

doc:authorityBankingRegulationAndSupervisionBoard a echr:DomesticAuthority ;
    rdfs:label "Banking Regulation and Supervision Board (the Board)"@en ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "Banking Regulation and Supervision Board"@en ;
    echr:hasSupportingQuote "By a decision dated 15 March 2001, the Banking Regulation and Supervision Board ( Bankalar Düzenleme ve Denetleme Kurulu , hereinafter “the Board”) resolved to transfer the management and control of İktisat Bankası T.A.Ş. ... to the Savings Deposit Insurance Fund"@en .

