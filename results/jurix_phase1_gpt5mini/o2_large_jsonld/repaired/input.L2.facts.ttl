@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/9c31f6f64728/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/9c31f6f64728> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:2"^^xsd:string .

doc:case_28934_95 a echr:CaseDocument ;
    rdfs:label "Beer and Regan v. Germany"@en ;
    echr:hasApplicant doc:karlheinzBeer,
        doc:philipRegan ;
    echr:hasApplicationNumber "28934/95"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceeding_darmstadt_1993_1995,
        doc:proceeding_regan_settlement_1994 ;
    echr:hasSupportingQuote "The case was referred to the Court, as established under former Article 19 of the Convention [3] , by the European Commission of Human Rights (“the Commission”) on 16March 1998, within the three-month period laid down by former Articles 32 § 1 and 47 of the Convention. It originated in an application (no. 28934/95) against the Federal Republic of Germany lodged with the Commission under former Article 25 by a German national, Mr Karlheinz Beer, and by a British national, Mr Philip Regan, on 13 September 1995."@en .

doc:companyTi a echr:Party,
        schema:Organization ;
    rdfs:label "the company T.I."@en ;
    echr:hasPartyName "the Italian company T.I."@en ;
    echr:hasSupportingQuote "The second applicant, a systems programmer and employed by the Italian company T.I., was placed at the disposal of the European Space Agency to perform services at the European Space Operations Centre in Darmstadt in 1991."@en .

doc:esa a echr:Party,
        schema:Organization ;
    rdfs:label "European Space Agency"@en ;
    echr:hasPartyName "The European Space Agency (\"ESA\")"@en ;
    echr:hasSupportingQuote "The European Space Agency (“ESA”) with headquarters in Paris, formed out of the European Space Research Organisation (“ESRO”) and the European Organisation for the Development and Construction of Space Vehicle Launchers (“ELDO”), was established under the Convention for the Establishment of a European Space Agency (“ESA Convention”) of 30 May 1975"@en .

doc:part_beer_proc1 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "In October and November 1993 the applicants instituted proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA"@en ;
    echr:participatingParty doc:karlheinzBeer .

doc:part_esa_proc1 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:hasSupportingQuote "In the respective labour court proceedings, ESA relied on its immunity from jurisdiction under Article XV § 2 of the ESA Convention and its Annex I."@en ;
    echr:participatingParty doc:esa .

doc:part_regan_proc1 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "In October and November 1993 the applicants instituted proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA"@en ;
    echr:participatingParty doc:philipRegan .

doc:part_regan_proc2 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "In the proceedings instituted by the second applicant against his dismissal by the company T.I. (see paragraph 13 above), a settlement had been reached in the Darmstadt Labour Court on 6 September 1994."@en ;
    echr:participatingParty doc:philipRegan .

doc:part_ti_proc2 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:hasSupportingQuote "In the proceedings instituted by the second applicant against his dismissal by the company T.I. (see paragraph 13 above), a settlement had been reached in the Darmstadt Labour Court on 6 September 1994."@en ;
    echr:participatingParty doc:companyTi .

doc:proceeding_darmstadt_1993_1995 a echr:DomesticProceeding ;
    rdfs:label "Darmstadt Labour Court proceedings against ESA (instituted Oct-Nov 1993; decision 21 March 1995)"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_beer_proc1,
        doc:part_esa_proc1,
        doc:part_regan_proc1 ;
    echr:hasProceedingStartDate "1993-10"^^xsd:gYearMonth ;
    echr:hasSupportingQuote "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."@en ;
    echr:isFinalDomesticDecision true .

doc:proceeding_regan_settlement_1994 a echr:DomesticProceeding ;
    rdfs:label "Darmstadt Labour Court settlement in proceedings by the second applicant against his dismissal by the company T.I. (6 September 1994)"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1994-09-06"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeSettledOrWithdrawn ;
    echr:hasParticipation doc:part_regan_proc2,
        doc:part_ti_proc2 ;
    echr:hasSupportingQuote "In the proceedings instituted by the second applicant against his dismissal by the company T.I. (see paragraph 13 above), a settlement had been reached in the Darmstadt Labour Court on 6 September 1994."@en .

doc:darmstadtLabourCourt a echr:DomesticAuthority,
        schema:Organization ;
    rdfs:label "Darmstadt Labour Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "the Darmstadt Labour Court ( Arbeitsgericht )"@en ;
    echr:hasSupportingQuote "In October and November 1993 the applicants instituted proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA"@en .

doc:karlheinzBeer a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Mr Karlheinz Beer"@en ;
    echr:hasGender echr:GenderMale ;
    echr:hasPartyName "Mr Karlheinz Beer"@en ;
    echr:hasPersonName "Mr Karlheinz Beer"@en ;
    echr:hasSupportingQuote "Mr Karlheinz Beer is a German national, born in 1952 and resident in Darmstadt."@en .

doc:philipRegan a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Mr Philip Regan"@en ;
    echr:hasGender echr:GenderMale ;
    echr:hasPartyName "Mr Philip Regan"@en ;
    echr:hasPersonName "Mr Philip Regan"@en .

