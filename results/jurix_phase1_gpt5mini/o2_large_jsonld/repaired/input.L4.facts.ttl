doc:district_court_order_costs_2001_10_11 a echr:EnforcementAction ;
    rdfs:label "Slovenj Gradec District Court order to pay witness costs (11 October 2001)"@en ;
    echr:followsProceeding doc:maribor_higher_court_upheld_conviction_2001_05_09 ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
    echr:hasDecisionDate "2001-10-11"^^xsd:date ;
    echr:hasParticipation doc:participation_district_order_costs_2001_10_11_applicant,
        doc:participation_district_order_costs_2001_10_11_court ;
    echr:hasSupportingQuote "Lastly, on 11 October 2001 the Slovenj Gradec District Court ordered the applicant to pay an additional sum to cover the costs of one of the witnesses heard during the proceedings. On that day, the proceedings were “finally concluded” ( pravnomočno končan postopek )."@en .

