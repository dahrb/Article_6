doc:maribor_higher_court_appeal_open_investigation_1997_12_04 a echr:DomesticProceeding ;
    rdfs:label "Maribor Higher Court appeal decision opening criminal investigation (4 December 1997)"@en ;
    echr:followsProceeding doc:district_court_not_open_investigation_1997_05_08 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "1997-12-04"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasParticipation doc:participation_maribor_1997_12_04_applicant,
        doc:participation_maribor_1997_12_04_prosecutor ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 12 May 1997 the Public Prosecutor appealed against this decision. On 4 December 1997 the Maribor Higher Court upheld her appeal finding that, despite the shortcomings mentioned in the first-instance decision, there were sufficient grounds for suspicion ... it changed the first-instance court’s decision and opened a criminal investigation against the applicant."@en .

