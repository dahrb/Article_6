doc:appeal_to_hqdcb_2013 a echr:DomesticProceeding ;
    rdfs:label "Appeal to the HQDCB against the decisions of 17 April and 16 May 2013"@en ;
    echr:followsProceeding doc:qdc_upheld_2013_05_16 ;
    echr:hasCourt doc:hqdcb ;
    echr:hasParticipation doc:partAppealHqdcbApplicant,
        doc:partAppealHqdcbD ;
    echr:hasProceedingType echr:TypeDisciplinary ;
    echr:hasSupportingQuote "In 2013 the HQDCB held two hearings in the applicant’s case, but failed to reach a decision."@en,
        "The applicant appealed against the decisions of 17 April and 16 May 2013 to the HQDCB, however the appeal did not have a suspensive effect."@en ;
    echr:isPending true .

doc:disciplinaryChamberQdcZakarpattya a echr:DomesticAuthority ;
    rdfs:label "Disciplinary Chamber of the QDC of Zakarpattya"@en ;
    echr:hasAuthorityKind echr:AuthorityDisciplinary ;
    echr:hasAuthorityName "Disciplinary Chamber of the QDC of Zakarpattya" ;
    echr:hasSupportingQuote "On 17 April 2013, in the applicant’s absence, the Disciplinary Chamber of the QDC of Zakarpattya suspended the applicant’s licence to practise as an advocate for six months for his failure to attend the meeting of 7 December 2012 and violating Article 62 of the Rules of Professional Conduct."@en .

