    echr:hasCourt doc:hqdcb ;
    echr:hasDecisionDate "2013-07-18"^^xsd:date ;
    echr:hasParticipation doc:part_d_observations_2013_07_18 ;
    echr:hasSupportingQuote "On 18 July 2013 D. submitted his observations to the HQDCB requesting it to reject the applicant’s appeal."@en .

