    rdfs:label "Scholz AG"@en ;
    echr:hasPartyName "Scholz AG"@en ;
    echr:hasSupportingQuote "by a German corporation, Scholz AG (“the applicant company”), on 19 March 2010."@en ;
    echr:isRepresentedBy doc:legalrepMrDAbgaryan,
