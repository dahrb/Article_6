doc:caseScholzAgVArmenia a echr:CaseDocument ;
    rdfs:label "Scholz AG v. Armenia"@en ;
    echr:hasApplicant doc:partyScholzAg ;
    echr:hasApplicationNumber "16528/10"^^xsd:string ;
    echr:hasDomesticProceeding doc:proc_arbitration_2008_09_17,
        doc:proc_civil_court_of_appeal_2009_06_25,
        doc:proc_commercialcourt_firstinstance_2007_01_15,
        doc:proc_commercialcourt_threejudge_2007_11_23,
        doc:proc_court_of_cassation_2009_08_04,
        doc:proc_district_court_2009_03_13,
        doc:proc_yerevan_civil_2008_10_17 ;
    echr:hasSupportingQuote "The case originated in an application (no. 16528/10) against the Republic of Armenia lodged with the Court under Article 34 of the Convention for the Protection of Human Rights and Fundamental Freedoms (“the Convention”) by a German corporation, Scholz AG (“the applicant company”), on 19 March 2010."@en .

doc:participation_proc_civil_court_of_appeal_2009_06_25_scholz rdfs:label "Participation of Scholz AG in Civil Court of Appeal (Jun-Jul 2009)" ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "On 25 June 2009 the applicant company lodged an appeal." ;
    echr:participatingParty doc:partyScholzAg .

doc:authorityArbitrationTribunal a echr:DomesticAuthority ;
    rdfs:label "Arbitration Tribunal of the Chamber of Commerce and Industry of Armenia"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Arbitration Tribunal of the Chamber of Commerce and Industry of Armenia"@en ;
    echr:hasSupportingQuote "the Arbitration Tribunal of the Chamber of Commerce and Industry of Armenia (“the Arbitration Tribunal”)."@en .

doc:authorityCivilCourtOfAppeal a echr:DomesticAuthority ;
    rdfs:label "Civil Court of Appeal"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Civil Court of Appeal"@en ;
    echr:hasSupportingQuote "On 21 July 2009 the Civil Court of Appeal upheld the decision of 16 June 2009."@en .

doc:authorityCourtOfCassation a echr:DomesticAuthority ;
    rdfs:label "Court of Cassation"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Court of Cassation"@en ;
    echr:hasSupportingQuote "On 23 September 2009 the Court of Cassation declared the applicant company’s appeal on points of law inadmissible."@en .

doc:authorityDistrictCourt a echr:DomesticAuthority ;
    rdfs:label "Kentron and Nork-Marash District Court of Yerevan"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Kentron and Nork-Marash District Court of Yerevan"@en ;
    echr:hasSupportingQuote "On 27 February 2009 the Yerevan Civil Court transferred the case to the Kentron and Nork-Marash District Court of Yerevan (“the District Court\") based on territorial jurisdiction"@en .

doc:authorityYerevanCivilCourt a echr:DomesticAuthority ;
    rdfs:label "Yerevan Civil Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Yerevan Civil Court"@en ;
    echr:hasSupportingQuote "In view of the fact that the Commercial Court had been abolished by that time, on 17 October 2008 the applicant company lodged a claim with the Yerevan Civil Court, seeking to recover EUR 116,600 from the LLC, representing the amount of the loan and interest." .

doc:legalrepMrDAbgaryan a echr:LegalRepresentative,
        echr:NaturalPerson ;
    rdfs:label "Mr D. Abgaryan"@en ;
    echr:hasGender echr:GenderMale ;
    echr:hasPersonName "Mr D. Abgaryan"@en ;
    echr:hasSupportingQuote "The applicant company was represented by Mr T. Atanesyan and Mr D. Abgaryan, lawyers practising in Yerevan."@en .

