    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasParticipation doc:part_regional_21apr1997_applicant,
        doc:part_regional_21apr1997_prosecutor ;
    echr:hasSupportingQuote "On 21 April 1997 the Nizhniy Novgorod Regional Court found the applicant guilty on some of the charges, and not guilty on most."@en .

doc:proc_regional_27_may_1998 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court judgment (27 May 1998)"@en ;
    echr:hasCourt doc:courtNizhniyRegional ;
    echr:hasDecisionDate "1998-05-27"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasParticipation doc:part_regional_27may1998_applicant,
        doc:part_regional_27may1998_prosecutor ;
    echr:hasSupportingQuote "On 27 May 1998 the Nizhniy Novgorod Regional Court found the applicant guilty on charges of misappropriation and embezzlement, larceny, bribery and attempt not to return money from abroad."@en .

doc:proc_regional_detention_1998_04_02 a echr:DomesticProceeding ;
    rdfs:label "Regional Court order to detain (2 April 1998)"@en ;
