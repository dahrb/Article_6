    echr:hasSupportingQuote "On 2 April 1998 the Nizhniy Novgorod Regional Court granted the prosecutor’s renewed motion for detention ... and the applicant was arrested in the course of the hearing."@en .

doc:proc_regional_21_apr_1997 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court judgment (21 April 1997)"@en ;
    echr:hasCourt doc:courtNizhniyRegional ;
