doc:admin_election_invalid_1998_04_01 a echr:AdministrativeAction ;
    rdfs:label "Local electoral committee invalidates mayoral election (1 April 1998)"@en ;
    echr:hasCourt doc:authLocalElectoralCommittee ;
    echr:hasParticipation doc:part_admin_election_invalid_1998_04_01_applicant ;
    echr:hasProceedingStartDate "1998-04-01"^^xsd:date ;
    echr:hasSupportingQuote "On 1 April 1998 the local electoral committee declared the elections invalid on the ground of irregularities committed during the campaign by some candidates, including the applicant."@en .

doc:admin_freeze_1995_10_05 a echr:AdministrativeAction ;
    rdfs:label "Freeze order: Stavanger and drydock (5 October 1995)"@en ;
    echr:hasCourt doc:partyNizhniyProsecutor ;
    echr:hasParticipation doc:part_admin_freeze_1995_10_05_prosecution ;
    echr:hasProceedingStartDate "1995-10-05"^^xsd:date ;
    echr:hasSupportingQuote "on 5 October 1995 property belonging to the applicant - the ship Stavanger and a floating drydock - was frozen on the order of the Nizhniy Novgorod prosecutor’s office."@en .

doc:admin_freeze_proceeds_1996_03_11 a echr:AdministrativeAction ;
    rdfs:label "Proceeds frozen (11 March 1996)"@en ;
    echr:hasCourt doc:partyNizhniyProsecutor ;
    echr:hasParticipation doc:part_admin_freeze_proceeds_1996_03_11_prosecution ;
    echr:hasProceedingStartDate "1996-03-11"^^xsd:date ;
    echr:hasSupportingQuote "on 11 March 1996 the proceeds from the ship sale were frozen on the order of the Nizhniy Novgorod prosecutor’s office."@en .

doc:admin_order_amended_judgment_1998_07_08 a echr:AdministrativeAction ;
    rdfs:label "Regional Court ordered applicant be given amended judgment (8 July 1998)"@en ;
    echr:hasCourt doc:courtNizhniyRegional ;
    echr:hasParticipation doc:part_admin_order_amended_judgment_1998_07_08_applicant ;
    echr:hasProceedingStartDate "1998-07-08"^^xsd:date ;
    echr:hasSupportingQuote "It appears that on 8 July 1998 the Regional Court ordered that the applicant should be given the amended version, but he claims that he did not receive it."@en .

doc:admin_service_judgment_1998_06_03 a echr:AdministrativeAction ;
    rdfs:label "Applicant received copy of judgment (3 June 1998)"@en ;
    echr:hasCourt doc:courtNizhniyRegional ;
    echr:hasParticipation doc:part_admin_service_judgment_1998_06_03_applicant ;
    echr:hasProceedingStartDate "1998-06-03"^^xsd:date ;
    echr:hasSupportingQuote "The applicant received a copy of the trial court judgment on 3 June 1998."@en .

doc:admin_stavanger_freed_1996_01_19 a echr:AdministrativeAction ;
    rdfs:label "Stavanger freed from arrest (19 January 1996)"@en ;
    echr:hasCourt doc:partyNizhniyProsecutor ;
    echr:hasParticipation doc:part_admin_stavanger_freed_1996_01_19_prosecution ;
    echr:hasProceedingStartDate "1996-01-19"^^xsd:date ;
    echr:hasSupportingQuote "On 19 January 1996 the Stavanger was freed from arrest"@en .

doc:admin_unfreeze_transfer_1996_05_18 a echr:AdministrativeAction ;
    rdfs:label "Unfreeze and transfer to \"Oka\" (18 May 1996)"@en ;
    echr:hasCourt doc:partyNizhniyProsecutor ;
    echr:hasParticipation doc:part_admin_unfreeze_transfer_1996_05_18_prosecution ;
    echr:hasProceedingStartDate "1996-05-18"^^xsd:date ;
    echr:hasSupportingQuote "On 18 May 1996 the Nizhniy Novgorod prosecutor’s office unfroze the account and transferred the money to the yard."@en .

doc:case_46503_99 a echr:CaseDocument ;
    rdfs:label "Application no. 46503/99 by Andrey Anatolyevitch KLIMENTYEV against Russia"@en ;
    echr:hasApplicant doc:partyAndreyKlimentyev ;
    echr:hasApplicationNumber "46503/99"^^xsd:string .

doc:civilDefender a echr:LegalRepresentative ;
    rdfs:label "the applicant's \"civil defender\""@en ;
    echr:hasPersonName "the applicant's \"civil defender\""@en ;
    echr:hasSupportingQuote "On 23 April 1998 the applicant’s “civil defender”, who participated in the process with a status similar to that of a lawyer, lodged with the Supreme Court an appeal against the court order of 2 April to detain the applicant."@en .

doc:lrMoskalenko a echr:LegalRepresentative ;
    rdfs:label "Mrs Moskalenko"@en ;
    echr:hasPersonName "Mrs Moskalenko"@en ;
    echr:hasSupportingQuote "He is represented before the Court by Mrs Moskalenko, a lawyer practising in Moscow, Russia and Mr Gerhart R. Baum, a lawyer practising in Koln, Germany."@en .

doc:lrMrO a echr:LegalRepresentative ;
    rdfs:label "Mr O."@en ;
    echr:hasPersonName "Mr. O."@en ;
    echr:hasSupportingQuote "An appeal to the Supreme Court by the applicant’s lawyer, Mr. O., challenged the judgment on a number of points."@en .

doc:proc_charge_7_mar_1995 a echr:ProsecutorialReview ;
    rdfs:label "Charges instituted (7 March 1995)"@en ;
    echr:hasParticipation doc:part_proc_charge_7mar1995_applicant,
        doc:part_proc_charge_7mar1995_prosecutor ;
    echr:hasProceedingStartDate "1995-03-07"^^xsd:date ;
    echr:hasSupportingQuote "was charged with embezzlement and other economic crimes on 7 March 1995."@en .

doc:proc_regional_motions_1998_05_19 a echr:DomesticProceeding ;
    rdfs:label "Regional Court decisions on motions (19 May 1998)"@en ;
    echr:hasCourt doc:courtNizhniyRegional ;
    echr:hasDecisionDate "1998-05-19"^^xsd:date ;
    echr:hasParticipation doc:part_regional_motions_1998_05_19_applicant ;
    echr:hasSupportingQuote "On 19 May the applicant’s “civil defender” requested the Regional Court to dismiss the judge presiding in the case for bias. The judge’s bias was allegedly shown by his refusal to call some of the witnesses requested by the defence (former governor of the region, the Regional Prosecutor, some other high-ranking officials), by his order to detain the applicant and by admitting evidence contested by the defence. He referred to Article 6 of the Convention. On the same day the applicant requested to admit Mrs Moskalenko as his lawyer in the trial because one of his lawyers was on sick leave. Both requests were rejected by the Regional Court." .

doc:proc_regional_newtrial_1998_03_30 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court - new trial (30 March 1998)"@en ;
    echr:followsProceeding doc:proc_supreme_jul_1997 ;
    echr:hasCourt doc:courtNizhniyRegional ;
    echr:hasParticipation doc:part_regional_30mar1998_applicant,
        doc:part_regional_30mar1998_prosecutor ;
    echr:hasProceedingStartDate "1998-03-30"^^xsd:date ;
    echr:hasSupportingQuote "On 30 March 1998, during the new trial, the prosecutor applied to the court to detain the applicant for violations of the undertaking not to leave the city during the trial and obstruction of justice. The Regional Court rejected the motion as unsubstantiated."@en .

doc:proc_supreme_10_aug_1998 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court cassation decision (10 August 1998)"@en ;
    echr:followsProceeding doc:proc_regional_27_may_1998 ;
    echr:hasCourt doc:courtSupreme ;
    echr:hasDecisionDate "1998-08-10"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_supreme_10aug1998_applicant,
        doc:part_supreme_10aug1998_prosecutor ;
    echr:hasSupportingQuote "On 10 August 1998 the Supreme Court confirmed the judgment of the Nizhniy Novgorod Regional Court, with some alterations."@en ;
    echr:isFinalDomesticDecision true .

doc:proc_supreme_appeal_1998_04_23 a echr:DomesticProceeding ;
    rdfs:label "Appeal to Supreme Court against detention order (23 April 1998; reply 19 May 1998)"@en ;
    echr:followsProceeding doc:proc_regional_detention_1998_04_02 ;
    echr:hasCourt doc:courtSupreme ;
    echr:hasDecisionDate "1998-05-19"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasParticipation doc:part_supreme_appeal_1998_04_23_applicant ;
    echr:hasProceedingStartDate "1998-04-23"^^xsd:date ;
    echr:hasSupportingQuote "The reply from the Supreme Court, dated 19 May 1998, stated that the national law did not allow appeals against that type of trial court orders separately from appeals against judgments."@en .

