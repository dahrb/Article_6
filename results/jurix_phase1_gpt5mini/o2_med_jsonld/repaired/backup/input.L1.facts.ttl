doc:stanev_first_instance_2000 a echr:DomesticProceeding ;
    rdfs:label "Ruse Regional Court judgment - 20 November 2000"@en ;
    echr:hasCourt doc:ruseRegionalCourt ;
    echr:hasDecisionDate "2000-11-20"^^xsd:date ;
    echr:hasParticipation doc:particip_ruse_prosecutor_firstinstance_2000,
        doc:particip_stanev_firstinstance_2000 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "In a judgment of 20 November 2000, the court declared the applicant to be partially incapacitated on the grounds that he had been suffering from simple schizophrenia since 1975, and that his ability to manage his own affairs and interests and to realise the consequences of his own acts had been impaired."@en .

doc:velikoTarnovoCourtOfAppeal a echr:DomesticAuthority ;
    rdfs:label "Veliko Tarnovo Court of Appeal ( Апелативен съд )"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Veliko Tarnovo Court of Appeal ( Апелативен съд )"^^xsd:string .

doc:welfare_report_2002 a echr:AdministrativeAction ;
    rdfs:label "Welfare report by Ruse social services - 23 July 2002"@en ;
    echr:followsProceeding doc:placement_request_2002 ;
    echr:hasDecisionDate "2002-07-23"^^xsd:date ;
    echr:hasParticipation doc:particip_ruse_social_services_welfare_2002,
        doc:particip_stanev_welfare_2002 ;
    echr:hasSupportingQuote "Social services drew up a welfare report on the applicant, noting on 23 July 2002 that he was suffering from schizophrenia, that he lived alone in a small, run-down annexe to his half-sister’s house and that his half-sister and his father’s second wife had stated that they did not wish to act as his guardian."@en .

doc:municipalSocialAssistanceDepartment a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "the municipal social assistance department"@en ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "municipal social assistance department"@en ;
    echr:hasSupportingQuote "Further to that request, on 30 December 2005 the municipal social assistance department carried out a “social assessment” ( социална оценка ) of the applicant, which concluded that he was incapable of working, even in a sheltered environment, and had no need for training or retraining, and that in those circumstances he was entitled to a social allowance to cover the costs of his transport, subsistence and medication."@en .

doc:municipal_appointment_2002 a echr:AdministrativeAction ;
    rdfs:label "Ruse Municipal Council appointment of guardian - 23 May 2002"@en ;
    echr:hasDecisionDate "2002-05-23"^^xsd:date ;
    echr:hasParticipation doc:particip_ms_r_p_appointment_2002,
        doc:particip_ruse_municipal_appointment_2002 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "Since the applicant’s family members had refused to take on any guardianship responsibilities, on 23 May 2002 the Municipal Council appointed Ms R.P., a council officer, as the applicant’s guardian until 31 December 2002."@en .

doc:publicProsecutorOffice a echr:DomesticAuthority,
