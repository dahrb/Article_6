doc:const_application_11_sep_2017 a echr:DomesticProceeding ;
    rdfs:label "individual application lodged with the Constitutional Court (11 September 2017)"@en ;
    echr:followsProceeding doc:fund_response_decision_11_aug_2017_notified_5_sep_2017 ;
