doc:const_decision_23_may_2018_inadmissible a echr:DomesticProceeding ;
    rdfs:label "Constitutional Court decision declaring the application inadmissible (23 May 2018)"@en ;
    echr:followsProceeding doc:const_application_11_sep_2017 ;
    echr:hasCourt doc:constitutionalCourt ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasParticipation doc:part_const_app_2017_applicant ;
    echr:hasSupportingQuote "In a decision of 23 May 2018, the Constitutional Court observed that the final annulment judgment of the 13th Chamber of the Supreme Administrative Court had been served on the applicant on 28 July 2017 and determined that the thirty-day time-limit for lodging an individual application had commenced on that date. Noting that the applicant’s application had been submitted on 11 September 2017, after the expiry of the time-limit, the Constitutional Court declared the application inadmissible. The decision was served on the applicant on 7 June 2018."@en ;
    echr:isFinalDomesticDecision true .

