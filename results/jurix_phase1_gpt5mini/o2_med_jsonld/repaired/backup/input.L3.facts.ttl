doc:requestForRectificationFollowingAppeal a echr:DomesticProceeding ;
    rdfs:label "request for rectification (granted 30 June 2017)"@en ;
    echr:followsProceeding doc:proc_13th_chamber_upheld_9_dec_2014 ;
    echr:hasCourt doc:fund ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_rectify_2017_applicant,
        doc:part_rectify_2017_fund ;
    echr:hasSupportingQuote "Following this decision, the applicant lodged a request for rectification. On 30 June 2017, the 13 th Chamber of the Supreme Administrative Court granted the request, referring to the ruling of the General Assembly of 7 July 2015 which had annulled the Fund’s decision of 13 January 2011 concerning the valuation of Viva TV-Radio Viva (see paragraph 29 above). The court held that the annulment in that judgment necessitated a fresh judicial review of the case."@en .

