doc:proc_13th_chamber_annulment_30_jun_2017 a echr:DomesticProceeding ;
    rdfs:label "13th Chamber overturned 6th Chamber and annulled the sale (30 June 2017)"@en ;
    echr:followsProceeding doc:requestForRectificationFollowingAppeal ;
    echr:hasCourt doc:fund ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_annul_2017_applicant,
        doc:part_annul_2017_fund ;
    echr:hasSupportingQuote "The court further emphasised that, since the Fund’s decision of 13 January 2011 had been definitively annulled, all actions based on that decision had been rendered legally invalid. As a result, the court overturned the judgment of the 6th Chamber of the Istanbul Administrative Court dated 19 March 2014 and annulled the sale in question."@en .

doc:proc_13th_chamber_upheld_9_dec_2014 a echr:DomesticProceeding ;
    rdfs:label "13th Chamber upheld decision on appeal (9 December 2014)"@en ;
    echr:followsProceeding doc:proc_6th_chamber_19_mar_2014 ;
    echr:hasCourt doc:fund ;
    echr:hasDecisionDate "2014-12-09"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_6th_2014_applicant,
        doc:part_6th_2014_fund ;
    echr:hasSupportingQuote "On an appeal by the applicant, the 13th Chamber of the Supreme Administrative Court upheld that decision on 9 December 2014."@en .

doc:proc_6th_chamber_19_mar_2014 a echr:DomesticProceeding ;
    rdfs:label "6th Chamber decision dismissing the applicant's claim (19 March 2014)"@en ;
    echr:followsProceeding doc:initiation_proceeding_24_feb_2011 ;
    echr:hasCourt doc:fund ;
    echr:hasDecisionDate "2014-03-19"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_6th_2014_applicant,
        doc:part_6th_2014_fund ;
    echr:hasSupportingQuote "On 19 March 2014, the 6th Chamber of the İstanbul Administrative Court dismissed the applicant’s claim, concluding that no legal irregularities had occurred in the tendering and sale procedures."@en .

doc:proceeding_admincourt_2011_02_07 a echr:DomesticProceeding ;
    rdfs:label "On 7 February 2011, the applicant initiated proceedings before the administrative court, contesting the actions of the Fund concerning the tendering of Viva TV-Radio Viva"@en ;
    echr:hasCourt doc:fund ;
    echr:hasParticipation doc:participation_proc1_applicant,
        doc:participation_proc1_fund ;
    echr:hasProceedingStartDate "2011-02-07"^^xsd:date ;
    echr:hasSupportingQuote "On 7 February 2011, the applicant initiated proceedings before the administrative court, contesting the actions of the Fund concerning the tendering of Viva TV-Radio Viva, in which he claimed to hold both direct and indirect shares."@en .

doc:proceeding_general_assembly_2015_07_07 a echr:DomesticProceeding ;
    rdfs:label "On 7 July 2015, following an appeal by the applicant, the General Assembly ... annulled the Fund’s decision."@en ;
    echr:followsProceeding doc:proceeding_supadmct_2014_12_09 ;
    echr:hasCourt doc:generalAssemblyAdministrativeProceedingsDivisions ;
    echr:hasDecisionDate "2015-07-07"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_proc1_applicant,
        doc:participation_proc1_fund ;
    echr:hasSupportingQuote "On 7 July 2015, following an appeal by the applicant, the General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court ( Danıştay İdari Dava Daireleri Genel Kurulu – hereinafter “the General Assembly”), in line with the dissenting opinion, ruled that the estimated value of USD 6,000,000 had been determined on the basis of the 2009 valuation report, without any new assessment of the market value. The General Assembly concluded that the contested decision was not in compliance with the law, and, by a majority, annulled the Fund’s decision."@en .

doc:proceeding_supadmct_2014_12_09 a echr:DomesticProceeding ;
