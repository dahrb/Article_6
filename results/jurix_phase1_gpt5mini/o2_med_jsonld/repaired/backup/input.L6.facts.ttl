doc:domestic_proceeding_arbitration_claim_20080917 a echr:DomesticProceeding ;
    rdfs:label "applicant company lodged a claim with the Arbitration Tribunal"@en ;
    echr:followsProceeding doc:admin_action_arbitration_president_reply_20080801 ;
    echr:hasCourt doc:arbitrationTribunal ;
    echr:hasParticipation doc:part_arbit_20080917_applicant,
        doc:part_arbit_20080917_llc ;
    echr:hasProceedingStartDate "2008-09-17"^^xsd:date ;
    echr:hasSupportingQuote "On 17 September 2008 the applicant company lodged a claim with the Arbitration Tribunal, seeking to recover EUR 116,600, the amount of the loan and interest."@en .

doc:domestic_proceeding_commercial_court_20071210 a echr:DomesticProceeding ;
    rdfs:label "three-judge bench of the Commercial Court rejected the complaint"@en ;
    echr:hasCourt doc:commercialCourt ;
    echr:hasDecisionDate "2007-12-10"^^xsd:date ;
    echr:hasParticipation doc:part_commercial_20071210_applicant,
        doc:part_commercial_20071210_llc ;
    echr:hasSupportingQuote "On 10 December 2007 a three-judge bench of the Commercial Court rejected the complaint submitted by the applicant company."@en .

doc:domestic_proceeding_district_court_20090313_20090616 a echr:DomesticProceeding ;
    rdfs:label "District Court accepted the case for examination (13 March 2009) / decided to leave the claim unexamined (16 June 2009)"@en ;
    echr:followsProceeding doc:admin_action_transfer_to_district_20090227 ;
    echr:hasCourt doc:districtCourtKentronNorkMarash ;
    echr:hasDecisionDate "2009-06-16"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_district_20090313_applicant,
        doc:part_district_20090313_llc ;
    echr:hasProceedingStartDate "2009-03-13"^^xsd:date ;
    echr:hasSupportingQuote "On 13 March 2009 the District Court accepted the case for examination."@en,
        "On 16 June 2009 the District Court decided to leave the claim lodged by the applicant company unexamined, finding that the refusal to start arbitration proceedings stated in the letter of 7 October 2008 did not substantiate the fact that there was no possibility of applying to the Arbitration Tribunal."@en .

doc:domestic_proceeding_yerevan_civil_20081017_20081112 a echr:DomesticProceeding ;
    rdfs:label "applicant company lodged a claim with the Yerevan Civil Court / acceptance and freezing injunction (12 November 2008)"@en ;
    echr:followsProceeding doc:admin_action_arbitration_refusal_20081007 ;
    echr:hasCourt doc:yerevanCivilCourt ;
    echr:hasDecisionDate "2008-11-12"^^xsd:date ;
    echr:hasParticipation doc:part_yerevan_20081017_applicant,
        doc:part_yerevan_20081017_llc ;
    echr:hasProceedingStartDate "2008-10-17"^^xsd:date ;
    echr:hasSupportingQuote "On 12 November 2008 the Yerevan Civil Court accepted the applicant company’s claim for examination and scheduled a preparatory hearing."@en,
        "On 17 October 2008 the applicant company lodged a claim with the Yerevan Civil Court, seeking to recover EUR 116,600 from the LLC, representing the amount of the loan and interest."@en,
        "On the same day it allowed the applicant company’s interlocutory application for a freezing injunction in respect of the property of the LLC in the amount of the claim."@en .

doc:dp_commercial_first_instance_20070115 a echr:DomesticProceeding ;
    rdfs:label "**14.** On 15 January 2007 the applicant company lodged a claim with the Commercial Court against the LLC, seeking to recover USD 10,000 from the initial debt of USD 1,213,824."@en ;
    echr:hasCourt doc:commercialCourt ;
    echr:hasDecisionDate "2007-11-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_llc_firstinstance_20070115,
        doc:participation_scholz_firstinstance_20070115 ;
    echr:hasProceedingStartDate "2007-01-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "**14.** On 15 January 2007 the applicant company lodged a claim with the Commercial Court against the LLC, seeking to recover USD 10,000 from the initial debt of USD 1,213,824."@en,
        "**16.** On 16 November 2007 the Commercial Court granted the request and decided to leave the applicant company’s claim and the counterclaim lodged by the LLC unexamined."@en,
        "**18.** On 7 November 2007 the LLC requested the Commercial Court to leave the applicant company’s claim unexamined on the grounds that the contracts ... be referred to the Arbitration Tribunal of the Chamber of Commerce and Industry of Armenia (“the Arbitration Tribunal”)."@en,
        "**4.** On 4 October 2007 the LLC filed a counterclaim, contesting the applicant company’s claims."@en .

