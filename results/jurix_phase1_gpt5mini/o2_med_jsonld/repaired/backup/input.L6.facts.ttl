doc:arbitrationTribunalChamberOfCommerce a echr:DomesticAuthority ;
    rdfs:label "Arbitration Tribunal of the Chamber of Commerce and Industry of Armenia"@en ;
    echr:hasAuthorityKind echr:AuthorityUnknown ;
    echr:hasAuthorityName "Arbitration Tribunal of the Chamber of Commerce and Industry of Armenia"@en ;
    echr:hasSupportingQuote "**18.** On 7 November 2007 the LLC requested the Commercial Court to leave the applicant company’s claim unexamined on the grounds that the contracts ... be referred to the Arbitration Tribunal of the Chamber of Commerce and Industry of Armenia (“the Arbitration Tribunal”)."@en .

doc:case_document_1 a echr:CaseDocument ;
    rdfs:label "the applicant company"@en ;
    echr:hasApplicant doc:partyApplicantCompany .

doc:domestic_proceeding_cassation_20090804_20090923 a echr:DomesticProceeding ;
    rdfs:label "applicant lodged an appeal on points of law / Court of Cassation declared it inadmissible (23 September 2009)"@en ;
    echr:followsProceeding doc:domestic_proceeding_appeal_court_of_appeal_20090625_20090721 ;
    echr:hasCourt doc:courtOfCassation ;
    echr:hasDecisionDate "2009-09-23"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_cassation_20090804_applicant,
        doc:part_cassation_20090804_llc ;
    echr:hasProceedingStartDate "2009-08-04"^^xsd:date ;
    echr:hasSupportingQuote "\"... As for the letter of the President of the Arbitration Tribunal of the Chamber of Commerce of 7 October 2008 concerning non-acceptance of the claim lodged by [the applicant company], it was based on the grounds that [the applicant company] had not submitted the original arbitration agreement or a certified copy, as required by the Commercial Arbitration Act and [the provisions contained therein], in the absence of which arbitration proceedings could not be started.\""@en,
        "On 23 September 2009 the Court of Cassation declared the applicant company’s appeal on points of law inadmissible."@en,
        "On 4 August 2009 the applicant company lodged an appeal on points of law."@en ;
    echr:isFinalDomesticDecision true .

doc:dp_commercial_appeal_20071123 a echr:DomesticProceeding ;
    rdfs:label "**20.** On 23 November 2007 the applicant company lodged a complaint concerning the decision to leave the claim and counterclaim unexamined."@en ;
    echr:followsProceeding doc:dp_commercial_first_instance_20070115 ;
    echr:hasCourt doc:commercialCourt ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasParticipation doc:participation_llc_appeal_20071123,
        doc:participation_scholz_appeal_20071123 ;
    echr:hasProceedingStartDate "2007-11-23"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "**19.** The decision was amenable to appeal before a three-judge bench of the Commercial Court within three days of receipt by the party."@en,
        "**20.** On 23 November 2007 the applicant company lodged a complaint concerning the decision to leave the claim and counterclaim unexamined."@en .

doc:admin_action_arbitration_president_reply_20080801 a echr:AdministrativeAction ;
    rdfs:label "President of the Arbitration Tribunal replied (1 August 2008)"@en ;
    echr:followsProceeding doc:domestic_proceeding_commercial_court_20071210 ;
    echr:hasCourt doc:arbitrationTribunal ;
    echr:hasDecisionDate "2008-08-01"^^xsd:date ;
    echr:hasParticipation doc:part_arbit_20080917_applicant,
        doc:part_arbit_refusal_tribunal_20081007 ;
    echr:hasSupportingQuote "On 1 August 2008 the President of the Arbitration Tribunal replied that the question of whether the arbitration clause stipulated in the contracts concluded between the parties was sufficient for it to accept the claim for examination could only be determined once the claim had been lodged."@en .

doc:admin_action_arbitration_refusal_20081007 a echr:AdministrativeAction ;
    rdfs:label "President of the Arbitration Tribunal refused to start arbitration proceedings (7 October 2008)"@en ;
    echr:followsProceeding doc:domestic_proceeding_arbitration_claim_20080917 ;
    echr:hasCourt doc:arbitrationTribunal ;
    echr:hasDecisionDate "2008-10-07"^^xsd:date ;
    echr:hasParticipation doc:part_arbit_20080917_applicant,
        doc:part_arbit_refusal_tribunal_20081007 ;
    echr:hasSupportingQuote "\"... The promissory note of 8 November 2002 and the agreement of 28 October 2005, on which your claim was based, do not contain an arbitration clause and, moreover, the parties have not concluded any agreement to submit the disputes arising out of the performance of the above-mentioned promissory note and the agreement to the permanent arbitration institution of the Chamber of Commerce and Industry of Armenia for determination. Consequently, in the absence of an arbitration agreement between the parties, the [Arbitration Tribunal] cannot start arbitration proceedings.\""@en,
        "On 7 October 2008 the President of the Arbitration Tribunal informed the applicant company that its request to start arbitration proceedings would not be granted."@en .

doc:admin_action_transfer_to_district_20090227 a echr:AdministrativeAction ;
    rdfs:label "Yerevan Civil Court transferred the case to the District Court (27 February 2009)"@en ;
    echr:followsProceeding doc:domestic_proceeding_yerevan_civil_20081017_20081112 ;
    echr:hasCourt doc:yerevanCivilCourt ;
    echr:hasDecisionDate "2009-02-27"^^xsd:date ;
    echr:hasSupportingQuote "On 27 February 2009 the Yerevan Civil Court transferred the case to the Kentron and Nork-Marash District Court of Yerevan (“the District Court”) based on territorial jurisdiction, in view of the fact that on 1 March 2009 the Yerevan Civil Court would be abolished."@en .

