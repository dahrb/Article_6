doc:domestic_proceeding_aliens_appeals_board_extremely_urgent_2016_10_07 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board — extremely urgent procedure (decision 7 October 2016)"@en ;
    echr:followsProceeding doc:administrative_action_aliens_refusal_2016_09_13 ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2016-10-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasParticipation doc:part_aliens_appeals_2016_10_07_aliens_office,
        doc:part_aliens_appeals_2016_10_07_applicants,
        doc:part_appeal_2016_10_07_applicants ;
    echr:hasSupportingQuote "It also reiterated the res judicata nature of its judgments, in particular that of 7 October 2016, which had nonetheless not been executed."@en,
        "On 7 October 2016 the Aliens Appeals Board, acting under the extremely urgent procedure, ordered a stay of execution of the refusals by the Aliens Office to grant visas and instructed the Belgian State to take new decisions within 48 hours, giving adequate legal grounds, that is, by giving reasons which took account of the extremely dangerous situation in Syria."@en .

