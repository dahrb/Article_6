doc:brussels_court_of_appeal_judgment_2016_12_07 a echr:DomesticProceeding ;
    rdfs:label "the Brussels Court of Appeal’s judgment of 7 December 2016 ordering the Belgian State to execute the Aliens Appeals Board’s judgment of 20 October 2016"@en ;
    echr:followsProceeding doc:aliens_appeals_2016_10_20,
        doc:tpi_inter_partes_2016_11_07 ;
    echr:hasCourt doc:brusselsCourtOfAppeal ;
    echr:hasDecisionDate "2016-12-07"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_brussels_appeal_2016_12_07_applicants,
        doc:participation_applicants_brussels_coa_2016_12_07,
        doc:participation_applicants_courtappeal_20161207,
        doc:participation_belgian_state_brussels_coa_2016_12_07,
        doc:participation_state_courtappeal_20161207 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "the Brussels Court of Appeal delivered a judgment on 7 December 2016 varying the order of 7 November 2016. It held that the applicants could rely on the binding and enforceable nature of the contested judgment ... It also considered that ... the appeal lodged with it was not wholly devoid of purpose."^^xsd:string,
        "the Brussels Court of Appeal’s judgment of 7 December 2016 ordering the Belgian State to execute the Aliens Appeals Board’s judgment of 20 October 2016"@en,
        "the court of appeal’s judgment of 7 December 2016"@en ;
    echr:isFinalDomesticDecision true .

doc:court_of_appeal_judgment_20170630 a echr:DomesticProceeding ;
    rdfs:label "Brussels Court of Appeal judgment of 30 June 2017"@en ;
    echr:followsProceeding doc:brussels_court_of_appeal_judgment_2016_12_07,
        doc:state_action_enforcementjudge_20161215 ;
    echr:hasCourt doc:brusselsCourtOfAppeal ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasParticipation doc:part_brussels_appeal_2017_06_30_applicants,
        doc:part_brussels_appeal_2017_06_30_belgian_state,
        doc:participation_applicants_courtappeal_20170630,
        doc:participation_state_courtappeal_20170630 ;
    echr:hasSupportingQuote "it secured this aim through the court of appeal’s judgment of 30 June 2017."^^xsd:string,
        "It was ultimately the action lodged by the Belgian State (see paragraph 37 above) which was the first to be examined by the Brussels Court of Appeal. By a judgment of 30 June 2017 a Dutch-language division of the Court of Appeal held that the Aliens Appeals Boards’ judgment of 20 October 2016 was no longer operative, given that the applicants had not lodged an application to have the visa refusal decisions of 13 September 2016 set aside."@en .

