doc:aliens_appeals_2016_10_14 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board judgment ordering stay (14 October 2016)"@en ;
    echr:followsProceeding doc:administrative_decision_2016_10_10 ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2016-10-14"^^xsd:date ;
