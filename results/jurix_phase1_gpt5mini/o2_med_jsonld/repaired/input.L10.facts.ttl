doc:aliens_appeals_2016_10_20 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board judgment ordering stay and interim measures (20 October 2016)"@en ;
    echr:followsProceeding doc:administrative_decision_2016_10_17 ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2016-10-20"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_aliens_appeals_2016_10_20_applicants,
        doc:participation_applicants_aliens_appeals_2016_10_20,
        doc:participation_belgian_state_aliens_appeals_2016_10_20 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "By a judgment of 20 October 2016 the Aliens Appeals Board, essentially reiterating the substance of its previous judgments, ordered a stay of execution of the refusal decisions of 17 October 2016. In addition... it considered that it was justified to direct the State to issue the applicants, within 48 hours, with laissez-passers or visas, valid for three months."^^xsd:string,
        "the Aliens Appeals Board’s judgment of 20 October 2016, which had instructed the Belgian authorities to issue them with the visas they had requested under Article 3 of the Convention."@en .

