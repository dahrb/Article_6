    dcterms:title "input.jsonl:2"^^xsd:string .

doc:caseBeerAndRegan a echr:CaseDocument ;
    rdfs:label "CASE OF BEER AND REGAN v. GERMANY"@en ;
    echr:hasApplicant doc:partyKarlheinzBeer,
        doc:partyPhilipRegan ;
    echr:hasApplicationNumber "28934/95"^^xsd:string ;
    echr:hasCaseName "Beer and Regan v. Germany"@en ;
    echr:hasDomesticProceeding doc:proceeding_darmstadt_labour_1993 ;
    echr:hasSupportingQuote "(Application no. 28934/95)"@en,
        "CASE OF BEER AND REGAN v. GERMANY"@en,
        "by a German national, Mr Karlheinz Beer, and by a British national, Mr Philip Regan, on 13 September 1995."@en .

doc:case_28934_95 a echr:CaseDocument ;
    rdfs:label "application no. 28934/95"@en ;
    echr:hasApplicant doc:partyBeer,
        doc:partyRegan ;
    echr:hasApplicationNumber "28934/95"^^xsd:string ;
    echr:hasDomesticProceeding doc:domestic_proceeding_darmstadt_1 ;
    echr:hasRespondentState "Federal Republic of Germany"@en .

doc:case_document_1 a echr:CaseDocument ;
    rdfs:label "the case"@en,
        "the present case"@en ;
    echr:hasApplicant doc:applicantsParty,
        doc:partyFirstApplicant,
        doc:partySecondApplicant ;
    echr:hasDomesticProceeding doc:domprocGermanCourtsImmunity,
        doc:domproc_darmstadt_settlement_1,
        doc:domproc_labour_immunity_1 ;
    echr:hasSupportingQuote "**63.** In view of all these circumstances, the Court finds that, in giving effect to the immunity from jurisdiction of ESA on the basis of section 20(2) of the Courts Act, the German courts did not exceed their margin of appreciation."@en .

doc:authority_labour_court_1 a echr:DomesticAuthority ;
    rdfs:label "The Labour Court"@en ;
    echr:hasAuthorityName "The Labour Court"@en .

doc:domestic_proceeding_darmstadt_1 a echr:DomesticProceeding ;
    rdfs:label "Darmstadt labour court proceedings"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_beer_dp1,
        doc:participation_esa_dp1,
        doc:participation_regan_dp1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "In the instant case the Darmstadt Labour Court concluded that the conditions under section 20(2) of the German Courts Act for finding that the applicants’ action was inadmissible were fulfilled."@en,
        "the labour court proceedings instituted by the applicants involved the “determination of [their] civil rights and obligations”."@en .

doc:domprocGermanCourtsImmunity a echr:DomesticProceeding ;
    rdfs:label "giving effect to the immunity from jurisdiction of ESA on the basis of section 20(2) of the Courts Act"@en ;
    echr:hasCourt doc:germanCourtsAuthority ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_applicants_domproc1,
        doc:participation_esa_domproc1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "**63.** In view of all these circumstances, the Court finds that, in giving effect to the immunity from jurisdiction of ESA on the basis of section 20(2) of the Courts Act, the German courts did not exceed their margin of appreciation."@en .

doc:domproc_darmstadt_settlement_1 a echr:DomesticProceeding ;
    rdfs:label "In the proceedings instituted by the second applicant against his dismissal by the company T.I. (see paragraph 13 above), a settlement had been reached in the Darmstadt Labour Court on 6 September 1994. According to this settlement, the second applicant’s employment with the company T.I. had terminated on 31 December 1993, and the company T.I. undertook to pay to the second applicant the sum of 22,000 marks (DEM) for loss of job."@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1994-09-06"^^xsd:date ;
    echr:hasOutcome echr:OutcomeSettledOrWithdrawn ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_darmstadt_company_ti_1,
        doc:participation_labour_second_app_settlement_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "In the proceedings instituted by the second applicant against his dismissal by the company T.I. (see paragraph 13 above), a settlement had been reached in the Darmstadt Labour Court on 6 September 1994. According to this settlement, the second applicant’s employment with the company T.I. had terminated on 31 December 1993, and the company T.I. undertook to pay to the second applicant the sum of 22,000 marks (DEM) for loss of job."@en .

doc:domproc_labour_immunity_1 a echr:DomesticProceeding ;
    rdfs:label "The Labour Court, referring to section 20(2) of the Courts Act ( Gerichtsverfassungsgesetz ), according to which immunity from jurisdiction could be provided for, inter alia , in international agreements, considered that ESA enjoyed such immunity under Article XV § 2 of the ESA Convention and its Annex I."@en ;
    echr:hasCourt doc:authority_labour_court_1 ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_labour_first_app_1,
        doc:participation_labour_second_app_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "The Labour Court, referring to section 20(2) of the Courts Act ( Gerichtsverfassungsgesetz ), according to which immunity from jurisdiction could be provided for, inter alia , in international agreements, considered that ESA enjoyed such immunity under Article XV § 2 of the ESA Convention and its Annex I."@en .

doc:esaParty a echr:Party ;
    rdfs:label "ESA"@en ;
    echr:hasPartyName "ESA"^^xsd:string ;
    echr:hasSupportingQuote "the rule of immunity from jurisdiction, which the German courts applied to ESA in the present case, has a legitimate objective."@en .

doc:germanCourtsAuthority a echr:DomesticAuthority ;
    rdfs:label "the German courts"@en ;
    echr:hasAuthorityName "the German courts"^^xsd:string ;
    echr:hasJurisdictionState "Germany"^^xsd:string ;
    echr:hasSupportingQuote "the rule of immunity from jurisdiction, which the German courts applied to ESA in the present case, has a legitimate objective."@en .

doc:participation_applicants_domproc1 a echr:Participation ;
    rdfs:label "participation of the applicants in German courts' immunity decision"@en ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "**61.** The significant feature of the instant case is that the applicants, after having performed services at the premises of ESOC in Darmstadt for a considerable time on the basis of contracts with foreign firms, attempted to obtain recognition of permanent employment by ESA on the basis of the above-mentioned special German legislation for the regulation of the German labour market."@en ;
    echr:participatingParty doc:applicantsParty .

doc:participation_beer_darmstadt_1993 a echr:Participation ;
    rdfs:label "participation of Mr Karlheinz Beer in proceedings before the Darmstadt Labour Court"@en ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "the applicants instituted proceedings before the Darmstadt Labour Court ( Arbeitsgericht )"@en ;
    echr:participatingParty doc:partyKarlheinzBeer .

doc:participation_beer_dp1 a echr:Participation ;
    rdfs:label "participation of Mr Beer in Darmstadt labour court proceedings"@en ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "the labour court proceedings instituted by the applicants"@en ;
    echr:participatingParty doc:partyBeer .

doc:participation_darmstadt_company_ti_1 a echr:Participation ;
    rdfs:label "participation of the company T.I. in Darmstadt Labour Court settlement"@en ;
