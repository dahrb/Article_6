doc:proceeding_darmstadt_labour_1993 a echr:DomesticProceeding ;
    rdfs:label "proceedings before the Darmstadt Labour Court ( Arbeitsgericht )"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_beer_darmstadt_1993,
        doc:participation_esa_darmstadt_1993,
        doc:participation_regan_darmstadt_1993 ;
    echr:hasProceedingStartDate "1993-10"^^xsd:gYearMonth ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "In October and November 1993 the applicants instituted proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA"@en,
        "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."@en ;
    echr:isFinalDomesticDecision true .

