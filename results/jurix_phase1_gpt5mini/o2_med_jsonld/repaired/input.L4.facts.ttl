doc:caseAleksanderMatko a echr:CaseDocument ;
    rdfs:label "Matko v. Slovenia"@en,
        "Matko v. Slovenia (domestic chain)"@en ;
    echr:hasApplicant doc:personAleksanderMatko ;
    echr:hasApplicationNumber "43393/98"^^xsd:string ;
    echr:hasCaseName "CASE OF MATKO v. SLOVENIA"@en ;
    echr:hasDomesticProceeding doc:adm_police_received_complaint_by_applicant_1995_05_15,
        doc:appeal_by_prosecutor_1997_05_12,
        doc:appeal_decision_open_investigation_1997_12_04,
        doc:appeals_after_retrial_2001_03_12_2001_05_09,
        doc:arrest_1995_04_05,
        doc:complaint_1995_04_07,
        doc:criminal_investigation_1995,
        doc:final_costs_order_2001_10_11,
        doc:indictment_filed_1998_12_28,
        doc:investigation_concluded_exclusion_decision_1998_03_17,
        doc:investigation_interviews_1998_02_19_1998_03_10,
        doc:judicial_decision_no_investigation_1997_05_08,
        doc:judicial_investigation_questioning_1997_04_08,
        doc:maribor_quash_and_remit_2000_09_27,
        doc:mia_report_submitted_1995_11_15,
        doc:mia_working_group_appointed_1995_04_20,
        doc:objection_rejected_1999_02_16,
        doc:objection_to_indictment_1999_01_27,
        doc:police_complaint_against_applicant_1995_04_12,
        doc:police_report_submitted_1996_02_05,
        doc:proc_deposition_added_1995_06_20,
        doc:proc_dismissal_applicant_complaint_1997_01_17,
        doc:proc_request_deposition_1995_06_15,
        doc:proc_request_identify_officers_1995_07_14,
        doc:proc_request_open_investigation_against_applicant_1997_01_17,
        doc:prosecutor_appeal_after_acquittal_2000_01_05,
        doc:retrial_conviction_2001_02_12,
        doc:retrial_hearings_2000_12_15_2001_02_12,
        doc:trial_hearings_1999_09_13_1999_11_22,
        doc:trial_judgment_acquittal_1999_11_22 ;
    echr:hasSupportingQuote "The case originated in an application (no. 43393/98) against the Republic of Slovenia lodged with the European Commission of Human Rights (“the Commission”) under former Article 25 of the Convention for the Protection of Human Rights and Fundamental Freedoms (“the Convention”) by a Slovenian national, Mr Aleksander Matko (“the applicant”), on 22 July 1998."^^xsd:string .

doc:specialUnit a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Special Unit ( Specialna enota )"@en ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Special Unit ( Specialna enota )"@en ;
    echr:hasJurisdictionState "Slovenia"^^xsd:string ;
    echr:hasSupportingQuote "a Special Unit ( Specialna enota ), which was under the direct control of the Ministry of Internal Affairs (“the MIA”)"^^xsd:string .

doc:adm_police_received_complaint_by_applicant_1995_05_15 a echr:AdministrativeAction ;
    rdfs:label "Applicant lodged criminal complaint with Slovenj Gradec Police"@en ;
    echr:hasCourt doc:slovenjGradecPolice ;
    echr:hasParticipation doc:part_adm_police_received_complaint_applicant_1995_05_15,
        doc:part_adm_police_received_complaint_police_1995_05_15 ;
    echr:hasProceedingStartDate "1995-05-15"^^xsd:date ;
    echr:hasSupportingQuote "On 15 May 1995 the applicant lodged, through his lawyer, a written criminal complaint ( kazenska ovadba ) with the Slovenj Gradec Police against unidentified police officers for causing minor bodily harm ( lahka telesna poškodba ) and an unlawful deprivation of liberty ( protipraven odvzem prostosti )."@en .

doc:applicant_legal_representative_1 a echr:LegalRepresentative,
        echr:NaturalPerson ;
    rdfs:label "the applicant's lawyer"@en .

doc:complaint_1995_04_07 a echr:AdministrativeAction ;
    rdfs:label "Applicant's oral complaint to the Slovenj Gradec Police and written statement (7 April 1995)"@en ;
    echr:followsProceeding doc:arrest_1995_04_05 ;
    echr:hasCourt doc:slovenjGradecPolice ;
    echr:hasParticipation doc:participationComplaintApplicant,
        doc:participationComplaintPolice ;
    echr:hasProceedingStartDate "1995-04-07"^^xsd:date ;
    echr:hasSupportingQuote "On 7 April 1995 the applicant went to the Slovenj Gradec Police and made an oral complaint against the officers of the Special Unit concerning the events of 5 April 1995. A written statement was prepared by the officer in charge and signed by the applicant."^^xsd:string .

doc:criminal_investigation_1995 a echr:DomesticProceeding ;
    rdfs:label "Criminal investigation instituted against the applicant (April 1995)"@en ;
    echr:followsProceeding doc:arrest_1995_04_05 ;
    echr:hasCourt doc:slovenjGradecPolice ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasParticipation doc:participationInvestigationApplicant,
        doc:participationInvestigationPolice ;
    echr:hasProceedingStartDate "1995-04-05"^^xsd:date ;
    echr:hasSupportingQuote "Officer J.K. testified in the criminal investigation instituted against the applicant, that they had received information that the “white Golf” had left “the place\", which meant that it had left Pik Bar ."^^xsd:string .

doc:final_costs_order_2001_10_11 a echr:DomesticProceeding ;
    rdfs:label "District Court ordered payment of additional costs and proceedings finally concluded"@en ;
    echr:followsProceeding doc:appeals_after_retrial_2001_03_12_2001_05_09 ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
    echr:hasDecisionDate "2001-10-11"^^xsd:date ;
    echr:hasParticipation doc:part_final_costs_order_applicant_2001_10_11,
        doc:part_final_costs_order_court_2001_10_11 ;
    echr:hasSupportingQuote "Lastly, on 11 October 2001 the Slovenj Gradec District Court ordered the applicant to pay an additional sum to cover the costs of one of the witnesses heard during the proceedings. On that day, the proceedings were “finally concluded” ( pravnomočno končan postopek )."@en ;
    echr:isFinalDomesticDecision true .

doc:mia_report_submitted_1995_11_15 a echr:AdministrativeAction ;
    rdfs:label "MIA submitted report to the Public Prosecutor"@en ;
    echr:hasCourt doc:miaOffice ;
    echr:hasParticipation doc:part_mia_report_mia_1995_11_15,
        doc:part_mia_report_prosecutor_1995_11_15 ;
    echr:hasProceedingStartDate "1995-11-15"^^xsd:date ;
    echr:hasSupportingQuote "Subsequently, two reports concerning the relevant police operation were submitted to the Public Prosecutor: one by the MIA on 15 November 1995 and one by the Slovenj Gradec Police on 5 February 1996."@en .

doc:mia_working_group_appointed_1995_04_20 a echr:AdministrativeAction ;
    rdfs:label "MIA appointed a working group to assess lawfulness of procedures"@en ;
    echr:hasCourt doc:miaOffice ;
    echr:hasParticipation doc:part_mia_working_group_mia_1995_04_20 ;
    echr:hasProceedingStartDate "1995-04-20"^^xsd:date ;
    echr:hasSupportingQuote "It transpires from the MIA’s report that, on 20 April 1995, the MIA had appointed a “working group” ( delovna skupina ) consisting of officers from the Slovenj Gradec Police and the MIA to assess the lawfulness of the procedures carried out by the Special Unit and the Slovenj Gradec Police."@en .

