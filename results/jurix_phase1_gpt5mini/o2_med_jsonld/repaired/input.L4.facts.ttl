doc:police_complaint_against_applicant_1995_04_12 a echr:AdministrativeAction ;
    rdfs:label "Slovenj Gradec Police lodged a criminal complaint against the applicant"@en ;
    echr:hasCourt doc:slovenjGradecPolice ;
    echr:hasParticipation doc:part_police_complaint_against_applicant_applicant_1995_04_12,
        doc:part_police_complaint_against_applicant_police_1995_04_12 ;
    echr:hasProceedingStartDate "1995-04-12"^^xsd:date ;
    echr:hasSupportingQuote "On 12 April 1995 the Slovenj Gradec Police lodged a criminal complaint against the applicant for the criminal offence of “obstructing an official in the course of his duties” under section 302, paragraph 4-1 of the Slovenian Criminal Code, which referred to the same incident as the applicant’s criminal complaint."@en .

doc:police_report_submitted_1996_02_05 a echr:AdministrativeAction ;
    rdfs:label "Slovenj Gradec Police submitted report to the Public Prosecutor"@en ;
    echr:hasCourt doc:slovenjGradecPolice ;
    echr:hasParticipation doc:part_mia_report_prosecutor_1995_11_15,
        doc:part_police_report_police_1996_02_05 ;
    echr:hasProceedingStartDate "1996-02-05"^^xsd:date ;
    echr:hasSupportingQuote "Subsequently, two reports concerning the relevant police operation were submitted to the Public Prosecutor: one by the MIA on 15 November 1995 and one by the Slovenj Gradec Police on 5 February 1996."@en .

doc:proc_deposition_added_1995_06_20 a echr:AdministrativeAction ;
    rdfs:label "Applicant's deposition added to the file"@en ;
    echr:hasCourt doc:slovenjGradecPublicProsecutorOffice ;
    echr:hasParticipation doc:part_deposition_added_applicant_1995_06_20 ;
    echr:hasProceedingStartDate "1995-06-20"^^xsd:date ;
    echr:hasSupportingQuote "which he did on 20 June 1995."@en .

doc:proc_dismissal_applicant_complaint_1997_01_17 a echr:ProsecutorialReview ;
    rdfs:label "Public Prosecutor decision dismissing the applicant's criminal complaint"@en ;
    echr:hasCourt doc:slovenjGradecPublicProsecutorOffice ;
    echr:hasDecisionDate "1997-01-17"^^xsd:date ;
    echr:hasParticipation doc:part_appeal_applicant_1997_05_12,
        doc:part_appeal_prosecutor_1997_05_12 ;
    echr:hasSupportingQuote "On 17 January 1997 the Public Prosecutor issued a decision dismissing the applicant’s criminal complaint. It was served on the applicant’s lawyer on 22 January 1997."@en .

doc:proc_request_deposition_1995_06_15 a echr:ProsecutorialReview ;
    rdfs:label "Public Prosecutor asked applicant's lawyer to add deposition to the file"@en ;
    echr:hasCourt doc:slovenjGradecPublicProsecutorOffice ;
    echr:hasParticipation doc:part_proc_request_deposition_applicant_1995_06_15,
        doc:part_proc_request_deposition_prosecutor_1995_06_15 ;
    echr:hasProceedingStartDate "1995-06-15"^^xsd:date ;
    echr:hasSupportingQuote "On 15 June 1995 the Slovenj Gradec District Public Prosecutor’s Office ( Okrožno državno tožilstvo ) asked the applicant’s lawyer to add his client’s deposition to the file, which he did on 20 June 1995."@en .

doc:proc_request_identify_officers_1995_07_14 a echr:ProsecutorialReview ;
    rdfs:label "Public Prosecutor requested police to identify officers"@en ;
    echr:hasCourt doc:slovenjGradecPublicProsecutorOffice ;
    echr:hasParticipation doc:part_proc_request_deposition_prosecutor_1995_06_15,
        doc:part_proc_request_identify_officers_police_1995_07_14 ;
    echr:hasProceedingStartDate "1995-07-14"^^xsd:date ;
    echr:hasSupportingQuote "In the meantime, on 14 July 1995, the Slovenj Gradec District Public Prosecutor (the “Public Prosecutor”) requested the Slovenj Gradec Police to identify the officers who had participated in the procedure against the applicant and to conduct an interview with them."@en .

doc:appeal_by_prosecutor_1997_05_12 a echr:DomesticProceeding ;
    rdfs:label "Public Prosecutor appealed the District Court decision"@en ;
    echr:followsProceeding doc:judicial_decision_no_investigation_1997_05_08 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasParticipation doc:part_appeal_applicant_1997_05_12,
        doc:part_appeal_prosecutor_1997_05_12 ;
    echr:hasProceedingStartDate "1997-05-12"^^xsd:date ;
    echr:hasSupportingQuote "On 12 May 1997 the Public Prosecutor appealed against this decision."@en .

doc:appeal_decision_open_investigation_1997_12_04 a echr:DomesticProceeding ;
    rdfs:label "Maribor Higher Court upheld appeal and opened criminal investigation"@en ;
    echr:followsProceeding doc:appeal_by_prosecutor_1997_05_12 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "1997-12-04"^^xsd:date ;
    echr:hasParticipation doc:part_appeal_applicant_1997_05_12,
        doc:part_appeal_decision_court_1997_12_04,
        doc:part_appeal_prosecutor_1997_05_12 ;
    echr:hasSupportingQuote "On 4 December 1997 the Maribor Higher Court upheld her appeal finding that, despite the shortcomings mentioned in the first-instance decision, there were sufficient grounds for suspicion that the applicant had committed the alleged offence. Accordingly, it changed the first-instance court’s decision and opened a criminal investigation against the applicant."@en .

doc:appeals_after_retrial_2001_03_12_2001_05_09 a echr:DomesticProceeding ;
    rdfs:label "Appeals after retrial (applicant and prosecutor)"@en ;
    echr:followsProceeding doc:retrial_conviction_2001_02_12 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasParticipation doc:part_appeals_after_retrial_applicant_2001_03_12,
        doc:part_appeals_after_retrial_court_2001_05_09,
        doc:part_retrial_hearings_prosecutor_2000_12_15 ;
    echr:hasProceedingStartDate "2001-03-12"^^xsd:date ;
    echr:hasSupportingQuote "On 12 March 2001 the Public Prosecutor appealed against this judgment and applied for a heavier sentence. The applicant also appealed. On 9 May 2001 the Maribor Higher Court upheld the conviction but amended the judgment with respect to the costs of the proceedings."@en .

doc:indictment_filed_1998_12_28 a echr:DomesticProceeding ;
    rdfs:label "Public Prosecutor filed an indictment against the applicant"@en ;
    echr:followsProceeding doc:investigation_concluded_exclusion_decision_1998_03_17 ;
    echr:hasCourt doc:slovenjGradecPublicProsecutorOffice ;
    echr:hasParticipation doc:part_indictment_applicant_1998_12_28,
        doc:part_indictment_prosecutor_1998_12_28 ;
    echr:hasProceedingStartDate "1998-12-28"^^xsd:date ;
    echr:hasSupportingQuote "On 28 December 1998 the Public Prosecutor filed an indictment against the applicant for “attempting to obstruct an official in the course of his duties” ( poskus kaznivega dejanja preprečitve uradnega dejanja uradni osebi )."@en .

doc:investigation_concluded_exclusion_decision_1998_03_17 a echr:DomesticProceeding ;
    rdfs:label "Investigating judge concluded the criminal investigation and ordered exclusion of certain documents"@en ;
    echr:followsProceeding doc:investigation_interviews_1998_02_19_1998_03_10 ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
    echr:hasDecisionDate "1998-03-17"^^xsd:date ;
    echr:hasParticipation doc:part_indictment_applicant_1998_12_28,
        doc:part_investigation_concluded_court_1998_03_17 ;
    echr:hasSupportingQuote "On 17 March 1998 the criminal investigation was concluded with the investigating judge’s decision ordering the exclusion of certain documents from the case-file in accordance with section 83, paragraph 3, of the Criminal Procedure Act."@en .

doc:investigation_interviews_1998_02_19_1998_03_10 a echr:DomesticProceeding ;
    rdfs:label "Investigating judge interviewed officers (five officers, M.J. and A.K.)"@en ;
    echr:followsProceeding doc:appeal_decision_open_investigation_1997_12_04 ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasParticipation doc:part_indictment_applicant_1998_12_28,
        doc:part_investigation_interviews_court_1998_02_19,
        doc:part_investigation_interviews_police_1998_02_19 ;
    echr:hasProceedingStartDate "1998-02-19"^^xsd:date ;
    echr:hasSupportingQuote "Between 19 February 1998 and 10 March 1998 the investigating judge interviewed five officers from the Slovenj Gradec Police who had participated in the operation, the officer M.J., who had been responsible for the officers of the Special Unit, and A.K., who had allegedly witnessed the incident."@en .

doc:judicial_decision_no_investigation_1997_05_08 a echr:DomesticProceeding ;
    rdfs:label "District Court decided not to open a criminal investigation"@en ;
