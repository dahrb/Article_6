    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "Following the institution of an investigation against the applicant in March 1995"@en .

doc:lift_freeze_drydock_1996_05 a echr:AdministrativeAction ;
    rdfs:label "order lifting freeze on drydock May 1996"@en ;
    echr:hasCourt doc:prosecutorOfficeNizhniy ;
    echr:hasDecisionDate "1996-05"^^xsd:gYearMonth ;
    echr:hasParticipation doc:part_lift_drydock_applicant_1996 ;
    echr:hasSupportingQuote "It appears that the order freezing the drydock was lifted in May 1996, as it belonged to a Norwegian company “Aroko”."@en .

doc:local_electoral_committee_decision_1998_04_01 a echr:AdministrativeAction ;
    rdfs:label "local electoral committee decision 1 April 1998"@en ;
    echr:hasCourt doc:localElectoralCommittee ;
    echr:hasDecisionDate "1998-04-01"^^xsd:date ;
    echr:hasParticipation doc:part_electoral_1998_04_01_applicant,
        doc:part_electoral_1998_04_01_committee ;
    echr:hasSupportingQuote "On 1 April 1998 the local electoral committee declared the elections invalid on the ground of irregularities committed during the campaign by some candidates, including the applicant."@en .

doc:order_amended_version_1998_07_08 a echr:AdministrativeAction ;
    rdfs:label "Regional Court ordered applicant be given amended judgment 8 July 1998"@en ;
    echr:hasCourt doc:nizhniyRegionalCourt ;
    echr:hasDecisionDate "1998-07-08"^^xsd:date ;
    echr:hasParticipation doc:part_order_amended_applicant_1998 ;
    echr:hasSupportingQuote "It appears that on 8 July 1998 the Regional Court ordered that the applicant should be given the amended version, but he claims that he did not receive it."@en .

doc:port_transfer_1996_01_19_unfreeze_stavanger a echr:AdministrativeAction ;
    rdfs:label "Stavanger freed from arrest 19 January 1996"@en ;
    echr:hasCourt doc:prosecutorOfficeNizhniy ;
    echr:hasDecisionDate "1996-01-19"^^xsd:date ;
    echr:hasParticipation doc:part_freeze_applicant_1995,
        doc:part_freeze_prosecutor_1995 ;
    echr:hasSupportingQuote "On 19 January 1996 the Stavanger was freed from arrest - and on 11 March 1996 the proceeds from the ship sale were frozen on the order of the Nizhniy Novgorod prosecutor’s office."@en .

doc:quash_conviction_1999_02 a echr:AdministrativeAction ;
    rdfs:label "quashing of 1982 conviction February 1999"@en ;
    echr:hasCourt doc:prosecutorOfficeNizhniy ;
    echr:hasDecisionDate "1999-02"^^xsd:gYearMonth ;
    echr:hasParticipation doc:part_quash_applicant_1999,
        doc:part_quash_prosecutor_1999 ;
    echr:hasSupportingQuote "In February 1999 the applicant’s first (1982) conviction was quashed, and the file in that case was closed by the Nizhniy Novgorod regional prosecutor’s office."@en .

doc:received_copy_1998_06_03 a echr:AdministrativeAction ;
    rdfs:label "applicant received copy of trial judgment 3 June 1998"@en ;
    echr:hasCourt doc:nizhniyRegionalCourt ;
    echr:hasDecisionDate "1998-06-03"^^xsd:date ;
    echr:hasParticipation doc:part_received_copy_applicant_1998 ;
    echr:hasSupportingQuote "The applicant received a copy of the trial court judgment on 3 June 1998."@en .

doc:regional_court_judgment_1998_05_27 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court judgment 27 May 1998"@en ;
    echr:followsProceeding doc:regional_court_retrial_1998_03_30 ;
    echr:hasCourt doc:nnRegionalCourt ;
    echr:hasDecisionDate "1998-05-27"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_regjud_1997_04_21_applicant,
        doc:part_regjud_1997_04_21_prosecution ;
    echr:hasSupportingQuote "On 27 May 1998 the Nizhniy Novgorod Regional Court found the applicant guilty on charges of misappropriation and embezzlement, larceny, bribery and attempt not to return money from abroad. In total, the court sentenced him to six years in prison and confiscation of some property."@en .

doc:regional_court_reject_requests_1998_05_19 a echr:DomesticProceeding ;
    rdfs:label "Regional Court rejection of requests 19 May 1998"@en ;
    echr:followsProceeding doc:regional_court_detention_order_1998_04_02 ;
    echr:hasCourt doc:nnRegionalCourt ;
    echr:hasDecisionDate "1998-05-19"^^xsd:date ;
    echr:hasParticipation doc:part_rejectreq_1998_05_19_applicant,
        doc:part_rejectreq_1998_05_19_court ;
    echr:hasSupportingQuote "On 19 May the applicant’s “civil defender” requested the Regional Court to dismiss the judge presiding in the case for bias. On the same day the applicant requested to admit Mrs Moskalenko as his lawyer in the trial because one of his lawyers was on sick leave. Both requests were rejected by the Regional Court."@en .

doc:regional_judgment_1997_04_21 a echr:DomesticProceeding ;
    rdfs:label "judgment by Nizhniy Novgorod Regional Court 21 April 1997"@en ;
    echr:hasCourt doc:nizhniyRegionalCourt ;
    echr:hasDecisionDate "1997-04-21"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasParticipation doc:part_1997_applicant,
        doc:part_1997_oka,
        doc:part_1997_prosecutor ;
    echr:hasSupportingQuote "By a judgment of the Nizhniy Novgorod Regional Court of 21 April 1997, later quashed by the Supreme Court, the applicant was ordered to pay the “Oka” damages in the amount that had been transferred to it previously."@en .

doc:release_2000_10 a echr:EnforcementAction ;
    rdfs:label "applicant released from detention October 2000"@en ;
    echr:hasDecisionDate "2000-10"^^xsd:gYearMonth ;
    echr:hasParticipation doc:part_release_applicant_2000 ;
    echr:hasSupportingQuote "In October 2000 the applicant was released from detention."@en .

doc:supreme_court_cassation_1998_08_10 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court cassation decision 10 August 1998"@en ;
    echr:followsProceeding doc:trial_second_1998_05_27 ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasDecisionDate "1998-08-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasParticipation doc:part_supreme_applicant_1998 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 10 August 1998 the Supreme Court confirmed the judgment of the Nizhniy Novgorod Regional Court, with some alterations."@en ;
    echr:isFinalDomesticDecision true .

doc:supreme_court_reply_1998_05_19 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court reply 19 May 1998"@en ;
    echr:followsProceeding doc:appeal_detention_to_supreme_1998_04_23 ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasDecisionDate "1998-05-19"^^xsd:date ;
    echr:hasParticipation doc:part_supremereply_1998_05_19_applicant,
        doc:part_supremereply_1998_05_19_prosecution ;
    echr:hasSupportingQuote "The reply from the Supreme Court, dated 19 May 1998, stated that the national law did not allow appeals against that type of trial court orders separately from appeals against judgments."@en .

doc:transfer_to_oka_1996_05_18 a echr:AdministrativeAction ;
    rdfs:label "unfreeze account and transfer to Oka 18 May 1996"@en ;
    echr:hasCourt doc:prosecutorOfficeNizhniy ;
    echr:hasDecisionDate "1996-05-18"^^xsd:date ;
    echr:hasParticipation doc:part_transfer_oka_applicant_1996,
        doc:part_transfer_oka_prosecutor_1996 ;
    echr:hasSupportingQuote "On 18 May 1996 the Nizhniy Novgorod prosecutor’s office unfroze the account and transferred the money to the yard."@en .

doc:appeal_detention_to_supreme_1998_04_23 a echr:DomesticProceeding ;
    rdfs:label "appeal to Supreme Court against detention order 23 April 1998"@en ;
    echr:followsProceeding doc:regional_court_detention_order_1998_04_02 ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasParticipation doc:part_appeal_detention_1998_04_23_applicant,
        doc:part_appeal_detention_1998_04_23_prosecution ;
    echr:hasProceedingStartDate "1998-04-23"^^xsd:date ;
    echr:hasSupportingQuote "On 23 April 1998 the applicant’s “civil defender”, who participated in the process with a status similar to that of a lawyer, lodged with the Supreme Court an appeal against the court order of 2 April to detain the applicant."@en .

