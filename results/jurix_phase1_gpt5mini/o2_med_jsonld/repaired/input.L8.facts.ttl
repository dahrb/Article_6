        doc:part_charging_prosecution_1995_03_07 ;
    echr:hasProceedingStartDate "1995-03-07"^^xsd:date ;
    echr:hasSupportingQuote "The applicant, together with another person, was charged with embezzlement and other economic crimes on 7 March 1995."@en .

doc:freeze_proceeds_1996_03_11 a echr:AdministrativeAction ;
    rdfs:label "freeze of proceeds from ship sale 11 March 1996"@en ;
    echr:hasCourt doc:prosecutorOfficeNizhniy ;
    echr:hasDecisionDate "1996-03-11"^^xsd:date ;
    echr:hasParticipation doc:part_freeze_proceeds_applicant_1996,
        doc:part_freeze_proceeds_prosecutor_1996 ;
    echr:hasSupportingQuote "on 11 March 1996 the proceeds from the ship sale were frozen on the order of the Nizhniy Novgorod prosecutor’s office."@en .

doc:freeze_property_1995_10_05 a echr:AdministrativeAction ;
    rdfs:label "freeze of Stavanger and drydock 5 October 1995"@en ;
    echr:hasCourt doc:prosecutorOfficeNizhniy ;
    echr:hasDecisionDate "1995-10-05"^^xsd:date ;
    echr:hasParticipation doc:part_freeze_applicant_1995,
        doc:part_freeze_prosecutor_1995 ;
    echr:hasSupportingQuote "on 5 October 1995 property belonging to the applicant - the ship Stavanger and a floating drydock - was frozen on the order of the Nizhniy Novgorod prosecutor’s office."@en .

doc:investigation_1995_03 a echr:DomesticProceeding ;
