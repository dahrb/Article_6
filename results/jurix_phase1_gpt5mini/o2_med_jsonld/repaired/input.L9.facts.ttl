doc:admin_applicant_partial_statement_2010_11_29 a echr:AdministrativeAction ;
    rdfs:label "On 29 November 2010 the applicant gave a partial statement."@en ;
    echr:hasCourt doc:authInvestigator ;
    echr:hasDecisionDate "2010-11-29"^^xsd:date ;
    echr:hasParticipation doc:participation_admin_partial_statement_applicant_2010_11_29 ;
    echr:hasSupportingQuote "On 29 November 2010 the applicant gave a partial statement, alleging that on 12 August 2010 the governor of Rustavi Prison no. 6 had asked him to withdraw his application to the Court, in exchange for better conditions in prison."@en .

doc:admin_forensic_concluded_2010_09_03 a echr:AdministrativeAction ;
    rdfs:label "On 3 September 2010 the forensic medical examination was concluded."@en ;
    echr:followsProceeding doc:admin_forensic_commission_2010_08_31 ;
    echr:hasCourt doc:authNationalForensicBureau ;
    echr:hasDecisionDate "2010-09-03"^^xsd:date ;
    echr:hasParticipation doc:participation_admin_forensic_concluded_applicant_2010_09_03,
        doc:participation_admin_forensic_concluded_nfb_2010_09_03 ;
    echr:hasSupportingQuote "On 3 September 2010 the forensic medical examination was concluded. An expert from the National Forensic Bureau found that the applicant had a trace of a small abrasion in the area of his chin, approximately a month old, possibly caused by a hard object. A small wound, no more than three days old, was observed on the applicant’s shin. The report noted that both injuries were located \"within the applicant’s own reach\"."@en .

doc:admin_investigator_approached_2010_08_31 a echr:AdministrativeAction ;
    rdfs:label "On 31 August 2010 the applicant and his cellmate were approached by the investigator, but both refused to be questioned in the absence of their lawyers."@en ;
    echr:hasCourt doc:authInvestigator ;
    echr:hasDecisionDate "2010-08-31"^^xsd:date ;
    echr:hasParticipation doc:participation_admin_investigator_approach_applicant_2010_08_31,
