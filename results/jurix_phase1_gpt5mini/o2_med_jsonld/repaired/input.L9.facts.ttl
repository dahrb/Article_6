        doc:participation_admin_investigator_approach_investigator_2010_08_31 ;
    echr:hasSupportingQuote "On 31 August 2010 the applicant and his cellmate were approached by the investigator, but both refused to be questioned in the absence of their lawyers."@en .

doc:admin_question_doctor_2010_09_02 a echr:AdministrativeAction ;
    rdfs:label "On 2 September 2010 the investigator questioned a doctor from the prison hospital."@en ;
    echr:hasCourt doc:authInvestigator ;
    echr:hasDecisionDate "2010-09-02"^^xsd:date ;
    echr:hasParticipation doc:participation_admin_question_doctor_investigator_2010_09_02 ;
    echr:hasSupportingQuote "On 2 September 2010 the investigator questioned a doctor from the prison hospital. The doctor stated that she had met the applicant on 30 August 2010. No visible signs of injuries had been observed, nor had the applicant complained in this regard."@en .

doc:adminaction_reject_confrontation_applicant_20051103 a echr:AdministrativeAction ;
