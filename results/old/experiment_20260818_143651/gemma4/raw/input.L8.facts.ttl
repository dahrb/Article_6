doc:trial_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Trial at Nizhniy Novgorod Regional Court"@en ;
    echr:hasAdjournment doc:adjournment_request_1 ;
    echr:hasCourt doc:authority_1 ;
