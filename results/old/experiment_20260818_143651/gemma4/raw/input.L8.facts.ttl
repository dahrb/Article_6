        echr:Party ;
    rdfs:label "the applicant"^^xsd:string,
        "the applicant"@en ;
    echr:hasPersonName "the applicant"@en ;
    echr:hasSourceParagraph "1"@en ;
    echr:hasSupportingQuote "the applicant"@en ;
    echr:isAnonymised true .

