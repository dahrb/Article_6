doc:trial_1 a echr:DomesticProceeding ;
    rdfs:label "First trial of Andrey Klimentyev"@en ;
    echr:hasCourt doc:authority_1 ;
    echr:hasDecisionDate "1997-04-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
