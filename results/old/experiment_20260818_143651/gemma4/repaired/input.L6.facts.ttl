doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Appeal at Commercial Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:commercialCourt ;
    echr:hasDecisionDate "2007-12-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "21"^^xsd:string ;
    echr:hasSupportingQuote "a three-judge bench of the Commercial Court rejected the complaint submitted by the applicant company"^^xsd:string .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "Arbitration Proceeding"^^xsd:string ;
    echr:hasCourt doc:arbitrationTribunal ;
    echr:hasProceedingStartDate "2008-09-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "25"^^xsd:string ;
    echr:hasSupportingQuote "the applicant company lodged a claim with the Arbitration Tribunal"^^xsd:string .

doc:proceeding_arbitration_1 a echr:DomesticProceeding ;
    rdfs:label "Arbitration request 2008"^^xsd:string ;
    echr:hasCourt doc:arbitrationTribunal ;
    echr:hasDecisionDate "2008-10-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeOther ;
    echr:hasSourceParagraph "26"^^xsd:string ;
    echr:hasSupportingQuote "the President of the Arbitration Tribunal informed the applicant company that its request to start arbitration proceedings would not be granted"@en .

doc:proceeding_cassation_1 a echr:DomesticProceeding ;
    rdfs:label "Court of Cassation 2009"^^xsd:string ;
    echr:followsProceeding doc:proceeding_appeal_1 ;
    echr:hasCourt doc:courtOfCassation ;
    echr:hasDecisionDate "2009-09-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "38"^^xsd:string ;
    echr:hasSupportingQuote "the Court of Cassation declared the applicant company’s appeal on points of law inadmissible"@en ;
    echr:isFinalDomesticDecision true .

