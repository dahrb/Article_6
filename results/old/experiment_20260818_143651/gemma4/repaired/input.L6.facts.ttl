doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "First Instance Claim at Commercial Court"^^xsd:string,
        "Claim by Scholz AG against Safaryan LLC"@en ;
    echr:hasCourt doc:commercialCourtArmenia ;
    echr:hasDecisionDate "2007-11-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingStartDate "2007-01-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "19"^^xsd:string,
        "14"@en ;
    echr:hasSupportingQuote "the Commercial Court granted the request and decided to leave the applicant company’s claim and the counterclaim lodged by the LLC unexamined"^^xsd:string,
        "On 15 January 2007 the applicant company lodged a claim with the Commercial Court against the LLC"@en .

