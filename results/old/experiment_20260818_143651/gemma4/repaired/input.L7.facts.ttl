<https://growgraph.dev/doc/69a89791a8a3> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:7"^^xsd:string .

doc:acquittal_decision_1 a echr:DomesticProceeding ;
    rdfs:label "acquittal on counts 2 and 4"@en ;
    echr:followsProceeding doc:trial_proceeding_1 ;
    echr:hasCourt doc:trial_court_1 ;
    echr:hasOutcome echr:OutcomeAcquittal ;
    echr:hasSourceParagraph "2"@en ;
    echr:hasSupportingQuote "the judge ruled that there was insufficient evidence as a matter of law to support a conviction on counts 2 and 4 and that the applicant should be acquitted"@en .

doc:bail_review_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "High Court bail review"@en ;
    echr:followsProceeding doc:trial_proceeding_1 ;
    echr:hasCourt doc:high_court_1 ;
    echr:hasDecisionDate "1999-03-26"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeOther ;
    echr:hasSourceParagraph "8"@en ;
    echr:hasSupportingQuote "An application was made to the High Court to review bail on 26 March 1999. It was refused."@en .

doc:house_of_lords_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "petition for leave to appeal to the House of Lords"^^xsd:string ;
    echr:followsProceeding doc:appeal_proceeding_1 ;
