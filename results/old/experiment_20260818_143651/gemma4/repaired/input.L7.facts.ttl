doc:pre_trial_detention_1 a echr:PreTrialDetention ;
    rdfs:label "detention at Belmarsh prison"@en ;
    echr:hasCustodialMeasure echr:MeasureRemandInCustody ;
    echr:hasDetainee doc:applicant_1 ;
    echr:hasDetentionStartDate "1999-03-25"^^xsd:date ;
    echr:hasSourceParagraph "7"@en ;
    echr:hasSupportingQuote "bail should be withdrawn... he would be held in the hospital wing of Belmarsh prison"@en .

