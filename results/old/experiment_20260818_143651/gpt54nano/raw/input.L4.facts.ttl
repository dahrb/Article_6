    echr:hasSourceParagraph "43"^^xsd:string ;
    echr:hasSupportingQuote "On 17 March 1998 the criminal investigation was concluded with the investigating judge’s decision ordering the exclusion of certain documents from the case-file in accordance with section 83, paragraph 3, of the Criminal Procedure Act."^^xsd:string .

doc:conviction_retrial_judgment_2001_02_12 a echr:DomesticProceeding ;
    rdfs:label "By a judgment of 12 February 2001, the Slovenj Gradec District Court convicted the applicant as charged."@en ;
    echr:followsProceeding doc:retrial_hearings_2001_12_15_and_2001_02_12 ;
    echr:hasSourceParagraph "48"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of 12 February 2001, the Slovenj Gradec District Court convicted the applicant as charged and sentenced him to 3 months’ imprisonment, suspended for 3 years."^^xsd:string .

