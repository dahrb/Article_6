doc:commercial_court_amended_claim_1 a echr:DomesticProceeding ;
    rdfs:label "On 2 October 2007 the applicant company amended its initial claim, seeking to recover a total of USD 1,516,442 and EUR 116,600 from the LLC, including the principal debt, the loan and interest on both."@en ;
    echr:followsProceeding doc:commercial_court_claim_1 ;
    echr:hasProceedingStartDate "2007-10-02"^^xsd:date ;
    echr:hasSourceParagraph "15"^^xsd:string ;
    echr:hasSupportingQuote "On 2 October 2007 the applicant company amended its initial claim, seeking to recover a total of USD 1,516,442 and EUR 116,600 from the LLC, including the principal debt, the loan and interest on both."^^xsd:string .

<http://example.org/base/cd.arbitration_refusal_to_start_2008_10_07> a echr:DomesticAuthority,
        echr:DomesticProceeding ;
    rdfs:label "On 7 October 2008 the President of the Arbitration Tribunal informed the applicant company that its request to start arbitration proceedings would not be granted."@en ;
    echr:hasDecisionDate "2008-10-07"^^xsd:date ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasProceedingStartDate "2008-10-07"^^xsd:date ;
