    echr:hasSourceParagraph "30"^^xsd:string ;
    echr:hasSupportingQuote "On 13 March 2009 the District Court accepted the case for examination."^^xsd:string .

<http://example.org/base/cd.district_court_leave_unexamined_2009_06_16> a echr:DomesticProceeding ;
    rdfs:label "On 16 June 2009 the District Court decided to leave the claim lodged by the applicant company unexamined."@en ;
    echr:followsProceeding <http://example.org/base/cd.district_court_acceptance_2009_03_13> ;
    echr:hasDecisionDate "2009-06-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasProceedingStartDate "2009-03-13"^^xsd:date ;
    echr:hasSourceParagraph "33"^^xsd:string ;
    echr:hasSupportingQuote "On 16 June 2009 the District Court decided to leave the claim lodged by the applicant company unexamined, finding that the refusal to start arbitration proceedings stated in the letter of 7 October 2008 did not substantiate the fact that there was no possibility of applying to the Arbitration Tribunal."^^xsd:string .

<http://example.org/base/cd.yerevan_civil_court_claim_acceptance_2008_11_12> a echr:DomesticProceeding ;
    rdfs:label "On 12 November 2008 the Yerevan Civil Court accepted the applicant company’s claim for examination and scheduled a preparatory hearing."@en ;
