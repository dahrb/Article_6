    echr:hasSupportingQuote "On 7 October 2008 the President of the Arbitration Tribunal informed the applicant company that its request to start arbitration proceedings would not be granted."^^xsd:string ;
    echr:isFinalDomesticDecision true .

<http://example.org/base/cd.court_of_appeal_upheld_2009_07_21> a echr:DomesticProceeding ;
    rdfs:label "On 21 July 2009 the Civil Court of Appeal upheld the decision of 16 June 2009."@en ;
    echr:followsProceeding <http://example.org/base/cd.district_court_leave_unexamined_2009_06_16> ;
    echr:hasDecisionDate "2009-07-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasProceedingStartDate "2009-06-25"^^xsd:date ;
    echr:hasSourceParagraph "36"^^xsd:string ;
    echr:hasSupportingQuote "On 21 July 2009 the Civil Court of Appeal upheld the decision of 16 June 2009."^^xsd:string .

<http://example.org/base/cd.district_court_acceptance_2009_03_13> a echr:DomesticProceeding ;
    rdfs:label "On 13 March 2009 the District Court accepted the case for examination."@en ;
    echr:followsProceeding <http://example.org/base/cd.yerevan_civil_court_claim_acceptance_2008_11_12> ;
    echr:hasDecisionDate "2009-03-13"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
