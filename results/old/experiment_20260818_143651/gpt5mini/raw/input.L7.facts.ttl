doc:domestic_proceeding_house_of_lords_leave_2000 a echr:DomesticProceeding ;
    rdfs:label "On 15 June 2000, the House of Lords refused the petition for leave to appeal."@en ;
    echr:followsProceeding doc:domestic_proceeding_court_of_appeal_2000 ;
    echr:hasDecisionDate "2000-06-15"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasSourceParagraph "10"^^xsd:string ;
    echr:hasSupportingQuote "On 15 June 2000, the House of Lords refused the petition for leave to appeal."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:high_court_bail_review_1999 a echr:DomesticProceeding ;
    rdfs:label "An application was made to the High Court to review bail"@en ;
    echr:followsProceeding doc:trial_domestic_proceeding_1999 ;
    echr:hasDecisionDate "1999-03-26"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasSourceParagraph "8"^^xsd:string ;
    echr:hasSupportingQuote "An application was made to the High Court to review bail on 26 March 1999. It was refused."@en .

doc:trial_between_8_february_and_1_april_1999_first_instance a echr:DomesticProceeding ;
    rdfs:label "In the trial which took place between 8 February and 1 April 1999, before Mr Justice Potts and a jury, the applicant was represented by senior and junior counsel and solicitors."@en ;
    echr:followsProceeding doc:indictmentChargedOnAnIndictmentWithFourCountsOfMurder ;
    echr:hasDecisionDate "1999-04-01"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasProceedingStartDate "1999-02-08"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "A"^^xsd:string ;
    echr:hasSupportingQuote "In the trial which took place between 8 February and 1 April 1999, before Mr Justice Potts and a jury, the applicant was represented by senior and junior counsel and solicitors."^^xsd:string,
        "The applicant is a Polish national, born in 1921 and currently serving a sentence of life imprisonment in HM Prison Gartree."^^xsd:string .

doc:domestic_proceeding_court_of_appeal_2000 a echr:DomesticProceeding ;
    rdfs:label "The applicant appealed against conviction to the Court of Appeal."@en ;
    echr:followsProceeding doc:domestic_proceeding_trial_1 ;
    echr:hasDecisionDate "2000-02-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "3"^^xsd:string,
        "4"^^xsd:string ;
    echr:hasSupportingQuote "In its judgment of 10 February 2000, the Court of Appeal rejected the applicant’s appeal."^^xsd:string,
        "The applicant appealed against conviction to the Court of Appeal."^^xsd:string .

doc:domestic_proceeding_trial_1 a echr:DomesticProceeding ;
    rdfs:label "the trial"@en ;
    echr:hasDecisionDate "1999-04-01"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "2"^^xsd:string ;
    echr:hasSupportingQuote "On 1 April 1999, the jury convicted the applicant of counts 1 and 3."^^xsd:string,
        "The applicant was sentenced to a mandatory term of life imprisonment."^^xsd:string .

doc:indictmentChargedOnAnIndictmentWithFourCountsOfMurder a echr:DomesticProceeding ;
    rdfs:label "The applicant was charged on an indictment with four counts of murder:"@en ;
    echr:followsProceeding doc:investigation_1996_interviews ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "A"^^xsd:string ;
    echr:hasSupportingQuote "The applicant was charged on an indictment with four counts of murder:"^^xsd:string .

doc:investigation_1996_interviews a echr:DomesticProceeding ;
    rdfs:label "On 1 and 3 April 1996, the applicant was interviewed by the British police concerning his activities in Domachevo during the German occupation."@en ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingStartDate "1996-04-01"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "A"^^xsd:string ;
    echr:hasSupportingQuote "On 1 and 3 April 1996, the applicant was interviewed by the British police concerning his activities in Domachevo during the German occupation."^^xsd:string .

doc:trial_domestic_proceeding_1999 a echr:DomesticProceeding ;
    rdfs:label "the trial"@en ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasSourceParagraph "1"^^xsd:string,
        "2"^^xsd:string,
        "6"^^xsd:string,
        "7"^^xsd:string ;
    echr:hasSupportingQuote "At the close of the prosecution case, the judge ruled that there was insufficient evidence as a matter of law to support a conviction on counts 2 and 4 and that the applicant should be acquitted."@en,
        "On 24 March 1999, the judge refused the application."@en,
        "On 25 March 1999, before the closing speeches were due to begin and a long adjournment over a weekend, the judge after consulting counsel decided to withdraw the applicant’s bail."@en,
        "On 8 February 1999, the judge ruled that the evidence of both witnesses was relevant and admissible and, on 26 February 1999, that it should go before the jury."@en .

