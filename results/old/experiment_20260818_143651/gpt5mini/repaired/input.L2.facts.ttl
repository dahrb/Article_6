@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/d18e0f08e34a/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/d18e0f08e34a> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:2"^^xsd:string .

doc:applicantsAttemptRecognitionOfEmployment a echr:DomesticProceeding ;
    rdfs:label "applicants attempted to obtain recognition of permanent employment by ESA (special German labour legislation)"@en ;
    echr:hasSourceParagraph "61"@en ;
    echr:hasSupportingQuote "The significant feature of the instant case is that the applicants, after having performed services at the premises of ESOC in Darmstadt for a considerable time on the basis of contracts with foreign firms, attempted to obtain recognition of permanent employment by ESA on the basis of the above-mentioned special German legislation for the regulation of the German labour market."@en .

doc:darmstadtProceeding rdfs:label "the applicants’ action under the German Provision of Labour (Temporary Staff) Act"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasSourceParagraph "45"^^xsd:string,
        "46"^^xsd:string ;
    echr:hasSupportingQuote "In the instant case the Darmstadt Labour Court concluded that the conditions under section 20(2) of the German Courts Act for finding that the applicants’ action was inadmissible were fulfilled."@en,
        "The German labour court regarded the applicants’ action under the German Provision of Labour (Temporary Staff) Act inadmissible as the defendant, ESA, had claimed immunity from jurisdiction in accordance with Article XV § 2 of the ESA Convention and Article IV § 1 of its Annex I."@en .

doc:domesticProceedingLabourCourtInstitutedByApplicants rdfs:label "labour court proceedings instituted by the applicants"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "39"^^xsd:string,
        "41"^^xsd:string ;
    echr:hasSupportingQuote "The applicants had access to the Darmstadt Labour Court, only to be told that their action was barred by operation of law."@en,
        "the labour court proceedings instituted by the applicants"@en .

doc:federalLabourCourtDecision rdfs:label "the decision of the Federal Labour Court in the case of Mr Waite and Mr Kennedy"@en ;
    echr:hasCourt doc:federalLabourCourt ;
    echr:hasOutcome echr:OutcomeUnknown ;
    echr:hasSourceParagraph "46"^^xsd:string ;
    echr:hasSupportingQuote "The Labour Court further referred to the decision of the Federal Labour Court in the case of Mr Waite and Mr Kennedy"@en .

doc:federal_labour_court_decision_10_nov_1993 rdfs:label "decision of the Federal Labour Court of 10 November 1993 in the case concerning Mr Waite and Mr Kennedy"@en ;
    echr:hasCourt doc:federalLabourCourt ;
    echr:hasDecisionDate "1993-11-10"^^xsd:date ;
    echr:hasSourceParagraph "41"^^xsd:string ;
    echr:hasSupportingQuote "the decision of the Federal Labour Court of 10 November 1993 in the case concerning Mr Waite and Mr Kennedy"@en .

doc:germanCourtsImmunityDecision rdfs:label "German courts applied immunity from jurisdiction to ESA (section 20(2) Courts Act)"@en ;
    echr:hasSourceParagraph "53"@en,
        "63"@en ;
    echr:hasSupportingQuote "in giving effect to the immunity from jurisdiction of ESA on the basis of section 20(2) of the Courts Act, the German courts did not exceed their margin of appreciation."@en,
        "the rule of immunity from jurisdiction, which the German courts applied to ESA in the present case, has a legitimate objective."@en .

doc:proceeding_applicants_vs_esa_1993 a echr:DomesticProceeding ;
    rdfs:label "proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "13"^^xsd:string,
        "15"^^xsd:string ;
    echr:hasSupportingQuote "In October and November 1993 the applicants instituted proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA."^^xsd:string,
        "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."^^xsd:string .

doc:proceeding_second_applicant_dismissal_ti_1993 a echr:DomesticProceeding ;
    rdfs:label "proceedings instituted by the second applicant against his dismissal by the company T.I."@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1994-09-06"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeSettled ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "17"^^xsd:string ;
    echr:hasSupportingQuote "a settlement had been reached in the Darmstadt Labour Court on 6 September 1994."^^xsd:string .

doc:federalLabourCourt a echr:DomesticAuthority ;
    rdfs:label "Federal Labour Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Federal Labour Court"@en ;
    echr:hasSourceParagraph "46"^^xsd:string ;
    echr:hasSupportingQuote "The Labour Court further referred to the decision of the Federal Labour Court in the case of Mr Waite and Mr Kennedy"@en .

doc:darmstadtLabourCourt a echr:DomesticAuthority ;
    rdfs:label "Darmstadt Labour Court"@en,
        "Darmstadt Labour Court ( Arbeitsgericht )"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Darmstadt Labour Court"@en,
        "Darmstadt Labour Court ( Arbeitsgericht )"@en .

