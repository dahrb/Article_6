doc:constitutional_court_application_2017 a echr:DomesticProceeding ;
    rdfs:label "individual application with the Constitutional Court"@en ;
    echr:followsProceeding doc:supreme_adm_13th_chamber_annulment_2017 ;
    echr:hasCourt doc:authorityConstitutionalCourt ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasProceedingStartDate "2017-09-11"^^xsd:date ;
    echr:hasSourceParagraph "41"^^xsd:string,
        "42"^^xsd:string ;
    echr:hasSupportingQuote "Noting that the applicant’s application had been submitted on 11 September 2017, after the expiry of the time-limit, the Constitutional Court declared the application inadmissible."@en,
        "On 11 September 2017, the applicant lodged an individual application with the Constitutional Court, alleging violations of his right to property and his right to a fair trial due to the non-enforcement of the final judgment annulling the sale of Viva TV-Radio Viva."@en ;
    echr:isFinalDomesticDecision true .

doc:proc_2008_transfer_management a echr:DomesticProceeding ;
    rdfs:label "On 18 September 2008, the Fund further resolved to transfer the management and control of all companies within the Erol Aksoy Group to itself, along with the rights of their shareholders, except for the entitlement to dividends."@en ;
    echr:followsProceeding doc:proc_2008_initiate_legal_proceedings ;
    echr:hasCourt doc:theFund ;
    echr:hasProceedingStartDate "2008-09-18"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "14"^^xsd:string ;
    echr:hasSupportingQuote "On 18 September 2008, the Fund further resolved to transfer the management and control of all companies within the Erol Aksoy Group to itself, along with the rights of their shareholders, except for the entitlement to dividends."@en .

doc:proc_2011_offer_jan13 a echr:DomesticProceeding ;
    rdfs:label "On 13 January 2011, the Fund decided to offer Viva TV-Radio Viva for sale again, setting the reserve price at USD 6,000,000."@en ;
    echr:followsProceeding doc:proc_2009_offer_nov5 ;
    echr:hasCourt doc:theFund ;
    echr:hasProceedingStartDate "2011-01-13"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "24"^^xsd:string ;
    echr:hasSupportingQuote "However, only company A. participated in the auction held on 8 February 2011."@en,
        "On 13 January 2011, the Fund decided to offer Viva TV-Radio Viva for sale again, setting the reserve price at USD 6,000,000."@en .

doc:proc_non_enforcement_fund_1 a echr:DomesticProceeding ;
    rdfs:label "failure to comply with the Supreme Administrative Court's judgments by national authorities (non-enforcement)"@en ;
    echr:followsProceeding doc:proc_supreme_admin_judgment_1 ;
    echr:hasCourt doc:authority_savings_deposit_insurance_fund_1 ;
    echr:hasInstanceLevel echr:LevelEnforcement ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "he complained that the national authorities had failed to comply with the Supreme Administrative Court’s judgments rendered in his favour in those proceedings."@en .

doc:proc_rectification_20160125 a echr:DomesticProceeding ;
    rdfs:label "Supreme Administrative Court rectification request decision"@en ;
    echr:followsProceeding doc:proc_general_assembly_20150707 ;
    echr:hasCourt doc:authoritySupremeAdministrativeCourt ;
    echr:hasDecisionDate "2016-01-25"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "30"^^xsd:string ;
    echr:hasSupportingQuote "On 25 January 2016, the Supreme Administrative Court rejected the Fund’s request for rectification, noting that the case had become final following the appeal and was no longer subject to rectification."^^xsd:string .

doc:rectification_13th_chamber_supreme_admin_court_2017 a echr:DomesticProceeding ;
    rdfs:label "On 30 June 2017, the 13 th Chamber of the Supreme Administrative Court granted the request"@en ;
    echr:followsProceeding doc:appeal_13th_chamber_supreme_admin_court_2014 ;
    echr:hasDecisionDate "2017-06-30"^^echr:PartialDate ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "37"^^xsd:string,
        "38"^^xsd:string ;
    echr:hasSupportingQuote "As a result, the court overturned the judgment of the 6th Chamber of the Istanbul Administrative Court dated 19 March 2014 and annulled the sale in question."^^xsd:string,
        "On 30 June 2017, the 13 th Chamber of the Supreme Administrative Court granted the request, referring to the ruling of the General Assembly of 7 July 2015 which had annulled the Fund’s decision of 13 January 2011 concerning the valuation of Viva TV-Radio Viva (see paragraph 29 above)."^^xsd:string .

doc:appeal_13th_chamber_supreme_admin_court_2014 a echr:DomesticProceeding ;
    rdfs:label "On an appeal by the applicant, the 13th Chamber of the Supreme Administrative Court upheld that decision on 9 December 2014."@en ;
    echr:followsProceeding doc:proceeding_administrative_court_2011 ;
    echr:hasDecisionDate "2014-12-09"^^echr:PartialDate ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "35"^^xsd:string ;
    echr:hasSupportingQuote "On an appeal by the applicant, the 13th Chamber of the Supreme Administrative Court upheld that decision on 9 December 2014."^^xsd:string .

doc:authorityConstitutionalCourt a echr:DomesticAuthority ;
    rdfs:label "Constitutional Court"@en ;
    echr:hasAuthorityName "Constitutional Court"@en ;
    echr:hasSourceParagraph "41"^^xsd:string ;
    echr:hasSupportingQuote "On 11 September 2017, the applicant lodged an individual application with the Constitutional Court, alleging violations of his right to property and his right to a fair trial due to the non-enforcement of the final judgment annulling the sale of Viva TV-Radio Viva."@en .

doc:authority_savings_deposit_insurance_fund_1 a echr:DomesticAuthority ;
    rdfs:label "the Savings Deposit Insurance Fund ( Tasarruf Mevduat Sigorta Fonu , hereinafter “the Fund”)"@en ;
    echr:hasAuthorityName "Savings Deposit Insurance Fund ( Tasarruf Mevduat Sigorta Fonu )"@en ;
    echr:hasSourceParagraph "6"^^xsd:string ;
    echr:hasSupportingQuote "the Banking Regulation and Supervision Board ... resolved to transfer the management and control of İktisat Bankası T.A.Ş. (hereinafter “İktisat Bank” or “the Bank”) to the Savings Deposit Insurance Fund ( Tasarruf Mevduat Sigorta Fonu , hereinafter “the Fund\")"@en .

doc:proc_2006_liquidation_protocol a echr:DomesticProceeding ;
    rdfs:label "On 9 May 2006, a debt liquidation protocol ( Borç Tasfiye Protokolü , hereinafter referred to as “the Liquidation Protocol”) was signed between the Fund (as creditor) and the Erol Aksoy Group (as debtor)."@en ;
    echr:hasCourt doc:theFund ;
    echr:hasProceedingStartDate "2006-05-09"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "9"^^xsd:string ;
    echr:hasSupportingQuote "On 9 May 2006, a debt liquidation protocol ( Borç Tasfiye Protokolü , hereinafter referred to as “the Liquidation Protocol”) was signed between the Fund (as creditor) and the Erol Aksoy Group (as debtor)."@en .

doc:proc_2007_establish_units a echr:DomesticProceeding ;
    rdfs:label "On 19 July 2007, the Fund decided to establish two economic and commercial units: one for Viva TV and the other for Radio Viva."@en ;
    echr:hasCourt doc:theFund ;
    echr:hasProceedingStartDate "2007-07-19"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "16"^^xsd:string ;
    echr:hasSupportingQuote "On 19 July 2007, the Fund decided to establish two economic and commercial units: one for Viva TV and the other for Radio Viva."@en .

doc:proc_2007_offer_sale_together a echr:DomesticProceeding ;
    rdfs:label "On 29 August 2007, the Fund resolved to offer both Viva TV and Radio Viva for sale together in a single tendering process, setting a reserve price of USD 8,000,000."@en ;
    echr:followsProceeding doc:proc_2007_establish_units ;
    echr:hasCourt doc:theFund ;
    echr:hasProceedingStartDate "2007-08-29"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "20"^^xsd:string ;
    echr:hasSupportingQuote "On 29 August 2007, the Fund resolved to offer both Viva TV and Radio Viva for sale together in a single tendering process, setting a reserve price of USD 8,000,000."@en .

doc:proc_2008_initiate_legal_proceedings a echr:DomesticProceeding ;
    rdfs:label "On 3 April 2008, the Fund ... resolved to initiate legal proceedings against all natural and legal person debtors within the Erol Aksoy Group and to proceed with the sale of assets, including those consolidated as an economic and commercial unit."@en ;
    echr:followsProceeding doc:proc_2006_liquidation_protocol ;
    echr:hasCourt doc:theFund ;
    echr:hasProceedingStartDate "2008-04-03"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "13"^^xsd:string ;
    echr:hasSupportingQuote "On 3 April 2008, the Fund concluded that the Erol Aksoy Group had failed to fulfil several commitments and obligations set out in the Liquidation Protocol, rendering the Protocol no longer effective for the recovery of public receivables. Consequently, the Fund decided to rely on its provisions concerning default. It resolved to initiate legal proceedings against all natural and legal person debtors within the Erol Aksoy Group and to proceed with the sale of assets, including those consolidated as an economic and commercial unit."@en .

doc:proc_2009_merge_units a echr:DomesticProceeding ;
    rdfs:label "On 9 July 2009, the Fund decided to merge the two economic and commercial units, thereby creating the Viva TV-Radio Viva Economic and Commercial Unit (hereinafter referred to as “Viva TV-Radio Viva”)."@en ;
    echr:followsProceeding doc:proc_2007_offer_sale_together ;
    echr:hasCourt doc:theFund ;
    echr:hasProceedingStartDate "2009-07-09"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "22"^^xsd:string ;
    echr:hasSupportingQuote "On 9 July 2009, the Fund decided to merge the two economic and commercial units, thereby creating the Viva TV-Radio Viva Economic and Commercial Unit (hereinafter referred to as “Viva TV-Radio Viva”)."@en .

doc:proc_2009_offer_nov5 a echr:DomesticProceeding ;
    rdfs:label "On 5 November 2009, the Fund resolved to offer Viva TV-Radio Viva for sale, establishing a reserve price of USD 6,000,000."@en ;
    echr:followsProceeding doc:proc_2009_merge_units ;
    echr:hasCourt doc:theFund ;
    echr:hasProceedingStartDate "2009-11-05"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "23"^^xsd:string ;
    echr:hasSupportingQuote "On 5 November 2009, the Fund resolved to offer Viva TV-Radio Viva for sale, establishing a reserve price of USD 6,000,000."@en .

doc:proc_admin_court_20110207 a echr:DomesticProceeding ;
    rdfs:label "proceedings before the administrative court"@en ;
    echr:hasCourt doc:authoritySupremeAdministrativeCourt ;
    echr:hasProceedingStartDate "2011-02-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "27"^^xsd:string ;
    echr:hasSupportingQuote "On 7 February 2011, the applicant initiated proceedings before the administrative court, contesting the actions of the Fund concerning the tendering of Viva TV-Radio Viva, in which he claimed to hold both direct and indirect shares."^^xsd:string .

doc:proc_annulment_1 a echr:DomesticProceeding ;
    rdfs:label "proceedings initiated by the applicant to annul decisions related to the valuation, tender invitation and subsequent sale of a television channel and radio station owned by joint-stock companies in which the applicant held shares."@en ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "The case concerns the non-enforcement of judgments delivered by the Supreme Administrative Court following proceedings initiated by the applicant to annul decisions related to the valuation, tender invitation and subsequent sale of a television channel and radio station owned by joint-stock companies in which the applicant held shares."@en .

doc:proc_general_assembly_20150707 a echr:DomesticProceeding ;
    rdfs:label "General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court decision"@en ;
    echr:followsProceeding doc:proc_sup_13_chamber_20141209 ;
    echr:hasCourt doc:authoritySupremeAdministrativeCourt ;
    echr:hasDecisionDate "2015-07-07"^^xsd:date ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "29"^^xsd:string ;
    echr:hasSupportingQuote "On 7 July 2015, following an appeal by the applicant, the General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court ( Danıştay İdari Dava Daireleri Genel Kurulu – hereinafter “the General Assembly”), in line with the dissenting opinion, ruled that the estimated value of USD 6,000,000 had been determined on the basis of the 2009 valuation report, without any new assessment of the market value. The General Assembly concluded that the contested decision was not in compliance with the law, and, by a majority, annulled the Fund’s decision."^^xsd:string ;
    echr:isFinalDomesticDecision false .

doc:proc_sup_13_chamber_20141209 a echr:DomesticProceeding ;
    rdfs:label "13th Chamber of the Supreme Administrative Court decision"@en ;
    echr:followsProceeding doc:proc_admin_court_20110207 ;
    echr:hasCourt doc:authoritySupremeAdministrativeCourt ;
    echr:hasDecisionDate "2014-12-09"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "28"^^xsd:string ;
    echr:hasSupportingQuote "On 9 December 2014, the 13th Chamber of the Supreme Administrative Court dismissed the applicant’s case."^^xsd:string .

doc:proc_supreme_admin_judgment_1 a echr:DomesticProceeding ;
    rdfs:label "judgments delivered by the Supreme Administrative Court"@en ;
    echr:followsProceeding doc:proc_annulment_1 ;
    echr:hasCourt doc:authoritySupremeAdministrativeCourt ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasProceedingType echr:TypeAdministrative ;
