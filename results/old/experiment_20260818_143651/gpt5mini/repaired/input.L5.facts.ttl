doc:proc_hqdcb_vote_2016 a echr:DomesticProceeding ;
    rdfs:label "HQDCB meeting 22 July 2016"@en ;
    echr:followsProceeding doc:proc_hqdcb_hearings_2013 ;
    echr:hasCourt doc:authHqdcb ;
    echr:hasDecisionDate "2016-07-22"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasSourceParagraph "20"@en ;
    echr:hasSupportingQuote "On 22 July 2016 the draft decision was put to vote at a HQDCB meeting where 19 out of 30 HQDCB members were present. Out of 19 members, 11 voted in favour of the decision, 6 voted against it, and 2 abstained. In view of the changes to the Rules of Procedure adopted in 2014 (see paragraph 16 above), the draft decision was rejected and the decisions suspending the applicant’s licence remained valid."@en .

