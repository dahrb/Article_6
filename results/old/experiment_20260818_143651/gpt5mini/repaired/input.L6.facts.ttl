doc:yerevan_civil_court_proceeding_2008_10_17 a echr:DomesticProceeding ;
    rdfs:label "claim lodged with the Yerevan Civil Court on 17 October 2008"@en ;
    echr:hasCourt doc:yerevanCivilCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingStartDate "2008-10-17"^^xsd:date ;
    echr:hasSourceParagraph "27"^^xsd:string,
        "28"^^xsd:string ;
    echr:hasSupportingQuote "On 12 November 2008 the Yerevan Civil Court accepted the applicant company’s claim for examination and scheduled a preparatory hearing."@en,
        "On the same day it allowed the applicant company’s interlocutory application for a freezing injunction in respect of the property of the LLC in the amount of the claim."@en,
        "on 17 October 2008 the applicant company lodged a claim with the Yerevan Civil Court, seeking to recover EUR 116,600 from the LLC, representing the amount of the loan and interest."@en .

