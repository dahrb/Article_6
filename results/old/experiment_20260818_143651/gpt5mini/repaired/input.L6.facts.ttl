doc:arbitration_tribunal_refusal_2008_10_07 a echr:DomesticProceeding ;
    rdfs:label "Arbitration Tribunal decision of 7 October 2008"@en ;
    echr:hasCourt doc:arbitrationTribunalCciArmenia ;
    echr:hasDecisionDate "2008-10-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasSourceParagraph "26"^^xsd:string ;
    echr:hasSupportingQuote "Consequently, in the absence of an arbitration agreement between the parties, the [Arbitration Tribunal] cannot start arbitration proceedings."@en .

