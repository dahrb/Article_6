    echr:hasSupportingQuote "On 10 December 2007 a three-judge bench of the Commercial Court rejected the complaint submitted by the applicant company."^^xsd:string,
        "On 23 November 2007 the applicant company lodged a complaint concerning the decision to leave the claim and counterclaim unexamined."^^xsd:string .

doc:domesticProceedingCommercialCourtInitial a echr:DomesticProceeding ;
    rdfs:label "Commercial Court decision to leave the claim and counterclaim unexamined (16 November 2007)"@en ;
    echr:hasCourt doc:commercialCourt ;
    echr:hasDecisionDate "2007-11-16"^^xsd:date ;
    echr:hasSourceParagraph "16"^^xsd:string,
        "19"^^xsd:string ;
    echr:hasSupportingQuote "On 16 November 2007 the Commercial Court granted the request and decided to leave the applicant company’s claim and the counterclaim lodged by the LLC unexamined."^^xsd:string,
        "On 4 October 2007 the LLC filed a counterclaim, contesting the applicant company’s claims."^^xsd:string .

doc:domestic_proceeding_2007_commercial_court a echr:DomesticProceeding ;
    rdfs:label "On 15 January 2007 the applicant company lodged a claim with the Commercial Court against the LLC, seeking to recover USD 10,000 from the initial debt of USD 1,213,824."@en ;
    echr:hasCourt doc:commercialCourt ;
    echr:hasProceedingStartDate "2007-01-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "14"^^xsd:string,
        "15"^^xsd:string ;
    echr:hasSupportingQuote "On 15 January 2007 the applicant company lodged a claim with the Commercial Court against the LLC, seeking to recover USD 10,000 from the initial debt of USD 1,213,824."@en,
        "On 2 October 2007 the applicant company amended its initial claim, seeking to recover a total of USD 1,516,442 and EUR 116,600 from the LLC, including the principal debt, the loan and interest on both."@en .

