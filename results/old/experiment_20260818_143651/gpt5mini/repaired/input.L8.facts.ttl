doc:first_conviction_quashed_february_1999 a echr:DomesticProceeding ;
    rdfs:label "the applicant’s first (1982) conviction quashed in February 1999"@en ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasDecisionDate "1999-02"^^echr:PartialDate ;
    echr:hasInstanceLevel echr:LevelUnknown ;
    echr:hasSourceParagraph "5"^^xsd:string ;
    echr:hasSupportingQuote "In February 1999 the applicant’s first (1982) conviction was quashed, and the file in that case was closed by the Nizhniy Novgorod regional prosecutor’s office."@en .

doc:supreme_court_cassation_1998_08_10 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court cassation proceedings and decision of 10 August 1998"@en ;
    echr:followsProceeding doc:regional_court_second_trial_1998_05_27 ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasDecisionDate "1998-08-10"^^echr:PartialDate ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasSourceParagraph "2"^^xsd:string,
        "4"^^xsd:string ;
    echr:hasSupportingQuote "An appeal to the Supreme Court by the applicant’s lawyer, Mr. O., challenged the judgment on a number of points."@en,
        "On 10 August 1998 the Supreme Court confirmed the judgment of the Nizhniy Novgorod Regional Court, with some alterations."@en .

doc:supreme_review_detention_1998 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court review of detention order (appeal lodged 23 April 1998; reply 19 May 1998)"@en ;
    echr:followsProceeding doc:retrial_nizhniy_1998_03_30 ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasDecisionDate "1998-05-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasProceedingStartDate "1998-04-23"^^xsd:date ;
    echr:hasSourceParagraph "A"^^xsd:string ;
    echr:hasSupportingQuote "On 23 April 1998 the applicant's “civil defender”, who participated in the process with a status similar to that of a lawyer, lodged with the Supreme Court an appeal against the court order of 2 April to detain the applicant. He requested it to quash the order and to transfer the case to another region to be heard by jury, since it was impossible to achieve a fair and impartial trial in Nizhniy Novgorod, given the political tension surrounding the case."@en,
        "The reply from the Supreme Court, dated 19 May 1998, stated that the national law did not allow appeals against that type of trial court orders separately from appeals against judgments."@en .

doc:appeal_supreme_july_1997 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court (July 1997)"@en ;
    echr:followsProceeding doc:first_instance_trial_1995_1997 ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasDecisionDate "1997-07"^^xsd:gYearMonth ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasSourceParagraph "A"^^xsd:string ;
    echr:hasSupportingQuote "In July 1997 the Supreme Court quashed the conviction on the applicant’s appeal and remitted the case to the Nizhniy Novgorod Regional Court."@en .

doc:first_instance_trial_1995_1997 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court (21 April 1997)"@en ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasDecisionDate "1997-04-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasProceedingStartDate "1995-03-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "A"^^xsd:string ;
    echr:hasSupportingQuote "On 21 April 1997 the Nizhniy Novgorod Regional Court found the applicant guilty on some of the charges, and not guilty on most. He was sentenced to one and a half years in prison (the time he had already spent in pre-trial detention) and some of his property was confiscated."@en .

doc:investigation_march_1995 a echr:DomesticProceeding ;
    rdfs:label "investigation against the applicant in March 1995"@en ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingStartDate "1995-03"^^echr:PartialDate ;
    echr:hasSourceParagraph "7"^^xsd:string ;
    echr:hasSupportingQuote "Following the institution of an investigation against the applicant in March 1995,"@en .

doc:pre_trial_investigation_1 a echr:DomesticProceeding ;
    rdfs:label "pre-trial investigation"@en ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "2"^^xsd:string ;
    echr:hasSupportingQuote "during the pre-trial investigation"@en .

doc:regional_court_judgment_1997_04_21 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court judgment of 21 April 1997"@en ;
    echr:followsProceeding doc:investigation_march_1995 ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasDecisionDate "1997-04-21"^^echr:PartialDate ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasSourceParagraph "13"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of the Nizhniy Novgorod Regional Court of 21 April 1997, later quashed by the Supreme Court, the applicant was ordered to pay the “Oka” damages in the amount that had been transferred to it previously."@en .

doc:regional_court_second_trial_1998_05_27 a echr:DomesticProceeding ;
    rdfs:label "During the second trial, on 27 May 1998 the Nizhniy Novgorod Court ordered damages to \"Oka\""@en ;
    echr:followsProceeding doc:regional_court_judgment_1997_04_21 ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasDecisionDate "1998-05-27"^^echr:PartialDate ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasSourceParagraph "14"^^xsd:string ;
    echr:hasSupportingQuote "During the second trial, on 27 May 1998 (confirmed by the Supreme Court on 10 August 1998) the applicant was ordered by the Nizhniy Novgorod Court to pay damages to “Oka”."@en .

doc:retrial_nizhniy_1998_03_30 a echr:DomesticProceeding ;
    rdfs:label "Nizhniy Novgorod Regional Court retrial (30 March 1998 onward)"@en ;
    echr:followsProceeding doc:appeal_supreme_july_1997 ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingStartDate "1998-03-30"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "A"^^xsd:string ;
    echr:hasSupportingQuote "On 19 May the applicant’s “civil defender” requested the Regional Court to dismiss the judge presiding in the case for bias. ... On the same day the applicant requested to admit Mrs Moskalenko as his lawyer in the trial because one of his lawyers was on sick leave. Both requests were rejected by the Regional Court."@en,
        "On 2 April 1998 the Nizhniy Novgorod Regional Court granted the prosecutor’s renewed motion for detention on grounds of obstruction of justice and violations of the undertaking not to leave the city, and the applicant was arrested in the course of the hearing. The reasons given by the court for the order were the witnesses’ refusal to testify in the courtroom, public and media pressure on the court instigated by the applicant and breach of the court order. The court also ordered that the rest of the trial should be conducted in camera."@en,
        "On 30 March 1998, during the new trial, the prosecutor applied to the court to detain the applicant for violations of the undertaking not to leave the city during the trial and obstruction of justice. The Regional Court rejected the motion as unsubstantiated."@en .

doc:trial_first_instance_19980527 a echr:DomesticProceeding ;
    rdfs:label "trial"@en ;
    echr:followsProceeding doc:pre_trial_investigation_1 ;
    echr:hasCourt doc:nizhniyNovgorodRegionalCourt ;
    echr:hasDecisionDate "1998-05-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "5"^^xsd:string ;
    echr:hasSupportingQuote "On 27 May 1998 the Nizhniy Novgorod Regional Court found the applicant guilty on charges of misappropriation and embezzlement, larceny, bribery and attempt not to return money from abroad."@en .

doc:supremeCourt a echr:DomesticAuthority ;
    rdfs:label "Supreme Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Supreme Court"^^xsd:string .

doc:nizhniyNovgorodRegionalCourt a echr:DomesticAuthority ;
    rdfs:label "Nizhniy Novgorod Regional Court"@en,
        "Nizhniy Novgorod regional prosecutor’s office"@en ;
    echr:decidedProceeding doc:trial_first_instance_19980527 ;
    echr:hasAuthorityKind echr:AuthorityJudicial,
        echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Nizhniy Novgorod Regional Court"^^xsd:string,
        "Nizhniy Novgorod Regional Court"@en ;
    echr:hasSourceParagraph "5"^^xsd:string ;
    echr:hasSupportingQuote "On 27 May 1998 the Nizhniy Novgorod Regional Court found the applicant guilty on charges of misappropriation and embezzlement, larceny, bribery and attempt not to return money from abroad."@en .

