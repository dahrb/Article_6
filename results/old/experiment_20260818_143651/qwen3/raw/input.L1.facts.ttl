doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    echr:hasDecisionDate "2000-11-20"^^xsd:date,
        "2001-04-12"^^xsd:date,
        "2005-03-10"^^xsd:date ;
    echr:hasProceedingStartDate "2004-11-25"^^xsd:date,
        "2000"^^xsd:gYear ;
    echr:hasSourceParagraph "10"^^xsd:string,
        "11"^^xsd:string,
        "37"^^xsd:string ;
    echr:hasStatedDuration "P2191D"^^xsd:duration ;
    echr:hasSupportingQuote "That judgment was upheld in a judgment of 12 April 2001 by the Veliko Tarnovo Court of Appeal ( Апелативен съд ) on an appeal by the applicant, and was subsequently transmitted to the Ruse Municipal Council on 7 June 2001 for the appointment of a guardian."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:domestic_proceeding_2 a echr:DomesticProceeding ;
    echr:hasDecisionDate "2002-05-23"^^xsd:date,
        "2005-10-11"^^xsd:date ;
    echr:hasProceedingStartDate "2005-03-10"^^xsd:date ;
    echr:hasSourceParagraph "12"^^xsd:string,
        "38"^^xsd:string ;
    echr:hasStatedDuration "P365D"^^xsd:duration ;
    echr:hasSupportingQuote "Since the applicant’s family members had refused to take on any guardianship responsibilities, on 23 May 2002 the Municipal Council appointed Ms R.P., a council officer, as the applicant’s guardian until 31 December 2002."^^xsd:string .

doc:domestic_proceeding_3 a echr:DomesticProceeding ;
    echr:hasDecisionDate "2002-07-23"^^xsd:date,
        "2006-03-10"^^xsd:date ;
    echr:hasProceedingStartDate "2005-09-28"^^xsd:date ;
    echr:hasSourceParagraph "13"^^xsd:string,
        "40"^^xsd:string ;
    echr:hasStatedDuration "P62D"^^xsd:duration ;
    echr:hasSupportingQuote "Social services drew up a welfare report on the applicant, noting on 23 July 2002 that he was suffering from schizophrenia, that he lived alone in a small, run-down annexe to his half-sister’s house and that his half-sister and his father’s second wife had stated that they did not wish to act as his guardian. The requirements for placement in a social care home were therefore deemed to be fulfilled."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:domestic_proceeding_4 a echr:DomesticProceeding ;
    echr:hasDecisionDate "2002-12-10"^^xsd:date,
        "2005-08-10"^^xsd:date ;
    echr:hasProceedingStartDate "2005-03-01"^^xsd:date ;
    echr:hasSourceParagraph "14"^^xsd:string,
        "37-38"^^xsd:string ;
    echr:hasStatedDuration "P1808D"^^xsd:duration ;
    echr:hasSupportingQuote "On 10 December 2002 a welfare-placement agreement was signed between R.P. and the social care home for adults with mental disorders near the village of Pastra in the municipality of Rila (“the Pastra social care home”), an institution under the responsibility of the Ministry of Labour and Social Policy. The applicant was not informed of the agreement."^^xsd:string .

doc:domestic_proceeding_5 a echr:DomesticProceeding ;
    echr:hasDecisionDate "2005-02-02"^^xsd:date,
        "2005-09-16"^^xsd:date ;
    echr:hasProceedingStartDate "2005-09-09"^^xsd:date ;
    echr:hasSourceParagraph "17"^^xsd:string,
        "39"^^xsd:string ;
    echr:hasStatedDuration "P1458D"^^xsd:duration ;
    echr:hasSupportingQuote "In a letter dated 16 September 2005, she was informed that the Municipal Council had decided on 2 February 2005 to appoint the Director of the Pastra social care home as the applicant’s guardian."^^xsd:string ;
    echr:isFinalDomesticDecision true .

