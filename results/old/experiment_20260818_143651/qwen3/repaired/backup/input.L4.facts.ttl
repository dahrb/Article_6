doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Criminal complaint lodged, Slovenj Gradec Police, 12 April 1995"^^xsd:string ;
    echr:hasCourt doc:authority_1 ;
    echr:hasInactivityPeriod doc:inactivity_1 ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:proceeding_1_participation_1 ;
    echr:hasProceedingStartDate "1995-04-12"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "37"^^xsd:string ;
    echr:hasSupportingQuote "On 12 April 1995 the Slovenj Gradec Police lodged a criminal complaint against the applicant for the criminal offence of “obstructing an official in the course of his duties” under section 302, paragraph 4-1 of the Slovenian Criminal Code, which referred to the same incident as the applicant’s criminal complaint."^^xsd:string ;
    echr:isFinalDomesticDecision false .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Request to open criminal investigation, Slovenj Gradec District Court, 17 January 1997"^^xsd:string ;
    echr:hasCourt doc:authority_2 ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:proceeding_2_participation_1 ;
    echr:hasProceedingStartDate "1997-01-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "38"^^xsd:string ;
    echr:hasSupportingQuote "On 17 January 1997 the Public Prosecutor requested the Slovenj Gradec District Court to open a criminal investigation against the applicant."^^xsd:string ;
    echr:isFinalDomesticDecision false .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "Appeal against refusal to investigate, Maribor Higher Court, 4 December 1997"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:authority_3 ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:proceeding_2_participation_1 ;
    echr:hasProceedingStartDate "1997-05-12"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "41"^^xsd:string ;
    echr:hasSupportingQuote "On 12 May 1997 the Public Prosecutor appealed against this decision. On 4 December 1997 the Maribor Higher Court upheld her appeal finding that, despite the shortcomings mentioned in the first-instance decision, there were sufficient grounds for suspicion that the applicant had committed the alleged offence. Accordingly, it changed the first-instance court’s decision and opened a criminal investigation against the applicant."^^xsd:string ;
    echr:isFinalDomesticDecision false ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

doc:proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "Filing of indictment, Slovenj Gradec District Court, 28 December 1998"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:authority_2 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:proceeding_2_participation_1 ;
    echr:hasProceedingStartDate "1998-12-28"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "44"^^xsd:string ;
    echr:hasSupportingQuote "On 28 December 1998 the Public Prosecutor filed an indictment against the applicant for “attempting to obstruct an official in the course of his duties” ( poskus kaznivega dejanja preprečitve uradnega dejanja uradni osebi )."^^xsd:string ;
    echr:isFinalDomesticDecision false ;
    echr:raisesArticle6Issue doc:article6_issue_3 .

doc:proceeding_5 a echr:DomesticProceeding ;
    rdfs:label "Appeal against acquittal, Maribor Higher Court, 27 September 2000"^^xsd:string ;
    echr:followsProceeding doc:proceeding_4 ;
    echr:hasCourt doc:authority_3 ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:proceeding_1_participation_1 ;
    echr:hasProceedingStartDate "2000-01-05"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "47"^^xsd:string ;
    echr:hasSupportingQuote "On 5 January 2000 the Public Prosecutor appealed against the judgment and on 27 September 2000 the Maribor Higher Court quashed the judgment and remitted the case to a new panel for retrial."^^xsd:string ;
    echr:isFinalDomesticDecision false ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

doc:proceeding_7 a echr:DomesticProceeding ;
    rdfs:label "Appeal against conviction, Maribor Higher Court, 9 May 2001"^^xsd:string ;
    echr:followsProceeding doc:proceeding_6 ;
    echr:hasCourt doc:authority_3 ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:proceeding_1_participation_1 ;
    echr:hasProceedingStartDate "2001-03-12"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "49"^^xsd:string ;
    echr:hasSupportingQuote "On 12 March 2001 the Public Prosecutor appealed against this judgment and applied for a heavier sentence. The applicant also appealed. On 9 May 2001 the Maribor Higher Court upheld the conviction but amended the judgment with respect to the costs of the proceedings."^^xsd:string ;
    echr:isFinalDomesticDecision true ;
    echr:raisesArticle6Issue doc:article6_issue_3 .

