doc:pre_trial_detention_1 a echr:PreTrialDetention ;
    echr:hasDetentionEndDate "1995-04-05"^^xsd:date,
        "1995-04-06"^^xsd:date ;
    echr:hasDetentionStartDate "1995-04-05"^^xsd:date ;
    echr:hasSourceParagraph "12"^^xsd:string ;
    echr:hasStatedDetentionDuration "PT1H"^^xsd:duration ;
    echr:hasSupportingQuote "He was brought to the Slovenj Gradec Police Station [...] and released on 6 April 1995 at approximately half past midnight."^^xsd:string,
        "The applicant was released after questioning."^^xsd:string .

doc:proceeding_8 a echr:DomesticProceeding ;
    rdfs:label "Costs order, Slovenj Gradec District Court, 11 October 2001"^^xsd:string ;
    echr:hasCourt doc:authority_2 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:proceeding_2_participation_1 ;
    echr:hasProceedingStartDate "2001-10-11"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "50"^^xsd:string ;
    echr:hasSupportingQuote "Lastly, on 11 October 2001 the Slovenj Gradec District Court ordered the applicant to pay an additional sum to cover the costs of one of the witnesses heard during the proceedings. On that day, the proceedings were “finally concluded” ( pravnomočno končan postopek )."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:domestic_authority_2 a echr:DomesticAuthority ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Slovenj Gradec Police"^^xsd:string ;
    echr:hasName "Slovenj Gradec Police"^^xsd:string ;
    echr:hasSourceParagraph "10"^^xsd:string,
        "28"^^xsd:string,
        "33"^^xsd:string ;
    echr:hasSupportingQuote "On 7 April 1995 the applicant went to the Slovenj Gradec Police"^^xsd:string,
        "Slovenj Gradec Internal Affairs Administration ( Uprava za notranje zadeve – hereinafter referred as the “Slovenj Gradec Police”)"^^xsd:string,
        "The Slovenj Gradec Police report finds, inter alia , that D.P. and J.K. stopped the applicant’s car"^^xsd:string .

doc:domestic_authority_3 a echr:DomesticAuthority ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Slovenian courts"^^xsd:string,
        "Slovenj Gradec Police"^^xsd:string ;
    echr:hasName "Slovenj Gradec Police"^^xsd:string ;
    echr:hasSourceParagraph "29"^^xsd:string,
        "3"^^xsd:string,
        "32"^^xsd:string ;
    echr:hasSupportingQuote "On 15 May 1995 the applicant lodged, through his lawyer, a written criminal complaint ( kazenska ovadba ) with the Slovenj Gradec Police against unidentified police officers"^^xsd:string,
        "The criminal complaint of the Slovenj Gradec Police states that Aleksander Matko sustained injuries as a result of the use of force."^^xsd:string,
        "the investigation into his allegations had not been effective"^^xsd:string .

doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_2 ;
    echr:hasCourt doc:authority_1 ;
    echr:hasDecisionDate "1997-01-17"^^xsd:date,
        "2001-02-12"^^xsd:date ;
    echr:hasDelayAttribution echr:DelayAttributedToAuthorities ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasParty "cd:party_1"^^xsd:string ;
    echr:hasProceedingStartDate "1995-04-05"^^xsd:date,
        "1995-04-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "12"^^xsd:string,
        "21"^^xsd:string,
        "28"^^xsd:string,
        "34"^^xsd:string,
        "35"^^xsd:string ;
    echr:hasSupportingQuote "In the decision the Public Prosecutor identified D.P., J.K. and M. J. as the officers accused in the applicant’s complaint."^^xsd:string,
        "On 17 January 1997 the Public Prosecutor issued a decision dismissing the applicant’s criminal complaint."^^xsd:string,
        "On 5 April 1995 at about 8.30 p.m. the applicant, driving a car, was arrested in Slovenj Gradec by officers of the Special Unit and the Slovenj Gradec Police."^^xsd:string,
        "On 7 April 1995 the applicant went to the Slovenj Gradec Police and made an oral complaint against the officers of the Special Unit concerning the events of 5 April 1995."^^xsd:string,
        "The judgment of 12 February 2001 issued in the proceedings instituted against the applicant (see paragraph 48), established that three officers of the Slovenj Gradec Police, D.P., J.K. and M.F., who were in the car which stopped the applicant, received information about the location of a “white Golf”, believed to be being driven by the applicant, and an order to stop it."^^xsd:string ;
    echr:isFinalDomesticDecision true ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

doc:domestic_proceeding_2 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_3 ;
    echr:hasCourt doc:domestic_authority_2 ;
    echr:hasDecisionDate "1995-04-06"^^xsd:date,
        "1997-01-17"^^xsd:date ;
    echr:hasDelayAttribution echr:DelayAttributedToAuthorities ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasProceedingStartDate "1995-04-05"^^xsd:date,
        "1995-04-06"^^xsd:date,
        "1995-04-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "12"^^xsd:string,
        "26"^^xsd:string,
        "31"^^xsd:string,
        "32"^^xsd:string ;
    echr:hasSupportingQuote "He was questioned by the police and released on 6 April 1995 at approximately half past midnight."^^xsd:string,
        "In the meantime, on 14 July 1995, the Slovenj Gradec District Public Prosecutor (the “Public Prosecutor”) requested the Slovenj Gradec Police to identify the officers who had participated in the procedure against the applicant and to conduct an interview with them."^^xsd:string,
        "On 6 April 1995, soon after his release, the applicant was admitted to the Slovenj Gradec General Hospital where he stayed until 7 p.m. The medical report, written by a doctor in that hospital, stated that the applicant had bruises on his head, but did not include any details of the injuries. The applicant was advised to rest for a few days."^^xsd:string,
        "The latter, which under the “subject” ( zadeva ) refers solely to the criminal offence allegedly committed by the applicant, reads as follows:"^^xsd:string .

doc:domestic_proceeding_3 a echr:DomesticProceeding ;
    echr:hasCourt doc:domestic_authority_3 ;
    echr:hasDecisionDate "1995-04-19"^^xsd:date,
        "1997-01-17"^^xsd:date ;
    echr:hasDelayAttribution echr:DelayAttributedToAuthorities ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasParticipation doc:participation_3 ;
    echr:hasProceedingStartDate "1995-04-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSittingJudge doc:judicial_officer_1 ;
    echr:hasSourceParagraph "27"^^xsd:string,
        "29"^^xsd:string,
        "3"^^xsd:string,
        "32"^^xsd:string ;
    echr:hasSupportingQuote "On 15 May 1995 the applicant lodged, through his lawyer, a written criminal complaint ( kazenska ovadba ) with the Slovenj Gradec Police against unidentified police officers for causing minor bodily harm ( lahka telesna poškodba ) and an unlawful deprivation of liberty ( protipraven odvzem prostosti )."^^xsd:string,
        "The applicant alleged that he had been ill-treated by the police and that the investigation into his allegations had not been effective."^^xsd:string,
        "The criminal complaint of the Slovenj Gradec Police states that Aleksander Matko sustained injuries as a result of the use of force."^^xsd:string,
        "The medical report of 7 April 1995 indicates several lesions, including: - bruises on the right eye and a small amount of suffusion in the surrounding area; - a haematoma on the left side of the forehead - a painful nose; - a 6 cm by 4 cm haematoma on the left shoulder; - two 4-5 cm linear skin abrasions on the left side of the thorax; - a child’s-hand-sized moderate oedema behind the right ear; - an extensive haematoma on the left thigh. The doctors had also suspected a fracture of the right temporal bone. The report of an x-ray examination on 19 April 1995 indicated that there was a hairline fracture ( fissur a)."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:inactivity_1 a echr:InactivityPeriod ;
    echr:hasExtractionNote "Gap between criminal complaint lodged and request to open investigation; attributed to authorities' delay."^^xsd:string ;
    echr:hasInactivityCause echr:DelayAttributedToAuthorities ;
    echr:hasInactivityEndDate "1997-01-17"^^xsd:date ;
    echr:hasInactivityStartDate "1995-04-12"^^xsd:date .

