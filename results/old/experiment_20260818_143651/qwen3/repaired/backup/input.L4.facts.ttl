doc:article6_issue_1 a echr:Article6Issue ;
    rdfs:label "Judicial bias and lack of impartiality"^^xsd:string,
        "Unjustified delay in investigation and appeal"^^xsd:string ;
    echr:affectsParty doc:applicant,
        doc:party_1 ;
    echr:hasDelayAttribution echr:DelayAttributedToAuthorities ;
    echr:hasSourceParagraph "3"^^xsd:string,
        "30"^^xsd:string,
        "34"^^xsd:string,
        "41"^^xsd:string,
        "48"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of 12 February 2001, the Slovenj Gradec District Court convicted the applicant as charged and sentenced him to 3 months’ imprisonment, suspended for 3 years."^^xsd:string,
        "During the police procedure, the applicant did not request medical aid and the police only afterwards learned that he had sustained injuries."^^xsd:string,
        "He also alleged that the criminal proceedings had been unfair and excessively long (Article 6 of the Convention)."^^xsd:string,
        "On 12 May 1997 the Public Prosecutor appealed against this decision. On 4 December 1997 the Maribor Higher Court upheld her appeal finding that, despite the shortcomings mentioned in the first-instance decision, there were sufficient grounds for suspicion that the applicant had committed the alleged offence. Accordingly, it changed the first-instance court’s decision and opened a criminal investigation against the applicant."^^xsd:string,
        "On 15 June 1995 the Slovenj Gradec District Public Prosecutor’s Office (Okrožno državno tožilstvo ) asked the applicant’s lawyer to add his client’s deposition to the file, which he did on 20 June 1995. On 21 October 1996 and 6 January 1997 the applicant’s lawyer sought information from the Public Prosecutor’s Office about the state of progress in the proceedings."^^xsd:string,
        "On 17 January 1997 the Public Prosecutor issued a decision dismissing the applicant’s criminal complaint."^^xsd:string,
        "When the officers caught him, the applicant again tried to resist and they responded by using truncheons and gripped his elbow to handcuff him, knocking him down in the process."^^xsd:string ;
    echr:issueArisesIn doc:domestic_proceeding_1,
        doc:proceeding_3,
        doc:proceeding_6 .

