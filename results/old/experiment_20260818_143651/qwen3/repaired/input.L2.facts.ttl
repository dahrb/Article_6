doc:domestic_proceeding_2 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_1 ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasCourt doc:domestic_authority_1,
        doc:domestic_authority_2 ;
    echr:hasDecisionDate "1994-09-06"^^echr:PartialDate ;
    echr:hasDelayAttribution echr:DelayAttributedToAuthorities ;
    echr:hasExtractionNote "Settlement amount of 22,000 marks (DEM) paid by company T.I. to second applicant"@en ;
    echr:hasInstanceLevel echr:LevelAppeal,
        echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeSettled,
        echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant,
        echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasProceedingStartDate "1993-09-00"^^echr:PartialDate ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSittingJudge doc:judicial_officer_4 ;
    echr:hasSourceParagraph "17"^^xsd:string,
        "46"^^xsd:string ;
    echr:hasStatedDuration "P11M"^^xsd:duration ;
    echr:hasSupportingQuote "In the proceedings instituted by the second applicant against his dismissal by the company T.I. (see paragraph 13 above), a settlement had been reached in the Darmstadt Labour Court on 6 September 1994."^^xsd:string,
        "The Labour Court considered that ESA enjoyed immunity from jurisdiction according to the ESA Convention and its Annex I. In its view, ESA had been established as a new and independent organisation and was therefore not bound by Article 6 § 2 of the Agreement concerning ESOC (see paragraph 15 above). The Labour Court further referred to the decision of the Federal Labour Court in the case of Mr Waite and Mr Kennedy (see paragraph 15 above)."^^xsd:string ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

doc:party_2 a echr:Party ;
    echr:hasPartyName "the second applicant"^^xsd:string .

doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_2 ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasCourt doc:domestic_authority_1 ;
    echr:hasDecisionDate "1995-03-21"^^echr:PartialDate ;
    echr:hasDelayAttribution echr:DelayAttributedToAuthorities ;
    echr:hasExtractionNote "First applicant received DEM 14,000 for lawyer's fees and DEM 305,000 for loss of job"@en ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible,
        echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasProceedingStartDate "1995-09-13"^^xsd:date,
        "1993-10-00"^^echr:PartialDate ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSittingJudge doc:judicial_officer_4 ;
    echr:hasSourceParagraph "15"^^xsd:string,
        "41"^^xsd:string,
        "45"^^xsd:string ;
    echr:hasStatedDuration "P1Y5M"^^xsd:duration ;
    echr:hasSupportingQuote "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."^^xsd:string,
        "The German labour court proceedings in the present case, as in the case of Mr Waite and Mr Kennedy, had concentrated on the question of whether or not ESA could validly rely on its immunity from jurisdiction."^^xsd:string,
        "The German labour court regarded the applicants’ action under the German Provision of Labour (Temporary Staff) Act inadmissible as the defendant, ESA, had claimed immunity from jurisdiction in accordance with Article XV § 2 of the ESA Convention and Article IV § 1 of its Annex I."^^xsd:string ;
    echr:isFinalDomesticDecision true ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

doc:judicial_officer_4 a echr:JudicialOfficer ;
    echr:hasName "Mrs Voelskow-Thies"^^xsd:string ;
    echr:hasPersonName "Mrs Voelskow-Thies"^^xsd:string ;
    echr:hasSourceParagraph "9"^^xsd:string ;
    echr:hasSupportingQuote "The Court heard addresses by Mr Herndl, Mr Laule, Mr W.J. Habscheid and Mrs Voelskow-Thies."^^xsd:string .

doc:party_1 a echr:Party ;
    echr:hasPartyName "Mr Beer and Mr Regan"^^xsd:string,
        "the applicants"^^xsd:string .

doc:article6_issue_1 a echr:Article6Issue ;
    echr:affectsParty doc:party_1 ;
    echr:hasDelayAttribution echr:DelayAttributedToAuthorities ;
    echr:hasSourceParagraph "14"^^xsd:string,
        "33"^^xsd:string,
        "45"^^xsd:string ;
    echr:hasSupportingQuote """ESA relied on its immunity from jurisdiction under Article XV § 2 of the ESA Convention and its Annex I.

The Labour Court considered that ESA had validly relied on its immunity from jurisdiction.

The Labour Court, referring to section 20(2) of the Courts Act (Gerichtsverfassungsgesetz), according to which immunity from jurisdiction could be provided for, inter alia, in international agreements, considered that ESA enjoyed such immunity under Article XV § 2 of the ESA Convention and its Annex I."""^^xsd:string,
        "The German labour court regarded the applicants’ action under the German Provision of Labour (Temporary Staff) Act inadmissible as the defendant, ESA, had claimed immunity from jurisdiction in accordance with Article XV § 2 of the ESA Convention and Article IV § 1 of its Annex I."^^xsd:string,
        "they had been denied access to a court for a determination of their dispute with ESA in connection with an issue under German labour law."^^xsd:string ;
    echr:issueArisesIn doc:domestic_proceeding_1 .

doc:domestic_authority_1 a echr:DomesticAuthority ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Darmstadt Labour Court"^^xsd:string,
        "Darmstadt Labour Court (Arbeitsgericht)"^^xsd:string ;
    echr:hasName "Darmstadt Labour Court"^^xsd:string .

doc:participation_1 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:party_1,
        doc:party_2 .

