    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:erolAksoy .

doc:part_enf_1_fund a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:fund .

doc:proceedingSaleAnnulmentAppeal a echr:DomesticProceeding ;
    rdfs:label "Appeal of sale annulment"^^xsd:string ;
    echr:followsProceeding doc:proceeding_sale_annulment_1 ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2014-12-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partValAppAksoy,
        doc:partValAppFund ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On an appeal by the applicant, the 13th Chamber of the Supreme Administrative Court upheld that decision on 9 December 2014."^^xsd:string .

doc:proceedingValuationAppeal a echr:DomesticProceeding ;
    rdfs:label "Appeal of valuation decision"^^xsd:string ;
    echr:followsProceeding doc:proceeding_valuation_1 ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2015-07-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:partValAppAksoy,
        doc:partValAppFund ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 7 July 2015, following an appeal by the applicant, the General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court... annulled the Fund’s decision."^^xsd:string .

doc:proceedingValuationRectification a echr:DomesticProceeding ;
    rdfs:label "Rectification request on valuation"^^xsd:string ;
    echr:followsProceeding doc:proceedingValuationAppeal ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2016-01-25"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:partValRectAksoy,
        doc:partValRectFund ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 25 January 2016, the Supreme Administrative Court rejected the Fund’s request for rectification"^^xsd:string .

doc:proceeding_sale_annulment_1 a echr:DomesticProceeding ;
    rdfs:label "Proceeding to annul sale of Viva TV-Radio Viva"^^xsd:string ;
    echr:hasCourt doc:istanbulAdminCourt ;
    echr:hasDecisionDate "2014-03-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partValAppAksoy,
        doc:partValAppFund ;
    echr:hasProceedingStartDate "2011-02-24"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 24 February 2011, the applicant initiated proceedings before the administrative court, seeking the annulment of the sale of Viva TV-Radio Viva."^^xsd:string .

doc:proceeding_valuation_1 a echr:DomesticProceeding ;
    rdfs:label "Proceeding to annul valuation decision"^^xsd:string ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2014-12-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partValAppAksoy,
        doc:partValAppFund ;
    echr:hasProceedingStartDate "2011-02-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 7 February 2011, the applicant initiated proceedings before the administrative court, contesting the actions of the Fund concerning the tendering of Viva TV-Radio Viva"^^xsd:string .

doc:proceedingSaleAnnulmentRectification a echr:DomesticProceeding ;
    rdfs:label "Rectification of sale annulment"^^xsd:string ;
    echr:followsProceeding doc:proceedingSaleAnnulmentAppeal ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:partValAppAksoy,
        doc:partValAppFund ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "As a result, the court overturned the judgment of the 6th Chamber of the Istanbul Administrative Court dated 19 March 2014 and annulled the sale in question."@en .

