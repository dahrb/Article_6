<https://growgraph.dev/doc/6cb3461d1cd1> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:3"^^xsd:string .

doc:case_58919_18 a echr:CaseDocument ;
    echr:hasApplicant doc:erolAksoy ;
    echr:hasApplicationNumber "58919/18"^^xsd:string ;
    echr:hasCaseName "Erol Aksoy v. Türkiye"^^xsd:string ;
    echr:hasDomesticProceeding doc:constitutionalApplication,
        doc:proceedingSaleAnnulmentAppeal,
        doc:proceedingSaleAnnulmentRectification,
        doc:proceedingValuationAppeal,
        doc:proceedingValuationRectification,
        doc:proceeding_sale_annulment_1,
        doc:proceeding_valuation_1 ;
    echr:hasRespondentState "Türkiye"^^xsd:string .

doc:enforcement_request_1 a echr:AdministrativeAction ;
    rdfs:label "First enforcement request"^^xsd:string ;
    echr:followsProceeding doc:proceedingValuationRectification ;
    echr:hasDecisionDate "2016-04-18"^^xsd:date ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_enf_1_aksoy,
        doc:part_enf_1_fund ;
    echr:hasSupportingQuote "On 18 April 2016, the Fund notified the applicant of a decision taken on 27 October 2015 regarding the impossibility of enforcing the judgment."^^xsd:string .

doc:enforcement_request_2 a echr:AdministrativeAction ;
    rdfs:label "Second enforcement request"^^xsd:string ;
    echr:followsProceeding doc:proceedingSaleAnnulmentRectification ;
    echr:hasDecisionDate "2017-09-05"^^xsd:date ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_enf_1_aksoy,
        doc:part_enf_1_fund ;
    echr:hasSupportingQuote "On 5 September 2017, the Fund responded... the annulment decision could not be enforced due to legal and practical impossibilities"^^xsd:string .

doc:constitutionalApplication a echr:DomesticProceeding ;
    rdfs:label "Individual application to Constitutional Court"^^xsd:string ;
    echr:followsProceeding doc:proceedingSaleAnnulmentRectification ;
    echr:hasCourt doc:constitutionalCourt ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelSupervisoryReview ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partConstAksoy,
        doc:partConstFund ;
    echr:hasProceedingStartDate "2017-09-11"^^xsd:date ;
    echr:hasProceedingType echr:TypeConstitutional ;
    echr:hasSupportingQuote "On 11 September 2017, the applicant lodged an individual application with the Constitutional Court... the Constitutional Court declared the application inadmissible."^^xsd:string .

doc:constitutionalCourt a echr:DomesticAuthority ;
    rdfs:label "Constitutional Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Constitutional Court"^^xsd:string .

