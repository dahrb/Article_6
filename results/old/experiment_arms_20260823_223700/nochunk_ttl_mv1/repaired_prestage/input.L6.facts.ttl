    echr:hasCaseName "SCHOLZ AG v. ARMENIA"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceeding_commercial_court_1 ;
    echr:hasRespondentState "Republic of Armenia"^^xsd:string .

doc:proceedingCassation a echr:DomesticProceeding ;
    rdfs:label "Court of Cassation Proceeding"^^xsd:string ;
    echr:followsProceeding doc:proceedingCivilAppeal ;
    echr:hasCourt doc:courtOfCassation ;
    echr:hasDecisionDate "2009-09-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_llc_1,
        doc:part_scholz_1 ;
    echr:hasProceedingStartDate "2009-08-04"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 23 September 2009 the Court of Cassation declared the applicant company’s appeal on points of law inadmissible."^^xsd:string ;
    echr:isFinalDomesticDecision true .

