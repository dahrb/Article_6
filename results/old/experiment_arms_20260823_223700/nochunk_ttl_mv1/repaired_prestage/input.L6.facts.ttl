    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 7 October 2008 the President of the Arbitration Tribunal informed the applicant company that its request to start arbitration proceedings would not be granted."^^xsd:string .

doc:proceedingCivilAppeal a echr:DomesticProceeding ;
