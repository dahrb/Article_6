<https://growgraph.dev/doc/eceae272316f> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:1"^^xsd:string .

doc:actionPlacementRequest a echr:AdministrativeAction ;
    rdfs:label "social care home placement request"^^xsd:string ;
    echr:followsProceeding doc:actionGuardianAppointment ;
    echr:hasDecisionDate "2002-12-10"^^xsd:date ;
    echr:hasParticipation doc:part_home_1,
        doc:part_rp_1 ;
    echr:hasSupportingQuote "On 10 December 2002 a welfare-placement agreement was signed between R.P. and the social care home"^^xsd:string .

doc:action_guardian_appointment_2005 a echr:AdministrativeAction ;
    rdfs:label "appointment of home director as guardian"^^xsd:string ;
    echr:hasCourt doc:authorityRilaMunicipalCouncil ;
    echr:hasDecisionDate "2005-02-02"^^xsd:date ;
    echr:hasSupportingQuote "the Municipal Council had decided on 2 February 2005 to appoint the Director of the Pastra social care home as the applicant’s guardian"^^xsd:string .

doc:caseStanevBulgaria a echr:CaseDocument ;
    rdfs:label "Stanev v. Bulgaria"^^xsd:string ;
    echr:hasApplicant doc:applicantStanev ;
    echr:hasApplicationNumber "36760/06"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceedingIncapacityFirstInstance ;
    echr:hasRespondentState "Republic of Bulgaria"^^xsd:string .

doc:proceedingJudicialReviewMayor a echr:DomesticProceeding ;
    rdfs:label "judicial review of mayor decision"^^xsd:string ;
    echr:followsProceeding doc:actionMayorRefusal ;
    echr:hasCourt doc:authorityDupnitsaDistrictCourt ;
    echr:hasDecisionDate "2006-03-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_mayor_1,
        doc:part_rp_2,
        doc:part_stanev_2 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "The Dupnitsa District Court gave judgment on 10 March 2006... the court dismissed the application"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:reviewSupremeProsecutor a echr:ProsecutorialReview ;
    rdfs:label "supreme prosecutorial review"^^xsd:string ;
    echr:followsProceeding doc:reviewAppellateProsecutor ;
    echr:hasCourt doc:authoritySupremeProsecutor ;
    echr:hasDecisionDate "2005-11-29"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "subsequently on 29 November 2005 by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation"^^xsd:string .

doc:actionCapacityRequest a echr:AdministrativeAction ;
    rdfs:label "request for capacity restoration"^^xsd:string ;
    echr:hasDecisionDate "2004-11-25"^^xsd:date ;
    echr:hasSupportingQuote "On 25 November 2004 the applicant, through his lawyer, asked the public prosecutor’s office to apply to the Regional Court to have his legal capacity restored."^^xsd:string .

doc:actionGuardianAppointment a echr:AdministrativeAction ;
    rdfs:label "guardian appointment action"^^xsd:string ;
    echr:followsProceeding doc:proceedingIncapacityAppeal ;
