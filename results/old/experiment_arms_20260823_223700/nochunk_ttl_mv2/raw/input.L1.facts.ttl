    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasParticipation doc:part_council_1 ;
    echr:hasSupportingQuote "on 23 May 2002 the Municipal Council appointed Ms R.P., a council officer, as the applicant’s guardian"^^xsd:string .

doc:actionMayorRefusal a echr:AdministrativeAction ;
