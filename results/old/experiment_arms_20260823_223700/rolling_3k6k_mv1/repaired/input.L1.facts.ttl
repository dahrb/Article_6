doc:administrativeActionGuardianship a echr:AdministrativeAction ;
    rdfs:label "Placement in social care home and partial guardianship"^^xsd:string ;
    echr:hasStatusApplied echr:StatusPartialIncapacity ;
    echr:hasSupportingQuote "his placement in a social care home for people with mental disorders and his inability to obtain permission to leave the home"^^xsd:string .

