doc:adminActionAllowanceIncrease a echr:AdministrativeAction ;
    rdfs:label "Increase of social allowance"^^xsd:string ;
    echr:followsProceeding doc:adminActionAllowanceGrant ;
    echr:hasCourt doc:municipalSocialAssistanceDepartment ;
    echr:hasDecisionDate "2009-03-03"^^xsd:date ;
    echr:hasParticipation doc:participationDeptAllowanceInc,
        doc:participationStanevAllowanceInc ;
    echr:hasSupportingQuote "On 3 February 2009 the allowance was increased to BGN 19.50"^^xsd:string .

doc:adminActionGuardianAppointmentRila a echr:AdministrativeAction ;
    rdfs:label "Appointment of Director of Pastra home as guardian"^^xsd:string ;
    echr:followsProceeding doc:adminActionResidenceRegistration ;
    echr:hasCourt doc:rilaMunicipalCouncil ;
    echr:hasDecisionDate "2005-02-02"^^xsd:date ;
    echr:hasParticipation doc:participationDirectorGuardian,
        doc:participation_rila_council_1 ;
    echr:hasSupportingQuote "the Municipal Council had decided on 2 February 2005 to appoint the Director of the Pastra social care home as the applicant’s guardian"^^xsd:string .

doc:adminActionHomePlacement a echr:AdministrativeAction ;
    rdfs:label "Request for placement in social care home"^^xsd:string ;
    echr:followsProceeding doc:adminActionGuardianAppointment ;
    echr:hasDecisionDate "2002-07-23"^^xsd:date ;
    echr:hasParticipation doc:participation_rp_1 ;
    echr:hasSupportingQuote "Social services drew up a welfare report on the applicant, noting on 23 July 2002 that he was suffering from schizophrenia"^^xsd:string .

doc:adminActionPoliceResponse a echr:AdministrativeAction ;
