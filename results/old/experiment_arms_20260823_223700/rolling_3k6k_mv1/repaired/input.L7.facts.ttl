doc:courtOfAppealSawoniuk a echr:DomesticProceeding ;
    rdfs:label "Court of Appeal proceeding"^^xsd:string ;
    echr:followsProceeding doc:trialSawoniuk ;
    echr:hasCourt doc:courtOfAppealUk ;
    echr:hasDecisionDate "2000-02-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partSawoniukAppeal ;
    echr:hasSupportingQuote "As regards the allegations that the judge should have excluded evidence of witnesses about alleged assaults and the taking away of Jewish families by the applicant which were not on the indictment, it held that this evidence was relevant"^^xsd:string,
        "As regards the judge’s failure to stay the proceedings for abuse, the Court of Appeal found that he had correctly applied his discretion"^^xsd:string,
        "In its judgment of 10 February 2000, the Court of Appeal rejected the applicant’s appeal"^^xsd:string,
        "The Court of Appeal found no basis to fault the judge’s approach to the evidence concerning Mr Zan’s identification of the applicant."^^xsd:string .

