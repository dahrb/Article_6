doc:appeal_1 a echr:DomesticProceeding ;
    rdfs:label "Appeal against conviction"^^xsd:string ;
    echr:followsProceeding doc:trial_first_instance_1 ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasParticipation doc:participationAppealApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "The applicant appealed, arguing that there was insufficient evidence to convict him."^^xsd:string .

