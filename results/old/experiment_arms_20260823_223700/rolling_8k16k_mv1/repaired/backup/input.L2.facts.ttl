@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/3c75955b4975> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:2"^^xsd:string .

doc:agreementTBeer a echr:AdministrativeAction ;
    rdfs:label "Employment termination agreement - Karlheinz Beer"^^xsd:string ;
    echr:hasDecisionDate "1995-06-20"^^xsd:date ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasParticipation doc:partBeerT,
        doc:partTBeer ;
    echr:hasSupportingQuote "Under the terms of an agreement concluded on 20 June 1995 with the first applicant, terminating his contract of employment on 30 June 1995, the company T. undertook to pay to the first applicant the sum of DEM 14,000 for lawyer’s fees incurred in labour court proceedings concerning his dismissal and DEM 305,000 for the loss of his job."^^xsd:string .

doc:caseBeerRegan a echr:CaseDocument ;
    rdfs:label "Beer and Regan v. Germany"^^xsd:string ;
    echr:hasApplicant doc:karlheinzBeer,
        doc:philipRegan ;
    echr:hasApplicationNumber "28934/95"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceedingDarmstadtBeer,
        doc:proceedingDarmstadtRegan,
        doc:proceedingTiRegan ;
    echr:hasRespondentState "Federal Republic of Germany"^^xsd:string .

doc:committeeStaffRepresentatives a echr:Party ;
    rdfs:label "Committee of Staff Representatives of the Coordinated Organisations"^^xsd:string ;
    echr:hasPartyName "Committee of Staff Representatives of the Coordinated Organisations"^^xsd:string ;
    echr:hasSupportingQuote "The Committee of Staff Representatives of the Coordinated Organisations in their written comments"^^xsd:string .

doc:esaAppealsBoard a echr:DomesticAuthority ;
    rdfs:label "ESA Appeals Board"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "ESA Appeals Board"^^xsd:string ;
    echr:hasSupportingQuote "the ESA Appeals Board, which is ‘independent of the Agency’, has jurisdiction ‘to hear disputes relating to any explicit or implicit decision taken by the Agency and arising between it and a staff member’"^^xsd:string .

doc:esa a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "European Space Agency"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "European Space Agency"^^xsd:string .

