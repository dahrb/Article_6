    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:adminCourt ;
    echr:hasDecisionDate "2016-01-25"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_aksoy_1,
        doc:part_fund_2 ;
    echr:hasSupportingQuote "On 25 January 2016, the Supreme Administrative Court rejected the Fund’s request for rectification"^^xsd:string .

doc:proceeding_5 a echr:DomesticProceeding ;
    rdfs:label "Request for rectification of Supreme Administrative Court judgment"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:adminCourt ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeritsDecided ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_aksoy_4,
        doc:part_fund_1 ;
    echr:hasSupportingQuote "On 30 June 2017, the 13 th Chamber of the Supreme Administrative Court granted the request"^^xsd:string .

