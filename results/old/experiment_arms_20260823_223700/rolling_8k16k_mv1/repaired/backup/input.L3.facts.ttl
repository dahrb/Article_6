<https://growgraph.dev/doc/6cb3461d1cd1> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:3"^^xsd:string .

doc:admin_action_4 a echr:AdministrativeAction ;
    rdfs:label "Transfer of Group management"^^xsd:string ;
    echr:followsProceeding doc:admin_action_3 ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2008-09-18"^^xsd:date ;
    echr:hasParticipation doc:part_aksoy_1,
        doc:part_fund_2 ;
    echr:hasSupportingQuote "On 18 September 2008, the Fund further resolved to transfer the management and control of all companies within the Erol Aksoy Group to itself"^^xsd:string .

doc:case_58919_18 a echr:CaseDocument ;
    rdfs:label "Erol Aksoy v. Türkiye"^^xsd:string ;
    echr:hasApplicant doc:erolAksoy ;
    echr:hasApplicationNumber "58919/18"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceeding_1,
        doc:proceeding_2,
        doc:proceeding_3,
        doc:proceeding_4 ;
    echr:hasRespondentState "Türkiye"^^xsd:string .

doc:companyA a echr:Party ;
    rdfs:label "Company A."^^xsd:string .

doc:proceeding_6 a echr:DomesticProceeding ;
    rdfs:label "Individual application to the Constitutional Court"^^xsd:string ;
    echr:followsProceeding doc:enforcement_action_2 ;
    echr:hasCourt doc:constitutionalCourt ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasOutcome echr:OutcomeInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_aksoy_4,
        doc:part_fund_1 ;
    echr:hasProceedingStartDate "2017-09-11"^^xsd:date ;
    echr:hasSupportingQuote "On 11 September 2017, the applicant lodged an individual application with the Constitutional Court... the Constitutional Court declared the application inadmissible."^^xsd:string .

doc:admin_action_1 a echr:AdministrativeAction ;
    rdfs:label "Transfer of İktisat Bank management"^^xsd:string ;
    echr:hasCourt doc:bankingBoard ;
    echr:hasDecisionDate "2001-03-15"^^xsd:date ;
    echr:hasParticipation doc:part_bank_1,
        doc:part_board_1,
        doc:part_fund_1 ;
    echr:hasSupportingQuote "By a decision dated 15 March 2001, the Banking Regulation and Supervision Board... resolved to transfer the management and control of İktisat Bankası T.A.Ş... to the Savings Deposit Insurance Fund"^^xsd:string .

doc:admin_action_10 a echr:AdministrativeAction ;
    rdfs:label "Award of Viva TV-Radio Viva to Company A"^^xsd:string ;
    echr:followsProceeding doc:admin_action_9 ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2012-05-03"^^xsd:date ;
    echr:hasSupportingQuote "on 3 May 2012, the Fund approved the award of Viva TV-Radio Viva to company A."^^xsd:string .

doc:admin_action_2 a echr:AdministrativeAction ;
    rdfs:label "Debt recovery resolution"^^xsd:string ;
    echr:followsProceeding doc:admin_action_1 ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2001-09-14"^^xsd:date ;
    echr:hasParticipation doc:part_aksoy_1,
        doc:part_fund_2 ;
    echr:hasSupportingQuote "on 14 September 2001, the Fund resolved to recover 726,122,000 Turkish liras from the former shareholders"^^xsd:string .

doc:admin_action_3 a echr:AdministrativeAction ;
    rdfs:label "Default declaration"^^xsd:string ;
    echr:followsProceeding doc:admin_action_2 ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2008-04-03"^^xsd:date ;
    echr:hasParticipation doc:part_aksoy_1,
        doc:part_fund_2 ;
    echr:hasSupportingQuote "On 3 April 2008, the Fund concluded that the Erol Aksoy Group had failed to fulfil several commitments... the Fund decided to rely on its provisions concerning default"^^xsd:string .

doc:admin_action_5 a echr:AdministrativeAction ;
    rdfs:label "Establishment of Viva TV and Radio Viva units"^^xsd:string ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2007-07-19"^^xsd:date ;
    echr:hasSupportingQuote "On 19 July 2007, the Fund decided to establish two economic and commercial units: one for Viva TV and the other for Radio Viva."^^xsd:string .

doc:admin_action_6 a echr:AdministrativeAction ;
    rdfs:label "Tendering process for Viva TV and Radio Viva"^^xsd:string ;
    echr:followsProceeding doc:admin_action_5 ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2007-08-29"^^xsd:date ;
    echr:hasSupportingQuote "On 29 August 2007, the Fund resolved to offer both Viva TV and Radio Viva for sale together in a single tendering process"^^xsd:string .

doc:admin_action_7 a echr:AdministrativeAction ;
    rdfs:label "Merger of Viva TV and Radio Viva units"^^xsd:string ;
    echr:followsProceeding doc:admin_action_6 ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2009-07-09"^^xsd:date ;
    echr:hasSupportingQuote "On 9 July 2009, the Fund decided to merge the two economic and commercial units, thereby creating the Viva TV-Radio Viva Economic and Commercial Unit"^^xsd:string .

doc:admin_action_8 a echr:AdministrativeAction ;
    rdfs:label "Tendering process for Viva TV-Radio Viva (2009)"^^xsd:string ;
    echr:followsProceeding doc:admin_action_7 ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2009-11-05"^^xsd:date ;
    echr:hasSupportingQuote "On 5 November 2009, the Fund resolved to offer Viva TV-Radio Viva for sale"^^xsd:string .

doc:admin_action_9 a echr:AdministrativeAction ;
    rdfs:label "Tendering process for Viva TV-Radio Viva (2011)"^^xsd:string ;
    echr:followsProceeding doc:admin_action_8 ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2011-01-13"^^xsd:date ;
    echr:hasSupportingQuote "On 13 January 2011, the Fund decided to offer Viva TV-Radio Viva for sale again"^^xsd:string .

doc:constitutionalCourt a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Constitutional Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Constitutional Court"^^xsd:string .

doc:enforcement_action_1 a echr:EnforcementAction ;
    rdfs:label "Fund's refusal to enforce annulment judgment (October 2015)"^^xsd:string ;
    echr:followsProceeding doc:proceeding_5 ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2015-10-27"^^xsd:date ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "On 18 April 2016, the Fund notified the applicant of a decision taken on 27 October 2015 regarding the impossibility of enforcing the judgment."^^xsd:string .

doc:enforcement_action_2 a echr:EnforcementAction ;
    rdfs:label "Fund's second refusal to enforce annulment judgment (August 2017)"^^xsd:string ;
    echr:followsProceeding doc:enforcement_action_1 ;
    echr:hasCourt doc:sdiFund ;
    echr:hasDecisionDate "2017-08-11"^^xsd:date ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "a decision had already been made on 11 August 2017 regarding the enforcement of the relevant judgment... the annulment decision could not be enforced"^^xsd:string .

