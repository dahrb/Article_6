        doc:participationBeerEsa,
        doc:participationEsaLabour,
        doc:participationReganEsa,
        doc:participation_applicants_labour_2 ;
    echr:hasProceedingStartDate "1993-10-01"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "The Darmstadt Labour Court concluded that the conditions under section 20(2) of the German Courts Act for finding that the applicants’ action was inadmissible were fulfilled."^^xsd:string .

doc:proceedingImmunityChallenge a echr:DomesticProceeding ;
    rdfs:label "challenge to ESA immunity before German labour courts"^^xsd:string ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationApplicantsImmunity,
        doc:participationCommissionImmunity,
        doc:participationGovGermanyImmunity,
        doc:participation_applicants_immunity_2 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "in giving effect to the immunity from jurisdiction of ESA on the basis of section 20(2) of the Courts Act, the German courts did not exceed their margin of appreciation."^^xsd:string,
        "the reasons advanced by the German labour courts to give effect to the immunity from jurisdiction of ESA under Article XV of the ESA Convention and its Annex I cannot be regarded as arbitrary."^^xsd:string .

