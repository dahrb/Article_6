@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/010fe8cca2f6/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/010fe8cca2f6> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:6"^^xsd:string .

doc:caseScholzAgVArmenia a echr:CaseDocument ;
    rdfs:label "Scholz AG v. Armenia"^^xsd:string ;
    echr:hasApplicant doc:applicantScholzAg ;
    echr:hasApplicationNumber "16528/10"^^xsd:string ;
    echr:hasCaseName "Scholz AG v. Armenia"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceeding_1,
        doc:proceeding_appeal_1,
        doc:proceeding_arbitration_1,
        doc:proceeding_cassation_1,
        doc:proceeding_district_1,
        doc:proceeding_yerevan_1 ;
    echr:hasRespondentState "Republic of Armenia"^^xsd:string .

doc:directorLlc a echr:NaturalPerson ;
    rdfs:label "Director of the LLC"^^xsd:string ;
    echr:hasPersonName "the director of the LLC"^^xsd:string .

doc:arbitrationTribunal a echr:DomesticAuthority ;
    rdfs:label "Arbitration Tribunal"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Arbitration Tribunal"^^xsd:string .

doc:civilCourtOfAppeal a echr:DomesticAuthority ;
    rdfs:label "Civil Court of Appeal"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Civil Court of Appeal"^^xsd:string .

doc:commercialCourt a echr:DomesticAuthority ;
    rdfs:label "Commercial Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Commercial Court"^^xsd:string .

doc:courtOfCassation a echr:DomesticAuthority ;
    rdfs:label "Court of Cassation"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Court of Cassation"^^xsd:string .

doc:districtCourtYerevan a echr:DomesticAuthority ;
    rdfs:label "Kentron and Nork-Marash District Court of Yerevan"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Kentron and Nork-Marash District Court of Yerevan"^^xsd:string .

doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Commercial Court Claim 2007"^^xsd:string ;
    echr:hasCourt doc:commercialCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingStartDate "2007-01-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil .

doc:proceeding_cassation_1 a echr:DomesticProceeding ;
    rdfs:label "Court of Cassation 2009"^^xsd:string ;
    echr:followsProceeding doc:proceeding_appeal_1 ;
    echr:hasCourt doc:courtOfCassation ;
    echr:hasDecisionDate "2009-09-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingStartDate "2009-08-04"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:isFinalDomesticDecision true .

doc:yerevanCivilCourt a echr:DomesticAuthority ;
    rdfs:label "Yerevan Civil Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Yerevan Civil Court"^^xsd:string .

doc:llcParty a echr:Party ;
    rdfs:label "the LLC"^^xsd:string ;
    echr:hasPartyName "the LLC"^^xsd:string .

doc:participation_yerevan_1 a echr:Participation ;
    rdfs:label "Scholz AG Participation in District Court"^^xsd:string,
        "Scholz AG Participation in Yerevan Civil Court"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicantScholzAg .

doc:participation_yerevan_2 a echr:Participation ;
    rdfs:label "LLC Participation in District Court"^^xsd:string,
        "LLC Participation in Yerevan Civil Court"^^xsd:string ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:llcParty .

doc:proceeding_appeal_1 a echr:DomesticProceeding ;
    rdfs:label "Civil Court of Appeal 2009"^^xsd:string ;
    echr:followsProceeding doc:proceeding_district_1 ;
    echr:hasCourt doc:civilCourtOfAppeal ;
    echr:hasDecisionDate "2009-07-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingStartDate "2009-06-25"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil .

doc:proceeding_arbitration_1 a echr:DomesticProceeding ;
    rdfs:label "Arbitration Tribunal Claim 2008"^^xsd:string ;
    echr:hasCourt doc:arbitrationTribunal ;
    echr:hasDecisionDate "2008-10-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingStartDate "2008-09-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil .

doc:proceeding_district_1 a echr:DomesticProceeding ;
    rdfs:label "District Court Examination 2009"^^xsd:string ;
    echr:followsProceeding doc:proceeding_yerevan_1 ;
    echr:hasCourt doc:districtCourtYerevan ;
    echr:hasDecisionDate "2009-06-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_yerevan_1,
        doc:participation_yerevan_2 ;
    echr:hasProceedingStartDate "2009-03-13"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil .

doc:proceeding_yerevan_1 a echr:DomesticProceeding ;
    rdfs:label "Yerevan Civil Court Claim 2008"^^xsd:string ;
    echr:followsProceeding doc:proceeding_arbitration_1 ;
    echr:hasCourt doc:yerevanCivilCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:participation_yerevan_1,
        doc:participation_yerevan_2 ;
    echr:hasProceedingStartDate "2008-10-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil .

doc:applicantScholzAg a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Scholz AG"^^xsd:string ;
    echr:hasPartyName "Scholz AG"^^xsd:string .

doc:participation_1 a echr:Participation ;
    rdfs:label "Scholz AG Participation in Appeal"^^xsd:string,
        "Scholz AG Participation in Arbitration"^^xsd:string,
        "Scholz AG Participation in Cassation"^^xsd:string,
        "Scholz AG Participation in proceeding_1"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicantScholzAg .

doc:participation_2 a echr:Participation ;
    rdfs:label "LLC Participation in Appeal"^^xsd:string,
        "LLC Participation in Arbitration"^^xsd:string,
        "LLC Participation in Cassation"^^xsd:string,
        "LLC Participation in proceeding_1"^^xsd:string ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:llcParty .

