    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "the defence also made an application that the evidence of two witnesses, Ivan Baglay and Evgeny Melianuk, be excluded as inadmissible. On 8 February 1999, the judge ruled that the evidence of both witnesses was relevant and admissible"^^xsd:string .

