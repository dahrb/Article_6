doc:appealConvictionSawoniuk a echr:DomesticProceeding ;
    rdfs:label "Appeal against conviction by Anthony SAWONIUK"^^xsd:string ;
    echr:followsProceeding doc:trial_sawoniuk_1999 ;
    echr:hasCourt doc:courtAppealUk ;
    echr:hasDecisionDate "2000-02-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationSawoniukAppeal ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "As regards the allegations that the judge should have excluded evidence of witnesses... it held that this evidence was relevant"^^xsd:string,
        "As regards the judge’s failure to stay the proceedings for abuse, the Court of Appeal found that he had correctly applied his discretion"^^xsd:string,
        "In its judgment of 10 February 2000, the Court of Appeal rejected the applicant’s appeal"^^xsd:string,
        "The Court of Appeal found no basis to fault the judge’s approach to the evidence concerning Mr Zan’s identification of the applicant"^^xsd:string .

doc:applicationStayOfTrial a echr:DomesticProceeding ;
    rdfs:label "Application to stay trial"^^xsd:string ;
    echr:hasCourt doc:courtPotts ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "the trial should be stayed as an abuse on the basis that due inter alia to the lapse of time since events the applicant could not obtain a fair trial. The application was refused by the trial judge"^^xsd:string .

