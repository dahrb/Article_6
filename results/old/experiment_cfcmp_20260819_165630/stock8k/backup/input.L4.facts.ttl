@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/8bada6ac84cf/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/8bada6ac84cf> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:4"^^xsd:string .

doc:caseMatko a echr:CaseDocument ;
    rdfs:label "Matko v. Slovenia"^^xsd:string ;
    echr:hasApplicant doc:applicantMatko ;
    echr:hasApplicationNumber "43393/98"^^xsd:string ;
    echr:hasDomesticProceeding doc:appeal_maribor_1,
        doc:appeal_maribor_2,
        doc:complaint_police_1,
        doc:cost_order_1,
        doc:proceedingCriminalMatko,
        doc:prosecution_investigation_1,
        doc:retrial_first_instance_1,
        doc:trial_first_instance_1 ;
    echr:hasRespondentState "Republic of Slovenia"^^xsd:string .

doc:sentence_duration_1 a echr:DomesticProceeding ;
    rdfs:label "sentence duration"^^xsd:string ;
    echr:hasExtractionNote "3 months imprisonment, suspended for 3 years"^^xsd:string .

doc:complaint_matko_1 a echr:DomesticProceeding ;
    rdfs:label "Criminal complaint by Mr Aleksander Matko"^^xsd:string ;
    echr:hasCourt doc:slovenjGradecPolice ;
    echr:hasDecisionDate "1995-04-07"^^xsd:date ;
    echr:hasExtractionNote "Proceeding initiated as an oral complaint"^^xsd:string ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 7 April 1995 the applicant went to the Slovenj Gradec Police and made an oral complaint"^^xsd:string .

doc:cost_order_1 a echr:DomesticProceeding ;
    rdfs:label "final cost order"^^xsd:string ;
    echr:followsProceeding doc:appeal_maribor_2 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "2001-10-11"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelEnforcement ;
    echr:hasProceedingType echr:TypeOther ;
    echr:hasSupportingQuote "on 11 October 2001 the Slovenj Gradec District Court ordered the applicant to pay an additional sum to cover the costs... the proceedings were “finally concluded”"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:detention_matko_1 a echr:PreTrialDetention ;
    rdfs:label "Detention of Aleksander Matko April 1995"^^xsd:string ;
    echr:hasCustodialMeasure echr:MeasurePoliceCustody ;
    echr:hasDetainee doc:applicantMatko ;
    echr:hasDetentionEndDate "1995-04-06"^^xsd:date ;
    echr:hasDetentionStartDate "1995-04-05"^^xsd:date ;
    echr:hasSupportingQuote "the applicant... was arrested in Slovenj Gradec... He was brought to the Slovenj Gradec Police Station... and released on 6 April 1995"^^xsd:string .

doc:participation_complaint_1 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicantMatko .

doc:participation_matko_1 a echr:Participation ;
    rdfs:label "Participation of Aleksander Matko in criminal proceedings"^^xsd:string ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:applicantMatko .

doc:proceedingCriminalMatko a echr:DomesticProceeding ;
    rdfs:label "Criminal proceedings against Mr Aleksander Matko"^^xsd:string ;
    echr:followsProceeding doc:complaint_matko_1 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "2001-02-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasParticipation doc:participation_matko_1 ;
    echr:hasPreTrialDetention doc:detention_matko_1 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "The judgment of 12 February 2001 issued in the proceedings instituted against the applicant"^^xsd:string .

doc:appeal_maribor_1 a echr:DomesticProceeding ;
    rdfs:label "first appeal to Maribor Higher Court"^^xsd:string ;
    echr:followsProceeding doc:trial_first_instance_1 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "2000-09-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "on 27 September 2000 the Maribor Higher Court quashed the judgment and remitted the case to a new panel for retrial."^^xsd:string .

doc:appeal_maribor_2 a echr:DomesticProceeding ;
    rdfs:label "second appeal to Maribor Higher Court"^^xsd:string ;
    echr:followsProceeding doc:retrial_first_instance_1 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "2001-05-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 9 May 2001 the Maribor Higher Court upheld the conviction"^^xsd:string .

doc:complaint_police_1 a echr:DomesticProceeding ;
    rdfs:label "criminal complaint against police officers"^^xsd:string ;
    echr:hasCourt doc:slovenjGradecPolice ;
    echr:hasDecisionDate "1997-01-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_complaint_1 ;
    echr:hasProceedingStartDate "1995-05-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 17 January 1997 the Public Prosecutor issued a decision dismissing the applicant’s criminal complaint."^^xsd:string .

doc:prosecution_investigation_1 a echr:DomesticProceeding ;
    rdfs:label "criminal investigation against the applicant"^^xsd:string ;
    echr:followsProceeding doc:complaint_police_1 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "1997-05-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingStartDate "1997-01-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 8 May 1997... the Slovenj Gradec District Court decided not to open a criminal investigation against the applicant."^^xsd:string .

doc:retrial_first_instance_1 a echr:DomesticProceeding ;
    rdfs:label "retrial before Slovenj Gradec District Court"^^xsd:string ;
    echr:followsProceeding doc:appeal_maribor_1 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "2001-02-12"^^xsd:date ;
    echr:hasExtractionNote "Sentence: 3 months imprisonment, suspended for 3 years."^^xsd:string ;
    echr:hasInstanceLevel echr:LevelReopening ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasStatedDetentionDuration "P3M"^^xsd:duration ;
    echr:hasSupportingQuote "By a judgment of 12 February 2001, the Slovenj Gradec District Court convicted the applicant as charged"^^xsd:string .

doc:slovenjGradecPolice a echr:DomesticAuthority ;
    rdfs:label "Slovenj Gradec District Public Prosecutor’s Office"^^xsd:string,
        "Slovenj Gradec Police"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasJurisdictionState "Slovenia"^^xsd:string .

doc:trial_first_instance_1 a echr:DomesticProceeding ;
    rdfs:label "first instance trial"^^xsd:string ;
    echr:followsProceeding doc:prosecution_investigation_1 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "1999-11-22"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeAcquittal ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "By a judgment of 22 November 1999 the court acquitted the applicant."^^xsd:string .

doc:applicantMatko a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Aleksander Matko"^^xsd:string,
        "Mr Aleksander Matko"^^xsd:string ;
    echr:hasPersonName "Mr Aleksander Matko"^^xsd:string .

doc:mariborHigherCourt a echr:DomesticAuthority ;
    rdfs:label "Domestic Court"^^xsd:string,
        "Maribor Higher Court"^^xsd:string,
        "Slovenj Gradec District Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasJurisdictionState "Slovenia"^^xsd:string .

