@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/a139d296d364/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://qudt.org/schema/qudt/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/a139d296d364> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:9"^^xsd:string .

doc:case_1 a echr:CaseDocument ;
    rdfs:label "Malkhaz BADUASHVILI against Georgia"^^xsd:string ;
    echr:hasApplicant doc:applicant_1 ;
    echr:hasApplicationNumber "18720/08"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceeding_1,
        doc:proceeding_2 ;
    echr:hasRespondentState "Georgia"^^xsd:string .

doc:case_document_1 a echr:CaseDocument ;
    echr:hasDomesticProceeding doc:investigation_ill_treatment_1,
        doc:proceeding_appeal_1,
        doc:proceeding_mt_1,
        doc:proceeding_supreme_court_1,
        doc:proceeding_zt_1 .

doc:cellCapacityActualMax a ns1:QuantityValue ;
    rdfs:label "approximate actual capacity maximum"^^xsd:string ;
    ns1:numericValue 80 .

doc:cellCapacityActualMin a ns1:QuantityValue ;
    rdfs:label "approximate actual capacity minimum"^^xsd:string ;
    ns1:numericValue 70 .

doc:cellCapacityIntended a ns1:QuantityValue ;
    rdfs:label "intended capacity"^^xsd:string ;
    ns1:numericValue 26 .

doc:mt_1 a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "M.T."^^xsd:string .

doc:participation_1 a echr:Participation ;
    rdfs:comment "Paragraph 25"^^xsd:string ;
    echr:hasPartySide echr:SideResponding ;
    echr:hasSupportingQuote "during the trial at the first-instance court"^^xsd:string,
        "the Tbilisi Court of Appeal upheld the applicant’s conviction."^^xsd:string ;
    echr:participatingParty doc:applicant_1 .

doc:participation_2 a echr:Participation ;
    rdfs:comment "Paragraph 26"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "an appeal on points of law lodged by the applicant"^^xsd:string ;
    echr:participatingParty doc:applicant_1 .

doc:prison_cell_1 a echr:AdministrativeAction ;
    rdfs:label "Prison Cell Accommodation"^^xsd:string ;
    rdfs:comment "Paragraph 29"^^xsd:string ;
    echr:hasSupportingQuote "the cell intended for 26 persons was accommodating approximately 70-80 inmates"^^xsd:string .

doc:prosecution_review_1 a echr:ProsecutorialReview ;
    rdfs:label "investigator refusal to question M.T."^^xsd:string ;
    echr:hasDecisionDate "2005-10-29"^^xsd:date ;
    echr:hasSupportingQuote "On 29 October 2005 M.T.’s request was rejected by the investigator"^^xsd:string .

doc:sentence_1 a echr:DomesticProceeding ;
    rdfs:label "sentencing of Malkhaz Baduashvili"^^xsd:string ;
    doc:sentenceDuration "P17Y"^^xsd:duration ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasSupportingQuote "sentenced him to 17 years’ imprisonment"^^xsd:string .

doc:zt_1 a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Z.T."^^xsd:string .

doc:courtSupremeCourt a echr:DomesticAuthority ;
    rdfs:label "Supreme Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Supreme Court"^^xsd:string ;
    echr:hasJurisdictionState "Georgia"^^xsd:string .

doc:courtTbilisiAppeal a echr:DomesticAuthority ;
    rdfs:label "Tbilisi Court of Appeal"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Tbilisi Court of Appeal"^^xsd:string ;
    echr:hasJurisdictionState "Georgia"^^xsd:string .

doc:court_1 a echr:DomesticAuthority ;
    rdfs:label "court of first instance"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "court of first instance"^^xsd:string ;
    echr:hasJurisdictionState "Georgia"^^xsd:string .

doc:detention_1 a echr:PreTrialDetention ;
    rdfs:label "remand in custody of Malkhaz Baduashvili"^^xsd:string ;
    echr:hasCustodialMeasure echr:MeasureRemandInCustody ;
    echr:hasDetainee doc:applicant_1 ;
    echr:hasDetentionStartDate "2005-07-27"^^xsd:date ;
    echr:hasSupportingQuote "He was arrested and remanded in custody on 27 July 2005"^^xsd:string .

doc:investigation_ill_treatment_1 a echr:DomesticProceeding ;
    rdfs:label "Investigation into allegations of ill-treatment"^^xsd:string ;
    rdfs:comment "Paragraph 40"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingStartDate "2010-08-31"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 31 August 2010 an investigation was opened into the applicant’s allegations."^^xsd:string ;
    echr:isPending true .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "appeal against conviction"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "The applicant appealed, arguing that there was insufficient evidence to convict him"^^xsd:string .

doc:proceeding_mt_1 a echr:DomesticProceeding ;
    rdfs:label "Criminal proceedings against M.T."^^xsd:string ;
    rdfs:comment "Paragraph 27"^^xsd:string ;
    echr:hasDecisionDate "2006-12-26"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 26 December 2006... they were convicted at first instance of obstructing justice by giving false testimony."^^xsd:string .

doc:proceeding_supreme_court_1 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court appeal on points of law"^^xsd:string ;
    rdfs:comment "Paragraph 26"^^xsd:string ;
    echr:followsProceeding doc:proceeding_appeal_1 ;
    echr:hasCourt doc:courtSupremeCourt ;
    echr:hasDecisionDate "2008-02-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 20 February 2008 the Supreme Court declared an appeal on points of law lodged by the applicant inadmissible."^^xsd:string .

doc:proceeding_zt_1 a echr:DomesticProceeding ;
    rdfs:label "Criminal proceedings against Z.T."^^xsd:string ;
    rdfs:comment "Paragraph 27"^^xsd:string ;
    echr:hasDecisionDate "2007-01-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On... 23 January 2007 respectively they were convicted at first instance of obstructing justice by giving false testimony."^^xsd:string .

doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "first-instance trial"^^xsd:string ;
    echr:hasCourt doc:court_1 ;
    echr:hasDecisionDate "2006-12-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasPreTrialDetention doc:detention_1 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 8 December 2006 the court of first instance convicted the applicant of aggravated murder"^^xsd:string .

doc:proceeding_appeal_1 a echr:DomesticProceeding ;
    rdfs:label "Tbilisi Court of Appeal proceedings"^^xsd:string ;
    rdfs:comment "Paragraph 25"^^xsd:string ;
    echr:hasCourt doc:courtTbilisiAppeal ;
    echr:hasDecisionDate "2007-06-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 27 June 2007 the Tbilisi Court of Appeal upheld the applicant’s conviction."^^xsd:string .

doc:applicant_1 a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Malkhaz Baduashvili"^^xsd:string,
        "the applicant"^^xsd:string ;
    echr:hasPersonName "Mr Malkhaz Baduashvili"^^xsd:string .

