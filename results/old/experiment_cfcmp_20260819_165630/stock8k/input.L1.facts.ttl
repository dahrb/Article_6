@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/8c2d2ca0edc1/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/ns/qudt/ontology/> .
@prefix ns2: <http://www.qudt.org/schema/qudt/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/8c2d2ca0edc1> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:1"^^xsd:string .

doc:allowance_1 a ns1:QuantityValue ;
    rdfs:label "monthly social allowance 2007"^^xsd:string ;
    ns1:numericValue 16.5 ;
    ns1:unit doc:unitBgn .

doc:allowance_2 a ns1:QuantityValue ;
    rdfs:label "increased monthly social allowance 2009"^^xsd:string ;
    ns1:numericValue 19.5 ;
    ns1:unit doc:unitBgn .

doc:allowance_eur_approx_1 a ns1:QuantityValue ;
    rdfs:label "monthly social allowance 2007 in euros approximation"^^xsd:string ;
    ns1:numericValue 8.0 ;
    ns1:unit doc:unitEur .

doc:allowance_eur_approx_2 a ns1:QuantityValue ;
    rdfs:label "increased monthly social allowance 2009 in euros approximation"^^xsd:string ;
    ns1:numericValue 10.0 ;
    ns1:unit doc:unitEur .

doc:caseStanevBulgaria a echr:CaseDocument ;
    rdfs:label "Case of Stanev v. Bulgaria"^^xsd:string ;
    echr:hasApplicant doc:stanev ;
    echr:hasApplicationNumber "36760/06"^^xsd:string ;
    echr:hasDomesticProceeding doc:guardianship_appointment_1,
        doc:guardianship_appointment_2,
        doc:medical_assessment_1,
        doc:proceeding_1,
        doc:proceeding_2 ;
    echr:hasRespondentState "Republic of Bulgaria"^^xsd:string .

doc:case_1 a echr:CaseDocument ;
    rdfs:label "Case of the applicant regarding Pastra social care home"^^xsd:string ;
    echr:hasDomesticProceeding doc:admin_action_1,
        doc:district_court_proceeding_1,
        doc:prosecution_review_1,
        doc:prosecution_review_2,
        doc:prosecution_review_3 .

doc:disablement_value_1 a ns2:QuantityValue ;
    rdfs:label "degree of disablement"^^xsd:string ;
    ns2:numericValue 90 ;
    rdfs:comment "percent"^^xsd:string .

doc:journeyCostEurApprox a ns1:QuantityValue ;
    rdfs:label "journey cost to Ruse in euros approximation"^^xsd:string ;
    ns1:numericValue 30.0 ;
    ns1:unit doc:unitEur .

doc:journey_cost_1 a ns1:QuantityValue ;
    rdfs:label "journey cost to Ruse"^^xsd:string ;
    ns1:numericValue 60.0 ;
    ns1:unit doc:unitBgn .

doc:pensionEuroApprox a ns1:QuantityValue ;
    rdfs:label "applicant's pension in euros approximation"^^xsd:string ;
    ns1:numericValue 65.0 ;
    ns1:unit doc:unitEur .

doc:pension_value_1 a ns1:QuantityValue ;
    rdfs:label "applicant's updated invalidity pension 2008"^^xsd:string ;
    ns1:numericValue 130.0 ;
    ns1:unit doc:unitBgn .

doc:district_court_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Dupnitsa District Court judicial review"^^xsd:string ;
    echr:followsProceeding doc:admin_action_1 ;
    echr:hasCourt doc:ruseRegionalCourt ;
    echr:hasDecisionDate "2006-03-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_3 ;
    echr:hasProceedingStartDate "2005-09-28"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "The Dupnitsa District Court gave judgment on 10 March 2006. ... the court dismissed the application"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:guardianship_appointment_1 a echr:AdministrativeAction ;
    rdfs:label "Appointment of guardian Ms R.P."^^xsd:string ;
    echr:hasCourt doc:ruseMunicipalCouncil ;
    echr:hasDecisionDate "2002-05-23"^^xsd:date ;
    echr:hasSupportingQuote "on 23 May 2002 the Municipal Council appointed Ms R.P., a council officer, as the applicant’s guardian"^^xsd:string .

doc:guardianship_appointment_2 a echr:AdministrativeAction ;
    rdfs:label "Appointment of Pastra home Director as guardian"^^xsd:string ;
    echr:hasCourt doc:rilaMunicipalCouncil ;
    echr:hasDecisionDate "2005-02-02"^^xsd:date ;
    echr:hasSupportingQuote "the Municipal Council had decided on 2 February 2005 to appoint the Director of the Pastra social care home as the applicant’s guardian"^^xsd:string .

doc:lawyer_1 a echr:LegalRepresentative ;
    rdfs:label "the applicant's lawyer"^^xsd:string .

doc:mayor_rila_1 a echr:DomesticAuthority ;
    rdfs:label "mayor of Rila"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

doc:medical_assessment_1 a echr:AdministrativeAction ;
    rdfs:label "Occupational fitness assessment"^^xsd:string ;
    rdfs:comment "Found the applicant had a 90% degree of disablement"^^xsd:string ;
    echr:hasCourt doc:medical_panel_1 ;
    echr:hasDecisionDate "1990-12-20"^^xsd:date ;
    echr:hasSupportingQuote "On 20 December 1990 a panel of occupational physicians declared him unfit to work."^^xsd:string .

doc:medical_panel_1 a echr:DomesticAuthority ;
    rdfs:label "Panel of occupational physicians"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "panel of occupational physicians"^^xsd:string ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

doc:participation_3 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "the applicant’s lawyer applied to the Dupnitsa District Court"^^xsd:string ;
    echr:participatingParty doc:applicant_1 .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Appeal against partial incapacity declaration"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:ruseRegionalCourt ;
    echr:hasDecisionDate "2001-04-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_2 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "That judgment was upheld in a judgment of 12 April 2001 by the Veliko Tarnovo Court of Appeal"^^xsd:string .

doc:prosecution_review_3 a echr:ProsecutorialReview ;
    rdfs:label "Supreme Court of Cassation Prosecutor's review"^^xsd:string ;
    echr:followsProceeding doc:prosecution_review_2 ;
    echr:hasCourt doc:prosecutor_supreme_1 ;
    echr:hasDecisionDate "2005-11-29"^^xsd:date ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "subsequently on 29 November 2005 by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation"^^xsd:string .

doc:rilaMunicipalCouncil a echr:DomesticAuthority ;
    rdfs:label "Rila Municipal Council"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityMunicipal ;
    echr:hasAuthorityName "Rila Municipal Council"^^xsd:string ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

doc:ruseMunicipalCouncil a echr:DomesticAuthority ;
    rdfs:label "Ruse Municipal Council"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityMunicipal ;
    echr:hasAuthorityName "Ruse Municipal Council"^^xsd:string ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

doc:admin_action_1 a echr:AdministrativeAction ;
    rdfs:label "Mayor of Rila's decision on release from guardianship"^^xsd:string ;
    echr:hasCourt doc:mayor_rila_1 ;
    echr:hasDecisionDate "2005-09-16"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_2 ;
    echr:hasSupportingQuote "In a letter of 16 September 2005, the mayor of Rila refused his request"^^xsd:string .

doc:participation_1 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating,
        echr:SideResponding ;
    echr:hasSupportingQuote "the applicant, through his lawyer, asked the public prosecutor’s office"^^xsd:string ;
    echr:participatingParty doc:applicant_1,
        doc:stanev .

doc:participation_2 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "the applicant, through his lawyer, asked the mayor of Rila"^^xsd:string ;
    echr:participatingParty doc:applicant_1,
        doc:stanev .

doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Declaration of partial legal incapacity proceeding"^^xsd:string ;
    echr:hasCourt doc:ruseRegionalCourt ;
    echr:hasDecisionDate "2000-11-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasStatusApplied echr:StatusPartialIncapacity ;
    echr:hasSupportingQuote "In a judgment of 20 November 2000, the court declared the applicant to be partially incapacitated"^^xsd:string .

doc:prosecution_review_1 a echr:ProsecutorialReview ;
    rdfs:label "Regional Prosecutor's review on legal capacity restoration"^^xsd:string ;
    echr:hasCourt doc:prosecutor_supreme_1 ;
    echr:hasDecisionDate "2005-08-10"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasSupportingQuote "On 10 August 2005 the regional prosecutor refused to bring an action for restoration of the applicant’s legal capacity"^^xsd:string .

doc:prosecution_review_2 a echr:ProsecutorialReview ;
    rdfs:label "Appellate Prosecutor's review"^^xsd:string ;
    echr:followsProceeding doc:prosecution_review_1 ;
    echr:hasCourt doc:prosecutor_supreme_1 ;
    echr:hasDecisionDate "2005-10-11"^^xsd:date ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "the regional prosecutor’s refusal was upheld on 11 October 2005 by the appellate prosecutor"^^xsd:string .

doc:applicant_1 a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "the applicant"^^xsd:string ;
    echr:isRepresentedBy doc:lawyer_1 .

doc:prosecutor_supreme_1 a echr:DomesticAuthority ;
    rdfs:label "Chief Public Prosecutor’s Office at the Supreme Court of Cassation"^^xsd:string,
        "appellate prosecutor"^^xsd:string,
        "regional prosecutor"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

doc:ruseRegionalCourt a echr:DomesticAuthority ;
    rdfs:label "Dupnitsa District Court"^^xsd:string,
        "Ruse Regional Court"^^xsd:string,
        "Veliko Tarnovo Court of Appeal"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Ruse Regional Court ( Окръжен съд )"^^xsd:string,
        "Veliko Tarnovo Court of Appeal ( Апелативен съд )"^^xsd:string ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

doc:stanev a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Mr Rusi Kosev Stanev"^^xsd:string ;
    echr:hasPersonName "Mr Rusi Kosev Stanev"^^xsd:string .

doc:unitBgn a ns1:Unit ;
    rdfs:label "Bulgarian levs (BGN)"^^xsd:string .

doc:unitEur a ns1:Unit ;
    rdfs:label "euros (EUR)"^^xsd:string .

