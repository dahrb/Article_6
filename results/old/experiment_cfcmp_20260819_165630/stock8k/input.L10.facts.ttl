    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Brussels Dutch-speaking TPI"^^xsd:string ;
    echr:hasJurisdictionState "Belgium"^^xsd:string .

doc:conseilDEtat a echr:DomesticAuthority ;
    rdfs:label "the Conseil d’État"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial .

doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Urgent application for stay of execution"^^xsd:string ;
    rdfs:comment "Paragraph 15"^^xsd:string ;
    echr:followsProceeding doc:admin_action_1 ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2016-10-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 7 October 2016 the Aliens Appeals Board, acting under the extremely urgent procedure, ordered a stay of execution of the refusals"^^xsd:string .

doc:proceeding_10 a echr:DomesticProceeding ;
    rdfs:label "TPI Brussels judgment of 7 November 2016"^^xsd:string ;
    echr:followsProceeding doc:proceeding_9 ;
    echr:hasCourt doc:tpiBrussels ;
    echr:hasDecisionDate "2016-11-07"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "On 7 November 2016 another judge acting as president of the French-language TPI declared their application admissible but unfounded"^^xsd:string .

doc:proceeding_9 a echr:DomesticProceeding ;
    rdfs:label "TPI Brussels order of 25 October 2016"^^xsd:string ;
    echr:followsProceeding doc:proceeding_6 ;
    echr:hasCourt doc:tpiBrussels ;
    echr:hasDecisionDate "2016-10-25"^^xsd:date ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasSupportingQuote "By an order of 25 October 2016... the acting president of the French-language TPI ordered the State... to comply with the Board’s judgment of 20 October 2016"^^xsd:string .

doc:tpiBrussels a echr:DomesticAuthority ;
    rdfs:label "the Brussels French-language Court of First Instance"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial .

doc:proceeding_1 a echr:AdministrativeAction,
        echr:DomesticProceeding ;
    rdfs:label "Action for stay of execution (13 Dec 2016)"^^xsd:string,
        "Aliens Appeals Board proceeding"^^xsd:string,
        "Aliens Office visa refusal decisions of 10 October 2016"^^xsd:string ;
    rdfs:comment "Paragraph 37"^^xsd:string,
        "paragraph 75"^^xsd:string ;
    echr:hasCourt doc:aliensAppealsBoard,
        doc:aliensOffice,
        doc:brusselsDutchTpi ;
    echr:hasDecisionDate "2016-10-10"^^xsd:date,
        "2016-10-20"^^xsd:date,
        "2016-12-13"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview,
        echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed,
        echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant,
        echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative,
        echr:TypeCivil ;
    echr:hasSupportingQuote "lodged a unilateral action to that effect with the President of the Brussels Dutch-speaking TPI on 13 December 2016, but was unsuccessful (order of the same date)"^^xsd:string,
        "the Aliens Appeals Board’s judgment of 20 October 2016, which had instructed the Belgian authorities to issue them with the visas they had requested"^^xsd:string,
        "the Aliens Office issued new decisions, dated 10 October 2016, refusing to grant the visas"^^xsd:string .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board urgent procedure on 14 October 2016"^^xsd:string,
        "Appeal against stay of execution refusal"^^xsd:string,
        "Brussels Court of Appeal proceeding"^^xsd:string ;
    rdfs:comment "Paragraph 37"^^xsd:string,
        "paragraph 75"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:aliensAppealsBoard,
        doc:brusselsCourtOfAppeal ;
    echr:hasDecisionDate "2016-10-14"^^xsd:date,
        "2016-12-07"^^xsd:date,
        "2016-12-14"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal,
        echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimGranted,
        echr:OutcomeMeasureImposed,
        echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative,
        echr:TypeCivil ;
    echr:hasSupportingQuote "By a judgment of 14 October 2016 the Aliens Appeals Board, acting under the extremely urgent procedure, again ordered a stay of execution"^^xsd:string,
        "on an appeal by the Belgian State, the court of appeal varied the decision of the first-instance court in a judgment of 14 December 2016"^^xsd:string,
        "the Brussels Court of Appeal’s judgment of 7 December 2016 ordering the Belgian State to execute the Aliens Appeals Board’s judgment of 20 October 2016"^^xsd:string .

doc:proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "Belgian State's action before Dutch-language TPI"^^xsd:string,
        "Conseil d’État appeal on 17 May 2018 (regarding March 24 decision)"^^xsd:string ;
    rdfs:comment "Paragraph 39"^^xsd:string ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:brusselsDutchTpi,
        doc:conseilDEtat ;
    echr:hasDecisionDate "2018-05-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal,
        echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2016-12-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "An administrative appeal on points of law lodged by the applicants against that judgment was dismissed by the Conseil d’État on 17 May 2018"^^xsd:string,
        "On the same date the Belgian State brought proceedings against the applicants before the enforcement judge at the Brussels Dutch-language TPI"^^xsd:string .

doc:proceeding_5 a echr:AdministrativeAction,
        echr:DomesticProceeding ;
    rdfs:label "Aliens Office visa refusal decisions of 17 October 2016"^^xsd:string,
        "Appeal regarding jurisdiction and operative status"^^xsd:string ;
    rdfs:comment "Paragraph 40"^^xsd:string ;
    echr:followsProceeding doc:proceeding_4 ;
    echr:hasCourt doc:aliensOffice,
        doc:brusselsCourtOfAppeal ;
    echr:hasDecisionDate "2016-10-17"^^xsd:date,
        "2017-06-30"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "By a judgment of 30 June 2017 a Dutch-language division of the Court of Appeal held that the Aliens Appeals Boards’ judgment of 20 October 2016 was no longer operative"^^xsd:string,
        "On 17 October 2016 the Aliens Office again took decisions refusing to issue the visas"^^xsd:string .

doc:aliensOffice a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Aliens Office"^^xsd:string,
        "the Aliens Office"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "Aliens Office"^^xsd:string ;
    echr:hasJurisdictionState "Belgium"^^xsd:string .

doc:brusselsCourtOfAppeal a echr:DomesticAuthority ;
    rdfs:label "Brussels Court of Appeal"^^xsd:string,
        "the Brussels Court of Appeal"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Brussels Court of Appeal"^^xsd:string ;
    echr:hasJurisdictionState "Belgium"^^xsd:string .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board proceeding on 24 March 2017 (regarding Oct 10 decisions)"^^xsd:string,
        "Applicants' action before French-language TPI"^^xsd:string ;
    rdfs:comment "Paragraph 38, 42"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2,
        doc:proceeding_6 ;
    echr:hasCourt doc:aliensAppealsBoard,
        doc:brusselsFrenchTpi ;
    echr:hasDecisionDate "2017-03-24"^^xsd:date,
        "2017-12-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed,
        echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant,
        echr:DirectionUnknown ;
    echr:hasProceedingStartDate "2016-12-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "By a judgment of 24 March 2017 the Aliens Appeals Board dismissed the application to have the decisions set aside"^^xsd:string,
        "On 15 December 2016 the applicants brought an action against the Belgian State before the enforcement judge at the Brussels French-language TPI... On 20 December 2017 the French-language enforcement judge... found that the case had become devoid of purpose"^^xsd:string,
        "On 24 March 2017 the Aliens Appeals Board dismissed the application to have those decisions set aside"^^xsd:string .

doc:proceeding_6 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board judgment of 20 October 2016"^^xsd:string,
        "Appeal on points of law (pending)"^^xsd:string ;
    rdfs:comment "Paragraph 36"^^xsd:string ;
    echr:followsProceeding doc:proceeding_5 ;
    echr:hasCourt doc:aliensAppealsBoard,
        doc:brusselsCourtOfAppeal ;
    echr:hasDecisionDate "2016-10-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingStartDate "2017-02-27"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "By a judgment of 20 October 2016 the Aliens Appeals Board... ordered a stay of execution of the refusal decisions of 17 October 2016"^^xsd:string,
        "On 27 February 2017 the Belgian State lodged an appeal on points of law against the court of appeal’s judgment of 7 December 2016. Those proceedings are currently pending."^^xsd:string ;
    echr:isPending true .

