    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "Belgian State"^^xsd:string ;
    echr:hasJurisdictionState "Belgium"^^xsd:string ;
    echr:hasPartyName "the Belgian State"^^xsd:string .

