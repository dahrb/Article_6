doc:case_3599_18 a echr:CaseDocument ;
    echr:hasApplicationNumber "3599/18"^^xsd:string ;
    echr:hasCaseName "M.N. and Others against Belgium"^^xsd:string ;
    echr:hasDomesticProceeding doc:admin_action_1,
        doc:domestic_proceeding_1,
        doc:domestic_proceeding_2,
        doc:visa_app_dec_2016 ;
    echr:hasRespondentState "Belgium"^^xsd:string .

doc:case_document_1 a echr:CaseDocument ;
    echr:hasDomesticProceeding doc:proceeding_1,
        doc:proceeding_2,
        doc:proceeding_3,
        doc:proceeding_4,
        doc:proceeding_5,
        doc:proceeding_6 .

doc:part_1 a echr:Participation ;
    rdfs:comment "Paragraph 36"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "the Belgian State lodged an appeal"^^xsd:string ;
    echr:participatingParty doc:belgianState .

doc:part_2 a echr:Participation ;
    rdfs:comment "Paragraph 39"^^xsd:string ;
    echr:hasPartySide echr:SideResponding ;
    echr:hasSupportingQuote "the Belgian State brought proceedings against the applicants"^^xsd:string ;
    echr:participatingParty doc:applicants .

doc:participation_1 a echr:Participation ;
    rdfs:comment "paragraph 74"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "the applicants complained that the Belgian authorities’ refusal to issue them with the so-called ‘humanitarian’ visas"^^xsd:string ;
    echr:participatingParty doc:applicants .

doc:participation_2 a echr:Participation ;
    rdfs:comment "paragraph 75"^^xsd:string ;
    echr:hasPartySide echr:SideResponding ;
    echr:hasSupportingQuote "ordering the Belgian State to execute the Aliens Appeals Board’s judgment"^^xsd:string ;
    echr:participatingParty doc:belgianState .

doc:penalty_1 a echr:DomesticEvent ;
    rdfs:label "penalty payment for non-compliance"^^xsd:string ;
    doc:penaltyValue 1000.0 ;
    echr:hasSupportingQuote "a penalty payment of 1,000 euros (EUR) per day of delay and per applicant"^^xsd:string .

doc:brusselsFrenchTpi a echr:DomesticAuthority ;
    rdfs:label "Brussels French-language TPI"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Brussels French-language TPI"^^xsd:string ;
    echr:hasJurisdictionState "Belgium"^^xsd:string .

doc:domestic_proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Decision to lift stay of execution"^^xsd:string ;
    rdfs:comment "Paragraph 16"^^xsd:string ;
    echr:followsProceeding doc:domestic_proceeding_1 ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2017-03-06"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 6 March 2017 the Aliens Appeals Board... decided in consequence to lift the stay of execution of the visa refusal decisions"^^xsd:string .

doc:proceeding_11 a echr:DomesticProceeding ;
    rdfs:label "Brussels Court of Appeal judgment of 7 December 2016"^^xsd:string ;
    echr:followsProceeding doc:proceeding_10 ;
    echr:hasCourt doc:brusselsCourtOfAppeal ;
    echr:hasDecisionDate "2016-12-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasSupportingQuote "the Brussels Court of Appeal delivered a judgment on 7 December 2016 varying the order of 7 November 2016"^^xsd:string .

doc:proceeding_8 a echr:DomesticProceeding ;
    rdfs:label "Conseil d’État appeal on 17 May 2018 (regarding Oct 20 case)"^^xsd:string ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:conseilDEtat ;
    echr:hasDecisionDate "2018-05-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "An appeal on points of law against this judgment was dismissed by the Conseil d’État in a judgment of 17 May 2018"^^xsd:string .

doc:visa_app_dec_2016 a echr:AdministrativeAction ;
    rdfs:label "Second visa application rejection"^^xsd:string ;
    rdfs:comment "Paragraph 13"^^xsd:string ;
    echr:hasCourt doc:aliensOffice ;
    echr:hasDecisionDate "2016-12"^^xsd:gYearMonth ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "The applicants subsequently submitted such an application, which was rejected by the Belgian authorities in December 2016"^^xsd:string .

doc:admin_action_1 a echr:AdministrativeAction ;
    rdfs:label "Visa refusal decision"^^xsd:string ;
    rdfs:comment "Paragraph 11"^^xsd:string ;
    echr:hasCourt doc:aliensOffice ;
    echr:hasDecisionDate "2016-09-13"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "On 13 September 2016 the Aliens Office... refused to grant “humanitarian visas” to the applicants"^^xsd:string .

doc:applicants a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "the applicants"^^xsd:string ;
    echr:hasPartyName "the applicants"^^xsd:string ;
    echr:hasSupportingQuote "a married couple and their two minor children, all Syrian nationals ('the applicants')"^^xsd:string .

doc:belgianState a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Belgian State"^^xsd:string,
