@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/0cb5e9d8e5ce/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/ns/qudt/ontology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/0cb5e9d8e5ce> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:2"^^xsd:string .

doc:caseBeerRegan a echr:CaseDocument ;
    rdfs:label "Beer and Regan v. Germany"^^xsd:string ;
    echr:hasApplicant doc:applicantBeer,
        doc:philipRegan ;
    echr:hasApplicationNumber "28934/95"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceedingDarmstadtLabourCourt ;
    echr:hasRespondentState "Federal Republic of Germany"^^xsd:string .

doc:case_28934_95 a echr:CaseDocument ;
    echr:hasApplicant doc:applicantBeer,
        doc:philipRegan ;
    echr:hasApplicationNumber "28934/95"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceedingDarmstadtLabourCourt ;
    echr:hasRespondentState "Federal Republic of Germany"^^xsd:string .

doc:case_document_1 a echr:CaseDocument ;
    rdfs:label "Case regarding ESA immunity"^^xsd:string,
        "ESA Case"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceedingDarmstadtLabourCourt,
        doc:proceeding_2 .

doc:legal_fees_value_1 a ns1:QuantityValue ;
    rdfs:label "lawyer fees for first applicant"^^xsd:string ;
    rdfs:comment "DEM"^^xsd:string,
        "Paragraph 18"^^xsd:string ;
    ns1:numericValue 14000.0 ;
    echr:hasSupportingQuote "the sum of DEM 14,000 for lawyer’s fees"^^xsd:string .

doc:loss_of_job_value_1 a ns1:QuantityValue ;
    rdfs:label "loss of job payment for first applicant"^^xsd:string ;
    rdfs:comment "DEM"^^xsd:string,
        "Paragraph 18"^^xsd:string ;
    ns1:numericValue 305000.0 ;
    echr:hasSupportingQuote "DEM 305,000 for the loss of his job"^^xsd:string .

doc:participation_1_1 a echr:Participation ;
    rdfs:comment "Paragraph 15"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "the applicants’ argument"^^xsd:string ;
    echr:participatingParty doc:applicant_1 .

doc:participation_1_2 a echr:Participation ;
    rdfs:comment "Paragraph 15"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "the applicants’ argument"^^xsd:string ;
    echr:participatingParty doc:applicant_2 .

doc:participation_2_1 a echr:Participation ;
    rdfs:comment "Paragraph 17"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSupportingQuote "proceedings instituted by the second applicant"^^xsd:string ;
    echr:participatingParty doc:applicant_2 .

doc:settlement_value_1 a ns1:QuantityValue ;
    rdfs:label "settlement amount for second applicant"^^xsd:string ;
    rdfs:comment "DEM"^^xsd:string,
        "Paragraph 17"^^xsd:string ;
    ns1:numericValue 22000.0 ;
    echr:hasSupportingQuote "the sum of 22,000 marks (DEM)"^^xsd:string .

doc:applicantGroup a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "the applicants"^^xsd:string ;
    echr:hasPersonName "the applicants"^^xsd:string .

doc:applicant_1 a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "first applicant"^^xsd:string ;
    echr:hasPersonName "first applicant"^^xsd:string .

doc:participationBeer a echr:Participation ;
    rdfs:label "Participation of Karlheinz Beer in Darmstadt Labour Court proceeding"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicantBeer .

doc:participationBeerDarmstadt a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicantBeer .

doc:participationRegan a echr:Participation ;
    rdfs:label "Participation of Philip Regan in Darmstadt Labour Court proceeding"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:philipRegan .

doc:participationReganDarmstadt a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:philipRegan .

doc:participation_1 a echr:Participation ;
    rdfs:label "Applicants' participation in German courts"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicantGroup .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Proceedings against company T.I."^^xsd:string ;
    rdfs:comment "Paragraph 17"^^xsd:string ;
    echr:hasCourt doc:germanCourts ;
    echr:hasDecisionDate "1994-09-06"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeSettled ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "In the proceedings instituted by the second applicant against his dismissal by the company T.I.... a settlement had been reached in the Darmstadt Labour Court on 6 September 1994"^^xsd:string .

doc:applicant_2 a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "second applicant"^^xsd:string ;
    echr:hasPersonName "second applicant"^^xsd:string .

doc:germanCourts a echr:DomesticAuthority ;
    rdfs:label "Darmstadt Labour Court"^^xsd:string,
        "German courts"^^xsd:string,
        "The Labour Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Darmstadt Labour Court"^^xsd:string,
        "The Labour Court"^^xsd:string ;
    echr:hasJurisdictionState "Germany"^^xsd:string .

doc:proceedingDarmstadtLabourCourt a echr:DomesticProceeding ;
    rdfs:label "Proceedings before the Darmstadt Labour Court"^^xsd:string ;
    rdfs:comment "Extracted from paragraph 53"^^xsd:string,
        "Paragraph 15"^^xsd:string,
        "Paragraph 46: The Darmstadt Labour Court concluded that the conditions under section 20(2) of the German Courts Act for finding that the applicants’ action was inadmissible were fulfilled."^^xsd:string ;
    echr:hasCourt doc:germanCourts ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasExtractionNote "Proceeding instituted in October and November 1993; start date recorded as October 1st for ISO 8601 compatibility."^^xsd:string ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationBeer,
        doc:participationBeerDarmstadt,
        doc:participationRegan,
        doc:participationReganDarmstadt,
        doc:participation_1 ;
    echr:hasProceedingStartDate "1993-10-01"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."^^xsd:string,
        "The Darmstadt Labour Court concluded that the conditions under section 20(2) of the German Courts Act for finding that the applicants’ action was inadmissible were fulfilled."^^xsd:string,
        "The Labour Court... considered that ESA enjoyed such immunity... It therefore rejected the applicants’ argument"^^xsd:string,
        "the rule of immunity from jurisdiction, which the German courts applied to ESA in the present case"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:applicantBeer a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Mr Beer"^^xsd:string,
        "Mr Karlheinz Beer"^^xsd:string ;
    echr:hasPersonName "Mr Beer"^^xsd:string,
        "Mr Karlheinz Beer"^^xsd:string .

doc:philipRegan a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Mr Philip Regan"^^xsd:string,
        "Mr Regan"^^xsd:string ;
    echr:hasPersonName "Mr Philip Regan"^^xsd:string,
        "Mr Regan"^^xsd:string .

