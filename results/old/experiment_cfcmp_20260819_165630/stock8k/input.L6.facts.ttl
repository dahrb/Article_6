@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/010fe8cca2f6/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://www.w3.org/ns/qudt/ontology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/010fe8cca2f6> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:6"^^xsd:string .

doc:case_1 a echr:CaseDocument ;
    rdfs:label "Scholz AG v. Armenia"^^xsd:string ;
    echr:hasApplicant doc:applicantCompany ;
    echr:hasApplicationNumber "16528/10"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceeding_1,
        doc:proceeding_2,
        doc:proceeding_3,
        doc:proceeding_4,
        doc:proceeding_5,
        doc:proceeding_6 ;
    echr:hasRespondentState "Republic of Armenia"^^xsd:string .

doc:claim_amount_1 a ns1:QuantityValue ;
    rdfs:label "claim amount"^^xsd:string ;
    dcterms:description "EUR 116,600"^^xsd:string ;
    ns1:numericValue 116600.0 .

doc:debt_calculation_1 a echr:AdministrativeAction ;
    rdfs:label "Calculation of liabilities"^^xsd:string ;
    echr:hasDecisionDate "2005-10-28"^^xsd:date ;
    echr:hasSupportingQuote "On 28 October 2005 representatives of the applicant company and the LLC made a calculation of their liabilities as at that date"^^xsd:string .

doc:loan_1 a echr:AdministrativeAction ;
    rdfs:label "Loan agreement"^^xsd:string ;
    echr:hasDecisionDate "2002-11-08"^^xsd:date ;
    echr:hasSupportingQuote "On 8 November 2002 the applicant company provided the LLC with a loan in the amount of 100,000 euros (EUR)"^^xsd:string .

doc:loan_amount_1 a ns1:QuantityValue ;
    rdfs:label "loan amount"^^xsd:string ;
    dcterms:description "EUR 100,000"^^xsd:string ;
    ns1:numericValue 100000.0 .

doc:llcParty a echr:Party ;
    rdfs:label "A. Safaryan and Associates LLC"^^xsd:string ;
    echr:hasPartyName "A. Safaryan and Associates LLC"^^xsd:string .

doc:participation_2 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:llcParty .

doc:proceeding_1_1 a echr:DomesticProceeding ;
    rdfs:label "Commercial Court Decision on Examination" ;
    echr:hasDecisionDate "2007-11-16"^^xsd:date ;
    echr:hasOutcome echr:OutcomeRefusedExamination .

doc:proceeding_6 a echr:DomesticProceeding ;
    rdfs:label "Court of Cassation Appeal"^^xsd:string ;
    echr:followsProceeding doc:proceeding_5 ;
    echr:hasCourt doc:districtCourt ;
    echr:hasDecisionDate "2009-09-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2009-08-04"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 23 September 2009 the Court of Cassation declared the applicant company’s appeal on points of law inadmissible."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:applicantCompany a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Scholz AG"^^xsd:string,
        "the applicant company"^^xsd:string ;
    echr:hasPartyName "Scholz AG"^^xsd:string .

doc:participation_1 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicantCompany .

doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Commercial Court Complaint"^^xsd:string,
        "Initial claim before Commercial Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1_1 ;
    echr:hasCourt doc:districtCourt ;
    echr:hasDecisionDate "2007-12-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingStartDate "2007-01-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 10 December 2007 a three-judge bench of the Commercial Court rejected the complaint submitted by the applicant company."^^xsd:string,
        "On 16 November 2007 the Commercial Court granted the request and decided to leave the applicant company’s claim and the counterclaim lodged by the LLC unexamined."^^xsd:string .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Appeal against decision to leave claim unexamined"^^xsd:string,
        "Arbitration Tribunal Claim"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:districtCourt ;
    echr:hasDecisionDate "2008-10-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasProceedingStartDate "2007-11-23"^^xsd:date,
        "2008-09-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 23 November 2007 the applicant company lodged a complaint concerning the decision to leave the claim and counterclaim unexamined."^^xsd:string,
        "On 7 October 2008 the President of the Arbitration Tribunal informed the applicant company that its request to start arbitration proceedings would not be granted."^^xsd:string .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "Yerevan Civil Court Claim"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:districtCourt ;
    echr:hasDecisionDate "2009-02-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasProceedingStartDate "2008-10-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "on 17 October 2008 the applicant company lodged a claim with the Yerevan Civil Court... On 27 February 2009 the Yerevan Civil Court transferred the case to the Kentron and Nork-Marash District Court"^^xsd:string .

doc:proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "District Court Proceedings"^^xsd:string ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:districtCourt ;
    echr:hasDecisionDate "2009-06-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2009-03-13"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 16 June 2009 the District Court decided to leave the claim lodged by the applicant company unexamined"^^xsd:string .

doc:proceeding_5 a echr:DomesticProceeding ;
    rdfs:label "Civil Court of Appeal"^^xsd:string ;
    echr:followsProceeding doc:proceeding_4 ;
    echr:hasCourt doc:districtCourt ;
    echr:hasDecisionDate "2009-07-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2009-06-25"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 21 July 2009 the Civil Court of Appeal upheld the decision of 16 June 2009."^^xsd:string .

doc:districtCourt a echr:DomesticAuthority ;
    rdfs:label "Arbitration Tribunal"^^xsd:string,
        "Civil Court of Appeal"^^xsd:string,
        "Commercial Court"^^xsd:string,
        "Court of Cassation"^^xsd:string,
        "Kentron and Nork-Marash District Court of Yerevan"^^xsd:string,
        "Yerevan Civil Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Commercial Court"^^xsd:string ;
    echr:hasJurisdictionState "Armenia"^^xsd:string .

