doc:trial_sawoniuk_1999 a echr:DomesticProceeding ;
    rdfs:label "Trial of Anthony Sawoniuk (1999)"^^xsd:string ;
    echr:hasCourt doc:courtPottsJury ;
    echr:hasDecisionDate "1999-04-01"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome doc:outcome_counts_2_4 ;
    echr:hasParticipation doc:participationSawoniukTrial ;
    echr:hasProceedingStartDate "1999-02-08"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "In the trial which took place between 8 February and 1 April 1999, before Mr Justice Potts and a jury"^^xsd:string,
        "the judge ruled that there was insufficient evidence as a matter of law to support a conviction on counts 2 and 4 and that the applicant should be acquitted"^^xsd:string .

