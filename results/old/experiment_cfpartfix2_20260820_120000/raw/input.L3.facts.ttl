    echr:hasDecisionDate "2007-07-19"^^xsd:date ;
    echr:hasParticipation doc:participationSdifUnits ;
    echr:hasSupportingQuote "On 19 July 2007, the Fund decided to establish two economic and commercial units: one for Viva TV and the other for Radio Viva."^^xsd:string .

