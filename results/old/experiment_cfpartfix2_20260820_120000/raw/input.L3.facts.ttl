doc:proceedingConstitutionalCourtProperty a echr:DomesticProceeding ;
    rdfs:label "Constitutional Court individual application regarding property rights"^^xsd:string ;
    echr:hasCourt doc:authConstCourt ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participationAksoyConstProperty ;
    echr:hasSupportingQuote "The Constitutional Court concluded that the administration’s failure to enforce the annulment decisions amounted to a violation of the applicant’s property rights under Article 35 of the Constitution"^^xsd:string .

doc:proceedingStandingSac a echr:DomesticProceeding ;
    rdfs:label "Supreme Administrative Court proceeding on standing"^^xsd:string ;
    echr:followsProceeding doc:proceedingStandingAdminCourt ;
    echr:hasCourt doc:authSac ;
    echr:hasDecisionDate "2006-07-20"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participationAksoySac ;
    echr:hasSupportingQuote "On 20 July 2006, the Supreme Administrative Court, ruling unanimously, found that the applicant had a legal interest in the enforcement proceedings... and quashed the administrative court’s earlier decision"^^xsd:string .

doc:actionFundDefaultDecision a echr:AdministrativeAction ;
    rdfs:label "Fund decision to rely on default provisions"^^xsd:string ;
    echr:hasCourt doc:partySdif ;
    echr:hasDecisionDate "2008-04-03"^^xsd:date ;
    echr:hasParticipation doc:participationAksoyGroupDefault,
        doc:participationSdifDefault ;
    echr:hasSupportingQuote "On 3 April 2008, the Fund concluded that the Erol Aksoy Group had failed to fulfil several commitments and obligations set out in the Liquidation Protocol... Consequently, the Fund decided to rely on its provisions concerning default."^^xsd:string .

