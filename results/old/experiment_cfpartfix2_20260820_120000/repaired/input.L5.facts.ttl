doc:proceedingQdcZakarpattya a echr:DomesticProceeding ;
    rdfs:label "Disciplinary proceedings before QDC of Zakarpattya"^^xsd:string ;
    echr:followsProceeding doc:actionComplaintTransfer ;
    echr:hasCourt doc:authQdcZakarpattya ;
    echr:hasDecisionDate "2013-04-17"^^xsd:date ;
    echr:hasExtractionNote "The Court notes the suspension lasted for six months."^^xsd:string ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partLawyerDQdc,
        doc:partMartynovskiyQdc ;
    echr:hasProceedingType echr:TypeDisciplinary ;
    echr:hasSupportingQuote "In February 2013 the applicant learned that the QDC of Zakarpattya was examining a complaint against him"^^xsd:string,
        "On 17 April 2013, in the applicant’s absence, the Disciplinary Chamber of the QDC of Zakarpattya suspended the applicant’s licence to practise as an advocate for six months"^^xsd:string,
        "The applicant had not informed the Disciplinary Chamber of the reasons why he had been absent from the meeting of 7 December 2012."^^xsd:string,
        "the applicant’s suspension was temporary and lasted for six months."^^xsd:string .

doc:proceeding_kyiv_dist_admin_2016 a echr:DomesticProceeding ;
    rdfs:label "Appeal to Kyiv District Administrative Court 2016"^^xsd:string ;
    echr:followsProceeding doc:proceeding_hqdcb_decision_2016 ;
    echr:hasCourt doc:authKyivDistAdminCourt ;
    echr:hasDecisionDate "2021-04-08"^^xsd:date ;
    echr:hasInactivityPeriod doc:inactivity_kyiv_admin_1,
        doc:inactivity_kyiv_admin_2 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_martynovskiy_kyiv_dist_2016 ;
    echr:hasProceedingStartDate "2016-10-05"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 5 October 2016 the applicant lodged an appeal with the Kyiv District Administrative Court against the decisions of the Zakarpattya Bar and the decision of the HQDCB."^^xsd:string,
        "On 8 April 2021 the Kyiv District Administrative Court found that all the decisions issued by the self-government bodies of the Bar against the applicant had been lawful."^^xsd:string,
        "the applicant instituted proceedings before the Kyiv District Administrative Court on 5 October 2016."^^xsd:string .

