doc:inactivity_kyiv_admin_1 a echr:InactivityPeriod ;
    rdfs:label "Suspension of Kyiv District Administrative Court proceedings"^^xsd:string ;
    echr:hasInactivityCause echr:DelayUnattributed ;
    echr:hasInactivityEndDate "2018-05-01"^^xsd:date ;
    echr:hasInactivityStartDate "2017-02-01"^^xsd:date ;
    echr:hasSupportingQuote "in February 2017 the Kyiv District Administrative Court suspended the examination of the applicant’s case... the delay in the resumption of the proceedings between March 2017 and May 2018 was attributable to the applicant or to the Government."^^xsd:string .

doc:inactivity_kyiv_admin_2 a echr:InactivityPeriod ;
    rdfs:label "Inactivity following resumption 2018-2019"^^xsd:string ;
    echr:hasInactivityCause echr:DelayAttributedToAuthorities ;
    echr:hasInactivityEndDate "2019-12-31"^^xsd:date ;
    echr:hasInactivityStartDate "2018-05-01"^^xsd:date ;
    echr:hasSupportingQuote "following the resumption of the proceedings in May 2018 the applicant repeatedly enquired with the Kyiv District Administrative Court, in 2018 and 2019, about the progress in his case, but received no reply."^^xsd:string .

