@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/5181901b0ee9/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/5181901b0ee9> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:1"^^xsd:string .

doc:caseStanevBulgaria a echr:CaseDocument ;
    echr:hasApplicationNumber "36760/06"^^xsd:string ;
    echr:hasCaseName "Stanev v. Bulgaria"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceedingIncapacityRuse ;
    echr:hasRespondentState "Republic of Bulgaria"^^xsd:string .

doc:proceedingIncapacityAppeal a echr:DomesticProceeding ;
    rdfs:label "Appeal against partial incapacity declaration"^^xsd:string ;
    echr:followsProceeding doc:proceedingIncapacityRuse ;
    echr:hasCourt doc:authorityVelikoTarnovoAppeal ;
    echr:hasDecisionDate "2001-04-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "11"^^xsd:string ;
    echr:hasSupportingQuote "That judgment was upheld in a judgment of 12 April 2001 by the Veliko Tarnovo Court of Appeal"^^xsd:string .

doc:proceedingJudicialReviewMayor a echr:DomesticProceeding ;
    rdfs:label "Judicial review of mayor's refusal to bring action for release from guardianship"^^xsd:string ;
    echr:hasCourt doc:authorityDupnitsaDistrictCourt ;
    echr:hasDecisionDate "2006-03-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2005-09-28"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "40"^^xsd:string ;
    echr:hasSupportingQuote "The Dupnitsa District Court gave judgment on 10 March 2006... the court dismissed the application"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:authorityDupnitsaDistrictCourt a echr:DomesticAuthority ;
    rdfs:label "Dupnitsa District Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Dupnitsa District Court"^^xsd:string ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

doc:authorityRuseRegionalCourt a echr:DomesticAuthority ;
    rdfs:label "Ruse Regional Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Ruse Regional Court ( Окръжен съд )"^^xsd:string ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

doc:authorityVelikoTarnovoAppeal a echr:DomesticAuthority ;
    rdfs:label "Veliko Tarnovo Court of Appeal"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Veliko Tarnovo Court of Appeal ( Апелативен съд )"^^xsd:string ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

doc:proceedingIncapacityRuse a echr:DomesticProceeding ;
    rdfs:label "Proceeding for declaration of total legal incapacity"^^xsd:string ;
    echr:hasCourt doc:authorityRuseRegionalCourt ;
    echr:hasDecisionDate "2000-11-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "10"^^xsd:string ;
    echr:hasSupportingQuote "In a judgment of 20 November 2000, the court declared the applicant to be partially incapacitated"^^xsd:string .

