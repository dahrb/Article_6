@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/061543c12241> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:3"^^xsd:string .

doc:proc_constitutional_2017 a echr:DomesticProceeding ;
    rdfs:label "Individual application to the Constitutional Court lodged 11 September 2017; decision 23 May 2018"@en ;
    echr:followsProceeding doc:proc_13th_2017 ;
    echr:hasCourt doc:constitutionalCourt ;
    echr:hasDecisionDate "2018-05-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelConstitutional ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasProceedingStartDate "2017-09-11"^^xsd:date ;
    echr:hasProceedingType echr:TypeConstitutional ;
    echr:hasSourceParagraph "41"^^xsd:string,
        "42"^^xsd:string ;
    echr:hasSupportingQuote "In a decision of 23 May 2018, the Constitutional Court observed that the final annulment judgment of the 13th Chamber of the Supreme Administrative Court had been served on the applicant on 28 July 2017 and determined that the thirty-day time-limit for lodging an individual application had commenced on that date. Noting that the applicant’s application had been submitted on 11 September 2017, after the expiry of the time-limit, the Constitutional Court declared the application inadmissible."^^xsd:string,
        "On 11 September 2017, the applicant lodged an individual application with the Constitutional Court, alleging violations of his right to property and his right to a fair trial due to the non-enforcement of the final judgment annulling the sale of Viva TV-Radio Viva."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:constitutionalCourt a echr:DomesticAuthority ;
    rdfs:label "Constitutional Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Constitutional Court"^^xsd:string ;
    echr:hasJurisdictionState "Türkiye"^^xsd:string .

doc:istanbul_admin_court_6th a echr:DomesticAuthority ;
    rdfs:label "6th Chamber of the İstanbul Administrative Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "6th Chamber of the İstanbul Administrative Court"^^xsd:string ;
    echr:hasJurisdictionState "Türkiye"^^xsd:string .

doc:proc_13th_2017 a echr:DomesticProceeding ;
    rdfs:label "13th Chamber of the Supreme Administrative Court - rectification granted on 30 June 2017"@en ;
    echr:followsProceeding doc:proc_rect_rej_2016 ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "37"^^xsd:string ;
    echr:hasSupportingQuote "On 30 June 2017, the 13th Chamber of the Supreme Administrative Court granted the request, referring to the ruling of the General Assembly of 7 July 2015 which had annulled the Fund’s decision of 13 January 2011 concerning the valuation of Viva TV-Radio Viva (see paragraph 29 above). The court held that the annulment in that judgment necessitated a fresh judicial review of the case. The court ... overturned the judgment of the 6th Chamber of the Istanbul Administrative Court dated 19 March 2014 and annulled the sale in question."^^xsd:string ;
    echr:isFinalDomesticDecision false .

doc:proc_appeal_13th_2014 a echr:DomesticProceeding ;
    rdfs:label "Appeal to the Supreme Administrative Court (13th Chamber) - 9 December 2014"@en ;
    echr:followsProceeding doc:proc_firstinst_2011 ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2014-12-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "28"^^xsd:string ;
    echr:hasSupportingQuote "On 9 December 2014, the 13th Chamber of the Supreme Administrative Court dismissed the applicant’s case."^^xsd:string ;
    echr:isFinalDomesticDecision false .

doc:proc_firstinst_2011 a echr:DomesticProceeding ;
    rdfs:label "Proceedings before the İstanbul Administrative Court (6th Chamber)"@en ;
    echr:hasCourt doc:istanbul_admin_court_6th ;
    echr:hasDecisionDate "2014-03-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasProceedingStartDate "2011-02-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "27"^^xsd:string,
        "35"^^xsd:string ;
    echr:hasSupportingQuote "On 19 March 2014, the 6th Chamber of the İstanbul Administrative Court dismissed the applicant’s claim, concluding that no legal irregularities had occurred in the tendering and sale procedures."^^xsd:string,
        "On 7 February 2011, the applicant initiated proceedings before the administrative court, contesting the actions of the Fund concerning the tendering of Viva TV-Radio Viva, in which he claimed to hold both direct and indirect shares."^^xsd:string ;
    echr:isFinalDomesticDecision false .

doc:proc_ga_2015 a echr:DomesticProceeding ;
    rdfs:label "General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court - 7 July 2015"@en ;
    echr:followsProceeding doc:proc_appeal_13th_2014 ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2015-07-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "29"^^xsd:string ;
    echr:hasSupportingQuote "On 7 July 2015, following an appeal by the applicant, the General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court ( Danıştay İdari Dava Daireleri Genel Kurulu – hereinafter “the General Assembly”), in line with the dissenting opinion, ruled that the estimated value of USD 6,000,000 had been determined on the basis of the 2009 valuation report, without any new assessment of the market value. The General Assembly concluded that the contested decision was not in compliance with the law, and, by a majority, annulled the Fund’s decision."^^xsd:string ;
    echr:isFinalDomesticDecision false .

doc:proc_rect_rej_2016 a echr:DomesticProceeding ;
    rdfs:label "Supreme Administrative Court decision rejecting the Fund's request for rectification - 25 January 2016"@en ;
    echr:followsProceeding doc:proc_ga_2015 ;
    echr:hasCourt doc:supremeAdminCourt ;
    echr:hasDecisionDate "2016-01-25"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelSupervisoryReview ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "30"^^xsd:string ;
    echr:hasSupportingQuote "On 25 January 2016, the Supreme Administrative Court rejected the Fund’s request for rectification, noting that the case had become final following the appeal and was no longer subject to rectification."^^xsd:string ;
    echr:isFinalDomesticDecision false .

doc:supremeAdminCourt a echr:DomesticAuthority ;
    rdfs:label "13th Chamber of the Supreme Administrative Court"@en,
        "General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court"@en,
        "Supreme Administrative Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "13th Chamber of the Supreme Administrative Court"^^xsd:string,
        "General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court"^^xsd:string,
        "Supreme Administrative Court"^^xsd:string ;
    echr:hasJurisdictionState "Türkiye"^^xsd:string .

