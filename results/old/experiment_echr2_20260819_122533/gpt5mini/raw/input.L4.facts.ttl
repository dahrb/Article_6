    echr:hasSupportingQuote "On 4 December 1997 the Maribor Higher Court upheld her appeal finding that, despite the shortcomings mentioned in the first-instance decision, there were sufficient grounds for suspicion that the applicant had committed the alleged offence. Accordingly, it changed the first-instance court’s decision and opened a criminal investigation against the applicant."^^xsd:string .

doc:proc_police_initiated_case_against_applicant_19950412 a echr:DomesticProceeding ;
    rdfs:label "On 12 April 1995 the Slovenj Gradec Police lodged a criminal complaint against the applicant for the criminal offence of 'obstructing an official in the course of his duties' which referred to the same incident as the applicant's criminal complaint."@en ;
    echr:hasCourt doc:authoritySlovenjGradecPolice ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingStartDate "1995-04-12"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "37"^^xsd:string ;
    echr:hasSupportingQuote "On 12 April 1995 the Slovenj Gradec Police lodged a criminal complaint against the applicant for the criminal offence of 'obstructing an official in the course of his duties' under section 302, paragraph 4-1 of the Slovenian Criminal Code, which referred to the same incident as the applicant's criminal complaint."^^xsd:string .

doc:proc_sg_districtcourt_decision_not_to_open_19970408 a echr:DomesticProceeding ;
    rdfs:label "On 8 April 1997, further to a proposal of the investigating judge, the Slovenj Gradec District Court decided not to open a criminal investigation against the applicant."@en ;
    echr:followsProceeding doc:proc_police_initiated_case_against_applicant_19950412 ;
