    echr:hasAuthorityName "Supreme Court"^^xsd:string ;
    echr:hasJurisdictionState "Georgia"^^xsd:string .

doc:authorityTbilisiCourtOfAppeal a echr:DomesticAuthority ;
    rdfs:label "Tbilisi Court of Appeal"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Tbilisi Court of Appeal"^^xsd:string ;
    echr:hasJurisdictionState "Georgia"^^xsd:string .

doc:domestic_proceeding_appeal_2007 a echr:DomesticProceeding ;
    rdfs:label "On 27 June 2007 the Tbilisi Court of Appeal upheld the applicant’s conviction."^^xsd:string ;
    echr:followsProceeding doc:domestic_proceeding_trial_2006 ;
    echr:hasCourt doc:authorityTbilisiCourtOfAppeal ;
    echr:hasDecisionDate "2007-06-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "25"^^xsd:string ;
    echr:hasSupportingQuote "On 27 June 2007 the Tbilisi Court of Appeal upheld the applicant’s conviction."^^xsd:string ;
    echr:isPending false .

doc:domestic_proceeding_investigation_2005 a echr:DomesticProceeding ;
    rdfs:label "Criminal proceedings against the applicant (a) Investigation"^^xsd:string ;
    echr:hasCourt doc:authorityInvestigatingAuthorities ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingStartDate "2005-07-10"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "9"^^xsd:string ;
    echr:hasSupportingQuote "On 14 July 2005 a search warrant was issued in respect of the applicant. He was arrested and remanded in custody on 27 July 2005."^^xsd:string ;
    echr:isPending false .

doc:domestic_proceeding_trial_2006 a echr:DomesticProceeding ;
    rdfs:label "Criminal proceedings against the applicant (b) Trial"^^xsd:string ;
    echr:followsProceeding doc:domestic_proceeding_investigation_2005 ;
    echr:hasCourt doc:authorityFirstInstanceCourt ;
    echr:hasDecisionDate "2006-12-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2006-07-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "22"^^xsd:string ;
    echr:hasSupportingQuote "On 8 December 2006 the court of first instance convicted the applicant of aggravated murder and the illegal acquisition, possession and carrying of firearms, and sentenced him to 17 years’ imprisonment."^^xsd:string ;
    echr:isPending false .

