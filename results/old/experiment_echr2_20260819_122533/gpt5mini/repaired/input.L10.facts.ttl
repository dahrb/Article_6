@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/dd3fe495951c> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:2"^^xsd:string .

doc:aliens_appeals_board_dismissal_2017_03_24 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board judgment (24 March 2017) - dismissal of application to set aside 10 October 2016 decisions"^^xsd:string ;
    echr:followsProceeding doc:aliens_office_refusal_2016_10_10 ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2017-03-24"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "22"^^xsd:string ;
    echr:hasSupportingQuote "On 24 March 2017 the Aliens Appeals Board dismissed the application to have those decisions set aside, finding that the Aliens Office’s decisions of 13 September 2016 had become final and that, in consequence, the applicants no longer had standing to challenge the subsequent decisions."^^xsd:string .

doc:aliens_appeals_board_lift_stay_2017_03_06 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board decision (6 March 2017) - lifting stay of execution"^^xsd:string ;
    echr:followsProceeding doc:aliens_appeals_board_stay_2016_10_07 ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2017-03-06"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "16"^^xsd:string ;
    echr:hasSupportingQuote "On 6 March 2017 the Aliens Appeals Board noted that no application had been brought to have the decisions of 13 September 2016 refusing to issue the visas set aside, and decided in consequence to lift the stay of execution of the visa refusal decisions and the interim measures."^^xsd:string .

doc:aliens_appeals_board_stay_2016_10_14 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board order (14 October 2016) - stay of execution"^^xsd:string ;
    echr:followsProceeding doc:aliens_office_refusal_2016_10_10 ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2016-10-14"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "20"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of 14 October 2016 the Aliens Appeals Board, acting under the extremely urgent procedure, again ordered a stay of execution of the decision of 10 October 2016 refusing to issue the visas, and instructed the Aliens Office to take new decisions, this time giving adequate legal grounds, within 48 hours."^^xsd:string .

doc:applicants_enforcement_action_2016_12_15 a echr:DomesticProceeding ;
    rdfs:label "Applicants' action before the enforcement judge (15 December 2016) - ensure execution of payment order"^^xsd:string ;
    echr:followsProceeding doc:brussels_court_of_appeal_2016_12_07 ;
    echr:hasCourt doc:enforcementJudgeFrenchTpi ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingStartDate "2016-12-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "38"^^xsd:string ;
    echr:hasSupportingQuote "On 15 December 2016 the applicants brought an action against the Belgian State before the enforcement judge at the Brussels French-language TPI, seeking to ensure that the payment order of 13 December 2016 was executed."^^xsd:string .

doc:brussels_court_of_appeal_2017_06_30 a echr:DomesticProceeding ;
    rdfs:label "Brussels Court of Appeal judgment (30 June 2017) - Dutch-language division: judgment that earlier orders were no longer operative"^^xsd:string ;
    echr:followsProceeding doc:state_enforcement_action_2016_12_15 ;
    echr:hasCourt doc:brusselsCourtOfAppeal ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "40"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of 30 June 2017 a Dutch-language division of the Court of Appeal held that the Aliens Appeals Boards’ judgment of 20 October 2016 was no longer operative, given that the applicants had not lodged an application to have the visa refusal decisions of 13 September 2016 set aside."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:state_appeal_on_points_2017_02_27 a echr:DomesticProceeding ;
    rdfs:label "Belgian State appeal on points of law (27 February 2017) against the court of appeal's judgment of 7 December 2016"^^xsd:string ;
    echr:followsProceeding doc:brussels_court_of_appeal_2016_12_07 ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasProceedingStartDate "2017-02-27"^^xsd:date ;
    echr:hasProceedingType echr:TypeOther ;
    echr:hasSourceParagraph "36"^^xsd:string ;
    echr:hasSupportingQuote "On 27 February 2017 the Belgian State lodged an appeal on points of law against the court of appeal’s judgment of 7 December 2016. Those proceedings are currently pending."^^xsd:string ;
    echr:isPending true .

doc:aliens_appeals_board_stay_2016_10_07 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board order (7 October 2016) - stay of execution"^^xsd:string ;
    echr:followsProceeding doc:aliens_office_refusal_2016_09_13 ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2016-10-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "15"^^xsd:string ;
    echr:hasSupportingQuote "On 7 October 2016 the Aliens Appeals Board, acting under the extremely urgent procedure, ordered a stay of execution of the refusals by the Aliens Office to grant visas and instructed the Belgian State to take new decisions within 48 hours, giving adequate legal grounds, that is, by giving reasons which took account of the extremely dangerous situation in Syria."^^xsd:string .

doc:aliens_appeals_board_stay_2016_10_20 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board judgment (20 October 2016) - stay and order to issue laissez-passers"^^xsd:string ;
    echr:followsProceeding doc:aliens_office_refusal_2016_10_17 ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2016-10-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "25"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of 20 October 2016 the Aliens Appeals Board, essentially reiterating the substance of its previous judgments, ordered a stay of execution of the refusal decisions of 17 October 2016. In addition, in view of the imminent danger faced by the applicants, the Belgian State's persistent refusal to comply with res judicata authority and the importance of ensuring that the remedy was effective, it considered that it was justified to direct the State to issue the applicants, within 48 hours, with laissez-passers or visas, valid for three months."^^xsd:string .

doc:aliens_office_refusal_2016_09_13 a echr:DomesticProceeding ;
    rdfs:label "Aliens Office refusal (13 September 2016)"^^xsd:string ;
    echr:hasCourt doc:aliensOffice ;
    echr:hasDecisionDate "2016-09-13"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "11"^^xsd:string ;
    echr:hasSupportingQuote "On 13 September 2016 the Aliens Office, the administrative body responsible for issuing visas (see paragraph 45 below), refused to grant “humanitarian visas” to the applicants and informed them of its decisions by an email of 29 September 2016, transmitted through the visa department of the Belgian embassy in Beirut."^^xsd:string .

doc:aliens_office_refusal_2016_10_17 a echr:DomesticProceeding ;
    rdfs:label "Aliens Office refusal (17 October 2016)"^^xsd:string ;
    echr:hasCourt doc:aliensOffice ;
    echr:hasDecisionDate "2016-10-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "24"^^xsd:string ;
    echr:hasSupportingQuote "On 17 October 2016 the Aliens Office again took decisions refusing to issue the visas, citing the same reasons as in the previous refusals."^^xsd:string .

doc:brussels_tpi_decision_2016_11_07 a echr:DomesticProceeding ;
    rdfs:label "TPI decision (7 November 2016) - admissible but unfounded"^^xsd:string ;
    echr:followsProceeding doc:brussels_tpi_order_2016_10_25 ;
    echr:hasCourt doc:brusselsTpi ;
    echr:hasDecisionDate "2016-11-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "31"^^xsd:string ;
    echr:hasSupportingQuote "On 7 November 2016 another judge acting as president of the French - language TPI declared their application admissible but unfounded, considering that the Belgian authorities could not be criticised for failing voluntarily to comply with a judgment by the Aliens Appeals Board, even one that was immediately enforceable, if these same authorities intended to challenge the legality of the judgment by pursuing an appeal procedure provided for by law."^^xsd:string .

doc:brussels_tpi_order_2016_10_25 a echr:DomesticProceeding ;
    rdfs:label "Order of the acting president of the French-language TPI (25 October 2016) - urgent measure to enforce 20 October 2016"^^xsd:string ;
    echr:followsProceeding doc:aliens_appeals_board_stay_2016_10_20 ;
    echr:hasCourt doc:brusselsTpi ;
    echr:hasDecisionDate "2016-10-25"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "30"^^xsd:string ;
    echr:hasSupportingQuote "By an order of 25 October 2016, considering that the failure by the Aliens Office to comply with a judgment of the Aliens Appeals Board, notwithstanding the fact that it had been immediately enforceable, constituted “an unacceptable illegal action”, the acting president of the French-language TPI ordered the State, as an urgent measure, to comply with the Board’s judgment of 20 October 2016, that is, to issue the applicants with visas or laissez-passers , and made the order subject to a penalty payment of 1,000 euros (EUR) per day of delay and per applicant."^^xsd:string .

doc:enforcementJudgeDutchTpi a echr:DomesticAuthority ;
    rdfs:label "Enforcement judge at the Brussels Dutch-language TPI"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "enforcement judge at the Brussels Dutch-language TPI"^^xsd:string ;
    echr:hasJurisdictionState "Belgium"^^xsd:string .

doc:enforcementJudgeFrenchTpi a echr:DomesticAuthority ;
    rdfs:label "Enforcement judge at the Brussels French-language TPI"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "enforcement judge at the Brussels French-language TPI"^^xsd:string ;
    echr:hasJurisdictionState "Belgium"^^xsd:string .

doc:state_enforcement_action_2016_12_15 a echr:DomesticProceeding ;
    rdfs:label "Belgian State action before the enforcement judge (15 December 2016) - stay of execution / cantonnement"^^xsd:string ;
    echr:followsProceeding doc:brussels_court_of_appeal_2016_12_07 ;
    echr:hasCourt doc:enforcementJudgeDutchTpi ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingStartDate "2016-12-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "39"^^xsd:string ;
    echr:hasSupportingQuote "On the same date the Belgian State brought proceedings against the applicants before the enforcement judge at the Brussels Dutch - language TPI, seeking a stay of execution of the principal sentence ( condamnation principale ) resulting from the Aliens Appeals Boards’ judgment of 20 October 2016 (obligation to issue visas or laissez - passers ) and/or a stay of execution of the court of appeal’s judgment of 7 December 2016, and/or to prevent other enforcement measures, such as penalty payments."^^xsd:string .

doc:aliens_office_refusal_2016_10_10 a echr:DomesticProceeding ;
    rdfs:label "Aliens Office refusal (10 October 2016) - reissued decisions"^^xsd:string ;
    echr:hasCourt doc:aliensOffice ;
    echr:hasDecisionDate "2016-10-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "19"^^xsd:string ;
    echr:hasSupportingQuote "As required by the order of the Aliens Appeals Board (see paragraph 15 above), the Aliens Office issued new decisions, dated 10 October 2016, refusing to grant the visas; however, it provided the same reasons as in the previous refusals."^^xsd:string .

doc:brusselsCourtOfAppeal a echr:DomesticAuthority ;
    rdfs:label "Brussels Court of Appeal"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Brussels Court of Appeal"^^xsd:string ;
    echr:hasJurisdictionState "Belgium"^^xsd:string .

doc:brusselsTpi a echr:DomesticAuthority ;
    rdfs:label "Brussels French-language Court of First Instance (TPI)"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Brussels French-language Court of First Instance"^^xsd:string ;
    echr:hasJurisdictionState "Belgium"^^xsd:string .

doc:aliensOffice a echr:DomesticAuthority ;
    rdfs:label "Aliens Office"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "Aliens Office"^^xsd:string ;
    echr:hasJurisdictionState "Belgium"^^xsd:string .

doc:brussels_court_of_appeal_2016_12_07 a echr:DomesticProceeding ;
    rdfs:label "Brussels Court of Appeal judgment (7 December 2016) - variation and enforcement order"^^xsd:string ;
    echr:followsProceeding doc:brussels_tpi_decision_2016_11_07 ;
    echr:hasCourt doc:brusselsCourtOfAppeal ;
    echr:hasDecisionDate "2016-12-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "32"^^xsd:string ;
    echr:hasSupportingQuote "On an appeal by the applicants, the Brussels Court of Appeal delivered a judgment on 7 December 2016 varying the order of 7 November 2016. It held that the applicants could rely on the binding and enforceable nature of the contested judgment and on their subjective right to seek compliance and obtain an end to the harm sustained by them as a result of non-execution of the judgment, which constituted “an illegal action” and manifest fault."^^xsd:string .

doc:aliensAppealsBoard a echr:DomesticAuthority ;
    rdfs:label "Aliens Appeals Board"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Aliens Appeals Board"^^xsd:string ;
    echr:hasJurisdictionState "Belgium"^^xsd:string .

