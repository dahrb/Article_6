    rdfs:label "Kyiv District Administrative Court proceedings (lodged 5 October 2016; decision 8 April 2021)"^^xsd:string ;
    echr:followsProceeding doc:hqdcb_decision_2016_07_22 ;
    echr:hasCourt doc:kyivDistrictAdminCourtAuthority ;
    echr:hasDecisionDate "2021-04-08"^^xsd:date ;
    echr:hasInactivityPeriod doc:inactivity_kyiv_district_2017_02_16_2018_05_15 ;
