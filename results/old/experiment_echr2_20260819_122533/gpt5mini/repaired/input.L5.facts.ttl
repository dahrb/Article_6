    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingStartDate "2018-05-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "27"^^xsd:string ;
    echr:hasSupportingQuote "On 15 May 2018 the Kyiv District Administrative Court resumed the examination of the applicant’s appeal lodged on 5 October 2016. The court noted that the applicant had informed it of the decision of 6 March 2017 and had asked it to resume the proceedings."^^xsd:string .

