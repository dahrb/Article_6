doc:kyiv_admin_court_of_appeal_decision_2017_03_06 a echr:DomesticProceeding ;
    rdfs:label "Kyiv Administrative Court of Appeal - decision quashing (6 March 2017)"^^xsd:string ;
    echr:followsProceeding doc:podilskyy_decision_2016_12_22 ;
    echr:hasCourt doc:kyivAdminCourtOfAppealAuthority ;
    echr:hasDecisionDate "2017-03-06"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionUnknown ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "25"^^xsd:string ;
    echr:hasSupportingQuote "On 6 March 2017 the Kyiv Administrative Court of Appeal quashed the decision of 22 December 2016. The outcome of that set of proceedings remains unknown."^^xsd:string .

doc:kyiv_district_admin_proceeding_resumption_2018_05_15 a echr:DomesticProceeding ;
    rdfs:label "Kyiv District Administrative Court - resumption of examination (15 May 2018)"^^xsd:string ;
