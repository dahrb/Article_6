doc:trial_1999_potts a echr:DomesticProceeding ;
    rdfs:label "In the trial which took place between 8 February and 1 April 1999, before Mr Justice Potts and a jury, the applicant was represented by senior and junior counsel and solicitors."^^xsd:string ;
    echr:hasCourt doc:courtTrialPotts ;
    echr:hasDecisionDate "1999-04-01"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "1999-02-08"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "14"^^xsd:string,
        "25"^^xsd:string ;
    echr:hasSupportingQuote "In the trial which took place between 8 February and 1 April 1999, before Mr Justice Potts and a jury, the applicant was represented by senior and junior counsel and solicitors."^^xsd:string,
        "On 1 April 1999, the jury convicted the applicant of counts 1 and 3. The applicant was sentenced to a mandatory term of life imprisonment."^^xsd:string ;
    echr:isFinalDomesticDecision false ;
    echr:isPending false .

