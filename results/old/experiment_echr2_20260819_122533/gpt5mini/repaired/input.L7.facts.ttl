doc:highcourt_bail_review_1999_03_26 a echr:DomesticProceeding ;
    rdfs:label "An application was made to the High Court to review bail on 26 March 1999. It was refused."^^xsd:string ;
    echr:followsProceeding doc:trial_1999_potts ;
    echr:hasCourt doc:courtHighcourt ;
    echr:hasDecisionDate "1999-03-26"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelSupervisoryReview ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeOther ;
    echr:hasSourceParagraph "23"^^xsd:string ;
    echr:hasSupportingQuote "An application was made to the High Court to review bail on 26 March 1999. It was refused. The applicant states that the High Court judge took the view that he should not interfere with the decision given the stage reached in the proceedings, i.e. the closing speeches."^^xsd:string ;
    echr:isFinalDomesticDecision false ;
    echr:isPending false .

