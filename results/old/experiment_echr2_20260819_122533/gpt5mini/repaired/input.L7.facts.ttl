    echr:hasSourceParagraph "35"^^xsd:string ;
    echr:hasSupportingQuote "On 15 June 2000, the House of Lords refused the petition for leave to appeal. No reasons were given."^^xsd:string ;
    echr:isFinalDomesticDecision true ;
    echr:isPending false .

