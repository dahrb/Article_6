doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Commercial Court claim for debt recovery"^^xsd:string,
        "first instance claim examination"^^xsd:string ;
    echr:hasCourt doc:commercial_court_1 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingStartDate "2007-01-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 15 January 2007 the applicant company lodged a claim with the Commercial Court against the LLC"^^xsd:string,
        "On 16 November 2007 the Commercial Court granted the request and decided to leave the applicant company’s claim and the counterclaim lodged by the LLC unexamined."^^xsd:string .

doc:proceeding_cassation_1 a echr:DomesticProceeding ;
    rdfs:label "Court of Cassation proceeding"^^xsd:string ;
    echr:followsProceeding doc:proceeding_civil_appeal_1 ;
    echr:hasCourt doc:authCassation ;
    echr:hasDecisionDate "2009-09-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationCassationApplicant ;
    echr:hasProceedingStartDate "2009-08-04"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 23 September 2009 the Court of Cassation declared the applicant company’s appeal on points of law inadmissible"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:authYerevanCivil a echr:DomesticAuthority ;
    rdfs:label "Yerevan Civil Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Yerevan Civil Court"^^xsd:string ;
    echr:hasJurisdictionState "Armenia"^^xsd:string .

doc:commercial_court_1 a echr:DomesticAuthority ;
    rdfs:label "Commercial Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Commercial Court"^^xsd:string ;
    echr:hasJurisdictionState "Armenia"^^xsd:string .

doc:commercial_court_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Commercial Court proceedings on arbitration clause"^^xsd:string ;
    echr:hasCourt doc:commercial_court_1 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "the Commercial Court had already found that the arbitration clause contained in the contracts was sufficient to start arbitration proceedings"^^xsd:string .

doc:llc_party_1 a echr:Party ;
    rdfs:label "LLC"^^xsd:string ;
    echr:hasPartyName "LLC"^^xsd:string .

doc:proceeding_civil_appeal_1 a echr:DomesticProceeding ;
    rdfs:label "Civil Court of Appeal proceeding"^^xsd:string ;
    echr:followsProceeding doc:proceeding_district_court_1 ;
    echr:hasCourt doc:authCivilAppeal ;
    echr:hasDecisionDate "2009-07-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationAppealApplicant,
        doc:participationAppealLlc ;
    echr:hasProceedingStartDate "2009-06-25"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 21 July 2009 the Civil Court of Appeal upheld the decision of 16 June 2009"^^xsd:string .

doc:proceeding_district_court_1 a echr:DomesticProceeding ;
    rdfs:label "District Court proceeding"^^xsd:string ;
    echr:followsProceeding doc:proceeding_yerevan_civil_1 ;
    echr:hasCourt doc:authDistrictCourt ;
    echr:hasDecisionDate "2009-06-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationDistrictApplicant,
        doc:participationDistrictLlc ;
    echr:hasProceedingStartDate "2009-03-13"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 16 June 2009 the District Court decided to leave the claim lodged by the applicant company unexamined"^^xsd:string .

doc:proceeding_yerevan_civil_1 a echr:DomesticProceeding ;
    rdfs:label "Yerevan Civil Court proceeding"^^xsd:string ;
    echr:hasCourt doc:authYerevanCivil ;
    echr:hasDecisionDate "2009-02-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 27 February 2009 the Yerevan Civil Court transferred the case to the Kentron and Nork-Marash District Court of Yerevan"^^xsd:string .

doc:llc_1 a echr:Party ;
    rdfs:label "the LLC"^^xsd:string ;
    echr:hasPartyName "the LLC"^^xsd:string .

doc:applicant_company_1 a echr:Party ;
    rdfs:label "applicant company"^^xsd:string,
