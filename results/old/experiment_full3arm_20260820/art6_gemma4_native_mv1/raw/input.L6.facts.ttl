<https://growgraph.dev/doc/96a03f05d6be> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:6"^^xsd:string .

doc:administrative_action_1 a echr:AdministrativeAction ;
    rdfs:label "request for information to Arbitration Tribunal"^^xsd:string ;
    echr:hasSupportingQuote "On 23 July 2008 the applicant company’s representative sent a request for information to the President of the Arbitration Tribunal"^^xsd:string .

doc:case_1 a echr:CaseDocument ;
    echr:hasApplicant doc:applicant_company_1 ;
    echr:hasDomesticProceeding doc:proceeding_1 .

doc:case_doc_1 a echr:CaseDocument ;
    echr:hasApplicant doc:applicant_company_1 ;
    echr:hasDomesticProceeding doc:proceeding_cassation_1,
        doc:proceeding_civil_appeal_1,
        doc:proceeding_district_court_1,
        doc:proceeding_yerevan_civil_1 .

doc:case_document_1 a echr:CaseDocument ;
    echr:hasApplicant doc:applicant_company_1 ;
    echr:hasDomesticProceeding doc:commercial_court_proceeding_1 .

doc:commercial_court_bench_1 a echr:DomesticAuthority ;
    rdfs:label "three-judge bench of the Commercial Court"^^xsd:string ;
    echr:hasAuthorityName "three-judge bench of the Commercial Court"^^xsd:string .

doc:participation_5 a echr:Participation .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "appeal of the decision to leave claim unexamined"^^xsd:string ;
    echr:hasParticipation doc:participation_3,
        doc:participation_4 ;
    echr:hasSupportingQuote "On 10 December 2007 a three-judge bench of the Commercial Court rejected the complaint submitted by the applicant company."^^xsd:string .

doc:yerevan_civil_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Yerevan Civil Court claim for recovery"^^xsd:string ;
    echr:followsProceeding doc:arbitration_proceeding_1 ;
    echr:hasCourt doc:authYerevanCivil ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:participation_ycc_1,
        doc:participation_ycc_2 ;
    echr:hasProceedingStartDate "2008-10-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "on 17 October 2008 the applicant company lodged a claim with the Yerevan Civil Court"^^xsd:string ;
    echr:isPending true .

doc:arbitration_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Arbitration Tribunal claim for recovery"^^xsd:string ;
    echr:followsProceeding doc:commercial_court_proceeding_1 ;
    echr:hasCourt doc:arbitration_tribunal_1 ;
    echr:hasDecisionDate "2008-10-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_arb_1,
        doc:participation_arb_2 ;
    echr:hasProceedingStartDate "2008-09-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 7 October 2008 the President of the Arbitration Tribunal informed the applicant company that its request to start arbitration proceedings would not be granted"^^xsd:string .

doc:arbitration_tribunal_1 a echr:DomesticAuthority ;
    rdfs:label "Arbitration Tribunal"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Arbitration Tribunal"^^xsd:string ;
    echr:hasJurisdictionState "Armenia"^^xsd:string .

doc:authCassation a echr:DomesticAuthority ;
