doc:proceeding_3 a echr:DomesticProceeding,
        echr:EnforcementAction ;
    rdfs:label "Appeal before Brussels Court of Appeal"^^xsd:string,
        "Challenge to decisions of 17 October 2016"^^xsd:string,
        "Court of Cassation potential appeal"^^xsd:string,
        "Execution of Brussels Court of Appeal judgment"^^xsd:string,
        "Unilateral action for stay of execution"^^xsd:string,
        "decision to lift stay of execution (6 March 2017)"^^xsd:string ;
    echr:followsProceeding doc:admin_action_2,
        doc:proceeding_1,
        doc:proceeding_2 ;
    echr:hasCourt doc:aliensAppealsBoard,
        doc:aliens_appeals_board_1,
        doc:belgianState,
        doc:brusselsCourtAppeal,
        doc:brusselsDutchTpiPresident ;
    echr:hasDecisionDate "2016-10-20"^^xsd:date,
        "2016-12-07"^^xsd:date,
        "2016-12-13"^^xsd:date,
        "2017-03-06"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal,
        echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed,
        echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant,
        echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_1_app,
        doc:part_3_1,
        doc:part_3_2,
        doc:part_3_state,
        doc:participation_1 ;
    echr:hasProceedingType echr:TypeAdministrative,
        echr:TypeCivil ;
    echr:hasSupportingQuote "By a judgment of 20 October 2016 the Aliens Appeals Board... ordered a stay of execution of the refusal decisions of 17 October 2016"^^xsd:string,
        "On 6 March 2017 the Aliens Appeals Board... decided in consequence to lift the stay of execution"^^xsd:string,
        "did not appeal on points of law against the Brussels Court of Appeal’s judgment"^^xsd:string,
        "impossible for them to pursue the execution of the Brussels Court of Appeal’s judgment of 7 December 2016"^^xsd:string,
        "lodged a unilateral action to that effect with the President of the Brussels Dutch-speaking TPI on 13 December 2016, but was unsuccessful (order of the same date)"^^xsd:string,
        "the Brussels Court of Appeal delivered a judgment on 7 December 2016 varying the order of 7 November 2016"^^xsd:string ;
    echr:isPending false,
        true .

doc:proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "Appeal against stay of execution order"^^xsd:string,
        "Belgian State appeal against execution"^^xsd:string,
        "Challenge to decisions of 17 October 2016 (Final Judgment)"^^xsd:string,
        "Enforcement judge proceeding"^^xsd:string,
        "appeal on points of law by applicants (8 Feb 2018)"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2,
        doc:proceeding_3 ;
    echr:hasCourt doc:aliensAppealsBoard,
        doc:brusselsCourtAppeal,
        doc:brusselsCourtOfAppeal,
