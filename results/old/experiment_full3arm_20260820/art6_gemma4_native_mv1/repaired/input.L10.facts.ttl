        doc:enforcementJudge ;
    echr:hasDecisionDate "2016-12-14"^^xsd:date,
        "2017-03-24"^^xsd:date,
        "2017-06-30"^^xsd:date,
        "2017-12-20"^^xsd:date,
        "2018-02-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal,
        echr:LevelCassation,
        echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed,
        echr:OutcomeClaimGranted,
        echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_1_app,
        doc:part_3_state,
        doc:part_4_1,
        doc:part_4_2,
        doc:part_7,
        doc:part_8,
        doc:participation_1 ;
    echr:hasProceedingStartDate "2016-12-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative,
        echr:TypeCivil ;
    echr:hasSupportingQuote "By a judgment of 24 March 2017 the Aliens Appeals Board dismissed the application to have the decisions set aside"^^xsd:string,
        "On 20 December 2017 the French-language enforcement judge, examining the action brought by the applicants on 15 December 2016, found that the case had become devoid of purpose"^^xsd:string,
        "On 8 February 2018 the Conseil d’État dismissed an appeal on points of law by the applicants against the judgment of 6 March 2017"^^xsd:string,
        "on an appeal by the Belgian State, the court of appeal varied the decision of the first-instance court in a judgment of 14 December 2016"^^xsd:string,
        "the Belgian State sought to counter the execution... it secured this aim through the court of appeal’s judgment of 30 June 2017"^^xsd:string ;
    echr:isFinalDomesticDecision true .

