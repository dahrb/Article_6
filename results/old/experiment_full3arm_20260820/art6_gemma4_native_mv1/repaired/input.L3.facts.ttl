doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "First-instance administrative court proceeding"^^xsd:string,
        "annulment proceedings before the İstanbul Administrative Court"^^xsd:string,
        "first instance proceeding before 13th Chamber"^^xsd:string,
        "proceedings before the administrative court"^^xsd:string ;
    echr:followsProceeding doc:action_1 ;
    echr:hasDecisionDate "2014-03-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_1_1,
        doc:participation_1_2,
        doc:participation_2 ;
    echr:hasProceedingStartDate "2011-02-24"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 24 February 2011, the applicant initiated proceedings before the administrative court, seeking the annulment of the sale of Viva TV-Radio Viva... On 19 March 2014, the 6th Chamber of the İstanbul Administrative Court dismissed the applicant’s claim"^^xsd:string,
        "On 7 February 2011, the applicant initiated proceedings before the administrative court, contesting the actions of the Fund concerning the tendering of Viva TV-Radio Viva"^^xsd:string,
        "On 9 December 2014, the 13th Chamber of the Supreme Administrative Court dismissed the applicant’s case."^^xsd:string,
        "judgment of the 6th Chamber of the Istanbul Administrative Court dated 19 March 2014"^^xsd:string,
        "the decision of the first-instance administrative court, which had dismissed the case on the grounds of his lack of standing"^^xsd:string .

