doc:admin_action_1 a echr:AdministrativeAction ;
    rdfs:label "Fund decision on impossibility of enforcement"^^xsd:string,
        "decision to initiate legal proceedings"^^xsd:string,
        "transfer of management and control of İktisat Bankası T.A.Ş."^^xsd:string ;
    echr:hasCourt doc:boardAuthority,
