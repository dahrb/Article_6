    echr:hasDecisionDate "2001-03-15"^^xsd:date,
        "2008-04-03"^^xsd:date,
        "2015-10-27"^^xsd:date ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2,
        doc:participation_3,
        doc:participation_5 ;
    echr:hasSupportingQuote "By a decision dated 15 March 2001, the Banking Regulation and Supervision Board... resolved to transfer the management and control of İktisat Bankası T.A.Ş."^^xsd:string,
        "On 3 April 2008, the Fund concluded that the Erol Aksoy Group had failed to fulfil several commitments and obligations set out in the Liquidation Protocol... It resolved to initiate legal proceedings against all natural and legal person debtors within the Erol Aksoy Group"^^xsd:string,
        "the Fund notified the applicant of a decision taken on 27 October 2015 regarding the impossibility of enforcing the judgment"^^xsd:string .

