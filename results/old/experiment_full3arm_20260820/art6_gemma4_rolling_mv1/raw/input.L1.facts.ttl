    echr:hasParticipation doc:participationSocialDeptIncrease,
        doc:participationStanevIncrease ;
    echr:hasSupportingQuote "On 3 February 2009 the allowance was increased to BGN 19.50"^^xsd:string .

doc:administrativeActionGuardianAppointmentRila a echr:AdministrativeAction ;
