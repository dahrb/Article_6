    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasSupportingQuote "It appears that on 8 July 1998 the Regional Court ordered that the applicant should be given the amended version"^^xsd:string .

