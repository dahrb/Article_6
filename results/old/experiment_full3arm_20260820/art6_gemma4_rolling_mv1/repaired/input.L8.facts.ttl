        doc:participationScMoskalenko,
        doc:participationScMrK ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "An appeal to the Supreme Court by the applicant’s lawyer, Mr. O., challenged the judgment on a number of points."^^xsd:string,
        "On 10 August 1998 the Supreme Court confirmed the judgment of the Nizhniy Novgorod Regional Court"^^xsd:string,
        "confirmed by the Supreme Court on 10 August 1998"^^xsd:string .

