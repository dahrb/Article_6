doc:proceeding_10 a echr:DomesticProceeding ;
    rdfs:label "quashing of 1982 conviction"^^xsd:string ;
    echr:hasCourt doc:prosecutorNn ;
    echr:hasDecisionDate "1999-02"^^xsd:gYearMonth ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "In February 1999 the applicant’s first (1982) conviction was quashed, and the file in that case was closed by the Nizhniy Novgorod regional prosecutor’s office."^^xsd:string .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court appeal"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:authoritySupremeCourt ;
    echr:hasDecisionDate "1997-07"^^xsd:gYearMonth ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:part_2_app ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "In July 1997 the Supreme Court quashed the conviction on the applicant’s appeal and remitted the case to the Nizhniy Novgorod Regional Court"^^xsd:string .

doc:proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "appeal against detention order"^^xsd:string ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:authoritySupremeCourt ;
    echr:hasDecisionDate "1998-05-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_2_app ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 23 April 1998 the applicant’s “civil defender”... lodged with the Supreme Court an appeal against the court order of 2 April to detain the applicant... The reply from the Supreme Court, dated 19 May 1998, stated that the national law did not allow appeals against that type of trial court orders separately from appeals against judgments."^^xsd:string .

doc:proceeding_5 a echr:DomesticProceeding ;
    rdfs:label "request to dismiss judge for bias"^^xsd:string ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:authorityNnRegionalCourt ;
    echr:hasDecisionDate "1998-05-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_2_app ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 19 May the applicant’s “civil defender” requested the Regional Court to dismiss the judge presiding in the case for bias... Both requests were rejected by the Regional Court."^^xsd:string,
        "On the same day the applicant requested to admit Mrs Moskalenko as his lawyer in the trial... Both requests were rejected by the Regional Court."^^xsd:string .

doc:proceeding_8 a echr:DomesticProceeding ;
    rdfs:label "order to provide amended judgment"^^xsd:string ;
    echr:followsProceeding doc:proceeding_3 ;
