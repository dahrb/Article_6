        doc:part_3_mr_k,
        doc:part_3_nl_top,
        doc:part_3_oka,
        doc:part_3_slot,
        doc:part_3_zhanto ;
    echr:hasPreTrialDetention doc:detention_2 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "During the second trial, on 27 May 1998... the applicant was ordered by the Nizhniy Novgorod Court to pay damages to “Oka”."^^xsd:string,
        "On 27 May 1998 the Nizhniy Novgorod Regional Court found the applicant guilty on charges of misappropriation and embezzlement, larceny, bribery and attempt not to return money from abroad."^^xsd:string,
        "On 27 May 1998 the Regional Court made a number of further orders ( частные определения ) in the case."^^xsd:string,
        "On 30 March 1998, during the new trial"^^xsd:string .

