doc:proceeding_10 a echr:DomesticProceeding ;
    rdfs:label "cassation appeal to Supreme Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_7 ;
    echr:hasAdjournment doc:adjournment_1 ;
    echr:hasCourt doc:authoritySupremeCourt ;
    echr:hasDecisionDate "1998-08-10"^^xsd:date ;
    echr:hasExtractionNote "the verbatim record ran to 15 volumes"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeClaimPartlyGranted ;
    echr:hasOutcomeDirection echr:DirectionMixed ;
    echr:hasParticipation doc:part_10_app_mosk,
        doc:part_1_pros,
        doc:part_2_app ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "An appeal to the Supreme Court by the applicant’s lawyer, Mr. O., challenged the judgment on a number of points."^^xsd:string,
        "On 10 August 1998 the Supreme Court confirmed the judgment of the Nizhniy Novgorod Regional Court, with some alterations."^^xsd:string,
        "The Supreme Court dropped certain charges from the conviction and altered the classification of certain crimes... The sentencing of the applicant to a total of six years in prison was upheld."^^xsd:string .

