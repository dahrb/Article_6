doc:adminAdmissionSggh a echr:AdministrativeAction ;
    rdfs:label "On 6 April 1995, soon after his release, the applicant was admitted to the Slovenj Gradec General Hospital where he stayed until 7 p.m."^^xsd:string ;
    echr:hasParticipation doc:participationApplicantAdmissionSggh ;
    echr:hasProceedingStartDate "1995-04-06"^^xsd:date ;
    echr:hasSupportingQuote "On 6 April 1995, soon after his release, the applicant was admitted to the Slovenj Gradec General Hospital where he stayed until 7 p.m."^^xsd:string .

doc:adminMedicalMaribor a echr:AdministrativeAction ;
    rdfs:label "Next day, 7 April 1995, the applicant sought medical aid in the Maribor General Hospital."^^xsd:string ;
    echr:hasParticipation doc:participationApplicantMedicalMaribor ;
    echr:hasProceedingStartDate "1995-04-07"^^xsd:date ;
    echr:hasSupportingQuote "Next day, 7 April 1995, the applicant sought medical aid in the Maribor General Hospital."^^xsd:string .

doc:complaint_1995_04_12 a echr:AdministrativeAction ;
    rdfs:label "criminal complaint lodged by the Slovenj Gradec Police on 12 April 1995"^^xsd:string ;
    echr:hasParticipation doc:participationPoliceComplaintApplicant,
        doc:participationPoliceComplaintPolice ;
    echr:hasProceedingStartDate "1995-04-12"^^xsd:date ;
    echr:hasSupportingQuote "On 12 April 1995 the Slovenj Gradec Police lodged a criminal complaint against the applicant for the criminal offence of “obstructing an official in the course of his duties” under section 302, paragraph 4-1 of the Slovenian Criminal Code, which referred to the same incident as the applicant’s criminal complaint."^^xsd:string .

doc:criminalComplaintByApplicantNotice a echr:AdministrativeAction ;
    rdfs:label "the applicant’s criminal complaint (mentioned as lodged)"^^xsd:string ;
    echr:hasSupportingQuote "From the facts described above and from the contents of the criminal complaint [lodged against the applicant] it is evident that there exists a reasonable suspicion [ utemeljeni sum ] that Matko Aleksander on 5 April at 20.30 committed the criminal offence of obstructing an official in the course of his duties within the meaning of section 302/II of the Criminal Code of the Republic of Slovenia."^^xsd:string .

doc:criminalComplaintSlovenjGradecPolice a echr:AdministrativeAction ;
    rdfs:label "the criminal complaint of the Slovenj Gradec Police"^^xsd:string ;
    echr:hasSupportingQuote "The criminal complaint of the Slovenj Gradec Police states that Aleksander Matko sustained injuries as a result of the use of force."^^xsd:string .

doc:criminal_proceedings_1995_1998 a echr:DomesticProceeding ;
    rdfs:label "criminal proceedings (pre-1998)"^^xsd:string ;
    echr:followsProceeding doc:pretrial_investigation_1995 ;
    echr:hasParticipation doc:participation_criminal_applicant_1995_1998,
        doc:participation_criminal_state_1995_1998 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "the criminal proceedings had been unfair and excessively long (Article 6 of the Convention)."^^xsd:string ;
    echr:isPending true .

doc:domesticAuthorityMinistryInternalAffairs a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Ministry of Internal Affairs (MIA)"^^xsd:string ;
    echr:hasAuthorityName "Ministry of Internal Affairs (\"the MIA\")"^^xsd:string ;
    echr:hasSupportingQuote "On 4 and 5 April 1995 a Special Unit ( Specialna enota ), which was under the direct control of the Ministry of Internal Affairs (\"the MIA\") in cooperation with officers from the Slovenj Gradec Internal Affairs Administration ( Uprava za notranje zadeve – hereinafter referred as the \"Slovenj Gradec Police\") undertook a large-scale operation against the activities of a criminal organisation presumed to be operating on the territory of the town of Slovenj Gradec."^^xsd:string .

doc:investigation_request_1997_01_17 a echr:DomesticProceeding ;
    rdfs:label "a request for an investigation against Matko Aleksander was lodged with the investigating judge in the Slovenj Gradec District Court"^^xsd:string ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasParticipation doc:participationInvestigationApplicant,
        doc:participationInvestigationPublicProsecutor ;
    echr:hasProceedingStartDate "1997-01-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "In addition, on 17 January 1997, a request for an investigation against Matko Aleksander was lodged with the investigating judge in the Slovenj Gradec District Court, for, among other matters, obstructing an official in the course of his duties (...)."^^xsd:string .

doc:objection_1999_01_27 a echr:DomesticProceeding ;
    rdfs:label "applicant filed an objection to the indictment 27 January 1999"^^xsd:string ;
    echr:followsProceeding doc:indictment_1998_12_28 ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
