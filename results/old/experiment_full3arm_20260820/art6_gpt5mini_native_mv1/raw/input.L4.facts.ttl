    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 27 January 1999 the applicant filed an objection to the indictment."^^xsd:string .

doc:policeReportSlovenjGradec a echr:AdministrativeAction ;
    rdfs:label "The Slovenj Gradec Police report"^^xsd:string ;
    echr:hasSupportingQuote "The Slovenj Gradec Police report finds, inter alia , that D.P. and J.K. stopped the applicant’s car and that the Special Unit’s officers were under the command of M.J."^^xsd:string .

doc:police_use_of_force_1995_04_05 a echr:EnforcementAction ;
    rdfs:label "On 5 April 1995, at 20.30, physical force and handcuffs were used against Matko"^^xsd:string ;
    echr:hasProceedingStartDate "1995-04-05"^^xsd:date ;
    echr:hasSupportingQuote "On 5 April 1995, at 20.30, Aleksander Matko actively resisted the lawful procedure against him with the intention of preventing criminal police investigators from performing their official duties. Since their official duty could not be carried out otherwise, physical force and handcuffs were used against Matko in accordance with police powers."^^xsd:string .

doc:proc_lawyer_sought_info_1997_01_06 a echr:ProsecutorialReview ;
    rdfs:label "On 6 January 1997 the applicant’s lawyer sought information from the Public Prosecutor’s Office"^^xsd:string ;
