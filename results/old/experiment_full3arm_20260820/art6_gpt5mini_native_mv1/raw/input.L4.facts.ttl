        doc:participationProsecutorreviewMJ ;
    echr:hasSupportingQuote "On 17 January 1997 the Public Prosecutor issued a decision dismissing the applicant’s criminal complaint. It was served on the applicant’s lawyer on 22 January 1997."^^xsd:string .

doc:search_car_1 a echr:EnforcementAction ;
    rdfs:label "the police searched the applicant’s car"^^xsd:string ;
    echr:hasSupportingQuote "In the meantime, the police also searched the applicant’s car."^^xsd:string .

doc:xray_report_19apr a echr:AdministrativeAction ;
    rdfs:label "The report of an x-ray examination on 19 April 1995 indicated that there was a hairline fracture ( fissur a)."^^xsd:string ;
    echr:hasParticipation doc:participation_applicant_xray_19apr ;
    echr:hasProceedingStartDate "1995-04-19"^^xsd:date ;
    echr:hasSupportingQuote "The report of an x-ray examination on 19 April 1995 indicated that there was a hairline fracture ( fissur a)."^^xsd:string .

doc:admin_mia_appointed_working_group_1995_04_20 a echr:AdministrativeAction ;
    rdfs:label "on 20 April 1995, the MIA had appointed a “working group” ( delovna skupina )"^^xsd:string ;
    echr:followsProceeding doc:admin_oral_complaint_1995_04_07 ;
    echr:hasParticipation doc:participationApplicantAdmissionSggh ;
    echr:hasProceedingStartDate "1995-04-20"^^xsd:date ;
    echr:hasSupportingQuote "on 20 April 1995, the MIA had appointed a “working group” ( delovna skupina ) consisting of officers from the Slovenj Gradec Police and the MIA to assess the lawfulness of the procedures carried out by the Special Unit and the Slovenj Gradec Police."^^xsd:string .

doc:admin_mia_report_1995_11_15 a echr:AdministrativeAction ;
    rdfs:label "MIA report submitted on 15 November 1995"^^xsd:string ;
    echr:followsProceeding doc:proc_request_identify_officers_1995_07_14 ;
    echr:hasParticipation doc:participationMiaReport,
        doc:participationMiaReportProsecutor ;
    echr:hasProceedingStartDate "1995-11-15"^^xsd:date ;
    echr:hasSupportingQuote """"Further to the analysis of procedures and activities which had taken place on 4 and 5 April 1995, the working group established that all the measures and procedures were lawful and in accordance with legal powers and professional rules.
(...)
The procedure against Aleksander Matko was carried out by criminal investigators D.P., J.K., M.F, T.G, I.G. and officers of the MIA’s Special Unit, who were headed by M.J (...).\""""^^xsd:string .

doc:admin_oral_complaint_1995_04_07 a echr:AdministrativeAction ;
    rdfs:label "On 7 April 1995 the applicant went to the Slovenj Gradec Police and made an oral complaint"^^xsd:string ;
    echr:followsProceeding doc:case_document_1 ;
    echr:hasParticipation doc:participation_oral_1995_04_07_applicant,
        doc:participation_oral_1995_04_07_police ;
    echr:hasProceedingStartDate "1995-04-07"^^xsd:date ;
    echr:hasSupportingQuote "On 7 April 1995 the applicant went to the Slovenj Gradec Police and made an oral complaint against the officers of the Special Unit concerning the events of 5 April 1995."^^xsd:string .

