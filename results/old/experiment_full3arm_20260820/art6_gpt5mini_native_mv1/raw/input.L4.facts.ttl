doc:admin_written_complaint_1995_05_15 a echr:AdministrativeAction ;
    rdfs:label "On 15 May 1995 the applicant lodged, through his lawyer, a written criminal complaint ( kazenska ovadba ) with the Slovenj Gradec Police"^^xsd:string ;
    echr:followsProceeding doc:admin_mia_appointed_working_group_1995_04_20 ;
    echr:hasParticipation doc:participationApplicantAdmissionSggh,
        doc:participation_written_1995_05_15_police ;
    echr:hasProceedingStartDate "1995-05-15"^^xsd:date ;
    echr:hasSupportingQuote "On 15 May 1995 the applicant lodged, through his lawyer, a written criminal complaint ( kazenska ovadba ) with the Slovenj Gradec Police against unidentified police officers for causing minor bodily harm ( lahka telesna poškodba ) and an unlawful deprivation of liberty ( protipraven odvzem prostosti )."^^xsd:string .

doc:appeal_1997_05_12 a echr:DomesticProceeding ;
    rdfs:label "Public Prosecutor appeal against district court decision (Maribor Higher Court decision 4 December 1997)"^^xsd:string ;
    echr:followsProceeding doc:district_decision_1997_05_08 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "1997-12-04"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationAppealApplicant,
        doc:participationAppealPp ;
    echr:hasProceedingStartDate "1997-05-12"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 4 December 1997 the Maribor Higher Court upheld her appeal finding that, despite the shortcomings mentioned in the first-instance decision, there were sufficient grounds for suspicion that the applicant had committed the alleged offence. Accordingly, it changed the first-instance court’s decision and opened a criminal investigation against the applicant."^^xsd:string .

doc:arrest_1995_04_05 a echr:EnforcementAction ;
    rdfs:label "arrest 5 April 1995"^^xsd:string ;
    echr:followsProceeding doc:police_operation_1995_04_04_05 ;
    echr:hasSupportingQuote "On 5 April 1995 at about 8.30 p.m. the applicant, driving a car, was arrested in Slovenj Gradec by officers of the Special Unit and the Slovenj Gradec Police."^^xsd:string .

