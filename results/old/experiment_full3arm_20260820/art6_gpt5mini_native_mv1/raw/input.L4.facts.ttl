doc:applicant a echr:DomesticAuthority,
        echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Aleksander Matko"^^xsd:string,
        "I.G."^^xsd:string,
        "Mr Aleksander Matko"^^xsd:string,
        "Public Prosecutor"^^xsd:string,
        "Republic of Slovenia"^^xsd:string,
        "Slovenj Gradec Police"^^xsd:string,
        "the MIA"^^xsd:string,
        "the Public Prosecutor"^^xsd:string,
        "the applicant"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityAdministrative,
        echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Public Prosecutor"^^xsd:string,
        "Slovenj Gradec Police"^^xsd:string,
        "the MIA"^^xsd:string,
        "the Public Prosecutor"^^xsd:string ;
    echr:hasJurisdictionState "Slovenia"^^xsd:string ;
    echr:hasPartyName "Public Prosecutor"^^xsd:string,
        "Republic of Slovenia"^^xsd:string,
        "Slovenj Gradec Police"^^xsd:string,
        "the applicant"^^xsd:string ;
    echr:hasPersonName "Aleksander Matko"^^xsd:string,
        "I.G."^^xsd:string,
        "Mr Aleksander Matko"^^xsd:string,
        "the applicant"^^xsd:string ;
    echr:hasSupportingQuote "Aleksander Matko"^^xsd:string,
        "Another officer from the Slovenj Gradec Police, I.G., who had arrived at the scene with the officers of the Special Unit and was also questioned in the criminal investigation, stated that there were 20 officers of the Special Unit and Slovenj Gradec Police at the scene, and that five of them had had direct contact with the applicant."^^xsd:string,
        "On 17 January 1997 the Public Prosecutor issued a decision dismissing the applicant’s criminal complaint."^^xsd:string,
        "On 4 and 5 April 1995 a Special Unit ( Specialna enota ), which was under the direct control of the Ministry of Internal Affairs (\"the MIA\") in cooperation with officers from the Slovenj Gradec Internal Affairs Administration ( Uprava za notranje zadeve – hereinafter referred as the \"Slovenj Gradec Police\") undertook a large-scale operation against the activities of a criminal organisation presumed to be operating on the territory of the town of Slovenj Gradec."^^xsd:string,
        "On 7 April 1995 the applicant went to the Slovenj Gradec Police and made an oral complaint against the officers of the Special Unit concerning the events of 5 April 1995."^^xsd:string,
        "Slovenj Gradec Police"^^xsd:string,
        "The case originated in an application (no. 43393/98) against the Republic of Slovenia lodged with the European Commission of Human Rights (\"the Commission\") under former Article 25 of the Convention for the Protection of Human Rights and Fundamental Freedoms (\"the Convention\") by a Slovenian national, Mr Aleksander Matko (\"the applicant\"), on 22 July 1998."^^xsd:string,
        "The criminal complaint of the Slovenj Gradec Police states that Aleksander Matko sustained injuries as a result of the use of force."^^xsd:string,
        "The procedure against Aleksander Matko was carried out by criminal investigators D.P., J.K., M.F, T.G, I.G. and officers of the MIA’s Special Unit, who were headed by M.J (...)"^^xsd:string,
