    echr:hasSupportingQuote "confirmed by the Supreme Court on 10 August 1998"^^xsd:string .

doc:proceeding_conviction_1998_05_27 a echr:DomesticProceeding ;
    rdfs:label "On 27 May 1998 the Nizhniy Novgorod Regional Court found the applicant guilty on charges of misappropriation and embezzlement, larceny, bribery and attempt not to return money from abroad."^^xsd:string ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasDecisionDate "1998-05-27"^^xsd:date ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partOrderApplicant,
        doc:part_coaccused_trial_1998_05_27,
        doc:part_nl_top_trial_1998_05_27,
        doc:part_shipyard_oka_trial_1998_05_27,
        doc:part_slot_trial_1998_05_27,
        doc:part_zhanto_trial_1998_05_27 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "In total, the court sentenced him to six years in prison and confiscation of some property."^^xsd:string,
        "It appears that the civil claims by the latter three companies were submitted on 20 April 1998, i.e. during the trial."^^xsd:string,
        "On 27 May 1998 the Nizhniy Novgorod Regional Court found the applicant guilty on charges of misappropriation and embezzlement, larceny, bribery and attempt not to return money from abroad."^^xsd:string,
        "The court admitted certain expert reports as evidence, the legality of which was contested by the applicant."^^xsd:string,
        "The court also admitted several documents in English during the trial, the translations of which had not been provided to the applicant before the trial."^^xsd:string,
        "The court also granted civil claims for damages by the shipyard “Oka” and three other companies, “Zhanto”, “NL TOP” and “Slot”."^^xsd:string,
        "The court rejected the defence motions to call some additional witnesses, including the former governor of the region, the Regional Prosecutor and other officials."^^xsd:string,
        "Their statements made during the pre-trial investigation were admitted by the court, after viewing a video tape of their questioning."^^xsd:string .

