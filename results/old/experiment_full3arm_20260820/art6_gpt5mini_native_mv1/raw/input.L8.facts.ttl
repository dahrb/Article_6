doc:supreme_court_judgment_1998_08_10 a echr:DomesticProceeding ;
    rdfs:label "Supreme Court judgment 10 August 1998"^^xsd:string ;
    echr:followsProceeding doc:nn_regional_court_judgment_1998_05_27 ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasDecisionDate "1998-08-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_supreme_applicant_1998,
        doc:part_supreme_representation_1998 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "His lawyers, including Mrs Moskalenko, were present at the hearing."^^xsd:string,
        "On 10 August 1998 the Supreme Court confirmed the judgment of the Nizhniy Novgorod Regional Court, with some alterations."^^xsd:string,
        "The Supreme Court concluded that the disputed evidence had been properly evaluated by the Nizhniy Novgorod Regional Court and found admissible."^^xsd:string,
        "The applicant requested permission to attend the hearing in the Supreme Court in person, but the request was turned down."^^xsd:string,
        "The sentencing of the applicant to a total of six years in prison was upheld."^^xsd:string,
        "the defence requested the court to stand down for lack of impartiality, shown by the refusal to postpone the hearing, but the motion was rejected."^^xsd:string .

