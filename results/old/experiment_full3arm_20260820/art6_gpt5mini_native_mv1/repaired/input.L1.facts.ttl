doc:admin_welfare_report_2002_07_23 a echr:AdministrativeAction ;
    rdfs:label "Ruse social services welfare report 23-07-2002"^^xsd:string ;
    echr:followsProceeding doc:admin_application_social_services_2002_05_29 ;
    echr:hasCourt doc:authorityRuseSocialServices ;
    echr:hasDecisionDate "2002-07-23"^^xsd:date ;
    echr:hasParticipation doc:part_welfare_report_socialservices_2002_07_23 ;
    echr:hasSupportingQuote "Social services drew up a welfare report on the applicant, noting on 23 July 2002 that he was suffering from schizophrenia, that he lived alone in a small, run-down annexe to his half-sister’s house and that his half-sister and his father’s second wife had stated that they did not wish to act as his guardian."^^xsd:string .

doc:caseStanevVBulgaria a echr:CaseDocument ;
    rdfs:label "CASE OF STANEV v. BULGARIA"^^xsd:string ;
    echr:hasApplicant doc:applicantRusiKosevStanev ;
    echr:hasApplicationNumber "36760/06"^^xsd:string ;
    echr:hasExtractionNote "No domestic proceedings are described in the provided excerpt."^^xsd:string ;
    echr:hasJudgmentDate "2012-01-17"^^xsd:date ;
    echr:hasRespondentState "Republic of Bulgaria"^^xsd:string ;
    echr:hasSupportingQuote "**1.** The case originated in an application (no. 36760/06) against the Republic of Bulgaria lodged with the Court under Article 34 of the Convention for the Protection of Human Rights and Fundamental Freedoms (“the Convention”) by a Bulgarian national, Mr Rusi Kosev Stanev (“the applicant”), on 8 September 2006."^^xsd:string .

