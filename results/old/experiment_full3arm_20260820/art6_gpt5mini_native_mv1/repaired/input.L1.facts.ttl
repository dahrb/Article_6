doc:social_assessment_2005 a echr:AdministrativeAction ;
    rdfs:label "social assessment (30 December 2005)"^^xsd:string ;
    echr:followsProceeding doc:req_guardian_2005 ;
    echr:hasDecisionDate "2005-12-30"^^xsd:date ;
    echr:hasParticipation doc:part_assess_applicant_2005,
        doc:part_assess_dept_2005 ;
    echr:hasSupportingQuote "Further to that request, on 30 December 2005 the municipal social assistance department carried out a “social assessment” ( социална оценка ) of the applicant, which concluded that he was incapable of working, even in a sheltered environment, and had no need for training or retraining, and that in those circumstances he was entitled to a social allowance to cover the costs of his transport, subsistence and medication."^^xsd:string .

