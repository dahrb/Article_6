doc:complaint_7dec2012 a echr:AdministrativeAction ;
    rdfs:label "Complaint by D. to HQDCB about 7 December 2012 meeting"^^xsd:string ;
    echr:hasCourt doc:hqdcb ;
    echr:hasParticipation doc:participation_D_complaint_7dec2012,
        doc:participation_applicant_complaint_7dec2012 ;
    echr:hasSupportingQuote "Lawyer D. complained to the HQDCB that by failing to attend the meeting of 7 December 2012 the applicant had violated Article 62 of the Rules of Professional Conduct, adopted by the Congress of Advocates on 17 November 2012 and published on 18 January 2012, which provided that advocates elected to self-government bodies should abstain from actions which might result in blocking the work of those bodies. D. stated that before the meeting of 7 December 2012 the HQDCB had posted a message on its website informing of the date and place of the meeting of 7 December 2012. D. asked the HQDCB to suspend the applicant’s licence."^^xsd:string .

