doc:case_document_1 a echr:CaseDocument ;
    rdfs:label "ECHR judgment"^^xsd:string ;
    echr:hasApplicant doc:partyApplicants,
        doc:partyKarlheinzBeer,
        doc:partyPhilipRegan ;
    echr:hasDomesticProceeding doc:proceeding_german_courts_1 ;
    echr:hasExtractionNote "The provided excerpt contains biographical/employment facts (e.g. placement at the European Space Agency in 1982) but does not describe any domestic court or administrative proceedings prior to the Strasbourg application; do not invent domestic events where none are present."^^xsd:string ;
    echr:hasRespondentState "Germany"^^xsd:string ;
    echr:hasSupportingQuote "By a letter sent by fax on 19 November 1998 the Committee of Staff Representatives of the Coordinated Organisations sought leave to submit written comments (Rules 61 § 3 and 71). On 20 November 1998 the President granted leave subject to certain conditions. The comments were filed at the Registry on 23 November 1998."^^xsd:string,
        "In accordance with the President’s decision, a hearing in this case and in the case of Waite and Kennedy v. Germany (application no. 26083/94) took place in public in the Human Rights Building, Strasbourg, on 25 November 1998."^^xsd:string,
        "Mr Karlheinz Beer is a German national, born in 1952 and resident in Darmstadt. Mr Philip Regan is a British national, born in 1960 and resident in London in the United Kingdom."^^xsd:string,
        "Taking into account in particular the alternative means of legal process available to the applicants, it cannot be said that the limitation on their access to the German courts with regard to ESA impaired the essence of their “right to a court” or was disproportionate for the purposes of Article 6 § 1 of the Convention."^^xsd:string,
        "Waite and Kennedy v. Germany (application no. 26083/94)"^^xsd:string .

