doc:proc_darmstadt_esa_1993_1995 a echr:DomesticProceeding ;
    rdfs:label "proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA"^^xsd:string ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasExtractionNote "In view of the decisions taken in the case of Mr Waite and Mr Kennedy, the applicants did not pursue the matter."^^xsd:string ;
    echr:hasInactivityPeriod doc:inactivity_proc_darmstadt_1995 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_proc1_esa,
        doc:participation_proc1_firstapp,
        doc:participation_proc1_secondapp ;
    echr:hasProceedingStartDate "1993"^^xsd:gYear ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "10 November 1993"^^xsd:string,
        "18 February 1999"^^xsd:string,
        "Article XV § 2"^^xsd:string,
        "In October and November 1993 the applicants instituted proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA, arguing that, pursuant to the German Provision of Labour (Temporary Staff) Act ( Arbeitnehmerüberlassungsgesetz ), they had acquired the status of employees of ESA."^^xsd:string,
        "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."^^xsd:string,
        "file no. 7 AZR 600/92"^^xsd:string,
        "section 20(2) of the Courts Act ( Gerichtsverfassungsgesetz )"^^xsd:string,
        "§§ 21-25"^^xsd:string ;
    echr:isFinalDomesticDecision true .

