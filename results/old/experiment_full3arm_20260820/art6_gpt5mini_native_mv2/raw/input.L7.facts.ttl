doc:procChargedOnIndictment a echr:DomesticProceeding ;
    rdfs:label "charged on an indictment (four counts)"^^xsd:string ;
    echr:followsProceeding doc:admin_interview_1996_04_03 ;
    echr:hasExtractionNote "Count 1: that between 19 and 27 September 1942 he had murdered a Jewess in Domachevo in circumstances constituting a violation of the laws and customs of war"^^xsd:string,
        "Count 4: that between 19 and 31 December 1942 he had murdered a Jew known as Mir Barlas in Domachevo in circumstances constituting a violation of the laws and customs of war"^^xsd:string ;
    echr:hasParticipation doc:participationApplicantCharged,
        doc:participationProsecutionCharged ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "Count 1: that between 19 and 27 September 1942 he had murdered a Jewess in Domachevo in circumstances constituting a violation of the laws and customs of war; ... Count 4: that between 19 and 31 December 1942 he had murdered a Jew known as Mir Barlas in Domachevo in circumstances constituting a violation of the laws and customs of war."^^xsd:string,
        "The applicant was charged on an indictment with four counts of murder:"^^xsd:string .

doc:proc_court_of_appeal_1 a echr:DomesticProceeding ;
    rdfs:label "Court of Appeal decision (refused leave; certified points)"^^xsd:string ;
    echr:followsProceeding doc:proc_trial_1 ;
    echr:hasCourt doc:domauthCourtOfAppeal ;
    echr:hasExtractionNote "point 1: Whether evidence of other criminal activity, not charged in the indictment, allegedly committed by the defendant is admissible to prove that the defendant is one of a group of people, one of whom must have committed the offence charged or under a broader basis, by which the jury ought to have had evidence of the whole background to the offence in order to enable them to see the offences charged in context."^^xsd:string,
        "point 2: If such evidence was admissible, must the jury be instructed in terms that they must not treat the evidence as proof of propensity."^^xsd:string ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_court_of_appeal_applicant_1 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "The Court of Appeal refused leave of appeal to the House of Lords but certified two points of law of general importance, namely:"^^xsd:string .

doc:proc_trial_1 a echr:DomesticProceeding ;
    rdfs:label "first-instance trial"^^xsd:string ;
    echr:hasCourt doc:domauthFirstInstance ;
    echr:hasExtractionNote "13 year old"^^xsd:string,
        "56 years"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_trial_applicant_1 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "Given the unique circumstances of this case and the grave consequences of conviction to the appellant, we have considered with care whether there is any more general ground upon which these convictions could be regarded as unsafe."^^xsd:string .

doc:proceedingPretrialStayApplication a echr:DomesticProceeding ;
    rdfs:label "application that the trial should be stayed as an abuse"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasParticipation doc:participation_pretrial_applicant_1,
        doc:participation_pretrial_prosecution_1 ;
    echr:hasSupportingQuote "Before the commencement of the proceedings, the defence made a number of applications: that the trial should be stayed as an abuse on the basis that due inter alia to the lapse of time since events the applicant could not obtain a fair trial. The application was refused by the trial judge who considered that it was entirely speculative as to whether the unavailability of witnesses was a detriment or a bonus, that the evidence of the eye-witnesses called by the prosecution could be properly and rigorously tested within the confines of the trial process, and that any points which the defence might have about the reliability of the evidence could be fairly accommodated within the trial process."^^xsd:string .

doc:proceedingSiteVisitDomachevo a echr:DomesticProceeding ;
    rdfs:label "judge and jury site visit at Domachevo"^^xsd:string ;
    echr:followsProceeding doc:proceeding_evidence_to_jury_19990226 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:participation_sitevisit_applicant_1,
        doc:participation_sitevisit_prosecution_1 ;
    echr:hasSupportingQuote "During the trial the judge and jury visited the location at Domachevo, including the site in a forest where one witness, Fedor Zan, claimed to have seen the applicant execute a number of Jewish women, including the victim specified in Count 3."^^xsd:string .

doc:proceeding_admissibility_19990208 a echr:DomesticProceeding ;
    rdfs:label "judge ruled that the evidence of both witnesses was relevant and admissible"^^xsd:string ;
    echr:followsProceeding doc:proceedingPretrialStayApplication ;
    echr:hasDecisionDate "1999-02-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:participation_admissibility_applicant_19990208,
