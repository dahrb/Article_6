doc:partyProsecution a echr:Party ;
    rdfs:label "the prosecution"^^xsd:string ;
    echr:hasPartyName "the prosecution"^^xsd:string ;
    echr:hasSupportingQuote "In essence, the prosecution case was that the applicant had been a willing volunteer in the local police force and engaged in the search and kill operation carried out after the massacre of the Jewish inhabitants of the ghetto in Domachevo on 19-20 September 1942."^^xsd:string,
        "Prosecution counsel asked him whether he had ever served in the German army and he denied it very emphatically."^^xsd:string ;
    echr:isRepresentedBy doc:repProsecutionCounsel .

doc:party_prosecution_1 a echr:Party ;
    rdfs:label "the prosecution"^^xsd:string ;
    echr:hasPartyName "the prosecution"^^xsd:string ;
    echr:hasSupportingQuote "Witnesses for the prosecution alleged that they had seen the applicant engaged in acts of violence against Jewish persons and that he had been involved in executions."^^xsd:string .

doc:partyApplicant a echr:DomesticAuthority,
        echr:NaturalPerson,
        echr:Party ;
    rdfs:label "British police"^^xsd:string,
