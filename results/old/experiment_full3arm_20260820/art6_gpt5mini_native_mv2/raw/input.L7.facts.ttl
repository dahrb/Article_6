    echr:hasSupportingQuote "On 8 February 1999, the judge ruled that the evidence of both witnesses was relevant and admissible"^^xsd:string .

doc:proceeding_trial_1 a echr:DomesticProceeding ;
    rdfs:label "trial (first instance)"^^xsd:string ;
    echr:hasCourt doc:trial_court_1 ;
    echr:hasExtractionNote "127 or 128 paces"^^xsd:string,
        "4-5 minutes"^^xsd:string,
        "no fewer than 15 Jewish women"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeUnknown ;
    echr:hasParticipation doc:participation_applicant_trial_1,
        doc:participation_prosecution_trial_1,
        doc:participation_witness_zan_trial_1 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "He hid himself in the bushes and observed what happened. The [applicant] had a submachine gun. The women turned to face the pit and the [applicant] mowed them down with the machine gun."^^xsd:string .

doc:trial_1999_03_29 a echr:DomesticProceeding ;
    rdfs:label "the trial"^^xsd:string ;
    echr:hasAdjournment doc:adjournment_1999_03_29 ;
    echr:hasCourt doc:trial_court_1 ;
    echr:hasDecisionDate "1999-04-01"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_trial_applicant_1 ;
    echr:hasSupportingQuote "On 1 April 1999, the jury convicted the applicant of counts 1 and 3."^^xsd:string,
        "On hearing re-assurances from defence counsel that arrangements would be made for transporting the applicant to and from the court room and for ensuring his welfare in his own home, and having regard to the shortness of the overnight adjournment of the trial, the trial judge reinstated bail."^^xsd:string,
        "The Home Secretary has yet to fix the tariff."^^xsd:string,
        "The Lord Chief Justice recommended a tariff (the period to be served for retribution and deterrence) of five years."^^xsd:string,
        "The applicant was sentenced to a mandatory term of life imprisonment."^^xsd:string .

