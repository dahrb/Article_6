    echr:hasJurisdictionState "United Kingdom"^^xsd:string ;
    echr:hasPartyName "the applicant"^^xsd:string ;
    echr:hasPersonName "the applicant"^^xsd:string ;
    echr:hasSupportingQuote "On 1 and 3 April 1996, the applicant was interviewed by the British police concerning his activities in Domachevo during the German occupation."^^xsd:string,
        "When the applicant gave evidence, he referred to his service in the Polish army, again with reference to the Polish records, and stated that he had in fact left Domachevo at the end of 1943, not during 1944 as had been part of a formal admission by his legal representatives."^^xsd:string,
        "Witnesses for the prosecution alleged that they had seen the applicant engaged in acts of violence against Jewish persons and that he had been involved in executions."^^xsd:string,
        "grave consequences of conviction to the appellant"^^xsd:string,
        "the applicant"^^xsd:string ;
