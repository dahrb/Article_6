doc:admin_request_2008_07_23 a echr:AdministrativeAction ;
    rdfs:label "request for information to President of the Arbitration Tribunal 23 July 2008"@en ;
    echr:hasParticipation doc:part_admin_applicant_2008_07_23,
        doc:part_admin_president_2008_07_23 ;
    echr:hasProceedingStartDate "2008-07-23"^^xsd:date ;
    echr:hasSupportingQuote "On 23 July 2008 the applicant company’s representative sent a request for information to the President of the Arbitration Tribunal, asking whether the arbitration clause contained in the contracts concluded between the parties was sufficient for the tribunal to accept the claim for examination, and whether the decisions of the Commercial Court to leave the claim unexamined on the grounds that the determination of the dispute fell within the jurisdiction of a commercial arbitration court provided sufficient grounds for accepting the claim."^^xsd:string .

