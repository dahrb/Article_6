doc:transfer_2009_02_27 a echr:DomesticProceeding ;
    rdfs:label "transfer to District Court 2009-02-27"@en ;
    echr:hasCourt doc:yerevanCivilCourtAuth ;
    echr:hasDecisionDate "2009-02-27"^^xsd:date ;
    echr:hasExtractionNote "paragraph 29"^^xsd:string ;
    echr:hasParticipation doc:participationApplicantTransfer,
        doc:participationLlcTransfer ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 27 February 2009 the Yerevan Civil Court transferred the case to the Kentron and Nork-Marash District Court of Yerevan (“the District Court”) based on territorial jurisdiction, in view of the fact that on 1 March 2009 the Yerevan Civil Court would be abolished."^^xsd:string .

doc:yerevan_proceeding_2008_10_17 a echr:DomesticProceeding ;
    rdfs:label "on 17 October 2008 the applicant company lodged a claim with the Yerevan Civil Court, seeking to recover EUR 116,600 from the LLC, representing the amount of the loan and interest; the applicant company also applied for a freezing injunction in respect of the respondent’s assets in the amount of the claim."^^xsd:string ;
    echr:followsProceeding doc:arbitration_refusal_letter_2008_10_07 ;
    echr:hasCourt doc:yerevanCivilCourt ;
    echr:hasExtractionNote "claim amount: EUR 116,600"^^xsd:string ;
    echr:hasParticipation doc:participation_yerevan_applicant_2008_10_17,
        doc:participation_yerevan_llc_2008_10_17 ;
    echr:hasProceedingStartDate "2008-10-17"^^echr:PartialDate ;
    echr:hasSupportingQuote "In view of the fact that the Commercial Court had been abolished by that time, on 17 October 2008 the applicant company lodged a claim with the Yerevan Civil Court, seeking to recover EUR 116,600 from the LLC, representing the amount of the loan and interest. It submitted that the Arbitration Tribunal had refused to accept the claim for examination even though the Commercial Court had already found that the determination of the dispute fell within the tribunal’s jurisdiction. In such circumstances, the applicant company’s right of access to a court had been violated. The applicant company also applied for a freezing injunction in respect of the respondent’s assets in the amount of the claim."^^xsd:string .

doc:appealProc a echr:DomesticProceeding ;
    rdfs:label "appeal to Civil Court of Appeal 2009-06-25"@en ;
    echr:followsProceeding doc:districtCourtProc ;
    echr:hasCourt doc:civilCourtOfAppealAuth ;
    echr:hasDecisionDate "2009-07-21"^^xsd:date ;
    echr:hasExtractionNote "paragraph 34"^^xsd:string,
        "paragraph 35"^^xsd:string,
        "paragraph 36"^^xsd:string ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasParticipation doc:participationApplicantAppeal,
        doc:participationLlcAppeal ;
    echr:hasProceedingStartDate "2009-06-25"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 21 July 2009 the Civil Court of Appeal upheld the decision of 16 June 2009. In doing so, it stated, in particular, that the applicant company had failed to submit to the Arbitration Tribunal extracts of the contracts containing the arbitration clause, as a result of which its claim had not been accepted."^^xsd:string,
        "On 25 June 2009 the applicant company lodged an appeal."^^xsd:string .

doc:districtCourtProc a echr:DomesticProceeding ;
    rdfs:label "District Court proceeding (first-instance) 2009"@en ;
    echr:hasCourt doc:districtCourtAuth ;
    echr:hasDecisionDate "2009-06-16"^^xsd:date ;
    echr:hasExtractionNote "paragraph 30"^^xsd:string,
        "paragraph 31"^^xsd:string,
        "paragraph 32"^^xsd:string,
        "paragraph 33"^^xsd:string ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasParticipation doc:participationApplicantAppeal,
        doc:participationLlcAppeal ;
    echr:hasProceedingStartDate "2009-03-13"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "On 13 March 2009 the District Court accepted the case for examination."^^xsd:string,
        "On 16 June 2009 the District Court decided to leave the claim lodged by the applicant company unexamined, finding that the refusal to start arbitration proceedings stated in the letter of 7 October 2008 did not substantiate the fact that there was no possibility of applying to the Arbitration Tribunal. The District Court further referred to the previous findings of the Commercial Court to conclude that the claim should be left unexamined."^^xsd:string .

