        foaf:Document ;
    dcterms:title "input.jsonl:5"^^xsd:string .

doc:case_69358_13 a echr:CaseDocument ;
    rdfs:label "CASE OF MARTYNOVSKIY v. UKRAINE (Application no. 69358/13)"^^xsd:string ;
    echr:hasApplicant doc:romanMartynovskiy ;
    echr:hasApplicationNumber "69358/13"^^xsd:string ;
    echr:hasDomesticProceeding doc:hq_appeal_2013,
        doc:qdc_disciplinary_2013,
        doc:qdc_uphold_2013 ;
    echr:hasRespondentState "Ukraine"^^xsd:string .

doc:d_observations_2013 a echr:AdministrativeAction ;
    rdfs:label "D.'s observations to the HQDCB (18 July 2013)"^^xsd:string ;
    echr:hasCourt doc:hqDcb ;
    echr:hasDecisionDate "2013-07-18"^^echr:PartialDate ;
    echr:hasSupportingQuote "On 18 July 2013 D. submitted his observations to the HQDCB requesting it to reject the applicant’s appeal."^^xsd:string .

doc:hq_meeting_2012 a echr:AdministrativeAction ;
    rdfs:label "HQDCB meeting of 7 December 2012"^^xsd:string ;
    echr:hasCourt doc:hqDcb ;
    echr:hasProceedingStartDate "2012-12-07"^^echr:PartialDate ;
    echr:hasSupportingQuote "On 7 December 2012 the HQDCB held its first meeting, but the applicant did not attend."^^xsd:string .

doc:hq_meeting_2013 a echr:AdministrativeAction ;
    rdfs:label "HQDCB meeting of 19 April 2013"^^xsd:string ;
    echr:hasCourt doc:hqDcb ;
    echr:hasDecisionDate "2013-04-19"^^echr:PartialDate ;
    echr:hasSupportingQuote "Since his licence had been suspended, the applicant was not allowed to attend the meeting of the HQDCB on 19 April 2013."^^xsd:string .

doc:notification_2013 a echr:AdministrativeAction ;
    rdfs:label "Notification to applicant of decision (22 April 2013)"^^xsd:string ;
    echr:hasCourt doc:disciplinaryChamberZakarpattya ;
    echr:hasDecisionDate "2013-04-22"^^echr:PartialDate ;
    echr:hasSupportingQuote "On 22 April 2013 the applicant was informed of the meeting and the decision of 17 April 2013."^^xsd:string .

doc:hq_appeal_2013 a echr:DomesticProceeding ;
    rdfs:label "Appeal to the HQDCB (2013) against decisions of 17 April and 16 May 2013"^^xsd:string ;
    echr:followsProceeding doc:qdc_uphold_2013 ;
    echr:hasCourt doc:hqDcb ;
    echr:hasParticipation doc:partHqAppealApplicant,
        doc:partHqAppealHq,
        doc:partHqAppealQdc ;
    echr:hasProceedingStartDate "2013-04-19"^^echr:PartialDate ;
    echr:hasSupportingQuote "The applicant appealed against the decisions of 17 April and 16 May 2013 to the HQDCB, however the appeal did not have a suspensive effect."^^xsd:string ;
    echr:isPending true .

doc:kikkas a echr:LegalRepresentative,
        echr:NaturalPerson ;
    rdfs:label "Mr M. Kikkas"^^xsd:string ;
    echr:hasPersonName "Mr M. Kikkas"^^xsd:string ;
    echr:hasSupportingQuote "the application (no. 69358/13) ... was represented by Mr A.V. Yakovlev and Mr M. Kikkas, lawyers practising in Kyiv;"^^xsd:string .

