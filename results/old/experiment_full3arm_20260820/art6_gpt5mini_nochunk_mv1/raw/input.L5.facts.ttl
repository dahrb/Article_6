    rdfs:label "Participation: applicant in HQDCB appeal (2013)"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:romanMartynovskiy .

doc:partHqAppealHq a echr:Participation ;
    rdfs:label "Participation: HQDCB in HQDCB appeal (2013)"^^xsd:string ;
    echr:hasPartySide echr:SideThirdParty ;
    echr:participatingParty doc:hqDcb .

doc:partHqAppealQdc a echr:Participation ;
    rdfs:label "Participation: QDC of Zakarpattya in HQDCB appeal (2013)"^^xsd:string ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:qdcZakarpattya .

doc:partQdcDisciplinaryApplicant a echr:Participation ;
    rdfs:label "Participation: applicant in QDC disciplinary (17 Apr 2013)"^^xsd:string ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:romanMartynovskiy .

doc:partQdcDisciplinaryChamber a echr:Participation ;
    rdfs:label "Participation: Disciplinary Chamber in QDC disciplinary (17 Apr 2013)"^^xsd:string ;
    echr:hasPartySide echr:SideThirdParty ;
    echr:participatingParty doc:disciplinaryChamberZakarpattya .

doc:partQdcDisciplinaryD a echr:Participation ;
    rdfs:label "Participation: D. in QDC disciplinary (17 Apr 2013)"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:complainantD .

doc:partQdcUpholdApplicant a echr:Participation ;
    rdfs:label "Participation: applicant in QDC uphold (16 May 2013)"^^xsd:string ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:romanMartynovskiy .

doc:partQdcUpholdD a echr:Participation ;
    rdfs:label "Participation: D. in QDC uphold (16 May 2013)"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:complainantD .

doc:partQdcUpholdQdc a echr:Participation ;
    rdfs:label "Participation: QDC of Zakarpattya in QDC uphold (16 May 2013)"^^xsd:string ;
    echr:hasPartySide echr:SideThirdParty ;
    echr:participatingParty doc:qdcZakarpattya .

doc:transfer_2013 a echr:AdministrativeAction ;
    rdfs:label "Transfer of D.'s complaint to the QDC of Zakarpattya (24 January 2013)"^^xsd:string ;
    echr:hasCourt doc:hqDcb ;
    echr:hasDecisionDate "2013-01-24"^^echr:PartialDate ;
    echr:hasSupportingQuote "On 24 January 2013 the head of the HQDCB transferred D.’s complaint to the Qualification and Disciplinary Commission of the Regional Bar of Zakarpattya (\"the QDC of Zakarpattya\")."^^xsd:string .

doc:yakovlev a echr:LegalRepresentative,
        echr:NaturalPerson ;
    rdfs:label "Mr A.V. Yakovlev"^^xsd:string ;
    echr:hasPersonName "Mr A.V. Yakovlev"^^xsd:string ;
    echr:hasSupportingQuote "the application (no. 69358/13) ... was represented by Mr A.V. Yakovlev and Mr M. Kikkas, lawyers practising in Kyiv;"^^xsd:string .

doc:complainantD a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "D."^^xsd:string ;
    echr:hasPersonName "D."^^xsd:string ;
    echr:hasSupportingQuote "Lawyer D. complained to the HQDCB that by failing to attend the meeting of 7 December 2012 the applicant had violated Article 62 of the Rules of Professional Conduct, adopted by the Congress of Advocates on 17 November 2012 and published on 18 January 2012, which provided that advocates elected to self-government bodies should abstain from actions which might result in blocking the work of those bodies. D. stated that before the meeting of 7 December 2012 the HQDCB had posted a message on its website informing of the date and place of the meeting of 7 December 2012. D. asked the HQDCB to suspend the applicant’s licence."^^xsd:string .

doc:qdc_disciplinary_2013 a echr:DomesticProceeding ;
    rdfs:label "Disciplinary Chamber decision of 17 April 2013 (QDC of Zakarpattya)"^^xsd:string ;
    echr:followsProceeding doc:transfer_2013 ;
    echr:hasCourt doc:disciplinaryChamberZakarpattya ;
    echr:hasDecisionDate "2013-04-17"^^echr:PartialDate ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partQdcDisciplinaryApplicant,
        doc:partQdcDisciplinaryChamber,
        doc:partQdcDisciplinaryD ;
    echr:hasProceedingStartDate "2013-01-24"^^echr:PartialDate ;
    echr:hasSupportingQuote "On 17 April 2013, in the applicant’s absence, the Disciplinary Chamber of the QDC of Zakarpattya suspended the applicant’s licence to practise as an advocate for six months for his failure to attend the meeting of 7 December 2012 and violating Article 62 of the Rules of Professional Conduct."^^xsd:string .

doc:qdc_uphold_2013 a echr:DomesticProceeding ;
    rdfs:label "QDC of Zakarpattya upheld decision on 16 May 2013"^^xsd:string ;
    echr:followsProceeding doc:qdc_disciplinary_2013 ;
    echr:hasCourt doc:qdcZakarpattya ;
    echr:hasDecisionDate "2013-05-16"^^echr:PartialDate ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:partQdcUpholdApplicant,
        doc:partQdcUpholdD,
        doc:partQdcUpholdQdc ;
    echr:hasProceedingStartDate "2013-04-17"^^echr:PartialDate ;
    echr:hasSupportingQuote "On 16 May the QDC of Zakarpattya upheld the decision of 17 April 2013."^^xsd:string .

doc:disciplinaryChamberZakarpattya a echr:DomesticAuthority ;
    rdfs:label "Disciplinary Chamber of the QDC of Zakarpattya"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityDisciplinary ;
    echr:hasAuthorityName "Disciplinary Chamber of the QDC of Zakarpattya"^^xsd:string ;
    echr:hasSupportingQuote "On 17 April 2013, in the applicant’s absence, the Disciplinary Chamber of the QDC of Zakarpattya suspended the applicant’s licence to practise as an advocate for six months for his failure to attend the meeting of 7 December 2012 and violating Article 62 of the Rules of Professional Conduct."^^xsd:string .

doc:qdcZakarpattya a echr:DomesticAuthority ;
    rdfs:label "Qualification and Disciplinary Commission of the Regional Bar of Zakarpattya"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityDisciplinary ;
    echr:hasAuthorityName "Qualification and Disciplinary Commission of the Regional Bar of Zakarpattya"^^xsd:string ;
    echr:hasSupportingQuote "On 24 January 2013 the head of the HQDCB transferred D.’s complaint to the Qualification and Disciplinary Commission of the Regional Bar of Zakarpattya (\"the QDC of Zakarpattya\")."^^xsd:string .

doc:romanMartynovskiy a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Mr Roman Yuryevich Martynovskiy"^^xsd:string ;
    echr:hasPersonName "Mr Roman Yuryevich Martynovskiy"^^xsd:string ;
    echr:hasSupportingQuote "the application (no. 69358/13) against Ukraine lodged with the Court under Article 34 of the Convention for the Protection of Human Rights and Fundamental Freedoms (\"the Convention\") on 19 September 2013 by a Ukrainian national, Mr Roman Yuryevich Martynovskiy (\"the applicant\"), who was born in 1965, lives in Kyiv and was represented by Mr A.V. Yakovlev and Mr M. Kikkas, lawyers practising in Kyiv;"^^xsd:string ;
    echr:isRepresentedBy doc:kikkas,
        doc:yakovlev .

doc:hqDcb a echr:DomesticAuthority ;
    rdfs:label "Higher Qualification and Disciplinary Commission of the Bar (the HQDCB)"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityDisciplinary ;
    echr:hasAuthorityName "Higher Qualification and Disciplinary Commission of the Bar"^^xsd:string ;
    echr:hasSupportingQuote "On 12 October 2012 the members of the Sevastopol Bar elected the applicant to represent them in the Higher Qualification and Disciplinary Commission of the Bar (\"the HQDCB\"), one of the governing bodies of the Bar of Ukraine."^^xsd:string .

