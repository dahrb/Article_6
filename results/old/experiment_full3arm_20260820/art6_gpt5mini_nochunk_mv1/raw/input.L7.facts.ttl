doc:domestic_proceeding_trial_1999 a echr:DomesticProceeding ;
    rdfs:label "Trial before Mr Justice Potts and a jury (8 Feb - 1 Apr 1999)"^^xsd:string ;
    echr:hasCourt doc:courtPottsAndJury ;
    echr:hasDecisionDate "1999-04-01"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationTrialApplicant,
        doc:participationTrialProsecution ;
    echr:hasProceedingStartDate "1999-02-08"^^xsd:date ;
    echr:hasSupportingQuote "In the trial which took place between 8 February and 1 April 1999, before Mr Justice Potts and a jury, the applicant was tried on four counts of murder."^^xsd:string,
        "On 1 April 1999, the jury convicted the applicant of counts 1 and 3. The applicant was sentenced to a mandatory term of life imprisonment."^^xsd:string,
        "On 25 March 1999, before the closing speeches were due to begin ... the judge ... decided to withdraw the applicant’s bail."^^xsd:string,
        "On 29 March 1999 ... the trial judge reinstated bail."^^xsd:string .

