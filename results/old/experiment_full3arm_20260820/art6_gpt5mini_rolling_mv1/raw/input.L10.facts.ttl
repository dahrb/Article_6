doc:conseilDetat a echr:DomesticAuthority ;
    rdfs:label "the Conseil d’État"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasJurisdictionState "Belgium"^^xsd:string ;
    echr:hasSupportingQuote "An appeal lies against decisions taken at first instance, and an appeal on points of law may be lodged against judgments given on appeal."^^xsd:string,
        "Under section 39/67 of the Aliens Act, an appeal on points of law against the decisions of the Aliens Appeals Board lies to the Conseil d’État."^^xsd:string,
        "the Conseil d’État"^^xsd:string .

doc:domestic_proceeding_admin_challenge_aliens_office_2016 a echr:DomesticProceeding ;
    rdfs:label "proceedings before the administrative courts to challenge the refusal by the Aliens Office"@en ;
    echr:hasCourt doc:administrativeCourts ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasParticipation doc:participation_applicants_admin_challenge_1,
        doc:participation_belgian_state_admin_challenge_1 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "During the administrative phase, the applicants attempted, firstly, to obtain documents that would enable them to enter and reside legally in Belgium for the period required to make a formal asylum claim; secondly, they brought proceedings before the administrative courts to challenge the refusal by the Aliens Office to issue them with visas."^^xsd:string .

