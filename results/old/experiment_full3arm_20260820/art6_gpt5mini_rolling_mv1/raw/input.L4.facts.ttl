doc:written_complaint_1995_05_15 a echr:AdministrativeAction ;
    rdfs:label "written criminal complaint 15 May 1995"^^xsd:string ;
    echr:hasParticipation doc:participation_written_applicant_1995_05_15,
        doc:participation_written_slovenj_gradec_police_1995_05_15 ;
    echr:hasProceedingStartDate "1995-05-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 15 May 1995 the applicant lodged, through his lawyer, a written criminal complaint ( kazenska ovadba ) with the Slovenj Gradec Police against unidentified police officers for causing minor bodily harm ( lahka telesna poškodba ) and an unlawful deprivation of liberty ( protipraven odvzem prostosti ). The complaint mentions the names of two officers, D.P. and J.K., who were present at the scene but not involved in the alleged ill-treatment. The applicant proposed that the names of the officers who had allegedly ill-treated him be obtained from those officers and that criminal proceedings be introduced."^^xsd:string .

