doc:criminal_proceedings_1995_1998 a echr:DomesticProceeding ;
    rdfs:label "criminal proceedings (pre-1998)"^^xsd:string ;
    echr:followsProceeding doc:pretrial_investigation_1995 ;
    echr:hasParticipation doc:participation_criminal_applicant_1995_1998,
        doc:participation_criminal_state_1995_1998,
        doc:participation_interview_officer_d_p_1998,
        doc:participation_interview_officer_i_g_1998,
        doc:participation_interview_officer_j_k_1998,
        doc:participation_interview_officer_m_f_1998,
        doc:participation_interview_officer_m_j_1998,
        doc:participation_interview_officer_t_g_1998,
        doc:participation_interview_witness_a_k_1998 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "Between 19 February 1998 and 10 March 1998 the investigating judge interviewed five officers from the Slovenj Gradec Police who had participated in the operation, the officer M.J., who had been responsible for the officers of the Special Unit, and A.K., who had allegedly witnessed the incident."^^xsd:string,
        "the criminal proceedings had been unfair and excessively long (Article 6 of the Convention)."^^xsd:string ;
    echr:isPending true .

doc:district_court_decision_1997_05_08 a echr:DomesticProceeding ;
    rdfs:label "Slovenj Gradec District Court decision not to open investigation 8 May 1997"^^xsd:string ;
    echr:followsProceeding doc:investigation_request_1997_01_17 ;
    echr:hasCourt doc:domesticAuthoritySlovenjGradecDistrictCourt ;
    echr:hasDecisionDate "1997-05-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_districtcourt_applicant_1997_05_08,
        doc:participation_districtcourt_pp_1997_05_08 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 8 May 1997, further to a proposal of the investigating judge, the Slovenj Gradec District Court decided not to open a criminal investigation against the applicant. The court pointed out, inter alia , that the officers who were allegedly attacked by the applicant had not been identified and that the Ministry’s report, stating that a special operation for the investigation of serious crimes was in progress at that time, and the Public Prosecutor’s request for the investigation, which stated that the applicant was arrested because of his excessive speed, were contradictory."^^xsd:string .

doc:investigation_request_1997_01_17 a echr:DomesticProceeding ;
    rdfs:label "request for investigation lodged with investigating judge 17 January 1997"^^xsd:string ;
    echr:followsProceeding doc:pretrial_investigation_1995 ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasParticipation doc:participation_investigation_request_applicant_1997,
        doc:participation_investigation_request_pp_1997,
        doc:participation_questioning_applicant_1997_04_08 ;
    echr:hasProceedingStartDate "1997-01-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "In addition, on 17 January 1997, a request for an investigation against Matko Aleksander was lodged with the investigating judge in the Slovenj Gradec District Court, for, among other matters, obstructing an official in the course of his duties (...)"^^xsd:string,
        "On 17 January 1997 the Public Prosecutor requested the Slovenj Gradec District Court to open a criminal investigation against the applicant. It appears that her request was based on the above-mentioned reports of the MIA and the Slovenj Gradec Police (see paragraphs 31-33)."^^xsd:string .

