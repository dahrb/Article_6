doc:investigation_conclusion_1998_03_17 a echr:DomesticProceeding ;
    rdfs:label "investigating judge decision excluding documents 17 March 1998"^^xsd:string ;
    echr:followsProceeding doc:criminal_proceedings_1995_1998 ;
    echr:hasDecisionDate "1998-03-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeOther ;
    echr:hasOutcomeDirection echr:DirectionUnknown ;
    echr:hasParticipation doc:participation_investigation_conclusion_applicant_1998_03_17 ;
    echr:hasSupportingQuote "On 17 March 1998 the criminal investigation was concluded with the investigating judge’s decision ordering the exclusion of certain documents from the case-file in accordance with section 83, paragraph 3, of the Criminal Procedure Act. It is not known when that decision was served on the applicant."^^xsd:string .

doc:maribor_higher_court_decision_1997_12_04 a echr:DomesticProceeding ;
    rdfs:label "Maribor Higher Court decision 4 December 1997"^^xsd:string ;
    echr:followsProceeding doc:appeal_pp_1997_05_12 ;
    echr:hasCourt doc:domesticAuthorityMariborHigherCourt ;
    echr:hasDecisionDate "1997-12-04"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_maribor_applicant_1997_12_04,
        doc:participation_maribor_pp_1997_12_04 ;
    echr:hasSupportingQuote "On 4 December 1997 the Maribor Higher Court upheld her appeal finding that, despite the shortcomings mentioned in the first-instance decision, there were sufficient grounds for suspicion that the applicant had committed the alleged offence. Accordingly, it changed the first-instance court’s decision and opened a criminal investigation against the applicant."^^xsd:string .

doc:mia_report_1995_11_15 a echr:AdministrativeAction ;
    rdfs:label "MIA report 15 November 1995"^^xsd:string ;
    echr:hasParticipation doc:participation_mia_report_1995_11_15 ;
    echr:hasProceedingStartDate "1995-11-15"^^xsd:date ;
    echr:hasSupportingQuote "Further to the analysis of procedures and activities which had taken place on 4 and 5 April 1995, the working group established that all the measures and procedures were lawful and in accordance with legal powers and professional rules."^^xsd:string,
        "one by the MIA on 15 November 1995"^^xsd:string .

doc:mia_working_group_1995_04_20 a echr:AdministrativeAction ;
    rdfs:label "MIA working group appointment 20 April 1995"^^xsd:string ;
    echr:hasParticipation doc:participation_mia_1995_04_20,
        doc:participation_police_for_working_group_1995_04_20 ;
    echr:hasProceedingStartDate "1995-04-20"^^xsd:date ;
    echr:hasSupportingQuote "It transpires from the MIA’s report that, on 20 April 1995, the MIA had appointed a “working group” ( delovna skupina ) consisting of officers from the Slovenj Gradec Police and the MIA to assess the lawfulness of the procedures carried out by the Special Unit and the Slovenj Gradec Police."^^xsd:string .

doc:oral_complaint_1995_04_07 a echr:AdministrativeAction ;
    rdfs:label "oral complaint 7 April 1995"^^xsd:string ;
    echr:hasParticipation doc:participation_oral_applicant_1995_04_07,
        doc:participation_oral_slovenj_gradec_police_1995_04_07 ;
    echr:hasProceedingStartDate "1995-04-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 7 April 1995 the applicant went to the Slovenj Gradec Police and made an oral complaint against the officers of the Special Unit concerning the events of 5 April 1995. A written statement was prepared by the officer in charge and signed by the applicant."^^xsd:string .

doc:police_report_1996_02_05 a echr:AdministrativeAction ;
    rdfs:label "Slovenj Gradec Police report 5 February 1996"^^xsd:string ;
    echr:hasParticipation doc:participation_police_report_1996_02_05 ;
    echr:hasProceedingStartDate "1996-02-05"^^xsd:date ;
    echr:hasSupportingQuote "The Slovenj Gradec Police report finds, inter alia , that D.P. and J.K. stopped the applicant’s car and that the Special Unit’s officers were under the command of M.J. It explains that the Head of the Special Unit was authorised to give statements concerning the procedure of the Special Unit."^^xsd:string,
        "one by the Slovenj Gradec Police on 5 February 1996"^^xsd:string .

