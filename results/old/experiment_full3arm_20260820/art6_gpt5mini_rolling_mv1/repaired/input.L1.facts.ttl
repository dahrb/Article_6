doc:caseStanevVBulgaria a echr:CaseDocument ;
    rdfs:label "CASE OF STANEV v. BULGARIA"^^xsd:string ;
    echr:hasApplicant doc:applicantRusiKosevStanev ;
    echr:hasApplicationNumber "36760/06"^^xsd:string ;
    echr:hasExtractionNote "No domestic proceedings are described in the provided excerpt."^^xsd:string ;
    echr:hasJudgmentDate "2012-01-17"^^xsd:date ;
    echr:hasRespondentState "Republic of Bulgaria"^^xsd:string ;
    echr:hasSupportingQuote "**1.** The case originated in an application (no. 36760/06) against the Republic of Bulgaria lodged with the Court under Article 34 of the Convention for the Protection of Human Rights and Fundamental Freedoms (“the Convention”) by a Bulgarian national, Mr Rusi Kosev Stanev (“the applicant”), on 8 September 2006."^^xsd:string .

doc:governmentBulgaria a echr:Party ;
    rdfs:label "The Bulgarian Government"^^xsd:string ;
    echr:hasPartyName "The Bulgarian Government"^^xsd:string ;
    echr:hasSupportingQuote "The Bulgarian Government (“the Government”) were represented by their Agents, Ms N. Nikolova and Ms R. Nikolova, of the Ministry of Justice."^^xsd:string ;
    echr:isRepresentedBy doc:agentMsNNikolova,
        doc:agentMsRNikolova .

doc:guardianOfApplicant a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "in 2005 the applicant’s guardian"^^xsd:string ;
    echr:hasPersonName "the applicant’s guardian"^^xsd:string ;
    echr:hasSupportingQuote "in 2005 the applicant’s guardian asked the Municipal Council to grant a social allowance to facilitate his reintegration into the community."^^xsd:string .

doc:guardian_request_2005 a echr:DomesticEvent ;
    rdfs:label "in 2005 the applicant’s guardian asked the Municipal Council to grant a social allowance to facilitate his reintegration into the community."^^xsd:string ;
    echr:hasProceedingStartDate "2005"^^xsd:gYear ;
    echr:hasSupportingQuote "in 2005 the applicant’s guardian asked the Municipal Council to grant a social allowance to facilitate his reintegration into the community."^^xsd:string .

doc:medical_examination_2006 a echr:DomesticEvent ;
    rdfs:label "In addition, at his lawyer’s request, the applicant was examined on 31 August 2006 by Dr V.S., a different psychiatrist from the one who regularly visited the social care home, and by a psychologist, Ms I.A."^^xsd:string ;
    echr:hasParticipation doc:participationExamDrVS,
        doc:participationExamMsIA,
        doc:participation_exam_applicant_2006 ;
    echr:hasProceedingStartDate "2006-08-31"^^xsd:date ;
    echr:hasSupportingQuote "In addition, at his lawyer’s request, the applicant was examined on 31 August 2006 by Dr V.S., a different psychiatrist from the one who regularly visited the social care home, and by a psychologist, Ms I.A. The report drawn up on that occasion concluded that the diagnosis of schizophrenia given on 15 June 2005 (see paragraph 37 below) was inaccurate in that the patient did not display all the symptoms of that condition."^^xsd:string .

