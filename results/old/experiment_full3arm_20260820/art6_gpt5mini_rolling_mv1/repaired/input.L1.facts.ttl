doc:social_assessment_2005 a echr:AdministrativeAction ;
    rdfs:label "on 30 December 2005 the municipal social assistance department carried out a “social assessment” ( социална оценка ) of the applicant, which concluded that he was incapable of working, even in a sheltered environment, and had no need for training or retraining, and that in those circumstances he was entitled to a social allowance to cover the costs of his transport, subsistence and medication."^^xsd:string ;
    echr:hasCourt doc:municipalSocialAssistanceDepartment ;
    echr:hasDecisionDate "2005-12-30"^^xsd:date ;
    echr:hasParticipation doc:participation_social_assessment_2005_applicant,
        doc:participation_social_assessment_2005_department ;
    echr:hasSupportingQuote "on 30 December 2005 the municipal social assistance department carried out a “social assessment” ( социална оценка ) of the applicant, which concluded that he was incapable of working, even in a sheltered environment, and had no need for training or retraining, and that in those circumstances he was entitled to a social allowance to cover the costs of his transport, subsistence and medication."^^xsd:string .

