doc:proceeding_general_assembly_2015_07_07 a echr:DomesticProceeding ;
    rdfs:label "Proceeding before the General Assembly of the Administrative Proceedings Divisions (7 July 2015)"^^xsd:string ;
    echr:followsProceeding doc:proceeding_supadm_ch13_2014_12_09 ;
    echr:hasCourt doc:supremeAdministrativeCourt ;
    echr:hasDecisionDate "2015-07-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
