doc:company_a_1 a echr:Party ;
    rdfs:label "company A."^^xsd:string ;
    echr:hasPartyName "company A."^^xsd:string ;
    echr:hasSupportingQuote "However, only company A. participated in the auction held on 8 February 2011. Company A. initially submitted a bid of USD 3,750,000, after which the tendering process proceeded to the next stage of open bidding. Company A. then increased its offer to USD 4,150,000... On 11 February 2011, during the negotiation phase, company A. raised its bid to USD 5,000,000."^^xsd:string .

doc:tskb a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "Industrial Development Bank of Türkiye (Türkiye Sınaî Kalkınma Bankası A.Ş.)"^^xsd:string ;
    echr:hasAuthorityName "Industrial Development Bank of Türkiye ( Türkiye Sınaî Kalkınma Bankası A.Ş ., hereinafter referred to as “TSKB”)"^^xsd:string ;
    echr:hasSupportingQuote "On 1 August 2007, the Industrial Development Bank of Türkiye ( Türkiye Sınaî Kalkınma Bankası A.Ş ., hereinafter referred to as “TSKB”) issued a report and determined that the value of the Radio Viva Economic and Commercial Unit (hereinafter referred to as “Radio Viva”) was 4,258,000 United States dollars (USD), while the value of the Viva TV Economic and Commercial Unit (hereinafter referred to as “Viva TV”) was USD 373,400."^^xsd:string .

doc:supremeAdministrativeCourt a echr:DomesticAuthority ;
    rdfs:label "13th Chamber of the Supreme Administrative Court"^^xsd:string,
        "General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court"^^xsd:string,
        "Supreme Administrative Court"^^xsd:string,
        "administrative court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "13th Chamber of the Supreme Administrative Court"^^xsd:string,
        "General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court"^^xsd:string,
        "Supreme Administrative Court"^^xsd:string,
        "administrative court"^^xsd:string ;
    echr:hasJurisdictionState "the Republic of Türkiye"^^xsd:string ;
    echr:hasSupportingQuote "On 7 July 2015, following an appeal by the applicant, the General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court ( Danıstay İdari Dava Daireleri Genel Kurulu – hereinafter “the General Assembly”), in line with the dissenting opinion, ruled that the estimated value of USD 6,000,000 had been determined on the basis of the 2009 valuation report, without any new assessment of the market value. The General Assembly concluded that the contested decision was not in compliance with the law, and, by a majority, annulled the Fund’s decision."^^xsd:string,
        "On 9 December 2014, the 13th Chamber of the Supreme Administrative Court dismissed the applicant’s case."^^xsd:string,
        "judgments delivered by the Supreme Administrative Court"^^xsd:string,
        "the administrative court"^^xsd:string .

