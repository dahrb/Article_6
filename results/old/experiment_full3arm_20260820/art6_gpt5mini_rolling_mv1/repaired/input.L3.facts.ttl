doc:enforcement_non_enforcement_by_sdif_1 a echr:EnforcementAction ;
    rdfs:label "Inaction of the Saving Deposit Insurance Fund to enforce relevant judgments"^^xsd:string ;
    echr:followsProceeding doc:proceeding_annulment_valuation_tender_sale_1 ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_erol_enforcement_2016_03_23,
        doc:participation_sdif_enforcement1 ;
    echr:hasSupportingQuote "In a letter dated 23 March 2016, the applicant communicated with the Fund, requesting the enforcement of the annulment judgment."^^xsd:string,
        "Inaction of the Saving Deposit Insurance Fund, which managed and controlled Viva TV-Radio Viva for debt recovery purposes, to enforce relevant judgments, effectively deprived the applicant of his right of access to a court"^^xsd:string .

doc:enforcement_non_enforcement_by_sdif_cine5_1 a echr:EnforcementAction ;
    rdfs:label "Fund's failure to enforce annulment judgments concerning Cine 5 and related assets"^^xsd:string ;
    echr:followsProceeding doc:proceeding_supadm_2006_07_20 ;
    echr:hasCourt doc:savingDepositInsuranceFund ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_erol_enforcement_cine5_1,
        doc:participation_sdif_enforcement_cine5_1 ;
    echr:hasSupportingQuote "The Fund justified its failure to enforce the judgment on the grounds that the economic and commercial unit had already been transferred to the successful bidder, thereby severing any legal connection between the Fund and the asset in question. It argued that enforcing the annulment judgment would violate the purchaser’s acquired rights and undermine legal certainty and public trust, particularly as the purchase amount had been duly paid. The Fund further asserted that implementation of the judgment was both legally and practically impossible."^^xsd:string .

