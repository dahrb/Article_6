    echr:participatingParty doc:savingDepositInsuranceFund .

doc:participation_sdif_offer_sale_2011_01_13 a echr:Participation ;
    rdfs:label "Saving Deposit Insurance Fund participation in offer sale 13 January 2011"^^xsd:string ;
