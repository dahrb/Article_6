doc:proceeding_admin_first_instance_6183_2006 a echr:DomesticProceeding ;
    rdfs:label "Proceeding before the administrative court dismissed for lack of standing (Law no. 6183 enforcement proceedings)"^^xsd:string ;
    echr:hasCourt doc:supremeAdministrativeCourt ;
    echr:hasParticipation doc:participation_erol_admin_6183_first_instance_2006,
        doc:participation_sdif_admin_6183_first_instance_2006 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "the decision of the first-instance administrative court, which had dismissed the case on the grounds of his lack of standing."^^xsd:string .

doc:proceeding_supadm_2006_07_20 a echr:DomesticProceeding ;
    rdfs:label "Proceeding before the Supreme Administrative Court (20 July 2006)"^^xsd:string ;
    echr:followsProceeding doc:proceeding_admin_first_instance_6183_2006 ;
    echr:hasCourt doc:supremeAdministrativeCourt ;
    echr:hasDecisionDate "2006-07-20"^^xsd:date ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasParticipation doc:participation_erol_supadm_2006_07_20,
        doc:participation_sdif_supadm_2006_07_20 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "On 20 July 2006, the Supreme Administrative Court, ruling unanimously, found that the applicant had a legal interest in the enforcement proceedings initiated under Law no. 6183, as he was the majority shareholder of İktisat Bank, which had been transferred to the Fund. The court held that the applicant had standing to challenge the transaction and quashed the administrative court’s earlier decision."^^xsd:string .

doc:proceeding_supadm_ch13_2014_12_09 a echr:DomesticProceeding ;
    rdfs:label "Proceeding before the 13th Chamber of the Supreme Administrative Court (9 December 2014)"^^xsd:string ;
    echr:hasCourt doc:supremeAdministrativeCourt ;
    echr:hasDecisionDate "2014-12-09"^^xsd:date ;
    echr:hasParticipation doc:participation_erol_supadm_ch13_2014_12_09,
        doc:participation_sdif_supadm_ch13_2014_12_09 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSupportingQuote "In the dissenting opinion, the judge observed that an appraisal report prepared by experts on 30 June 2009 had valued the entity at USD 5,914,000. The judge noted that, although approximately eighteen months had passed since the report, the Fund had set the estimated value at USD 6,000,000 without obtaining an updated valuation to reflect the prevailing economic conditions. The judge considered this to be unlawful and concluded that the decision should have been annulled."^^xsd:string,
        "On 9 December 2014, the 13th Chamber of the Supreme Administrative Court dismissed the applicant’s case. The judgment was delivered by a majority, with one judge dissenting."^^xsd:string .

