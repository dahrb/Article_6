@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/b088c9405032> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:9"^^xsd:string .

doc:case_1 a echr:CaseDocument ;
    rdfs:label "Malkhaz BADUASHVILI against Georgia"^^xsd:string ;
    echr:hasApplicant doc:partyBaduashvili ;
    echr:hasApplicationNumber "18720/08"^^xsd:string ;
    echr:hasDomesticProceeding doc:proceedingFirstInstance ;
    echr:hasRespondentState "Georgia"^^xsd:string .

doc:proceedingSupreme a echr:DomesticProceeding ;
    rdfs:label "Supreme Court appeal"^^xsd:string ;
    echr:followsProceeding doc:proceedingAppeal ;
    echr:hasCourt doc:courtSupreme ;
    echr:hasDecisionDate "2008-02-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_baduashvili_2 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 20 February 2008 the Supreme Court declared an appeal on points of law lodged by the applicant inadmissible."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:prosecutorial_review_1 a echr:ProsecutorialReview ;
    rdfs:label "Appeal to regional prosecutor"^^xsd:string ;
    echr:hasCourt doc:authInvestigator ;
    echr:hasDecisionDate "2005-11-03"^^xsd:date ;
    echr:hasParticipation doc:part_mt_1 ;
    echr:hasSupportingQuote "On 3 November 2005 M.T. appealed to the regional prosecutor’s office against the investigator’s refusal to question him again."^^xsd:string .

doc:authInvestigator a echr:DomesticAuthority ;
    rdfs:label "Investigating Authorities"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "investigating authorities"^^xsd:string ;
    echr:hasJurisdictionState "Georgia"^^xsd:string .

doc:courtAppeal a echr:DomesticAuthority ;
    rdfs:label "Tbilisi Court of Appeal"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Tbilisi Court of Appeal"^^xsd:string ;
    echr:hasJurisdictionState "Georgia"^^xsd:string .

doc:courtFirstInstance a echr:DomesticAuthority ;
    rdfs:label "Court of First Instance"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "court of first instance"^^xsd:string ;
    echr:hasJurisdictionState "Georgia"^^xsd:string .

doc:courtSupreme a echr:DomesticAuthority ;
    rdfs:label "Supreme Court of Georgia"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Supreme Court"^^xsd:string ;
    echr:hasJurisdictionState "Georgia"^^xsd:string .

doc:detention_1 a echr:PreTrialDetention ;
    rdfs:label "Pre-trial detention of Malkhaz Baduashvili"^^xsd:string ;
    echr:hasCustodialMeasure echr:MeasureRemandInCustody ;
    echr:hasDetainee doc:partyBaduashvili ;
    echr:hasDetentionStartDate "2005-07-27"^^xsd:date ;
    echr:hasSupportingQuote "He was arrested and remanded in custody on 27 July 2005."^^xsd:string .

doc:lawyerAbuladze a echr:LegalRepresentative ;
    rdfs:label "Ms S. Abuladze"^^xsd:string ;
    echr:hasPersonName "Ms S. Abuladze"^^xsd:string .

doc:part_baduashvili_1 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:partyBaduashvili .

doc:part_mt_1 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:partyMt .

doc:part_prosecutor_1 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:partyProsecutor .

doc:partyMt a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "M.T."^^xsd:string ;
    echr:hasPersonName "M.T."^^xsd:string .

doc:partyProsecutor a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "The Prosecutor"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial .

doc:proceedingAppeal a echr:DomesticProceeding ;
    rdfs:label "Tbilisi Court of Appeal proceeding"^^xsd:string ;
    echr:followsProceeding doc:proceedingFirstInstance ;
    echr:hasCourt doc:courtAppeal ;
    echr:hasDecisionDate "2007-06-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_baduashvili_2 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 27 June 2007 the Tbilisi Court of Appeal upheld the applicant’s conviction."^^xsd:string .

doc:part_baduashvili_2 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:partyBaduashvili .

doc:proceedingFirstInstance a echr:DomesticProceeding ;
    rdfs:label "First instance trial"^^xsd:string ;
    echr:hasCourt doc:courtFirstInstance ;
    echr:hasDecisionDate "2006-12-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:part_baduashvili_1,
        doc:part_prosecutor_1 ;
    echr:hasPreTrialDetention doc:detention_1 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSupportingQuote "On 8 December 2006 the court of first instance convicted the applicant of aggravated murder"^^xsd:string .

doc:partyBaduashvili a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Malkhaz Baduashvili"^^xsd:string ;
    echr:hasPersonName "Malkhaz Baduashvili"^^xsd:string ;
    echr:isRepresentedBy doc:lawyerAbuladze .

