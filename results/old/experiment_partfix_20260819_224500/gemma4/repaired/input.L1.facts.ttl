    echr:hasAuthorityName "Veliko Tarnovo Court of Appeal ( Апелативен съд )"^^xsd:string ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

doc:participation_stanev_2 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:stanev .

doc:stanev a echr:NaturalPerson,
