@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/c21c17639fd6/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/c21c17639fd6> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:1"^^xsd:string .

doc:admin_appointment_guardian_1 a echr:AdministrativeAction ;
    rdfs:label "appointment of guardian Ms R.P."^^xsd:string ;
    echr:followsProceeding doc:proceedingIncapacityAppeal ;
    echr:hasCourt doc:ruseMunicipalCouncil ;
    echr:hasDecisionDate "2002-05-23"^^xsd:date ;
    echr:hasParticipation doc:participation_rp_1 ;
    echr:hasSupportingQuote "on 23 May 2002 the Municipal Council appointed Ms R.P., a council officer, as the applicant’s guardian"^^xsd:string .

doc:caseStanev a echr:CaseDocument ;
    echr:hasApplicant doc:stanev ;
    echr:hasApplicationNumber "36760/06"^^xsd:string ;
    echr:hasCaseName "CASE OF STANEV v. BULGARIA"^^xsd:string ;
    echr:hasRespondentState "Republic of Bulgaria"^^xsd:string .

doc:enforcementPlacementPastra a echr:EnforcementAction ;
    rdfs:label "placement in Pastra social care home"^^xsd:string ;
    echr:followsProceeding doc:adminPlacementRequest ;
    echr:hasDecisionDate "2002-12-10"^^xsd:date ;
    echr:hasSupportingQuote "On 10 December 2002 a welfare-placement agreement was signed... the applicant was taken by ambulance to the Pastra social care home"^^xsd:string .

doc:proceedingJudicialReviewMayor a echr:DomesticProceeding ;
    rdfs:label "judicial review of mayor's decision"^^xsd:string ;
    echr:followsProceeding doc:adminReleaseRequest ;
    echr:hasCourt doc:dupnitsaDistrictCourt ;
    echr:hasDecisionDate "2006-03-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_stanev_2 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSupportingQuote "The Dupnitsa District Court gave judgment on 10 March 2006... the court dismissed the application"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:review_capacity_restoration_3 a echr:ProsecutorialReview ;
    rdfs:label "Chief Prosecutor review"^^xsd:string ;
    echr:followsProceeding doc:review_capacity_restoration_2 ;
    echr:hasCourt doc:chiefProsecutorCassation ;
    echr:hasDecisionDate "2005-11-29"^^xsd:date ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "subsequently on 29 November 2005 by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation"^^xsd:string .

doc:adminPlacementRequest a echr:AdministrativeAction ;
    rdfs:label "request for placement in social care home"^^xsd:string ;
    echr:hasCourt doc:ruseSocialServices ;
    echr:hasDecisionDate "2002-07-23"^^xsd:date ;
    echr:hasSupportingQuote "Social services drew up a welfare report on the applicant, noting on 23 July 2002... The requirements for placement in a social care home were therefore deemed to be fulfilled"^^xsd:string .

doc:adminReleaseRequest a echr:AdministrativeAction ;
    rdfs:label "request for release from partial guardianship to Mayor"^^xsd:string ;
    echr:hasCourt doc:mayorRila ;
    echr:hasDecisionDate "2005-09-16"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasSupportingQuote "In a letter of 16 September 2005, the mayor of Rila refused his request"^^xsd:string .

doc:appellateProsecutor a echr:DomesticAuthority ;
    rdfs:label "appellate prosecutor"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "appellate prosecutor"^^xsd:string ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

doc:chiefProsecutorCassation a echr:DomesticAuthority ;
    rdfs:label "Chief Public Prosecutor’s Office at the Supreme Court of Cassation"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Chief Public Prosecutor’s Office at the Supreme Court of Cassation"^^xsd:string ;
    echr:hasJurisdictionState "Bulgaria"^^xsd:string .

