@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/7d6ad4a2d44a/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/7d6ad4a2d44a> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:3"^^xsd:string .

doc:liquidationProtocol a schema:Agreement ;
    rdfs:label "Liquidation Protocol"^^xsd:string ;
    echr:hasSourceParagraph "9"^^xsd:string ;
    echr:hasSupportingQuote "a debt liquidation protocol ( Borç Tasfiye Protokolü , hereinafter referred to as “the Liquidation Protocol”) was signed between the Fund (as creditor) and the Erol Aksoy Group (as debtor)"^^xsd:string .

doc:proceeding_4 a echr:DomesticProceeding ;
    rdfs:label "request for rectification"^^xsd:string ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:supAdminCourt ;
    echr:hasDecisionDate "2016-01-25"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelUnknown ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "30"^^xsd:string ;
    echr:hasSupportingQuote "On 25 January 2016, the Supreme Administrative Court rejected the Fund’s request for rectification"^^xsd:string .

doc:proceeding_rectification_1 a echr:DomesticProceeding ;
    rdfs:label "request for rectification"^^xsd:string ;
    echr:followsProceeding doc:proceeding_appeal_1 ;
    echr:hasCourt doc:supAdminCourt ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasParticipation doc:participation_3 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "37"^^xsd:string ;
    echr:hasSupportingQuote "On 30 June 2017, the 13th Chamber of the Supreme Administrative Court granted the request"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:constCourt a echr:DomesticAuthority ;
    rdfs:label "Constitutional Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial .

doc:erolAksoy a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Erol Aksoy"^^xsd:string,
        "Erol Aksoy Group"^^xsd:string ;
    echr:hasGender echr:GenderMale ;
    echr:hasHonorific "Mr"^^xsd:string .

doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "first-instance administrative court case"^^xsd:string,
        "legal proceedings against natural and legal person debtors within the Erol Aksoy Group"^^xsd:string,
        "proceedings before the administrative court"^^xsd:string ;
    echr:hasCourt doc:fund_1,
        doc:supAdminCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance,
        echr:LevelUnknown ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasProceedingStartDate "2011-02-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative,
        echr:TypeUnknown ;
    echr:hasSourceParagraph "13"^^xsd:string,
        "27"^^xsd:string,
        "46"^^xsd:string ;
    echr:hasSupportingQuote "On 7 February 2011, the applicant initiated proceedings before the administrative court"^^xsd:string,
        "the Fund decided to rely on its provisions concerning default. It resolved to initiate legal proceedings against all natural and legal person debtors within the Erol Aksoy Group"^^xsd:string,
        "the decision of the first-instance administrative court, which had dismissed the case on the grounds of his lack of standing"^^xsd:string .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "appeal to Supreme Administrative Court"^^xsd:string,
        "case before the 13th Chamber of the Supreme Administrative Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:supAdminCourt ;
    echr:hasDecisionDate "2006-07-20"^^xsd:date,
        "2014-12-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeClaimDismissed,
        echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant,
        echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_2 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "28"^^xsd:string,
        "47"^^xsd:string ;
    echr:hasSupportingQuote "On 20 July 2006, the Supreme Administrative Court... quashed the administrative court’s earlier decision"^^xsd:string,
        "On 9 December 2014, the 13th Chamber of the Supreme Administrative Court dismissed the applicant’s case"^^xsd:string .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "appeal before the General Assembly"^^xsd:string,
        "individual application to Constitutional Court (Viva TV-Radio Viva)"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:constCourt,
        doc:supAdminCourt ;
    echr:hasDecisionDate "2015-07-07"^^xsd:date,
        "2018-05-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal,
        echr:LevelConstitutional ;
    echr:hasOutcome echr:OutcomeClaimGranted,
        echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant,
        echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_3 ;
    echr:hasProceedingStartDate "2017-09-11"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative,
        echr:TypeConstitutional ;
    echr:hasSourceParagraph "29"^^xsd:string,
        "41, 42"^^xsd:string ;
    echr:hasSupportingQuote "On 11 September 2017, the applicant lodged an individual application with the Constitutional Court... the Constitutional Court declared the application inadmissible"^^xsd:string,
        "On 7 July 2015, following an appeal by the applicant, the General Assembly... annulled the Fund’s decision"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:proceeding_annulment_1 a echr:DomesticProceeding ;
    rdfs:label "proceedings seeking the annulment of the sale of Viva TV-Radio Viva"^^xsd:string ;
    echr:hasCourt doc:supAdminCourt ;
    echr:hasDecisionDate "2014-03-19"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasProceedingStartDate "2011-02-24"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "33"^^xsd:string ;
    echr:hasSupportingQuote "On 24 February 2011, the applicant initiated proceedings before the administrative court, seeking the annulment of the sale of Viva TV-Radio Viva."^^xsd:string .

doc:proceeding_appeal_1 a echr:DomesticProceeding ;
    rdfs:label "appeal against the dismissal of the annulment claim"^^xsd:string ;
    echr:followsProceeding doc:proceeding_annulment_1 ;
    echr:hasCourt doc:supAdminCourt ;
    echr:hasDecisionDate "2014-12-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_2 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "35"^^xsd:string ;
    echr:hasSupportingQuote "On an appeal by the applicant, the 13th Chamber of the Supreme Administrative Court upheld that decision on 9 December 2014."^^xsd:string .

doc:fund_1 a echr:DomesticAuthority,
        echr:Party ;
    rdfs:label "the Fund"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasName "the Fund"^^xsd:string .

doc:participation_1 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating,
        echr:SideResponding ;
    echr:hasSourceParagraph "13"^^xsd:string,
        "46"^^xsd:string ;
    echr:hasSupportingQuote "dismissed the case on the grounds of his lack of standing"^^xsd:string,
        "the Fund decided to rely on its provisions concerning default. It resolved to initiate legal proceedings"^^xsd:string ;
    echr:participatingParty doc:applicant_1,
        doc:fund_1 .

doc:participation_2 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating,
        echr:SideResponding ;
    echr:hasSourceParagraph "13"^^xsd:string,
        "46"^^xsd:string ;
    echr:hasSupportingQuote "The applicant appealed against the decision"^^xsd:string,
        "initiate legal proceedings against all natural and legal person debtors within the Erol Aksoy Group"^^xsd:string ;
    echr:participatingParty doc:applicant_1,
        doc:erolAksoy .

doc:participation_3 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSourceParagraph "41"^^xsd:string ;
    echr:hasSupportingQuote "the applicant lodged an individual application"^^xsd:string ;
    echr:participatingParty doc:applicant_1 .

doc:applicant_1 a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "the applicant"^^xsd:string ;
    echr:hasPersonName "the applicant"^^xsd:string ;
    echr:isAnonymised true .

doc:supAdminCourt a echr:DomesticAuthority ;
    rdfs:label "13th Chamber of the Supreme Administrative Court"^^xsd:string,
        "6th Chamber of the İstanbul Administrative Court"^^xsd:string,
        "General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court"^^xsd:string,
        "Supreme Administrative Court"^^xsd:string,
        "administrative court"^^xsd:string,
        "first-instance administrative court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasName "General Assembly of the Administrative Proceedings Divisions of the Supreme Administrative Court"^^xsd:string,
        "Supreme Administrative Court"^^xsd:string,
        "administrative court"^^xsd:string .

