    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "15"^^xsd:string,
        "23"^^xsd:string ;
    echr:hasSupportingQuote "An administrative appeal on points of law lodged by the applicants against that judgment was dismissed by the Conseil d’État on 17 May 2018"^^xsd:string,
        "On 7 October 2016 the Aliens Appeals Board... ordered a stay of execution of the refusals"^^xsd:string .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "Decision to lift stay of execution on 6 March 2017"^^xsd:string,
