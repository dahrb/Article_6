doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Visa application decision of 13 September 2016"^^xsd:string,
        "proceedings before the Aliens Appeals Board to have the Aliens Office’s decisions of 10 October 2016 set aside"^^xsd:string ;
    echr:hasCourt doc:aliensOffice ;
    echr:hasDecisionDate "2016-09-13"^^xsd:date,
        "2017-03-24"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "11"^^xsd:string,
        "22"^^xsd:string ;
    echr:hasSupportingQuote "On 13 September 2016 the Aliens Office... refused to grant “humanitarian visas”"^^xsd:string,
        "On 24 March 2017 the Aliens Appeals Board dismissed the application to have those decisions set aside"^^xsd:string .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Application for stay of execution regarding 13 September decisions"^^xsd:string,
