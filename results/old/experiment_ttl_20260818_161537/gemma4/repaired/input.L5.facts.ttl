    echr:hasSourceParagraph "50"^^xsd:string ;
    echr:hasSupportingQuote "applicant instituted proceedings against the decisions of the Bar bodies at the Podilskyy District Court"^^xsd:string .

doc:barBody a echr:DomesticAuthority ;
