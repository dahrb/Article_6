doc:proceeding_kyiv_1 rdfs:label "proceedings before the Kyiv District Administrative Court"^^xsd:string ;
    echr:followsProceeding doc:proceeding_bar_1 ;
    echr:hasCourt doc:podilskyyDistCourt ;
