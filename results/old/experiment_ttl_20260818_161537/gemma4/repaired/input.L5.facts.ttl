    echr:hasSourceParagraph "23"^^xsd:string ;
    echr:hasSupportingQuote "the Podilskyy District Court decided not to examine the applicant’s appeal"^^xsd:string .

doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "disciplinary proceeding before QDC of Zakarpattya"^^xsd:string ;
    echr:hasCourt doc:qdcZakarpattya ;
    echr:hasDecisionDate "2013-04-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasProceedingType echr:TypeDisciplinary ;
    echr:hasSourceParagraph "33"^^xsd:string,
        "9"^^xsd:string ;
    echr:hasSupportingQuote "On 17 April 2013, in the applicant’s absence, the Disciplinary Chamber of the QDC of Zakarpattya suspended the applicant’s licence to practise as an advocate for six months"^^xsd:string,
        "decisions of 17 April and 16 May 2013"^^xsd:string .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "review of the decision of 17 April 2013 by QDC of Zakarpattya"^^xsd:string,
        "review proceeding before HQDCB"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:qdcZakarpattya ;
    echr:hasDecisionDate "2013-05-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_2 ;
    echr:hasProceedingType echr:TypeDisciplinary ;
    echr:hasSourceParagraph "11"^^xsd:string,
        "33"^^xsd:string ;
    echr:hasSupportingQuote "On 16 May the QDC of Zakarpattya upheld the decision of 17 April 2013."^^xsd:string,
        "decisions of 17 April and 16 May 2013"^^xsd:string .

doc:proceeding_bar_1 a echr:DomesticProceeding ;
