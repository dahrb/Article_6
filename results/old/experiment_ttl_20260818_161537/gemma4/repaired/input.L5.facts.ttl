<https://growgraph.dev/doc/461955468b28> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:5"^^xsd:string .

doc:issue_length_1 a echr:Article6Issue ;
    rdfs:label "excessive length of proceedings"^^xsd:string ;
    echr:hasDelayAttribution echr:DelayAttributedToAuthorities ;
    echr:hasSourceParagraph "54"^^xsd:string ;
    echr:hasSupportingQuote "the length of the proceedings was excessive and failed to meet the ‘reasonable time’ requirement"^^xsd:string ;
    echr:issueArisesIn doc:proceeding_kyiv_1 .

