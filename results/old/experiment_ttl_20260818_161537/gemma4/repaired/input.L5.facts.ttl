    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicant .

doc:proceedingKyivAppeal a echr:DomesticProceeding ;
    rdfs:label "appeal before Kyiv Administrative Court of Appeal"^^xsd:string ;
    echr:followsProceeding doc:proceedingPodilskyyDist ;
    echr:hasCourt doc:podilskyyDistCourt ;
    echr:hasDecisionDate "2017-03-06"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "25"^^xsd:string ;
    echr:hasSupportingQuote "the Kyiv Administrative Court of Appeal quashed the decision of 22 December 2016"^^xsd:string .

doc:proceedingSupremeCourt a echr:DomesticProceeding ;
    rdfs:label "Supreme Court appeal"^^xsd:string ;
    echr:followsProceeding doc:proceeding_kyiv_dist_admin_1 ;
    echr:hasCourt doc:supremeCourt ;
    echr:hasDecisionDate "2021-12-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "31"^^xsd:string ;
    echr:hasSupportingQuote "final decision of the Supreme Court of 9 December 2021"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "appeal to HQDCB"^^xsd:string ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:hqdcb ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasParticipation doc:participation_2 ;
    echr:hasProceedingType echr:TypeDisciplinary ;
    echr:hasSourceParagraph "12"^^xsd:string ;
    echr:hasSupportingQuote "The applicant appealed against the decisions of 17 April and 16 May 2013 to the HQDCB"^^xsd:string .

