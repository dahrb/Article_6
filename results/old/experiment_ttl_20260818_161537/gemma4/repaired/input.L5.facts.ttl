    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "49"^^xsd:string ;
    echr:hasSupportingQuote "the applicant instituted proceedings before the Kyiv District Administrative Court on 5 October 2016. The final decision in the case was delivered on 9 December 2021"^^xsd:string .

doc:proceeding_kyiv_dist_admin_1 a echr:DomesticProceeding ;
    rdfs:label "appeal before Kyiv District Administrative Court"^^xsd:string ;
    echr:followsProceeding doc:proceedingHqdcbAppeal ;
