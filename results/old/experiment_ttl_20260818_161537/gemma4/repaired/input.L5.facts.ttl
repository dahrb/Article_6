doc:inactivity_kyiv_1 a echr:InactivityPeriod ;
    echr:hasInactivityCause echr:DelayUnattributed ;
    echr:hasInactivityEndDate "2018-05-01"^^xsd:date ;
    echr:hasInactivityStartDate "2017-03-06"^^xsd:date ;
    echr:hasSourceParagraph "50"^^xsd:string ;
    echr:hasSupportingQuote "delay in the resumption of the proceedings between March 2017 and May 2018 was attributable to the applicant or to the Government"^^xsd:string .

doc:participation_1 a echr:Participation ;
    rdfs:label "Applicant's participation in first instance"^^xsd:string ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:applicant,
