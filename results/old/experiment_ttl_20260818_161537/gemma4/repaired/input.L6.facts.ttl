@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/8f3cf0c0b942/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/8f3cf0c0b942> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:6"^^xsd:string .

doc:arbitration_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "arbitration proceedings"^^xsd:string ;
    echr:hasCourt doc:arbitrationTribunalAuth ;
    echr:hasDecisionDate "2008-10-07"^^xsd:date ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeOther ;
    echr:hasSourceParagraph "26"^^xsd:string ;
    echr:hasSupportingQuote "the President of the Arbitration Tribunal informed the applicant company that its request to start arbitration proceedings would not be granted"^^xsd:string .

doc:cassation_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "appeal on points of law to the Court of Cassation"^^xsd:string ;
    echr:followsProceeding doc:appeal_proceeding_1 ;
    echr:hasCourt doc:courtOfCassationAuth ;
    echr:hasDecisionDate "2009-09-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2009-08-04"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "38"^^xsd:string ;
    echr:hasSupportingQuote "the Court of Cassation declared the applicant company’s appeal on points of law inadmissible"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "complaint against the decision to leave claim unexamined"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:commercial_court_1 ;
    echr:hasDecisionDate "2007-12-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "21"^^xsd:string ;
    echr:hasSupportingQuote "a three-judge bench of the Commercial Court rejected the complaint submitted by the applicant company"^^xsd:string .

doc:proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "claim before the Arbitration Tribunal"^^xsd:string ;
    echr:hasCourt doc:arbitrationTribunalAuth ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingStartDate "2008-09-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "25"^^xsd:string ;
    echr:hasSupportingQuote "the applicant company lodged a claim with the Arbitration Tribunal"^^xsd:string ;
    echr:isPending true .

doc:appeal_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "appeal to the Civil Court of Appeal"^^xsd:string ;
    echr:followsProceeding doc:district_court_proceeding_1 ;
    echr:hasCourt doc:yerevanCivilCourtAuth ;
    echr:hasDecisionDate "2009-07-21"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2009-06-25"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "36"^^xsd:string ;
    echr:hasSupportingQuote "the Civil Court of Appeal upheld the decision of 16 June 2009"^^xsd:string .

doc:applicantCompany a echr:Party ;
    rdfs:label "applicant company"^^xsd:string,
        "the applicant company"^^xsd:string .

doc:courtOfCassationAuth a echr:DomesticAuthority ;
    rdfs:label "Court of Cassation"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial .

doc:districtCourtAuth a echr:DomesticAuthority ;
    rdfs:label "Kentron and Nork-Marash District Court of Yerevan"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial .

doc:district_court_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "proceeding before the Kentron and Nork-Marash District Court"^^xsd:string ;
    echr:followsProceeding doc:yerevan_civil_proceeding_1 ;
    echr:hasCourt doc:districtCourtAuth ;
    echr:hasDecisionDate "2009-06-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingStartDate "2009-03-13"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "33"^^xsd:string ;
    echr:hasSupportingQuote "the District Court decided to leave the claim lodged by the applicant company unexamined"^^xsd:string .

doc:llc a echr:Party ;
    rdfs:label "the LLC"^^xsd:string .

doc:llcCompany a echr:Party ;
    rdfs:label "LLC"^^xsd:string .

doc:proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "first instance claim and counterclaim"^^xsd:string ;
    echr:hasCourt doc:commercial_court_1 ;
    echr:hasDecisionDate "2007-11-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "19"^^xsd:string ;
    echr:hasSupportingQuote "the Commercial Court granted the request and decided to leave the applicant company’s claim and the counterclaim lodged by the LLC unexamined"^^xsd:string .

doc:yerevan_civil_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "claim with the Yerevan Civil Court"^^xsd:string ;
    echr:hasCourt doc:yerevanCivilCourtAuth ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingStartDate "2008-10-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "27"^^xsd:string ;
    echr:hasSupportingQuote "the applicant company lodged a claim with the Yerevan Civil Court"^^xsd:string .

doc:arbitrationTribunalAuth a echr:DomesticAuthority ;
    rdfs:label "Arbitration Tribunal of the Chamber of Commerce and Industry of Armenia"^^xsd:string,
        "President of the Arbitration Tribunal of the Chamber of Commerce and Industry of Armenia"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial .

doc:commercial_court_1 a echr:DomesticAuthority ;
    rdfs:label "Commercial Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial .

doc:yerevanCivilCourtAuth a echr:DomesticAuthority ;
    rdfs:label "Civil Court of Appeal"^^xsd:string,
        "Yerevan Civil Court"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial .

doc:participation_2 a echr:Participation ;
    echr:hasPartySide echr:SideResponding ;
    echr:participatingParty doc:llc,
        doc:llcCompany .

doc:participation_1 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:participatingParty doc:applicantCompany .

