doc:custodial_measure_1 a echr:CustodialMeasure ;
    rdfs:label "provisional detention"@en .

doc:domestic_authority_police_station_1 a echr:DomesticAuthority ;
    rdfs:label "Slovenj Gradec Police Station"@en ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Slovenj Gradec Police Station"@en .

doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "police procedure and transport to the police station"@en,
        "proceedings instituted against the applicant"@en ;
    echr:followsProceeding doc:domestic_proceeding_2 ;
    echr:hasCourt doc:domestic_authority_police_station_1 ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasPreTrialDetention doc:pre_trial_detention_1 ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "12"^^xsd:string,
        "21"^^xsd:string ;
    echr:hasSupportingQuote "The judgment of 12 February 2001 issued in the proceedings instituted against the applicant"^^xsd:string,
        "On 5 April 1995 at about 8.30 p.m. the applicant, driving a car, was arrested in Slovenj Gradec by officers of the Special Unit and the Slovenj Gradec Police. He was brought to the Slovenj Gradec Police Station for having allegedly failed to comply with the police orders. He was questioned by the police and released on 6 April 1995 at approximately half past midnight."@en .

doc:domestic_proceeding_criminal_complaint_1995 a echr:DomesticProceeding ;
    rdfs:label "the applicant’s criminal complaint and the subsequent investigation"@en ;
    echr:hasDecisionDate "1997-01-17"^^xsd:date ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "1995-04-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "28-35"^^xsd:string ;
    echr:hasSupportingQuote "On 15 May 1995 the applicant lodged, through his lawyer, a written criminal complaint ( kazenska ovadba ) with the Slovenj Gradec Police against unidentified police officers for causing minor bodily harm ( lahka telesna poškodba ) and an unlawful deprivation of liberty ( protipraven odvzem prostosti )."@en,
        "On 17 January 1997 the Public Prosecutor issued a decision dismissing the applicant’s criminal complaint. It was served on the applicant’s lawyer on 22 January 1997."@en,
        "On 7 April 1995 the applicant went to the Slovenj Gradec Police and made an oral complaint against the officers of the Special Unit concerning the events of 5 April 1995. A written statement was prepared by the officer in charge and signed by the applicant."@en .

doc:participation_1 a echr:Participation ;
    rdfs:label "Participation of applicant in police arrest and questioning"@en ;
    echr:participatingParty doc:party_applicant_1 .

doc:party_applicant_1 a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Mr Aleksander Matko"@en ;
    echr:hasPartyName "the applicant"@en .

doc:pre_trial_detention_1 a echr:PreTrialDetention ;
    rdfs:label "room for provisional detention (prostor za pridržanje)"@en ;
    echr:hasCustodialMeasure doc:custodial_measure_1 ;
    echr:hasSourceParagraph "14"^^xsd:string ;
    echr:hasSupportingQuote "At the police station, he was put in the room for provisional detention ( prostor za pridržanje ) where one of the officers untied him at his request."@en .

doc:domestic_proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "criminal investigation instituted against the applicant"@en,
        "police procedure and transport to the police station (applicant's version)"@en ;
    echr:followsProceeding doc:domestic_proceeding_1 ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "14"^^xsd:string,
        "22"^^xsd:string ;
    echr:hasSupportingQuote "Officer J.K. testified in the criminal investigation instituted against the applicant"^^xsd:string,
        "According to his submissions before the Court and the statements he gave in the relevant domestic proceedings, the applicant was driving through the centre of Slovenj Gradec on the evening of 5 April 1995 when at least two cars overtook him and forced him to stop. Approximately fifteen armed officers, wearing black jackets, arrived at the scene, some of whom approached the applicant."@en .

doc:maribor_higher_court_1 a echr:DomesticAuthority ;
    rdfs:label "Maribor Higher Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Maribor Higher Court"@en .

doc:slovenj_gradec_district_court_1 a echr:DomesticAuthority ;
    rdfs:label "Slovenj Gradec District Court"@en,
        "investigating judge in the Slovenj Gradec District Court"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Slovenj Gradec District Court"@en .

