    echr:hasSourceParagraph "50"^^xsd:string ;
    echr:hasSupportingQuote "On 11 October 2001 the Slovenj Gradec District Court ordered the applicant to pay an additional sum"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:domestic_proceeding_3 a echr:DomesticProceeding ;
    rdfs:label "police procedure and transport to the police station (government's version)"@en ;
    echr:followsProceeding doc:domestic_proceeding_2 ;
    echr:hasSourceParagraph "16"^^xsd:string ;
    echr:hasSupportingQuote "According to the version of events given by the Government, the police noticed a car moving at high speed. Since the conduct of the driver looked suspicious, the police decided to stop the car, to identify the driver and to perform a preventative search."@en .

