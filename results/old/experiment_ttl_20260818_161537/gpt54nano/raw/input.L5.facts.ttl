    echr:hasSourceParagraph "6"^^xsd:string ;
    echr:hasSupportingQuote "On 24 January 2013 the head of the HQDCB transferred D.’s complaint to the Qualification and Disciplinary Commission of the Regional Bar of Zakarpattya (\"the QDC of Zakarpattya\")."@en ;
    echr:isProceedingInCase doc:case_document_strasbourg_judgment_1 .

doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    rdfs:label "Disciplinary Chamber of the QDC of Zakarpattya suspended the applicant’s licence to practise as an advocate for six months"@en,
        "QDC of zakarpattya"@en ;
    echr:followsProceeding doc:domestic_proceeding_0 ;
    echr:hasCourt doc:qdcZakarpattya ;
    echr:hasDecisionDate "2013-04-17"^^xsd:date ;
    echr:hasOutcome doc:outcome_measure_imposed_1 ;
    echr:hasPreTrialDetention doc:pretrial_detention_unknown_1 ;
    echr:hasProceedingStartDate "2012-12-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeDisciplinary ;
    echr:hasSourceParagraph "32"^^xsd:string,
        "9"^^xsd:string ;
    echr:hasSupportingQuote "The courts established that the QDC of Zakarpattya and the HQDCB had examined the applicant’s case in accordance with the procedure prescribed by law"^^xsd:string,
        "On 17 April 2013, in the applicant’s absence, the Disciplinary Chamber of the QDC of Zakarpattya suspended the applicant’s licence to practise as an advocate for six months for his failure to attend the meeting of 7 December 2012 and violating Article 62 of the Rules of Professional Conduct."@en ;
    echr:isProceedingInCase doc:case_document_strasbourg_judgment_1 .

