doc:domestic_proceeding_forensic_medical_exam_conclusion_2010_09_03 a echr:DomesticProceeding ;
    rdfs:label "On 3 September 2010 the forensic medical examination was concluded"@en ;
    echr:hasProceedingStartDate "2010-09-03"^^xsd:date ;
    echr:hasSourceParagraph "43"^^xsd:string ;
    echr:hasSupportingQuote "On 3 September 2010 the forensic medical examination was concluded."^^xsd:string .

doc:first_instance_conviction_1 a echr:DomesticProceeding ;
    rdfs:label "on 8 December 2006"@en ;
    echr:followsProceeding doc:applicant_detained_1 ;
    echr:hasDecisionDate "2006-12-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "22"^^xsd:string ;
    echr:hasSupportingQuote "On 8 December 2006 the court of first instance convicted the applicant of aggravated murder and the illegal acquisition, possession and carrying of firearms, and sentenced him to 17 years’ imprisonment."@en .

doc:pre_trial_statements_application_1 a echr:DomesticProceeding ;
    rdfs:label "an application by the applicant for pre-trial statements"@en ;
    echr:followsProceeding doc:first_instance_conviction_1 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "23"^^xsd:string ;
    echr:hasSupportingQuote "The court dismissed an application by the applicant for pre-trial statements given by M.T. and Z.T. to be declared inadmissible on the grounds that they had been obtained under duress."@en .

doc:trial_phase_at_first_instance_court_1 a echr:DomesticProceeding ;
    rdfs:label "trial at the first-instance court"@en ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
