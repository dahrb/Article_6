doc:guardian_appointment_ruse_2002 a echr:DomesticProceeding ;
    rdfs:label "appointment of a guardian by the Ruse Municipal Council on 23 May 2002"^^xsd:string ;
    echr:followsProceeding doc:appeal_2001_veliko_tarnovo ;
    echr:hasCourt doc:rilaMunicipalCouncil ;
    echr:hasDecisionDate "2002-05-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasProceedingStartDate "2001-06-07"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "11"^^xsd:string,
        "12"^^xsd:string ;
    echr:hasSupportingQuote "Since the applicant’s family members had refused to take on any guardianship responsibilities, on 23 May 2002 the Municipal Council appointed Ms R.P., a council officer, as the applicant’s guardian until 31 December 2002."^^xsd:string,
        "and was subsequently transmitted to the Ruse Municipal Council on 7 June 2001 for the appointment of a guardian."^^xsd:string .

doc:rilaMunicipalCouncil a echr:DomesticAuthority ;
    rdfs:label "Rila Municipal Council"^^xsd:string,
        "Ruse Municipal Council"^^xsd:string .

doc:ruseRegionalProsecutor a echr:DomesticAuthority ;
    rdfs:label "appellate prosecutor"^^xsd:string,
        "regional prosecutor"^^xsd:string,
        "Ruse regional prosecutor"@en ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Ruse regional prosecutor"@en ;
    echr:hasSourceParagraph "10"^^xsd:string ;
    echr:hasSupportingQuote "On an unspecified date in 2000, at the request of the applicant’s two relatives, the Ruse regional prosecutor applied to the Ruse Regional Court ( Окръжен съд ) for a declaration of total legal incapacity in respect of the applicant."@en .

