    rdfs:label "the regional prosecutor’s refusal was upheld on 11 October 2005 by the appellate prosecutor"^^xsd:string ;
    echr:followsProceeding doc:proceeding_prosecutor_refusal_2005 ;
    echr:hasCourt doc:ruseRegionalProsecutor ;
