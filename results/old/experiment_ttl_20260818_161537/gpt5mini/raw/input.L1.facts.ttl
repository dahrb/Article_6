doc:proceeding_mayor_rila_refusal_2005 a echr:DomesticProceeding ;
    rdfs:label "In a letter of 16 September 2005, the mayor of Rila refused his request, stating that there was no basis for such an action in view of the medical certificate of 15 June 2005, the opinions of the Director and the social worker, and the conclusions reached by the public prosecutor’s office."^^xsd:string ;
    echr:hasCourt doc:authority_mayor_of_rila_2005 ;
    echr:hasDecisionDate "2005-09-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "39"^^xsd:string ;
    echr:hasSupportingQuote "In a letter of 16 September 2005, the mayor of Rila refused his request, stating that there was no basis for such an action in view of the medical certificate of 15 June 2005, the opinions of the Director and the social worker, and the conclusions reached by the public prosecutor’s office."^^xsd:string .

doc:proceeding_prosecutor_refusal_2005 a echr:DomesticProceeding ;
    rdfs:label "On 10 August 2005 the regional prosecutor refused to bring an action for restoration of the applicant’s legal capacity on the grounds that, in the opinion of the doctors, the Director of the Pastra social care home and the home’s social worker, the applicant was unable to cope on his own, and that the home, where he could undergo medical treatment, was the most suitable place for him to live."^^xsd:string ;
    echr:hasCourt doc:ruseRegionalProsecutor ;
    echr:hasDecisionDate "2005-08-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "38"^^xsd:string ;
    echr:hasSupportingQuote "On 10 August 2005 the regional prosecutor refused to bring an action for restoration of the applicant’s legal capacity on the grounds that, in the opinion of the doctors, the Director of the Pastra social care home and the home’s social worker, the applicant was unable to cope on his own, and that the home, where he could undergo medical treatment, was the most suitable place for him to live."^^xsd:string .

doc:ruseRegionalCourt a echr:DomesticAuthority ;
    rdfs:label "Ruse Regional Court ( Окръжен съд )"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Ruse Regional Court ( Окръжен съд )"@en .

