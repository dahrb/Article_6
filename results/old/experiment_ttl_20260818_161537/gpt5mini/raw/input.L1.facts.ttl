doc:appointment_rila_2005 a echr:DomesticProceeding ;
    rdfs:label "decision of 2 February 2005 by the Rila Municipal Council to appoint the Director of the Pastra social care home as guardian"^^xsd:string ;
    echr:followsProceeding doc:guardian_appointment_ruse_2002 ;
    echr:hasCourt doc:rilaMunicipalCouncil ;
    echr:hasDecisionDate "2005-02-02"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "17"^^xsd:string ;
    echr:hasSupportingQuote "In a letter dated 16 September 2005, she was informed that the Municipal Council had decided on 2 February 2005 to appoint the Director of the Pastra social care home as the applicant’s guardian."^^xsd:string .

doc:placement_agreement_2002 a echr:DomesticProceeding ;
    rdfs:label "welfare-placement agreement signed on 10 December 2002 between R.P. and the Pastra social care home"^^xsd:string ;
    echr:followsProceeding doc:guardian_appointment_ruse_2002 ;
    echr:hasCourt doc:pastraSocialCareHome ;
    echr:hasDecisionDate "2002-12-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "14"^^xsd:string ;
    echr:hasSupportingQuote "On 10 December 2002 a welfare-placement agreement was signed between R.P. and the social care home for adults with mental disorders near the village of Pastra in the municipality of Rila (\"the Pastra social care home\"), an institution under the responsibility of the Ministry of Labour and Social Policy."^^xsd:string .

doc:proceeding_chief_public_prosecutor_upheld_2005 a echr:DomesticProceeding ;
    rdfs:label "upheld on 29 November 2005 by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation"^^xsd:string ;
    echr:followsProceeding doc:proceeding_appellate_prosecutor_upheld_2005 ;
    echr:hasCourt doc:authority_chief_public_prosecutor_office_2005 ;
    echr:hasDecisionDate "2005-11-29"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "38"^^xsd:string ;
    echr:hasSupportingQuote "Despite those objections, the regional prosecutor’s refusal was upheld on 11 October 2005 by the appellate prosecutor, and subsequently on 29 November 2005 by the Chief Public Prosecutor’s Office at the Supreme Court of Cassation."^^xsd:string .

doc:proceeding_dupnitsa_district_court_2005_2006 a echr:DomesticProceeding ;
    rdfs:label "application to the Dupnitsa District Court for judicial review (filed 28 September 2005); the Dupnitsa District Court gave judgment on 10 March 2006"^^xsd:string ;
    echr:followsProceeding doc:proceeding_mayor_rila_refusal_2005 ;
    echr:hasCourt doc:authorityDupnitsaDistrictCourt ;
    echr:hasDecisionDate "2006-03-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2005-09-28"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "39"^^xsd:string,
        "40"^^xsd:string ;
    echr:hasSupportingQuote "On 28 September 2005 the applicant’s lawyer applied to the Dupnitsa District Court for judicial review of the mayor’s decision, under Article 115 of the Family Code (\"the FC\")."^^xsd:string,
        "The Dupnitsa District Court gave judgment on 10 March 2006. As to the merits, the court dismissed the application, finding that the guardian had no legitimate interest in contesting the mayor’s refusal, given that he could apply independently and directly for the applicant to be released from partial guardianship. Since the judgment was not subject to appeal, it became final."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:ruse_regional_court_judgment_20_november_2000 a echr:DomesticProceeding ;
    rdfs:label "a judgment of 20 November 2000"@en ;
    echr:hasCourt doc:ruseRegionalCourt ;
    echr:hasDecisionDate "2000-11-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "2000"^^xsd:gYear ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "10"^^xsd:string ;
    echr:hasSupportingQuote "In a judgment of 20 November 2000, the court declared the applicant to be partially incapacitated on the grounds that he had been suffering from simple schizophrenia since 1975, and that his ability to manage his own affairs and interests and to realise the consequences of his own acts had been impaired."@en .

doc:appeal_2001_veliko_tarnovo a echr:DomesticProceeding ;
    rdfs:label "judgment of 12 April 2001 by the Veliko Tarnovo Court of Appeal"^^xsd:string ;
    echr:followsProceeding doc:first_instance_judgment_1 ;
    echr:hasCourt doc:velikoTarnovoCourtOfAppeal ;
    echr:hasDecisionDate "2001-04-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasSourceParagraph "11"^^xsd:string ;
    echr:hasSupportingQuote "That judgment was upheld in a judgment of 12 April 2001 by the Veliko Tarnovo Court of Appeal ( Апелативен съд ) on an appeal by the applicant"^^xsd:string .

doc:authorityDupnitsaDistrictCourt a echr:DomesticAuthority ;
