doc:proc_aliens_appeals_7oct2016 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board judgment ordering stay (7 October 2016)"^^xsd:string ;
    echr:followsProceeding doc:proc_aliens_office_13sep2016 ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2016-10-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "15"^^xsd:string ;
    echr:hasSupportingQuote "On 7 October 2016 the Aliens Appeals Board, acting under the extremely urgent procedure, ordered a stay of execution of the refusals by the Aliens Office to grant visas and instructed the Belgian State to take new decisions within 48 hours, giving adequate legal grounds, that is, by giving reasons which took account of the extremely dangerous situation in Syria."^^xsd:string .

