doc:aliens_appeals_board_20oct2016 a echr:DomesticProceeding ;
    rdfs:label "judgment of 20 October 2016 by the Aliens Appeals Board ordering a stay of execution and interim measures"@en ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2016-10-20"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "25"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of 20 October 2016 the Aliens Appeals Board, essentially reiterating the substance of its previous judgments, ordered a stay of execution of the refusal decisions of 17 October 2016. In addition, in view of the imminent danger faced by the applicants, the Belgian State’s persistent refusal to comply with res judicata authority and the importance of ensuring that the remedy was effective, it considered that it was justified to direct the State to issue the applicants, within 48 hours, with laissez-passers or visas, valid for three months."^^xsd:string .

doc:brusselsCourtOfAppealProceeding a echr:DomesticProceeding ;
    rdfs:label "the Brussels Court of Appeal’s judgment of 7 December 2016"@en ;
    echr:followsProceeding doc:aliensAppealsBoardProceeding ;
    echr:hasCourt doc:brusselsCourtOfAppeal ;
    echr:hasDecisionDate "2016-12-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasSourceParagraph "75"^^xsd:string ;
    echr:hasSupportingQuote "the Brussels Court of Appeal’s judgment of 7 December 2016 ordering the Belgian State to execute the Aliens Appeals Board’s judgment of 20 October 2016"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:conseil_detat_17may2018 a echr:DomesticProceeding ;
    rdfs:label "administrative appeal on points of law dismissed by the Conseil d’État on 17 May 2018"@en ;
    echr:followsProceeding doc:aliens_appeals_board_24mar2017 ;
    echr:hasCourt doc:conseilDetat ;
    echr:hasDecisionDate "2018-05-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "23"^^xsd:string ;
    echr:hasSupportingQuote "An administrative appeal on points of law lodged by the applicants against that judgment was dismissed by the Conseil d’État on 17 May 2018."^^xsd:string .

doc:court_of_appeal_30jun2017 a echr:DomesticProceeding ;
    rdfs:label "court of appeal’s judgment of 30 June 2017 countering execution of earlier decisions"@en ;
    echr:followsProceeding doc:brussels_court_of_appeal_7dec2016 ;
    echr:hasCourt doc:brusselsCourtOfAppeal ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "28"^^xsd:string ;
    echr:hasSupportingQuote "For its part, the Belgian State sought to counter the execution of the above-cited decisions; it secured this aim through the court of appeal’s judgment of 30 June 2017."^^xsd:string .

doc:procAppealConseil a echr:DomesticProceeding ;
    rdfs:label "Appeal on points of law to the Conseil d’État"^^xsd:string ;
    echr:followsProceeding doc:procAliensAppeal ;
    echr:hasCourt doc:conseilDetat ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "54"^^xsd:string ;
    echr:hasSupportingQuote "Under section 39/67 of the Aliens Act, an appeal on points of law against the decisions of the Aliens Appeals Board lies to the Conseil d’État."^^xsd:string .

doc:procStayRequest a echr:DomesticProceeding ;
    rdfs:label "Request for stay of execution before the Aliens Appeals Board"^^xsd:string ;
    echr:followsProceeding doc:procAliensOfficeDecision ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasInstanceLevel echr:LevelUnknown ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "53"^^xsd:string ;
    echr:hasSupportingQuote "An action to have a decision by the Aliens Office set aside does not suspend it. For this reason, section 39/82 of the Aliens Act provides for the possibility of submitting a request for a stay of execution either under an “ordinary” procedure or under the “extremely urgent” procedure."^^xsd:string .

doc:procUrgentApplicationCfi a echr:DomesticProceeding ;
    rdfs:label "Urgent or ex parte application to the President of the Court of First Instance"^^xsd:string ;
    echr:hasCourt doc:presidentCfi ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "56"^^xsd:string ;
    echr:hasSupportingQuote "Article 584 of the Judicial Code provides for the possibility of applying to the president of the court of first instance by means of an urgent application or by an ex parte application:"^^xsd:string .

doc:proc_aliens_appeals_14oct2016 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board judgment ordering stay (14 October 2016)"^^xsd:string ;
    echr:followsProceeding doc:proc_aliens_office_10oct2016 ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2016-10-14"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "20"^^xsd:string ;
    echr:hasSupportingQuote "By a judgment of 14 October 2016 the Aliens Appeals Board, acting under the extremely urgent procedure, again ordered a stay of execution of the decision of 10 October 2016 refusing to issue the visas, and instructed the Aliens Office to take new decisions, this time giving adequate legal grounds, within 48 hours."^^xsd:string .

doc:proc_conseil_etat_applicants_8feb2018 a echr:DomesticProceeding ;
    rdfs:label "Conseil d’État judgment dismissing applicants' appeal on points of law (8 February 2018)"^^xsd:string ;
    echr:followsProceeding doc:proc_aliens_appeals_6mar2017 ;
    echr:hasCourt doc:conseilDetat ;
    echr:hasDecisionDate "2018-02-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "17"^^xsd:string ;
    echr:hasSupportingQuote "On 8 February 2018 the Conseil d’État dismissed an appeal on points of law by the applicants against the judgment of 6 March 2017. It held that no departure from the case-law had been made out and dismissed the arguments in which the applicants alleged a breach of the principle of legal certainty and a violation of Articles 3 and 13 of the Convention."^^xsd:string .

doc:proc_conseil_etat_state_8feb2018 a echr:DomesticProceeding ;
    rdfs:label "Conseil d’État judgment dismissing Belgian State's appeal on points of law (8 February 2018)"^^xsd:string ;
    echr:followsProceeding doc:proc_aliens_appeals_7oct2016 ;
    echr:hasCourt doc:conseilDetat ;
    echr:hasDecisionDate "2018-02-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "18"^^xsd:string ;
    echr:hasSupportingQuote "On the same date the Conseil d’État dismissed an appeal on points of law brought by the Belgian State against the judgment of 7 October 2016 on the grounds that, following the lifting of the stay of execution on 6 March 2017, the contested judgment no longer adversely affected the Belgian State."^^xsd:string .

doc:proc_long_stay_visa_dec_2016 a echr:DomesticProceeding ;
    rdfs:label "Belgian authorities decision rejecting long-stay visa (December 2016)"^^xsd:string ;
    echr:hasCourt doc:authorityBelgianAuthorities ;
    echr:hasDecisionDate "2016-12"^^xsd:gYearMonth ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "13"^^xsd:string ;
    echr:hasSupportingQuote "The applicants subsequently submitted such an application, which was rejected by the Belgian authorities in December 2016 (see paragraph 34 below)."^^xsd:string .

doc:aliensAppealsBoardProceeding a echr:DomesticProceeding ;
    rdfs:label "the Aliens Appeals Board’s judgment of 20 October 2016"@en ;
    echr:hasCourt doc:aliensAppealsBoard ;
