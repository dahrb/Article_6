doc:brussels_court_of_appeal_7dec2016 a echr:DomesticProceeding ;
    rdfs:label "Brussels Court of Appeal’s judgment of 7 December 2016 varying the order of 7 November 2016"@en ;
    echr:followsProceeding doc:tpi_inter_partes_7nov2016 ;
    echr:hasCourt doc:brusselsCourtOfAppeal ;
    echr:hasDecisionDate "2016-12-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "32"^^xsd:string ;
    echr:hasSupportingQuote "On an appeal by the applicants, the Brussels Court of Appeal delivered a judgment on 7 December 2016 varying the order of 7 November 2016."^^xsd:string .

doc:domprocAdmincourtAliensRefusal a echr:DomesticProceeding ;
    rdfs:label "administrative courts challenge of the Aliens Office refusal to issue visas"^^xsd:string ;
    echr:followsProceeding doc:domproc_visa_application_2016 ;
    echr:hasCourt doc:authorityAdministrativeCourts ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "8"^^xsd:string ;
    echr:hasSupportingQuote "During the administrative phase, the applicants attempted, firstly, to obtain documents that would enable them to enter and reside legally in Belgium for the period required to make a formal asylum claim; secondly, they brought proceedings before the administrative courts to challenge the refusal by the Aliens Office to issue them with visas."^^xsd:string ;
    echr:isProceedingInCase doc:case_3599_18 .

doc:presidentCfi a echr:DomesticAuthority ;
    rdfs:label "President of the Court of First Instance"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "President of the Court of First Instance"^^xsd:string .

doc:procAliensAppeal a echr:DomesticProceeding ;
    rdfs:label "Appeal to the Aliens Appeals Board"^^xsd:string ;
    echr:followsProceeding doc:procAliensOfficeDecision ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "52"^^xsd:string ;
    echr:hasSupportingQuote "If the Aliens Office refuses to issue a visa, the requesting party may apply to the Aliens Appeals Board to have the Aliens Office’s decision set aside. The Aliens Appeals Board is an administrative court which rules in a collegial formation or as a single judge."^^xsd:string .

doc:proc_aliens_appeals_6mar2017 a echr:DomesticProceeding ;
    rdfs:label "Aliens Appeals Board judgment lifting stay (6 March 2017)"^^xsd:string ;
    echr:followsProceeding doc:proc_aliens_appeals_7oct2016 ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2017-03-06"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "16"^^xsd:string ;
    echr:hasSupportingQuote "On 6 March 2017 the Aliens Appeals Board noted that no application had been brought to have the decisions of 13 September 2016 refusing to issue the visas set aside, and decided in consequence to lift the stay of execution of the visa refusal decisions and the interim measures. It further noted that, since the refusal decisions had not been set aside, they were still operative."^^xsd:string .

doc:proc_aliens_office_10oct2016 a echr:DomesticProceeding ;
    rdfs:label "Aliens Office new decisions refusing visas (10 October 2016)"^^xsd:string ;
    echr:followsProceeding doc:proc_aliens_appeals_7oct2016 ;
    echr:hasCourt doc:aliensOffice ;
    echr:hasDecisionDate "2016-10-10"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "19"^^xsd:string ;
    echr:hasSupportingQuote "As required by the order of the Aliens Appeals Board (see paragraph 15 above), the Aliens Office issued new decisions, dated 10 October 2016, refusing to grant the visas; however, it provided the same reasons as in the previous refusals."^^xsd:string .

doc:proc_aliens_office_13sep2016 a echr:DomesticProceeding ;
    rdfs:label "Aliens Office decision refusing humanitarian visas (13 September 2016)"^^xsd:string ;
    echr:hasCourt doc:aliensOffice ;
    echr:hasDecisionDate "2016-09-13"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "11"^^xsd:string ;
    echr:hasSupportingQuote "On 13 September 2016 the Aliens Office, the administrative body responsible for issuing visas (see paragraph 45 below), refused to grant “humanitarian visas” to the applicants and informed them of its decisions by an email of 29 September 2016, transmitted through the visa department of the Belgian embassy in Beirut."^^xsd:string .

doc:tpi_inter_partes_7nov2016 a echr:DomesticProceeding ;
    rdfs:label "inter partes action before the French-language TPI (decision of 7 November 2016)"@en ;
    echr:followsProceeding doc:tpi_unilateral_25oct2016 ;
    echr:hasCourt doc:brusselsTpi ;
    echr:hasDecisionDate "2016-11-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "31"^^xsd:string ;
    echr:hasSupportingQuote "On 7 November 2016 another judge acting as president of the French ‐ language TPI declared their application admissible but unfounded, considering that the Belgian authorities could not be criticised for failing voluntarily to comply with a judgment by the Aliens Appeals Board, even one that was immediately enforceable, if these same authorities intended to challenge the legality of the judgment by pursuing an appeal procedure provided for by law."^^xsd:string .

doc:tpi_unilateral_25oct2016 a echr:DomesticProceeding ;
    rdfs:label "unilateral application before the President of the Brussels French-language Court of First Instance (order of 25 October 2016)"@en ;
    echr:hasCourt doc:brusselsTpi ;
    echr:hasDecisionDate "2016-10-25"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimGranted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "30"^^xsd:string ;
    echr:hasSupportingQuote "By an order of 25 October 2016, considering that the failure by the Aliens Office to comply with a judgment of the Aliens Appeals Board, notwithstanding the fact that it had been immediately enforceable, constituted “an unacceptable illegal action”, the acting president of the French-language TPI ordered the State, as an urgent measure, to comply with the Board’s judgment of 20 October 2016, that is, to issue the applicants with visas or laissez-passers , and made the order subject to a penalty payment of 1,000 euros (EUR) per day of delay and per applicant."^^xsd:string .

doc:brusselsTpi a echr:DomesticAuthority ;
    rdfs:label "Brussels French-language Court of First Instance"@en ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Brussels French-language Court of First Instance"^^xsd:string .

doc:case_3599_18 a echr:CaseDocument ;
    rdfs:label "Application no. 3599/18 M.N. and Others against Belgium"^^xsd:string ;
    echr:hasDomesticProceeding doc:domprocAdmincourtAliensRefusal,
        doc:domproc_visa_application_2016 .

doc:domproc_visa_application_2016 a echr:DomesticProceeding ;
    rdfs:label "visa application at Belgian embassy (22 August 2016)"^^xsd:string ;
    echr:hasCourt doc:authorityBelgianEmbassyBeirut ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasProceedingStartDate "2016-08-22"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "10"^^xsd:string,
        "9"^^xsd:string ;
    echr:hasSupportingQuote "On 22 August 2016 the applicant couple, accompanied by one of their children, travelled to the Belgian embassy in Beirut to submit visa applications for themselves and their two children."^^xsd:string,
        "The applicants requested visas with limited territorial validity on the basis of Article 25 of the Community Code on Visas (see paragraph 64 below)."^^xsd:string ;
    echr:isProceedingInCase doc:case_3599_18 .

doc:procAliensOfficeDecision a echr:DomesticProceeding ;
    rdfs:label "Decision by the Aliens Office"^^xsd:string ;
    echr:hasCourt doc:aliensOffice ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "45"^^xsd:string ;
    echr:hasSupportingQuote "The decision on whether or not to grant a visa falls within the discretionary powers of the Minister (at the relevant time, the State Secretary with responsibility for asylum and migration), and his or her representative, an authorised civil servant from the Aliens Office."^^xsd:string .

