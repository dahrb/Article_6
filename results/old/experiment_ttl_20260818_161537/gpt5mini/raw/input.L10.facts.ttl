    echr:hasSourceParagraph "75"^^xsd:string ;
    echr:hasSupportingQuote "the Aliens Appeals Board’s judgment of 20 October 2016"^^xsd:string .

doc:aliens_appeals_board_24mar2017 a echr:DomesticProceeding ;
    rdfs:label "proceedings before the Aliens Appeals Board to have the Aliens Office’s decisions of 10 October 2016 set aside (decision 24 March 2017)"@en ;
    echr:hasCourt doc:aliensAppealsBoard ;
    echr:hasDecisionDate "2017-03-24"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "22"^^xsd:string ;
    echr:hasSupportingQuote "On 24 March 2017 the Aliens Appeals Board dismissed the application to have those decisions set aside, finding that the Aliens Office’s decisions of 13 September 2016 (see paragraph 11 above) had become final and that, in consequence, the applicants no longer had standing to challenge the subsequent decisions."^^xsd:string .

