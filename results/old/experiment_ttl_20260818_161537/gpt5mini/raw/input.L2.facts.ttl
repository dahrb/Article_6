@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/2935b76ac0ea/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/2935b76ac0ea> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:2"^^xsd:string .

doc:darmstadt_labour_proceeding_1993_1995 a echr:DomesticProceeding ;
    rdfs:label "Proceedings before the Darmstadt Labour Court instituted in October and November 1993; decision 21 March 1995"^^xsd:string ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1995-03-21"^^xsd:date ;
    echr:hasExtractionNote "Proceedings were instituted in October and November 1993 (two applicants); decision on 21 March 1995; applicants did not pursue the matter afterwards."^^xsd:string ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participationFirstLabour,
        doc:participationSecondLabour ;
    echr:hasSourceParagraph "13"^^xsd:string,
        "15"^^xsd:string ;
    echr:hasSupportingQuote "In October and November 1993 the applicants instituted proceedings before the Darmstadt Labour Court ( Arbeitsgericht ) against ESA, arguing that, pursuant to the German Provision of Labour (Temporary Staff) Act ( Arbeitnehmerüberlassungsgesetz ), they had acquired the status of employees of ESA."^^xsd:string,
        "On 21 March 1995 the Darmstadt Labour Court, following hearings, declared the applicants’ respective actions inadmissible."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:domestic_proceeding_darmstadt_1 a echr:DomesticProceeding ;
    rdfs:label "Darmstadt Labour Court proceedings"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "41"^^xsd:string ;
    echr:hasSupportingQuote "The applicants had access to the Darmstadt Labour Court, only to be told that their action was barred by operation of law."^^xsd:string .

doc:domestic_proceeding_federal_labour_court_19931110_1 a echr:DomesticProceeding ;
    rdfs:label "Federal Labour Court decision of 10 November 1993"@en ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1993-11-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "41"^^xsd:string ;
    echr:hasSupportingQuote "the decision of the Federal Labour Court of 10 November 1993 in the case concerning Mr Waite and Mr Kennedy"^^xsd:string .

doc:german_courts_immunity_section_20_2 a echr:DomesticProceeding ;
    rdfs:label "immunity from jurisdiction of ESA on the basis of section 20(2) of the Courts Act"^^xsd:string ;
    echr:followsProceeding doc:attemptedRecognitionPermanentEmploymentByEsa ;
    echr:hasCourt doc:germanCourts ;
    echr:hasInstanceLevel echr:LevelUnknown ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "63"^^xsd:string ;
    echr:hasSupportingQuote "in giving effect to the immunity from jurisdiction of ESA on the basis of section 20(2) of the Courts Act, the German courts did not exceed their margin of appreciation."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:proceeding_ti_dismissal_1994 a echr:DomesticProceeding ;
    rdfs:label "Proceedings before the Darmstadt Labour Court concerning dismissal by T.I., settlement on 6 September 1994"^^xsd:string ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasDecisionDate "1994-09-06"^^xsd:date ;
    echr:hasOutcome echr:OutcomeSettled ;
    echr:hasParticipation doc:participationSecondTi ;
    echr:hasSourceParagraph "17"^^xsd:string ;
    echr:hasSupportingQuote "In the proceedings instituted by the second applicant against his dismissal by the company T.I. (see paragraph 13 above), a settlement had been reached in the Darmstadt Labour Court on 6 September 1994."^^xsd:string .

doc:attemptedRecognitionPermanentEmploymentByEsa a echr:DomesticProceeding ;
    rdfs:label "attempted to obtain recognition of permanent employment by ESA"^^xsd:string ;
    echr:hasCourt doc:germanCourts ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "61"^^xsd:string ;
    echr:hasSupportingQuote "The significant feature of the instant case is that the applicants, after having performed services at the premises of ESOC in Darmstadt for a considerable time on the basis of contracts with foreign firms, attempted to obtain recognition of permanent employment by ESA on the basis of the above-mentioned special German legislation for the regulation of the German labour market."^^xsd:string .

doc:participationFirstLabour a echr:Participation ;
    rdfs:label "Participation of first applicant in Darmstadt Labour Court proceedings (Oct/Nov 1993)"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSourceParagraph "13"^^xsd:string ;
    echr:participatingParty doc:partyFirstApplicant .

doc:participationSecondLabour a echr:Participation ;
    rdfs:label "Participation of second applicant in Darmstadt Labour Court proceedings (Oct/Nov 1993)"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSourceParagraph "13"^^xsd:string ;
    echr:participatingParty doc:partySecondApplicant .

doc:participationSecondTi a echr:Participation ;
    rdfs:label "Participation of second applicant in proceedings against T.I. (settled 6 Sept 1994)"^^xsd:string ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSourceParagraph "17"^^xsd:string ;
    echr:participatingParty doc:partySecondApplicant .

doc:partyFirstApplicant a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Mr Karlheinz Beer"^^xsd:string ;
    echr:hasPartyName "Mr Karlheinz Beer"^^xsd:string ;
    echr:hasPersonName "Mr Karlheinz Beer"^^xsd:string ;
    echr:hasSourceParagraph "10"^^xsd:string .

doc:proceedingDarmstadtLabourCourt a echr:DomesticProceeding ;
    rdfs:label "the applicants’ action under the German Provision of Labour (Temporary Staff) Act"^^xsd:string ;
    echr:followsProceeding doc:proceedingFederalLabourCourtWaiteKennedy ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeUnknown ;
    echr:hasSourceParagraph "46"^^xsd:string ;
    echr:hasSupportingQuote "In the instant case the Darmstadt Labour Court concluded that the conditions under section 20(2) of the German Courts Act for finding that the applicants’ action was inadmissible were fulfilled."^^xsd:string .

doc:germanCourts a echr:DomesticAuthority ;
    rdfs:label "German courts"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "the German courts"^^xsd:string .

doc:partySecondApplicant a echr:NaturalPerson,
        echr:Party ;
    rdfs:label "Mr Philip Regan"^^xsd:string ;
    echr:hasPartyName "Mr Philip Regan"^^xsd:string ;
    echr:hasPersonName "Mr Philip Regan"^^xsd:string ;
    echr:hasSourceParagraph "10"^^xsd:string .

doc:proceedingFederalLabourCourtWaiteKennedy a echr:DomesticProceeding ;
    rdfs:label "decision of the Federal Labour Court in the case of Mr Waite and Mr Kennedy"^^xsd:string ;
    echr:hasCourt doc:darmstadtLabourCourt ;
    echr:hasOutcome echr:OutcomeUnknown ;
    echr:hasOutcomeDirection echr:DirectionUnknown ;
    echr:hasSourceParagraph "46"^^xsd:string ;
    echr:hasSupportingQuote "The Labour Court further referred to the decision of the Federal Labour Court in the case of Mr Waite and Mr Kennedy (see paragraph 15 above)."^^xsd:string .

doc:darmstadtLabourCourt a echr:DomesticAuthority ;
    rdfs:label "Darmstadt Labour Court"^^xsd:string,
        "Darmstadt Labour Court (Arbeitsgericht)"^^xsd:string,
        "Federal Labour Court"^^xsd:string,
        "Darmstadt Labour Court"@en,
        "Federal Labour Court"@en ;
    echr:decidedProceeding doc:proceedingDarmstadtLabourCourt,
        doc:proceedingFederalLabourCourtWaiteKennedy ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Darmstadt Labour Court"^^xsd:string,
        "Darmstadt Labour Court (Arbeitsgericht)"^^xsd:string,
        "Federal Labour Court"^^xsd:string .

