doc:final_conclusion_order_costs_11_oct_2001 a echr:DomesticProceeding ;
    rdfs:label "On 11 October 2001 the Slovenj Gradec District Court ordered the applicant to pay an additional sum to cover the costs of one of the witnesses heard during the proceedings. On that day, the proceedings were “finally concluded” ( pravnomočno končan postopek )."^^xsd:string ;
    echr:followsProceeding doc:maribor_higher_court_upheld_conviction_9_may_2001 ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
    echr:hasDecisionDate "2001-10-11"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelEnforcement ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "50"^^xsd:string ;
    echr:hasSupportingQuote "On 11 October 2001 the Slovenj Gradec District Court ordered the applicant to pay an additional sum to cover the costs of one of the witnesses heard during the proceedings. On that day, the proceedings were “finally concluded"^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:judgment_12_february_2001_issued_in_proceedings_instituted_against_applicant a echr:DomesticProceeding ;
    rdfs:label "The judgment of 12 February 2001 issued in the proceedings instituted against the applicant"^^xsd:string ;
    echr:followsProceeding doc:criminalInvestigationInstitutedAgainstApplicant ;
    echr:hasDecisionDate "2001-02-12"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelUnknown ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "21"^^xsd:string ;
    echr:hasSupportingQuote "The judgment of 12 February 2001 issued in the proceedings instituted against the applicant (see paragraph 48), established that three officers of the Slovenj Gradec Police, D.P., J.K. and M.F., who were in the car which stopped the applicant, received information about the location of a “white Golf”, believed to be being driven by the applicant, and an order to stop it."^^xsd:string .

doc:mia a echr:DomesticAuthority ;
    rdfs:label "MIA"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityAdministrative ;
    echr:hasAuthorityName "MIA"^^xsd:string .

doc:proceeding_2 a echr:DomesticProceeding ;
    rdfs:label "Investigation by Slovenj Gradec District Public Prosecutor’s Office, 15 May 1995–17 January 1997"^^xsd:string ;
    echr:followsProceeding doc:proceeding_1 ;
    echr:hasCourt doc:slovenjGradecProsecutorOffice ;
    echr:hasDecisionDate "1997-01-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeDiscontinued ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingStartDate "1995-05-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "30"^^xsd:string,
        "34"^^xsd:string ;
    echr:hasSupportingQuote "On 15 June 1995 the Slovenj Gradec District Public Prosecutor’s Office ( Okrožno državno tožilstvo ) asked the applicant’s lawyer to add his client’s deposition to the file, which he did on 20 June 1995."^^xsd:string,
        "On 17 January 1997 the Public Prosecutor issued a decision dismissing the applicant’s criminal complaint."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:publicProsecutor a echr:DomesticAuthority ;
    rdfs:label "Public Prosecutor"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Public Prosecutor"^^xsd:string .

doc:specialUnit a echr:DomesticAuthority ;
    rdfs:label "Special Unit"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Special Unit"^^xsd:string .

doc:criminalInvestigationInstitutedAgainstApplicant a echr:DomesticProceeding ;
    rdfs:label "criminal investigation instituted against the applicant"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "22"^^xsd:string ;
    echr:hasSupportingQuote "Officer J.K. testified in the criminal investigation instituted against the applicant, that they had received information that the “white Golf” had left “the place”, which meant that it had left Pik Bar ."^^xsd:string .

doc:district_decision_not_to_open_investigation_1997_05_08 a echr:DomesticProceeding ;
    rdfs:label "On 8 May 1997, further to a proposal of the investigating judge, the Slovenj Gradec District Court decided not to open a criminal investigation against the applicant."^^xsd:string ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
    echr:hasDecisionDate "1997-05-08"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "40"^^xsd:string ;
    echr:hasSupportingQuote "On 8 May 1997, further to a proposal of the investigating judge, the Slovenj Gradec District Court decided not to open a criminal investigation against the applicant."^^xsd:string .

doc:indictment_filed_1998_12_28 a echr:DomesticProceeding ;
    rdfs:label "On 28 December 1998 the Public Prosecutor filed an indictment against the applicant for “attempting to obstruct an official in the course of his duties” ( poskus kaznivega dejanja preprečitve uradnega dejanja uradni osebi )."^^xsd:string ;
    echr:followsProceeding doc:investigation_concluded_1998_03_17 ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeUnknown ;
    echr:hasProceedingStartDate "1998-12-28"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "44"^^xsd:string ;
    echr:hasSupportingQuote "On 28 December 1998 the Public Prosecutor filed an indictment against the applicant for “attempting to obstruct an official in the course of his duties"^^xsd:string .

doc:investigation_concluded_1998_03_17 a echr:DomesticProceeding ;
    rdfs:label "The criminal investigation was concluded with the investigating judge’s decision ordering the exclusion of certain documents from the case-file in accordance with section 83, paragraph 3, of the Criminal Procedure Act."^^xsd:string ;
    echr:followsProceeding doc:maribor_decision_upholding_appeal_and_opening_investigation_1997_12_04 ;
    echr:hasCourt doc:slovenjGradecDistrictCourt ;
    echr:hasDecisionDate "1998-03-17"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeUnknown ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "43"^^xsd:string ;
    echr:hasSupportingQuote "On 17 March 1998 the criminal investigation was concluded with the investigating judge’s decision ordering the exclusion of certain documents from the case-file in accordance with section 83, paragraph 3, of the Criminal Procedure Act."^^xsd:string .

doc:maribor_decision_upholding_appeal_and_opening_investigation_1997_12_04 a echr:DomesticProceeding ;
    rdfs:label "On 4 December 1997 the Maribor Higher Court upheld her appeal finding that, despite the shortcomings mentioned in the first-instance decision, there were sufficient grounds for suspicion that the applicant had committed the alleged offence."^^xsd:string ;
    echr:followsProceeding doc:district_decision_not_to_open_investigation_1997_05_08 ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "1997-12-04"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "41"^^xsd:string ;
    echr:hasSupportingQuote "On 4 December 1997 the Maribor Higher Court upheld her appeal finding that, despite the shortcomings mentioned in the first-instance decision, there were sufficient grounds for suspicion that the applicant had committed the alleged offence. Accordingly, it changed the first-instance court’s decision and opened a criminal investigation against the applicant."^^xsd:string .

doc:maribor_higher_court_upheld_conviction_9_may_2001 a echr:DomesticProceeding ;
    rdfs:label "On 9 May 2001 the Maribor Higher Court upheld the conviction but amended the judgment with respect to the costs of the proceedings."^^xsd:string ;
    echr:followsProceeding doc:retrial_judgment_12_feb_2001_conviction ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "2001-05-09"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "49"^^xsd:string ;
    echr:hasSupportingQuote "On 9 May 2001 the Maribor Higher Court upheld the conviction but amended the judgment with respect to the costs of the proceedings."^^xsd:string .

doc:maribor_quash_and_remit_27_sep_2000 a echr:DomesticProceeding ;
    rdfs:label "On 5 January 2000 the Public Prosecutor appealed against the judgment and on 27 September 2000 the Maribor Higher Court quashed the judgment and remitted the case to a new panel for retrial."^^xsd:string ;
    echr:followsProceeding doc:trial_judgment_22_nov_1999_acquittal ;
    echr:hasCourt doc:mariborHigherCourt ;
    echr:hasDecisionDate "2000-09-27"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "47"^^xsd:string ;
    echr:hasSupportingQuote "On 5 January 2000 the Public Prosecutor appealed against the judgment and on 27 September 2000 the Maribor Higher Court quashed the judgment and remitted the case to a new panel for retrial."^^xsd:string .

