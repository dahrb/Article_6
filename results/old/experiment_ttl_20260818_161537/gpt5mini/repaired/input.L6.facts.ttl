doc:court_of_cassation_appeal_on_points_of_law_2009_08_04 a echr:DomesticProceeding ;
    rdfs:label "the applicant company lodged an appeal on points of law"@en ;
    echr:followsProceeding doc:civil_court_of_appeal_appeal_2009_06_25 ;
    echr:hasCourt doc:authorityCourtOfCassation ;
    echr:hasDecisionDate "2009-09-23"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeDeclaredInadmissible ;
    echr:hasProceedingStartDate "2009-08-04"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "37"^^xsd:string,
        "38"^^xsd:string ;
    echr:hasSupportingQuote "On 23 September 2009 the Court of Cassation declared the applicant company’s appeal on points of law inadmissible."^^xsd:string,
        "On 4 August 2009 the applicant company lodged an appeal on points of law."^^xsd:string ;
    echr:isFinalDomesticDecision true .

doc:domestic_proceeding_commercial_court_2007 a echr:DomesticProceeding ;
    rdfs:label "Claim lodged with the Commercial Court"^^xsd:string ;
    echr:hasCourt doc:authorityCommercialCourt ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingStartDate "2007-01-15"^^xsd:date ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "14"^^xsd:string,
        "15"^^xsd:string ;
    echr:hasSupportingQuote "On 15 January 2007 the applicant company lodged a claim with the Commercial Court against the LLC, seeking to recover USD 10,000 from the initial debt of USD 1,213,824."^^xsd:string,
        "On 2 October 2007 the applicant company amended its initial claim, seeking to recover a total of USD 1,516,442 and EUR 116,600 from the LLC, including the principal debt, the loan and interest on both."^^xsd:string ;
    echr:isProceedingInCase doc:caseScholzAgVArmenia .

doc:proc_arbitration_tribunal_2008 a echr:DomesticProceeding ;
    rdfs:label "applicant company lodged a claim with the Arbitration Tribunal"^^xsd:string ;
    echr:hasCourt doc:authorityArbitrationTribunal ;
    echr:hasProceedingStartDate "2008-09-17"^^xsd:date ;
    echr:hasProceedingType echr:TypeOther ;
    echr:hasSourceParagraph "25"^^xsd:string ;
    echr:hasSupportingQuote "On 17 September 2008 the applicant company lodged a claim with the Arbitration Tribunal, seeking to recover EUR 116,600, the amount of the loan and interest."^^xsd:string ;
    echr:isProceedingInCase doc:caseDocumentUntyped .

doc:proc_commercial_court_appeal_2007 a echr:DomesticProceeding ;
    rdfs:label "three-judge bench of the Commercial Court rejected the complaint submitted by the applicant company"^^xsd:string ;
