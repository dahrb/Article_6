    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "20"^^xsd:string,
        "21"^^xsd:string ;
    echr:hasSupportingQuote "On 10 December 2007 a three-judge bench of the Commercial Court rejected the complaint submitted by the applicant company."^^xsd:string,
        "On 23 November 2007 the applicant company lodged a complaint concerning the decision to leave the claim and counterclaim unexamined."^^xsd:string ;
    echr:isProceedingInCase doc:caseDocumentUntyped .

doc:arbitration_refusal_2008 a echr:DomesticProceeding ;
    rdfs:label "the President of the Arbitration Tribunal informed the applicant company that its request to start arbitration proceedings would not be granted."@en ;
    echr:hasCourt doc:authorityArbitrationTribunal ;
    echr:hasDecisionDate "2008-10-07"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelUnknown ;
    echr:hasProceedingType echr:TypeOther ;
    echr:hasSourceParagraph "26"^^xsd:string ;
    echr:hasSupportingQuote "Consequently, in the absence of an arbitration agreement between the parties, the [Arbitration Tribunal] cannot start arbitration proceedings."^^xsd:string .

