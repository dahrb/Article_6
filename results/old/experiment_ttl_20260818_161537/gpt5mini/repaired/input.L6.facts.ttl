doc:proc_commercial_court_first_instance_2007 a echr:DomesticProceeding ;
    rdfs:label "Commercial Court decision to leave the applicant company’s claim and the counterclaim unexamined"^^xsd:string ;
    echr:hasCourt doc:authorityCommercialCourt ;
    echr:hasDecisionDate "2007-11-16"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "16"^^xsd:string,
        "18"^^xsd:string,
        "19"^^xsd:string ;
    echr:hasSupportingQuote "On 16 November 2007 the Commercial Court granted the request and decided to leave the applicant company’s claim and the counterclaim lodged by the LLC unexamined."^^xsd:string,
        "On 4 October 2007 the LLC filed a counterclaim, contesting the applicant company’s claims."^^xsd:string,
        "On 7 November 2007 the LLC requested the Commercial Court to leave the applicant company’s claim unexamined on the grounds that the contracts of 8 February 1999, 10 April 2000 and 2 April 2003 contained a dispute resolution clause whereby disputes concerning their performance would be resolved by the Arbitration Tribunal of the Chamber of Commerce of the country of the respondent."^^xsd:string ;
    echr:isProceedingInCase doc:caseDocumentUntyped .

