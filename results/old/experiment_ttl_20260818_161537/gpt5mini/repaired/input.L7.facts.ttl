@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doc: <https://growgraph.dev/doc/9d0f5c14ba04/> .
@prefix echr: <https://growgraph.dev/echr#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://growgraph.dev/doc/9d0f5c14ba04> a prov:Entity,
        foaf:Document ;
    dcterms:title "input.jsonl:7"^^xsd:string .

doc:high_court_bail_review_1999 a echr:DomesticProceeding ;
    rdfs:label "High Court to review bail"^^xsd:string ;
    echr:followsProceeding doc:trial_1999_first_instance ;
    echr:hasDecisionDate "1999-03-26"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "8"^^xsd:string ;
    echr:hasSupportingQuote "An application was made to the High Court to review bail on 26 March 1999. It was refused. The applicant states that the High Court judge took the view that he should not interfere with the decision given the stage reached in the proceedings, i.e. the closing speeches."^^xsd:string .

doc:houseOfLordsLeaveProceeding a echr:DomesticProceeding ;
    rdfs:label "the petition for leave to appeal"^^xsd:string ;
    echr:followsProceeding doc:appealCourtProceeding ;
    echr:hasCourt doc:houseOfLordsAuthority ;
    echr:hasDecisionDate "2000-06-15"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelCassation ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "10"^^xsd:string ;
    echr:hasSupportingQuote "On 15 June 2000, the House of Lords refused the petition for leave to appeal."^^xsd:string .

doc:proceeding_trial_1999 a echr:DomesticProceeding ;
    rdfs:label "Trial at first instance (8 Feb - 1 Apr 1999) before Mr Justice Potts and a jury"^^xsd:string ;
    echr:followsProceeding doc:proceedingIndictment ;
    echr:hasCourt doc:authorityJudgePotts ;
    echr:hasDecisionDate "1999-04-01"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingStartDate "1999-02-08"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "A"^^xsd:string ;
    echr:hasSupportingQuote "Before the commencement of the proceedings, the defence made a number of applications: that the trial should be stayed as an abuse on the basis that due inter alia to the lapse of time since events the applicant could not obtain a fair trial. The application was refused by the trial judge who considered that it was entirely speculative ..."^^xsd:string,
        "In the trial which took place between 8 February and 1 April 1999, before Mr Justice Potts and a jury, the applicant was represented by senior and junior counsel and solicitors."^^xsd:string .

doc:appealCourtProceeding a echr:DomesticProceeding ;
    rdfs:label "appeal to the Court of Appeal"^^xsd:string ;
    echr:followsProceeding doc:trialProceeding ;
    echr:hasCourt doc:courtOfAppealAuthority ;
    echr:hasDecisionDate "2000-02-10"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "4"^^xsd:string ;
    echr:hasSupportingQuote "In its judgment of 10 February 2000, the Court of Appeal rejected the applicant’s appeal."^^xsd:string .

doc:authorityBritishPolice a echr:DomesticAuthority ;
    rdfs:label "the British police"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "the British police"^^xsd:string .

doc:authorityJudgePotts a echr:DomesticAuthority ;
    rdfs:label "Mr Justice Potts and a jury"^^xsd:string ;
    echr:hasAuthorityKind echr:AuthorityJudicial ;
    echr:hasAuthorityName "Mr Justice Potts and a jury"^^xsd:string .

doc:courtOfAppealAuthority a echr:DomesticAuthority ;
    rdfs:label "the Court of Appeal"^^xsd:string .

doc:houseOfLordsAuthority a echr:DomesticAuthority ;
    rdfs:label "the House of Lords"^^xsd:string .

doc:proceedingIndictment a echr:DomesticProceeding ;
    rdfs:label "Criminal charging on indictment (four counts)"^^xsd:string ;
    echr:followsProceeding doc:proceeding_investigation_1996 ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "A"^^xsd:string ;
    echr:hasSupportingQuote "The applicant was charged on an indictment with four counts of murder:"^^xsd:string .

doc:proceeding_investigation_1996 a echr:DomesticProceeding ;
    rdfs:label "Investigation: interviews by the British police (1 & 3 April 1996)"^^xsd:string ;
    echr:hasCourt doc:authorityBritishPolice ;
    echr:hasInstanceLevel echr:LevelInvestigative ;
    echr:hasProceedingStartDate "1996-04-01"^^xsd:date ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "A"^^xsd:string ;
    echr:hasSupportingQuote "On 1 and 3 April 1996, the applicant was interviewed by the British police concerning his activities in Domachevo during the German occupation."^^xsd:string .

doc:trialAdjournment a echr:Adjournment ;
    rdfs:label "the overnight adjournment of the trial"^^xsd:string ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "On hearing re-assurances from defence counsel that arrangements would be made for transporting the applicant to and from the court room and for ensuring his welfare in his own home, and having regard to the shortness of the overnight adjournment of the trial, the trial judge reinstated bail."^^xsd:string .

doc:trialJudgeAuthority a echr:DomesticAuthority ;
    rdfs:label "the trial judge"^^xsd:string .

doc:trialProceeding a echr:DomesticProceeding ;
    rdfs:label "the trial"^^xsd:string ;
    echr:hasAdjournment doc:trialAdjournment ;
    echr:hasCourt doc:trialJudgeAuthority ;
    echr:hasDecisionDate "1999-04-01"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeConviction ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "2"^^xsd:string ;
    echr:hasSupportingQuote "On 1 April 1999, the jury convicted the applicant of counts 1 and 3."^^xsd:string .

doc:trial_1999_first_instance a echr:DomesticProceeding ;
    rdfs:label "the trial"^^xsd:string ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeCriminal ;
    echr:hasSourceParagraph "1"^^xsd:string,
        "3"^^xsd:string,
        "6"^^xsd:string,
        "7"^^xsd:string ;
    echr:hasSupportingQuote "During the trial the judge and jury visited the location at Domachevo, including the site in a forest where one witness, Fedor Zan, claimed to have seen the applicant execute a number of Jewish women, including the victim specified in Count 3."^^xsd:string,
        "On 24 March 1999, the judge refused the application."^^xsd:string,
        "On 25 March 1999, before the closing speeches were due to begin and a long adjournment over a weekend, the judge after consulting counsel decided to withdraw the applicant’s bail."^^xsd:string,
        "On 8 February 1999, the judge ruled that the evidence of both witnesses was relevant and admissible and, on 26 February 1999, that it should go before the jury."^^xsd:string .

