doc:proceeding_1 a echr:DomesticProceeding ;
    echr:followsProceeding doc:proceeding_2 ;
    echr:hasCourt doc:authority_1 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "1"^^xsd:string ;
    echr:hasSupportingQuote "If the contract between a hirer-out and an employee hired out is void under section 1(9)(1), a contract between the hiring employer and the employee hired out is deemed to have been concluded ( gilt als zustande gekommen ) as from the envisaged start of employment (section 1(10)(1)(1))."^^xsd:string,
        "Section 1(1)(1) of the Provision of Labour (Temporary Staff) Act ( Arbeitnehmerüberlassungsgesetz ) provides that an employer who, on a commercial basis ( gewerbsmäßig ), intends to hire out his employees to third persons - hiring employers ( Entleiher ) - must obtain official permission."^^xsd:string,
        "Section 1(9)(1) provides that contracts between the hirer-out ( Verleiher ) and the hiring employer and between the hirer-out and the employee hired out ( Leiharbeitnehmer ) are void if no official permission has been obtained as required by section 1(1)(1)."^^xsd:string .

doc:adjournment_1 a echr:Adjournment ;
