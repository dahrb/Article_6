doc:domestic_authority_1 a echr:DomesticAuthority ;
    echr:decidedProceeding doc:domestic_proceeding_1 ;
    echr:hasAuthorityKind echr:AuthorityAdministrative,
        echr:AuthorityJudicial,
        echr:AuthorityProsecutorial ;
    echr:hasAuthorityName "Appeals Board"^^xsd:string,
        "Darmstadt Labour Court"^^xsd:string,
        "Federal Republic of Germany"^^xsd:string,
        "German courts"^^xsd:string ;
    echr:hasSourceParagraph "33.1"^^xsd:string,
        "46"^^xsd:string ;
    echr:hasSupportingQuote "In the instant case the Darmstadt Labour Court concluded that the conditions under section 20(2) of the German Courts Act for finding that the applicants’ action was inadmissible were fulfilled."^^xsd:string,
        "There shall be set up an Appeals Board, independent of the Agency, to hear disputes relating to any explicit or implicit decision taken by the Agency and arising between it and a staff member, a former staff member or persons entitled under him."^^xsd:string .

doc:domestic_authority_2 a echr:DomesticAuthority ;
    echr:decidedProceeding doc:domestic_proceeding_2 ;
    echr:hasAuthorityKind echr:AuthorityAdministrative,
        echr:AuthorityJudicial ;
    echr:hasAuthorityName "Darmstadt Labour Court"^^xsd:string,
        "European Commission of Human Rights"^^xsd:string,
        "Federal Labour Court"^^xsd:string,
        "German courts"^^xsd:string ;
    echr:hasSourceParagraph "42"^^xsd:string,
        "46"^^xsd:string ;
    echr:hasSupportingQuote "The German labour court proceedings in the present case, as in the case of Mr Waite and Mr Kennedy, had concentrated on the question of whether or not ESA could validly rely on its immunity from jurisdiction."^^xsd:string,
        "The Labour Court further referred to the decision of the Federal Labour Court in the case of Mr Waite and Mr Kennedy (see paragraph 15 above)."^^xsd:string .

