doc:participation_2 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSourceParagraph "42"^^xsd:string ;
    echr:hasSupportingQuote "The German labour court proceedings in the present case, as in the case of Mr Waite and Mr Kennedy, had concentrated on the question of whether or not ESA could validly rely on its immunity from jurisdiction."^^xsd:string ;
    echr:participatingParty doc:party_1 .

doc:proceeding_2 a echr:DomesticProceeding ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:authority_2 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "2"^^xsd:string ;
    echr:hasSupportingQuote "Section 20(1) other representatives of States staying in Germany upon the invitation of the German Government."^^xsd:string,
        "Section 20(2) provides that other persons shall have immunity from jurisdiction according to the rules of general international law, or pursuant to international agreements or other legal rules."^^xsd:string,
        "Sections 18 to 20 of the German Courts Act ( Gerichtsverfassungsgesetz ) regulate immunity from jurisdiction ( Exterritorialität ) in German court proceedings."^^xsd:string .

doc:proceeding_3 a echr:DomesticProceeding ;
    echr:hasCourt doc:authority_3 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "3"^^xsd:string ;
    echr:hasSupportingQuote "According to Article I of Annex I, the Agency shall have legal personality, in particular the capacity to contract, to acquire and to dispose of movable and immovable property, and to be a party to legal proceedings."^^xsd:string,
        "According to Article XXVII of Annex I, the Agency shall make suitable provision for the satisfactory settlement of disputes arising between the Agency and the Director General, staff members or experts in respect of their conditions of service."^^xsd:string,
        "Annex I relates to the privileges and immunities of the Agency."^^xsd:string,
        "Article XIX provides that on the date of entry into force of the ESA Convention the Agency shall take over all the rights and obligations of ESRO."^^xsd:string,
        "Article XV regulates the legal status, privileges and immunities of the Agency. According to paragraph 1, the Agency shall have legal personality."^^xsd:string,
        "Article XVII concerns the arbitration procedure in case of disputes between two or more member States, or between any of them and ESA, concerning the interpretation or application of the ESA Convention or its annexes, and disputes arising out of damage caused by ESA, or involving any other responsibility of ESA (Article XXVI of Annex I), which are not settled by or through the Council."^^xsd:string,
        "Article XXV of Annex I provides for arbitration with regard to written contracts other than those concluded in accordance with the Staff Regulations."^^xsd:string,
        "Chapter VIII of the ESA Staff Regulations (Regulations 33 to 41) concerns disputes within ESA."^^xsd:string,
        "Moreover, any member State may submit to the International Arbitration Tribunal referred to in Article XVII of the ESA Convention any dispute, inter alia , arising out of damage caused by the Agency, or involving any other non-contractual responsibility of the Agency."^^xsd:string,
        "Pursuant to Article IV § 1 (a) of Annex I, the Agency shall have immunity from jurisdiction and execution, except to the extent that it shall, by decision of the Council, have expressly waived such immunity in a particular case; the Council has the duty to waive this immunity in all cases where reliance upon it would impede the course of justice and it can be waived without prejudicing the interests of the Agency."^^xsd:string,
        "The ESA Convention came into force on 30 October 1980, when ten States, members of ESRO or ELDO, had signed it and had deposited their instruments of ratification or acceptance."^^xsd:string,
        "The purpose of ESA is to provide for and to promote, for exclusively peaceful purposes, cooperation among European States in space research and technology and their space applications, with a view to their being used for scientific purposes and for operational space applications systems (Article II of the ESA Convention)."^^xsd:string .

doc:case_document_1 a echr:CaseDocument ;
    echr:hasApplicant doc:party_1 ;
    echr:hasDomesticProceeding doc:domestic_proceeding_1,
        doc:domestic_proceeding_2 .

doc:domestic_proceeding_2 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_1 ;
    echr:hasCourt doc:domestic_authority_2 ;
    echr:hasDecisionDate "1995-09-13"^^xsd:date,
        "1998"^^xsd:gYear ;
    echr:hasInactivityPeriod doc:inactivity_period_1 ;
    echr:hasInstanceLevel echr:LevelAppeal,
        echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination,
        echr:OutcomeUnknown,
        echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant,
        echr:DirectionUnknown ;
    echr:hasParticipation doc:participation_1,
        doc:participation_2 ;
    echr:hasProceedingStartDate "1998-03-16"^^xsd:date,
        "1998"^^xsd:gYear ;
    echr:hasProceedingType echr:TypeCivil,
        echr:TypeCriminal ;
    echr:hasSourceParagraph "1"^^xsd:string,
        "42"^^xsd:string,
        "46"^^xsd:string,
        "63"^^xsd:string ;
    echr:hasSupportingQuote "In view of all these circumstances, the Court finds that, in giving effect to the immunity from jurisdiction of ESA on the basis of section 20(2) of the Courts Act, the German courts did not exceed their margin of appreciation."^^xsd:string,
        "The German labour court proceedings in the present case, as in the case of Mr Waite and Mr Kennedy, had concentrated on the question of whether or not ESA could validly rely on its immunity from jurisdiction."^^xsd:string,
        "The Labour Court further referred to the decision of the Federal Labour Court in the case of Mr Waite and Mr Kennedy (see paragraph 15 above)."^^xsd:string,
        "The case was referred to the Court... by the European Commission of Human Rights... on 16 March 1998..."^^xsd:string ;
    echr:isProceedingInCase doc:case_document_1 ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

doc:domestic_proceeding_3 a echr:DomesticProceeding ;
    echr:hasCourt doc:domestic_authority_3 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "60"^^xsd:string ;
    echr:hasSupportingQuote "Relying on general labour regulations or, more particularly, on the German Provision of Labour (Temporary Staff) Act, temporary workers can file claims in damages against such firms."^^xsd:string ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

doc:domestic_proceeding_5 a echr:DomesticProceeding ;
    echr:hasCourt doc:domestic_authority_5 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeClaimDismissed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "59"^^xsd:string ;
    echr:hasSupportingQuote "As to the notion of \"staff member\", it would have been for the ESA Appeals Board, under Regulation 33 § 6 of the ESA Staff Regulations, to settle the question of its jurisdiction and, in this connection, to rule whether in substance the applicants fell within the notion of \"staff members\"."^^xsd:string ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

doc:participation_1 a echr:Participation ;
    echr:hasPartySide echr:SideInitiating ;
    echr:hasSourceParagraph "33.1"^^xsd:string ;
    echr:hasSupportingQuote "There shall be set up an Appeals Board, independent of the Agency, to hear disputes relating to any explicit or implicit decision taken by the Agency and arising between it and a staff member, a former staff member or persons entitled under him."^^xsd:string ;
    echr:participatingParty doc:party_1 .

doc:domestic_proceeding_1 a echr:DomesticProceeding ;
    echr:hasAdjournment doc:adjournment_1 ;
    echr:hasCourt doc:domestic_authority_1 ;
    echr:hasDecisionDate "1995-09-13"^^xsd:date,
        "1998"^^xsd:gYear ;
    echr:hasInstanceLevel echr:LevelAdministrativeReview,
        echr:LevelFirstInstance,
        echr:LevelInvestigative ;
    echr:hasOutcome echr:OutcomeRefusedExamination,
        echr:OutcomeUnknown ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant,
        echr:DirectionUnknown ;
    echr:hasParticipation doc:participation_1 ;
    echr:hasProceedingStartDate "1995-09-13"^^xsd:date,
        "1998"^^xsd:gYear ;
    echr:hasProceedingType echr:TypeAdministrative,
        echr:TypeCivil,
        echr:TypeCriminal ;
    echr:hasSourceParagraph "1"^^xsd:string,
        "33.1"^^xsd:string,
        "45"^^xsd:string,
        "55"^^xsd:string ;
    echr:hasSupportingQuote "The German labour court regarded the applicants’ action under the German Provision of Labour (Temporary Staff) Act inadmissible as the defendant, ESA, had claimed immunity from jurisdiction in accordance with Article XV § 2 of the ESA Convention and Article IV § 1 of its Annex I."^^xsd:string,
        "The remedies available to the applicants were in particular an appeal to the ESA Appeals Board if they wished to assert contractual rights, their years of membership of the ESA staff and their integration into the operation of ESA."^^xsd:string,
        "There shall be set up an Appeals Board, independent of the Agency, to hear disputes relating to any explicit or implicit decision taken by the Agency and arising between it and a staff member, a former staff member or persons entitled under him."^^xsd:string,
        "on 13 September 1995"^^xsd:string ;
    echr:isProceedingInCase doc:case_document_1 ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

doc:party_1 a echr:Party ;
    echr:hasPartyName "Mr Beer and Mr Regan"^^xsd:string,
        "Mr Karlheinz Beer, Mr Philip Regan"^^xsd:string,
        "the applicants"^^xsd:string ;
    echr:hasSourceParagraph "33"^^xsd:string,
        "45"^^xsd:string,
        "46"^^xsd:string,
        "50"^^xsd:string ;
    echr:hasSupportingQuote "Mr Beer and Mr Regan applied to the Commission on 13 September 1995."^^xsd:string,
        "The German labour court regarded the applicants’ action under the German Provision of Labour (Temporary Staff) Act inadmissible as the defendant, ESA, had claimed immunity from jurisdiction in accordance with Article XV § 2 of the ESA Convention and Article IV § 1 of its Annex I."^^xsd:string,
        "The Labour Court considered that ESA enjoyed immunity from jurisdiction according to the ESA Convention and its Annex I."^^xsd:string,
        "The applicants maintained that the right of access to the courts was not met merely by the institution of proceedings."^^xsd:string .

doc:article6_issue_1 a echr:Article6Issue ;
    echr:affectsParty doc:party_1 ;
    echr:hasDelayAttribution echr:DelayAttributedToAuthorities,
        echr:DelayUnattributed ;
    echr:hasSourceParagraph "33"^^xsd:string,
        "45"^^xsd:string,
        "46"^^xsd:string ;
    echr:hasSupportingQuote "Section 20(2) of the German Courts Act provides that persons shall have immunity from jurisdiction according to the rules of general international law, or pursuant to international agreements or other legal rules (see paragraph 20 above)."^^xsd:string,
        "The Labour Court considered that ESA enjoyed immunity from jurisdiction according to the ESA Convention and its Annex I."^^xsd:string,
        "they had been denied access to a court for a determination of their dispute with ESA in connection with an issue under German labour law."^^xsd:string ;
    echr:issueArisesIn doc:domestic_proceeding_1 .

