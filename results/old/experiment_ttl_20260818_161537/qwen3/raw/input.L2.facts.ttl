doc:domestic_proceeding_4 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_3 ;
    echr:hasCourt doc:domestic_authority_4 ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "62"^^xsd:string ;
    echr:hasSupportingQuote "To read Article 6 § 1 of the Convention and its guarantee of access to court as necessarily requiring the application of national legislation in such matters would, in the Court’s view, thwart the proper functioning of international organisations and run counter to the current trend towards extending and strengthening international cooperation."^^xsd:string ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

doc:domestic_proceeding_6 a echr:DomesticProceeding ;
    echr:followsProceeding doc:domestic_proceeding_5 ;
    echr:hasCourt doc:domestic_authority_6 ;
    echr:hasInstanceLevel echr:LevelAppeal ;
    echr:hasOutcome echr:OutcomeUpheldOnAppeal ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "59"^^xsd:string ;
    echr:hasSupportingQuote "As to the notion of \"staff member\", it would have been for the ESA Appeals Board, under Regulation 33 § 6 of the ESA Staff Regulations, to settle the question of its jurisdiction and, in this connection, to rule whether in substance the applicants fell within the notion of \"staff members\"."^^xsd:string ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

doc:domestic_proceeding_7 a echr:DomesticProceeding ;
    echr:hasCourt doc:domestic_authority_7 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasProceedingType echr:TypeCivil ;
    echr:hasSourceParagraph "52"^^xsd:string ;
    echr:hasSupportingQuote "The Committee of Staff Representatives of the Coordinated Organisations in their written comments (see paragraph 7 above) considered that the statutory provisions concerning immunity had to be interpreted so as to satisfy the fundamental rights under Article 6 § 1 of the Convention."^^xsd:string ;
    echr:raisesArticle6Issue doc:article6_issue_1 .

