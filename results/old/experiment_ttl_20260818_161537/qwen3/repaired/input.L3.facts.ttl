doc:proceeding_5 a echr:DomesticProceeding ;
    echr:hasCourt doc:authority_1,
        echr:SavingsDepositInsuranceFund ;
    echr:hasDecisionDate "2016-04-18"^^xsd:date ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeasureImposed,
        echr:OutcomeRefusedExamination ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_5 ;
    echr:hasProceedingStartDate "2007-08-29"^^xsd:date,
        "2016-04-18"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "20"^^xsd:string,
        "33"^^xsd:string ;
    echr:hasSupportingQuote "On 18 April 2016, the Fund notified the applicant of a decision taken on 27 October 2015 regarding the impossibility of enforcing the judgment."^^xsd:string,
        "On 29 August 2007, the Fund resolved to offer both Viva TV and Radio Viva for sale together in a single tendering process, setting a reserve price of USD 8,000,000. However, as no bids were received, the tendering process could not proceed."^^xsd:string ;
    echr:isFinalDomesticDecision false ;
    echr:isPending false ;
    echr:raisesArticle6Issue doc:issue_1 .

doc:proceeding_7 a echr:AdministrativeAction ;
    echr:followsProceeding doc:valuation_2 ;
    echr:hasCourt doc:authority_1 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_7 ;
    echr:hasProceedingStartDate "2009-07-09"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "22"^^xsd:string ;
    echr:hasSupportingQuote "On 9 July 2009, the Fund decided to merge the two economic and commercial units, thereby creating the Viva TV-Radio Viva Economic and Commercial Unit (hereinafter referred to as “Viva TV-Radio Viva”)."^^xsd:string .

doc:proceeding_9 a echr:DomesticProceeding ;
    echr:followsProceeding doc:proceeding_8 ;
    echr:hasCourt doc:authority_1 ;
    echr:hasInstanceLevel echr:LevelFirstInstance ;
    echr:hasOutcome echr:OutcomeMeasureImposed ;
    echr:hasOutcomeDirection echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_9 ;
    echr:hasProceedingStartDate "2011-01-13"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "24"^^xsd:string ;
    echr:hasSupportingQuote "On 13 January 2011, the Fund decided to offer Viva TV-Radio Viva for sale again, setting the reserve price at USD 6,000,000. Three companies acquired the tender documents. However, only company A. participated in the auction held on 8 February 2011."^^xsd:string .

doc:valuation_1 a echr:DomesticProceeding ;
    echr:followsProceeding doc:proceeding_3 ;
    echr:hasCourt doc:authority_1,
        echr:SupremeAdministrativeCourt ;
    echr:hasDecisionDate "2017-06-30"^^xsd:date ;
    echr:hasInstanceLevel echr:InstanceLevelAppellate,
        echr:LevelFirstInstance,
        echr:LevelReopening ;
    echr:hasOutcome echr:OutcomeQuashedAndRemitted ;
    echr:hasOutcomeDirection echr:DirectionFavourableToApplicant,
        echr:DirectionUnfavourableToApplicant ;
    echr:hasParticipation doc:participation_4 ;
    echr:hasProceedingStartDate "2007-08-01"^^xsd:date,
        "2017-06-30"^^xsd:date ;
    echr:hasProceedingType echr:TypeAdministrative ;
    echr:hasSourceParagraph "17"^^xsd:string,
        "38"^^xsd:string ;
    echr:hasStatedDuration "P308D"^^xsd:duration,
        "P748D"^^xsd:duration ;
    echr:hasSupportingQuote "On 1 August 2007, the Industrial Development Bank of Türkiye (Türkiye Sınaî Kalkınma Bankası A.Ş., hereinafter referred to as “TSKB”) issued a report and determined that the value of the Radio Viva Economic and Commercial Unit (hereinafter referred to as “Radio Viva”) was 4,258,000 United States dollars (USD), while the value of the Viva TV Economic and Commercial Unit (hereinafter referred to as “Viva TV”) was USD 373,400."^^xsd:string,
        "The court further emphasised that, since the Fund’s decision of 13 January 2011 had been definitively annulled, all actions based on that decision had been rendered legally invalid. As a result, the court overturned the judgment of the 6th Chamber of the Istanbul Administrative Court dated 19 March 2014 and annulled the sale in question."^^xsd:string ;
    echr:isFinalDomesticDecision false ;
    echr:isPending false ;
    echr:raisesArticle6Issue doc:issue_1 .

