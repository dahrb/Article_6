doc:authority_2 a echr:DomesticAuthority ;
    rdfs:label "Savings Deposit Insurance Fund"^^xsd:string ;
    echr:decidedProceeding doc:proceeding_2 ;
    echr:hasAuthorityKind echr:AuthorityAdministrative,
        echr:AuthorityJudicial ;
    echr:hasAuthorityName "13th Chamber of the Supreme Administrative Court"^^xsd:string,
        "Savings Deposit Insurance Fund"^^xsd:string,
        "Supreme Administrative Court"^^xsd:string ;
    echr:hasName "13th Chamber of the Supreme Administrative Court"^^xsd:string,
        "Supreme Administrative Court"^^xsd:string ;
    echr:hasSourceParagraph "28"^^xsd:string ;
    echr:hasSupportingQuote "On 9 December 2014, the 13th Chamber of the Supreme Administrative Court dismissed the applicant’s case."^^xsd:string .

doc:article6_issue_1 a echr:Article6Issue ;
    rdfs:label "Failure to enforce judgments affecting civil rights"^^xsd:string ;
    echr:affectsParty doc:applicant_1,
        doc:party_1 ;
    echr:hasDelayAttribution echr:DelayAttributedToAuthorities ;
    echr:hasSourceParagraph "1"^^xsd:string,
        "28"^^xsd:string ;
    echr:hasSupportingQuote "Failure to enforce judgments directly and personally affected the applicant’s right to the procedural safeguards guaranteed in the determination of his civil rights and obligations"^^xsd:string,
        "On 9 December 2014, the 13th Chamber of the Supreme Administrative Court dismissed the applicant’s case. The judgment was delivered by a majority, with one judge dissenting. In the dissenting opinion, the judge observed that an appraisal report prepared by experts on 30 June 2009 had valued the entity at USD 5,914,000. The judge noted that, although approximately eighteen months had passed since the report, the Fund had set the estimated value at USD 6,000,000 without obtaining an updated valuation to reflect the prevailing economic conditions. The judge considered this to be unlawful and concluded that the decision should have been annulled."^^xsd:string .

doc:issue_1 a echr:Article6Issue ;
    echr:affectsParty doc:party_1 ;
    echr:hasDelayAttribution echr:DelayAttributedToAuthorities ;
    echr:hasExtractionNote "The text states 'nearly one and a half years' since the valuation report of 30 June 2009 to the 2017 decision, which is approximately 1.5 years (18 months)."^^xsd:string ;
    echr:hasSourceParagraph "13"^^xsd:string ;
    echr:hasStatedDuration "P1Y6M"^^xsd:duration ;
    echr:hasSupportingQuote "On 3 April 2008, the Fund concluded that the Erol Aksoy Group had failed to fulfil several commitments and obligations set out in the Liquidation Protocol, rendering the Protocol no longer effective for the recovery of public receivables. Consequently, the Fund decided to rely on its provisions concerning default. It resolved to initiate legal proceedings against all natural and legal person debtors within the Erol Aksoy Group and to proceed with the sale of assets, including those consolidated as an economic and commercial unit."^^xsd:string ;
    echr:issueArisesIn doc:proceeding_1 .

